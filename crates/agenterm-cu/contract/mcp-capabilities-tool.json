{
  "name": "agenterm_acu_capabilities",
  "title": "Inspect agenterm-cu capabilities",
  "description": "Return the canonical read-only agenterm-cu capability inventory through the shared typed Executor.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ok": { "type": "boolean" },
      "target": { "type": "string" },
      "command": { "type": "string", "minLength": 1 },
      "data": {},
      "error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 0 },
          "detail": {}
        },
        "required": ["code", "message"]
      }
    },
    "required": ["ok", "target", "command"],
    "oneOf": [
      {
        "properties": { "ok": { "const": true } },
        "required": ["data"],
        "not": { "required": ["error"] }
      },
      {
        "properties": { "ok": { "const": false } },
        "required": ["error"],
        "not": { "required": ["data"] }
      }
    ]
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
