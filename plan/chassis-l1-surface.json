{
  "schema": 2,
  "plan": "plan/refactor-chassis-l1-l2-l3.md",
  "rule": "A six-cell Base Candidate is justified only by a changed path in one of the named L1 reasons. Unmatched and explicitly non-L1 paths do not require that lane.",
