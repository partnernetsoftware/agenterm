// Public macOS court for the frozen profile-name binding v2 experiment.
// Args are fixed by run-current-host.sh; this file owns no admission lock.
import * as rh from "scripts/qjs/lib/rh_compat";
import * as model from "research/browser-profile-name-binding-v2/binding-model";

const EXPERIMENT = "acu.dynamic.075.profile-name-binding-v2";
const EXTENSION_ID = "knofdkmmpkbnjhdkcjddbakbpmgpmjpe";
const RECEIPT_MIRROR = "receipt-mirror.json";

function ensure(value, code) {
  if (!value) { throw code; }
}

function sorted_keys(value) {
  const keys = Object.keys(value);
  for (let i = 0; i < keys.length; i = i + 1) {
    for (let j = i + 1; j < keys.length; j = j + 1) {
      if (keys[j] < keys[i]) {
        const swap = keys[i]; keys[i] = keys[j]; keys[j] = swap;
      }
    }
  }
  return keys;
}

function exact_object(value, expected) {
  if (value === null || typeof value !== "object" || Array.isArray(value)) {
    return false;
  }
  const actual = sorted_keys(value);
  const wanted = copy_strings(expected);
  for (let i = 0; i < wanted.length; i = i + 1) {
    for (let j = i + 1; j < wanted.length; j = j + 1) {
      if (wanted[j] < wanted[i]) {
        const swap = wanted[i]; wanted[i] = wanted[j]; wanted[j] = swap;
      }
    }
  }
  if (actual.length !== wanted.length) { return false; }
  for (let i = 0; i < actual.length; i = i + 1) {
    if (actual[i] !== wanted[i]) { return false; }
  }
  return true;
}

function copy_strings(values) {
  const out = [];
  for (let i = 0; i < values.length; i = i + 1) { out.push(values[i]); }
  return out;
}

function exact_string_array(actual, expected) {
  if (!Array.isArray(actual) || actual.length !== expected.length) {
    return false;
  }
  for (let i = 0; i < expected.length; i = i + 1) {
    if (actual[i] !== expected[i]) { return false; }
  }
  return true;
}

// This is the broker's restricted canonical JSON subset, not a claim that the
// court implements general RFC 8785. All court-produced values are ASCII,
// booleans, nulls, safe integers, arrays, or objects.
function canonical(value) {
  if (value === null || typeof value === "boolean"
      || typeof value === "number" || typeof value === "string") {
    return JSON.stringify(value);
  }
  if (Array.isArray(value)) {
    let items = "";
    for (let i = 0; i < value.length; i = i + 1) {
      if (i > 0) { items = items + ","; }
      items = items + canonical(value[i]);
    }
    return "[" + items + "]";
  }
  const keys = sorted_keys(value);
  let members = "";
  for (let i = 0; i < keys.length; i = i + 1) {
    if (i > 0) { members = members + ","; }
    members = members + JSON.stringify(keys[i]) + ":" + canonical(value[keys[i]]);
  }
  return "{" + members + "}";
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const meta = rh.symlink_metadata(path);
  return meta.is_file === true && meta.is_symlink !== true;
}

function direct_directory(path) {
  if (!rh.exists(path)) { return false; }
  const meta = rh.symlink_metadata(path);
  return meta.is_dir === true && meta.is_symlink !== true;
}

function bounded_json_file(path, max_bytes, code) {
  ensure(direct_file(path), code + "_missing");
  const meta = rh.metadata(path);
  ensure(typeof meta.len === "number" && meta.len > 0 && meta.len <= max_bytes,
    code + "_size");
  const text = rh.read_text(path);
  ensure(text.length <= max_bytes, code + "_read_size");
  try { return JSON.parse(text); }
  catch (_) { throw code + "_json"; }
}

function exact_stage_schema(stages, name, required, optional, variants) {
  const stage = stages[name];
  const variant = variants !== null;
  ensure(exact_object(stage, variant
      ? ["required", "optional", "one_of"] : ["required", "optional"]),
    "profile_binding_v2_template_stage_shape");
  ensure(canonical(stage.required) === canonical(required)
      && canonical(stage.optional) === canonical(optional),
    "profile_binding_v2_template_stage_contract");
  if (variant) {
    ensure(Array.isArray(stage.one_of)
        && canonical(stage.one_of) === canonical(variants),
      "profile_binding_v2_template_stage_variants");
  }
}

function validate_template_contract(template) {
  ensure(exact_object(template, ["schema", "experiment", "limits",
      "identity_domains", "journal_keys", "ledger_keys", "receipt_keys",
      "criteria_keys", "stages"]), "profile_binding_v2_template_keys");
  ensure(template.schema === "agenterm.profile-binding-v2-result-template/v1"
      && template.experiment === EXPERIMENT,
    "profile_binding_v2_template_identity");
  ensure(exact_object(template.limits, ["journal_max_rows_exclusive",
      "journal_max_row_bytes_exclusive", "journal_max_total_bytes_exclusive"])
      && template.limits.journal_max_rows_exclusive === 64
      && template.limits.journal_max_row_bytes_exclusive === 32768
      && template.limits.journal_max_total_bytes_exclusive === 1048576,
    "profile_binding_v2_template_limits");
  ensure(exact_string_array(template.identity_domains, [
    "acu.profile-binding-v2.owner-identity/v1",
    "acu.profile-binding-v2.browser-identity/v1",
    "acu.profile-binding-v2.host-identity/v1",
    "acu.profile-binding-v2.connection-identity/v1",
    "acu.profile-binding-v2.inventory-row/v1",
    "acu.profile-binding-v2.candidate-profile/v1",
    "acu.profile-binding-v2.candidate-installation/v1",
    "acu.profile-binding-v2.candidate-root/v1",
    "acu.profile-binding-v2.live-root/v1",
    "acu.profile-binding-v2.strict-status/v1",
    "acu.profile-binding-v2.construction-trace/v1",
    "acu.profile-binding-v2.surface-clause/v1",
    "acu.profile-binding-v2.ground-truth-pair/v1",
    "acu.profile-binding-v2.fault-matrix/v1"
  ]), "profile_binding_v2_template_identity_domains");
  ensure(exact_string_array(template.journal_keys, ["schema", "experiment",
      "kind", "ordinal", "run_id", "seq", "prev_sha256", "stage",
      "producer", "deadline_ms", "elapsed_ms", "code", "facts"]),
    "profile_binding_v2_template_journal_keys");
  ensure(exact_string_array(template.ledger_keys, ["schema", "experiment",
      "kind", "ordinal", "run_id", "source_sha", "input_digest", "status",
      "receipt_sha256", "terminal_code"]),
    "profile_binding_v2_template_ledger_keys");
  ensure(exact_string_array(template.receipt_keys, ["schema", "experiment",
      "kind", "ordinal", "run_id", "source_sha", "input_digest",
      "journal_final_seq", "journal_final_sha256", "last_completed_stage",
      "deadline_ms", "code", "facts", "criteria"]),
    "profile_binding_v2_template_receipt_keys");
  ensure(exact_string_array(template.criteria_keys, ["V1", "V2", "V3",
      "V3a", "V3b", "V4a", "V4b", "G1", "G2a", "G2b", "G3",
      "G4a", "G4c", "G6", "G7"]),
    "profile_binding_v2_template_criteria_keys");
  ensure(exact_object(template.stages, ["preflight", "baseline",
      "session-ready", "connection-ready", "fixture", "ownership",
      "candidate", "surface", "a0-control", "prefix-control",
      "binding-model", "stop", "termination-proof", "final-inventory",
      "registry-hygiene", "root-removal", "terminal"]),
    "profile_binding_v2_template_stages");

  exact_stage_schema(template.stages, "preflight", {
    source_sha:"git_sha", input_digest:"sha256", agenterm_sha256:"sha256",
    agenterm_cu_sha256:"sha256", browser_sha256:"sha256",
    browser_family:"string", browser_version:"string",
    state_chain_valid:"boolean"
  }, {result_template_sha256:"sha256"}, null);
  exact_stage_schema(template.stages, "baseline", {
    row_count:"safe_integer", normalized_row_digest:"sha256", complete:"boolean"
  }, {baseline_preserved:"boolean", owned_delta:"boolean"}, null);
  exact_stage_schema(template.stages, "session-ready", {}, {}, [
    {required:{owner_identity_digest:"sha256", browser_identity_digest:"sha256",
      ready:"boolean"}, optional:{complete:"boolean"}},
    {required:{ready:"boolean", complete:"boolean", failure_class:"string"},
      optional:{}}
  ]);
  exact_stage_schema(template.stages, "connection-ready", {}, {}, [
    {required:{host_identity_digest:"sha256", row_count:"safe_integer",
      ready:"boolean", complete:"boolean"}, optional:{}},
    {required:{host_identity_digest:"sha256",
      connection_identity_digest:"sha256", ready:"boolean",
      complete:"boolean"}, optional:{}}
  ]);
  exact_stage_schema(template.stages, "fixture", {
    extension_id:"string", strict_status_digest:"sha256",
    extension_identity_match:"boolean", status_identity_match:"boolean",
    build_identity_match:"boolean", native_host_identity_digest:"sha256",
    construction_trace_digest:"sha256", construction_trace_complete:"boolean"
  }, {}, null);
  exact_stage_schema(template.stages, "ownership", {}, {}, [
    {required:{owner_identity_digest:"sha256", browser_identity_digest:"sha256",
      host_identity_digest:"sha256", tree_row_count:"safe_integer",
      ps_row_count:"safe_integer", browser_pgid_exact:"boolean",
      host_pgid_exact:"boolean", sid_equal_nonzero:"boolean",
      parent_chain_exact:"boolean", tree_contains_host:"boolean",
      owner_identity_match:"boolean", browser_identity_match:"boolean",
      host_identity_match:"boolean"}, optional:{}},
    {required:{owner_identity_digest:"sha256", browser_identity_digest:"sha256",
      host_identity_digest:"sha256", connection_identity_digest:"sha256",
      tree_row_count:"safe_integer", ps_row_count:"safe_integer",
      browser_pgid_exact:"boolean", host_pgid_exact:"boolean",
      sid_equal_nonzero:"boolean", parent_chain_exact:"boolean",
      tree_contains_host:"boolean", owner_identity_match:"boolean",
      browser_identity_match:"boolean", host_identity_match:"boolean"}, optional:{}}
  ]);
  exact_stage_schema(template.stages, "candidate", {}, {}, [
    {required:{local_state_digest:"sha256", local_state_row_count:"safe_integer",
      N_all:"safe_integer"}, optional:{}},
    {required:{preferences_digest:"sha256", preferences_row_count:"safe_integer",
      candidate_root_identity_digest:"sha256", live_root_identity_digest:"sha256",
