// acu.dynamic.074 discriminator court: owned Chromium wheel oracle.
//
// Research only. This court starts one caller-selected Chromium executable
// with an invocation-owned profile and fixed loopback CDP endpoint, opens B
// first and A second so B is not the key window, raises a caller-selected guard
// fixture to the foreground, resolves B's exact CGWindowID from the browser
// PID plus unique title and stable native bounds, then runs 20 seeded triplets
// of the frozen three arms through the
// caller-selected injector and reads the wheel counts back independently over
// CDP. It emits exactly one verdict JSON on stdout and nothing else.
//
// Args: REPO AGENTERM_CU_EXE CHROMIUM_EXE INJECTOR_EXE GUARD_FIXTURE_EXE SOURCE_SHA PROBE_DIGEST
//   SOURCE_SHA and PROBE_DIGEST are computed by the outer runner over the
//   repo-relative labels + contents of page.html, court-chromium.qjs, the
//   injector and guard sources and the runner itself; this court never
//   computes them, it only echoes them into the verdict.
// Run with `--project-root scripts/qjs` so `lib/rh_compat` and
// `lib/test_harness` resolve exactly as they do for the public courts.
// or:   --list-evidence   (this court registers no evidence; prints nothing)
//
// Injector contract (frozen by the experiment owner):
//   INJECTOR_EXE --arm private|public-loc|public-off --pid PID --window CGID
//                --x X --y Y --off-x X --off-y Y --dx 0 --dy 3
//                --guard-state PATH
//   stdout is one JSON object; the court requires ok === true and
//   host_unchanged === true, anything else is INCONCLUSIVE.
//
// Verdict JSON: verdict, seed, triplets, private_exact_count,
// public_loc_exact_count, public_off_target_count, cleanup_verified, plus the
// identity and coordinate facts needed to reproduce the run.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const TRIPLETS = 20;
const SEED = 20260909;
const ARMS = ["private", "public-loc", "public-off"];
const WHEEL_DX = 0;
const WHEEL_DY = 3;
const FRAME_A = { x: 40, y: 80, width: 520, height: 400 };
const FRAME_B = { x: 700, y: 80, width: 520, height: 400 };

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const result = at(value, dotted);
  return result === undefined || result === null ? "" : "" + result;
}

function half(value) {
  return (value - (value % 2)) / 2;
}

function number_at(value, dotted) {
  const raw = text_at(value, dotted);
  if (raw === "") { return 0; }
  return rh.parse_int(raw);
}

// Deterministic LCG so every run with the same seed visits the arms in the
// same recorded order; the seed is part of the verdict.
let rng_state = SEED;
function next_random() {
  rng_state = (rng_state * 1103515245 + 12345) % 2147483648;
  return rng_state;
}

function arm_order_for_round() {
  const order = [];
  let pool = [];
  for (const arm of ARMS) { pool.push(arm); }
  while (pool.length > 0) {
    const index = next_random() % pool.length;
    order.push(pool[index]);
    const rest = [];
    for (let i = 0; i < pool.length; i = i + 1) {
      if (i !== index) { rest.push(pool[i]); }
    }
    pool = rest;
  }
  return order;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  return;
}
harness.require(args.length === 7,
  "expected: REPO AGENTERM_CU_EXE CHROMIUM_EXE INJECTOR_EXE GUARD_FIXTURE_EXE SOURCE_SHA PROBE_DIGEST");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const chromium = rh.absolute(args[2]);
const injector = rh.absolute(args[3]);
const guard_fixture = rh.absolute(args[4]);
const source_sha = "" + args[5];
const probe_digest = "" + args[6];

const context = harness.new_context(repo, "acu-074-chromium-discriminator");
const run_directory = context.run_directory;
const nonce = "" + context.run_id;
const page_path = rh.join(repo, "research/skylight-window-local-pointer/fixture-chromium/page.html");
const guard_state = rh.join(run_directory, "guard.json");
const cu_env = {
  AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
  AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
  AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(run_directory, "cu-idempotency.json"),
  AGENTERM_NO_ACTIVATE: "1"
};

function invoke(grant, arguments) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: cu_env,
    timeout_ms: 60000
  });
  const text = output.stdout.trim();
  ensure(text !== "", "acu074_empty_reply:" + argv.join(" ") + ":" + output.stderr);
  return { output: output, reply: JSON.parse(text) };
}

function require_ok(result, label) {
  ensure(result.output.success === true && result.reply.ok === true,
    label + ":" + JSON.stringify(result.reply));
  return result.reply;
}

function page_url(label) {
  return "file://" + page_path + "?label=" + label + "&nonce=" + nonce;
}

function page_title(label) {
  return "acu-074-" + label + "-" + nonce;
}

// Native window rows carry {handle, process_id, title, bounds{x,y,width,height}}.
function native_windows_for(pid) {
  const reply = require_ok(invoke("observe", ["windows", "--pid", "" + pid, "--max", "8"]),
    "acu074_native_windows_failed");
  const rows = [];
  for (const row of reply.data.windows) {
    if (row.process_id === pid) { rows.push(row); }
  }
  return rows;
}

function native_window_by_title(pid, title) {
  let found = null;
  for (const row of native_windows_for(pid)) {
    if (row.title === title) {
      ensure(found === null, "acu074_native_title_ambiguous:" + title);
      found = row;
    }
  }
  ensure(found !== null, "acu074_native_title_missing:" + title);
  return found;
}

function bounds_distinct(left, right) {
  return left.x !== right.x || left.y !== right.y
    || left.width !== right.width || left.height !== right.height;
}

function place_frame(handle, frame) {
  const placed = require_ok(invoke("observe,actuate", [
    "window-place", "--action", "frame", "--window", "" + handle,
    "--x", "" + frame.x, "--y", "" + frame.y,
    "--width", "" + frame.width, "--height", "" + frame.height
  ]), "acu074_window_place_failed:" + handle);
  return placed;
}

function page_target_by_title(port, title) {
  const targets = require_ok(invoke("observe", ["page-targets", "--port", "" + port]),
    "acu074_page_targets_failed");
  let found = null;
  for (const row of targets.data.targets) {
    if (row.type === "page" && row.title === title) {
      ensure(found === null, "acu074_page_target_ambiguous:" + title);
      found = row;
    }
  }
  ensure(found !== null, "acu074_page_target_missing:" + title);
  return "" + found.id;
}

function page_js(port, target_id, expression) {
  const reply = require_ok(invoke("observe", [
    "page-js", "--port", "" + port, "--target-id", target_id, "--expression", expression
  ]), "acu074_page_js_failed:" + target_id);
  return reply.data.value;
}

function reset_counts(port, target_id, label) {
  const value = "" + page_js(port, target_id, "window.__agentermWheel.reset()");
  ensure(value === "reset:" + label, "acu074_reset_readback:" + label + ":" + value);
}

function snapshot_counts(port, target_id, label) {
  const raw = page_js(port, target_id, "window.__agentermWheel.snapshot()");
  const snapshot = JSON.parse("" + raw);
  ensure(snapshot.label === label && snapshot.nonce === nonce,
    "acu074_snapshot_identity:" + label + ":" + raw);
  return snapshot;
}

function oracle_self_test(port, target_id, label) {
  reset_counts(port, target_id, label);
  const raw = page_js(port, target_id,
    "window.__agentermWheel.selfTest(" + WHEEL_DX + "," + WHEEL_DY + ")");
  const snapshot = JSON.parse("" + raw);
  ensure(snapshot.label === label && snapshot.count === 1
    && snapshot.last !== null && snapshot.last.kind === "wheel"
    && snapshot.last.deltaX === WHEEL_DX && snapshot.last.deltaY === WHEEL_DY,
    "acu074_oracle_self_test_failed:" + label + ":" + raw);
  reset_counts(port, target_id, label);
}

function exact_wheel_delivery(target, peer) {
  return target.count === 1 && peer.count === 0
    && target.last !== null && target.last.kind === "wheel"
    && target.last.deltaX === WHEEL_DX && target.last.deltaY !== 0;
}

function guard_ready(deadline_ms) {
  while (rh.now_ms() < deadline_ms) {
    if (rh.exists(guard_state)) {
      const text = rh.read_text(guard_state);
      if (text.trim() !== "") { return JSON.parse(text); }
    }
    rh.sleep_ms(20);
  }
  throw "acu074_guard_readiness_timeout";
}

function focused_native_window() {
  const reply = require_ok(invoke("observe", ["windows", "--focused", "true", "--max", "2"]),
    "acu074_focused_window_failed");
  ensure(reply.data.returned === 1, "acu074_focused_window_ambiguous");
  return reply.data.windows[0];
}

function run_injector(arm, browser_pid, target_window, target_point, off_point) {
  const argv = [
    "--arm", arm,
    "--pid", "" + browser_pid,
    "--window", "" + target_window,
    "--x", "" + target_point.x, "--y", "" + target_point.y,
    "--off-x", "" + off_point.x, "--off-y", "" + off_point.y,
    "--dx", "" + WHEEL_DX, "--dy", "" + WHEEL_DY,
    "--guard-state", guard_state
  ];
  const output = rh.command(injector, argv, {
    cwd: run_directory,
    env: cu_env,
    timeout_ms: 30000
  });
  const text = output.stdout.trim();
  ensure(output.success === true && text !== "",
    "acu074_injector_failed:" + arm + ":" + output.stdout + output.stderr);
  const reply = JSON.parse(text);
  ensure(reply.ok === true, "acu074_injector_not_ok:" + arm + ":" + text);
  ensure(reply.host_unchanged === true, "acu074_injector_host_changed:" + arm + ":" + text);
  return reply;
}

let chrome_child = -1;
let guard_child = -1;
let stage = "setup";
let failure = "";
let cleanup_verified = false;
let identity = null;
let triplets_run = 0;
let private_exact = 0;
let public_loc_exact = 0;
let public_off_target = 0;
let peer_hits = { private: 0, "public-loc": 0, "public-off": 0 };
const rounds = [];

try {
  ensure(direct_file(executable), "acu074_cu_executable_missing:" + executable);
  ensure(direct_file(chromium), "acu074_chromium_missing:" + chromium);
  ensure(direct_file(injector), "acu074_injector_missing:" + injector);
  ensure(direct_file(guard_fixture), "acu074_guard_fixture_missing:" + guard_fixture);
  ensure(direct_file(page_path), "acu074_page_missing:" + page_path);
  ensure(source_sha !== "" && probe_digest !== "", "acu074_result_identity_missing");

  const profile = rh.join(run_directory, "chrome-profile");
  const port = 9600 + (rh.pid() % 300);
  const stale = rh.command("curl", [
    "-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"
  ], { cwd: run_directory, timeout_ms: 3000 });
  ensure(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
    "acu074_cdp_port_in_use:" + port);

  stage = "browser-launch-b";
  chrome_child = harness.start({
    program: chromium,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--no-first-run",
      "--no-default-browser-check",
      "--new-window",
      page_url("B")
    ],
    current_dir: run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 600000
  });
  const browser_pid = harness.spawned_pid(chrome_child);
  let cdp_ready = false;
  for (let attempt = 0; attempt < 120; attempt = attempt + 1) {
    const probe = rh.command("curl", [
      "-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"
    ], { cwd: run_directory, timeout_ms: 3000 });
    if (probe.success === true && probe.stdout.indexOf("Browser") >= 0) {
      cdp_ready = true;
      break;
    }
    rh.sleep_ms(250);
  }
  ensure(cdp_ready, "acu074_cdp_readiness_timeout");

  stage = "browser-launch-a";
  const opened_a = rh.command(chromium, [
    "--user-data-dir=" + profile,
    "--remote-debugging-port=" + port,
    "--remote-debugging-address=127.0.0.1",
    "--new-window",
    page_url("A")
  ], {
    cwd: run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 15000
  });
  ensure(opened_a.success === true, "acu074_open_a_failed:" + opened_a.stderr);

  stage = "native-candidates";
  let candidate_a = null;
  let candidate_b = null;
  const discovery_deadline = rh.now_ms() + 15000;
  while (rh.now_ms() < discovery_deadline && (candidate_a === null || candidate_b === null)) {
    const rows = native_windows_for(browser_pid);
    let seen_a = null;
    let seen_b = null;
    let ambiguous = false;
    for (const row of rows) {
      if (row.title === page_title("A")) { if (seen_a !== null) { ambiguous = true; } seen_a = row; }
      if (row.title === page_title("B")) { if (seen_b !== null) { ambiguous = true; } seen_b = row; }
    }
    ensure(!ambiguous, "acu074_native_candidate_ambiguous");
    if (seen_a !== null && seen_b !== null) {
      candidate_a = seen_a;
      candidate_b = seen_b;
      break;
    }
    rh.sleep_ms(100);
  }
  ensure(candidate_a !== null && candidate_b !== null, "acu074_native_candidates_missing");
  ensure(candidate_a.handle !== candidate_b.handle, "acu074_native_handles_collide");

  stage = "window-place";
  place_frame(candidate_a.handle, FRAME_A);
  place_frame(candidate_b.handle, FRAME_B);
  rh.sleep_ms(300);

  stage = "bijection";
  const native_a = native_window_by_title(browser_pid, page_title("A"));
  const native_b = native_window_by_title(browser_pid, page_title("B"));
  ensure(bounds_distinct(native_a.bounds, native_b.bounds), "acu074_native_bounds_not_distinct");
  const target_window = native_b.handle;
  const peer_window = native_a.handle;
  const browser_front = focused_native_window();
  ensure(browser_front.process_id === browser_pid && browser_front.handle === peer_window,
    "acu074_target_b_is_key_window:" + JSON.stringify(browser_front));

  stage = "guard";
  guard_child = harness.start({
    program: guard_fixture,
    args: ["--role", "guard", "--state", guard_state],
    current_dir: run_directory,
    env: {},
    timeout_ms: 600000
  });
  const guard = guard_ready(rh.now_ms() + 10000);
  ensure(guard.pid > 0, "acu074_guard_pid");
  rh.sleep_ms(300);
  const front = focused_native_window();
  ensure(front.process_id === guard.pid, "acu074_guard_not_frontmost:" + JSON.stringify(front));
  const native_b_after_guard = native_window_by_title(browser_pid, page_title("B"));
  ensure(native_b_after_guard.handle === target_window
    && !bounds_distinct(native_b_after_guard.bounds, native_b.bounds),
    "acu074_target_b_moved_after_guard");

  stage = "page-targets";
  const target_a = page_target_by_title(port, page_title("A"));
  const target_b = page_target_by_title(port, page_title("B"));
  ensure(target_a !== target_b, "acu074_page_targets_collide");

  stage = "oracle-self-test";
  oracle_self_test(port, target_a, "A");
  oracle_self_test(port, target_b, "B");

  // B screen point (center of B) and a recorded off-target point placed at the
  // center of A: it is outside B by construction because the two frames are
  // mutually distinct and non-overlapping.
  const target_point = {
    x: native_b.bounds.x + half(native_b.bounds.width),
    y: native_b.bounds.y + half(native_b.bounds.height)
  };
  const off_point = {
    x: native_a.bounds.x + half(native_a.bounds.width),
    y: native_a.bounds.y + half(native_a.bounds.height)
  };
  ensure(off_point.x < native_b.bounds.x || off_point.x >= native_b.bounds.x + native_b.bounds.width
    || off_point.y < native_b.bounds.y || off_point.y >= native_b.bounds.y + native_b.bounds.height,
    "acu074_off_point_inside_target");

  identity = {
    browser_pid: browser_pid,
    cdp_port: port,
    target: { label: "B", cg_window: target_window,
              bounds: native_b.bounds, target_id: target_b },
    peer: { label: "A", cg_window: peer_window,
            bounds: native_a.bounds, target_id: target_a },
    guard_pid: guard.pid,
    target_point: target_point,
    off_point: off_point
  };

  stage = "triplets";
  for (let round = 0; round < TRIPLETS; round = round + 1) {
    const order = arm_order_for_round();
    const round_record = { round: round + 1, order: order, results: [] };
    for (const arm of order) {
      reset_counts(port, target_a, "A");
      reset_counts(port, target_b, "B");
      const before_front = focused_native_window();
      ensure(before_front.process_id === guard.pid, "acu074_guard_lost_before:" + arm);
      const injected = run_injector(arm, browser_pid, target_window, target_point, off_point);
      // A full no-delivery observation window is required for both public
      // controls; stopping at the first change would bias the comparison.
      rh.sleep_ms(500);
      const snap_b = snapshot_counts(port, target_b, "B");
      const snap_a = snapshot_counts(port, target_a, "A");
      const after_front = focused_native_window();
      ensure(after_front.process_id === guard.pid, "acu074_guard_lost_after:" + arm);
      const exact = exact_wheel_delivery(snap_b, snap_a);
      if (arm === "private" && exact) { private_exact = private_exact + 1; }
      if (arm === "public-loc" && exact) { public_loc_exact = public_loc_exact + 1; }
      if (arm === "public-off" && snap_b.count > 0) { public_off_target = public_off_target + 1; }
      if (snap_a.count > 0) { peer_hits[arm] = peer_hits[arm] + 1; }
      round_record.results.push({
        arm: arm,
        target_count: snap_b.count,
        peer_count: snap_a.count,
        target_last: snap_b.last,
        injector: injected
      });
    }
    rounds.push(round_record);
    triplets_run = triplets_run + 1;
  }
  stage = "done";
} catch (error) {
  failure = "" + error;
}

// Cleanup always runs; its outcome is part of the verdict.
let cleanup_failure = "";
try {
  if (guard_child >= 0) {
    if (harness.state(guard_child) === "running") { harness.kill(guard_child); }
    const guard_exit = harness.wait(guard_child, 2000);
    ensure(guard_exit.timed_out !== true, "acu074_guard_cleanup_timeout");
  }
  if (chrome_child >= 0) {
    if (harness.state(chrome_child) === "running") { harness.kill(chrome_child); }
    const chrome_exit = harness.wait(chrome_child, 5000);
    ensure(chrome_exit.timed_out !== true, "acu074_chromium_cleanup_timeout");
  }
  cleanup_verified = true;
} catch (error) {
  cleanup_failure = "" + error;
}

let verdict = "INCONCLUSIVE";
if (failure === "" && cleanup_failure === "" && triplets_run === TRIPLETS) {
  if (private_exact < TRIPLETS) {
    verdict = "FAIL_PRIVATE";
  } else if (public_loc_exact === 0) {
    verdict = "PASS";
  } else if (public_loc_exact === TRIPLETS && public_off_target === 0) {
    verdict = "FAIL_NONDISTINGUISHING";
  } else {
    verdict = "INCONCLUSIVE_UNSTABLE";
  }
}

const report = {
  verdict: verdict,
  source_sha: source_sha,
  probe_digest: probe_digest,
  seed: SEED,
  triplets: triplets_run,
  private_exact_count: private_exact,
  public_loc_exact_count: public_loc_exact,
  public_off_target_count: public_off_target,
  cleanup_verified: cleanup_verified,
  peer_hits: peer_hits,
  wheel: { dx: WHEEL_DX, dy: WHEEL_DY },
  identity: identity,
  rounds: rounds,
  stage: stage,
  failure: failure,
  cleanup_failure: cleanup_failure,
  run_id: nonce
};
print(JSON.stringify(report));

if (verdict === "INCONCLUSIVE" || verdict === "INCONCLUSIVE_UNSTABLE" || cleanup_failure !== "") {
  throw "acu074_" + verdict + (failure !== "" ? ":" + failure : "")
    + (cleanup_failure !== "" ? ":" + cleanup_failure : "");
}
harness.remove_run(context);
return;
