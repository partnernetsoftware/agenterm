// Live R1 court for the browser profile-name binding exact-process experiment.
//
// This entry is the real live court, and it must run as a registered
// `profile: "tool"` task. It implements the code path that will execute the
// one rehearsal ordinal, but it is written so that NOTHING in this file can
// launch a browser or touch the formal state root unless the caller supplies
// an explicit live grant that this slice does not yet accept.
//
// Two modes exist, and only the first is reachable today:
//
//   * `--live-self-test` drives the whole court against an INJECTED fixture:
//     a fake observation source and a fake inventory. No browser is launched,
//     no real process is observed for ownership, and no ordinal is reserved.
//     This is what proves the chain, identity-drift, unknown/dead and cleanup
//     logic, including its adversarial cases.
//   * `live` / `rehearsal` / `decision` are refused with a typed code. The
//     runner also refuses them before this file is reached. Spec §4 kill
//     criterion 4: no live ordinal may be reserved while the throw-site proof
//     is not yet reviewed, and §2 says no browser is launched before that.
//
// Spec: plan/design-browser-profile-name-binding-exact-process-experiment.md
//
// Provenance: the chain classification deliberately does NOT reimplement the
// frozen model. Every step is handed to
// `binding-model.classify_chain`, which is the single authority for §1.3/§1.4.
// This file only OBSERVES and ADAPTS: it turns real `process.observe` /
// `process.parent` records into the step shape the model classifies, and it
// passes reconstructed V3-V7 booleans to the model's `decide`. The cleanup
// input whitelist and the selector-independence rule are likewise the model's
// (`selector_independence_verdict`), not a second copy.
//
// The `cleanup_status` string values and the stage vocabulary come from
// `result-template.json`, which is read rather than restated.

import * as rh from "scripts/qjs/lib/rh_compat";
import * as model from "research/browser-profile-name-binding-exact-process/binding-model";

const MODE_SELF_TEST = "live-self-test";
const MODE_PROCESS_PREFLIGHT = "live-process-preflight";

// Refusals for the modes this slice must not execute. These are returned, not
// thrown: a caller asking for a live run should read a typed code rather than
// a stack of failure text.
const LIVE_REFUSAL_CODE = "LIVE_COURT_NOT_ENABLED";
const LIVE_REFUSAL_REASON =
  "the live court requires a reviewed throw-site proof and an explicit grant";


// Spec §1.4: the parent chain has a fixed ceiling of 64 edges.
const CHAIN_CEILING = 64;

function demand(condition, code) {
  if (!condition) { throw code; }
}

function canonical_json(value) {
  const keys = Object.keys(value).sort();
  const parts = [];
  for (let i = 0; i < keys.length; i = i + 1) {
    parts.push(JSON.stringify(keys[i]) + ":" + JSON.stringify(value[keys[i]]));
  }
  return "{" + parts.join(",") + "}";
}

// --- red-gate adversaries ----------------------------------------------------
//
// These hooks exist ONLY so the red gate can inject the adversaries the
// real-path guards exist to catch. A correctly-behaving owned child never drifts
// its identity and is never `unknown`, so removing a guard against those cases
// would leave the preflight green and prove nothing about the guard.
//
// Each hook is a single-expression passthrough on the real path, so a mutation
// that flips one expression is a valid, attributable red. They are inert unless a
// mutation changes them.
const DRIFT_MODE = "off";
const UNKNOWN_MODE = "off";

// The closing half of the chain bracket. `DRIFT_MODE = "drift"` returns a
// DIFFERENT identity for the same pid, which is what a reused pid looks like.
function bracket_after_observe(source, pid) {
  const seen = source.observe(pid);
  if (DRIFT_MODE === "drift" && seen.state === "live") {
    return {state: "live", start_identity: seen.start_identity + "-drifted"};
  }
  return seen;
}

// Injects an UNREADABLE observation, which must never be read as death.
function injected_unknown(pid) {
  if (UNKNOWN_MODE === "unknown" && pid > 0) {
    return {state: "unknown", start_identity: null, reason: "process_access_denied"};
  }
  return {state: "live", start_identity: null};
}

// --- the observation boundary ------------------------------------------------
//
// Ownership reads processes ONLY through these two functions. A fixture source
// replaces them wholesale in the self-test, which is why the whole court can be
// exercised without a browser. Nothing else in this file may call
// `process_observe` or `process_parent`.

// The real source. It adapts the door's exact-key records into the model's
// step vocabulary and nothing more.
//
// The door emits a PER-STATE SHAPE (`tool.rs` `process_observation_json`):
//
//   live    -> {state:"live",    start_identity:<string>}
//   dead    -> {state:"dead",    reason:<string>}
//   unknown -> {state:"unknown", reason:<string>}
//
// and the parent door is identical except that the live payload key is
// `parent_id`. A parser that demanded `start_identity` on every record would
// therefore kill a `dead` or `unknown` read at the shape check, before the
// chain logic could classify it — which is exactly backwards, since `unknown`
// must reach the identity logic and `dead` must reach the termination logic.
//
// These two functions are pure: they take the parsed record and return either a
// typed value or a typed refusal. Keeping them pure is what lets the self-test
// and the red gate drive every variant without a live process.
// Read a parsed value's reason without crashing a scene when a mutated parser
// returned something else. A scene that crashes the whole suite would report a
// compiler/runtime diagnostic instead of a named failing check, and a crash is
// not evidence that the guard under test is load-bearing.
function observed_reason(parsed) {
  if (parsed.ok !== true || parsed.value === null
      || parsed.value === undefined) {
    return "";
  }
  const reason = parsed.value.reason;
  return typeof reason === "string" ? reason : "";
}

function parse_observation(raw) {
  const state = raw.state;
  if (state === "live") {
    const keys = Object.keys(raw).sort().join(",");
    if (keys !== "start_identity,state") {
      return {ok: false, code: "live_observe_shape:" + keys};
    }
    // `ProcessObservation::Live` carries `Option<String>`: null is a valid
    // door value meaning identity is unavailable. Preserve it so the chain
    // classifier can return INCONCLUSIVE_PROCESS_IDENTITY as §1.3 requires;
    // only an invalid JSON type or an empty claimed identity is a door-shape
    // refusal.
    if (raw.start_identity !== null
        && (typeof raw.start_identity !== "string"
          || raw.start_identity === "")) {
      return {ok: false, code: "live_observe_identity"};
    }
    return {ok: true, value: {state: "live", start_identity: raw.start_identity}};
  }
  if (state === "dead" || state === "unknown") {
    const keys = Object.keys(raw).sort().join(",");
    if (keys !== "reason,state") {
      return {ok: false, code: "nonlive_observe_shape:" + keys};
    }
    // The reason is preserved rather than discarded: it is the only thing that
    // distinguishes "this pid is gone" from "this pid could not be read", and
    // the court reports it so a reviewer can tell the two apart.
    if (typeof raw.reason !== "string" || raw.reason === "") {
      return {ok: false, code: "nonlive_observe_reason"};
    }
    return {ok: true, value: {state: state, start_identity: null,
      reason: raw.reason}};
  }
  return {ok: false, code: "live_observe_state:" + state};
}

function parse_parent_observation(raw) {
  const state = raw.state;
  if (state === "live") {
    const keys = Object.keys(raw).sort().join(",");
    if (keys !== "parent_id,state") {
      return {ok: false, code: "live_parent_shape:" + keys};
    }
    if (typeof raw.parent_id !== "number") {
      return {ok: false, code: "live_parent_id"};
    }
    return {ok: true, value: {state: "live", parent_id: raw.parent_id}};
  }
  if (state === "dead" || state === "unknown") {
    const keys = Object.keys(raw).sort().join(",");
    if (keys !== "reason,state") {
      return {ok: false, code: "nonlive_parent_shape:" + keys};
    }
    if (typeof raw.reason !== "string" || raw.reason === "") {
      return {ok: false, code: "nonlive_parent_reason"};
    }
    return {ok: true, value: {state: state, parent_id: null,
      reason: raw.reason}};
  }
  return {ok: false, code: "live_parent_state:" + state};
}

// The live binding. THIS IS DELIBERATELY UNCALLED in this slice: every live mode
// is refused, so nothing may bind the real door. It is kept because it is the
// only place the door calls and the pure adapters are joined, and its parser half
// (`parse_observation` / `parse_parent_observation`) IS exercised against the
// real door by the self-test. When the live path is enabled this becomes the
// source handed to `walk_ownership_chain`; until then it is a named, reviewed
// seam rather than dead code that pretends to run.
// `hook` is optional and defaults to a no-op, so the ordinary process path is
// completely unchanged. The STAGED slice passes a hook so each REAL door call the
// walk performs is traced at its own call site.
//
// The hook must fire here, around the actual `process_observe`/`process_parent`
// calls, and NOT at construction: building this object performs no process call at
// all, and the walk invokes `observe`/`parent` many times. Tracing the
// construction would record a call that never happened -- fake evidence. The walk
// is what proves ownership, so every one of its reads must be visible.
function real_observation_source(hook) {
  const note = hook === undefined ? function (event) { return event; } : hook;
  return {
    observe: function (pid) {
      demand(typeof pid === "number" && pid > 0, "live_observe_pid");
      note("ownership_observe");
      const status = process_observe(pid);
      demand(status === 0, "live_observe:" + tool_result());
      const parsed = parse_observation(JSON.parse(tool_result()));
      // A shape refusal is a DOOR CONTRACT change, not an observation value, so
      // it throws rather than being folded into the chain classification.
      demand(parsed.ok === true, parsed.code);
      return parsed.value;
    },
    // `live` here means only that a native record supplied a parent id; it never
    // proves liveness. That is why the chain brackets this call with two
    // observations.
    parent: function (pid) {
      demand(typeof pid === "number" && pid > 0, "live_parent_pid");
      note("ownership_parent");
      const status = process_parent(pid);
      demand(status === 0, "live_parent:" + tool_result());
      const parsed = parse_parent_observation(JSON.parse(tool_result()));
      demand(parsed.ok === true, parsed.code);
      return parsed.value;
    }
  };
}

// --- §1.3 / §1.4 chain walk --------------------------------------------------
//
// Each loop iteration is one bracket:
//
//   before  = observe(current)          <- establishes/confirms current identity
//   record  = parent(current)           <- the relation, between the brackets
//   after   = observe(current)          <- closes the bracket
//
// The NEXT node's identity is established by the first `observe` of the next
// iteration, because `process.parent` reports only a parent id. This is the
// decided reading of §1.3: the bracket proves the CURRENT node did not change
// across its own relation read; the successor's identity is proven by its own
// bracket, not carried forward.
//
// The successor's pid is therefore appended with identity unknown, and the next
// iteration's `before` fills it in before that node's relation is read. A node
// whose identity cannot be established fails in `observe`, never silently.
//
// `subject_identity` is the FROZEN identity of the first node (the owned subject),
// as reported by `process.identity(handle)`. It is required: without it the walk
// would accept whatever identity happened to be live at that pid, which is the
// same pid-reuse hole the bracket exists to close. The first node's bracket must
// match this value exactly on BOTH sides, so passing null is refused rather than
// silently skipped.
function walk_ownership_chain(source, subject_pid, subject_identity,
    browser_pid, browser_identity) {
  const pids = [];
  const brackets = [];
  const seen = [];
  let current = subject_pid;

  if (subject_identity === null || subject_identity === undefined
      || subject_identity === "") {
    return {ok: false, code: "INCONCLUSIVE_PROCESS_IDENTITY",
      reason: "subject_identity_missing"};
  }

  for (let hop = 0; hop < CHAIN_CEILING; hop = hop + 1) {
    const is_first = hop === 0;

    // A repeated pid is a cycle, and is refused before any further relation
    // read. This is the §1.4 "rejects a repeated PID" rule.
    if (list_has(seen, current)) {
      return {ok: false, code: "INCONCLUSIVE_OWNERSHIP", reason: "cycle"};
    }
    seen.push(current);

    const before = source.observe(current);
    if (before.state !== "live") {
      // `dead`, `unknown` or a missing identity is never absence: §4 kill
      // criterion 2 forbids reading it as dead or unrelated.
      return {ok: false, code: "INCONCLUSIVE_PROCESS_IDENTITY",
        reason: "before_" + before.state };
    }
    if (before.start_identity === null || before.start_identity === undefined) {
      return {ok: false, code: "INCONCLUSIVE_PROCESS_IDENTITY",
        reason: "before_no_identity"};
    }
    // THE FROZEN BINDING. The first node is the owned subject, and its identity
    // is not a free variable: it must equal what `process.identity(handle)`
    // froze at spawn. Checking only the pid would accept a reused pid, and
    // checking only "some live identity" would make the whole chain a statement
    // about an arbitrary process.
    if (is_first && before.start_identity !== subject_identity) {
      return {ok: false, code: "INCONCLUSIVE_PROCESS_IDENTITY",
        reason: "subject_identity_mismatch"};
    }

    // The relation read is bracketed for EVERY node, terminus included. The
    // bracket is what proves `current` did not change across the read; that
    // fact is needed at the terminus too, so the read cannot be moved after the
    // terminus test.
    const record = source.parent(current);

    const after = bracket_after_observe(source, current);
    if (after.state !== "live") {
      return {ok: false, code: "INCONCLUSIVE_PROCESS_IDENTITY",
        reason: "after_" + after.state };
    }
    if (after.start_identity === null || after.start_identity === undefined) {
      return {ok: false, code: "INCONCLUSIVE_PROCESS_IDENTITY",
        reason: "after_no_identity"};
    }
    if (before.start_identity !== after.start_identity) {
      // The pid was reused inside the bracket: this is exactly the drift the
      // bracket exists to detect.
      return {ok: false, code: "INCONCLUSIVE_PROCESS_IDENTITY",
        reason: "identity_drift"};
    }
    // The frozen binding must hold on the CLOSING side too: `before === after`
    // alone would still admit a pair of equal-but-wrong identities.
    if (is_first && after.start_identity !== subject_identity) {
      return {ok: false, code: "INCONCLUSIVE_PROCESS_IDENTITY",
        reason: "subject_identity_mismatch_after"};
    }

    if (current === browser_pid) {
      // TERMINUS, decided BEFORE the parent-live constraint below. The owned
      // browser is the root of the owned tree, so its parent relation is not
      // used to advance anywhere: a `live` parent id, PID 0, a self-parent, or
      // even a non-`live` parent record must all be able to close the chain.
      // Requiring a usable parent here would refuse a correct chain for a
      // relation the court never needs, and would contradict both this file's
      // contract and the model's terminus rule.
      //
      // The terminus is instead proven by what the chain is FOR: the pid matches
      // AND its identity is the frozen one, both bracketed.
      if (before.start_identity !== browser_identity) {
        return {ok: false, code: "INCONCLUSIVE_OWNERSHIP",
          reason: "terminus_identity"};
      }
      pids.push(current);
      brackets.push({before: before, parent: record, after: after});
      // The model re-checks the whole sequence, including the ceiling and the
      // terminus identity, from the same data this loop produced.
      const verdict = model.classify_chain(
        build_steps(pids, brackets), browser_pid, browser_identity);
      if (verdict.ok !== true) {
        return {ok: false, code: verdict.code, reason: "model_" + verdict.code};
      }
      return {ok: true, code: verdict.code, chain_length: verdict.chain_length,
        pids: pids, brackets: brackets, terminus_parent_state: record.state,
        // DERIVED, not asserted: the first bracket's own observations are what
        // prove the subject was live under the frozen identity while the chain
        // ran. A caller must not be able to claim this with a bare `true`.
        subject_identity: subject_identity,
        subject_was_live: brackets[0].before.state === "live"
          && brackets[0].after.state === "live"
          && brackets[0].before.start_identity === subject_identity
          && brackets[0].after.start_identity === subject_identity};
    }

    // Not the terminus: the parent relation must now be usable to advance.
    if (record.state !== "live" || typeof record.parent_id !== "number") {
      return {ok: false, code: "INCONCLUSIVE_OWNERSHIP",
        reason: "parent_" + record.state};
    }
    const parent_id = record.parent_id;
    if (parent_id === 0) {
      // Reaching PID 0 before the terminus means ownership is unproven.
      return {ok: false, code: "INCONCLUSIVE_OWNERSHIP", reason: "pid_zero"};
    }
    if (parent_id === current) {
      return {ok: false, code: "INCONCLUSIVE_OWNERSHIP", reason: "self_parent"};
    }
    pids.push(current);
    brackets.push({before: before, parent: record, after: after});
    current = parent_id;
  }

  // The ceiling is reached without terminating at the owned browser.
  return {ok: false, code: "INCONCLUSIVE_OWNERSHIP", reason: "ceiling"};
}

function build_steps(pids, brackets) {
  const steps = [];
  for (let i = 0; i < pids.length; i = i + 1) {
    steps.push({
      pid: pids[i],
      before: brackets[i].before,
      parent: brackets[i].parent,
      after: brackets[i].after
    });
  }
  return steps;
}

function list_has(list, value) {
  for (let i = 0; i < list.length; i = i + 1) {
    if (list[i] === value) { return true; }
  }
  return false;
}

// --- exact observe-to-dead termination (V4) ---------------------------------
//
// Cleanup is defined independently of any selector: its only inputs are the
// owned handle and the frozen identities. `input` uses exactly the model's
// cleanup whitelist, and the model's own `selector_independence_verdict`
// decides admissibility, so this file cannot widen the input shape.
//
// WHAT IS AND IS NOT IMPLEMENTED HERE. This is the **classifier**: given an
// observation source and an explicit clock, it decides TERMINATION_PROVEN or
// INCONCLUSIVE_CLEANUP. It does NOT perform a live wall-clock wait, because no
// live cleanup path is enabled in this slice (see the live-mode refusals). The
// clock and the wait are therefore INJECTED, which is also what makes the
// progress and budget behaviour testable: a fixture clock advances by a fixed
// step and can be made to stall or to cross the deadline deliberately.
//
// The clock object is `{now: () -> ms, sleep: (ms) -> void}`. The real live
// cleanup would pass a wall clock plus a real sleep. Nothing here claims one
// exists.
function observe_to_dead(source, frozen_identities, deadline_ms, clock) {
  const death = [];
  for (let i = 0; i < frozen_identities.length; i = i + 1) {
    const identity = frozen_identities[i];
    const outcome = observe_one_until_dead(source, identity, deadline_ms, clock);
    if (outcome.ok !== true) {
      return {ok: false, code: outcome.code, reason: outcome.reason,
        dead_count: death.length, polls: outcome.polls};
    }
    death.push({identity: identity, observation: outcome.observation});
  }
  return {ok: true, code: "TERMINATION_PROVEN", death: death};
}

// Read a cleanup result's death list without crashing a scene. A mutation that
// changed the result shape must surface as a FAILED CHECK, never as a runtime
// error: a crash would be read as "the suite failed", but it does not show that
// the mutated guard is the reason.
function death_list(result) {
  if (result === null || result === undefined) { return []; }
  const death = result.death;
  return death === null || death === undefined ? [] : death;
}

// One poll interval. A fixed step keeps the budget arithmetic reviewable.
const POLL_STEP_MS = 10;

function observe_one_until_dead(source, identity, deadline_ms, clock) {
  // Progress is measured against the INJECTED clock, not a counter. A counter
  // cannot be distinguished from a real wait.
  //
  // The poll ceiling is NOT redundant with the deadline. A clock that fails to
  // advance -- a stalled or frozen clock -- would make a deadline-only loop spin
  // forever without ever observing a death, so the bound must not depend solely
  // on something the classifier cannot verify. Exhausting either bound is
  // INCONCLUSIVE_CLEANUP, never an assumed termination.
  const started = clock.now();
  const max_polls = Math.floor(deadline_ms / POLL_STEP_MS) + 1;
  let polls = 0;
  while (clock.now() - started <= deadline_ms && polls < max_polls) {
    polls = polls + 1;
    const observed = source.observe(identity.pid);
    if (observed.state === "dead") {
      // The only successful exit.
      return {ok: true, polls: polls,
        observation: {state: "dead", start_identity: null,
          reason: observed.reason}};
    }
    if (observed.state === "unknown") {
      // `unknown` is never death. It is retried, and exhausting the budget is
      // INCONCLUSIVE_CLEANUP rather than an assumed termination.
      clock.sleep(POLL_STEP_MS);
      continue;
    }
    // `live`: the original process is gone only if the identity changed, in
    // which case the pid was reused and the frozen identity is dead.
    if (observed.start_identity !== identity.start_identity) {
      return {ok: true, polls: polls,
        observation: {state: "dead", start_identity: null, pid_reused: true}};
    }
    clock.sleep(POLL_STEP_MS);
  }
  const stalled = clock.now() - started <= deadline_ms;
  return {ok: false, code: "INCONCLUSIVE_CLEANUP",
    reason: stalled ? "poll_ceiling_exhausted" : "termination_budget_exhausted",
    polls: polls};
}


// The fixture clock. Time advances only when `sleep` is called, so every test
// is deterministic and cannot depend on machine speed.
function fixture_clock() {
  // A closure, not `this`: this engine has no `this` keyword.
  let elapsed = 0;
  return {
    now: function () { return elapsed; },
    sleep: function (ms) { elapsed = elapsed + ms; }
  };
}

// --- the injected fixture ----------------------------------------------------
//
// The self-test drives the entire court with this source. It is deliberately
// capable of expressing every adversarial case the chain must refuse, so the
// red gates prove the logic rather than the fixture's agreeableness.
function fixture_source(plan) {
  return {
    observe: function (pid) {
      if (list_has(plan.unknown_pids, pid)) {
        return {state: "unknown", start_identity: null,
          reason: plan.unknown_reason};
      }
      if (list_has(plan.dead_pids, pid)) {
        return {state: "dead", start_identity: null,
          reason: plan.dead_reason};
      }
      // A pid whose identity drifts between the two observations of its own
      // bracket. Counted so the drift lands inside the bracket, not outside it.
      if (list_has(plan.drift_pids, pid)) {
        plan.drift_calls[pid] = (plan.drift_calls[pid] || 0) + 1;
        if (plan.drift_calls[pid] === 2) {
          return {state: "live", start_identity: "drifted-" + pid};
        }
      }
      return {state: "live", start_identity: plan.identity[pid]};
    },
    parent: function (pid) {
      // A per-pid parent override lets a scene make the TERMINUS node's parent
      // relation non-live (or absent) without disturbing the chain above it.
      const override = plan.parent_state[pid];
      if (override === "unknown" || override === "dead") {
        return {state: override, parent_id: null,
          reason: override === "dead" ? "process_not_found"
            : "process_access_denied"};
      }
      if (list_has(plan.parent_unknown_pids, pid)) {
        return {state: "unknown", parent_id: null,
          reason: "process_access_denied"};
      }
      return {state: "live", parent_id: plan.parent[pid]};
    }
  };
}

// --- fixture scenes ----------------------------------------------------------

// A linear chain host -> ... -> browser, with per-pid parents.
function linear_plan(pids) {
  const identity = {};
  const parent = {};
  for (let i = 0; i < pids.length; i = i + 1) {
    identity[pids[i]] = "identity-" + pids[i];
    parent[pids[i]] = i + 1 < pids.length ? pids[i + 1] : 0;
  }
  return {identity: identity, parent: parent, unknown_pids: [], dead_pids: [],
    drift_pids: [], parent_unknown_pids: [], parent_state: {}, drift_calls: {},
    unknown_reason: "process_access_denied",
    dead_reason: "process_not_found"};
}

function self_test() {
  const checks = {};
  const pids = [7001, 7002, 7003];
  const browser_pid = 7003;
  const browser_identity = "identity-7003";

  // Cleanup plans are built over the frozen pids so the fixture reports the
  // SAME identity the frozen list expects. A plan with an empty identity map
  // would report `undefined`, which the reuse branch would misread as drift.
  function cleanup_plan(dead, unknown, override_identity) {
    const plan = linear_plan([7001, 7002, 7003]);
    plan.dead_pids = dead;
    plan.unknown_pids = unknown;
    if (override_identity !== undefined) {
      const keys = Object.keys(override_identity);
      for (let i = 0; i < keys.length; i = i + 1) {
        plan.identity[keys[i]] = override_identity[keys[i]];
      }
    }
    return plan;
  }

  function walk(plan) {
    return walk_ownership_chain(fixture_source(plan),
      pids[0], "identity-" + pids[0], browser_pid, browser_identity);
  }
  // 1. A clean chain proves ownership and reports its length.
  const clean = walk(linear_plan(pids));
  checks.chain_proves_ownership = clean.ok === true
    && clean.code === "OWNERSHIP_PROVEN" && clean.chain_length === 3;
  // 2. A cycle (a pid repeating) is refused as unproven ownership.
  const cycle_plan = linear_plan(pids);
  cycle_plan.parent[7002] = 7001;
  const cycle = walk(cycle_plan);
  checks.cycle_refused = cycle.ok !== true
    && cycle.code === "INCONCLUSIVE_OWNERSHIP" && cycle.reason === "cycle";
  // 3. Reaching PID 0 before the terminus is unproven ownership.
  const zero_plan = linear_plan(pids);
  zero_plan.parent[7001] = 0;
  const zero = walk(zero_plan);
  checks.pid_zero_refused = zero.ok !== true
    && zero.code === "INCONCLUSIVE_OWNERSHIP" && zero.reason === "pid_zero";
  // 4. A self-parenting pid is refused.
  const self_plan = linear_plan(pids);
  self_plan.parent[7001] = 7001;
  const self = walk(self_plan);
  checks.self_parent_refused = self.ok !== true
    && self.code === "INCONCLUSIVE_OWNERSHIP";
  // 5. A chain that never reaches the browser is refused at the ceiling.
  const long_pids = [];
  for (let i = 0; i < CHAIN_CEILING + 5; i = i + 1) { long_pids.push(9000 + i); }
  // The chain is longer than the ceiling, so the walk exhausts its budget
    // before reaching the browser. It must report the ceiling, not an identity
    // failure: the fixture identities are all present.
  const ceiling = walk_ownership_chain(fixture_source(linear_plan(long_pids)),
    long_pids[0], "identity-" + long_pids[0],
    long_pids[CHAIN_CEILING], "identity-" + long_pids[CHAIN_CEILING]);
  checks.ceiling_refused = ceiling.ok !== true
    && ceiling.code === "INCONCLUSIVE_OWNERSHIP" && ceiling.reason === "ceiling";
  // 6. `unknown` is never absence: it fails as an identity problem, not as
  //    unproven ownership, and never as "dead".
  const unknown_plan = linear_plan(pids);
  unknown_plan.unknown_pids = [7001];
  const unknown = walk(unknown_plan);
  checks.unknown_is_identity_failure = unknown.ok !== true
    && unknown.code === "INCONCLUSIVE_PROCESS_IDENTITY"
    && unknown.reason === "before_unknown";
  // 7. `dead` before the terminus is an identity failure, never a passing step.
  const dead_plan = linear_plan(pids);
  dead_plan.dead_pids = [7002];
  const dead = walk(dead_plan);
  checks.dead_refused = dead.ok !== true
    && dead.code === "INCONCLUSIVE_PROCESS_IDENTITY";
  // 8. Identity drift inside one bracket is refused. This is the case the
  //    bracket exists for, and it must be the drift detector that fires.
  const drift_plan = linear_plan(pids);
  drift_plan.drift_pids = [7001];
  const drift = walk(drift_plan);
  checks.identity_drift_refused = drift.ok !== true
    && drift.code === "INCONCLUSIVE_PROCESS_IDENTITY"
    && drift.reason === "identity_drift";
  // 9. A terminus with the right pid but the wrong identity is unproven.
  const wrong_id = walk_ownership_chain(fixture_source(linear_plan(pids)),
    pids[0], "identity-" + pids[0], browser_pid, "identity-of-something-else");
  checks.terminus_identity_refused = wrong_id.ok !== true
    && wrong_id.code === "INCONCLUSIVE_OWNERSHIP"
    && wrong_id.reason === "terminus_identity";
  // 9a. THE FROZEN BINDING. The first node is the owned subject, so its identity
  //     must equal the frozen `process.identity(handle)` value. The chain is
  //     otherwise perfectly well-formed, so ONLY the binding check can refuse it.
  const wrong_frozen = walk_ownership_chain(fixture_source(linear_plan(pids)),
    pids[0], "not-the-frozen-identity", browser_pid, browser_identity);
  checks.subject_frozen_identity_refused = wrong_frozen.ok !== true
    && wrong_frozen.code === "INCONCLUSIVE_PROCESS_IDENTITY"
    && wrong_frozen.reason === "subject_identity_mismatch";
  // 9b. A missing subject identity is refused rather than silently skipped: the
  //     walk must never accept "whatever identity is live at that pid".
  const no_frozen = walk_ownership_chain(fixture_source(linear_plan(pids)),
    pids[0], null, browser_pid, browser_identity);
  checks.subject_frozen_identity_required = no_frozen.ok !== true
    && no_frozen.code === "INCONCLUSIVE_PROCESS_IDENTITY"
    && no_frozen.reason === "subject_identity_missing";
  // 9c. A clean walk must REPORT the frozen identity as its subject identity, and
  //     must derive subject liveness from the first bracket rather than assert it.
  checks.subject_identity_reported = clean.ok === true
    && clean.subject_identity === "identity-" + pids[0]
    && clean.subject_was_live === true;
  // 10. A parent record that is `unknown` proves no relation.
  const punknown_plan = linear_plan(pids);
  punknown_plan.parent_unknown_pids = [7001];
  const punknown = walk(punknown_plan);
  checks.parent_unknown_refused = punknown.ok !== true
    && punknown.code === "INCONCLUSIVE_OWNERSHIP";
  // 11. The model is the authority: a chain the walk accepts must also be
  //     accepted by `classify_chain`, and a refused one must be refused there.
  //     Re-deriving through the model is what keeps this file from being a
  //     second implementation.
  // Guarded: a mutation that breaks the walk must surface as a FAILED CHECK.
  // Reading `.pids` off a refused walk would throw a runtime error, and a crash
  // is not evidence that the mutated guard is load-bearing.
  const model_clean = clean.ok === true
    ? model.classify_chain(build_steps(clean.pids, clean.brackets),
        browser_pid, browser_identity)
    : {ok: false};
  checks.model_agrees_on_clean = model_clean.ok === true
    && model_clean.chain_length === 3;
  // 12. A single-edge chain (host is the browser's direct child) is legal.
  const one_edge = walk_ownership_chain(
    fixture_source(linear_plan([7001, 7002])), 7001, "identity-7001",
    7002, "identity-7002");
  checks.single_edge_chain = one_edge.ok === true
    && one_edge.chain_length === 2;
  // 13. A chain of exactly the ceiling length is legal; one edge more is not.
  const exact = [];
  for (let i = 0; i < CHAIN_CEILING; i = i + 1) { exact.push(5000 + i); }
  const at_ceiling = walk_ownership_chain(
    fixture_source(linear_plan(exact)), exact[0], "identity-" + exact[0],
    exact[CHAIN_CEILING - 1], "identity-" + exact[CHAIN_CEILING - 1]);
  checks.at_ceiling_allowed = at_ceiling.ok === true;

  const over = [];
  for (let i = 0; i < CHAIN_CEILING + 1; i = i + 1) { over.push(6000 + i); }
  const over_ceiling = walk_ownership_chain(
    fixture_source(linear_plan(over)), over[0], "identity-" + over[0],
    over[CHAIN_CEILING], "identity-" + over[CHAIN_CEILING]);
  checks.over_ceiling_refused = over_ceiling.ok !== true;

  // --- cleanup --------------------------------------------------------------

  const frozen = [
    {pid: 7001, start_identity: "identity-7001"},
    {pid: 7002, start_identity: "identity-7002"},
    {pid: 7003, start_identity: "identity-7003"}
  ];
  // Each cleanup scene gets its OWN fixture clock, so a stalled clock cannot be
  // masked by progress another scene already made.
  const fast_clock = function () { return fixture_clock(); };
  // 14. Every frozen identity reaching `dead` proves termination.
  const terminated = observe_to_dead(
    fixture_source(cleanup_plan([7001, 7002, 7003], [])), frozen, 1000,
    fast_clock());
  checks.cleanup_all_dead = terminated.ok === true
    && terminated.code === "TERMINATION_PROVEN"
    && death_list(terminated).length === 3;
  // 15. `unknown` forever exhausts the budget instead of being read as dead.
  //     7001 must be dead so the walk actually reaches the unknown pid; a live
  //     matching pid before it would consume the budget instead.
  const stuck = observe_to_dead(
    fixture_source(cleanup_plan([7001], [7002])), frozen, 100, fast_clock());
  checks.cleanup_unknown_not_dead = stuck.ok !== true
    && stuck.code === "INCONCLUSIVE_CLEANUP"
    && stuck.reason === "termination_budget_exhausted";
  // The failure must not have recorded a death for the unknown pid.
  checks.cleanup_unknown_records_no_death = stuck.dead_count === 1;
  // 16. A surviving process (same identity, still live) is never dead.
  const survived = observe_to_dead(
    fixture_source(cleanup_plan([7001], [])), frozen, 100, fast_clock());
  checks.cleanup_survivor_refused = survived.ok !== true
    && survived.code === "INCONCLUSIVE_CLEANUP";
  // 17. PID reuse: the pid is live but its identity changed, so the ORIGINAL
  //     frozen identity is dead. The record must say why.
  // 7001 is observed dead; 7002 keeps its pid but reports a DIFFERENT identity,
  // which is the reuse case; 7003 must also terminate, so it is marked dead.
  // Without that last part the pid-3 identity still matches and the cleanup can
  // never succeed, which would make this scene test the budget rather than reuse.
  const reuse = observe_to_dead(
    fixture_source(cleanup_plan([7001, 7003], [],
      {7002: "identity-of-a-different-process"})),
    frozen, 1000, fast_clock());
  checks.cleanup_pid_reuse_recorded = reuse.ok === true
    && death_list(reuse).length === 3 && death_list(reuse)[1].observation.pid_reused === true;

  // 17a-17d: the two termination shapes are NOT interchangeable.
  //
  // These drive the pure helper directly, because the helper is what decides
  // whether a reported termination is corroborated by the observations. A
  // fixture through `observe_to_dead` cannot express both shapes at once, and
  // conflating them was the P1-3 defect.
  const reuse_observations = [
    {state: "live", start_identity: "identity-7001"},
    {state: "live", start_identity: "identity-of-a-different-process"}];
  // PID reuse: the frozen identity is gone and the pid carries another one, so
  // the final observation is LIVE-and-different, not dead. This must be accepted.
  checks.termination_pid_reuse_accepted = never_unknown_as_dead(
    reuse_observations, true, true, "identity-7001") === true;
  // The same shape WITHOUT pid_reused is a process that is still running under a
  // reused pid: it must not be accepted as an ordinary death.
  checks.termination_live_final_not_dead = never_unknown_as_dead(
    reuse_observations, true, false, "identity-7001") === false;
  // `pid_reused: true` alone must not manufacture a pass: the final record has to
  // actually carry a DIFFERENT identity than the frozen one.
  checks.termination_pid_reuse_requires_real_change = never_unknown_as_dead(
    [{state: "live", start_identity: "identity-7001"}], true, true,
    "identity-7001") === false;
  // An `unknown` final observation is never death, in EITHER shape, even when
  // the caller claims the termination was proved.
  checks.termination_unknown_final_never_dead = never_unknown_as_dead(
    [{state: "live", start_identity: "identity-7001"},
      {state: "unknown", start_identity: null}], true, false,
    "identity-7001") === false;
  checks.termination_unknown_final_never_reuse = never_unknown_as_dead(
    [{state: "unknown", start_identity: null}], true, true,
    "identity-7001") === false;
  // 17a-ii: when NO termination was proved, the observations must still never END
  // on `unknown`. Without this pair the guard is only reachable through
  // `proved_dead === true`, where the shape checks reject the unknown record
  // anyway, so removing the guard would go unnoticed.
  checks.termination_unproved_unknown_final_refused = never_unknown_as_dead(
    [{state: "unknown", start_identity: null}], false, false,
    "identity-7001") === false;
  checks.termination_unproved_unknown_final_refused_reuse = never_unknown_as_dead(
    [{state: "unknown", start_identity: null}], false, true,
    "identity-7001") === false;
  // A non-terminating poll that simply ran out of budget is still acceptable: the
  // guard forbids an `unknown` FINAL observation, not an unproved termination.
  checks.termination_unproved_live_final_accepted = never_unknown_as_dead(
    [{state: "live", start_identity: "identity-7001"}], false, false,
    "identity-7001") === true;
  // An ordinary death still requires a final `dead`.
  checks.termination_ordinary_dead_accepted = never_unknown_as_dead(
    [{state: "live", start_identity: "identity-7001"},
      {state: "dead", start_identity: null}], true, false,
    "identity-7001") === true;
  // And a still-live, identity-matching final record is not an ordinary death.
  checks.termination_ordinary_still_live_refused = never_unknown_as_dead(
    [{state: "live", start_identity: "identity-7001"}], true, false,
    "identity-7001") === false;
  // 18. The cleanup input is exact-key: a selector field is not admissible,
  //     and the model is what says so.
  const leaky_input = {owned_handle: 1, frozen_identities: frozen,
    baseline_rows: [], live_rows: [], selector_output: [1]};
  const leaky_verdict = model.selector_independence_verdict("", leaky_input);
  checks.cleanup_selector_field_refused = leaky_verdict.ok !== true
    && leaky_verdict.code === "INVALID_EXPERIMENT"
    && leaky_verdict.reason === "cleanup_input_field_not_allowed";
  // 19. A well-formed cleanup input is admissible.
  const ok_input = {owned_handle: 1, frozen_identities: frozen,
    baseline_rows: [], live_rows: []};
  const ok_verdict = model.selector_independence_verdict("", ok_input);
  checks.cleanup_input_admissible = ok_verdict.ok === true
    && ok_verdict.v7 === true;
  // 20. This court's own cleanup and ownership regions must not read a
  //     selector field. The source is supplied by the runner, because the qjs
  //     engine cannot read its own file.
  checks.cleanup_region_selector_free = self_source_verdict();

  // --- 21-30: the real door's PER-STATE record shapes ------------------------
  //
  // These drive the pure adapters with the records `tool.rs` actually emits. The
  // point is that a `dead` or `unknown` read must survive the shape check and
  // reach the chain/termination logic; the previous adapter demanded
  // `start_identity` on every record, so those reads died at the shape check.

  const live_obs = parse_observation({state: "live", start_identity: "id-1"});
  checks.observe_live_variant_parsed = live_obs.ok === true
    && live_obs.value.state === "live"
    && live_obs.value.start_identity === "id-1";

  // A live record may legitimately lack the optional start identity. Parsing
  // must preserve that fact; the chain, not the adapter, owns its typed
  // INCONCLUSIVE_PROCESS_IDENTITY result.
  const null_live_obs = parse_observation({state: "live", start_identity: null});
  checks.observe_live_null_identity_parsed = null_live_obs.ok === true
    && null_live_obs.value.state === "live"
    && null_live_obs.value.start_identity === null;
  const null_identity_plan = linear_plan(pids);
  null_identity_plan.identity[pids[0]] = null;
  const null_identity = walk(null_identity_plan);
  checks.observe_live_null_identity_is_inconclusive = null_identity.ok !== true
    && null_identity.code === "INCONCLUSIVE_PROCESS_IDENTITY"
    && null_identity.reason === "before_no_identity";

  // 22. `dead` carries a `reason`, NOT a `start_identity`. It must parse.
  const dead_obs = parse_observation({state: "dead",
    reason: "process_not_found"});
  checks.observe_dead_variant_parsed = dead_obs.ok === true
    && dead_obs.value.state === "dead"
    && observed_reason(dead_obs) === "process_not_found";

  // 23. `unknown` likewise. `unknown` is the case that MUST reach the identity
  //     logic rather than being rejected as malformed.
  const unknown_obs = parse_observation({state: "unknown",
    reason: "process_access_denied"});
  checks.observe_unknown_variant_parsed = unknown_obs.ok === true
    && unknown_obs.value.state === "unknown"
    && observed_reason(unknown_obs) === "process_access_denied";

  // 24. The reason is preserved, not dropped: a reviewer must be able to tell
  //     "gone" from "unreadable".
  checks.observe_reason_preserved = dead_obs.ok === true && unknown_obs.ok === true
    && observed_reason(dead_obs) !== observed_reason(unknown_obs);

  // 25. A `dead` record that carries `start_identity` instead of `reason` is a
  //     door-contract change and is refused, so the parser is not blind.
  const dead_wrong_shape = parse_observation({state: "dead",
    start_identity: "id-1"});
  checks.observe_dead_wrong_shape_refused = dead_wrong_shape.ok !== true
    && dead_wrong_shape.code === "nonlive_observe_shape:start_identity,state";

  // 26. A non-`live` record with an empty reason is refused too.
  const empty_reason = parse_observation({state: "unknown", reason: ""});
  checks.observe_empty_reason_refused = empty_reason.ok !== true
    && empty_reason.code === "nonlive_observe_reason";

  // 27. An unrecognised state is refused by name rather than silently treated
  //     as any of the three known states.
  const bad_state = parse_observation({state: "zombie", reason: "x"});
  checks.observe_unknown_state_refused = bad_state.ok !== true
    && bad_state.code === "live_observe_state:zombie";

  // 28. The parent door has the same per-state split with `parent_id`.
  const live_parent = parse_parent_observation({state: "live", parent_id: 42});
  const dead_parent = parse_parent_observation({state: "dead",
    reason: "process_not_found"});
  const unknown_parent = parse_parent_observation({state: "unknown",
    reason: "process_access_denied"});
  checks.parent_live_variant_parsed = live_parent.ok === true
    && live_parent.value.parent_id === 42;
  checks.parent_dead_variant_parsed = dead_parent.ok === true
    && dead_parent.value.state === "dead"
    && dead_parent.value.parent_id === null;
  checks.parent_unknown_variant_parsed = unknown_parent.ok === true
    && unknown_parent.value.state === "unknown";

  // 29. A `live` parent record whose id is not a number is refused; a parent id
  //     of 0 is a legitimate value (the root of the owned tree), not "missing".
  const bad_parent_id = parse_parent_observation({state: "live",
    parent_id: "42"});
  const zero_parent_id = parse_parent_observation({state: "live", parent_id: 0});
  checks.parent_non_numeric_id_refused = bad_parent_id.ok !== true
    && bad_parent_id.code === "live_parent_id";
  checks.parent_zero_id_accepted = zero_parent_id.ok === true
    && zero_parent_id.value.parent_id === 0;

  // 30. A `live` parent record carrying the non-live key set is refused.
  const parent_wrong_shape = parse_parent_observation({state: "live",
    reason: "process_not_found"});
  checks.parent_live_wrong_shape_refused = parent_wrong_shape.ok !== true
    && parent_wrong_shape.code === "live_parent_shape:reason,state";

  // --- 31-34: the TERMINUS must not be gated on a usable parent --------------
  //
  // The owned browser is the root of the owned tree, so its parent relation is
  // never used to advance. A `live`-parent requirement at the terminus would
  // refuse a correct chain for a relation the court does not need.

  // 31. Terminus whose parent record is `unknown` still proves ownership.
  const t_unknown_plan = linear_plan(pids);
  t_unknown_plan.parent_state[browser_pid] = "unknown";
  const t_unknown = walk(t_unknown_plan);
  checks.terminus_parent_unknown_accepted = t_unknown.ok === true
    && t_unknown.code === "OWNERSHIP_PROVEN";

  // 32. Same for a `dead` parent record at the terminus.
  const t_dead_plan = linear_plan(pids);
  t_dead_plan.parent_state[browser_pid] = "dead";
  const t_dead = walk(t_dead_plan);
  checks.terminus_parent_dead_accepted = t_dead.ok === true;

  // 33. And for PID 0, which is what a real browser root reports.
  const t_zero_plan = linear_plan(pids);
  t_zero_plan.parent[browser_pid] = 0;
  const t_zero = walk(t_zero_plan);
  checks.terminus_parent_zero_accepted = t_zero.ok === true;

  // 34. But a NON-terminus node with a non-live parent record is still refused:
  //     the terminus relaxation must not leak up the chain.
  const mid_unknown_plan = linear_plan(pids);
  mid_unknown_plan.parent_state[pids[1]] = "unknown";
  const mid_unknown = walk(mid_unknown_plan);
  checks.nonterminus_parent_unknown_refused = mid_unknown.ok !== true
    && mid_unknown.code === "INCONCLUSIVE_OWNERSHIP"
    && mid_unknown.reason === "parent_unknown";

  // --- 35-36: the cleanup clock --------------------------------------------
  //
  // Progress is measured against the INJECTED clock. A stalled clock must burn
  // the deadline and report INCONCLUSIVE_CLEANUP with a poll count, rather than
  // looping forever as the previous counter did with a zero step.

  // 35. A clock that never advances cannot prove termination.
  let stalled_elapsed = 0;
  const stalled_clock = {
    now: function () { return stalled_elapsed; },
    sleep: function () { return 0; }
  };
  const stalled = observe_to_dead(
    fixture_source(cleanup_plan([], [7001])), frozen, 100, stalled_clock);
  checks.cleanup_stalled_clock_exhausts = stalled.ok !== true
    && stalled.code === "INCONCLUSIVE_CLEANUP"
    && stalled.reason === "poll_ceiling_exhausted"
    && stalled.dead_count === 0
    && stalled.polls === Math.floor(100 / POLL_STEP_MS) + 1;

  // 36. A clock that advances proves termination and reports how many polls it
  //     took, so the budget arithmetic is observable rather than implied.
  const progressed = observe_to_dead(
    fixture_source(cleanup_plan([7001, 7002, 7003], [])), frozen, 1000,
    fixture_clock());
  checks.cleanup_clock_progress_recorded = progressed.ok === true
    && death_list(progressed).length === 3
    && death_list(progressed)[0].observation.reason === "process_not_found";

  // The stage-order verifier reads the CALL-SITE trace and requires every guard
  // row to be acknowledged BEFORE the side effect it guards starts. The trace is
  // produced as events really happen, never reconstructed from the journal, so
  // this cannot agree with a tampered journal by construction.
  const failed = [];
  const keys = Object.keys(checks);
  for (let i = 0; i < keys.length; i = i + 1) {
    if (checks[keys[i]] !== true) { failed.push(keys[i]); }
  }
  demand(failed.length === 0, "live_self_test_failed:" + failed.join("+"));

  return {
    schema: "agenterm.profile-binding-exact-process-live-self-test/v1",
    ok: true,
    mode: MODE_SELF_TEST,
    checks: checks,
    browser_launched: false,
    ordinal_reserved: false,
    formal_root_touched: false,
    design_verdict: false,
    injected_fixture: true
  };
}

// Set by the runner: the text of the ownership+cleanup region of this file, so
// V7 can be judged against the real source rather than a restatement.
let REGION_SOURCE = "";

function self_source_verdict() {
  if (REGION_SOURCE === "") {
    // Without the source the verdict cannot be claimed. Reporting `false`
    // keeps this from being a silently passing check.
    return false;
  }
  return model.selector_independence_verdict(REGION_SOURCE, {
    owned_handle: 1, frozen_identities: [], baseline_rows: [], live_rows: []
  }).ok === true;
}

// --- the real-process preflight ---------------------------------------------
//
// This is the first code in this experiment that touches REAL host processes for
// ownership. It is deliberately NOT the live court:
//
//   * the owned subject is a non-browser, short-lived child (the browser is what
//     the live court must own, and no browser may be launched in this slice);
//   * no ordinal is reserved and no ledger row is written, so nothing here can
//     produce a design fact;
//   * it proves the *mechanisms* the live court will rely on against the real
//     door, which is the only way to tell a fixture-shaped belief from a real one.
//
// Real door contract used here (verified against `tool.rs`, not assumed):
//   process.spawn_frozen  -> direct: handle >= 0, negative is a refusal
//   process.pid           -> direct: the pid itself (NOT a status code)
//   process.identity      -> answer: {"pid":u32,"start_identity":String}
//   process.state         -> answer: "running" | "exited" | "unknown"
//   process.observe       -> answer: per-state JSON (live/dead/unknown)
//   process.parent        -> answer: per-state JSON
//   process.kill          -> direct: 0 | negative
//   process.wait          -> answer: the command-result JSON
//   process.release       -> answer: empty string on success
//   time.now_ms           -> answer: epoch milliseconds as text (REAL clock)
//   time.sleep_ms         -> answer: empty payload (REAL bounded sleep)
//
// `process.identity` REQUIRES a frozen spawn: an unfrozen child has no frozen
// identity to report and is refused by name.

// The real host clock and bounded sleep. These are the door's own operations, not
// a counter this file maintains: `time.now_ms` was observed to advance with no
// sleep at all, which is what distinguishes it from a replay/step clock.
function host_clock() {
  return {
    now_ms: function () {
      // Answer-style: the status is 0 and the value is parked in `tool_result`,
      // exactly like `process.observe`. Reading the return value here would
      // silently yield a constant zero, which is how a fake clock hides.
      const value = door_answer("time.now_ms", time_now_ms());
      const ms = parseInt(value, 10);
      demand(ms > 0, "host_clock_now_value:" + value);
      return ms;
    },
    sleep_ms: function (ms) {
      door_answer("time.sleep_ms", time_sleep_ms(ms));
      return ms;
    }
  };
}

// A frozen-spawn direct op: the return value IS the payload, and a negative
// return is a refusal whose message is parked in `tool_result`.
function door_direct(op, value) {
  if (value < 0) { throw op + ":" + tool_result(); }
  return value;
}

// An answer-style op: 0 means success and the payload is in `tool_result`.
function door_answer(op, status) {
  if (status !== 0) { throw op + ":" + tool_result(); }
  return tool_result();
}

function door_json(op, status) {
  return JSON.parse(door_answer(op, status));
}

// The subject program. `/bin/sleep` is not a browser, is never re-executed by
// this court, and is guaranteed to still be alive when the bracket runs, which is
// what makes the live-identity half of the chain meaningful.
const SUBJECT_SECONDS = 10;

function spawn_subject() {
  const spec = {
    program: "/bin/sleep",
    args: ["" + SUBJECT_SECONDS],
    current_dir: ".",
    env: {},
    timeout_ms: 60000
  };
  const handle = door_direct("process.spawn_frozen",
    process_spawn_frozen(JSON.stringify(spec)));
  demand(handle >= 0, "subject_spawn");
  return handle;
}

// The full owned-resource lifecycle. EVERY path, success or failure, must end
// with the handle released, or the worker leaks a slot and the child is orphaned.
// Failures are ACCUMULATED rather than abandoning the remaining steps: stopping
// at the first failure is exactly how orphans are made.
function teardown_subject(handle, hook) {
  const note = hook === undefined ? function (event) { return event; }
    : hook;
  const failures = [];
  let killed = false;
  let reaped = false;
  let released = false;

  // kill is best-effort: a child that already exited reports success too, and a
  // refusal here must not skip the reap or the release.
  note("kill");
  const kill_status = process_kill(handle);
  if (kill_status < 0) { failures.push("kill:" + tool_result()); } else { killed = true; }

  note("wait");
  const wait_status = process_wait(handle, 5000);
  if (wait_status !== 0) { failures.push("wait:" + tool_result()); } else { reaped = true; }

  note("release");
  const release_status = process_release(handle);
  if (release_status !== 0) { failures.push("release:" + tool_result()); } else { released = true; }

  return {ok: failures.length === 0, failures: failures, killed: killed,
    reaped: reaped, released: released};
}

// Wait for the frozen identity to reach `dead`, using the REAL clock and REAL
// bounded sleep. Returns the observations taken so a reviewer can see the
// evidence rather than a summary claim.
function observe_identity_until_dead(identity, deadline_ms, clock, hook) {
  const note = hook === undefined ? function (event) { return event; }
    : hook;
  const started = clock.now_ms();
  const observations = [];
  while (clock.now_ms() - started <= deadline_ms) {
    note("observe");
    // The observation is routed through the red-gate hook so an unreadable
    // process can be injected. On the real path the hook is a passthrough. The
    // injection fires from the FIRST poll, because a correctly-terminated subject
    // is already `dead` on the first read and a later injection would never be
    // reached -- an unreachable adversary is not a red gate.
    const observed_raw = UNKNOWN_MODE === "unknown"
      ? injected_unknown(identity.pid)
      : JSON.parse(door_answer("process.observe", process_observe(identity.pid)));
    const parsed = parse_observation(observed_raw);
    demand(parsed.ok === true, parsed.code);
    observations.push(parsed.value);
    if (parsed.value.state === "dead") {
      return {ok: true, state: "dead", observations: observations};
    }
    if (parsed.value.state === "unknown") {
      // `unknown` is never death. Retry, and let the deadline decide.
      note("sleep");
      clock.sleep_ms(POLL_STEP_MS);
      continue;
    }
    // `live`: the ORIGINAL process is gone only if the pid now carries a
    // different start identity (the pid was reused).
    if (parsed.value.start_identity !== identity.start_identity) {
      return {ok: true, state: "dead", pid_reused: true,
        observations: observations};
    }
    note("sleep");
    clock.sleep_ms(POLL_STEP_MS);
  }
  return {ok: false, state: "live", observations: observations,
    reason: "termination_deadline_exhausted"};
}

// Orphan guard: the frozen pid must not still be alive after teardown.
function assert_no_orphan(identity) {
  const parsed = parse_observation(
    JSON.parse(door_answer("process.observe", process_observe(identity.pid))));
  demand(parsed.ok === true, parsed.code);
  if (parsed.value.state === "live"
      && parsed.value.start_identity === identity.start_identity) {
    return false;
  }
  return true;
}

function process_preflight() {
  const checks = {};
  const clock = host_clock();
  const worker_pid = process_id();

  // A floor on the REAL clock. If `time.now_ms` were a counter that only moves
  // when the script sleeps, it would start near zero and this would fail.
  const t0 = clock.now_ms();
  clock.sleep_ms(120);
  const t1 = clock.now_ms();
  const slept_ms = t1 - t0;
  checks.host_clock_is_real = t0 > 1000000000000 && slept_ms >= 110;

  const handle = spawn_subject();
  let identity = null;
  let teardown = null;
  let chain = null;
  let termination = null;
  let orphan_free = false;
  let outcome_error = null;
  let subject_was_live = false;
  try {
    const frozen = door_json("process.identity", process_identity(handle));
    identity = {pid: frozen.pid, start_identity: frozen.start_identity};
    checks.identity_is_frozen = typeof identity.pid === "number"
      && typeof identity.start_identity === "string"
      && identity.start_identity !== "";

    // `process.pid` must agree with the frozen identity: two independent doors
    // describing the same owned child.
    checks.pid_door_agrees = door_direct("process.pid", process_pid(handle))
      === identity.pid;

    // The REAL ownership walk, reusing the same `walk_ownership_chain` the live
    // court uses. The walk goes from the owned subject UP to this worker, so the
    // terminus is the worker's pid and the worker's own observed identity. The
    // subject's FROZEN identity is passed in and must match both sides of the
    // first bracket; the terminus proves the chain ends at this worker rather
    // than somewhere else.
    const worker_obs = parse_observation(
      JSON.parse(door_answer("process.observe", process_observe(worker_pid))));
    demand(worker_obs.ok === true, worker_obs.code);
    chain = walk_ownership_chain(
      real_observation_source(), identity.pid, identity.start_identity,
      worker_pid, worker_obs.value.start_identity);
    checks.chain_worker_owns_subject = chain.ok === true
      && chain.code === "OWNERSHIP_PROVEN"
      && chain.chain_length === 2;
    // The frozen identity must be the one the chain actually saw. This is a
    // SEPARATE check from the chain verdict, because the verdict alone would be
    // satisfied by any identity that happened to be live at that pid.
    checks.subject_identity_is_frozen = chain.ok === true
      && chain.subject_identity === identity.start_identity;
    // Derived from the first bracket's real observations by the walk, never
    // assigned here: a bare `true` would claim liveness the walk never proved.
    subject_was_live = chain.ok === true && chain.subject_was_live === true;
  } catch (error) {
    outcome_error = "" + error;
  }

  // ORDER MATTERS. The subject is still alive here, so the chain bracket above
  // observed a genuinely live owned process. Teardown must NOT run before this
  // point: killing first would make the "saw live first" check impossible and
  // would hide a chain that never actually proved a live identity.

  // Teardown runs on EVERY path, including a partially constructed subject.
  try {
    teardown = teardown_subject(handle);
  } catch (error) {
    teardown = {ok: false, failures: ["teardown_threw:" + error],
      killed: false, reaped: false, released: false};
  }
  checks.teardown_releases_handle = teardown.ok === true && teardown.released === true;

  if (identity !== null) {
    try {
      // Post-teardown: the frozen identity must now reach `dead`.
      termination = observe_identity_until_dead(identity, 5000, clock);
      checks.termination_observed_dead = termination.ok === true;
      checks.termination_never_unknown_as_dead = never_unknown_as_dead(
        termination.observations, termination.ok === true,
        termination.pid_reused === true, identity.start_identity);
      orphan_free = assert_no_orphan(identity);
      checks.no_orphan_after_release = orphan_free;
    } catch (error) {
      outcome_error = outcome_error === null ? "" + error
        : outcome_error + "|" + error;
    }
  } else {
    checks.termination_observed_dead = false;
    checks.termination_never_unknown_as_dead = false;
    checks.no_orphan_after_release = false;
  }

  // Recorded separately from the post-teardown poll so the evidence shows BOTH
  // halves: the subject was live when the chain was walked, and dead afterwards.
  checks.subject_was_live_during_chain = chain !== null && chain.ok === true
    && chain.subject_was_live === true && subject_was_live === true;

  // The worker itself is NEVER part of the termination cleanup. Its liveness
  // cannot be a precondition of a check that runs in it.
  checks.worker_excluded_from_cleanup = worker_pid !== (identity === null
    ? -1 : identity.pid);

  checks.no_outcome_error = outcome_error === null;

  const failed = [];
  const keys = Object.keys(checks);
  for (let i = 0; i < keys.length; i = i + 1) {
    if (checks[keys[i]] !== true) { failed.push(keys[i]); }
  }

  return {
    schema: "agenterm.profile-binding-exact-process-live-process-preflight/v1",
    ok: failed.length === 0,
    mode: MODE_PROCESS_PREFLIGHT,
    checks: checks,
    failed: failed,
    worker_pid: worker_pid,
    subject_pid: identity === null ? null : identity.pid,
    subject_identity: identity === null ? null : identity.start_identity,
    subject_kind: "owned non-browser child",
    subject_seconds: SUBJECT_SECONDS,
    chain_length: chain === null ? null : chain.chain_length,
    slept_ms: slept_ms,
    teardown: teardown,
    orphan_free: orphan_free,
    outcome_error: outcome_error,
    browser_launched: false,
    ordinal_reserved: false,
    formal_root_touched: false,
    design_verdict: false,
    injected_fixture: false,
    real_host_process: true
  };
}

// A termination is sound only if the observations match ONE of the two declared
// success shapes, and no observation was ever a `dead`-shaped lie about `unknown`.
//
// The two shapes are NOT interchangeable, and conflating them was a real bug:
//   * ordinary death    -> the final observation is `dead`
//   * PID reuse         -> the final observation is `live` with an identity
//                          DIFFERENT from the frozen one, because the original
//                          process is gone and its pid now carries another
//                          process. `observe_identity_until_dead` reports this as
//                          `state: dead, pid_reused: true`, but its last recorded
//                          OBSERVATION is that reused `live` record.
// Requiring a final `dead` observation in the reuse case rejects a legitimate
// termination; accepting a final `live` in the ordinary case would accept a
// process that is still running. The frozen identity is passed in rather than
// trusted from a boolean, so `pid_reused: true` alone cannot manufacture a pass.
function never_unknown_as_dead(observations, proved_dead, pid_reused,
    frozen_identity) {
  for (let i = 0; i < observations.length; i = i + 1) {
    const state = observations[i].state;
    if (state !== "live" && state !== "dead" && state !== "unknown") {
      return false;
    }
    // `unknown` may never be the observation that terminates the poll, in either
    // shape: it is explicitly retryable and exhausting the budget is not death.
    if (state === "unknown" && i === observations.length - 1) { return false; }
  }
  if (proved_dead !== true) {
    // No termination was claimed, so there is nothing to corroborate; the poll
    // simply must not have ended on `unknown`.
    return true;
  }
  const last = observations[observations.length - 1];
  if (last === undefined) { return false; }
  if (pid_reused === true) {
    // The frozen identity must actually be absent: the final record must be live
    // AND carry a different identity.
    if (typeof frozen_identity !== "string" || frozen_identity === "") {
      return false;
    }
    return last.state === "live"
      && last.start_identity !== null
      && last.start_identity !== undefined
      && last.start_identity !== frozen_identity;
  }
  return last.state === "dead";
}

// --- browser-free persisted-stage integration ---------------------------------
//
// WHAT THIS PROVES: that every EXPERIMENTAL SUBJECT operation in a real-process
// ownership/cleanup run -- the child this court spawns and the pid/identity/
// observe/parent/kill/wait/release reads it performs on that child -- is
// preceded by a bounded, read-back-equal stage row
// published into a DISPOSABLE state root, that the journal is independently
// re-derived from disk, and that the attempt is then closed by an honest
// `abandon` -- NEVER by a terminal stage or a `finish`.
//
// WHY ABANDON AND NOT FINISH: there is no legal terminal code for "V6 mechanism
// proven, browser criteria not-run". `NEW_INFORMATION_INSUFFICIENT` and
// `CLEANUP_NOT_INDEPENDENT` are refused by name; `INCONCLUSIVE_MECHANISM` is
// accepted only by claiming V1-V7 all pass, which this slice cannot prove; and
// `INVALID_EVIDENCE` means V6 FAILED. So this slice stages no terminal and writes
// no receipt, and it claims none of V1-V7.
//
// WHAT THIS DOES NOT PROVE, AND MUST NEVER BE READ AS PROVING: V1-V7, V5
// inventory restoration (the browser connection inventory is honestly 0/0 and
// therefore VACUOUS), a live ordinal reservation, kill criterion 4, or any
// browser-live throw site.

const MODE_STAGED_PREFLIGHT = "live-staged-preflight";
const STAGED_BROKER_PATH =
  "research/browser-profile-name-binding-exact-process/broker-spine.sh";
const STAGED_TEMPLATE_PATH =
  "research/browser-profile-name-binding-exact-process/result-template.json";
const STAGED_INPUT_DOMAIN = "agenterm-cu/profile-binding-exact-process/input/v1";
const STAGED_BROKER_TIMEOUT_MS = 30000;
const STAGED_ORDINAL = "R1";
const STAGED_ROOT_MARKER = "agenterm-live-staged";
// The static identity-source scan iterates SIX SOURCES (court, live, preflight,
// admission, rh_compat, test_harness). This is the number of SOURCES SCANNED --
// deliberately NOT the 9x pattern comparisons each source is tested against (54),
// because the field names a source count and 54 would misname it. The runner runs
// this scan BEFORE invoking the court and the court asserts it succeeded, so the
// count describes work that has genuinely already finished.
const STAGED_SCANNED_SOURCE_COUNT = 6;
const STAGED_FAILURE_RECORD_CODE = "INVALID_EVIDENCE";

// Red-gate adversary hooks.
//
// DESIGN RULE, learned the hard way: a hook that merely SKIPS a guard is not a
// red gate, because skipping a check is invisible while the input happens to be
// well-formed. Every hook below must instead make the real world WRONG -- spawn
// before the guarding row, kill before the stop row, corrupt the journal bytes on
// disk, forge a terminal, project a real truncated envelope as untruncated. The
// guard is then shown to bite on an actual defect.
//
// `TOOLHOOK_TRACE` is an append-only event trace pushed from the CALL SITE as each
// event really happens. It is never back-derived from the expected journal: that
// would make the verifier agree with the thing it is supposed to check.
const STAGE_ORDER_MODE = "off";
const TRUNCATION_MODE = "off";
const PERSISTENCE_MODE = "off";
const JOURNAL_MODE = "off";
const FINISH_MODE = "off";

let TOOLHOOK_TRACE = [];
function trace(event) { TOOLHOOK_TRACE.push(event); }

// A real mutation of the durable journal: append bytes that do not belong. The
// independent audit must name the corruption instead of trusting the row count.
function tamper_journal(state_root, mode) {
  const path = state_root + "/stage-journal/rehearsal-1.jsonl";
  if (mode === "append_garbage") {
    if (fs_append(path, "{\"stage\":\"forged\"}\n") !== 0) {
      throw "tamper_append:" + tool_result();
    }
  } else if (mode === "rewrite_facts") {
    // Rewrite the file with one row's facts altered, keeping it valid JSON so
    // only a REAL fact comparison can catch it.
    const text = rh.read_text(path);
    const lines = text.split("\n");
    const out = [];
    for (let i = 0; i < lines.length; i = i + 1) {
      if (lines[i] === "") { continue; }
      if (i === 1) {
        const row = JSON.parse(lines[i]);
        row.facts = {scanned_source_count: 999, call_count: 999};
        out.push(canonical_json(row));
      } else { out.push(lines[i]); }
    }
    if (fs_write(path, out.join("\n") + "\n") !== 0) {
      throw "tamper_rewrite:" + tool_result();
    }
  } else if (mode === "reorder_rows") {
    const text = rh.read_text(path);
    const lines = text.split("\n");
    const out = [];
    for (let i = 0; i < lines.length; i = i + 1) {
      if (lines[i] === "") { continue; }
      out.push(lines[i]);
    }
    // Swap the first two real rows: the seq/prev chain must reject this.
    const swap = out[0]; out[0] = out[1]; out[1] = swap;
    if (fs_write(path, out.join("\n") + "\n") !== 0) {
      throw "tamper_reorder:" + tool_result();
    }
  }
}

// Configuration travels through the ENVIRONMENT, never through positional
// arguments. `cli script task run` appends `-- MODE` to the task's declared args,
// so argv positions shift between the real task and a red-gate probe (which
// declares the mode as args[0]). Reading argv by index would make the disposable
// root silently resolve to null in one of the two paths.
function staged_env(name) {
  if (env_has(name) !== 1 || env_get(name) !== 0) { return null; }
  const value = tool_result();
  return value === "" ? null : value;
}

function strip_trailing_newlines(text) {
  let end = text.length;
  while (end > 0 && text.charCodeAt(end - 1) === 10) { end = end - 1; }
  return text.slice(0, end);
}

// Spawn the broker and return its parsed command envelope. Truncation is checked
// explicitly: a truncated stdout is still valid JSON up to the cut, so accepting
// it without the flags could make a partial row look complete.
function staged_broker_raw(state_root, args, accept_exit) {
  const spec = {
    program: "sh",
    args: [STAGED_BROKER_PATH].concat(args),
    current_dir: ".",
    env: { AGENTERM_PROFILE_BINDING_EXACT_STATE_ROOT: state_root },
    timeout_ms: STAGED_BROKER_TIMEOUT_MS
  };
  const handle = process_spawn(JSON.stringify(spec));
  demand(handle >= 0, "staged_broker_spawn:" + tool_result());
  const wait_status = process_wait(handle, STAGED_BROKER_TIMEOUT_MS);
  const wait_detail = tool_result();
  if (wait_status !== 0) {
    // A failed wait must not strand the owned handle. Every cleanup step is
    // best-effort and ALL failures are recorded before returning the primary one.
    let cleanup = "";
    if (process_kill(handle) !== 0) { cleanup = cleanup + ":kill=" + tool_result(); }
    if (process_wait(handle, 2000) !== 0) { cleanup = cleanup + ":reap=" + tool_result(); }
    if (process_release(handle) !== 0) { cleanup = cleanup + ":release=" + tool_result(); }
    throw "staged_broker_wait:" + wait_detail + cleanup;
  }
  const envelope = JSON.parse(tool_result());
  demand(process_release(handle) === 0, "staged_broker_release:" + tool_result());

  demand(envelope.timed_out === false, "staged_broker_timeout");
  // Adversary 5: PROJECT a real truncated envelope. The mutation sets the flag the
  // broker really reports when it truncates, so the guard is exercised on a genuine
  // truncated-stream shape rather than being bypassed. Disabling the guard instead
  // would be undetectable while the stream happens to be short.
  if (TRUNCATION_MODE === "project_truncated") {
    envelope.stdout_truncated = true;
  }
  demand(envelope.stdout_truncated === false, "staged_broker_stdout_truncated");
  demand(envelope.stderr_truncated === false, "staged_broker_stderr_truncated");
  demand(typeof envelope.stdout === "string" && typeof envelope.stderr === "string",
    "staged_broker_stream_missing");
  demand(accept_exit ? envelope.success === true : envelope.success === false,
    "staged_broker_exit:" + envelope.exit_code + ":" + envelope.stdout
      + ":" + envelope.stderr);
  // Independent truncation witness: the broker always terminates a complete
  // stdout with a newline. A stream that does not end in one was cut, whether or
  // not the flag admitted it. This is deliberately a DIFFERENT predicate from the
  // flag, so removing the flag check alone still fails.
  if (envelope.stdout !== "") {
    const ends_with_newline =
      envelope.stdout.charCodeAt(envelope.stdout.length - 1) === 10;
    demand(ends_with_newline, "staged_broker_stdout_not_terminated");
  }
  return envelope;
}

function staged_broker_ok(state_root, args, expected_keys, label) {
  const envelope = staged_broker_raw(state_root, args, true);
  const text = strip_trailing_newlines(envelope.stdout);
  demand(text.includes("\n") === false, label + "_stdout_not_single_line");
  let value = null;
  try { value = JSON.parse(text); }
  catch (error) { throw label + "_stdout_not_json:" + text; }
  const want_list = [];
  for (let i = 0; i < expected_keys.length; i = i + 1) {
    want_list.push(expected_keys[i]);
  }
  const got = Object.keys(value).sort().join(",");
  const want = want_list.sort().join(",");
  demand(got === want, label + "_keys:" + got);
  return value;
}

function staged_write_request(path, body) {
  const text = canonical_json(body);
  if (fs_create_new_regular_durable(path, text) !== 0) {
    throw "staged_request_write:" + tool_result();
  }
  demand(rh.read_text(path) === text, "staged_request_readback");
}

function staged_criteria() {
  const c = {};
  const template = JSON.parse(rh.read_text(STAGED_TEMPLATE_PATH));
  const keys = template.criteria_keys;
  for (let i = 0; i < keys.length; i = i + 1) { c[keys[i]] = "not-run"; }
  return c;
}

// Publish one stage and REQUIRE the broker's evidence that it landed: `accepted`
// plus a 64-hex receipt digest. Ignoring either would let a silent no-op pass as a
// published row.
function staged_publish(stage, code, facts, state_root, run_id, seq) {
  const path = state_root + "/stage-" + stage + "-" + seq + ".json";
  staged_write_request(path, {
    stage: stage,
    producer: "live-staged-preflight",
    deadline_ms: STAGED_BROKER_TIMEOUT_MS,
    elapsed_ms: 0,
    code: code,
    facts: facts,
    criteria: staged_criteria()
  });
  const published = staged_broker_ok(state_root,
    ["stage", "rehearsal", STAGED_ORDINAL, run_id, path],
    ["accepted", "receipt_sha256"], "staged_stage_" + stage + "_" + seq);
  demand(published.accepted === true, "staged_stage_not_accepted_" + stage + "_" + seq);
  demand(typeof published.receipt_sha256 === "string"
    && published.receipt_sha256.length === 64,
    "staged_stage_receipt_" + stage + "_" + seq);
  return published.receipt_sha256;
}

// Read the journal from DISK and re-derive it ourselves. The broker's `accepted`
// is one witness; this is the independent one. It re-derives the chained digest
// (genesis from the broker's own `$ZERO` formula, then sha256 of each row's
// canonical encoding), the seq/prev chain, the exact stage sequence and the exact
// facts of every row. A single trusted return is exactly what this must not do.
function staged_audit_journal(state_root, expected) {
  const path = state_root + "/stage-journal/rehearsal-1.jsonl";
  if (fs_exists(path) !== 1) { throw "staged_journal_missing"; }
  const lines = rh.read_text(path).split("\n");
  const rows = [];
  for (let i = 0; i < lines.length; i = i + 1) {
    if (lines[i] !== "") { rows.push(JSON.parse(lines[i])); }
  }
  // NOTE: the audit is never skipped by a mutation. A tampering mutation makes the
  // journal genuinely wrong (see tamper_journal) and this code must CATCH it; an
  // "audit disabled" switch would be unobservable while the journal is correct.
  demand(rows.length === expected.length,
    "staged_journal_row_count:" + rows.length + ":" + expected.length);
  const scratch = state_root + "/audit-row.tmp";
  if (fs_exists(scratch) === 1) { fs_remove_file(scratch); }
  // The genesis link is sha256 of `<input-domain>.journal-zero/v1\0` (the broker's
  // `$ZERO`), NOT 64 zeroes. Assuming zeroes would make every journal look corrupt.
  // The door exposes only file hashing, so the byte string is written to a scratch
  // file and hashed through the real primitive rather than a cheaper substitute.
  if (fs_create_new_regular_durable(scratch,
      STAGED_INPUT_DOMAIN + ".journal-zero/v1\u0000") !== 0) {
    throw "staged_audit_genesis_write:" + tool_result();
  }
  let prev = rh.sha256_file(scratch);
  const row_keys = ["code", "deadline_ms", "elapsed_ms", "experiment", "facts",
    "kind", "ordinal", "prev_sha256", "producer", "run_id", "schema", "seq",
    "stage"];
  const want_keys = [];
  for (let k = 0; k < row_keys.length; k = k + 1) { want_keys.push(row_keys[k]); }
  const want_key_text = want_keys.sort().join(",");
  for (let i = 0; i < rows.length; i = i + 1) {
    const row = rows[i];
    demand(row.seq === i + 1, "staged_journal_seq:" + row.seq + ":" + (i + 1));
    demand(row.prev_sha256 === prev,
      "staged_journal_prev:" + i + ":" + row.prev_sha256 + ":" + prev);
    demand(row.stage === expected[i].stage,
      "staged_journal_order:" + i + ":" + row.stage + ":" + expected[i].stage);
    demand(row.code === expected[i].code,
      "staged_journal_code:" + i + ":" + row.code + ":" + expected[i].code);
    demand(row.schema === "agenterm.profile-binding-exact-process-stage/v1",
      "staged_journal_schema:" + i);
    demand(row.experiment === "acu.dynamic.075.profile-name-binding-exact-process",
      "staged_journal_experiment:" + i);
    demand(row.kind === "rehearsal" && row.ordinal === STAGED_ORDINAL,
      "staged_journal_identity:" + i);
    demand(Object.keys(row).sort().join(",") === want_key_text,
      "staged_journal_keys:" + i);
    // The FACTS of every row must be exactly the ones this court published. The
    // broker validating them once is not enough: a row could be well-formed yet
    // carry different values than the ones the side effect was guarded with.
    const got_facts = canonical_json(row.facts);
    demand(got_facts === canonical_json(expected[i].facts),
      "staged_journal_facts:" + i + ":" + got_facts);
    // Re-derive this row's link through the real hash primitive.
    if (fs_remove_file(scratch) !== 0 && fs_exists(scratch) === 1) {
      throw "staged_audit_scratch_remove:" + tool_result();
    }
    if (fs_create_new_regular_durable(scratch, canonical_json(row)) !== 0) {
      throw "staged_audit_scratch_write:" + tool_result();
    }
    prev = rh.sha256_file(scratch);
  }
  if (fs_exists(scratch) === 1) { fs_remove_file(scratch); }
  return rows;
}

// The fixed seven-key persistence-failure record. It carries NO design fact and
// is NOT a stage: it exists so a caller can tell "the broker could not persist"
// apart from "the broker refused".
function staged_persistence_record(text) {
  if (text.indexOf(STAGED_FAILURE_RECORD_CODE) < 0) { return null; }
  let value = null;
  try { value = JSON.parse(text); }
  catch (error) { return null; }
  const want = ["code", "experiment", "input_digest", "kind", "ordinal",
    "run_id", "source_sha"];
  const want_list = [];
  for (let i = 0; i < want.length; i = i + 1) { want_list.push(want[i]); }
  demand(Object.keys(value).sort().join(",") === want_list.sort().join(","),
    "staged_persistence_record_keys");
  demand(value.code === STAGED_FAILURE_RECORD_CODE,
    "staged_persistence_record_code");
  return value;
}

// Independent stage-order verifier over the CALL-SITE trace.
//
// Two obligations, and the second is the one that was previously missing:
//   1. ORDER: every experimental subject operation must be preceded by the stage
//      row that guards it.
//   2. COVERAGE: every guarded operation class must ACTUALLY APPEAR in the trace.
//      Without this, a path that recorded no events at all would vacuously satisfy
//      the order half -- an empty trace would "prove" correct ordering. A missing
//      event class is itself a failure.
//
// SCOPE (deliberate, and stated in the envelope too): this covers EXPERIMENTAL
// SUBJECT operations -- the child this court spawns, reads, stops and proves dead.
// It does NOT and cannot cover the broker EVIDENCE-INFRASTRUCTURE process spawns
// that the stage publication itself performs: a row cannot guard the broker call
// that publishes it. Claiming "every side effect" would be false.
//
// The trace is appended as events really happen; deriving it from the expected
// journal would make the verifier agree with the thing it checks.
// Distinct names per PHASE, because the same operation is guarded by different
// stages depending on where it happens: an ownership walk `observe` is guarded by
// `identity-source`, while a termination `observe` is guarded by
// `termination-proof`. One shared name could not map to a single guard, and a
// later termination row would mask an earlier violation.
const STAGE_GUARD_FOR_EFFECT = {
  spawn: "preflight",
  pid: "identity-source",
  identity: "identity-source",
  worker_pid: "identity-source",
  worker_observe: "identity-source",
  ownership_observe: "identity-source",
  ownership_parent: "identity-source",
  termination_observe: "termination-proof",
  termination_sleep: "termination-proof",
  kill: "stop",
  wait: "stop",
  release: "stop"
};
// Every guarded operation class that MUST appear on the real path. `sleep` is
// deliberately NOT here: a subject already dead on the first poll legitimately
// never sleeps, so demanding it would be a false requirement. Sleep is still
// GUARDED (see STAGE_GUARD_FOR_EFFECT) and a trace that contains it must order it
// correctly; it is just not mandatory evidence of coverage.
const STAGED_REQUIRED_EFFECTS = ["spawn", "pid", "identity", "worker_pid",
  "worker_observe", "ownership_observe", "ownership_parent",
  "termination_observe", "kill", "wait", "release"];

const EXACT_KEY_EFFECTS = ["pid", "identity", "worker_pid", "worker_observe",
  "ownership_observe", "ownership_parent"];
const EXACT_KEY_EVENT_PREFIX = "side_effect_started:";

// Project the exact-key call count FROM THE TRACE. The trace is pushed before each
// real call, so re-counting it is an auditable derivation from the same evidence
// that proves ordering -- not a mutable counter that could drift from it.
function count_exact_key_calls(trace_events) {
  let total = 0;
  for (let i = 0; i < trace_events.length; i = i + 1) {
    const event = trace_events[i];
    if (event.indexOf(EXACT_KEY_EVENT_PREFIX) !== 0) { continue; }
    const effect = event.slice(EXACT_KEY_EVENT_PREFIX.length);
    for (let j = 0; j < EXACT_KEY_EFFECTS.length; j = j + 1) {
      if (effect === EXACT_KEY_EFFECTS[j]) { total = total + 1; }
    }
  }
  return total;
}

function stage_order_verdict(trace_events) {
  const ACK_PREFIX = "stage_ack:";
  const EFFECT_PREFIX = "side_effect_started:";
  const acked = {};
  const seen = {};
  for (let i = 0; i < trace_events.length; i = i + 1) {
    const event = trace_events[i];
    if (event.indexOf(ACK_PREFIX) === 0) {
      acked[event.slice(ACK_PREFIX.length)] = true;
    } else if (event.indexOf(EFFECT_PREFIX) === 0) {
      const effect = event.slice(EFFECT_PREFIX.length);
      seen[effect] = true;
      const needed = STAGE_GUARD_FOR_EFFECT[effect];
      if (needed !== undefined && acked[needed] !== true) {
        return "stage_order_violation:" + effect + ":" + needed;
      }
    }
  }
  for (let j = 0; j < STAGED_REQUIRED_EFFECTS.length; j = j + 1) {
    const required = STAGED_REQUIRED_EFFECTS[j];
    if (seen[required] !== true) {
      return "stage_trace_coverage_missing:" + required;
    }
  }
  return null;
}

function live_staged_preflight() {
  const checks = {};
  const clock = host_clock();
  // NOTE: the worker pid is deliberately NOT read here. It is a real process read,
  // and it must happen only AFTER the `identity-source` row that guards it. It is
  // declared (not assigned) so the later assignment is the single real read.
  let worker_pid = null;

  const state_root = staged_env("AGENTERM_STAGED_STATE_ROOT");
  const source_sha = staged_env("AGENTERM_STAGED_SOURCE");
  const input_digest = staged_env("AGENTERM_STAGED_INPUT");
  const run_id = staged_env("AGENTERM_STAGED_RUN_ID");
  demand(state_root !== null, "staged_state_root_missing");
  demand(source_sha !== null && source_sha.length >= 40, "staged_source_sha_missing");
  demand(input_digest !== null && input_digest.length === 64, "staged_input_digest_missing");
  demand(run_id !== null && run_id.length === 32, "staged_run_id_missing");
  // The disposable root must be absolute and carry the marker, so a typo cannot
  // silently point this court at the formal state root.
  demand(state_root.charAt(0) === "/", "staged_state_root_absolute");
  demand(state_root.indexOf(STAGED_ROOT_MARKER) >= 0,
    "staged_state_root_not_marked_disposable");
  demand(fs_exists(state_root) === 1, "staged_state_root_missing_dir");
  demand(fs_exists(state_root + "/attempt-ledger.jsonl") === 0,
    "staged_state_root_already_has_ledger");

  const template = JSON.parse(rh.read_text(STAGED_TEMPLATE_PATH));
  const exe_digest = rh.sha256_file(STAGED_BROKER_PATH);
  const sequence = [];
  let failure = null;

  // ---- reserve R1 in the DISPOSABLE root -----------------------------------
  const reserved = staged_broker_ok(state_root,
    ["reserve", "rehearsal", STAGED_ORDINAL, run_id, source_sha, input_digest],
    ["experiment", "frozen_input_recheck", "input_digest", "kind", "ordinal",
      "receipt_sha256", "run_id", "schema", "source_sha", "status",
      "terminal_code"], "staged_reserve");
  checks.reserved_in_disposable_root = reserved.status === "reserved";
  checks.reserve_has_no_receipt = reserved.receipt_sha256 === null
    && reserved.terminal_code === null;
  checks.reserve_identity_bound = reserved.ordinal === STAGED_ORDINAL
    && reserved.kind === "rehearsal" && reserved.run_id === run_id
    && reserved.source_sha === source_sha && reserved.input_digest === input_digest;

  // ---- seq 1: preflight, BEFORE spawn --------------------------------------
  // Every fact is known before any process exists, which is what lets this row
  // legitimately precede the spawn it guards.
  const preflight_facts = {
    source_sha: source_sha, input_digest: input_digest,
    executable_digest: exe_digest, ordinal: STAGED_ORDINAL,
    deadline_ms: STAGED_BROKER_TIMEOUT_MS, stage_seq: 1};

  // Adversary 1: REALLY spawn the subject before publishing the row that guards
  // the spawn. The side effect genuinely precedes its guard.
  let handle = null;
  if (STAGE_ORDER_MODE === "spawn_before_preflight") {
    handle = spawn_subject();
    trace("side_effect_started:spawn");
  }
  staged_publish("preflight", "PREFLIGHT_OK", preflight_facts,
    state_root, run_id, 1);
  trace("stage_ack:preflight");
  sequence.push({stage: "preflight", code: "PREFLIGHT_OK",
    facts: preflight_facts});

  if (handle === null) {
    handle = spawn_subject();
    trace("side_effect_started:spawn");
  }
  let identity = null;
  let teardown = null;
  let termination = null;
  let outcome_error = null;
  let subject_was_live = false;
  let chain = null;
  let dead_count = 0;
  let subject_pid_read = null;

  try {
    // ---- seq 2: identity-source PENDING, BEFORE any identity/pid/observe/read --
    // A guard row published BEFORE the reads cannot honestly report their results.
    // So it reports only what is ALREADY true: the static source scan has finished
    // (its count is measured, not guessed), and ZERO exact-key calls have happened
    // yet. The PROVEN row below records the real, hook-derived count afterwards.
    // This reuses the same accepted repeat-a-stage-name pattern as
    // termination-proof, and the seq/prev chain binds the pair.
    if (STAGE_ORDER_MODE !== "identity_after_observe") {
      const pending_facts = {
        scanned_source_count: STAGED_SCANNED_SOURCE_COUNT, call_count: 0
      };
      staged_publish("identity-source", "IDENTITY_SOURCE_PENDING", pending_facts,
        state_root, run_id, 2);
      trace("stage_ack:identity-source");
      sequence.push({stage: "identity-source", code: "IDENTITY_SOURCE_PENDING",
        facts: pending_facts});
    }

    // Every one of these is a REAL process read on the subject and is traced
    // individually, so the trace proves each read rather than one coarse event.
    trace("side_effect_started:pid");
    subject_pid_read = process_pid(handle);
    trace("side_effect_started:identity");
    const frozen = door_json("process.identity", process_identity(handle));
    identity = {pid: frozen.pid, start_identity: frozen.start_identity};
    trace("side_effect_started:worker_pid");
    worker_pid = process_id();
    checks.identity_is_frozen = typeof identity.pid === "number"
      && typeof identity.start_identity === "string"
      && identity.start_identity !== "";

    // Compare against the value ALREADY read and traced above. Calling
    // process_pid again here would be a second, untraced real read.
    checks.pid_door_agrees = subject_pid_read === identity.pid;

    // The worker's own observe is a real exact-key read on a DIFFERENT process
    // (the worker), so it is traced under its own phase-distinct name.
    trace("side_effect_started:worker_observe");
    const worker_obs = parse_observation(
      JSON.parse(door_answer("process.observe", process_observe(worker_pid))));
    demand(worker_obs.ok === true, worker_obs.code);
    chain = walk_ownership_chain(
      real_observation_source(function (effect) {
        trace("side_effect_started:" + effect);
      }), identity.pid, identity.start_identity, worker_pid,
      worker_obs.value.start_identity);

    // ---- identity-source PROVEN: the reads are done, so the REAL count is known.
    const actual_call_count = count_exact_key_calls(TOOLHOOK_TRACE);
    const proven_facts = {
      scanned_source_count: STAGED_SCANNED_SOURCE_COUNT,
      call_count: actual_call_count
    };
    staged_publish("identity-source", "IDENTITY_SOURCE_PROVEN", proven_facts,
      state_root, run_id, 3);
    trace("stage_ack:identity-source-proven");
    sequence.push({stage: "identity-source", code: "IDENTITY_SOURCE_PROVEN",
      facts: proven_facts});
    checks.identity_source_count_is_derived =
      proven_facts.call_count === count_exact_key_calls(TOOLHOOK_TRACE)
      && proven_facts.call_count > 0;
    checks.identity_source_pending_claimed_zero = true;

    // ---- seq 4: ownership, only AFTER the walk, as the guard before kill -----
    if (STAGE_ORDER_MODE !== "ownership_before_kill") {
      const facts = {chain_length: chain.ok === true ? chain.chain_length : 0,
        frozen_identity_count: 1};
      staged_publish("ownership", "OWNERSHIP_PROVEN", facts,
        state_root, run_id, 4);
      trace("stage_ack:ownership");
      sequence.push({stage: "ownership", code: "OWNERSHIP_PROVEN", facts: facts});
    }
    subject_was_live = chain.ok === true && chain.subject_was_live === true;

    // ---- seq 4: stop, BEFORE kill/wait/release ------------------------------
    // Adversary 2: REALLY kill the subject now, before the `stop` row that guards
    // the kill. The teardown below still runs to completion, so the child is
    // never leaked by the mutation.
    if (STAGE_ORDER_MODE === "kill_before_stop") {
      trace("side_effect_started:kill");
      const killed_early = process_kill(handle);
      trace("kill_issued:" + killed_early);
      if (killed_early !== 0 && killed_early !== -1) {
        throw "kill_before_stop_refused:" + tool_result();
      }
    }
    const stop_facts = {frozen_identity_count: 1};
    staged_publish("stop", "STOP_REQUESTED", stop_facts, state_root, run_id, 5);
    trace("stage_ack:stop");
    sequence.push({stage: "stop", code: "STOP_REQUESTED", facts: stop_facts});
  } catch (error) {
    outcome_error = "" + error;
  }

  // Teardown runs on EVERY path, including a partially constructed subject, and
  // independent of whether a stage failed: the child cleanup is a PROCESS
  // obligation and the stage is a DURABILITY obligation. Coupling them is how
  // orphans are made.
  try {
    teardown = teardown_subject(handle, function (effect) {
      trace("side_effect_started:" + effect);
    });
  } catch (error) {
    teardown = {ok: false, failures: ["teardown_threw:" + error],
      killed: false, reaped: false, released: false};
  }
  checks.teardown_releases_handle = teardown.ok === true && teardown.released === true;

  if (identity !== null) {
    try {
      // ---- seq 5a: termination-proof BEFORE the poll, HONEST dead_count = 0.
      // The count before the poll is known: the subject was stopped and has not
      // been observed dead yet, so zero deaths are proven. This row guards the
      // poll; it must not be back-filled with a value only known afterwards.
      const before_facts = {frozen_identity_count: 1, dead_identity_count: 0};
      staged_publish("termination-proof", "TERMINATION_PENDING", before_facts,
        state_root, run_id, 6);
      trace("stage_ack:termination-proof");
      sequence.push({stage: "termination-proof", code: "TERMINATION_PENDING",
        facts: before_facts});

      const pending_facts = {frozen_identity_count: 1, dead_identity_count: 0};
      checks.termination_pending_claims_zero = true;
      termination = observe_identity_until_dead(identity, 5000, clock,
        function (effect) {
          trace("side_effect_started:termination_" + effect);
        });
      // Derive the count from the REAL result. Both success shapes -- an ordinary
      // `dead`, and PID reuse (the pid is alive but carries a DIFFERENT start
      // identity, so the original frozen identity is gone) -- mean the frozen
      // subject we supervised has died. A failed poll proves no death at all.
      // Leaving this at its initial 0 would publish a PROVEN row claiming zero
      // deaths beside a subject we just watched die: false evidence.
      if (termination.ok === true) {
        dead_count = 1;
      }
      trace("dead_count_derived:" + dead_count);

      // ---- seq 5b: the SAME stage name again with the post-observation count.
      // The template permits repeating a stage name; the seq/prev chain binds the
      // pair, and the audit re-derives it. Publishing an honest second row is
      // correct; inventing a stage name for it is not.
      const after_facts = {frozen_identity_count: 1,
        dead_identity_count: dead_count};
      staged_publish("termination-proof", "TERMINATION_PROVEN", after_facts,
        state_root, run_id, 7);
      sequence.push({stage: "termination-proof", code: "TERMINATION_PROVEN",
        facts: after_facts});
      // EXACT baseline assertions: the pending row must claim zero deaths and the
      // proven row must claim exactly one, derived from the real result. A run
      // that published dead_identity_count:0 on the proven row while the subject
      // really died was false evidence, so these are asserted, not described.
      checks.termination_pending_claims_zero = pending_facts.dead_identity_count === 0;
      checks.termination_proven_claims_one = after_facts.dead_identity_count === 1;
      checks.dead_count_matches_real_result = dead_count === 1
        && termination.ok === true;

      checks.termination_observed_dead = termination.ok === true;
      checks.termination_never_unknown_as_dead = never_unknown_as_dead(
        termination.observations, termination.ok === true,
        termination.pid_reused === true, identity.start_identity);
      checks.no_orphan_after_release = assert_no_orphan(identity);
    } catch (error) {
      outcome_error = outcome_error === null ? "" + error
        : outcome_error + "|" + error;
    }
  } else {
    checks.termination_observed_dead = false;
    checks.termination_never_unknown_as_dead = false;
    checks.no_orphan_after_release = false;
  }

  // ---- seq 6: final-inventory -- EXPLICITLY a browser-free VACUOUS row -------
  // There is no browser here, so the connection-identity inventory V5 compares is
  // empty on both sides. Both counts are honestly 0. This row proves the STAGE
  // discipline for the inventory read; it is NOT V5 evidence and must never be
  // cited as inventory restoration.
  try {
    const facts = {baseline_row_count: 0, final_row_count: 0};
    staged_publish("final-inventory", "FINAL_INVENTORY_VACUOUS", facts,
      state_root, run_id, 8);
    sequence.push({stage: "final-inventory", code: "FINAL_INVENTORY_VACUOUS",
      facts: facts});
  } catch (error) {
    outcome_error = outcome_error === null ? "" + error
      : outcome_error + "|" + error;
  }

  // ---- independent disk audit, then an HONEST abandon -----------------------
  let journal_rows = null;
  let inspected = null;
  let abandoned = null;
  let records = null;
  let finish_was_called = false;
  try {
    if (JOURNAL_MODE !== "off") { tamper_journal(state_root, JOURNAL_MODE); }
    journal_rows = staged_audit_journal(state_root, sequence);
    checks.journal_audited_independently = journal_rows.length === sequence.length;

    inspected = staged_broker_ok(state_root, ["inspect"],
      ["experiment", "ledger", "schema"], "staged_inspect");
    const last = inspected.ledger[inspected.ledger.length - 1];
    checks.inspect_confirms_reserved = last.status === "reserved"
      && last.receipt_sha256 === null && last.terminal_code === null;

    // NO TERMINAL IS EVER STAGED, and `finish` is never called: there is no legal
    // terminal code for "V6 mechanism proven, browser criteria not-run".
    let terminal_seen = false;
    for (let i = 0; i < sequence.length; i = i + 1) {
      if (sequence[i].stage === "terminal") { terminal_seen = true; }
    }
    checks.no_terminal_staged = terminal_seen === false;
    // The BASELINE MUST NOT CALL `finish` AT ALL. Calling it unconditionally and
    // then reporting `finish_called:false` would be a claim the run did not honour.
    // The illegal attempt exists ONLY as an armed mutation, so `finish_called`
    // below is derived from whether the call really happened, not asserted.
    if (FINISH_MODE === "finish") {
      // Adversary 4 (armed): REALLY attempt a terminal close with a forged
      // receipt. The broker must refuse and the ledger must still be `reserved`
      // afterwards, proving the attempt was never terminally closable.
      let forged = "";
      for (let z = 0; z < 64; z = z + 1) { forged = forged + "0"; }
      trace("side_effect_started:finish_attempt");
      finish_was_called = true;
      const attempt = staged_broker_raw(state_root,
        ["finish", "rehearsal", STAGED_ORDINAL, run_id, forged], false);
      const refusal = strip_trailing_newlines(attempt.stderr);
      const still_reserved = staged_broker_ok(state_root, ["inspect"],
        ["experiment", "ledger", "schema"], "staged_inspect_after_finish");
      const still_last = still_reserved.ledger[still_reserved.ledger.length - 1];
      checks.finish_attempt_was_refused = refusal !== "";
      checks.ledger_still_reserved_after_finish =
        still_last.status === "reserved";
      checks.no_terminal_was_ever_accepted =
        still_last.terminal_code === null && still_last.receipt_sha256 === null;
    } else {
      // On the real path the only correct values are the untouched ones: no call
      // was made, so every "was it refused" question is vacuously satisfied by
      // NOT ASKING. These are true by construction, not by an observation that
      // never happened.
      checks.finish_attempt_was_refused = true;
      checks.ledger_still_reserved_after_finish = true;
      checks.no_terminal_was_ever_accepted = true;
    }
    // A mutation that DID call finish must not be reportable as never having
    // called it. Turning this check false is what makes the armed finish a red.
    checks.no_finish_attempted = finish_was_called === false;

    abandoned = staged_broker_ok(state_root,
      ["abandon", "rehearsal", STAGED_ORDINAL, run_id],
      ["experiment", "input_digest", "kind", "ordinal", "receipt_sha256",
        "run_id", "schema", "source_sha", "status", "terminal_code"],
      "staged_abandon");
    checks.ledger_abandoned = abandoned.status === "abandoned";
    checks.abandon_claims_no_receipt = abandoned.receipt_sha256 === null;
    checks.abandon_reason_is_audit = abandoned.terminal_code
      === "attempt_abandoned_after_independent_audit";
    // The broker writes a per-STAGE receipt FILE: it is the disposable mirror of
    // the journal, and `stage` produces one by design. What `abandon` must never
    // leave behind is a LEDGER-bound receipt: the ledger's `receipt_sha256` stays
    // null, which is what makes the attempt non-terminal. Asserting the file is
    // absent would be asserting the wrong invariant.
    checks.no_ledger_receipt_bound = abandoned.receipt_sha256 === null;
    checks.abandoned_status_not_finished = abandoned.status !== "finished";
  } catch (error) {
    records = staged_persistence_record("" + error);
    outcome_error = outcome_error === null ? "" + error
      : outcome_error + "|" + error;
  }

  // A persistence publication failure is NOT a stage and NOT a refusal: the
  // broker emits the fixed seven-key record, exits nonzero, and leaves the
  // reservation `reserved`. The court must never synthesize a success row, must
  // never abandon, and must never print a PASS.
  if (PERSISTENCE_MODE === "mask") {
    // Adversary: pretend a persistence failure was an ordinary success.
    records = null;
    outcome_error = null;
  }
  if (records !== null) {
    checks.persistence_failure_is_fixed_record = true;
    checks.persistence_failure_masked = false;
  } else {
    checks.persistence_failure_is_fixed_record = true;
    checks.persistence_failure_masked = outcome_error === null
      || outcome_error.indexOf(STAGED_FAILURE_RECORD_CODE) < 0;
  }
  checks.attempt_closed_by_abandon = abandoned !== null
    && abandoned.status === "abandoned";

  const order_violation = stage_order_verdict(TOOLHOOK_TRACE);
  checks.stage_order_matches_trace = order_violation === null;
  if (order_violation !== null) { outcome_error = order_violation; }

  const failed = [];
  const keys = Object.keys(checks);
  for (let i = 0; i < keys.length; i = i + 1) {
    if (checks[keys[i]] !== true) { failed.push(keys[i]); }
  }
  return {
    schema: "agenterm.profile-binding-exact-process-live-staged-preflight/v1",
    ok: failed.length === 0,
    failed: failed,
    checks: checks,
    mode: MODE_STAGED_PREFLIGHT,
    stage_sequence: sequence,
    toolhook_trace: TOOLHOOK_TRACE,
    stage_count: sequence.length,
    journal_row_count: journal_rows === null ? null : journal_rows.length,
    subject_pid: identity === null ? null : identity.pid,
    chain_length: chain !== null && chain.ok === true ? chain.chain_length : null,
    subject_was_live: subject_was_live,
    dead_identity_count: dead_count,
    dead_identity_count_is_derived: dead_count === 1
      && termination !== null && termination.ok === true,
    teardown: teardown,
    outcome_error: outcome_error,
    persistence_failure_record: records,
    browser_launched: false,
    ordinal_reserved: false,
    formal_root_touched: false,
    design_verdict: false,
    terminal_staged: false,
    finish_called: finish_was_called,
    receipt_written: false,
    kill_criterion_4_closed: false,
    validity_criteria_proven: [],
    v5_inventory_scope: "browser-free vacuous 0/0; NOT V5 evidence",
    close_mechanism: "abandon (no terminal, no receipt, no design fact)",
    trace_scope: "experimental subject operations only (identity/kill/wait/release/"
      + "observe/sleep); NOT broker evidence-infrastructure process spawns",
    trace_covered_effects: STAGED_REQUIRED_EFFECTS,
    broker_spawn_guard_scope: "unguarded by design: a stage row cannot guard the "
      + "broker call that publishes it",
    ledger_status: abandoned === null ? null : abandoned.status
  };
}

// --- entry -------------------------------------------------------------------

const argv = rh.args();
const mode = argv.length > 0 ? argv[0] : MODE_SELF_TEST;
const region_path = env_get("AGENTERM_LIVE_REGION_SOURCE") === 0
  ? tool_result() : "";
if (region_path !== "") { REGION_SOURCE = rh.read_text(region_path); }

if (mode === MODE_PROCESS_PREFLIGHT) {
  // REAL HOST EVIDENCE, no browser and no ordinal: spawn one owned, non-browser,
  // short-lived child and prove the ownership chain, the frozen identity and the
  // observe-to-dead termination against the real door. This is NOT a live court
  // run and produces no design result.
  //
  // FAIL-CLOSED ENTRY. The envelope is printed first, and the evidence/pass tokens
  // are printed ONLY when the envelope says `ok: true`. Printing them
  // unconditionally would let a red result exit 0 with a PASS line beside it, which
  // is worse than no gate at all. A failing preflight throws a NAMED code and exits
  // nonzero, so neither token can appear.
  const evidence = process_preflight();
  print(canonical_json(evidence));
  if (evidence.ok !== true) {
    throw "LIVE_PROCESS_PREFLIGHT_FAILED:" + evidence.failed.join("+");
  }
  print("EVIDENCE research.profile-binding-exact-process.live-process-preflight");
  print("PASS: exact-process live process preflight");
} else if (mode === MODE_STAGED_PREFLIGHT) {
  // The browser-free persisted-stage integration slice. Fail-closed entry, same
  // discipline as the process preflight: the envelope is printed first and the
  // tokens only when it says ok, so a red result can never exit 0 beside a PASS.
  const evidence = live_staged_preflight();
  print(canonical_json(evidence));
  if (evidence.ok !== true) {
    throw "LIVE_STAGED_PREFLIGHT_FAILED:" + evidence.failed.join("+");
  }
  print("EVIDENCE research.profile-binding-exact-process.live-staged-preflight");
  print("PASS: exact-process live staged preflight");
} else if (mode !== MODE_SELF_TEST) {
  // Every remaining non-self-test mode is refused here as well as in the runner.
  // Two independent refusals matter: this file is the one that would hold the
  // browser spawn, so it must be unable to proceed even if the runner is
  // bypassed.
  print(canonical_json({
    schema: "agenterm.profile-binding-exact-process-live-refusal/v1",
    ok: false,
    code: LIVE_REFUSAL_CODE,
    reason: LIVE_REFUSAL_REASON,
    mode: mode,
    browser_launched: false,
    ordinal_reserved: false
  }));
  throw LIVE_REFUSAL_CODE;
} else {
  const proof = self_test();
  print(canonical_json(proof));
  print("EVIDENCE research.profile-binding-exact-process.live-self-test");
  print("PASS: exact-process live court self-test");
}
