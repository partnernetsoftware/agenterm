  },
  "journal_row_rules": {
    "keys": "exactly journal_keys",
    "sequence": "safe integer beginning at zero and increasing by exactly one",
    "code": "stage_pass or one terminal_codes value",
    "facts": "exact subset of common_stage_facts plus the reached stage required and optional whitelist",
    "publication": "RFC 8785 canonical JSON followed by atomic replacement, readback and byte equality"
  },
  "receipt_rules": {
    "keys": "exactly receipt_keys",
    "stage_statuses": "exact object with every stage_order key and a stage_status_values value",
    "criteria": "exact object with every criteria_keys key and a criterion_result_shape value",
    "terminal_code": "exactly one terminal_codes value",
    "scan": "exact receipt_sections.scan object; when complete is true every nullable field is non-null; when complete is false a nullable field is null exactly when the corresponding measured fact is unavailable and is never synthesized as zero",
    "scan_source": "receipt.scan and the scan-coverage stage derive from the same validated process-probe summary; every same-named field present in both is exactly equal, and a failed scan-coverage stage omits unavailable optional stage facts while receipt.scan retains their required keys as JSON null",
    "sample_sequence_digest": "sha256 of the UTF-8 domain agenterm.singleton-safety.v1.sample-sequence, one 0x00 byte, and the RFC 8785 canonical JSON ordered sanitized sample array; zero samples uses the literal empty array and does not prove coverage",
    "journal_sha256": "sha256 of the exact authoritative journal file bytes after final atomic readback",
    "publication": "RFC 8785 canonical JSON followed by atomic replacement, readback and hashing before any lane mirror"
  },
