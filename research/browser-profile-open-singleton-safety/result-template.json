  "limits": {
    "journal_max_rows_exclusive": 64,
    "journal_max_row_bytes_exclusive": 32768,
    "journal_max_total_bytes_exclusive": 1048576,
    "scan_row_max": 4096,
    "group_membership_max": 4096,
    "scan_cadence_target_ms": 20,
    "scan_interval_max_ms": 200,
    "scan_enumeration_max_ms": 200,
    "direct_request_exit_deadline_ms": 5000,
    "relay_exit_deadline_ms": 5000,
    "relay_first_start_window_ms": 2000,
    "focus_restore_deadline_ms": 5000,
    "rehearsal_outer_deadline_ms": 165000,
    "rehearsal_serial_budget_ms": 140000,
    "decision_outer_deadline_ms": 180000,
    "decision_serial_budget_ms": 155000,
    "unsafe_cleanup_signals_per_target_max": 1
  },
  "serial_budget_phases": {
    "rehearsal": [
      {"name": "admission-and-reservation", "max_ms": 20000, "stages": ["preflight"]},
      {"name": "two-fixtures-termination-and-restoration", "max_ms": 35000, "stages": ["focus-baseline", "fixture-ready", "rehearsal-foreground", "rehearsal-window-close", "rehearsal-terminate"]},
      {"name": "public-session-start-and-status", "max_ms": 20000, "stages": ["session-ready"]},
      {"name": "independent-ownership-witnesses", "max_ms": 15000, "stages": ["ownership"]},
      {"name": "session-stop-remove-and-absence", "max_ms": 25000, "stages": ["session-stop", "termination-proof", "session-remove", "root-removal"]},
      {"name": "original-foreground-restoration", "max_ms": 10000, "stages": ["original-restore"]},
      {"name": "persistence-and-terminal-publication", "max_ms": 15000, "stages": ["final-inventory", "scan-coverage", "terminal"]}
    ],
    "decision": [
      {"name": "admission-and-reservation", "max_ms": 20000, "stages": ["preflight"]},
      {"name": "focus-fixture", "max_ms": 15000, "stages": ["focus-baseline", "fixture-ready"]},
      {"name": "public-session-start-status-and-ownership", "max_ms": 20000, "stages": ["session-ready", "ownership"]},
      {"name": "direct-open-and-relay-classification", "max_ms": 10000, "stages": ["open-request", "relay"]},
      {"name": "owned-window-space-and-focus-proof", "max_ms": 20000, "stages": ["window-ready"]},
      {"name": "exact-window-close", "max_ms": 10000, "stages": ["window-close"]},
      {"name": "session-stop-remove-and-absence", "max_ms": 25000, "stages": ["session-stop", "termination-proof", "session-remove", "root-removal"]},
      {"name": "both-natural-restorations", "max_ms": 10000, "stages": ["fixture-restore", "original-restore"]},
      {"name": "persistence-and-terminal-publication", "max_ms": 25000, "stages": ["final-inventory", "scan-coverage", "terminal"]}
    ]
  },
  "stage_deadline_rule": "deadline_ms is the absolute monotonic deadline of the stage's serial_budget_phase; every stage in one phase shares that deadline and cannot reset or borrow outer scheduling slack",
  "artifact_mapping": {
    "R1": {
      "kind": "rehearsal",
