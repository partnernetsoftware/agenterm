// Pure Bun-free compatibility pipeline. It owns legacy argv shape only; the
// native command schema, authorization, mechanisms and receipts remain in
// agenterm-cu through agenterm:acu.argv.

import * as legacy from "agenterm:acu/legacy-args";
import * as rewrite from "agenterm:acu/rewrite";

export const LEGACY_TOP_LEVEL = [
  "windows", "apps", "query", "invoke", "verify", "wait", "unlock",
  "observe", "focused", "click", "dclick", "rclick", "type", "key",
  "move", "shot", "clip", "clipboard", "displays", "spaces", "cursor",
  "frame", "movewin", "resize", "maximize", "close", "orderwin",
  "focus", "raise", "minimize", "restore", "hit", "snapshot", "diff",
  "launch", "quit", "hide", "show", "ps", "kill", "doctor", "permissions",
  "resource"
];

function contains(values, wanted) {
  for (let i = 0; i < values.length; i = i + 1) {
    if (values[i] === wanted) { return true; }
  }
  return false;
}

function append(out, values) {
  for (let i = 0; i < values.length; i = i + 1) { out.push(values[i]); }
}

function exec_with_prefix(prefix, argv) {
  const out = [];
  append(out, prefix);
  append(out, argv);
  return { kind: "exec", argv: out };
}

function has_arg(argv, wanted) {
  for (let i = 0; i < argv.length; i = i + 1) {
    if (argv[i] === wanted || argv[i].startsWith(wanted + "=")) { return true; }
  }
  return false;
}

function todo(gap_id, command, message) {
  return { kind: "todo", gap_id: gap_id, command: command, message: message };
}

function copy(values) {
  const out = [];
  append(out, values);
  return out;
}

function copy_from(values, start) {
  const out = [];
  for (let i = start; i < values.length; i = i + 1) { out.push(values[i]); }
  return out;
}

function value_flag(argv, name) {
  const prefix = "--" + name + "=";
  let found = null;
  for (let i = 0; i < argv.length; i = i + 1) {
    if (argv[i] === "--" + name) {
      if (found !== null || i + 1 >= argv.length || argv[i + 1].startsWith("--")) {
        return { ok: false, message: "--" + name + " requires one unambiguous value" };
      }
      found = { value: argv[i + 1], index: i, consumed: 2 };
      i = i + 1;
    } else if (argv[i].startsWith(prefix)) {
      if (found !== null) {
        return { ok: false, message: "--" + name + " may be specified only once" };
      }
      found = { value: argv[i].slice(prefix.length), index: i, consumed: 1 };
    }
  }
  return found === null ? { ok: true, present: false, value: null }
    : { ok: true, present: true, value: found.value, index: found.index, consumed: found.consumed };
}

function without_value_flags(argv, names) {
  const removed = {};
  const skips = {};
  for (let n = 0; n < names.length; n = n + 1) {
    const flag = value_flag(argv, names[n]);
    if (!flag.ok) { return flag; }
    removed[names[n]] = flag.present ? flag.value : null;
    if (flag.present) {
      skips["" + flag.index] = true;
      if (flag.consumed === 2) { skips["" + (flag.index + 1)] = true; }
    }
  }
  const remaining = [];
  for (let i = 0; i < argv.length; i = i + 1) {
    if (skips["" + i] !== true) { remaining.push(argv[i]); }
  }
  return { ok: true, values: removed, argv: remaining };
}

function optional_integer(raw, minimum, label) {
  if (raw === null) { return { ok: true, value: null }; }
  if (raw.length === 0) { return { ok: false, message: label + " must be an integer" }; }
  for (let i = 0; i < raw.length; i = i + 1) {
    const code = raw.charCodeAt(i);
    if (code < 48 || code > 57) {
      return { ok: false, message: label + " must be an integer" };
    }
  }
  const value = Number(raw);
  if (value < minimum) { return { ok: false, message: label + " is outside its bound" }; }
  return { ok: true, value: value };
}

function reducible_wait_literal(pattern) {
  if (typeof pattern !== "string" || pattern.length < 1 || pattern.length > 512
      || pattern.indexOf("\0") >= 0) {
    return null;
  }
  let literal = pattern;
  if (pattern.endsWith(".*")) { literal = pattern.slice(0, pattern.length - 2); }
  if (literal.length < 1) { return null; }
  const syntax = "\\^$.*+?()[]{}|";
  for (let i = 0; i < literal.length; i = i + 1) {
    if (syntax.indexOf(literal[i]) >= 0) { return null; }
  }
  return literal;
}

function compound_plan(kind, command, fields) {
  fields.kind = kind;
  fields.command = command;
  return fields;
}

// Stable guards for legacy shapes whose typed ACU behavior is deliberately
// still absent. Keep these before generic native forwarding: a parser error is
// not an acceptable substitute for the repair queue's machine-readable id.
function known_dynamic_boundary(argv) {
  const verb = argv[0];
  const sub = argv.length > 1 ? argv[1] : undefined;
  if (verb === "simulator" && sub === "status") {
    const parsed = without_value_flags(argv, ["device"]);
    if (!parsed.ok) { return { kind: "usage", command: "simulator", message: parsed.message }; }
    if (parsed.values.device === null || parsed.argv.length !== 3) {
      return { kind: "usage", command: "simulator",
        message: "simulator status requires BUNDLE_ID and --device UDID" };
    }
    return { kind: "exec", argv: ["simulator-status", parsed.values.device, parsed.argv[2]] };
  }
  if (verb === "daemon" && sub === "service") {
    return { kind: "usage", command: "daemon",
      message: "daemon service is permanently retired; use the on-demand ACU runtime" };
  }
  if (verb === "pty" && has_arg(argv, "--provider")) {
    const provider = value_flag(argv, "provider");
    if (!provider.ok) { return { kind: "usage", command: "pty", message: provider.message }; }
    if (provider.value !== "native") {
      return { kind: "usage", command: "pty",
        message: "tmux provider topology is outside the AgenTerm-owned one-tab PTY contract" };
    }
    if (sub === "list") {
      const parsed = without_value_flags(argv, ["provider"]);
      if (!parsed.ok) { return { kind: "usage", command: "pty", message: parsed.message }; }
      if (parsed.argv.length !== 2) {
        return { kind: "usage", command: "pty", message: "pty list accepts no extra arguments" };
      }
      return { kind: "exec", argv: ["pty-list"] };
    }
    if (sub === "start" && provider.value === "native") {
      const parsed = without_value_flags(argv, ["provider"]);
      const native = ["pty-start"];
      append(native, copy_from(parsed.argv, 2));
      return { kind: "exec", argv: native };
    }
    if (sub === "wait") {
      const parsed = without_value_flags(argv, ["provider", "timeout"]);
      if (!parsed.ok) { return { kind: "usage", command: "pty", message: parsed.message }; }
      if (parsed.argv.length === 4) {
        const literal = reducible_wait_literal(parsed.argv[3]);
        const timeout = parsed.values.timeout === null ? 30 : Number(parsed.values.timeout);
        if (timeout !== timeout || timeout < 0.05 || timeout > 300) {
          return { kind: "usage", command: "pty",
            message: "pty wait --timeout must be in [0.05, 300] seconds" };
        }
        if (literal !== null) {
          return { kind: "exec", argv: ["pty-wait", parsed.argv[2], "--contains", literal,
            "--cursor", "earliest", "--timeout-ms", "" + Math.round(timeout * 1000)] };
        }
      }
      return todo("acu.dynamic.067", "pty", "legacy regex wait needs a bounded linear-time matcher");
    }
    if (sub === "start") {
      return todo("acu.dynamic.066", "pty", "legacy default-shell start needs a typed native shape");
    }
    return todo("acu.dynamic.061", "pty", "native provider shape is not typed yet");
  }
  if (verb === "job" && (sub === "output" || sub === "events" || sub === "wait")
      && !has_arg(argv, "--generation")) {
    if (argv.length < 3 || argv[2].startsWith("--")) {
      return { kind: "usage", command: "job", message: "job operation needs JOB_ID" };
    }
    return compound_plan("job-generation", "job", {
      job_id: argv[2], native_verb: "job-" + sub, tail: copy_from(argv, 3)
    });
  }
  if (verb === "job" && sub === "events" && has_arg(argv, "--generation")
      && has_arg(argv, "--max-bytes")) {
    const parsed = without_value_flags(argv, ["generation"]);
    if (!parsed.ok) { return { kind: "usage", command: "job", message: parsed.message }; }
    if (parsed.argv.length < 3 || parsed.values.generation === null) {
      return { kind: "usage", command: "job", message: "job events needs JOB_ID and GENERATION" };
    }
    const native = ["job-events", parsed.argv[2], parsed.values.generation];
    append(native, copy_from(parsed.argv, 3));
    return { kind: "exec", argv: native };
  }
  if (verb === "apps" && (sub === "inspect" || sub === "watch" || sub === "provisioning")) {
    return todo("acu.dynamic.072", "apps", "application inspection and signing facts need a typed provider");
  }
  if (verb === "apps" && (has_arg(argv, "--match") || has_arg(argv, "--offset")
      || has_arg(argv, "--max"))) {
    const parsed = without_value_flags(argv, ["match", "offset", "max"]);
    if (!parsed.ok) { return { kind: "usage", command: "apps", message: parsed.message }; }
    const offset = optional_integer(parsed.values.offset, 0, "apps --offset");
    const max = optional_integer(parsed.values.max, 1, "apps --max");
    if (!offset.ok || !max.ok) {
      return { kind: "usage", command: "apps", message: !offset.ok ? offset.message : max.message };
    }
    return compound_plan("apps-page", "apps", {
      argv: parsed.argv, match: parsed.values.match, offset: offset.value, max: max.value
    });
  }
  if (verb === "scroll" && has_arg(argv, "--to")) {
    return todo("acu.dynamic.074", "scroll", "window-local wheel delivery needs a typed mechanism");
  }
  if (verb === "browser" && sub === "tabs") {
    return todo("acu.dynamic.075", "browser", "profile-selected browser tab inventory is not typed yet");
  }
  if (verb === "inspect" && has_arg(argv, "--app")) {
    const parsed = without_value_flags(argv, ["app", "depth"]);
    if (!parsed.ok) { return { kind: "usage", command: "inspect", message: parsed.message }; }
    if (parsed.values.app === null || parsed.values.app.length === 0 || parsed.argv.length !== 1) {
      return { kind: "usage", command: "inspect",
        message: "inspect --app requires one application name and optional --depth" };
    }
    const depth = optional_integer(parsed.values.depth, 1, "inspect --depth");
    if (!depth.ok || depth.value !== null && depth.value > 32) {
      return { kind: "usage", command: "inspect",
        message: depth.ok ? "inspect --depth is outside its bound" : depth.message };
    }
    const native = ["app-inspect", "--app", parsed.values.app];
    if (depth.value !== null) { append(native, ["--depth", "" + depth.value]); }
    return { kind: "exec", argv: native };
  }
  if (verb === "tree" && has_arg(argv, "--page")) {
    return { kind: "usage", command: "tree",
      message: "tree --page was never a valid MCU tree shape; use bounded tree selectors" };
  }
  if (verb === "tree" && has_arg(argv, "--max-value-bytes")) {
    return todo("acu.dynamic.078", "tree", "paged or value-bounded tree compatibility is not typed yet");
  }
  if (verb === "windows" && sub === "watch" && (has_arg(argv, "--focused")
      || has_arg(argv, "--minimized") || has_arg(argv, "--onscreen")
      || has_arg(argv, "--occluded") || has_arg(argv, "--all")
      || has_arg(argv, "--offset") || has_arg(argv, "--max")
      || has_arg(argv, "--meta") || has_arg(argv, "--duration")
      || has_arg(argv, "--interval") || has_arg(argv, "--ax-meta")
      || has_arg(argv, "--ax-role")
      || has_arg(argv, "--ax-subrole") || has_arg(argv, "--ax-identifier")
      || has_arg(argv, "--ax-scan-max") || has_arg(argv, "--type"))) {
    return todo("acu.dynamic.084", "windows", "window-watch filters must run inside its poll");
  }
  if (verb === "windows" && sub === "watch") {
    const native = ["windows-watch"];
    append(native, copy_from(argv, 2));
    return { kind: "exec", argv: native };
  }
  if (verb === "windows" && sub !== "watch" && has_arg(argv, "--space")) {
    const parsed = without_value_flags(argv, ["space", "offset", "max"]);
    if (!parsed.ok) { return { kind: "usage", command: "windows", message: parsed.message }; }
    const offset = optional_integer(parsed.values.offset, 0, "windows --offset");
    const max = optional_integer(parsed.values.max, 1, "windows --max");
    if (parsed.values.space === null || !offset.ok || !max.ok) {
      return { kind: "usage", command: "windows", message: parsed.values.space === null
        ? "windows --space requires a value" : (!offset.ok ? offset.message : max.message) };
    }
    return compound_plan("windows-space-page", "windows", {
      argv: parsed.argv, space: parsed.values.space, offset: offset.value, max: max.value
    });
  }
  if (verb === "privilege" && sub === "apply"
      && (!has_arg(argv, "--request") || !has_arg(argv, "--approve"))) {
    return { kind: "usage", command: "privilege",
      message: "privilege apply requires --request PLAN --approve 64_HEX" };
  }
  if (verb === "page" && sub === "targets" && has_arg(argv, "--match")
      && !has_arg(argv, "--port") && !has_arg(argv, "--pid")) {
    return { kind: "usage", command: "page",
      message: "page targets requires --port N or --pid PID; --match does not select an endpoint" };
  }
  if (verb === "menu" && !has_arg(argv, "--window")) {
    if (sub === "inspect") {
      const parsed = without_value_flags(argv, [
        "depth", "scan-max", "title", "enabled", "offset", "max"
      ]);
      if (!parsed.ok) { return { kind: "usage", command: "menu", message: parsed.message }; }
      const remaining = [];
      let exact = false;
      for (let i = 0; i < parsed.argv.length; i = i + 1) {
        if (parsed.argv[i] === "--exact") {
          if (exact) { return { kind: "usage", command: "menu", message: "menu inspect --exact may appear once" }; }
          exact = true;
        } else {
          remaining.push(parsed.argv[i]);
        }
      }
      const depth = optional_integer(parsed.values.depth, 0, "menu inspect --depth");
      const max_nodes = optional_integer(parsed.values["scan-max"], 1, "menu inspect --scan-max");
      const offset = optional_integer(parsed.values.offset, 0, "menu inspect --offset");
      const max = optional_integer(parsed.values.max, 1, "menu inspect --max");
      if (remaining.length === 3 && remaining[2].length > 0
          && depth.ok && (depth.value === null || depth.value <= 8)
          && max_nodes.ok && (max_nodes.value === null || max_nodes.value <= 5000)
          && offset.ok && max.ok
          && (parsed.values.enabled === null
              || parsed.values.enabled === "true" || parsed.values.enabled === "false")) {
        const native = ["app-menu-inspect", "--app", remaining[2]];
        if (depth.value !== null) { append(native, ["--depth", "" + depth.value]); }
        if (max_nodes.value !== null) { append(native, ["--max-nodes", "" + max_nodes.value]); }
        if (parsed.values.title !== null) { append(native, ["--title", parsed.values.title]); }
        if (exact) { native.push("--exact"); }
        if (parsed.values.enabled !== null) { append(native, ["--enabled", parsed.values.enabled]); }
        if (offset.value !== null) { append(native, ["--offset", "" + offset.value]); }
        if (max.value !== null) { append(native, ["--max", "" + max.value]); }
        return { kind: "exec", argv: native };
      }
    }
    return todo(sub === "inspect" ? "acu.dynamic.086" : "acu.dynamic.087", "menu",
      "app-global menu addressing needs an unambiguous typed target");
  }
  return null;
}

export function canonicalize(input) {
  const extracted = legacy.extractGlobals(input);
  const command_args = extracted.argv;
  if (command_args.length === 0) { return { kind: "exec", argv: ["--help"] }; }
  const entry = command_args[0];
  if (entry === "grant" || entry === "verbs" || entry === "help" || entry === "host"
      || entry === "--help" || entry === "-h") {
    return { kind: "exec", argv: command_args };
  }
  const boundary = known_dynamic_boundary(command_args);
  if (boundary !== null) {
    if (boundary.kind === "exec") { return exec_with_prefix(extracted.prefix, boundary.argv); }
    if (boundary.kind !== "usage" && boundary.kind !== "todo") {
      boundary.globals = copy(extracted.prefix);
    }
    return boundary;
  }
  if (!contains(LEGACY_TOP_LEVEL, entry)) {
    return exec_with_prefix(extracted.prefix, command_args);
  }
  const mapped = rewrite.rewrite(command_args);
  if (mapped.kind === "identity-kill") {
    return {
      kind: mapped.kind,
      command: mapped.command,
      pid: mapped.pid,
      mode: mapped.mode,
      timeoutMs: mapped.timeoutMs,
      globals: extracted.prefix
    };
  }
  if (mapped.kind === "focused-pid" || mapped.kind === "observe-roles"
      || mapped.kind === "selector-dclick") {
    mapped.globals = copy(extracted.prefix);
    return mapped;
  }
  if (mapped.kind !== "exec") { return mapped; }
  return exec_with_prefix(extracted.prefix, mapped.argv);
}
