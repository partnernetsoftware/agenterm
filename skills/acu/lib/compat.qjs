// Pure Bun-free compatibility pipeline. It owns legacy argv shape only; the
// native command schema, authorization, mechanisms and receipts remain in
// agenterm-cu through agenterm:acu.argv.

import * as legacy from "agenterm:acu/legacy-args";
import * as rewrite from "agenterm:acu/rewrite";

export const LEGACY_TOP_LEVEL = [
  "windows", "apps", "tree", "elements", "query", "invoke", "verify", "wait", "unlock",
  "observe", "focused", "click", "dclick", "rclick", "type", "key",
  "move", "shot", "clip", "clipboard", "displays", "spaces", "cursor",
  "frame", "movewin", "resize", "maximize", "close", "orderwin",
  "focus", "raise", "minimize", "restore", "hit", "snapshot", "diff",
  "launch", "quit", "hide", "show", "ps", "kill", "doctor", "permissions",
  "resource"
];

// Stable ids for argument-sensitive legacy shapes that are still meaningful
// but cannot be forwarded to a same-named native command without changing
// their contract. The compatibility-corpus test locks these ids to the frozen
// archive; unknown spellings are deliberately absent and continue to native
// usage handling.
export const LEGACY_TODO_GAP_IDS = [
  "acu.dynamic.004", "acu.dynamic.075",
];

function contains(values, wanted) {
  for (let i = 0; i < values.length; i = i + 1) {
    if (values[i] === wanted) { return true; }
  }
  return false;
}

function append(out, values) {
  for (let i = 0; i < values.length; i = i + 1) { out.push(values[i]); }
}

function exec_with_prefix(prefix, argv) {
  const out = [];
  append(out, prefix);
  append(out, argv);
  return { kind: "exec", argv: out };
}

function has_arg(argv, wanted) {
  for (let i = 0; i < argv.length; i = i + 1) {
    if (argv[i] === wanted || argv[i].startsWith(wanted + "=")) { return true; }
  }
  return false;
}

function has_any_arg(argv, wanted) {
  for (let i = 0; i < wanted.length; i = i + 1) {
    if (has_arg(argv, wanted[i])) { return true; }
  }
  return false;
}

function todo(gap_id, command, message) {
  return { kind: "todo", gap_id: gap_id, command: command, message: message };
}

function copy(values) {
  const out = [];
  append(out, values);
  return out;
}

function copy_from(values, start) {
  const out = [];
  for (let i = start; i < values.length; i = i + 1) { out.push(values[i]); }
  return out;
}

function value_flag(argv, name) {
  const prefix = "--" + name + "=";
  let found = null;
  for (let i = 0; i < argv.length; i = i + 1) {
    if (argv[i] === "--" + name) {
      if (found !== null || i + 1 >= argv.length || argv[i + 1].startsWith("--")) {
        return { ok: false, message: "--" + name + " requires one unambiguous value" };
      }
      found = { value: argv[i + 1], index: i, consumed: 2 };
      i = i + 1;
    } else if (argv[i].startsWith(prefix)) {
      if (found !== null) {
        return { ok: false, message: "--" + name + " may be specified only once" };
      }
      found = { value: argv[i].slice(prefix.length), index: i, consumed: 1 };
    }
  }
  return found === null ? { ok: true, present: false, value: null }
    : { ok: true, present: true, value: found.value, index: found.index, consumed: found.consumed };
}

function without_value_flags(argv, names) {
  const removed = {};
  const skips = {};
  for (let n = 0; n < names.length; n = n + 1) {
    const flag = value_flag(argv, names[n]);
    if (!flag.ok) { return flag; }
    removed[names[n]] = flag.present ? flag.value : null;
    if (flag.present) {
      skips["" + flag.index] = true;
      if (flag.consumed === 2) { skips["" + (flag.index + 1)] = true; }
    }
  }
  const remaining = [];
  for (let i = 0; i < argv.length; i = i + 1) {
    if (skips["" + i] !== true) { remaining.push(argv[i]); }
  }
  return { ok: true, values: removed, argv: remaining };
}

function without_switch_flags(argv, names) {
  const removed = {};
  const remaining = [];
  for (let n = 0; n < names.length; n = n + 1) { removed[names[n]] = false; }
  for (let i = 0; i < argv.length; i = i + 1) {
    let matched = null;
    for (let n = 0; n < names.length; n = n + 1) {
      if (argv[i] === "--" + names[n]) { matched = names[n]; }
      if (argv[i].startsWith("--" + names[n] + "=")) {
        return { ok: false, message: "--" + names[n] + " does not take a value" };
      }
    }
    if (matched === null) {
      remaining.push(argv[i]);
    } else if (removed[matched]) {
      return { ok: false, message: "--" + matched + " may be specified only once" };
    } else {
      removed[matched] = true;
    }
  }
  return { ok: true, values: removed, argv: remaining };
}

function optional_integer(raw, minimum, label) {
  if (raw === null) { return { ok: true, value: null }; }
  if (raw.length === 0) { return { ok: false, message: label + " must be an integer" }; }
  for (let i = 0; i < raw.length; i = i + 1) {
    const code = raw.charCodeAt(i);
    if (code < 48 || code > 57) {
      return { ok: false, message: label + " must be an integer" };
    }
  }
  const value = Number(raw);
  if (value < minimum) { return { ok: false, message: label + " is outside its bound" }; }
  return { ok: true, value: value };
}

function legacy_seconds_ms(raw, minimum_ms, maximum_ms) {
  // Archived MCU source at fcfaf6703 accepted Number-compatible seconds and
  // rounded only while crossing into ACU's millisecond contract.
  const seconds = Number(raw);
  const raw_ms = seconds * 1000;
  return raw_ms >= minimum_ms && raw_ms <= maximum_ms ? Math.round(raw_ms) : null;
}

function legacy_bounded_integer(raw, minimum, maximum) {
  if (raw === null) { return null; }
  const value = Number(raw);
  return value >= minimum && value <= maximum && value % 1 === 0 ? value : null;
}

function legacy_finite_number(raw) {
  const value = Number(raw);
  return value === value && value - value === 0 ? value : null;
}

function lower_hex_prefix(raw) {
  if (typeof raw !== "string" || raw.length < 1 || raw.length > 32) { return false; }
  for (let i = 0; i < raw.length; i = i + 1) {
    const code = raw.charCodeAt(i);
    if (!((code >= 48 && code <= 57) || (code >= 97 && code <= 102))) { return false; }
  }
  return true;
}

function reducible_wait_literal(pattern) {
  if (typeof pattern !== "string" || pattern.length < 1 || pattern.length > 512
      || pattern.indexOf("\0") >= 0) {
    return null;
  }
  let literal = pattern;
  if (pattern.endsWith(".*")) { literal = pattern.slice(0, pattern.length - 2); }
  if (literal.length < 1) { return null; }
  const syntax = "\\^$.*+?()[]{}|";
  for (let i = 0; i < literal.length; i = i + 1) {
    if (syntax.indexOf(literal[i]) >= 0) { return null; }
  }
  return literal;
}

function compound_plan(kind, command, fields) {
  fields.kind = kind;
  fields.command = command;
  return fields;
}

// Stable guards for legacy shapes whose typed ACU behavior is deliberately
// still absent. Keep these before generic native forwarding: a parser error is
// not an acceptable substitute for the repair queue's machine-readable id.
function known_dynamic_boundary(argv) {
  const verb = argv[0];
  const sub = argv.length > 1 ? argv[1] : undefined;
  if (verb === "drag" && has_arg(argv, "--to")
      && !(has_arg(argv, "--window") && has_arg(argv, "--from"))) {
    return todo("acu.dynamic.004", "drag",
      "legacy window-local drag coordinates need a lossless typed adapter; macOS HANDLE delivery is retired, while Linux and Windows remain gaps");
  }
  if (verb === "zoom" && (argv.length > 1 && !argv[1].startsWith("--")
      || has_any_arg(argv, ["--x1", "--y1", "--x2", "--y2"]))) {
    const parsed = without_value_flags(argv, ["x1", "y1", "x2", "y2", "out"]);
    if (!parsed.ok) { return { kind: "usage", command: "zoom", message: parsed.message }; }
    if (parsed.argv.length !== 2 || parsed.argv[1].startsWith("--")) {
      return { kind: "usage", command: "zoom",
        message: "zoom requires one window handle and --x1 --y1 --x2 --y2 --out" };
    }
    const x1 = parsed.values.x1 === null ? null : legacy_finite_number(parsed.values.x1);
    const y1 = parsed.values.y1 === null ? null : legacy_finite_number(parsed.values.y1);
    const x2 = parsed.values.x2 === null ? null : legacy_finite_number(parsed.values.x2);
    const y2 = parsed.values.y2 === null ? null : legacy_finite_number(parsed.values.y2);
    if (x1 === null || y1 === null || x2 === null || y2 === null
        || parsed.values.out === null || parsed.values.out.length === 0) {
      return { kind: "usage", command: "zoom",
        message: "zoom requires finite --x1 --y1 --x2 --y2 and an explicit --out path" };
    }
    return compound_plan("zoom-legacy-rect", "zoom", {
      window: parsed.argv[1], x1: x1, y1: y1, x2: x2, y2: y2,
      out: parsed.values.out
    });
  }
  if (verb === "job" && sub === "resources") {
    const parsed = without_value_flags(argv,
      ["generation", "watch", "interval", "max-samples", "top", "max"]);
    if (!parsed.ok) { return { kind: "usage", command: "job", message: parsed.message }; }
    if (parsed.argv.length !== 3 || parsed.argv[2].startsWith("--")) {
      return { kind: "usage", command: "job", message: "job resources needs JOB_ID" };
    }
    const top = parsed.values.top === null ? null
      : legacy_bounded_integer(parsed.values.top, 0, 20);
    const max = parsed.values.max === null ? null
      : legacy_bounded_integer(parsed.values.max, 1, 4096);
    if ((parsed.values.top !== null && top === null)
        || (parsed.values.max !== null && max === null)) {
      return { kind: "usage", command: "job",
        message: "job resources requires --max 1..4096 and --top 0..20" };
    }
    const watching = parsed.values.watch !== null;
    if (!watching && (parsed.values.interval !== null
        || parsed.values["max-samples"] !== null)) {
      return { kind: "usage", command: "job",
        message: "job resources --interval and --max-samples require --watch" };
    }
    const tail = [];
    if (watching) {
      const watch_ms = legacy_seconds_ms(parsed.values.watch, 100, 300000);
      const interval_ms = parsed.values.interval === null ? 1000
        : legacy_seconds_ms(parsed.values.interval, 100, 5000);
      const parsed_sample_ceiling = legacy_bounded_integer(
        parsed.values["max-samples"], 1, 1000);
      const sample_ceiling = parsed.values["max-samples"] === null
        ? 300 : parsed_sample_ceiling;
      if (watch_ms === null || interval_ms === null || sample_ceiling === null) {
        return { kind: "usage", command: "job",
          message: "job resources requires --watch 0.1..300, --interval 0.1..5 and --max-samples 1..1000" };
      }
      append(tail, ["--watch-ms", "" + watch_ms, "--interval-ms", "" + interval_ms,
        "--max-samples", "" + sample_ceiling]);
      if (top !== null || max !== null) { tail.push("--members-per-sample"); }
    }
    if (top !== null || max !== null) {
      return compound_plan("job-resources-projection", "job", {
        job_id: parsed.argv[2], generation: parsed.values.generation,
        native_verb: "job-resources", tail: tail, top: top, max: max,
        watch: watching
      });
    }
    if (parsed.values.generation === null) {
      return compound_plan("job-generation", "job", {
        job_id: parsed.argv[2], native_verb: "job-resources", tail: tail
      });
    }
    const native = ["job-resources", parsed.argv[2], parsed.values.generation];
    append(native, tail);
    return { kind: "exec", argv: native };
  }
  if (verb === "device" && sub === "claim" && argv.length >= 3
      && argv[2].startsWith("/dev/")) {
    return { kind: "usage", code: "retired", command: "device",
      message: "device claim PATH is permanently retired: run device list, then device claim DEVICE_ID --ttl-seconds N with --session, --session-lease and --request-id; raw /dev paths and implicit runtime sessions are not accepted" };
  }
  if (verb === "device"
      && (sub === "read" || sub === "write" || sub === "renew" || sub === "release")
      && has_arg(argv, "--lease") && !has_arg(argv, "--generation")) {
    return { kind: "usage", code: "retired", command: "device",
      message: "the implicit legacy device lease lifecycle is permanently retired: use device-status, device-read, device-write, device-renew or device-release with LEASE_ID, --generation N and --lease SECRET under the explicit claiming session" };
  }
  if (verb === "storage" && (sub === "mount" || sub === "unmount" || sub === "eject")) {
    return { kind: "usage", command: "storage",
      message: "legacy storage accepts only storage devices [--max N]; use storage-volumes for mounted capacity" };
  }
  if (verb === "browser" && sub === "bridge" && argv[2] === "status") {
    const parsed = without_value_flags(argv, ["profile"]);
    if (!parsed.ok) { return { kind: "usage", command: "browser", message: parsed.message }; }
    if (parsed.argv.length !== 3) {
      return { kind: "usage", command: "browser",
        message: "browser bridge status accepts only --profile PROFILE_INSTANCE_PREFIX" };
    }
    if (parsed.values.profile !== null && !lower_hex_prefix(parsed.values.profile)) {
      return todo("acu.dynamic.075.profile-name-binding", "browser",
        "browser bridge status human profile names need a verified MV3 profile identity binding");
    }
    return compound_plan("bridge-status", "browser", { profile: parsed.values.profile });
  }
  if (verb === "browser" && sub === "nav") {
    const valued = without_value_flags(argv,
      ["port", "pid", "match", "profile", "app", "tab-id"]);
    if (!valued.ok) { return { kind: "usage", command: "browser", message: valued.message }; }
    const switched = without_switch_flags(valued.argv, ["allow-foreground"]);
    if (!switched.ok) { return { kind: "usage", command: "browser", message: switched.message }; }
    if (switched.argv.length !== 3 || switched.argv[2].startsWith("--")) {
      return { kind: "usage", command: "browser", message: "browser nav needs one URL" };
    }
    const port = optional_integer(valued.values.port, 1, "browser nav --port");
    const pid = optional_integer(valued.values.pid, 1, "browser nav --pid");
    if (!port.ok || !pid.ok || port.value !== null && port.value > 65535
        || pid.value !== null && pid.value > 4294967295) {
      return { kind: "usage", command: "browser",
        message: "browser nav requires --port 1..65535 or --pid 1..4294967295" };
    }
    if (port.value === null && pid.value === null) {
      if (switched.values["allow-foreground"]) {
        return { kind: "usage", command: "browser",
          message: "browser nav --allow-foreground is not mapped: no AppleScript navigation path exists; use page-nav --port N or --pid PID with --match SUB and --url URL" };
      }
      const url = switched.argv[2];
      const scheme_url = url.toLowerCase();
      if (!(scheme_url.startsWith("http://") || scheme_url.startsWith("https://"))) {
        return { kind: "usage", command: "browser",
          message: "browser bridge nav accepts only an http(s) URL" };
      }
      if (valued.values.app !== null) {
        return todo("acu.dynamic.075.profile-name-binding", "browser",
          "browser nav --app needs a verified Chromium application and MV3 profile identity binding");
      }
      if (valued.values.profile !== null && !lower_hex_prefix(valued.values.profile)) {
        return todo("acu.dynamic.075.profile-name-binding", "browser",
          "browser nav human profile names need a verified MV3 profile identity binding");
      }
      if (valued.values.match !== null && valued.values.match.length === 0) {
        return { kind: "usage", command: "browser",
          message: "browser nav --match must not be empty" };
      }
      const tab = optional_integer(valued.values["tab-id"], 1, "browser nav --tab-id");
      if (!tab.ok || tab.value !== null && tab.value > 4294967295) {
        return { kind: "usage", command: "browser",
          message: "browser nav --tab-id must be 1..4294967295" };
      }
      return compound_plan("bridge-nav", "browser", {
        url: url, profile: valued.values.profile, tab_id: tab.value,
        match: valued.values.match
      });
    }
    const transport = port.value !== null
      ? ["--port", "" + port.value] : ["--pid", "" + pid.value];
    if (valued.values.match !== null) {
      if (valued.values.match.length === 0) {
        return { kind: "usage", command: "browser",
          message: "browser nav --match must not be empty" };
      }
      return { kind: "exec", argv: ["page-nav", transport[0], transport[1],
        "--match", valued.values.match, "--url", switched.argv[2]] };
    }
    return compound_plan("cdp-nav", "browser", {
      transport: transport, url: switched.argv[2]
    });
  }
  if (verb === "browser" && sub === "open" && argv.length > 2
      && !argv[2].startsWith("--")) {
    const parsed = without_value_flags(argv, ["profile", "app", "timeout"]);
    if (!parsed.ok) { return { kind: "usage", command: "browser", message: parsed.message }; }
    if (parsed.argv.length !== 3) {
      return { kind: "usage", command: "browser",
        message: "legacy browser open accepts one positional URL with --profile, --app or --timeout" };
    }
    if (parsed.values.app !== null) {
      return todo("acu.dynamic.075.profile-name-binding", "browser",
        "browser open --app needs a verified Chromium application and MV3 profile identity binding");
    }
    if (parsed.values.profile !== null && !lower_hex_prefix(parsed.values.profile)) {
      return todo("acu.dynamic.075.profile-name-binding", "browser",
        "browser open human profile names need a verified MV3 profile identity binding");
    }
    return compound_plan("bridge-open", "browser", {
      url: parsed.argv[2], profile: parsed.values.profile,
      legacy_timeout: parsed.values.timeout
    });
  }
  if (verb === "browser" && sub === "open" && argv.length > 2
      && argv[2].startsWith("--")) {
    return null;
  }
  if (verb === "browser" && sub === "bridge" && argv[2] === "setup") {
    const parsed = without_value_flags(argv, ["app", "profile", "timeout"]);
    if (!parsed.ok) { return { kind: "usage", command: "browser", message: parsed.message }; }
    if (parsed.argv.length !== 3) {
      return { kind: "usage", command: "browser",
        message: "browser bridge setup accepts only --app APP" };
    }
    if (parsed.values.profile !== null || parsed.values.timeout !== null) {
      return { kind: "usage", command: "browser",
        message: "browser bridge setup does not accept --profile or --timeout" };
    }
    const native = ["browser-bridge-setup"];
    const app = parsed.values.app;
    if (app === null || app.toLowerCase() === "brave"
        || app.toLowerCase() === "brave browser"
        || app.toLowerCase() === "brave origin") {
      append(native, ["--browser", "brave-browser", "--browser", "brave-origin",
        "--browser", "chrome"]);
    } else if (app.toLowerCase().indexOf("chrome") >= 0) {
      append(native, ["--browser", "chrome"]);
    } else {
      return { kind: "usage", command: "browser",
        message: "browser bridge setup --app must name Brave, Brave Browser, Brave Origin or a Chrome family application" };
    }
    return { kind: "exec", argv: native };
  }
  if (verb === "browser" && (sub === "open" || sub === "bridge"
      || sub === "profile")) {
    return todo("acu.dynamic.075", "browser",
      "legacy browser profile and bridge shapes need an exact native identity binding");
  }
  if (verb === "tree"
      && has_any_arg(argv, ["--actionable", "--index", "--offset", "--max"])) {
    return { kind: "usage", command: "tree",
      message: "tree accepts only --depth, --max-nodes, --max-value-bytes and --selector" };
  }
  if (verb === "simulator" && sub === "status") {
    const parsed = without_value_flags(argv, ["device"]);
    if (!parsed.ok) { return { kind: "usage", command: "simulator", message: parsed.message }; }
    if (parsed.values.device === null || parsed.argv.length !== 3) {
      return { kind: "usage", command: "simulator",
        message: "simulator status requires BUNDLE_ID and --device UDID" };
    }
    return { kind: "exec", argv: ["simulator-status", parsed.values.device, parsed.argv[2]] };
  }
  if (verb === "simulator" && (sub === "boot" || sub === "shutdown")
      && has_arg(argv, "--device")) {
    const parsed = without_value_flags(argv, ["device"]);
    if (!parsed.ok) { return { kind: "usage", command: "simulator", message: parsed.message }; }
    if (parsed.values.device === null || parsed.argv.length !== 2) {
      return { kind: "usage", command: "simulator",
        message: "simulator " + sub + " requires --device UDID" };
    }
    return { kind: "exec", argv: [
      "simulator-" + sub, parsed.values.device, "--expect",
      sub === "boot" ? "booted" : "shutdown"
    ] };
  }
  if (verb === "daemon" && sub === "service") {
    return { kind: "usage", code: "retired", command: "daemon",
      message: "daemon service is permanently retired; use the on-demand ACU runtime" };
  }
  if (verb === "pty" && has_arg(argv, "--provider")) {
    const provider = value_flag(argv, "provider");
    if (!provider.ok) { return { kind: "usage", command: "pty", message: provider.message }; }
    if (provider.value !== "native") {
      return { kind: "usage", command: "pty",
        message: "tmux provider topology is outside the AgenTerm-owned one-tab PTY contract" };
    }
    if (sub === "list") {
      const parsed = without_value_flags(argv, ["provider"]);
      if (!parsed.ok) { return { kind: "usage", command: "pty", message: parsed.message }; }
      if (parsed.argv.length !== 2) {
        return { kind: "usage", command: "pty", message: "pty list accepts no extra arguments" };
      }
      return { kind: "exec", argv: ["pty-list"] };
    }
    if (sub === "start" && provider.value === "native") {
      const parsed = without_value_flags(argv, ["provider"]);
      const native = ["pty-start"];
      append(native, copy_from(parsed.argv, 2));
      return { kind: "exec", argv: native };
    }
    if (sub === "wait") {
      const parsed = without_value_flags(argv, ["provider", "timeout"]);
      if (!parsed.ok) { return { kind: "usage", command: "pty", message: parsed.message }; }
      if (parsed.argv.length !== 4) {
        return { kind: "usage", command: "pty",
          message: "pty wait requires JOB and PATTERN" };
      }
      const pattern = parsed.argv[3];
      const literal = reducible_wait_literal(pattern);
      const timeout = parsed.values.timeout === null ? 30 : Number(parsed.values.timeout);
      if (timeout !== timeout || timeout < 0.05 || timeout > 300) {
        return { kind: "usage", command: "pty",
          message: "pty wait --timeout must be in [0.05, 300] seconds" };
      }
      const condition = literal === null ? ["--regex", pattern] : ["--contains", literal];
      return { kind: "exec", argv: ["pty-wait", parsed.argv[2], condition[0], condition[1],
        "--cursor", "earliest", "--timeout-ms", "" + Math.round(timeout * 1000)] };
    }
    if (sub === "start") {
      return todo("acu.dynamic.066", "pty", "legacy default-shell start needs a typed native shape");
    }
    return todo("acu.dynamic.061", "pty", "native provider shape is not typed yet");
  }
  if (verb === "job" && (sub === "output" || sub === "events" || sub === "wait")
      && !has_arg(argv, "--generation")) {
    if (argv.length < 3 || argv[2].startsWith("--")) {
      return { kind: "usage", command: "job", message: "job operation needs JOB_ID" };
    }
    return compound_plan("job-generation", "job", {
      job_id: argv[2], native_verb: "job-" + sub, tail: copy_from(argv, 3)
    });
  }
  if (verb === "job" && sub === "events" && has_arg(argv, "--generation")
      && has_arg(argv, "--max-bytes")) {
    const parsed = without_value_flags(argv, ["generation"]);
    if (!parsed.ok) { return { kind: "usage", command: "job", message: parsed.message }; }
    if (parsed.argv.length < 3 || parsed.values.generation === null) {
      return { kind: "usage", command: "job", message: "job events needs JOB_ID and GENERATION" };
    }
    const native = ["job-events", parsed.argv[2], parsed.values.generation];
    append(native, copy_from(parsed.argv, 3));
    return { kind: "exec", argv: native };
  }
  if (verb === "apps" && sub === "inspect" && argv.length === 3
      && !argv[2].startsWith("--")) {
    return { kind: "exec", argv: ["app-facts", "--selector", argv[2],
      "--signing", "--verify", "--entitlements"] };
  }
  if (verb === "apps" && sub === "watch") {
    const parsed = without_value_flags(argv, ["duration", "interval", "max-events"]);
    if (!parsed.ok) { return { kind: "usage", command: "apps", message: parsed.message }; }
    if (parsed.argv.length !== 3 || parsed.argv[2].startsWith("--")) {
      return { kind: "usage", command: "apps", message: "apps watch needs name|bundle-id|path" };
    }
    const duration_ms = parsed.values.duration === null ? 10000
      : legacy_seconds_ms(parsed.values.duration, 100, 300000);
    const interval_ms = parsed.values.interval === null ? 500
      : legacy_seconds_ms(parsed.values.interval, 50, 10000);
    const parsed_event_ceiling = legacy_bounded_integer(parsed.values["max-events"], 1, 1000);
    const event_ceiling = parsed.values["max-events"] === null ? 100 : parsed_event_ceiling;
    if (duration_ms === null || interval_ms === null || event_ceiling === null) {
      return { kind: "usage", command: "apps",
        message: "apps watch requires --duration 0.1..300, --interval 0.05..10 and --max-events 1..1000" };
    }
    return { kind: "exec", argv: ["app-watch", "--app", parsed.argv[2],
      "--duration-ms", "" + duration_ms, "--interval-ms", "" + interval_ms,
      "--max-events", "" + event_ceiling] };
  }
  if (verb === "apps" && (sub === "inspect" || sub === "provisioning")) {
    return todo("acu.dynamic.072", "apps", "application inspection and signing facts need a typed provider");
  }
  if (verb === "apps" && (has_arg(argv, "--match") || has_arg(argv, "--offset")
      || has_arg(argv, "--max"))) {
    const parsed = without_value_flags(argv, ["match", "offset", "max"]);
    if (!parsed.ok) { return { kind: "usage", command: "apps", message: parsed.message }; }
    const offset = optional_integer(parsed.values.offset, 0, "apps --offset");
    const max = optional_integer(parsed.values.max, 1, "apps --max");
    if (!offset.ok || !max.ok) {
      return { kind: "usage", command: "apps", message: !offset.ok ? offset.message : max.message };
    }
    return compound_plan("apps-page", "apps", {
      argv: parsed.argv, match: parsed.values.match, offset: offset.value, max: max.value
    });
  }
  if (verb === "scroll" && has_arg(argv, "--to")) {
    return todo("acu.dynamic.074", "scroll", "window-local wheel delivery needs a typed mechanism");
  }
  if (verb === "browser" && sub === "tabs") {
    const parsed = without_value_flags(argv, ["profile", "connection-id", "match", "tab-id", "app"]);
    if (!parsed.ok) { return { kind: "usage", command: "browser", message: parsed.message }; }
    if (parsed.argv.length !== 2) {
      return { kind: "usage", command: "browser", message: "browser tabs accepts no positional arguments" };
    }
    if (parsed.values.app !== null) {
      return todo("acu.dynamic.075.profile-name-binding", "browser",
        "browser tabs --app needs a verified application-to-MV3-profile binding");
    }
    const tab_id = optional_integer(parsed.values["tab-id"], 1, "browser tabs --tab-id");
    if (!tab_id.ok) { return { kind: "usage", command: "browser", message: tab_id.message }; }
    if (parsed.values.match !== null && tab_id.value !== null) {
      return { kind: "usage", command: "browser", message: "browser tabs takes at most one of --match and --tab-id" };
    }
    const native = ["browser-tabs"];
    if (parsed.values.profile !== null) {
      if (!lower_hex_prefix(parsed.values.profile)) {
        return todo("acu.dynamic.075.profile-name-binding", "browser",
          "browser tabs human profile names need a verified MV3 profile identity binding");
      }
      append(native, ["--profile-instance-id", parsed.values.profile]);
    }
    if (parsed.values["connection-id"] !== null) {
      append(native, ["--connection-id", parsed.values["connection-id"]]);
    }
    if (parsed.values.match !== null) { append(native, ["--match", parsed.values.match]); }
    if (tab_id.value !== null) { append(native, ["--tab-id", "" + tab_id.value]); }
    return { kind: "exec", argv: native };
  }
  if (verb === "inspect" && has_arg(argv, "--app")) {
    const parsed = without_value_flags(argv, ["app", "depth"]);
    if (!parsed.ok) { return { kind: "usage", command: "inspect", message: parsed.message }; }
    if (parsed.values.app === null || parsed.values.app.length === 0 || parsed.argv.length !== 1) {
      return { kind: "usage", command: "inspect",
        message: "inspect --app requires one application name and optional --depth" };
    }
    const depth = optional_integer(parsed.values.depth, 1, "inspect --depth");
    if (!depth.ok || depth.value !== null && depth.value > 32) {
      return { kind: "usage", command: "inspect",
        message: depth.ok ? "inspect --depth is outside its bound" : depth.message };
    }
    const native = ["app-inspect", "--app", parsed.values.app];
    if (depth.value !== null) { append(native, ["--depth", "" + depth.value]); }
    return { kind: "exec", argv: native };
  }
  if (verb === "tree" && has_arg(argv, "--page")) {
    return { kind: "usage", command: "tree",
      message: "tree --page was never a valid MCU tree shape; use bounded tree selectors" };
  }
  if (verb === "windows" && sub === "watch") {
    if (has_any_arg(argv, ["--offset", "--meta", "--ax-meta", "--ax-role",
        "--ax-subrole", "--ax-identifier", "--ax-scan-max"])) {
      return { kind: "usage", command: "windows",
        message: "windows watch never accepted offset, metadata, or AX-root flags" };
    }
    const parsed = without_value_flags(argv, ["duration", "interval", "max-events", "max"]);
    if (!parsed.ok) { return { kind: "usage", command: "windows", message: parsed.message }; }
    if (parsed.argv.length < 2 || parsed.argv[0] !== "windows" || parsed.argv[1] !== "watch") {
      return { kind: "usage", command: "windows", message: "windows watch arguments are malformed" };
    }
    const duration_ms = parsed.values.duration === null ? 10000
      : legacy_seconds_ms(parsed.values.duration, 100, 300000);
    const interval_ms = parsed.values.interval === null ? 500
      : legacy_seconds_ms(parsed.values.interval, 50, 10000);
    const event_ceiling = parsed.values["max-events"] === null ? 500
      : legacy_bounded_integer(parsed.values["max-events"], 1, 10000);
    const window_ceiling = parsed.values.max === null ? 2000
      : legacy_bounded_integer(parsed.values.max, 1, 5000);
    if (duration_ms === null || interval_ms === null || event_ceiling === null
        || window_ceiling === null || interval_ms > duration_ms) {
      return { kind: "usage", command: "windows",
        message: "windows watch requires duration 0.1..300 s, interval 0.05..10 s not above duration, max-events 1..10000 and max 1..5000" };
    }
    const native = ["windows-watch"];
    append(native, copy_from(parsed.argv, 2));
    append(native, ["--duration-ms", "" + duration_ms, "--interval-ms", "" + interval_ms,
      "--max-events", "" + event_ceiling, "--max-windows", "" + window_ceiling]);
    return { kind: "exec", argv: native };
  }
  if (verb === "privilege" && sub === "apply"
      && (!has_arg(argv, "--request") || !has_arg(argv, "--approve"))) {
    return { kind: "usage", command: "privilege",
      message: "privilege apply requires --request PLAN --approve 64_HEX" };
  }
  if (verb === "page" && sub === "targets" && has_arg(argv, "--match")
      && !has_arg(argv, "--port") && !has_arg(argv, "--pid")) {
    return { kind: "usage", command: "page",
      message: "page targets requires --port N or --pid PID; --match does not select an endpoint" };
  }
  if (verb === "menu" && !has_arg(argv, "--window")) {
    if (sub === "inspect") {
      const parsed = without_value_flags(argv, [
        "depth", "scan-max", "title", "enabled", "offset", "max"
      ]);
      if (!parsed.ok) { return { kind: "usage", command: "menu", message: parsed.message }; }
      const remaining = [];
      let exact = false;
      for (let i = 0; i < parsed.argv.length; i = i + 1) {
        if (parsed.argv[i] === "--exact") {
          if (exact) { return { kind: "usage", command: "menu", message: "menu inspect --exact may appear once" }; }
          exact = true;
        } else {
          remaining.push(parsed.argv[i]);
        }
      }
      const depth = optional_integer(parsed.values.depth, 0, "menu inspect --depth");
      const max_nodes = optional_integer(parsed.values["scan-max"], 1, "menu inspect --scan-max");
      const offset = optional_integer(parsed.values.offset, 0, "menu inspect --offset");
      const max = optional_integer(parsed.values.max, 1, "menu inspect --max");
      if (remaining.length === 3 && remaining[2].length > 0
          && depth.ok && (depth.value === null || depth.value <= 8)
          && max_nodes.ok && (max_nodes.value === null || max_nodes.value <= 5000)
          && offset.ok && max.ok
          && (parsed.values.enabled === null
              || parsed.values.enabled === "true" || parsed.values.enabled === "false")) {
        const native = ["app-menu-inspect", "--app", remaining[2]];
        if (depth.value !== null) { append(native, ["--depth", "" + depth.value]); }
        if (max_nodes.value !== null) { append(native, ["--max-nodes", "" + max_nodes.value]); }
        if (parsed.values.title !== null) { append(native, ["--title", parsed.values.title]); }
        if (exact) { native.push("--exact"); }
        if (parsed.values.enabled !== null) { append(native, ["--enabled", parsed.values.enabled]); }
        if (offset.value !== null) { append(native, ["--offset", "" + offset.value]); }
        if (max.value !== null) { append(native, ["--max", "" + max.value]); }
        return { kind: "exec", argv: native };
      }
    } else {
      const parsed = without_value_flags(argv, ["path"]);
      if (!parsed.ok) { return { kind: "usage", command: "menu", message: parsed.message }; }
      if (parsed.argv.length === 2 && parsed.argv[1].length > 0
          && parsed.values.path !== null) {
        return { kind: "exec", argv: [
          "app-menu-invoke", "--app", parsed.argv[1], "--path", parsed.values.path
        ] };
      }
    }
    return todo(sub === "inspect" ? "acu.dynamic.086" : "acu.dynamic.087", "menu",
      "app-global menu addressing needs an unambiguous typed target");
  }
  return null;
}

export function canonicalize(input) {
  const extracted = legacy.extractGlobals(input);
  const command_args = extracted.argv;
  if (command_args.length === 0) { return { kind: "exec", argv: ["--help"] }; }
  const entry = command_args[0];
  if (entry === "grant" || entry === "verbs" || entry === "help" || entry === "host"
      || entry === "--help" || entry === "-h") {
    return { kind: "exec", argv: command_args };
  }
  const boundary = known_dynamic_boundary(command_args);
  if (boundary !== null) {
    if (boundary.kind === "exec") { return exec_with_prefix(extracted.prefix, boundary.argv); }
    if (boundary.kind !== "usage" && boundary.kind !== "todo") {
      boundary.globals = copy(extracted.prefix);
    }
    return boundary;
  }
  if (!contains(LEGACY_TOP_LEVEL, entry)) {
    return exec_with_prefix(extracted.prefix, command_args);
  }
  const mapped = rewrite.rewrite(command_args);
  if (mapped.kind === "identity-kill") {
    return {
      kind: mapped.kind,
      command: mapped.command,
      pid: mapped.pid,
      mode: mapped.mode,
      timeoutMs: mapped.timeoutMs,
      globals: extracted.prefix
    };
  }
  if (mapped.kind === "focused-pid" || mapped.kind === "observe-roles"
      || mapped.kind === "observe-filters"
      || mapped.kind === "elements-page" || mapped.kind === "bridge-status"
      || mapped.kind === "bridge-open" || mapped.kind === "bridge-nav"
      || mapped.kind === "cdp-nav"
      || mapped.kind === "selector-dclick") {
    mapped.globals = copy(extracted.prefix);
    return mapped;
  }
  if (mapped.kind !== "exec") { return mapped; }
  return exec_with_prefix(extracted.prefix, mapped.argv);
}
