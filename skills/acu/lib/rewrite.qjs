// Pure first-wave compatibility rewrites. Input has already had global flags
// removed; output is one typed argv call or an explicit local refusal.

import * as legacy from "agenterm:acu/legacy-args";

const QUERY_TODO_FLAGS = [
  "text", "selector", "within", "text-match", "descendant-text-depth",
  "title", "value", "description", "help", "placeholder", "required",
  "max-value-bytes", "meta"
];
const INVOKE_ACTIONS = [
  "press", "set-value", "select-option", "set-checked", "set-expanded",
  "increment", "decrement", "set-selected", "set-selection", "scroll-to",
  "cancel", "show-default-ui", "show-menu"
];
const DIRECT_VERBS = [
  "windows", "apps", "doctor", "permissions", "displays", "spaces", "cursor", "frame",
  "movewin", "resize", "maximize", "launch", "quit", "hide", "show", "ps"
];

function contains(values, wanted) {
  for (let i = 0; i < values.length; i = i + 1) {
    if (values[i] === wanted) { return true; }
  }
  return false;
}

function usage(command, message) {
  return { kind: "usage", command: command, message: message };
}

function todo(gap_id, command, message) {
  return { kind: "todo", gap_id: gap_id, command: command, message: message };
}

function exec(argv) {
  return { kind: "exec", argv: argv };
}

function append(out, values) {
  for (let i = 0; i < values.length; i = i + 1) { out.push(values[i]); }
  return out;
}

function copy_from(values, start) {
  const out = [];
  for (let i = start; i < values.length; i = i + 1) { out.push(values[i]); }
  return out;
}

function take_first(values) {
  if (rest_length(values) === 0) { return undefined; }
  const first = values.items[values.index];
  values.index = values.index + 1;
  return first;
}

function rest_length(rest) {
  return rest.items.length - rest.index;
}

function rest_at(rest, offset) {
  return rest.items[rest.index + offset];
}

function append_rest(out, rest) {
  for (let i = rest.index; i < rest.items.length; i = i + 1) {
    out.push(rest.items[i]);
  }
}

function empty_rest() {
  return { items: [], index: 0 };
}

function joined(prefix, flags, rest) {
  const out = copy_from(prefix, 0);
  append(out, flag_pairs(flags, []));
  append_rest(out, rest);
  return out;
}

function digits_only(raw) {
  if (raw.length === 0) { return false; }
  for (let i = 0; i < raw.length; i = i + 1) {
    const code = raw.charCodeAt(i);
    if (code < 48 || code > 57) { return false; }
  }
  return true;
}

function lower_hex_prefix(raw) {
  if (typeof raw !== "string" || raw.length < 1 || raw.length > 32) { return false; }
  for (let i = 0; i < raw.length; i = i + 1) {
    const code = raw.charCodeAt(i);
    if (!((code >= 48 && code <= 57) || (code >= 97 && code <= 102))) {
      return false;
    }
  }
  return true;
}

function milliseconds(raw) {
  let text = raw;
  if (text.startsWith("+")) { text = text.slice(1); }
  const parts = text.split(".");
  if (parts.length > 2 || !digits_only(parts[0])) { return null; }
  let fraction = parts.length === 2 ? parts[1] : "";
  if (fraction.length > 3 || (fraction.length > 0 && !digits_only(fraction))) { return null; }
  while (fraction.length < 3) { fraction = fraction + "0"; }
  return Number(parts[0]) * 1000 + (fraction.length === 0 ? 0 : Number(fraction));
}

function take_handle(rest) {
  if (rest_length(rest) === 0 || rest_at(rest, 0).startsWith("-")) { return null; }
  return take_first(rest);
}

function flag_pairs(flags, skipped) {
  const out = [];
  const names = Object.keys(flags);
  for (let i = 0; i < names.length; i = i + 1) {
    const name = names[i];
    if (contains(skipped, name)) { continue; }
    const value = flags[name];
    if (value === undefined) { continue; }
    if (value === true) { out.push("--" + name); }
    else if (value !== false) { out.push("--" + name); out.push("" + value); }
  }
  return out;
}

function seconds_to_ms(flags, from, to) {
  if (typeof flags[from] !== "string" || flags[to] !== undefined) { return true; }
  const value = milliseconds(flags[from]);
  if (value === null) { return false; }
  flags[to] = "" + value;
  flags[from] = undefined;
  return true;
}

function bounded_integer(flags, name, minimum, maximum) {
  if (flags[name] === undefined) { return true; }
  if (typeof flags[name] !== "string" || !digits_only(flags[name])) { return false; }
  const value = Number(flags[name]);
  return value >= minimum && value <= maximum;
}

function normalize_bool(flags, name) {
  if (flags[name] === undefined) { return true; }
  if (flags[name] === true) { return false; }
  const raw = "" + flags[name];
  const lower = raw.toLowerCase();
  if (lower === "true" || lower === "1" || lower === "yes" || lower === "on") {
    flags[name] = "true";
    return true;
  }
  if (lower === "false" || lower === "0" || lower === "no" || lower === "off") {
    flags[name] = "false";
    return true;
  }
  return false;
}

function legacy_bool(value) {
  if (value === true) { return true; }
  if (typeof value !== "string") { return null; }
  const lower = value.toLowerCase();
  if (lower === "true" || lower === "1" || lower === "yes" || lower === "on") {
    return true;
  }
  if (lower === "false" || lower === "0" || lower === "no" || lower === "off") {
    return false;
  }
  return null;
}

function finite_number(raw) {
  if (typeof raw !== "string" || raw.trim().length === 0) { return null; }
  const text = raw.trim();
  for (let i = 0; i < text.length; i = i + 1) {
    const ch = text.charAt(i);
    if ((ch < "0" || ch > "9") && ch !== "+" && ch !== "-" && ch !== "."
        && ch !== "e" && ch !== "E") { return null; }
  }
  const value = Number(text);
  return value === value && value >= -1e308 && value <= 1e308 ? value : null;
}

function utf8_length(text) {
  let bytes = 0;
  for (let i = 0; i < text.length; i = i + 1) {
    const code = text.charCodeAt(i);
    if (code <= 0x7f) { bytes = bytes + 1; }
    else if (code <= 0x7ff) { bytes = bytes + 2; }
    else if (code >= 0xd800 && code <= 0xdbff && i + 1 < text.length
        && text.charCodeAt(i + 1) >= 0xdc00 && text.charCodeAt(i + 1) <= 0xdfff) {
      bytes = bytes + 4;
      i = i + 1;
    } else { bytes = bytes + 3; }
  }
  return bytes;
}

function expectation_envelope(raw) {
  if (utf8_length(raw) > 65536) {
    return { ok: false, message: "expectation exceeds 65536 bytes" };
  }
  let parsed = null;
  try { parsed = JSON.parse(raw); }
  catch (error) { return { ok: false, message: "expectation is not valid JSON: " + error }; }
  if (Array.isArray(parsed)) { return { ok: true, value: raw }; }
  if (parsed === null || typeof parsed !== "object") {
    return { ok: false, message: "expectation must be an array or {present,absent}" };
  }
  const envelope_keys = Object.keys(parsed);
  for (let i = 0; i < envelope_keys.length; i = i + 1) {
    if (envelope_keys[i] !== "present" && envelope_keys[i] !== "absent") {
      return { ok: false, message: "unknown expectation envelope field " + envelope_keys[i] };
    }
  }
  const present = parsed.present === undefined ? [] : parsed.present;
  const absent = parsed.absent === undefined ? [] : parsed.absent;
  if (!Array.isArray(present) || !Array.isArray(absent)) {
    return { ok: false, message: "present and absent must be arrays" };
  }
  const rows = [];
  const groups = [present, absent];
  for (let group = 0; group < groups.length; group = group + 1) {
    const values = groups[group];
    const exists = group === 0;
    for (let index = 0; index < values.length; index = index + 1) {
      const value = values[index];
      if (value === null || typeof value !== "object" || Array.isArray(value)) {
        return { ok: false, message: (exists ? "present" : "absent")
          + "[" + index + "] must be an object" };
      }
      if (value.exists !== undefined && value.exists !== exists) {
        return { ok: false, message: (exists ? "present" : "absent")
          + "[" + index + "].exists conflicts with envelope" };
      }
      const row = {};
      const keys = Object.keys(value);
      for (let key_index = 0; key_index < keys.length; key_index = key_index + 1) {
        row[keys[key_index]] = value[keys[key_index]];
      }
      row.exists = exists;
      rows.push(row);
    }
  }
  if (rows.length < 1 || rows.length > 128) {
    return { ok: false, message: "expectation must contain 1..128 predicates" };
  }
  return { ok: true, value: JSON.stringify(rows) };
}

function query(rest, flags) {
  const names = Object.keys(flags);
  for (let i = 0; i < names.length; i = i + 1) {
    if (contains(QUERY_TODO_FLAGS, names[i])) {
      return todo("acu.dynamic.077", "query", "query predicate requires a later typed adapter");
    }
  }
  if (!seconds_to_ms(flags, "watch", "watch-ms")
      || !seconds_to_ms(flags, "interval", "interval-ms")) {
    return usage("query", "query seconds flags require non-negative finite decimals");
  }
  const integer_bounds = [
    ["depth", 0, 32], ["min-depth", 0, 32], ["max-depth", 0, 32],
    ["scan-max", 1, 20000], ["offset", 0, 100000], ["max", 1, 5000]
  ];
  for (let i = 0; i < integer_bounds.length; i = i + 1) {
    const row = integer_bounds[i];
    if (!bounded_integer(flags, row[0], row[1], row[2])) {
      return usage("query", "query --" + row[0] + " is outside its bound");
    }
  }
  if (flags["min-depth"] !== undefined && flags["max-depth"] !== undefined
      && Number(flags["max-depth"]) < Number(flags["min-depth"])) {
    return usage("query", "query --max-depth must be at least --min-depth");
  }
  const bools = ["enabled", "focused", "selected", "checked", "expanded"];
  for (let i = 0; i < bools.length; i = i + 1) {
    if (!normalize_bool(flags, bools[i])) {
      return usage("query", "query --" + bools[i] + " requires explicit true or false");
    }
  }
  if (flags.actionable !== undefined) {
    if (flags.actionable === true) { flags.actionable = true; }
    else if (legacy.flagIsFalse(flags.actionable)) { flags.actionable = undefined; }
    else if (legacy.flagTruthy(flags.actionable)) { flags.actionable = true; }
    else { return usage("query", "query --actionable requires true or false"); }
  }
  if (flags["scan-max"] !== undefined) {
    flags["max-nodes"] = flags["scan-max"];
    flags["scan-max"] = undefined;
  }
  if (flags.depth === undefined) { flags.depth = "12"; }
  if (flags["max-nodes"] === undefined) { flags["max-nodes"] = "5000"; }
  if (flags.max === undefined) { flags.max = "500"; }
  const handle = flags.window !== undefined ? "" + flags.window : take_handle(rest);
  flags.window = undefined;
  flags.app = undefined;
  if (handle === null) { return usage("query", "query needs HANDLE or --window"); }
  return exec(joined(["query", "--window", handle], flags, rest));
}

function elements(rest, flags) {
  const names = Object.keys(flags);
  const allowed = ["actionable", "max", "depth", "page", "tab-id", "profile"];
  for (let i = 0; i < names.length; i = i + 1) {
    if (!contains(allowed, names[i])) {
      return usage("elements",
        "elements accepts only --actionable, --max, --depth, --page, --tab-id and --profile");
    }
  }
  const handle = take_handle(rest);
  if (handle === null || rest_length(rest) !== 0) {
    return usage("elements", "elements needs exactly one HANDLE");
  }
  if (legacy.flagTruthy(flags.page)) {
    if (!bounded_integer(flags, "depth", 1, 12)) {
      return usage("elements", "elements --page --depth must be within 1..12");
    }
    if (!bounded_integer(flags, "max", 1, 1000)) {
      return usage("elements",
        "elements --page --max must be within 1..1000; the archived extension also refused larger pages");
    }
    if (flags["tab-id"] === undefined) {
      return usage("elements", "elements --page requires --tab-id");
    }
    if (!bounded_integer(flags, "tab-id", 1, 2147483647)) {
      return usage("elements", "elements --page requires a positive --tab-id");
    }
    const actionable = flags.actionable === undefined ? true : legacy_bool(flags.actionable);
    if (actionable === null) {
      return usage("elements", "elements --actionable requires true or false");
    }
    if (flags.profile !== undefined && !lower_hex_prefix(flags.profile)) {
      return todo("acu.dynamic.075.profile-name-binding", "elements",
        "human browser profile names need a cryptographic binding to one MV3 profile instance");
    }
    return {
      kind: "elements-page", command: "elements", window: handle,
      tab_id: Number(flags["tab-id"]),
      depth: flags.depth === undefined ? 12 : Number(flags.depth),
      max: flags.max === undefined ? 200 : Number(flags.max),
      actionable: actionable,
      profile: flags.profile === undefined ? null : flags.profile
    };
  }
  // The archived non-page path ignored these browser-only flags, including
  // an explicit `--page false`; retain that behavior without mixing indices.
  flags.page = undefined;
  flags["tab-id"] = undefined;
  flags.profile = undefined;
  if (!bounded_integer(flags, "depth", 1, 12)) {
    return usage("elements", "elements --depth must be within 1..12");
  }
  if (!bounded_integer(flags, "max", 1, 2000)) {
    return usage("elements", "elements --max must be within 1..2000");
  }
  const depth = flags.depth === undefined ? "12" : "" + flags.depth;
  const max = flags.max === undefined ? "200" : "" + flags.max;
  const actionable = flags.actionable === undefined || !legacy.flagIsFalse(flags.actionable);
  const out = [
    "query", "--window", handle, "--depth", "12", "--max-depth", depth,
    "--max", max, "--offset", "0"
  ];
  if (actionable) { out.push("--actionable"); }
  return exec(out);
}

function invoke(rest, flags) {
  const handle = flags.window !== undefined ? "" + flags.window : take_handle(rest);
  flags.window = undefined;
  if (handle === null) { return usage("invoke", "invoke needs HANDLE or --window"); }
  let selector = flags.selector !== undefined ? "" + flags.selector : null;
  flags.selector = undefined;
  let action = null;
  let value = null;
  if (flags.index !== undefined) {
    action = take_first(rest);
    value = take_first(rest);
  } else {
    if (selector === null) { selector = take_first(rest); }
    action = take_first(rest);
    value = take_first(rest);
  }
  if (action !== undefined && action !== null && !contains(INVOKE_ACTIONS, action)) {
    return todo("acu.dynamic.079", "invoke", "invoke action is not in the typed action set");
  }
  const out = ["invoke", "--window", handle];
  if (flags.index !== undefined) {
    out.push("--index"); out.push("" + flags.index); flags.index = undefined;
  } else if (selector !== undefined && selector !== null) {
    out.push("--selector"); out.push(selector);
  }
  const pairs = flag_pairs(flags, []);
  for (let i = 0; i < pairs.length; i = i + 1) { out.push(pairs[i]); }
  if (action !== undefined && action !== null) { out.push(action); }
  if (value !== undefined && value !== null) { out.push(value); }
  append_rest(out, rest);
  return exec(out);
}

function window_action(verb, rest, flags) {
  const handle = flags.window !== undefined ? "" + flags.window : take_handle(rest);
  flags.window = undefined;
  if (handle === null) { return usage(verb, verb + " needs HANDLE or --window"); }
  if ((verb === "minimize" || verb === "restore") && flags.expect === undefined) {
    flags.expect = verb === "minimize" ? "minimized" : "restored";
  }
  const target_verb = verb === "focus" ? "activate" : verb;
  return exec(joined([target_verb, "--window", handle], flags, rest));
}

function observe_window(verb, rest, flags) {
  if ((verb === "verify" || verb === "wait") && typeof flags.expect === "string"
      && flags.expect.trim().startsWith("{")) {
    const normalized = expectation_envelope(flags.expect);
    if (normalized.ok !== true) { return usage(verb, normalized.message); }
    flags.expect = normalized.value;
  }
  const filter_names = [
    "role", "action", "text", "enabled", "focused", "selected", "checked",
    "expanded", "required", "actionable", "min-depth", "max-depth", "within",
    "offset", "max"
  ];
  const filters = {};
  let has_filters = false;
  if (verb === "observe") {
    for (let i = 0; i < filter_names.length; i = i + 1) {
      const name = filter_names[i];
      if (flags[name] !== undefined) {
        filters[name] = flags[name];
        flags[name] = undefined;
        has_filters = true;
      }
    }
  }
  if (!seconds_to_ms(flags, "timeout", "timeout-ms")
      || !seconds_to_ms(flags, "duration", "duration-ms")
      || !seconds_to_ms(flags, "interval", "interval-ms")) {
    return usage(verb, verb + " seconds flags require non-negative finite decimals");
  }
  const handle = flags.window !== undefined ? "" + flags.window : take_handle(rest);
  flags.window = undefined;
  if (handle === null) { return usage(verb, verb + " needs HANDLE or --window"); }
  if (has_filters) {
    if (flags["duration-ms"] === undefined) { flags["duration-ms"] = "5000"; }
    if (flags.depth === undefined) { flags.depth = "4"; }
    if (flags["max-nodes"] === undefined) { flags["max-nodes"] = "1000"; }
    if (flags["max-events"] === undefined) { flags["max-events"] = "200"; }
    if (!bounded_integer(flags, "duration-ms", 50, 30000)
        || !bounded_integer(flags, "depth", 0, 64)
        || !bounded_integer(flags, "max-nodes", 1, 20000)
        || !bounded_integer(flags, "max-events", 1, 5000)) {
      return usage(verb, "observe requires duration 0.05..30 seconds and positive bounded tree/event budgets");
    }
    const depth = Number(flags.depth);
    const min_depth = filters["min-depth"] === undefined ? 0 : Number(filters["min-depth"]);
    const max_depth = filters["max-depth"] === undefined ? depth : Number(filters["max-depth"]);
    if (!Number.isInteger(min_depth) || !Number.isInteger(max_depth)
        || min_depth < 0 || max_depth < min_depth || max_depth > depth) {
      return usage(verb, "observe depth filters require 0 <= min-depth <= max-depth <= depth");
    }
    filters["min-depth"] = min_depth;
    filters["max-depth"] = max_depth;
    const offset = filters.offset === undefined ? 0 : Number(filters.offset);
    const max = filters.max === undefined ? Number(flags["max-events"]) : Number(filters.max);
    if (!Number.isInteger(offset) || offset < 0 || offset > 100000
        || !Number.isInteger(max) || max < 1 || max > 1000) {
      return usage(verb, "observe offset must be 0..100000 and max must be 1..1000");
    }
    filters.offset = offset;
    filters.max = max;
    const bool_names = ["enabled", "focused", "selected", "checked", "expanded", "required"];
    for (let i = 0; i < bool_names.length; i = i + 1) {
      const name = bool_names[i];
      if (filters[name] !== undefined) {
        const value = legacy_bool(filters[name]);
        if (value === null) { return usage(verb, "observe --" + name + " requires true or false"); }
        filters[name] = value;
      }
    }
    if (filters.actionable !== undefined) {
      const value = legacy_bool(filters.actionable);
      if (value === null) { return usage(verb, "observe --actionable requires true or false"); }
      filters.actionable = value;
    }
    if (filters.within !== undefined) {
      if (typeof filters.within !== "string") {
        return usage(verb, "observe --within requires x1,y1,x2,y2");
      }
      const parts = filters.within.split(",");
      if (parts.length !== 4) { return usage(verb, "observe --within requires x1,y1,x2,y2"); }
      const values = [];
      for (let i = 0; i < parts.length; i = i + 1) {
        const value = finite_number(parts[i]);
        if (value === null) { return usage(verb, "observe --within requires finite coordinates"); }
        values.push(value);
      }
      if (values[2] < values[0] || values[3] < values[1]) {
        return usage(verb, "observe --within endpoints must not precede their origins");
      }
      filters.within = values;
    }
    return { kind: "observe-filters", command: verb, filters: filters,
      argv: joined([verb, "--window", handle], flags, rest) };
  }
  return exec(joined([verb, "--window", handle], flags, rest));
}

function legacy_kill(rest, flags) {
  const pid = take_first(rest);
  if (pid === undefined || rest_length(rest) !== 0 || !digits_only(pid) || pid === "0") {
    return usage("kill", "kill needs exactly one positive PID");
  }
  const names = Object.keys(flags);
  for (let i = 0; i < names.length; i = i + 1) {
    if (names[i] !== "force" && names[i] !== "timeout") {
      return usage("kill", "kill does not accept --" + names[i]);
    }
  }
  let timeout_ms = "30000";
  if (flags.timeout !== undefined) {
    const parsed = milliseconds("" + flags.timeout);
    if (parsed === null || parsed < 1 || parsed > 86400000) {
      return usage("kill", "kill --timeout must be in (0, 86400] seconds");
    }
    timeout_ms = "" + parsed;
  }
  return {
    kind: "identity-kill",
    command: "kill",
    pid: pid,
    mode: legacy.flagTruthy(flags.force) ? "forceful" : "graceful",
    timeoutMs: timeout_ms
  };
}

function resource(rest, flags) {
  const sub = take_first(rest);
  if (sub === "status") {
    if (rest_length(rest) !== 0 || flag_pairs(flags, []).length !== 0) {
      return usage("resource", "resource status accepts no arguments");
    }
    return exec(["resource-status"]);
  }
  if (sub === "pressure") {
    if (rest_length(rest) !== 0 || flag_pairs(flags, []).length !== 0) {
      return usage("resource", "resource pressure accepts no arguments");
    }
    return exec(["resource-pressure"]);
  }
  if (sub === "top") {
    const names = Object.keys(flags);
    for (let i = 0; i < names.length; i = i + 1) {
      if (names[i] !== "sort" && names[i] !== "limit") {
        return usage("resource", "resource top accepts only --sort cpu|mem and --limit N");
      }
    }
    if (rest_length(rest) !== 0) {
      return usage("resource", "resource top accepts no positional arguments");
    }
    const sort = flags.sort === undefined ? "cpu" : "" + flags.sort;
    if (sort !== "cpu" && sort !== "mem") {
      return usage("resource", "resource top --sort must be cpu or mem");
    }
    if (flags.limit !== undefined && !bounded_integer(flags, "limit", 1, 1000)) {
      return usage("resource", "resource top --limit must be an integer in 1..1000");
    }
    return exec(["ps", "--sort", sort === "mem" ? "memory" : "cpu",
      "--max", flags.limit === undefined ? "20" : "" + flags.limit]);
  }
  if (sub === "volumes") {
    if (rest_length(rest) !== 0) {
      return usage("resource", "resource volumes accepts no positional arguments");
    }
    const names = Object.keys(flags);
    for (let i = 0; i < names.length; i = i + 1) {
      if (names[i] !== "max") {
        return usage("resource", "resource volumes accepts only --max N");
      }
    }
    if (flags.max !== undefined && !bounded_integer(flags, "max", 1, 5000)) {
      return usage("resource", "resource volumes --max must be an integer in 1..5000");
    }
    const max = flags.max === undefined ? 500 : Number(flags.max);
    if (max > 512) {
      return usage("resource",
        "resource volumes --max above 512 is not supported by storage-volumes (1..512)");
    }
    return exec(["storage-volumes", "--max", "" + max]);
  }
  if (sub === "disk") {
    if (rest_length(rest) > 1 || flag_pairs(flags, []).length !== 0) {
      return usage("resource", "resource disk accepts at most one PATH and no flags");
    }
    return exec(["storage-volume-at", rest_length(rest) === 0 ? "/" : rest_at(rest, 0)]);
  }
  return usage("resource",
    "resource subcommand must be status, pressure, top, volumes or disk");
}

function click(verb, rest, flags) {
  if (typeof flags.at === "string") {
    const handle = "" + flags.at;
    flags.at = undefined;
    const selector = take_first(rest);
    if (selector === undefined || rest_length(rest) !== 0 || flag_pairs(flags, []).length !== 0) {
      return usage(verb, verb + " --at requires exactly HANDLE SELECTOR");
    }
    return exec(["invoke", "--window", handle, "--selector", selector,
      verb === "rclick" ? "show-menu" : "press"]);
  }
  if (flags.to !== undefined || rest_length(rest) >= 2) {
    const target = flags.to;
    flags.to = undefined;
    if (target === undefined) {
      return usage(verb, verb + " pixel coordinates require --to desktop");
    }
    const lower = ("" + target).toLowerCase();
    if (!contains(["desktop", "screen", "global", "all"], lower)) {
      return todo("acu.dynamic.094", verb, "window-local pixel delivery needs a typed mechanism");
    }
    const x = take_first(rest);
    const y = take_first(rest);
    if (x === undefined || y === undefined || rest_length(rest) !== 0) {
      return usage(verb, verb + " pixel form requires exactly X Y");
    }
    const out = ["click", "--coords", x + "," + y, "--degraded"];
    if (verb === "rclick") { out.push("--button"); out.push("right"); }
    const pairs = flag_pairs(flags, ["button", "clicks"]);
    if (flags.button !== undefined) { out.push("--button"); out.push("" + flags.button); }
    if (flags.clicks !== undefined) { out.push("--clicks"); out.push("" + flags.clicks); }
    for (let i = 0; i < pairs.length; i = i + 1) { out.push(pairs[i]); }
    return exec(out);
  }
  return exec(joined([verb], flags, rest));
}

function keyboard(verb, rest, flags) {
  if (flags.to === "desktop") {
    flags.to = undefined;
    if (rest_length(rest) !== 1 || flag_pairs(flags, []).length !== 0) {
      return usage(verb, verb + " --to desktop requires exactly one payload");
    }
    return exec([verb === "type" ? "send-text" : "send-keys", "--", rest_at(rest, 0)]);
  }
  if (typeof flags.to === "string") {
    const handle = "" + flags.to;
    flags.to = undefined;
    return exec(joined([verb, "--window", handle], flags, rest));
  }
  return exec(joined([verb], flags, rest));
}

function clipboard(rest, flags) {
  const sub = rest_at(rest, 0);
  if (sub === "inspect") {
    take_first(rest); flags["max-items"] = undefined; flags["max-types"] = undefined;
    return exec(joined(["clipboard-read"], flags, rest));
  }
  if (sub === "read") {
    take_first(rest);
    const type = flags.type !== undefined ? "" + flags.type : take_first(rest);
    flags.type = undefined;
    const out = ["clipboard-read"];
    if (type !== undefined) { out.push("--type"); out.push(type); }
    return exec(joined(out, flags, rest));
  }
  if (sub === "write") {
    take_first(rest);
    const type = flags.type !== undefined ? "" + flags.type : take_first(rest);
    const path = flags.path !== undefined ? "" + flags.path : take_first(rest);
    flags.type = undefined; flags.path = undefined;
    if (type === undefined || path === undefined || rest_length(rest) !== 0) {
      return usage("clipboard", "clipboard write needs TYPE PATH");
    }
    return exec(joined(["clipboard-write", "--type", type, "--path", path], flags, empty_rest()));
  }
  if (sub === "write-file") {
    take_first(rest);
    const path = flags.path !== undefined ? "" + flags.path : take_first(rest);
    flags.path = undefined;
    if (path === undefined || rest_length(rest) !== 0) {
      return usage("clipboard", "clipboard write-file needs PATH");
    }
    return exec(joined(["clipboard-write-file", "--path", path], flags, empty_rest()));
  }
  if (sub === "clear") {
    take_first(rest);
    return exec(joined(["clipboard-clear"], flags, rest));
  }
  return exec(joined(["clipboard-read"], flags, rest));
}

export function rewrite(input) {
  const parsed = legacy.parseArgs(input);
  const verb = parsed._[0];
  if (verb === undefined) { return usage("", "missing command"); }
  const rest = { items: copy_from(parsed._, 1), index: 0 };
  const flags = parsed.flags;

  if (contains(DIRECT_VERBS, verb)) { return exec(joined([verb], flags, rest)); }

  if (verb === "elements") { return elements(rest, flags); }
  if (verb === "query") { return query(rest, flags); }
  if (verb === "invoke") { return invoke(rest, flags); }
  if (verb === "verify" || verb === "wait" || verb === "observe" || verb === "focused") {
    if (verb === "focused" && flags.window === undefined && rest_length(rest) > 0
        && digits_only(rest_at(rest, 0))) {
      const pid = Number(take_first(rest));
      if (rest_length(rest) !== 0 || flag_pairs(flags, []).length !== 0 || pid <= 0) {
        return usage(verb, "focused PID accepts exactly one positive PID");
      }
      return { kind: "focused-pid", command: verb, pid: pid };
    }
    return observe_window(verb, rest, flags);
  }
  if (verb === "unlock") { return window_action(verb, rest, flags); }
  if (verb === "close") {
    const handle = flags.window !== undefined ? "" + flags.window : take_handle(rest);
    flags.window = undefined;
    return exec(handle === null
      ? joined(["close"], flags, rest)
      : joined(["close", "--window", handle], flags, rest));
  }
  if (verb === "click" || verb === "dclick" || verb === "rclick") {
    if (verb === "dclick" && typeof flags.at === "string") {
      const handle = "" + flags.at;
      flags.at = undefined;
      const selector = take_first(rest);
      if (selector === undefined || rest_length(rest) !== 0 || flag_pairs(flags, []).length !== 0) {
        return usage(verb, "dclick --at requires exactly HANDLE SELECTOR");
      }
      return { kind: "selector-dclick", command: verb,
        window: handle, selector: selector };
    }
    return click(verb, rest, flags);
  }
  if (verb === "type" || verb === "key") { return keyboard(verb, rest, flags); }
  if (verb === "move") {
    if (flags.to === "desktop" && rest_length(rest) === 2) {
      flags.to = undefined;
      return exec(joined(["pointer-move", "--to", "desktop", "--x", rest_at(rest, 0),
        "--y", rest_at(rest, 1)], flags, empty_rest()));
    }
    if (flags.to !== undefined) {
      return todo("acu.dynamic.095", "move", "window-local hover needs a typed mechanism");
    }
    return exec(joined(["move"], flags, rest));
  }
  if (verb === "shot") {
    if (typeof flags.handle === "string") { flags.window = flags.handle; flags.handle = undefined; }
    return exec(joined(["shot"], flags, rest));
  }
  if (verb === "clipboard") { return clipboard(rest, flags); }
  if (verb === "clip") {
    if (rest_length(rest) === 0) { return exec(joined(["clip"], flags, rest)); }
    let text = "";
    while (rest_length(rest) > 0) {
      if (text.length > 0) { text = text + " "; }
      text = text + take_first(rest);
    }
    return exec(joined([
      "clipboard-write", "--type", "text/plain;charset=utf-8", "--text", text
    ], flags, empty_rest()));
  }
  if (verb === "kill") { return legacy_kill(rest, flags); }
  if (verb === "resource") { return resource(rest, flags); }
  if (verb === "orderwin") {
    if (flags.window !== undefined || flags.relation !== undefined || flags.relative !== undefined) {
      return exec(joined(["orderwin"], flags, rest));
    }
    const target = take_handle(rest);
    const relation = take_first(rest);
    const relative = take_first(rest);
    if (target === null || relative === undefined || !contains(["above", "below"], relation)) {
      return usage("orderwin", "orderwin needs TARGET above|below RELATIVE");
    }
    return exec(joined(["orderwin", "--window", target, "--relation", relation,
      "--relative", relative], flags, rest));
  }
  if (contains(["focus", "raise", "minimize", "restore"], verb)) {
    return window_action(verb, rest, flags);
  }
  if (verb === "hit") {
    const handle = flags.window !== undefined ? "" + flags.window : take_handle(rest);
    const x = flags.x !== undefined ? "" + flags.x : take_first(rest);
    const y = flags.y !== undefined ? "" + flags.y : take_first(rest);
    flags.window = undefined; flags.x = undefined; flags.y = undefined;
    if (handle === null || x === undefined || y === undefined) {
      return usage("hit", "hit needs HANDLE X Y");
    }
    return exec(joined(["hit", "--window", handle, "--x", x, "--y", y], flags, rest));
  }
  if (verb === "snapshot" || verb === "diff") {
    const handle = flags.window !== undefined ? "" + flags.window : take_handle(rest);
    flags.window = undefined;
    if (handle === null) { return usage(verb, verb + " needs HANDLE or --window"); }
    return exec(joined([verb, "--window", handle], flags, rest));
  }
  if (verb === "tree") {
    const handle = flags.window !== undefined ? "" + flags.window : take_handle(rest);
    flags.window = undefined;
    if (handle === null) { return usage("tree", "tree needs HANDLE or --window"); }
    return exec(joined(["tree", "--window", handle], flags, rest));
  }
  return todo("acu.rewrite.unassigned", verb, "legacy shape is not in the first rewrite wave");
}
