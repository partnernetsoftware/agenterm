// Pure projections used by compound MCU-to-ACU rewrites.
//
// Every input is an already parsed CuReply. This module owns no host calls,
// command dispatch, authority decisions, or mutable cross-call state.

function failure(code, message) {
  return { ok: false, code: code, message: message };
}

function success(value) {
  return { ok: true, value: value };
}

function object_value(value) {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

function reply_data(reply, label) {
  if (!object_value(reply) || typeof reply.ok !== "boolean") {
    return failure("acu_compound_reply_invalid", label + " is not a CuReply");
  }
  if (reply.ok === false) {
    if (object_value(reply.error) && typeof reply.error.code === "string"
        && reply.error.code.length > 0 && typeof reply.error.message === "string") {
      return failure(reply.error.code, reply.error.message);
    }
    return failure("acu_compound_reply_invalid", label + " has no typed error");
  }
  if (reply.data === undefined || reply.data === null) {
    return failure("acu_compound_reply_invalid", label + " has no data");
  }
  return success(reply.data);
}

function positive_integer(value) {
  return typeof value === "number" && value > 0 && value === value && value % 1 === 0;
}

function nonnegative_integer(value) {
  return typeof value === "number" && value >= 0 && value === value && value % 1 === 0;
}

function clone(value) {
  return JSON.parse(JSON.stringify(value));
}

function page_bounds(offset, max) {
  const start = offset === undefined || offset === null ? 0 : offset;
  if (!nonnegative_integer(start)) {
    return failure("acu_compound_page_invalid", "offset must be a non-negative integer");
  }
  if (max !== undefined && max !== null && !positive_integer(max)) {
    return failure("acu_compound_page_invalid", "max must be a positive integer");
  }
  return success({ offset: start, max: max });
}

function page(values, bounds) {
  const end = bounds.max === undefined || bounds.max === null
    ? values.length : bounds.offset + bounds.max;
  const out = [];
  for (let i = bounds.offset; i < values.length && i < end; i = i + 1) {
    out.push(values[i]);
  }
  return out;
}

function lower(value) {
  return value.toLowerCase();
}

export function job_generation(reply, job_id) {
  const unpacked = reply_data(reply, "job-status reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || typeof job_id !== "string" || job_id.length === 0
      || data.job_id !== job_id || !positive_integer(data.generation)) {
    return failure("acu_compound_job_status_invalid",
      "job-status must identify the requested job with one positive generation");
  }
  return success(data.generation);
}

export function single_window(reply, pid) {
  const unpacked = reply_data(reply, "windows reply");
  if (!unpacked.ok) { return unpacked; }
  if (!positive_integer(pid)) {
    return failure("acu_compound_pid_invalid", "pid must be a positive integer");
  }
  const data = unpacked.value;
  const rows = Array.isArray(data) ? data
    : object_value(data) && Array.isArray(data.windows) ? data.windows : null;
  if (rows === null || rows.length !== 1 || !object_value(rows[0])) {
    return failure("acu_compound_window_ambiguous",
      "windows --pid must return exactly one window");
  }
  const row = rows[0];
  if (row.process_id !== pid || typeof row.handle !== "number" || row.handle === 0
      || row.handle !== row.handle || row.handle % 1 !== 0) {
    return failure("acu_compound_window_invalid",
      "windows --pid returned a mismatched pid or invalid handle");
  }
  return success(clone(row));
}

export function single_node_id(reply) {
  const unpacked = reply_data(reply, "query reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || !Array.isArray(data.nodes) || data.nodes.length !== 1
      || !object_value(data.nodes[0]) || typeof data.nodes[0].id !== "string"
      || data.nodes[0].id.length === 0) {
    return failure("acu_compound_node_ambiguous",
      "query must return exactly one node with a non-empty id");
  }
  return success(data.nodes[0].id);
}

export function apps_page(reply, match, offset, max) {
  const unpacked = reply_data(reply, "apps reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || !Array.isArray(data.apps)) {
    return failure("acu_compound_apps_invalid", "apps reply data must contain an apps array");
  }
  if (match !== undefined && match !== null && typeof match !== "string") {
    return failure("acu_compound_match_invalid", "app match must be a string");
  }
  const bounds = page_bounds(offset, max);
  if (!bounds.ok) { return bounds; }
  const wanted = match === undefined || match === null ? "" : lower(match);
  const matched = [];
  for (let i = 0; i < data.apps.length; i = i + 1) {
    const row = data.apps[i];
    if (!object_value(row) || typeof row.app_name !== "string") {
      return failure("acu_compound_apps_invalid", "every app row needs app_name");
    }
    if (wanted === "" || lower(row.app_name).indexOf(wanted) !== -1) {
      matched.push(row);
    }
  }
  const selected = page(matched, bounds.value);
  const out = clone(data);
  out.apps = clone(selected);
  out.filter = { match: match === undefined || match === null ? null : match };
  out.visited = data.apps.length;
  out.matched = matched.length;
  out.returned = selected.length;
  out.offset = bounds.value.offset;
  out.truncated = bounds.value.offset + selected.length < matched.length;
  return success(out);
}

export function normalize_role(raw) {
  if (typeof raw !== "string") { return ""; }
  let text = raw.trim();
  if (text.startsWith("AX")) { text = text.slice(2); }
  text = text.toLowerCase();
  let out = "";
  for (let i = 0; i < text.length; i = i + 1) {
    const ch = text.charAt(i);
    if ((ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9")) { out = out + ch; }
  }
  return out === "pushbutton" ? "button" : out;
}

function wanted_values(raw_value, label, normalizer) {
  const raw = Array.isArray(raw_value) ? raw_value
    : typeof raw_value === "string" ? raw_value.split(",") : null;
  if (raw === null) {
    return failure("acu_compound_observe_filter_invalid",
      label + " must be a string or string array");
  }
  const values = [];
  for (let i = 0; i < raw.length; i = i + 1) {
    if (typeof raw[i] !== "string") {
      return failure("acu_compound_observe_filter_invalid",
        "every " + label + " value must be a string");
    }
    const value = normalizer(raw[i]);
    if (value !== "" && values.indexOf(value) === -1) { values.push(value); }
  }
  if (values.length === 0) {
    return failure("acu_compound_observe_filter_invalid",
      "at least one non-empty " + label + " is required");
  }
  return success(values);
}

function normalized_word(raw) {
  return typeof raw === "string" ? raw.trim().toLowerCase() : "";
}

function state_value(states, positive, negative) {
  if (!Array.isArray(states)) { return null; }
  let saw_negative = false;
  for (let i = 0; i < states.length; i = i + 1) {
    if (typeof states[i] !== "string") { continue; }
    const state = states[i].toLowerCase();
    if (positive.indexOf(state) !== -1) { return true; }
    if (negative.indexOf(state) !== -1) { saw_negative = true; }
  }
  return saw_negative ? false : null;
}

function event_text(event) {
  const values = [];
  function push(value) {
    if (typeof value === "string" && value.length > 0) { values.push(value); }
  }
  push(event.node.name);
  push(event.node.identifier);
  push(event.node.text);
  push(event.before);
  push(event.after);
  if (object_value(event.before)) {
    push(event.before.name); push(event.before.identifier); push(event.before.text);
  }
  if (object_value(event.after)) {
    push(event.after.name); push(event.after.identifier); push(event.after.text);
  }
  return values.join("\n").toLowerCase();
}

function legacy_observe_actionable(role, actions) {
  if (Array.isArray(actions) && actions.length > 0) { return true; }
  const suffixes = [
    "button", "checkbox", "radiobutton", "textfield", "textarea", "combobox",
    "popupbutton", "slider", "link", "menuitem"
  ];
  for (let i = 0; i < suffixes.length; i = i + 1) {
    if (role.endsWith(suffixes[i])) { return true; }
  }
  return false;
}

function unavailable_filter(name, mode) {
  return failure("observe_filter_unavailable",
    "observe filter " + name + " is unavailable in " + mode + " event facts");
}

export function observe_filters(reply, filters) {
  const unpacked = reply_data(reply, "observe reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || !Array.isArray(data.events) || !object_value(filters)) {
    return failure("acu_compound_observe_invalid",
      "observe reply data must contain an events array and filter object");
  }
  if (filters.required !== undefined) {
    return unavailable_filter("required", "all published");
  }
  const roles = filters.role === undefined ? null
    : wanted_values(filters.role, "role", normalize_role);
  if (roles !== null && !roles.ok) { return roles; }
  const actions = filters.action === undefined ? null
    : wanted_values(filters.action, "action", normalized_word);
  if (actions !== null && !actions.ok) { return actions; }
  const bounds = page_bounds(filters.offset, filters.max);
  if (!bounds.ok) { return bounds; }
  const needs_facts = actions !== null || filters.actionable === true
    || filters.enabled !== undefined || filters.focused !== undefined
    || filters.selected !== undefined || filters.checked !== undefined
    || filters.expanded !== undefined || filters.within !== undefined
    || filters["min-depth"] !== undefined || filters["max-depth"] !== undefined;
  if (needs_facts && data.mode === "notifications") {
    return unavailable_filter("event-facts", "notifications");
  }
  if (needs_facts) {
    for (let i = 0; i < data.events.length; i = i + 1) {
      if (!object_value(data.events[i]) || !object_value(data.events[i].node)
          || data.events[i].node.facts_complete !== true) {
        return unavailable_filter("event-facts",
          typeof data.mode === "string" ? data.mode : "unknown");
      }
    }
  }
  const matched = [];
  for (let i = 0; i < data.events.length; i = i + 1) {
    const event = data.events[i];
    if (!object_value(event) || !object_value(event.node)
        || typeof event.node.role !== "string") {
      return failure("acu_compound_observe_invalid", "every observe event needs node.role");
    }
    const role = normalize_role(event.node.role);
    if (roles !== null && roles.value.indexOf(role) === -1) { continue; }
    if (filters.text !== undefined) {
      if (typeof filters.text !== "string") {
        return failure("acu_compound_observe_filter_invalid", "text must be a string");
      }
      if (event_text(event).indexOf(filters.text.toLowerCase()) === -1) { continue; }
    }
    if (actions !== null) {
      if (!Array.isArray(event.node.actions)) { return unavailable_filter("action", data.mode); }
      let action_match = false;
      for (let j = 0; j < event.node.actions.length; j = j + 1) {
        if (typeof event.node.actions[j] === "string"
            && actions.value.indexOf(event.node.actions[j].toLowerCase()) !== -1) {
          action_match = true;
        }
      }
      if (!action_match) { continue; }
    }
    if (filters.actionable === true
        && !legacy_observe_actionable(role, event.node.actions)) { continue; }
    const state_filters = [
      ["enabled", ["enabled"], ["disabled"]],
      ["focused", ["focused"], ["focusable"]],
      ["selected", ["selected"], ["unselected"]],
      ["checked", ["checked"], ["unchecked"]],
      ["expanded", ["expanded"], ["collapsed"]]
    ];
    let state_match = true;
    for (let j = 0; j < state_filters.length; j = j + 1) {
      const spec = state_filters[j];
      if (filters[spec[0]] !== undefined
          && state_value(event.node.states, spec[1], spec[2]) !== filters[spec[0]]) {
        state_match = false;
      }
    }
    if (!state_match) { continue; }
    if (filters["min-depth"] !== undefined && event.node.depth < filters["min-depth"]) {
      continue;
    }
    if (filters["max-depth"] !== undefined && event.node.depth > filters["max-depth"]) {
      continue;
    }
    if (filters.within !== undefined) {
      if (!Array.isArray(filters.within) || filters.within.length !== 4
          || !object_value(event.node.bounds)) {
        return unavailable_filter("within", data.mode);
      }
      const center_x = event.node.bounds.x + event.node.bounds.width / 2;
      const center_y = event.node.bounds.y + event.node.bounds.height / 2;
      if (center_x < filters.within[0] || center_x > filters.within[2]
          || center_y < filters.within[1] || center_y > filters.within[3]) {
        continue;
      }
    }
    matched.push(event);
  }
  const selected = page(matched, bounds.value);
  const out = clone(data);
  const removed = data.events.length - matched.length;
  out.events = clone(selected);
  out.filters = clone(filters);
  out.captured_event_count = data.events.length;
  out.matched_event_count = matched.length;
  out.returned_event_count = selected.length;
  out.offset = bounds.value.offset;
  out.max = bounds.value.max;
  out.truncated_results = bounds.value.offset + selected.length < matched.length;
  out.emitted = selected.length;
  out.filtered = (nonnegative_integer(data.filtered) ? data.filtered : 0) + removed;
  return success(out);
}

export function observe_roles(reply, roles) {
  const wanted = wanted_values(roles, "role", normalize_role);
  if (!wanted.ok) { return wanted; }
  const projected = observe_filters(reply, { role: roles, offset: 0, max: null });
  if (!projected.ok) { return projected; }
  projected.value.roles = clone(wanted.value);
  return projected;
}
