// Pure projections used by compound MCU-to-ACU rewrites.
//
// Every input is an already parsed CuReply. This module owns no host calls,
// command dispatch, authority decisions, or mutable cross-call state.

function failure(code, message) {
  return { ok: false, code: code, message: message };
}

function success(value) {
  return { ok: true, value: value };
}

function object_value(value) {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

function reply_data(reply, label) {
  if (!object_value(reply) || typeof reply.ok !== "boolean") {
    return failure("acu_compound_reply_invalid", label + " is not a CuReply");
  }
  if (reply.ok === false) {
    if (object_value(reply.error) && typeof reply.error.code === "string"
        && reply.error.code.length > 0 && typeof reply.error.message === "string") {
      return failure(reply.error.code, reply.error.message);
    }
    return failure("acu_compound_reply_invalid", label + " has no typed error");
  }
  if (reply.data === undefined || reply.data === null) {
    return failure("acu_compound_reply_invalid", label + " has no data");
  }
  return success(reply.data);
}

function positive_integer(value) {
  return typeof value === "number" && value > 0 && value === value && value % 1 === 0;
}

function nonnegative_integer(value) {
  return typeof value === "number" && value >= 0 && value === value && value % 1 === 0;
}

function clone(value) {
  return JSON.parse(JSON.stringify(value));
}

function page_bounds(offset, max) {
  const start = offset === undefined || offset === null ? 0 : offset;
  if (!nonnegative_integer(start)) {
    return failure("acu_compound_page_invalid", "offset must be a non-negative integer");
  }
  if (max !== undefined && max !== null && !positive_integer(max)) {
    return failure("acu_compound_page_invalid", "max must be a positive integer");
  }
  return success({ offset: start, max: max });
}

function page(values, bounds) {
  const end = bounds.max === undefined || bounds.max === null
    ? values.length : bounds.offset + bounds.max;
  const out = [];
  for (let i = bounds.offset; i < values.length && i < end; i = i + 1) {
    out.push(values[i]);
  }
  return out;
}

function lower(value) {
  return value.toLowerCase();
}

function finite_number(value) {
  return typeof value === "number" && value === value && value - value === 0;
}

function floor_number(value) {
  const truncated = value - value % 1;
  return value < truncated ? truncated - 1 : truncated;
}

function ceil_number(value) {
  const truncated = value - value % 1;
  return value > truncated ? truncated + 1 : truncated;
}

function zoom_rect_shape(value) {
  return object_value(value) && object_value(value.requested)
    && object_value(value.padded) && Array.isArray(value.local_region)
    && value.local_region.length === 4 && value.pad === 0.2;
}

// The archived MCU expanded window-local corner coordinates by 20% on each
// side, using a one-point minimum source extent. Native zoom accepts an
// integer window-local rectangle, so this projection takes the outward integer
// bounds. It deliberately does not clamp to a window: the native command owns
// intersection, clipping and the typed outside-window refusal.
export function legacy_zoom_rect(x1, y1, x2, y2) {
  if (!finite_number(x1) || !finite_number(y1)
      || !finite_number(x2) || !finite_number(y2)) {
    return failure("acu_compound_zoom_rect_invalid",
      "legacy zoom corners must be finite numbers");
  }
  const source_width = x2 - x1 > 1 ? x2 - x1 : 1;
  const source_height = y2 - y1 > 1 ? y2 - y1 : 1;
  const padded = {
    x1: x1 - source_width * 0.2,
    y1: y1 - source_height * 0.2,
    x2: x2 + source_width * 0.2,
    y2: y2 + source_height * 0.2
  };
  const left = floor_number(padded.x1 < padded.x2 ? padded.x1 : padded.x2);
  const top = floor_number(padded.y1 < padded.y2 ? padded.y1 : padded.y2);
  const right = ceil_number(padded.x1 > padded.x2 ? padded.x1 : padded.x2);
  const bottom = ceil_number(padded.y1 > padded.y2 ? padded.y1 : padded.y2);
  const width = right - left;
  const height = bottom - top;
  if (!finite_number(left) || !finite_number(top)
      || !finite_number(right) || !finite_number(bottom)
      || left < -2147483648 || left > 2147483647
      || top < -2147483648 || top > 2147483647
      || width < 1 || width > 2147483647
      || height < 1 || height > 2147483647) {
    return failure("acu_compound_zoom_rect_invalid",
      "legacy zoom padding must fit one positive native i32 rectangle");
  }
  return success({
    requested: { x1: x1, y1: y1, x2: x2, y2: y2 },
    pad: 0.2,
    padded: padded,
    local_region: [left, top, width, height]
  });
}

// Preserve the native zoom facts and add only the legacy geometry needed by
// callers that still consume the MCU-shaped crop receipt.
export function legacy_zoom_reply_projection(reply, rect) {
  const unpacked = reply_data(reply, "zoom reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!zoom_rect_shape(rect) || !object_value(data)
      || !object_value(data.window_local_region) || !object_value(data.capture)
      || !positive_integer(data.output_width) || !positive_integer(data.output_height)
      || !finite_number(data.capture.scale_x) || data.capture.scale_x <= 0
      || !finite_number(data.capture.scale_y) || data.capture.scale_y <= 0) {
    return failure("acu_compound_zoom_reply_invalid",
      "zoom reply must contain clipped geometry, image dimensions and finite scales");
  }
  const out = clone(data);
  out.legacy_zoom = {
    requested: clone(rect.requested),
    pad: 0.2,
    padded: clone(rect.padded),
    clipped: clone(data.window_local_region),
    image: { width: data.output_width, height: data.output_height },
    scale: { x: data.capture.scale_x, y: data.capture.scale_y }
  };
  return success(out);
}

export function job_generation(reply, job_id) {
  const unpacked = reply_data(reply, "job-status reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || typeof job_id !== "string" || job_id.length === 0
      || data.job_id !== job_id || !positive_integer(data.generation)) {
    return failure("acu_compound_job_status_invalid",
      "job-status must identify the requested job with one positive generation");
  }
  return success(data.generation);
}

function decimal_string(value) {
  if (typeof value !== "string" || value.length === 0) { return null; }
  for (let i = 0; i < value.length; i = i + 1) {
    if (value.charAt(i) < "0" || value.charAt(i) > "9") { return null; }
  }
  let first = 0;
  while (first + 1 < value.length && value.charAt(first) === "0") { first = first + 1; }
  return value.slice(first);
}

function decimal_compare(left, right) {
  if (left.length !== right.length) { return left.length < right.length ? -1 : 1; }
  if (left === right) { return 0; }
  return left < right ? -1 : 1;
}

function decimal_subtract(left, right) {
  if (decimal_compare(left, right) < 0) { return null; }
  let borrow = 0;
  let out = "";
  let j = right.length - 1;
  for (let i = left.length - 1; i >= 0; i = i - 1) {
    let digit = Number(left.charAt(i)) - borrow;
    const other = j >= 0 ? Number(right.charAt(j)) : 0;
    j = j - 1;
    if (digit < other) { digit = digit + 10; borrow = 1; } else { borrow = 0; }
    out = "" + (digit - other) + out;
  }
  return decimal_string(out);
}

function resource_member(member) {
  if (!object_value(member) || !positive_integer(member.pid)
      || typeof member.start_identity !== "string" || member.start_identity.length === 0) {
    return failure("job_resources_member_shape_invalid",
      "every resource member needs a pid and start identity");
  }
  const cpu = decimal_string(member.cpu_time_ns);
  const rss = decimal_string(member.rss_bytes);
  if (cpu === null || rss === null) {
    return failure("job_resources_member_shape_invalid",
      "resource member CPU and RSS values must be decimal strings");
  }
  return success({ row: member, cpu: cpu, rss: rss, rate: null, has_rate: false });
}

function checked_members(container, label) {
  if (!object_value(container) || container.membership_complete !== true) {
    return failure("job_resources_membership_incomplete",
      label + " does not prove complete membership");
  }
  if (!Array.isArray(container.members) || !nonnegative_integer(container.member_count)
      || container.members.length !== container.member_count) {
    return failure("job_resources_member_shape_invalid",
      label + " member array does not match member_count");
  }
  const rows = [];
  for (let i = 0; i < container.members.length; i = i + 1) {
    const parsed = resource_member(container.members[i]);
    if (!parsed.ok) { return parsed; }
    if (i > 0 && rows[i - 1].row.pid >= parsed.value.row.pid) {
      return failure("job_resources_member_shape_invalid",
        label + " members must retain strict pid order");
    }
    rows.push(parsed.value);
  }
  return success(rows);
}

function resource_rank_before(left, right) {
  if (left.has_rate !== right.has_rate) { return left.has_rate; }
  if (left.has_rate && left.rate !== right.rate) { return left.rate > right.rate; }
  const cpu = decimal_compare(left.cpu, right.cpu);
  if (cpu !== 0) { return cpu > 0; }
  const rss = decimal_compare(left.rss, right.rss);
  if (rss !== 0) { return rss > 0; }
  return left.row.pid < right.row.pid;
}

function ranked_members(rows, top) {
  const sorted = [];
  if (top === 0) { return sorted; }
  for (let i = 0; i < rows.length; i = i + 1) {
    let at = sorted.length;
    while (at > 0 && resource_rank_before(rows[i], sorted[at - 1])) { at = at - 1; }
    sorted.push(rows[i]);
    for (let j = sorted.length - 1; j > at; j = j - 1) {
      sorted[j] = sorted[j - 1];
    }
    sorted[at] = rows[i];
    if (sorted.length > top) { sorted.pop(); }
  }
  const selected = [];
  for (let i = 0; i < sorted.length && i < top; i = i + 1) {
    selected.push(clone(sorted[i].row));
  }
  return selected;
}

function member_index(rows) {
  const index = {};
  for (let i = 0; i < rows.length; i = i + 1) {
    index["p" + rows[i].row.pid + ":" + rows[i].row.start_identity] = rows[i];
  }
  return index;
}

function add_interval_rates(rows, previous, elapsed_ms) {
  if (!positive_integer(elapsed_ms)) {
    return failure("job_resources_rate_undefined",
      "resource sample interval must be a positive integer");
  }
  const maximum = "9007199254740991";
  for (let i = 0; i < rows.length; i = i + 1) {
    const key = "p" + rows[i].row.pid + ":" + rows[i].row.start_identity;
    const before = previous[key];
    if (before === undefined) { continue; }
    const delta = decimal_subtract(rows[i].cpu, before.cpu);
    if (delta === null || decimal_compare(delta, maximum) > 0) {
      return failure("job_resources_rate_undefined",
        "resource CPU delta is negative or exceeds the exact rate bound");
    }
    rows[i].rate = Number(delta) / elapsed_ms;
    rows[i].has_rate = true;
  }
  return success(rows);
}

function project_member_list(container, rows, max) {
  if (max === null || max === undefined) { return; }
  const selected = [];
  for (let i = 0; i < rows.length && i < max; i = i + 1) {
    selected.push(clone(rows[i].row));
  }
  container.members = selected;
}

export function job_resources_projection(reply, top, max, watch) {
  const unpacked = reply_data(reply, "job-resources reply");
  if (!unpacked.ok) { return unpacked; }
  if (top !== null && top !== undefined && (!nonnegative_integer(top) || top > 20)) {
    return failure("job_resources_projection_invalid", "top must be in 0..20");
  }
  if (max !== null && max !== undefined && (!positive_integer(max) || max > 4096)) {
    return failure("job_resources_projection_invalid", "max must be in 1..4096");
  }
  const data = unpacked.value;
  const complete = checked_members(data, "job-resources reply");
  if (!complete.ok) { return complete; }
  const out = clone(data);
  const full_members = complete.value;
  if (top !== null && top !== undefined && watch !== true) {
    out.top_members = ranked_members(full_members, top);
    out.top_rank_basis = "cumulative-cpu-time";
    out.top_rate_available = false;
  }
  if (watch === true) {
    if (!Array.isArray(data.samples)) {
      return failure("job_resources_member_shape_invalid",
        "bounded resource reply must contain samples");
    }
    let previous = {};
    let previous_t_ms = null;
    for (let i = 0; i < data.samples.length; i = i + 1) {
      if (!object_value(data.samples[i]) || data.samples[i].membership_complete !== true) {
        return failure("job_resources_membership_incomplete",
          "job-resources sample does not prove complete membership");
      }
      if (!Array.isArray(data.samples[i].members)) {
        return failure("job_resources_members_per_sample_unavailable",
          "bounded resource projection requires members in every sample");
      }
      const parsed = checked_members(data.samples[i], "job-resources sample");
      if (!parsed.ok) {
        return parsed;
      }
      const rows = parsed.value;
      if (!nonnegative_integer(data.samples[i].t_ms)) {
        return failure("job_resources_member_shape_invalid",
          "resource sample needs a non-negative timestamp");
      }
      if (top !== null && top !== undefined) {
        if (previous_t_ms !== null) {
          const rated = add_interval_rates(rows, previous,
            data.samples[i].t_ms - previous_t_ms);
          if (!rated.ok) { return rated; }
        }
        out.samples[i].top_members = ranked_members(rows, top);
        out.samples[i].top_rank_basis = previous_t_ms === null
          ? "cumulative-cpu-time" : "interval-cpu-rate";
        out.samples[i].top_rate_available = previous_t_ms !== null;
      }
      project_member_list(out.samples[i], rows, max);
      previous = member_index(rows);
      previous_t_ms = data.samples[i].t_ms;
    }
  }
  project_member_list(out, full_members, max);
  out.member_projection = {
    kind: "legacy-job-resources", max_members: max,
    returned_members: out.members.length,
    truncated: out.members.length < data.member_count,
    order: "pid-asc", aggregates: "complete-membership",
    top: top, top_scope: "complete-membership"
  };
  return success(out);
}

export function single_window(reply, pid) {
  const unpacked = reply_data(reply, "windows reply");
  if (!unpacked.ok) { return unpacked; }
  if (!positive_integer(pid)) {
    return failure("acu_compound_pid_invalid", "pid must be a positive integer");
  }
  const data = unpacked.value;
  const rows = Array.isArray(data) ? data
    : object_value(data) && Array.isArray(data.windows) ? data.windows : null;
  if (rows === null || rows.length !== 1 || !object_value(rows[0])) {
    return failure("acu_compound_window_ambiguous",
      "windows --pid must return exactly one window");
  }
  const row = rows[0];
  if (row.process_id !== pid || typeof row.handle !== "number" || row.handle === 0
      || row.handle !== row.handle || row.handle % 1 !== 0) {
    return failure("acu_compound_window_invalid",
      "windows --pid returned a mismatched pid or invalid handle");
  }
  return success(clone(row));
}

export function single_node_id(reply) {
  const unpacked = reply_data(reply, "query reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || !Array.isArray(data.nodes) || data.nodes.length !== 1
      || !object_value(data.nodes[0]) || typeof data.nodes[0].id !== "string"
      || data.nodes[0].id.length === 0) {
    return failure("acu_compound_node_ambiguous",
      "query must return exactly one node with a non-empty id");
  }
  return success(data.nodes[0].id);
}

export function apps_page(reply, match, offset, max) {
  const unpacked = reply_data(reply, "apps reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || !Array.isArray(data.apps)) {
    return failure("acu_compound_apps_invalid", "apps reply data must contain an apps array");
  }
  if (match !== undefined && match !== null && typeof match !== "string") {
    return failure("acu_compound_match_invalid", "app match must be a string");
  }
  const bounds = page_bounds(offset, max);
  if (!bounds.ok) { return bounds; }
  const wanted = match === undefined || match === null ? "" : lower(match);
  const matched = [];
  for (let i = 0; i < data.apps.length; i = i + 1) {
    const row = data.apps[i];
    if (!object_value(row) || typeof row.app_name !== "string") {
      return failure("acu_compound_apps_invalid", "every app row needs app_name");
    }
    if (wanted === "" || lower(row.app_name).indexOf(wanted) !== -1) {
      matched.push(row);
    }
  }
  const selected = page(matched, bounds.value);
  const out = clone(data);
  out.apps = clone(selected);
  out.filter = { match: match === undefined || match === null ? null : match };
  out.visited = data.apps.length;
  out.matched = matched.length;
  out.returned = selected.length;
  out.offset = bounds.value.offset;
  out.truncated = bounds.value.offset + selected.length < matched.length;
  return success(out);
}

export function normalize_role(raw) {
  if (typeof raw !== "string") { return ""; }
  let text = raw.trim();
  if (text.startsWith("AX")) { text = text.slice(2); }
  text = text.toLowerCase();
  let out = "";
  for (let i = 0; i < text.length; i = i + 1) {
    const ch = text.charAt(i);
    if ((ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9")) { out = out + ch; }
  }
  return out === "pushbutton" ? "button" : out;
}

function wanted_values(raw_value, label, normalizer) {
  const raw = Array.isArray(raw_value) ? raw_value
    : typeof raw_value === "string" ? raw_value.split(",") : null;
  if (raw === null) {
    return failure("acu_compound_observe_filter_invalid",
      label + " must be a string or string array");
  }
  const values = [];
  for (let i = 0; i < raw.length; i = i + 1) {
    if (typeof raw[i] !== "string") {
      return failure("acu_compound_observe_filter_invalid",
        "every " + label + " value must be a string");
    }
    const value = normalizer(raw[i]);
    if (value !== "" && values.indexOf(value) === -1) { values.push(value); }
  }
  if (values.length === 0) {
    return failure("acu_compound_observe_filter_invalid",
      "at least one non-empty " + label + " is required");
  }
  return success(values);
}

function normalized_word(raw) {
  return typeof raw === "string" ? raw.trim().toLowerCase() : "";
}

function state_value(states, positive, negative) {
  if (!Array.isArray(states)) { return null; }
  let saw_negative = false;
  for (let i = 0; i < states.length; i = i + 1) {
    if (typeof states[i] !== "string") { continue; }
    const state = states[i].toLowerCase();
    if (positive.indexOf(state) !== -1) { return true; }
    if (negative.indexOf(state) !== -1) { saw_negative = true; }
  }
  return saw_negative ? false : null;
}

function event_text(event) {
  const values = [];
  function push(value) {
    if (typeof value === "string" && value.length > 0) { values.push(value); }
  }
  push(event.node.name);
  push(event.node.identifier);
  push(event.node.text);
  push(event.before);
  push(event.after);
  if (object_value(event.before)) {
    push(event.before.name); push(event.before.identifier); push(event.before.text);
  }
  if (object_value(event.after)) {
    push(event.after.name); push(event.after.identifier); push(event.after.text);
  }
  return values.join("\n").toLowerCase();
}

function legacy_observe_actionable(role, actions) {
  if (Array.isArray(actions) && actions.length > 0) { return true; }
  const suffixes = [
    "button", "checkbox", "radiobutton", "textfield", "textarea", "combobox",
    "popupbutton", "slider", "link", "menuitem"
  ];
  for (let i = 0; i < suffixes.length; i = i + 1) {
    if (role.endsWith(suffixes[i])) { return true; }
  }
  return false;
}

function unavailable_filter(name, mode) {
  return failure("observe_filter_unavailable",
    "observe filter " + name + " is unavailable in " + mode + " event facts");
}

export function observe_filters(reply, filters) {
  const unpacked = reply_data(reply, "observe reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || !Array.isArray(data.events) || !object_value(filters)) {
    return failure("acu_compound_observe_invalid",
      "observe reply data must contain an events array and filter object");
  }
  if (filters.required !== undefined) {
    return unavailable_filter("required", "all published");
  }
  const roles = filters.role === undefined ? null
    : wanted_values(filters.role, "role", normalize_role);
  if (roles !== null && !roles.ok) { return roles; }
  const actions = filters.action === undefined ? null
    : wanted_values(filters.action, "action", normalized_word);
  if (actions !== null && !actions.ok) { return actions; }
  const bounds = page_bounds(filters.offset, filters.max);
  if (!bounds.ok) { return bounds; }
  const needs_facts = actions !== null || filters.actionable === true
    || filters.enabled !== undefined || filters.focused !== undefined
    || filters.selected !== undefined || filters.checked !== undefined
    || filters.expanded !== undefined || filters.within !== undefined
    || filters["min-depth"] !== undefined || filters["max-depth"] !== undefined;
  if (needs_facts && data.mode === "notifications") {
    return unavailable_filter("event-facts", "notifications");
  }
  if (needs_facts) {
    for (let i = 0; i < data.events.length; i = i + 1) {
      if (!object_value(data.events[i]) || !object_value(data.events[i].node)
          || data.events[i].node.facts_complete !== true) {
        return unavailable_filter("event-facts",
          typeof data.mode === "string" ? data.mode : "unknown");
      }
    }
  }
  const matched = [];
  for (let i = 0; i < data.events.length; i = i + 1) {
    const event = data.events[i];
    if (!object_value(event) || !object_value(event.node)
        || typeof event.node.role !== "string") {
      return failure("acu_compound_observe_invalid", "every observe event needs node.role");
    }
    const role = normalize_role(event.node.role);
    if (roles !== null && roles.value.indexOf(role) === -1) { continue; }
    if (filters.text !== undefined) {
      if (typeof filters.text !== "string") {
        return failure("acu_compound_observe_filter_invalid", "text must be a string");
      }
      if (event_text(event).indexOf(filters.text.toLowerCase()) === -1) { continue; }
    }
    if (actions !== null) {
      if (!Array.isArray(event.node.actions)) { return unavailable_filter("action", data.mode); }
      let action_match = false;
      for (let j = 0; j < event.node.actions.length; j = j + 1) {
        if (typeof event.node.actions[j] === "string"
            && actions.value.indexOf(event.node.actions[j].toLowerCase()) !== -1) {
          action_match = true;
        }
      }
      if (!action_match) { continue; }
    }
    if (filters.actionable === true
        && !legacy_observe_actionable(role, event.node.actions)) { continue; }
    const state_filters = [
      ["enabled", ["enabled"], ["disabled"]],
      ["focused", ["focused"], ["focusable"]],
      ["selected", ["selected"], ["unselected"]],
      ["checked", ["checked"], ["unchecked"]],
      ["expanded", ["expanded"], ["collapsed"]]
    ];
    let state_match = true;
    for (let j = 0; j < state_filters.length; j = j + 1) {
      const spec = state_filters[j];
      if (filters[spec[0]] !== undefined
          && state_value(event.node.states, spec[1], spec[2]) !== filters[spec[0]]) {
        state_match = false;
      }
    }
    if (!state_match) { continue; }
    if (filters["min-depth"] !== undefined && event.node.depth < filters["min-depth"]) {
      continue;
    }
    if (filters["max-depth"] !== undefined && event.node.depth > filters["max-depth"]) {
      continue;
    }
    if (filters.within !== undefined) {
      if (!Array.isArray(filters.within) || filters.within.length !== 4
          || !object_value(event.node.bounds)) {
        return unavailable_filter("within", data.mode);
      }
      const center_x = event.node.bounds.x + event.node.bounds.width / 2;
      const center_y = event.node.bounds.y + event.node.bounds.height / 2;
      if (center_x < filters.within[0] || center_x > filters.within[2]
          || center_y < filters.within[1] || center_y > filters.within[3]) {
        continue;
      }
    }
    matched.push(event);
  }
  const selected = page(matched, bounds.value);
  const out = clone(data);
  const removed = data.events.length - matched.length;
  out.events = clone(selected);
  out.filters = clone(filters);
  out.captured_event_count = data.events.length;
  out.matched_event_count = matched.length;
  out.returned_event_count = selected.length;
  out.offset = bounds.value.offset;
  out.max = bounds.value.max;
  out.truncated_results = bounds.value.offset + selected.length < matched.length;
  out.emitted = selected.length;
  out.filtered = (nonnegative_integer(data.filtered) ? data.filtered : 0) + removed;
  return success(out);
}

export function observe_roles(reply, roles) {
  const wanted = wanted_values(roles, "role", normalize_role);
  if (!wanted.ok) { return wanted; }
  const projected = observe_filters(reply, { role: roles, offset: 0, max: null });
  if (!projected.ok) { return projected; }
  projected.value.roles = clone(wanted.value);
  return projected;
}

// Archived shared/tree-query.ts actionable role vocabulary. Page results keep
// this second-stage vocabulary separate from the provider-side CDP predicate.
const LEGACY_PAGE_ACTIONABLE_ROLES = [
  "button", "pushbutton", "togglebutton", "checkbox", "radiobutton",
  "textfield", "textarea", "entry", "passwordtext", "combobox",
  "popupbutton", "spinbutton", "slider", "link", "menuitem", "tab",
  "row", "cell"
];

export function legacy_page_role_key(raw) {
  if (typeof raw !== "string") { return ""; }
  let value = raw.toLowerCase();
  if (value.startsWith("ax")) { value = value.substring(2); }
  if (value.startsWith("controltype.")) {
    value = value.substring("controltype.".length);
  }
  let out = "";
  for (let i = 0; i < value.length; i = i + 1) {
    const ch = value.charAt(i);
    if ((ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9")) {
      out = out + ch;
    }
  }
  return out;
}

export function legacy_page_actionable(role) {
  const key = legacy_page_role_key(role);
  for (let i = 0; i < LEGACY_PAGE_ACTIONABLE_ROLES.length; i = i + 1) {
    if (LEGACY_PAGE_ACTIONABLE_ROLES[i] === key) { return true; }
  }
  return false;
}

function lower_hex(value, length) {
  if (typeof value !== "string" || value.length !== length) { return false; }
  for (let i = 0; i < value.length; i = i + 1) {
    const code = value.charCodeAt(i);
    if (!((code >= 48 && code <= 57) || (code >= 97 && code <= 102))) {
      return false;
    }
  }
  return true;
}

function bridge_status_result(reply, connection_id) {
  const unpacked = reply_data(reply, "browser-bridge-status reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  const result = object_value(data) && object_value(data.result) ? data.result : null;
  if (!object_value(data) || data.connection_id !== connection_id || result === null
      || !lower_hex(result.profile_instance_id, 32)
      || !positive_integer(result.protocol)
      || typeof result.extension_id !== "string" || result.extension_id.length === 0
      || typeof result.extension_version !== "string" || result.extension_version.length === 0
      || !Array.isArray(result.commands)) {
    return failure("browser_bridge_response_invalid",
      "bridge status reply lacks exact connection, protocol or extension identity");
  }
  for (let i = 0; i < result.commands.length; i = i + 1) {
    if (typeof result.commands[i] !== "string" || result.commands[i].length === 0) {
      return failure("browser_bridge_response_invalid",
        "bridge status commands must be non-empty strings");
    }
  }
  return success(result);
}

// Select one exact live MV3 connection from the complete native inventory.
// Human profile names are rejected by compat before this identity boundary.
export function bridge_select_connection(connections_reply, status_replies, profile) {
  if (profile !== null && (typeof profile !== "string"
      || profile.length < 1 || profile.length > 32
      || !lower_hex(profile, profile.length))) {
    return failure("browser_bridge_profile_identity_invalid",
      "bridge profile selector must be a 1..32 lowercase hexadecimal prefix");
  }
  if (!object_value(status_replies)) {
    return failure("browser_bridge_response_invalid",
      "bridge status replies must be keyed by exact connection id");
  }
  const unpacked = reply_data(connections_reply, "browser-bridge-connections reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || !Array.isArray(data.connections)
      || typeof data.truncated !== "boolean" || !nonnegative_integer(data.visited)
      || data.connections.length > data.visited) {
    return failure("browser_bridge_response_invalid",
      "bridge connection inventory lacks bounded completeness facts");
  }
  if (data.truncated) {
    return failure("browser_bridge_connection_inventory_truncated",
      "the live bridge connection inventory is incomplete; uniqueness cannot be proved");
  }
  const matched = [];
  for (let i = 0; i < data.connections.length; i = i + 1) {
    const entry = data.connections[i];
    if (!object_value(entry) || !lower_hex(entry.connection_id, 64)
        || !object_value(entry.process) || !positive_integer(entry.process.pid)) {
      return failure("browser_bridge_response_invalid",
        "bridge connection inventory contains an incomplete identity");
    }
    const status = bridge_status_result(status_replies[entry.connection_id], entry.connection_id);
    if (!status.ok) { return status; }
    if (profile === null || status.value.profile_instance_id.startsWith(profile)) {
      matched.push({
        connection_id: entry.connection_id,
        profile_instance_id: status.value.profile_instance_id,
        pid: entry.process.pid,
        status: status.value
      });
    }
  }
  if (matched.length === 0) {
    return failure("browser_bridge_profile_connection_not_found",
      "no live bridge connection matches the requested profile identity");
  }
  if (matched.length > 1) {
    return failure("browser_bridge_profile_connection_ambiguous",
      "more than one live bridge connection matches; pass a longer profile prefix");
  }
  return success(matched[0]);
}

export function bridge_status_projection(selected, connections_reply) {
  if (!object_value(selected) || !lower_hex(selected.connection_id, 64)
      || !lower_hex(selected.profile_instance_id, 32) || !positive_integer(selected.pid)
      || !object_value(selected.status)) {
    return failure("browser_bridge_response_invalid",
      "selected bridge connection is incomplete");
  }
  const unpacked = reply_data(connections_reply, "browser-bridge-connections reply");
  if (!unpacked.ok) { return unpacked; }
  const rows = unpacked.value.connections;
  if (!Array.isArray(rows)) {
    return failure("browser_bridge_response_invalid",
      "bridge connection inventory lacks connections");
  }
  const connections = [];
  let selected_count = 0;
  for (let i = 0; i < rows.length; i = i + 1) {
    const row = rows[i];
    if (!object_value(row) || !lower_hex(row.connection_id, 64)
        || !object_value(row.process) || !positive_integer(row.process.pid)) {
      return failure("browser_bridge_response_invalid",
        "bridge connection inventory contains an incomplete identity");
    }
    if (row.connection_id === selected.connection_id) {
      if (row.process.pid !== selected.pid) {
        return failure("browser_bridge_response_invalid",
          "selected bridge process identity changed inside the inventory");
      }
      selected_count = selected_count + 1;
    }
    connections.push({ connection_id: row.connection_id, pid: row.process.pid });
  }
  if (selected_count !== 1) {
    return failure("browser_bridge_response_invalid",
      "selected bridge connection is not unique in the complete inventory");
  }
  return success({
    connected: true,
    ready: true,
    connection: {
      connection_id: selected.connection_id,
      profile_instance_id: selected.profile_instance_id,
      pid: selected.pid
    },
    connections: connections,
    version: {
      extension_id: selected.status.extension_id,
      extension_version: selected.status.extension_version,
      protocol: selected.status.protocol,
      current: true
    },
    commands: clone(selected.status.commands),
    diagnosis: null,
    facts_withheld: ["installed", "manifests", "extensionPath", "profiles", "registry"]
  });
}

export function bridge_window_open_projection(selected, reply, legacy_timeout) {
  if (!object_value(selected) || !lower_hex(selected.connection_id, 64)
      || !lower_hex(selected.profile_instance_id, 32) || !positive_integer(selected.pid)) {
    return failure("browser_bridge_response_invalid",
      "selected bridge connection is incomplete");
  }
  const unpacked = reply_data(reply, "browser-bridge-window-open reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  const result = object_value(data) ? data.result : null;
  const window = object_value(result) ? result.window : null;
  const desktop = object_value(data) ? data.desktop_focus : null;
  if (!object_value(data) || data.connection_id !== selected.connection_id
      || !object_value(result) || result.requested_focused !== false
      || result.requested_state !== "minimized" || result.performed !== true
      || result.verified !== true || result.focus_changed !== false
      || result.focused_window_before !== result.focused_window_after
      || !object_value(window) || !positive_integer(window.window_id)
      || window.state !== "minimized" || window.focused !== false
      || window.tab_count !== 1 || !positive_integer(window.active_tab_id)
      || !object_value(desktop) || !positive_integer(desktop.before)
      || desktop.after_effect !== desktop.before || desktop.after !== desktop.before
      || desktop.verified !== true || desktop.restored !== false) {
    return failure("browser_open_postcondition_failed",
      "legacy browser open did not prove one atomic minimized window with unchanged browser and desktop focus");
  }
  return success({
    transport: "native-bridge",
    background: true,
    connection_id: selected.connection_id,
    profile_instance_id: selected.profile_instance_id,
    window_id: window.window_id,
    tab_id: window.active_tab_id,
    state: "minimized",
    focused: false,
    verified: true,
    transient_normal_window: false,
    legacy_timeout_ignored: legacy_timeout !== null && legacy_timeout !== undefined
  });
}

export function cdp_nav_target(reply) {
  const unpacked = reply_data(reply, "page-targets reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || !Array.isArray(data.targets)) {
    return failure("page_targets_shape_invalid", "page-targets reply lacks targets");
  }
  const pages = [];
  for (let i = 0; i < data.targets.length; i = i + 1) {
    const target = data.targets[i];
    if (!object_value(target) || typeof target.type !== "string"
        || typeof target.id !== "string" || target.id.length === 0) {
      return failure("page_targets_shape_invalid",
        "page-targets contains an incomplete target identity");
    }
    if (target.type === "page") {
      pages.push(target);
    }
  }
  if (pages.length !== 1) {
    return failure("page_target_ambiguous",
      pages.length === 0 ? "no CDP page target exists; pass --match to select one"
        : "more than one CDP page target exists; pass --match to select one");
  }
  return success({ target_id: pages[0].id });
}

// Resolve one exact MV3 connection and tab through native browser-tabs. The
// returned connection id, not the reply-local page index, owns later reads.
export function elements_page_tab(reply, tab_id, profile) {
  if (!positive_integer(tab_id)) {
    return failure("elements_page_tab_invalid", "elements --tab-id must be a positive integer");
  }
  const unpacked = reply_data(reply, "browser-tabs reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || data.mechanism !== "mv3-native-messaging") {
    return failure("browser_bridge_profile_connection_not_found",
      "page elements need one exact live MV3 profile connection");
  }
  if (data.truncated === true) {
    return failure("browser_bridge_tabs_inventory_truncated",
      "bridge tab inventory is truncated; the requested tab cannot be proved present");
  }
  if (!lower_hex(data.connection_id, 64) || !lower_hex(data.profile_instance_id, 32)
      || data.verified !== true || data.focus_changed !== false
      || !Array.isArray(data.tabs) || !nonnegative_integer(data.returned)
      || data.tabs.length !== data.returned || !object_value(data.selection)
      || data.selection.tab_id !== tab_id || data.selection.connection_id !== null
      || data.selection.match !== null
      || (profile === null && data.selection.profile_instance_id !== null)
      || (profile !== null && data.selection.profile_instance_id !== profile)
      || (profile !== null && !data.profile_instance_id.startsWith(profile))) {
    return failure("elements_page_shape_invalid",
      "browser-tabs did not prove one exact MV3 connection and bounded tab inventory");
  }
  if (data.tabs.length === 0) {
    return failure("browser_bridge_tab_not_found",
      "the requested tab is not present in the exact bridge tab inventory");
  }
  if (data.tabs.length !== 1) {
    return failure("elements_page_shape_invalid",
      "browser-tabs returned more than the one requested tab");
  }
  const tab = data.tabs[0];
  if (!object_value(tab) || tab.tab_id !== tab_id || !positive_integer(tab.window_id)
      || typeof tab.active !== "boolean") {
    return failure("elements_page_shape_invalid",
      "browser-tabs returned a mismatched or incomplete tab identity");
  }
  return success({
    connection_id: data.connection_id,
    profile_instance_id: data.profile_instance_id,
    tab_id: tab.tab_id,
    window_id: tab.window_id,
    active: tab.active
  });
}

function checked_page_node(node) {
  if (!object_value(node) || !positive_integer(node.backend_node_id)
      || typeof node.frame_id !== "string" || node.frame_id.length === 0
      || !nonnegative_integer(node.depth)
      || typeof node.role !== "string" || node.role.length === 0
      || typeof node.name !== "string"
      || typeof node.actionable !== "boolean"
      || typeof node.disabled !== "boolean"
      || typeof node.focused !== "boolean") {
    return null;
  }
  return node;
}

// The page index is positional inside this one reply. Exact follow-up identity
// is always connection + tab + frame + backend node, never invoke --index.
export function elements_page_projection(reply, options) {
  if (!object_value(options) || typeof options.actionable !== "boolean"
      || !positive_integer(options.max) || options.max > 1000
      || !positive_integer(options.tab_id) || !lower_hex(options.connection_id, 64)) {
    return failure("elements_page_options_invalid",
      "elements page projection needs actionable, max 1..1000, tab_id and connection_id");
  }
  const unpacked = reply_data(reply, "browser-bridge-debug-read reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || data.connection_id !== options.connection_id
      || !object_value(data.result)) {
    return failure("elements_page_shape_invalid",
      "bridge debug-read reply belongs to a different or unproven connection");
  }
  const result = data.result;
  if (result.tab_id !== options.tab_id
      || result.request_actionable !== options.actionable
      || !Array.isArray(result.nodes) || result.nodes.length > options.max + 1
      || !object_value(result.presentation) || !object_value(result.detach)
      || result.detach.outcome !== "detached" || typeof result.truncated !== "boolean"
      || !positive_integer(result.frame_count) || !nonnegative_integer(result.scanned)) {
    return failure("elements_page_shape_invalid",
      "bridge debug-read did not prove the requested filter, bounds and detach");
  }
  if (result.presentation.tab_active_before !== result.presentation.tab_active_after
      || result.presentation.window_focused_before !== result.presentation.window_focused_after
      || result.presentation.activation_requested !== false) {
    return failure("elements_page_presentation_changed",
      "bridge debug-read changed tab or window presentation; refusing to project");
  }
  const filtered = [];
  for (let i = 0; i < result.nodes.length; i = i + 1) {
    const node = checked_page_node(result.nodes[i]);
    if (node === null || (options.actionable && node.actionable !== true)) {
      return failure("elements_page_shape_invalid",
        "bridge debug-read node lacks exact identity or requested actionable facts");
    }
    const actionable = node.actionable === true || legacy_page_actionable(node.role);
    if (!options.actionable || actionable) {
      filtered.push({ node: node, actionable: actionable });
    }
  }
  const elements = [];
  for (let i = 0; i < filtered.length && i < options.max; i = i + 1) {
    const node = filtered[i].node;
    elements.push({
      index: i,
      role: node.role,
      name: node.name,
      selector: "page:" + node.frame_id + ":" + node.role + ":" + node.name,
      actions: filtered[i].actionable ? ["press"] : [],
      enabled: node.disabled !== true,
      focused: node.focused === true,
      frame_id: node.frame_id,
      backend_node_id: node.backend_node_id,
      depth: node.depth
    });
  }
  const next_actions = [];
  if (elements.length > 0) {
    next_actions.push("browser-bridge-debug-invoke " + options.connection_id
      + " --tab-id " + options.tab_id
      + " --frame-id <frame_id> --backend-node-id <backend_node_id>"
      + " --role <role> --name <name>; page indices are never valid for invoke --index");
  }
  return success({
    screenshot: false,
    provider: "page-ax",
    indexSpace: "page",
    ax: "content",
    connection_id: options.connection_id,
    tab_id: options.tab_id,
    frame_count: result.frame_count,
    visited: result.scanned,
    returned: elements.length,
    truncated: filtered.length > options.max || result.truncated === true,
    handle_ignored: true,
    request_actionable: options.actionable,
    max_effective_ceiling: 1000,
    elements: elements,
    nextActions: next_actions
  });
}
