// Pure projections used by compound MCU-to-ACU rewrites.
//
// Every input is an already parsed CuReply. This module owns no host calls,
// command dispatch, authority decisions, or mutable cross-call state.

function failure(code, message) {
  return { ok: false, code: code, message: message };
}

function success(value) {
  return { ok: true, value: value };
}

function object_value(value) {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

function reply_data(reply, label) {
  if (!object_value(reply) || typeof reply.ok !== "boolean") {
    return failure("acu_compound_reply_invalid", label + " is not a CuReply");
  }
  if (reply.ok === false) {
    if (object_value(reply.error) && typeof reply.error.code === "string"
        && reply.error.code.length > 0 && typeof reply.error.message === "string") {
      return failure(reply.error.code, reply.error.message);
    }
    return failure("acu_compound_reply_invalid", label + " has no typed error");
  }
  if (reply.data === undefined || reply.data === null) {
    return failure("acu_compound_reply_invalid", label + " has no data");
  }
  return success(reply.data);
}

function positive_integer(value) {
  return typeof value === "number" && value > 0 && value === value && value % 1 === 0;
}

function nonnegative_integer(value) {
  return typeof value === "number" && value >= 0 && value === value && value % 1 === 0;
}

function clone(value) {
  return JSON.parse(JSON.stringify(value));
}

function page_bounds(offset, max) {
  const start = offset === undefined || offset === null ? 0 : offset;
  if (!nonnegative_integer(start)) {
    return failure("acu_compound_page_invalid", "offset must be a non-negative integer");
  }
  if (max !== undefined && max !== null && !positive_integer(max)) {
    return failure("acu_compound_page_invalid", "max must be a positive integer");
  }
  return success({ offset: start, max: max });
}

function page(values, bounds) {
  const end = bounds.max === undefined || bounds.max === null
    ? values.length : bounds.offset + bounds.max;
  const out = [];
  for (let i = bounds.offset; i < values.length && i < end; i = i + 1) {
    out.push(values[i]);
  }
  return out;
}

function lower(value) {
  return value.toLowerCase();
}

export function job_generation(reply, job_id) {
  const unpacked = reply_data(reply, "job-status reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || typeof job_id !== "string" || job_id.length === 0
      || data.job_id !== job_id || !positive_integer(data.generation)) {
    return failure("acu_compound_job_status_invalid",
      "job-status must identify the requested job with one positive generation");
  }
  return success(data.generation);
}

export function single_window(reply, pid) {
  const unpacked = reply_data(reply, "windows reply");
  if (!unpacked.ok) { return unpacked; }
  if (!positive_integer(pid)) {
    return failure("acu_compound_pid_invalid", "pid must be a positive integer");
  }
  const data = unpacked.value;
  const rows = Array.isArray(data) ? data
    : object_value(data) && Array.isArray(data.windows) ? data.windows : null;
  if (rows === null || rows.length !== 1 || !object_value(rows[0])) {
    return failure("acu_compound_window_ambiguous",
      "windows --pid must return exactly one window");
  }
  const row = rows[0];
  if (row.process_id !== pid || typeof row.handle !== "number" || row.handle === 0
      || row.handle !== row.handle || row.handle % 1 !== 0) {
    return failure("acu_compound_window_invalid",
      "windows --pid returned a mismatched pid or invalid handle");
  }
  return success(clone(row));
}

export function single_node_id(reply) {
  const unpacked = reply_data(reply, "query reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || !Array.isArray(data.nodes) || data.nodes.length !== 1
      || !object_value(data.nodes[0]) || typeof data.nodes[0].id !== "string"
      || data.nodes[0].id.length === 0) {
    return failure("acu_compound_node_ambiguous",
      "query must return exactly one node with a non-empty id");
  }
  return success(data.nodes[0].id);
}

export function apps_page(reply, match, offset, max) {
  const unpacked = reply_data(reply, "apps reply");
  if (!unpacked.ok) { return unpacked; }
  const data = unpacked.value;
  if (!object_value(data) || !Array.isArray(data.apps)) {
    return failure("acu_compound_apps_invalid", "apps reply data must contain an apps array");
  }
  if (match !== undefined && match !== null && typeof match !== "string") {
    return failure("acu_compound_match_invalid", "app match must be a string");
  }
  const bounds = page_bounds(offset, max);
  if (!bounds.ok) { return bounds; }
  const wanted = match === undefined || match === null ? "" : lower(match);
  const matched = [];
  for (let i = 0; i < data.apps.length; i = i + 1) {
    const row = data.apps[i];
    if (!object_value(row) || typeof row.app_name !== "string") {
      return failure("acu_compound_apps_invalid", "every app row needs app_name");
    }
    if (wanted === "" || lower(row.app_name).indexOf(wanted) !== -1) {
      matched.push(row);
    }
  }
  const selected = page(matched, bounds.value);
  const out = clone(data);
  out.apps = clone(selected);
  out.filter = { match: match === undefined || match === null ? null : match };
  out.visited = data.apps.length;
  out.matched = matched.length;
  out.returned = selected.length;
  out.offset = bounds.value.offset;
  out.truncated = bounds.value.offset + selected.length < matched.length;
  return success(out);
}

function space_equal(value, wanted) {
  if ((typeof value !== "string" && typeof value !== "number")
      || (typeof value === "number" && (!positive_integer(value)))) {
    return false;
  }
  return "" + value === wanted;
}

export function windows_space_page(reply, space, offset, max) {
  const unpacked = reply_data(reply, "windows reply");
  if (!unpacked.ok) { return unpacked; }
  if ((typeof space !== "string" && typeof space !== "number") || "" + space === "") {
    return failure("acu_compound_space_invalid", "space must be a non-empty id");
  }
  const wanted = "" + space;
  const bounds = page_bounds(offset, max);
  if (!bounds.ok) { return bounds; }
  const data = unpacked.value;
  const rows = Array.isArray(data) ? data
    : object_value(data) && Array.isArray(data.windows) ? data.windows : null;
  if (rows === null) {
    return failure("acu_compound_windows_invalid",
      "windows reply data must be an array or contain a windows array");
  }
  const matched = [];
  for (let i = 0; i < rows.length; i = i + 1) {
    const row = rows[i];
    if (!object_value(row)) {
      return failure("acu_compound_windows_invalid", "every window row must be an object");
    }
    if (row.spaces === undefined) { continue; }
    if (!Array.isArray(row.spaces)) {
      return failure("acu_compound_windows_invalid", "window spaces must be an array");
    }
    let found = false;
    for (let j = 0; j < row.spaces.length; j = j + 1) {
      if (space_equal(row.spaces[j], wanted)) { found = true; }
    }
    if (found) { matched.push(row); }
  }
  const selected = page(matched, bounds.value);
  const out = Array.isArray(data) ? {} : clone(data);
  out.windows = clone(selected);
  out.filter = object_value(out.filter) ? out.filter : {};
  out.filter.space = wanted;
  out.visited = rows.length;
  out.matched = matched.length;
  out.returned = selected.length;
  out.offset = bounds.value.offset;
  out.truncated = bounds.value.offset + selected.length < matched.length;
  return success(out);
}

export function normalize_role(raw) {
  if (typeof raw !== "string") { return ""; }
  let text = raw.trim();
  if (text.startsWith("AX")) { text = text.slice(2); }
  text = text.toLowerCase();
  let out = "";
  for (let i = 0; i < text.length; i = i + 1) {
    const ch = text.charAt(i);
    if ((ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9")) { out = out + ch; }
  }
  return out === "pushbutton" ? "button" : out;
}

function wanted_roles(roles) {
  const raw = Array.isArray(roles) ? roles
    : typeof roles === "string" ? roles.split(",") : null;
  if (raw === null) {
    return failure("acu_compound_role_invalid", "roles must be a string or string array");
  }
  const values = [];
  for (let i = 0; i < raw.length; i = i + 1) {
    if (typeof raw[i] !== "string") {
      return failure("acu_compound_role_invalid", "every role must be a string");
    }
    const role = normalize_role(raw[i]);
    if (role !== "" && values.indexOf(role) === -1) { values.push(role); }
  }
  if (values.length === 0) {
    return failure("acu_compound_role_invalid", "at least one non-empty role is required");
  }
  return success(values);
}

export function observe_roles(reply, roles) {
  const unpacked = reply_data(reply, "observe reply");
  if (!unpacked.ok) { return unpacked; }
  const wanted = wanted_roles(roles);
  if (!wanted.ok) { return wanted; }
  const data = unpacked.value;
  if (!object_value(data) || !Array.isArray(data.events)) {
    return failure("acu_compound_observe_invalid",
      "observe reply data must contain an events array");
  }
  const kept = [];
  for (let i = 0; i < data.events.length; i = i + 1) {
    const event = data.events[i];
    if (!object_value(event) || !object_value(event.node)
        || typeof event.node.role !== "string") {
      return failure("acu_compound_observe_invalid", "every observe event needs node.role");
    }
    if (wanted.value.indexOf(normalize_role(event.node.role)) !== -1) { kept.push(event); }
  }
  const out = clone(data);
  const removed = data.events.length - kept.length;
  out.events = clone(kept);
  out.roles = clone(wanted.value);
  out.emitted = kept.length;
  out.filtered = (nonnegative_integer(data.filtered) ? data.filtered : 0) + removed;
  return success(out);
}
