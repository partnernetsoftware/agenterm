import * as compound from "skills/acu/lib/compound";

function require(condition, message) {
  if (!condition) { throw message; }
}

function ok(result, message) {
  require(result.ok === true, message + ": " + result.code + " " + result.message);
  return result.value;
}

function fails(result, code, message) {
  require(result.ok === false, message + " unexpectedly succeeded");
  require(result.code === code, message + " code=" + result.code);
  require(typeof result.message === "string" && result.message.length > 0,
    message + " missing message");
}

const native_effect_failure = {
  ok: false,
  target: "current",
  command: "browser-bridge-window-open",
  data: null,
  error: {
    code: "browser_bridge_outcome_unknown",
    message: "delivery cannot be proved",
    count: 1,
    detail: {
      effect: "unknown",
      retry_safe: false,
      recovery: { attempted: true, verified: false }
    }
  }
};
const preserved_effect_failure = compound.job_generation(
  native_effect_failure, "job-1");
require(preserved_effect_failure.ok === false
    && JSON.stringify(preserved_effect_failure.native_reply)
      === JSON.stringify(native_effect_failure),
  "native compound failures must preserve the complete CuReply");
preserved_effect_failure.native_reply.error.detail.effect = "not-performed";
require(native_effect_failure.error.detail.effect === "unknown",
  "preserved native compound failure must not alias its input");

const generation = ok(compound.job_generation({
  ok: true, data: { job_id: "job-1", generation: 7 }
}, "job-1"), "job generation");
require(generation === 7, "generation changed");
fails(compound.job_generation({
  ok: true, data: { job_id: "job-2", generation: 7 }
}, "job-1"), "acu_compound_job_status_invalid", "job identity");
fails(compound.job_generation({
  ok: true, data: { job_id: "job-1", generation: 0 }
}, "job-1"), "acu_compound_job_status_invalid", "zero generation");

const window_reply = { ok: true, data: {
  matched: 1,
  windows: [{ handle: 91, process_id: 42, title: "Editor" }]
} };
const window = ok(compound.single_window(window_reply, 42), "single window");
require(window.handle === 91 && window.process_id === 42, "window identity changed");
window.handle = 1;
require(window_reply.data.windows[0].handle === 91, "single window aliases reply");
fails(compound.single_window({ ok: true, data: { windows: [] } }, 42),
  "acu_compound_window_ambiguous", "missing window");
fails(compound.single_window({ ok: true, data: {
  windows: [{ handle: 91, process_id: 43 }]
} }, 42), "acu_compound_window_invalid", "window pid");

require(ok(compound.single_node_id({ ok: true, data: {
  nodes: [{ id: "/0/3", role: "AXButton" }]
} }), "single node") === "/0/3", "node id changed");
fails(compound.single_node_id({ ok: true, data: { nodes: [{ id: "a" }, { id: "b" }] } }),
  "acu_compound_node_ambiguous", "multiple nodes");

const apps_reply = { ok: true, data: {
  mechanism: "libagenterm",
  running_only: true,
  apps: [
    { app_name: "Editor Pro", pids: [1] },
    { app_name: "Terminal", pids: [2] },
    { app_name: "editor helper", pids: [3] }
  ]
} };
const apps = ok(compound.apps_page(apps_reply, "EDITOR", 1, 1), "apps page");
require(apps.apps.length === 1 && apps.apps[0].app_name === "editor helper", "apps match/page");
require(apps.visited === 3 && apps.matched === 2 && apps.returned === 1,
  "apps counts");
require(apps.offset === 1 && apps.truncated === false, "apps page metadata");
require(apps_reply.data.apps.length === 3, "apps projection mutated reply");
fails(compound.apps_page(apps_reply, "", -1, 1),
  "acu_compound_page_invalid", "apps offset");

require(compound.normalize_role("AXText Area") === "textarea", "AX normalization");
require(compound.normalize_role("push-button") === "button", "role synonym");
const observe_reply = { ok: true, data: {
  mode: "poll-diff",
  emitted: 4,
  filtered: 2,
  events: [
    { seq: 0, node: { id: "a", role: "AXButton" } },
    { seq: 1, node: { id: "b", role: "text-area" } },
    { seq: 2, node: { id: "c", role: "Push Button" } },
    { seq: 3, node: { id: "d", role: "link" } }
  ]
} };
const observed = ok(compound.observe_roles(observe_reply, " button, AXTextArea,button "),
  "observe roles");
require(observed.events.length === 3, "observe filter count");
require(observed.events[0].node.id === "a" && observed.events[2].node.id === "c",
  "observe filter order");
require(observed.roles.length === 2 && observed.roles[0] === "button"
  && observed.roles[1] === "textarea", "observe normalized roles");
require(observed.emitted === 3 && observed.filtered === 3, "observe counters");
require(observe_reply.data.events.length === 4, "observe projection mutated reply");

const fact_reply = { ok: true, data: {
  mode: "poll-diff", emitted: 3, filtered: 1, events: [
    { seq: 0, before: null, after: { text: "ready" }, node: {
      id: "a", role: "AXButton", name: "Save", identifier: "save-button",
      facts_complete: true, actions: ["press"], states: ["enabled", "checked"],
      depth: 2, bounds: { x: 10, y: 20, width: 20, height: 10 }, text: null
    } },
    { seq: 1, before: "old", after: "needle value", node: {
      id: "b", role: "AXTextField", name: "Editor", identifier: "editor",
      facts_complete: true, actions: [], states: [], depth: 3,
      bounds: { x: 100, y: 100, width: 40, height: 20 }, text: "body"
    } },
    { seq: 2, before: null, after: null, node: {
      id: "c", role: "AXLink", name: "More", identifier: null,
      facts_complete: true, actions: [], states: ["disabled", "unchecked"],
      depth: 4, bounds: { x: 200, y: 200, width: 10, height: 10 }, text: null
    } }
  ]
} };
const enabled = ok(compound.observe_filters(fact_reply, {
  enabled: true, "min-depth": 0, "max-depth": 4, offset: 0, max: 10
}), "observe enabled filter");
require(enabled.events.length === 1 && enabled.events[0].node.id === "a",
  "unknown boolean state must not match false or true");
require(enabled.captured_event_count === 3 && enabled.matched_event_count === 1
  && enabled.returned_event_count === 1, "observe filter counters");
const checked_false = ok(compound.observe_filters(fact_reply, {
  checked: false, "min-depth": 0, "max-depth": 4, offset: 0, max: 10
}), "observe checked false filter");
require(checked_false.events.length === 1 && checked_false.events[0].node.id === "c",
  "unknown checked state must not become false");
const text_page = ok(compound.observe_filters(fact_reply, {
  text: "e", "min-depth": 0, "max-depth": 4, offset: 1, max: 1
}), "observe text page");
require(text_page.matched_event_count === 3 && text_page.returned_event_count === 1
  && text_page.events[0].node.id === "b" && text_page.truncated_results === true,
  "observe pagination must apply after matching");
const action_within = ok(compound.observe_filters(fact_reply, {
  action: "PRESS", within: [0, 0, 50, 50], actionable: true,
  "min-depth": 2, "max-depth": 2, offset: 0, max: 10
}), "observe projected facts");
require(action_within.events.length === 1 && action_within.events[0].node.id === "a",
  "observe action, actionable, bounds and depth facts");
fails(compound.observe_filters(fact_reply, { required: false, offset: 0, max: 1 }),
  "observe_filter_unavailable", "required state unavailable");
fails(compound.observe_filters({ ok: true, data: {
  mode: "notifications", events: [{ node: {
    id: "n", role: "link", facts_complete: false, actions: null, states: null
  } }]
} }, { role: "button", action: "press", offset: 0, max: 1 }),
  "observe_filter_unavailable", "notification facts unavailable");
fails(compound.observe_filters({ ok: true, data: {
  mode: "notifications", events: []
} }, { enabled: false, offset: 0, max: 1 }),
  "observe_filter_unavailable", "empty notification facts unavailable");

fails(compound.observe_roles({ ok: true, data: { events: [{ node: {} }] } }, "button"),
  "acu_compound_observe_invalid", "observe malformed event");

const page_connection = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
const page_profile = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
const reload_selected = {
  connection_id: page_connection,
  profile_instance_id: page_profile
};
const reload_noop = ok(compound.bridge_extension_reload_projection(reload_selected, {
  ok: true, data: {
    reloaded: false, reason: "already-current", reload_scope: "extension-code",
    effect: "not-performed", retry_safe: true, connection_id: page_connection,
    profile_instance_id: page_profile,
    loaded_identity: { protocol: 6, extension_version: "1.7.0", build_id: "a" },
    source_identity: { protocol: 6, extension_version: "1.7.0", build_id: "a" },
    verified: true
  }
}), "extension reload no-op projection");
require(reload_noop.reloaded === false && reload_noop.current === true
    && reload_noop.effect === "not-performed" && reload_noop.retry_safe === true,
  "extension reload no-op identity");
const replacement_connection = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
const reload_performed = ok(compound.bridge_extension_reload_projection(reload_selected, {
  ok: true, data: {
    reloaded: true, reload_scope: "extension-code", effect: "performed",
    retry_safe: false, old_connection_id: page_connection,
    connection_id: replacement_connection, profile_instance_id: page_profile,
    old_connection_gone: true, unique_reconnect: true, tabs_unchanged: true,
    tabs_identity_digest: page_connection, focus_changed: false,
    acknowledgement: { accepted: true, reload_scope: "extension-code" },
    loaded_identity_before: { extension_version: "1.6.0" },
    loaded_identity_after: { extension_version: "1.7.0" },
    source_identity: { extension_version: "1.7.0" }, verified: true
  }
}), "extension reload performed projection");
require(reload_performed.reloaded === true
    && reload_performed.previous_connection_id === page_connection
    && reload_performed.connection_id === replacement_connection
    && reload_performed.effect === "performed" && reload_performed.retry_safe === false,
  "extension reload performed identity");
fails(compound.bridge_extension_reload_projection(reload_selected, {
  ok: true, data: {
    reloaded: true, reload_scope: "extension-code", effect: "unknown",
    retry_safe: false, profile_instance_id: page_profile, verified: true
  }
}), "browser_bridge_extension_reload_postcondition_failed",
"extension reload uncertain success projection");
const page_tab = ok(compound.elements_page_tab({ ok: true, data: {
  mechanism: "mv3-native-messaging", connection_id: page_connection,
  profile_instance_id: page_profile, returned: 1, truncated: false,
  verified: true, focus_changed: false,
  selection: { profile_instance_id: null, connection_id: null, match: null, tab_id: 4 },
  tabs: [{ tab_id: 4, window_id: 9, active: false }]
} }, 4, null), "elements page tab");
require(page_tab.connection_id === page_connection && page_tab.tab_id === 4,
  "elements page exact tab identity");
const page_native = { ok: true, data: { connection_id: page_connection, result: {
  tab_id: 4, request_actionable: true, frame_count: 1, scanned: 3, truncated: false,
  nodes: [
    { frame_id: "F", backend_node_id: 1, depth: 1, role: "button", name: "A",
      actionable: true, disabled: false, focused: false },
    { frame_id: "F", backend_node_id: 2, depth: 1, role: "link", name: "B",
      actionable: true, disabled: false, focused: true }
  ],
  presentation: { tab_active_before: false, tab_active_after: false,
    window_focused_before: false, window_focused_after: false,
    activation_requested: false },
  detach: { outcome: "detached" }
} } };
const page_view = ok(compound.elements_page_projection(page_native, {
  actionable: true, max: 1, tab_id: 4, connection_id: page_connection
}), "elements page projection");
require(page_view.returned === 1 && page_view.truncated === true
    && page_view.elements[0].index === 0 && page_view.elements[0].backend_node_id === 1,
  "elements page max+1 and reply-local index");
page_native.data.connection_id = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
fails(compound.elements_page_projection(page_native, {
  actionable: true, max: 1, tab_id: 4, connection_id: page_connection
}), "elements_page_shape_invalid", "elements page connection receipt");
page_native.data.connection_id = page_connection;

fails(compound.apps_page({ ok: false, error: {
  code: "denied", message: "grant missing"
} }, "x", 0, 1), "denied", "typed CuReply failure");
fails(compound.single_node_id({ ok: false, error: null }),
  "acu_compound_reply_invalid", "untyped CuReply failure");

"compound.qjs PASS";
