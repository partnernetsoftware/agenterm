import * as compat from "skills/acu/lib/compat";

function require(condition, message) { if (!condition) { throw message; } }

function same_argv(actual, expected, label) {
  require(actual.length === expected.length, label + " length");
  for (let i = 0; i < expected.length; i = i + 1) {
    require(actual[i] === expected[i], label + " argv[" + i + "]");
  }
}

const path = "skills/acu/tests/compat-corpus.json";
require(fs_read_to_string(path) === 0, "compat corpus unreadable: " + tool_result());
const corpus = JSON.parse(tool_result());
require(corpus.schema === "agenterm.acu.compat-corpus.v1", "compat corpus schema");
require(corpus.dynamic_rows.length === 95, "dynamic corpus count");
require(corpus.positive_rows.length === 42, "positive corpus count");

const corpus_gap_ids = [];
for (let i = 0; i < corpus.dynamic_rows.length; i = i + 1) {
  corpus_gap_ids.push(corpus.dynamic_rows[i].gap_id);
}
require(compat.LEGACY_TODO_GAP_IDS.length === 2,
  "legacy TODO catalog count drifted from the reviewed archive");
for (let i = 0; i < compat.LEGACY_TODO_GAP_IDS.length; i = i + 1) {
  const gap_id = compat.LEGACY_TODO_GAP_IDS[i];
  require(corpus_gap_ids.includes(gap_id),
    "legacy TODO catalog id is absent from frozen corpus: " + gap_id);
  require(compat.LEGACY_TODO_GAP_IDS.indexOf(gap_id) === i,
    "legacy TODO catalog id is duplicated: " + gap_id);
}

let executable = 0;
let explicit_todo = 0;
for (let i = 0; i < corpus.positive_rows.length; i = i + 1) {
  const row = corpus.positive_rows[i];
  let mapped = null;
  try { mapped = compat.canonicalize(row.argv); }
  catch (error) { throw row.verb + " canonicalize: " + error; }
  if (mapped.kind === "exec") {
    require(row.expected.kind === "exec", row.verb + " expected kind");
    same_argv(mapped.argv, row.expected.argv, row.verb);
    executable = executable + 1;
  } else if (mapped.kind === "identity-kill") {
    require(row.expected.kind === "identity-kill", row.verb + " identity expected kind");
    require(mapped.command === row.expected.command, row.verb + " identity command");
    require(mapped.pid === row.expected.pid, row.verb + " identity pid");
    require(mapped.mode === row.expected.mode, row.verb + " identity mode");
    require(mapped.timeoutMs === row.expected.timeoutMs, row.verb + " identity timeout");
    same_argv(mapped.globals, row.expected.globals, row.verb + " identity globals");
    executable = executable + 1;
  } else {
    require(mapped.kind === "todo", row.verb + " must be exec or typed todo");
    require(mapped.gap_id === "acu.argv." + row.verb, row.verb + " stable gap id");
    explicit_todo = explicit_todo + 1;
  }
}
require(executable === 42, "compatibility corpus must execute all 42 positive rows");
require(explicit_todo === 0, "positive compatibility corpus must expose no TODO rows");

let dynamic_stays = 0;
let permanent_rejections = 0;
const resolved_exec = ["acu.dynamic.003", "acu.dynamic.021", "acu.dynamic.050", "acu.dynamic.051", "acu.dynamic.057",
  "acu.dynamic.066", "acu.dynamic.067", "acu.dynamic.075", "acu.dynamic.079", "acu.dynamic.082", "acu.dynamic.091", "acu.dynamic.092",
  "acu.dynamic.072", "acu.dynamic.076", "acu.dynamic.077", "acu.dynamic.084", "acu.dynamic.085", "acu.dynamic.086", "acu.dynamic.087", "acu.dynamic.096"];
const resolved_todo = [];
const resolved_usage = ["acu.dynamic.058", "acu.dynamic.083",
  "acu.dynamic.088", "acu.dynamic.094"];
const resolved_compound = {
  "acu.dynamic.005": "zoom-legacy-rect",
  "acu.dynamic.018": "job-resources-projection",
  "acu.dynamic.019": "job-generation",
  "acu.dynamic.020": "job-generation",
  "acu.dynamic.023": "job-generation",
  "acu.dynamic.073": "apps-page",
  "acu.dynamic.080": "focused-pid",
  "acu.dynamic.081": "observe-filters",
  "acu.dynamic.078.page-index-space": "elements-page",
  "acu.dynamic.093": "selector-dclick"
};
let resolved_checked = 0;
for (let i = 0; i < corpus.dynamic_rows.length; i = i + 1) {
  const row = corpus.dynamic_rows[i];
  let mapped = null;
  try { mapped = compat.canonicalize(row.argv); }
  catch (error) { throw row.gap_id + " canonicalize: " + error; }
  if (row.classification === "dynamic-stay") {
    require(mapped.kind === "todo", row.gap_id + " must remain a typed TODO");
    require(mapped.gap_id === row.gap_id, row.gap_id + " stable dynamic id");
    dynamic_stays = dynamic_stays + 1;
  } else if (row.classification === "permanent-scope-rejection") {
    require(mapped.kind === "usage",
      row.gap_id + " permanent rejection must remain local");
    if (row.gap_id === "acu.dynamic.055") {
      require(mapped.code === "retired", row.gap_id + " must retain its typed retirement code");
    }
    permanent_rejections = permanent_rejections + 1;
  } else if (row.classification === "resolved") {
    if (resolved_exec.includes(row.gap_id)) {
      require(mapped.kind === "exec", row.gap_id + " resolved exec");
      if (row.gap_id === "acu.dynamic.050") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "simulator-status", "2D62E897-1CDC-477B-AFB8-ECD4B202D944",
          "com.example.fixture"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.057") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "storage", "volumes"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.077") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "query", "--window", "Window#1", "--subrole", "AXDialog",
          "--depth", "12", "--max-nodes", "5000", "--max", "500"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.076") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "app-inspect", "--app", "Editor"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.072") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "app-facts", "--selector", "Editor", "--signing", "--verify",
          "--entitlements"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.075") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "browser-tabs"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.084") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "windows-watch", "--space", "1", "--duration-ms", "10000",
          "--interval-ms", "500", "--max-events", "500", "--max-windows", "2000"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.085") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "windows", "--space", "1"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.086") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "app-menu-inspect", "--app", "Editor"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.087") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "app-menu-invoke", "--app", "Editor", "--path", "File/Open"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.067") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "pty-wait", "job-1", "--contains", "text", "--cursor", "earliest",
          "--timeout-ms", "30000"], row.gap_id);
      }
    } else if (resolved_todo.includes(row.gap_id)) {
      require(mapped.kind === "todo", row.gap_id + " pending compound must be TODO");
      require(mapped.gap_id === row.gap_id, row.gap_id + " pending compound id");
    } else if (resolved_usage.includes(row.gap_id)) {
      require(mapped.kind === "usage", row.gap_id + " resolved local rejection");
    } else if (resolved_compound[row.gap_id] !== undefined) {
      require(mapped.kind === resolved_compound[row.gap_id],
        row.gap_id + " resolved compound kind=" + mapped.kind);
    } else { throw row.gap_id + " missing resolved disposition"; }
    resolved_checked = resolved_checked + 1;
  }
}
require(dynamic_stays === 2, "dynamic stay corpus count");
require(permanent_rejections === 2, "permanent rejection corpus count");
require(resolved_checked === 34, "resolved dynamic corpus count");

const point_job_resources = compat.canonicalize(["job", "resources", "job-1"]);
require(point_job_resources.kind === "job-generation",
  "point job resources must resolve generation through the typed compound");
require(point_job_resources.job_id === "job-1", "point job resources keeps job id");
require(point_job_resources.native_verb === "job-resources",
  "point job resources selects the native resource verb");
require(point_job_resources.tail.length === 0,
  "point job resources invents no sampling arguments");

const sampled_job_resources = compat.canonicalize([
  "job", "resources", "job-1", "--watch", "0.2", "--interval", "0.1",
  "--max-samples", "2"
]);
require(sampled_job_resources.kind === "job-generation",
  "bounded job resources resolves generation through the typed compound");
same_argv(sampled_job_resources.tail,
  ["--watch-ms", "200", "--interval-ms", "100", "--max-samples", "2"],
  "bounded job resources sampling tail");

const sampled_job_resources_exact = compat.canonicalize([
  "job", "resources", "job-1", "--generation", "7",
  "--watch", "0.2", "--interval", "0.1", "--max-samples", "2"
]);
require(sampled_job_resources_exact.kind === "exec",
  "bounded job resources with generation executes directly");
same_argv(sampled_job_resources_exact.argv,
  ["--target", "current", "--grant", "observe,actuate", "job-resources", "job-1", "7",
    "--watch-ms", "200", "--interval-ms", "100", "--max-samples", "2"],
  "bounded job resources direct argv");

const sampled_job_resources_defaults = compat.canonicalize([
  "job", "resources", "job-1", "--generation", "7", "--watch", "1"
]);
same_argv(sampled_job_resources_defaults.argv,
  ["--target", "current", "--grant", "observe,actuate", "job-resources", "job-1", "7",
    "--watch-ms", "1000", "--interval-ms", "1000", "--max-samples", "300"],
  "bounded job resources legacy defaults");

const sampled_job_resources_fraction = compat.canonicalize([
  "job", "resources", "job-1", "--generation", "7", "--watch", "1e-1",
  "--interval", ".1", "--max-samples", "1"
]);
same_argv(sampled_job_resources_fraction.argv,
  ["--target", "current", "--grant", "observe,actuate", "job-resources", "job-1", "7",
    "--watch-ms", "100", "--interval-ms", "100", "--max-samples", "1"],
  "bounded job resources Number-compatible seconds");

require(compat.canonicalize([
  "job", "resources", "job-1", "--watch", "0.09"
]).kind === "usage", "job resources rejects a legacy watch below 0.1 seconds");
require(compat.canonicalize([
  "job", "resources", "job-1", "--watch", "1", "--interval", "5.1"
]).kind === "usage", "job resources rejects a legacy interval above 5 seconds");
require(compat.canonicalize([
  "job", "resources", "job-1", "--watch", "1", "--max-samples", "1001"
]).kind === "usage", "job resources rejects a legacy sample ceiling above 1000");

const missing_job_resources_id = compat.canonicalize(["job", "resources"]);
require(missing_job_resources_id.kind === "usage",
  "job resources without an id is a local typed usage failure");

const projected_job_resources = compat.canonicalize([
  "job", "resources", "job-1", "--generation", "7", "--watch", "1",
  "--top", "3", "--max", "4"
]);
require(projected_job_resources.kind === "job-resources-projection",
  "legacy top/max uses the complete-membership projection");
require(projected_job_resources.top === 3 && projected_job_resources.max === 4
    && projected_job_resources.watch === true,
  "legacy resource projection preserves reviewed bounds");
same_argv(projected_job_resources.tail,
  ["--watch-ms", "1000", "--interval-ms", "1000", "--max-samples", "300",
    "--members-per-sample"], "legacy watch projection requests member rows");
require(compat.canonicalize([
  "job", "resources", "job-1", "--interval", "1"
]).kind === "usage", "job resource interval without watch is usage");
require(compat.canonicalize([
  "job", "resources", "job-1", "--top", "21"
]).kind === "usage", "job resource top above 20 is usage");
require(compat.canonicalize([
  "job", "resources", "job-1", "--max", "4097"
]).kind === "usage", "job resource max above 4096 is usage");

const simulator_udid = "00000000-0000-0000-0000-000000000000";
const simulator_boot = compat.canonicalize([
  "simulator", "boot", "--device", simulator_udid
]);
require(simulator_boot.kind === "exec", "legacy simulator boot executes");
same_argv(simulator_boot.argv, ["--target", "current", "--grant", "observe,actuate",
  "simulator-boot", simulator_udid, "--expect", "booted"], "legacy simulator boot");
const simulator_shutdown = compat.canonicalize([
  "simulator", "shutdown", "--device", simulator_udid
]);
require(simulator_shutdown.kind === "exec", "legacy simulator shutdown executes");
same_argv(simulator_shutdown.argv, ["--target", "current", "--grant", "observe,actuate",
  "simulator-shutdown", simulator_udid, "--expect", "shutdown"],
  "legacy simulator shutdown");

const irreducible_wait = compat.canonicalize([
  "pty", "wait", "job-1", "text[0-9]+", "--provider", "native"
]);
require(irreducible_wait.kind === "exec", "general regex wait executes natively");
same_argv(irreducible_wait.argv, ["--target", "current", "--grant", "observe,actuate",
  "pty-wait", "job-1", "--regex", "text[0-9]+", "--cursor", "earliest",
  "--timeout-ms", "30000"], "general regex wait");

const native_pty_list = compat.canonicalize(["pty", "list", "--provider", "native"]);
require(native_pty_list.kind === "exec", "native PTY inventory executes");
same_argv(native_pty_list.argv, ["--target", "current", "--grant", "observe,actuate",
  "pty-list"], "native PTY inventory");

const exact_profile_tabs = compat.canonicalize([
  "browser", "tabs", "--profile", "abcdef12", "--match", "guide"
]);
require(exact_profile_tabs.kind === "exec", "exact MV3 profile prefix executes");
same_argv(exact_profile_tabs.argv, ["--target", "current", "--grant", "observe,actuate",
  "browser-tabs", "--profile-instance-id", "abcdef12", "--match", "guide"],
  "exact MV3 profile tabs");

const human_profile_tabs = compat.canonicalize([
  "browser", "tabs", "--profile", "Default"
]);
require(human_profile_tabs.kind === "todo", "human browser profile remains explicit TODO");
require(human_profile_tabs.gap_id === "acu.dynamic.075.profile-name-binding",
  "human browser profile keeps its stable sub-gap id");

const app_profile_tabs = compat.canonicalize([
  "browser", "tabs", "--app", "Brave Browser"
]);
require(app_profile_tabs.kind === "todo", "browser application alias remains explicit TODO");
require(app_profile_tabs.gap_id === "acu.dynamic.075.profile-name-binding",
  "browser application alias keeps its stable sub-gap id");

const tree_value_bound = compat.canonicalize([
  "tree", "Window#1", "--max-value-bytes", "0"
]);
require(tree_value_bound.kind === "exec", "tree value bound maps to native tree");
require(JSON.stringify(tree_value_bound.argv)
    === JSON.stringify(["--target", "current", "--grant", "observe,actuate",
      "tree", "--window", "Window#1", "--max-value-bytes", "0"]),
  "tree value bound keeps exact handle and byte budget:" + JSON.stringify(tree_value_bound));

const space_with_unmapped_filter = compat.canonicalize([
  "windows", "watch", "--space", "1", "--type", "appeared"
]);
require(space_with_unmapped_filter.kind === "exec", "window watch type filter executes");
same_argv(space_with_unmapped_filter.argv,
  ["--target", "current", "--grant", "observe,actuate", "windows-watch",
    "--space", "1", "--type", "appeared", "--duration-ms", "10000",
    "--interval-ms", "500", "--max-events", "500", "--max-windows", "2000"],
  "window watch archived defaults");

const bounded_window_watch = compat.canonicalize([
  "windows", "watch", "--focused", "false", "--onscreen", "true",
  "--occluded", "false", "--all", "--duration", "300", "--interval", "0.05",
  "--max-events", "10000", "--max", "5000"
]);
require(bounded_window_watch.kind === "exec", "bounded window watch executes");
same_argv(bounded_window_watch.argv,
  ["--target", "current", "--grant", "observe,actuate", "windows-watch",
    "--focused", "false", "--onscreen", "true", "--occluded", "false", "--all",
    "--duration-ms", "300000", "--interval-ms", "50", "--max-events", "10000",
    "--max-windows", "5000"], "bounded window watch");

const invalid_window_watch_type = compat.canonicalize([
  "windows", "watch", "--type", "appeared,bogus"
]);
require(invalid_window_watch_type.kind === "exec",
  "native parser owns invalid window watch type");

const invalid_window_watch_offset = compat.canonicalize([
  "windows", "watch", "--offset", "1"
]);
require(invalid_window_watch_offset.kind === "usage",
  "legacy window watch offset remains local usage");

function todo_case(argv, gap_id, label) {
  const mapped = compat.canonicalize(argv);
  require(mapped.kind === "todo", label + " must be a typed TODO");
  require(mapped.gap_id === gap_id, label + " gap=" + mapped.gap_id);
}

todo_case(["drag", "10", "20", "30", "40", "--to", "Window#1"],
  "acu.dynamic.004", "legacy drag");
const legacy_zoom = compat.canonicalize([
  "zoom", "Window#1", "--x1", "1", "--y1", "2", "--x2", "3", "--y2", "4",
  "--out", "zoom.png"
]);
require(legacy_zoom.kind === "zoom-legacy-rect", "legacy zoom maps through bounded geometry");
require(legacy_zoom.window === "Window#1" && legacy_zoom.x1 === 1 && legacy_zoom.y1 === 2
    && legacy_zoom.x2 === 3 && legacy_zoom.y2 === 4 && legacy_zoom.out === "zoom.png",
  "legacy zoom keeps exact corners, handle and explicit output");
require(compat.canonicalize([
  "zoom", "Window#1", "--x1", "1", "--y1", "2", "--x2", "3", "--y2", "4"
]).kind === "usage", "legacy zoom refuses a hidden default output path");
const retired_device_claim = compat.canonicalize(["device", "claim", "/dev/cu.fixture"]);
require(retired_device_claim.kind === "usage" && retired_device_claim.code === "retired"
    && retired_device_claim.command === "device"
    && retired_device_claim.gap_id === undefined,
  "legacy raw-path device claim must be a local typed retirement");
for (const operation of ["read", "write", "renew", "release"]) {
  const tail = operation === "write" ? ["--lease", "secret", "--hex", "00"]
    : ["--lease", "secret"];
  const retired = compat.canonicalize(["device", operation, "legacy-lease"].concat(tail));
  require(retired.kind === "usage" && retired.code === "retired"
      && retired.command === "device" && retired.gap_id === undefined,
    "legacy implicit device " + operation + " must be a local typed retirement");
}
const native_device_claim = compat.canonicalize([
  "device", "claim",
  "agt-device-v1-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
]);
require(native_device_claim.kind === "exec",
  "opaque native device claim alias must remain reachable");
require(compat.canonicalize([
  "device", "read", "00000000-0000-4000-8000-000000000000",
  "--generation", "1", "--lease",
  "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
]).kind === "exec", "generation-bound native device read must remain reachable");
const storage_volumes = compat.canonicalize(["storage", "volumes", "--max", "5"]);
require(storage_volumes.kind === "exec", "native storage volumes alias must pass through");
same_argv(storage_volumes.argv, ["--target", "current", "--grant", "observe,actuate",
  "storage", "volumes", "--max", "5"], "native storage volumes alias");
require(compat.canonicalize(["storage", "mount", "disk-1"]).kind === "usage",
  "legacy storage mount was never an MCU storage subcommand");
require(compat.canonicalize(["storage", "unmount", "disk-1"]).kind === "usage",
  "legacy storage unmount was never an MCU storage subcommand");
require(compat.canonicalize(["storage", "eject", "disk-1"]).kind === "usage",
  "legacy storage eject was never an MCU storage subcommand");
const bridge_setup = compat.canonicalize(["browser", "bridge", "setup"]);
require(bridge_setup.kind === "exec", "legacy browser bridge setup must execute");
same_argv(bridge_setup.argv, ["--target", "current", "--grant", "observe,actuate",
  "browser-bridge-setup", "--browser", "brave-browser", "--browser", "brave-origin",
  "--browser", "chrome"], "legacy browser bridge setup default scope");
const bridge_setup_chrome = compat.canonicalize([
  "browser", "bridge", "setup", "--app", "Google Chrome"
]);
same_argv(bridge_setup_chrome.argv, ["--target", "current", "--grant", "observe,actuate",
  "browser-bridge-setup", "--browser", "chrome"],
  "legacy browser bridge setup chrome scope");
require(compat.canonicalize([
  "browser", "bridge", "setup", "--app", "Brave Origin"
]).argv.length === bridge_setup.argv.length,
  "legacy Brave setup spellings must preserve the archived three-target scope");
require(compat.canonicalize([
  "browser", "bridge", "setup", "--app", "Chromium"
]).kind === "usage", "legacy setup unknown application binding must fail closed");
require(compat.canonicalize([
  "browser", "bridge", "setup", "--profile", "Default"
]).kind === "usage", "legacy setup ignored profile flags must fail closed");
const bridge_status = compat.canonicalize(["browser", "bridge", "status"]);
require(bridge_status.kind === "bridge-status" && bridge_status.profile === null,
  "legacy browser bridge status must use exact connection selection");
const bridge_status_profile = compat.canonicalize([
  "browser", "bridge", "status", "--profile", "abcdef12"
]);
require(bridge_status_profile.kind === "bridge-status"
    && bridge_status_profile.profile === "abcdef12",
  "legacy browser bridge status must retain a profile identity prefix");
todo_case(["browser", "bridge", "status", "--profile", "Default"],
  "acu.dynamic.075.profile-name-binding", "human browser bridge profile");
const browser_nav_match = compat.canonicalize([
  "browser", "nav", "https://example.test", "--port", "9333", "--match", "Guide"
]);
require(browser_nav_match.kind === "exec", "explicit matched CDP navigation must execute");
same_argv(browser_nav_match.argv, ["--target", "current", "--grant", "observe,actuate",
  "page-nav", "--port", "9333", "--match", "Guide", "--url", "https://example.test"],
  "explicit matched CDP navigation");
const browser_nav_unique = compat.canonicalize([
  "browser", "nav", "https://example.test", "--pid", "42"
]);
require(browser_nav_unique.kind === "cdp-nav"
    && browser_nav_unique.transport[0] === "--pid"
    && browser_nav_unique.transport[1] === "42",
  "explicit unmatched CDP navigation must resolve one page target");
const browser_nav_port_precedence = compat.canonicalize([
  "browser", "nav", "https://example.test", "--port", "9333", "--pid", "42",
  "--match", "Guide", "--profile", "Default", "--allow-foreground"
]);
require(browser_nav_port_precedence.kind === "exec"
    && browser_nav_port_precedence.argv.includes("--port")
    && !browser_nav_port_precedence.argv.includes("--pid")
    && !browser_nav_port_precedence.argv.includes("--profile")
    && !browser_nav_port_precedence.argv.includes("--allow-foreground"),
  "archived explicit CDP transport must take precedence over fallback selectors");
const browser_bridge_nav = compat.canonicalize([
  "--request-id", "nav-1", "--session", "session-1", "--session-lease", "lease-1",
  "browser", "nav", "https://example.test", "--tab-id", "7",
  "--profile", "0123abcd"
]);
require(browser_bridge_nav.kind === "bridge-nav"
    && browser_bridge_nav.url === "https://example.test"
    && browser_bridge_nav.tab_id === 7
    && browser_bridge_nav.profile === "0123abcd"
    && browser_bridge_nav.match === null,
  "browser bridge navigation must resolve one exact MV3 tab");
same_argv(browser_bridge_nav.globals, [
  "--target", "current", "--grant", "observe,actuate", "--request-id", "nav-1",
  "--session", "session-1", "--session-lease", "lease-1"
], "browser bridge navigation globals");
const browser_bridge_nav_match = compat.canonicalize([
  "browser", "nav", "https://example.test/matched", "--match", "Guide"
]);
require(browser_bridge_nav_match.kind === "bridge-nav"
    && browser_bridge_nav_match.match === "Guide"
