import * as compat from "skills/acu/lib/compat";

function require(condition, message) { if (!condition) { throw message; } }

function same_argv(actual, expected, label) {
  require(actual.length === expected.length, label + " length");
  for (let i = 0; i < expected.length; i = i + 1) {
    require(actual[i] === expected[i], label + " argv[" + i + "]");
  }
}

const path = "skills/acu/tests/compat-corpus.json";
require(fs_read_to_string(path) === 0, "compat corpus unreadable: " + tool_result());
const corpus = JSON.parse(tool_result());
require(corpus.schema === "agenterm.acu.compat-corpus.v1", "compat corpus schema");
require(corpus.dynamic_rows.length === 95, "dynamic corpus count");
require(corpus.positive_rows.length === 42, "positive corpus count");

let executable = 0;
let explicit_todo = 0;
for (let i = 0; i < corpus.positive_rows.length; i = i + 1) {
  const row = corpus.positive_rows[i];
  const mapped = compat.canonicalize(row.argv);
  if (mapped.kind === "exec") {
    require(row.expected.kind === "exec", row.verb + " expected kind");
    same_argv(mapped.argv, row.expected.argv, row.verb);
    executable = executable + 1;
  } else if (mapped.kind === "identity-kill") {
    require(row.expected.kind === "identity-kill", row.verb + " identity expected kind");
    require(mapped.command === row.expected.command, row.verb + " identity command");
    require(mapped.pid === row.expected.pid, row.verb + " identity pid");
    require(mapped.mode === row.expected.mode, row.verb + " identity mode");
    require(mapped.timeoutMs === row.expected.timeoutMs, row.verb + " identity timeout");
    same_argv(mapped.globals, row.expected.globals, row.verb + " identity globals");
    executable = executable + 1;
  } else {
    require(mapped.kind === "todo", row.verb + " must be exec or typed todo");
    require(mapped.gap_id === "acu.argv." + row.verb, row.verb + " stable gap id");
    explicit_todo = explicit_todo + 1;
  }
}
require(executable === 42, "compatibility corpus must execute all 42 positive rows");
require(explicit_todo === 0, "positive compatibility corpus must expose no TODO rows");

"compat-corpus.qjs PASS 42 exec / 0 typed TODO / 95 dynamic frozen";
