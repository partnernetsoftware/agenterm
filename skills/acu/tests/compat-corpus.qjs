import * as compat from "skills/acu/lib/compat";

function require(condition, message) { if (!condition) { throw message; } }

function same_argv(actual, expected, label) {
  require(actual.length === expected.length, label + " length");
  for (let i = 0; i < expected.length; i = i + 1) {
    require(actual[i] === expected[i], label + " argv[" + i + "]");
  }
}

const path = "skills/acu/tests/compat-corpus.json";
require(fs_read_to_string(path) === 0, "compat corpus unreadable: " + tool_result());
const corpus = JSON.parse(tool_result());
require(corpus.schema === "agenterm.acu.compat-corpus.v1", "compat corpus schema");
require(corpus.dynamic_rows.length === 95, "dynamic corpus count");
require(corpus.positive_rows.length === 42, "positive corpus count");

let executable = 0;
let explicit_todo = 0;
for (let i = 0; i < corpus.positive_rows.length; i = i + 1) {
  const row = corpus.positive_rows[i];
  let mapped = null;
  try { mapped = compat.canonicalize(row.argv); }
  catch (error) { throw row.verb + " canonicalize: " + error; }
  if (mapped.kind === "exec") {
    require(row.expected.kind === "exec", row.verb + " expected kind");
    same_argv(mapped.argv, row.expected.argv, row.verb);
    executable = executable + 1;
  } else if (mapped.kind === "identity-kill") {
    require(row.expected.kind === "identity-kill", row.verb + " identity expected kind");
    require(mapped.command === row.expected.command, row.verb + " identity command");
    require(mapped.pid === row.expected.pid, row.verb + " identity pid");
    require(mapped.mode === row.expected.mode, row.verb + " identity mode");
    require(mapped.timeoutMs === row.expected.timeoutMs, row.verb + " identity timeout");
    same_argv(mapped.globals, row.expected.globals, row.verb + " identity globals");
    executable = executable + 1;
  } else {
    require(mapped.kind === "todo", row.verb + " must be exec or typed todo");
    require(mapped.gap_id === "acu.argv." + row.verb, row.verb + " stable gap id");
    explicit_todo = explicit_todo + 1;
  }
}
require(executable === 42, "compatibility corpus must execute all 42 positive rows");
require(explicit_todo === 0, "positive compatibility corpus must expose no TODO rows");

let dynamic_stays = 0;
let permanent_rejections = 0;
const resolved_exec = ["acu.dynamic.003", "acu.dynamic.021", "acu.dynamic.050", "acu.dynamic.051",
  "acu.dynamic.066", "acu.dynamic.067", "acu.dynamic.079", "acu.dynamic.082", "acu.dynamic.091", "acu.dynamic.092",
  "acu.dynamic.084", "acu.dynamic.096"];
const resolved_todo = [];
const resolved_usage = ["acu.dynamic.058", "acu.dynamic.078", "acu.dynamic.083",
  "acu.dynamic.088", "acu.dynamic.094"];
const resolved_compound = {
  "acu.dynamic.019": "job-generation",
  "acu.dynamic.020": "job-generation",
  "acu.dynamic.023": "job-generation",
  "acu.dynamic.073": "apps-page",
  "acu.dynamic.080": "focused-pid",
  "acu.dynamic.081": "observe-roles",
  "acu.dynamic.085": "windows-space-page",
  "acu.dynamic.093": "selector-dclick"
};
let resolved_checked = 0;
for (let i = 0; i < corpus.dynamic_rows.length; i = i + 1) {
  const row = corpus.dynamic_rows[i];
  let mapped = null;
  try { mapped = compat.canonicalize(row.argv); }
  catch (error) { throw row.gap_id + " canonicalize: " + error; }
  if (row.classification === "dynamic-stay") {
    require(mapped.kind === "todo", row.gap_id + " must remain a typed TODO");
    require(mapped.gap_id === row.gap_id, row.gap_id + " stable dynamic id");
    dynamic_stays = dynamic_stays + 1;
  } else if (row.classification === "permanent-scope-rejection") {
    require(mapped.kind === "usage",
      row.gap_id + " permanent rejection must remain local");
    permanent_rejections = permanent_rejections + 1;
  } else if (row.classification === "resolved") {
    if (resolved_exec.includes(row.gap_id)) {
      require(mapped.kind === "exec", row.gap_id + " resolved exec");
      if (row.gap_id === "acu.dynamic.050") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "simulator-status", "2D62E897-1CDC-477B-AFB8-ECD4B202D944",
          "com.example.fixture"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.084") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "windows-watch", "--space", "1"], row.gap_id);
      } else if (row.gap_id === "acu.dynamic.067") {
        same_argv(mapped.argv, ["--target", "current", "--grant", "observe,actuate",
          "pty-wait", "job-1", "--contains", "text", "--cursor", "earliest",
          "--timeout-ms", "30000"], row.gap_id);
      }
    } else if (resolved_todo.includes(row.gap_id)) {
      require(mapped.kind === "todo", row.gap_id + " pending compound must be TODO");
      require(mapped.gap_id === row.gap_id, row.gap_id + " pending compound id");
    } else if (resolved_usage.includes(row.gap_id)) {
      require(mapped.kind === "usage", row.gap_id + " resolved local rejection");
    } else if (resolved_compound[row.gap_id] !== undefined) {
      require(mapped.kind === resolved_compound[row.gap_id],
        row.gap_id + " resolved compound kind=" + mapped.kind);
    } else { throw row.gap_id + " missing resolved disposition"; }
    resolved_checked = resolved_checked + 1;
  }
}
require(dynamic_stays === 8, "dynamic stay corpus count");
require(permanent_rejections === 2, "permanent rejection corpus count");
require(resolved_checked === 25, "resolved dynamic corpus count");

const irreducible_wait = compat.canonicalize([
  "pty", "wait", "job-1", "text[0-9]+", "--provider", "native"
]);
require(irreducible_wait.kind === "todo", "general regex wait remains TODO");
require(irreducible_wait.gap_id === "acu.dynamic.067",
  "general regex wait keeps stable dynamic id");

const native_pty_list = compat.canonicalize(["pty", "list", "--provider", "native"]);
require(native_pty_list.kind === "exec", "native PTY inventory executes");
same_argv(native_pty_list.argv, ["--target", "current", "--grant", "observe,actuate",
  "pty-list"], "native PTY inventory");

const tree_value_bound = compat.canonicalize([
  "tree", "Window#1", "--max-value-bytes", "0"
]);
require(tree_value_bound.kind === "todo", "unmapped tree value bound remains TODO");
require(tree_value_bound.gap_id === "acu.dynamic.078",
  "unmapped tree value bound keeps stable dynamic id");

const space_with_unmapped_filter = compat.canonicalize([
  "windows", "watch", "--space", "1", "--type", "appeared"
]);
require(space_with_unmapped_filter.kind === "todo", "unmapped watch filter remains TODO");
require(space_with_unmapped_filter.gap_id === "acu.dynamic.084",
  "unmapped watch filter keeps stable dynamic id");

"compat-corpus.qjs PASS 42 positive exec / 25 resolved dispositions (12 exec + 8 compound + 5 usage) / 8 dynamic TODO / 2 permanent rejections / 95 frozen";
