// Bun-free legacy ACU entry. Native mechanisms, authorization, validation,
// effects and receipts remain owned by agenterm-cu through `agenterm:acu`.
import * as acu from "agenterm:acu";
import * as argv_lib from "agenterm:acu/argv";
import * as compat from "agenterm:acu/compat";
import * as compound from "agenterm:acu/compound";

function usage(command, message, code) {
  return {
    ok: false,
    target: "",
    command: command,
    data: null,
    error: { code: code === undefined ? "usage" : code, message: message }
  };
}

function todo(gap_id, verb, message) {
  return {
    ok: false,
    target: "",
    command: verb,
    data: null,
    alert: "ACU_CAPABILITY_TODO",
    error: {
      code: "acu_todo",
      gap_id: gap_id,
      message: message,
      todo: {
        id: gap_id,
        status: "open",
        owner: "agenterm-cu",
        reference: "archived MCU source (read-only; never execute as fallback)"
      }
    }
  };
}

function exit_code(reply) {
  if (reply.ok === true) { return 0; }
  if (reply.error !== null && reply.error !== undefined
      && (reply.error.code === "usage" || reply.error.code === "retired"
          || reply.error.code === "acu_todo")) {
    return 2;
  }
  return 1;
}

function append_argv(out, values) {
  for (let i = 0; i < values.length; i = i + 1) { out.push(values[i]); }
}

function acu_error(command, code, message) {
  return {
    ok: false,
    target: "",
    command: command,
    data: null,
    error: { code: code, message: message }
  };
}

function execute_identity_kill(request) {
  const observe_argv = [];
  append_argv(observe_argv, request.globals);
  append_argv(observe_argv, ["process-state", "--pid", request.pid]);
  const observed = acu.argv(observe_argv);
  if (observed.ok !== true || observed.data === null || observed.data === undefined
      || observed.data.state !== "live"
      || typeof observed.data.start_identity !== "string"
      || observed.data.start_identity.length === 0) {
    return acu_error("kill", "process_not_live",
      "target process is not live with a verified start identity");
  }
  const effect_argv = [];
  append_argv(effect_argv, request.globals);
  append_argv(effect_argv, [
    "process-kill", "--pid", request.pid,
    "--start-identity", observed.data.start_identity,
    "--mode", request.mode, "--timeout-ms", request.timeoutMs,
    "--expect", "exited"
  ]);
  return acu.argv(effect_argv);
}

function prefixed(globals, command) {
  const out = [];
  append_argv(out, globals);
  append_argv(out, command);
  return out;
}

function projected_reply(command, reply, projection) {
  if (projection.ok !== true) {
    return acu_error(command, projection.code, projection.message);
  }
  reply.data = projection.value;
  return reply;
}

function execute_compound(request) {
  if (request.kind === "job-generation") {
    const status = acu.argv(prefixed(request.globals, ["job-status", request.job_id]));
    const generation = compound.job_generation(status, request.job_id);
    if (!generation.ok) { return acu_error(request.command, generation.code, generation.message); }
    const operation = [request.native_verb, request.job_id, "" + generation.value];
    append_argv(operation, request.tail);
    return acu.argv(prefixed(request.globals, operation));
  }
  if (request.kind === "job-resources-projection") {
    let generation = request.generation;
    if (generation === null) {
      const status = acu.argv(prefixed(request.globals, ["job-status", request.job_id]));
      const selected = compound.job_generation(status, request.job_id);
      if (!selected.ok) { return acu_error(request.command, selected.code, selected.message); }
      generation = "" + selected.value;
    }
    const operation = [request.native_verb, request.job_id, generation];
    append_argv(operation, request.tail);
    const reply = acu.argv(prefixed(request.globals, operation));
    return projected_reply(request.command, reply,
      compound.job_resources_projection(reply, request.top, request.max, request.watch));
  }
  if (request.kind === "apps-page") {
    const reply = acu.argv(prefixed(request.globals, request.argv));
    return projected_reply(request.command, reply,
      compound.apps_page(reply, request.match, request.offset, request.max));
  }
  if (request.kind === "focused-pid") {
    const windows = acu.argv(prefixed(request.globals,
      ["windows", "--pid", "" + request.pid, "--max", "2"]));
    const selected = compound.single_window(windows, request.pid);
    if (!selected.ok) { return acu_error(request.command, selected.code, selected.message); }
    return acu.argv(prefixed(request.globals,
      ["focused", "--window", "" + selected.value.handle]));
  }
  if (request.kind === "observe-roles") {
    const reply = acu.argv(prefixed(request.globals, request.argv));
    return projected_reply(request.command, reply, compound.observe_roles(reply, request.roles));
  }
  if (request.kind === "observe-filters") {
    const reply = acu.argv(prefixed(request.globals, request.argv));
    return projected_reply(request.command, reply,
      compound.observe_filters(reply, request.filters));
  }
  if (request.kind === "selector-dclick") {
    const query = acu.argv(prefixed(request.globals, [
      "query", "--window", request.window, "--selector", request.selector, "--max", "2"
    ]));
    const selected = compound.single_node_id(query);
    if (!selected.ok) { return acu_error(request.command, selected.code, selected.message); }
    return acu.argv(prefixed(request.globals, [
      "click", "--window", request.window, "--node", selected.value, "--clicks", "2"
    ]));
  }
  return acu_error(request.command, "acu_compound_kind_unknown",
    "compatibility plan names an unknown compound operation");
}

const input = argv_lib.from_host();
if (input.length === 1 && input[0] === "--retirement-report") {
  print(JSON.stringify({
    schema: 2,
    adapter: "acu.qjs",
    mcu_runtime_archived: true,
    runtime_fallback: false,
    mcu_required: false,
    dynamic_todo_queue: "prd/PRD_02_28_agenterm_cu.md"
  }));
  return 0;
}

let canonical = null;
try {
  canonical = compat.canonicalize(input);
} catch (error) {
  print(JSON.stringify(usage("acu.qjs", "" + error)));
  return 2;
}
if (canonical.kind === "usage") {
  print(JSON.stringify(usage(canonical.command, canonical.message, canonical.code)));
  return 2;
}
if (canonical.kind === "todo") {
  print(JSON.stringify(todo(canonical.gap_id, canonical.command, canonical.message)));
  return 2;
}
let reply = canonical.kind === "identity-kill"
  ? execute_identity_kill(canonical)
  : canonical.kind === "exec" ? acu.argv(canonical.argv) : execute_compound(canonical);
if (reply.ok !== true && reply.error !== null && reply.error !== undefined
    && reply.error.code === "usage" && input.length > 0
    && compat.LEGACY_TOP_LEVEL.includes(input[0])
    && reply.error.message.startsWith("unknown command")) {
  reply = todo("acu.argv." + input[0], input[0], "legacy command has no native ACU mapping yet");
}
print(JSON.stringify(reply));
return exit_code(reply);
