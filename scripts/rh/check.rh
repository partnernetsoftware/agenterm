// Repository quality, qualification, and receipt orchestration.
//
// Args:
//   REPO WORKER [--quick] [--release] [--skip-smoke] [--include-stress]
//     [--internal-qualification-dry-run] [--receipt PATH] [--target TARGET]

import "scripts/rh/lib/qualification" as qualification;
import "scripts/rh/lib/build_identity" as build_identity;

// Native pack transpile needs local wrappers so JSON timing/context bindings
// stay typed at qualification module boundaries.
fn copy_string_list(values) {
    let count = 0 + values.len;
    require(count > 0, "check_copy_string_list_empty");
    let copied = ["" + values[0]];
    let index = 1;
    while index < count {
        copied.push("" + values[index]);
        index += 1;
    }
    copied
}

fn wrap_timing_new(
    repo,
    manifest_path,
    output_path,
    lane,
    profile,
    workload,
    gate_ids
) {
    // stringify is native Json evidence; bare `.keys()` falls through to HostEval.
    let _workload_proof = rh::json::stringify(workload);
    let gate_id_list = copy_string_list(gate_ids);
    let timing = qualification::new_timing(
        repo,
        manifest_path,
        output_path,
        lane,
        profile,
        workload,
        gate_id_list
    );
    let _gates = timing.gates;
    timing
}

fn wrap_timing_set_gate(
    timing,
    gate_id,
    status,
    duration_ms,
    exit_code,
    timed_out
) {
    let _gates = timing.gates;
    qualification::timing_set_gate(
        timing,
        gate_id,
        status,
        duration_ms,
        exit_code,
        timed_out
    )
}

fn wrap_timing_finish(timing, status) {
    let _gates = timing.gates;
    qualification::timing_finish(timing, status)
}

fn wrap_timing_fail_stage(timing, stage_id) {
    let _gates = timing.gates;
    qualification::timing_fail_stage(timing, stage_id)
}

fn wrap_add_process_observation(
    context,
    process_samples,
    observed_powershell,
    terminal_compatibility
) {
    // Json-type evidence only — `context` has no `timing` key (see
    // qualification::q_new_context), and the AOT lane fails closed on
    // absent paths, so probing one here would rh_fail every gate.
    let _manifest = context.manifest;
    qualification::add_process_observation(
        context,
        process_samples,
        observed_powershell,
        terminal_compatibility
    )
}

fn wrap_add_result(context, id, status, duration_ms, output) {
    let _manifest = context.manifest;
    let gate_key = "" + id;
    let status_text = "" + status;
    let evidence = [];
    let line_index = 0;
    while line_index < output.len {
        let line = "" + output[line_index];
        line.trim();
        if line.starts_with("EVIDENCE ") {
            let evidence_id = line.sub_string(9);
            evidence.push(evidence_id);
        }
        line_index += 1;
    }
    context.results[gate_key] = #{
        id: gate_key,
        status: status_text,
        duration_ms: duration_ms,
        evidence: evidence
    };
    context
}

fn wrap_new_context(manifest_path, release, stress_included) {
    let context = qualification::q_new_context(
        manifest_path,
        release,
        stress_included
    );
    let _manifest = context.manifest;
    context
}

fn wrap_write_receipt(context, repo, receipt_path) {
    let _manifest = context.manifest;
    qualification::write_receipt(context, repo, receipt_path)
}

fn map_context(value) {
    let context = value.context;
    let _manifest = context.manifest;
    context
}

fn map_timing(value) {
    let timing = value.timing;
    let _gates = timing.gates;
    timing
}

fn map_sequence(value) {
    0 + value.sequence
}

fn map_environment(value) {
    let environment = value.environment;
    // stringify is native Json evidence; bare `.keys()` falls through to HostEval.
    let _environment_proof = rh::json::stringify(environment);
    environment
}

fn pass_int(value) {
    value
}

fn arg_value(index) {
    args[index]
}

fn absolute_display(path) {
    std::path::absolute(path).display
}

fn dev_environment(repo_value) {
    build_identity::environment(
        build_identity::facts(repo_value, "dev")
    )
}

fn require(condition, message) {
    if condition == 0 {
        throw message;
    } else {
        0;
    }
}

fn joined_text(values, separator) {
    let result = "";
    for index in 0..values.len {
        if index > 0 {
            result += separator;
        }
        result += "" + values[index];
    }
    result
}

fn stderr_powershell_notice(observed) {
    "\nrepository_automation_spawned_powershell:" +
        joined_text(observed, ",")
}

fn stderr_timeout_notice(timeout_ms) {
    "\ngate_deadline_exceeded:" + timeout_ms
}

fn compose_execute_stderr(
    stderr,
    powershell_violation,
    observed_powershell,
    timed_out,
    timeout_ms
) {
    let stderr_text = "" + stderr;
    if powershell_violation != 0 && timed_out != 0 {
        return stderr_text +
            stderr_powershell_notice(observed_powershell) +
            stderr_timeout_notice(timeout_ms);
    }
    if powershell_violation != 0 {
        return stderr_text +
            stderr_powershell_notice(observed_powershell);
    }
    if timed_out != 0 {
        return stderr_text + stderr_timeout_notice(timeout_ms);
    }
    stderr_text
}

fn empty_task_extra() {
    let items = [];
    items
}

fn one_task_extra(value) {
    let items = ["" + value];
    items
}

fn two_task_extra(first, second) {
    let items = ["" + first];
    items.push("" + second);
    items
}

fn three_task_extra(first, second, third) {
    let items = ["" + first];
    items.push("" + second);
    items.push("" + third);
    items
}

fn five_task_extra(first, second, third, fourth, fifth) {
    let items = ["" + first];
    items.push("" + second);
    items.push("" + third);
    items.push("" + fourth);
    items.push("" + fifth);
    items
}

fn smoke_timeout_ms(id) {
    if id == "script-smoke" {
        // Candidate 31954795648: the Windows quality gate killed
        // `rh task run script-smoke` at 620s with no output. The suite
        // now waits up to 180s per HTTP fixture pack compile (two
        // fixtures) plus the rest of the journey.
        return 1200000;
    }
    if id == "remote-ui-smoke"
            || id == "cli-smoke"
            || id == "fleet-smoke" {
        return 600000;
    }
    300000
}

fn evidence_list_spec(worker_program, suite_path) {
    let suite = "" + suite_path;
    // Declaration discovery is static and data-only. Compiling every large
    // smoke pack merely to enter its --list-evidence branch made the ordinary
    // Windows lane spend minutes before rustfmt and could poison later gates
    // when an AOT timeout recorded the first host error.
    let arguments = ["rh", "evidence-list"];
    arguments.push(suite);
    let _arg_count = 0 + arguments.len;
    spec(worker_program, arguments, 10000, empty_environment(), 0)
}

fn cmd_build_bat_spec(repo, profile, timeout_ms, environment) {
    let repo_path = "" + repo;
    let bat_path = std::path::join(repo_path, "build.bat").display;
    let arguments = ["/d", "/c"];
    arguments.push("" + bat_path);
    let profile_text = "" + profile;
    if profile_text != "" {
        arguments.push(profile_text);
    }
    let _arg_count = 0 + arguments.len;
    spec("cmd.exe", arguments, timeout_ms, environment, 0)
}

fn task_check_spec(worker, manifest) {
    let worker_path = "" + worker;
    let manifest_path = "" + manifest;
    let arguments = ["rh", "task", "check"];
    arguments.push("--manifest");
    arguments.push(manifest_path);
    let _arg_count = 0 + arguments.len;
    // Same cold-AOT allowance as evidence_list_spec above.
    spec(worker_path, arguments, 300000, empty_environment(), 0)
}

fn cargo_fmt_all_check_spec(environment) {
    let arguments = ["fmt", "--all", "--", "--check"];
    spec("cargo", arguments, 60000, environment, 0)
}

fn cargo_fmt_check_spec(environment) {
    let arguments = ["fmt", "--", "--check"];
    spec("cargo", arguments, 60000, environment, 0)
}

fn cargo_preflight_selftest_spec(environment) {
    let arguments = [
        "test", "--quiet", "--locked",
        "--test", "rhai_migration",
        "preflight_task_is_fail_closed_and_writes_reports_for_real_git_fixtures",
        "--", "--nocapture"
    ];
    // Building the rhai_migration integration test links the whole agenterm
    // crate — minutes on a cold CI target, not seconds. The old 60s wall
    // was the windows quality gate's standing first failure
    // (timing.json: preflight-selftest timed_out after ~70s with every
    // later gate not_run).
    spec("cargo", arguments, 600000, environment, 0)
}

fn cargo_clippy_all_spec(environment) {
    let arguments = [
        "clippy", "--quiet", "--locked", "--all-targets",
        "--all-features", "--", "-D", "warnings"
    ];
    // 60s only fit a fully warm cache; any crate edit forces a workspace
    // re-lint that runs minutes on CI runners.
    spec("cargo", arguments, 600000, environment, 0)
}

fn cargo_unit_primary_spec(environment) {
    let arguments = [
        // `-p agenterm-ui-core` is load-bearing: a
        // dependency crate's own `#[cfg(test)]` modules are NOT built or run
        // by `cargo test -p agenterm`. ui-core holds the hand-written
        // SSE2/AVX2/SSSE3/NEON pixel kernels behind `unsafe fn(*mut u32, ...)`
        // plus the retained-frame and damage state machines, and its 35 tests
        // -- including the bit-exactness oracles for every kernel -- had never
        // been executed by any gate on any architecture. Naming the package is
        // what makes them run.
        "test", "--quiet", "--locked", "--all-features",
        "-p", "agenterm", "-p", "agenterm-ui-core", "--",
        "--skip", "preflight_task_is_fail_closed_and_writes_reports_for_real_git_fixtures",
        "--skip", "preflight_benchmark_task_measures_clean_public_worker_runs",
        "--skip", "prd_alignment_task_matches_public_catalogs_and_fails_closed",
        "--skip", "supply_chain_task_is_deterministic_and_covers_the_resolved_lock_graph",
        "--skip", "quality_timing_is_complete_on_success_and_failure_and_renders_markdown",
        "--skip", "rhai_working_context_smoke_is_private_ephemeral_and_orphan_free",
        "--skip", "rhai_server_smoke_preserves_headless_authority_and_cleanup",
        "--skip", "rhai_wake_smoke_preserves_concurrent_ipc_pty_and_expired_mutation",
        "--skip", "rhai_startup_smoke_preserves_first_window_and_async_terminal_contract",
        "--skip", "rhai_cli_smoke_preserves_public_control_ui_bridge_and_pty_contract",
        "--skip", "rhai_fleet_smoke_preserves_discovery_event_launch_and_mux_contract",
        "--skip", "rhai_remote_ui_smoke_preserves_replaceable_client_and_reconnect_contract",
        "--skip", "rhai_script_smoke_preserves_unrestricted_runtime_and_supervisor_contract",
        "--skip", "rhai_theme_smoke_preserves_native_rendering_pty_and_restart_contract",
        "--skip", "rhai_workbench_smoke_preserves_physical_editing_and_compact_tree_contract",
        "--skip", "rhai_diagnostic_bundles_are_bounded_private_and_orphan_free",
        "--skip", "rhai_harness_cleanup_owns_only_registered_children",
        "--skip", "migration_audit_rejects_operational_references_to_deleted_scripts",
        "--skip", "rhai_qualification_contract_fails_closed_and_cleans_owned_scratch",
        "--skip", "rhai_qualified_package_accepts_only_the_exact_receipt_bytes",
        // Native pack compilation is intentionally owned by rh-check.sh.
        // Large bundled entries (notably remote-ui-smoke) can spend minutes
        // in their generated Cargo build and must not consume this broad
        // unit lane's five-minute process budget a second time.
        "--skip", "uses_bundled_pack",
        "--skip", "uses_native_bundled_pack",
        "--skip", "pack_builds",
        "--skip", "native_pack_",
        "--skip", "source_cache_is_stable_for_same_source",
        "--skip", "script_engine_exec_parity_",
        "--skip", "native_for_fixtures_qualify_with_expected_entry_values",
        "--skip", "_executes_natively_without_interpreter",
        "--skip", "native_pack_executes_without_interpreter"
    ];
    // Strictly more work than the Clippy gate above -- same `--all-features`
    // compile of every target, plus linking and running every test binary --
    // yet it had half of Clippy's 600s. Any commit touching the root package
    // rebuilds all of its test targets, which put this right on the 300s edge:
    // it passed at 2d782408 and timed out at 54b7ec3e with the SAME warm cache
    // key. `check.rh` records real durations in timing.json, so a budget that
    // tolerates a rebuild does not hide slowness; it stops reporting a rebuild
    // as a correctness failure.
    spec("cargo", arguments, 900000, environment, 0)
}

fn cargo_unit_migration_spec(environment) {
    let arguments = [
        "test", "--quiet", "--locked", "--all-features",
        "--test", "rhai_migration",
        "quality_timing_is_complete_on_success_and_failure_and_renders_markdown",
        "--", "--nocapture"
    ];
    // Runs right after the primary gate, so it is usually warm -- but it is the
    // same `--all-features` graph, so a cold or invalidated target makes 120s
    // unreachable for reasons that have nothing to do with this test.
    spec("cargo", arguments, 300000, environment, 0)
}

fn build_artifact_timeout_ms(release) {
    if release != 0 {
        return 600000;
    }
    300000
}

fn build_artifact_profile(release) {
    if release != 0 {
        return "release";
    }
    ""
}

fn spec(program, arguments, timeout_ms, environment, allow_powershell) {
    let program_text = "" + program;
    let timeout_value = 0 + timeout_ms;
    let allow_value = 0 + allow_powershell;
    // Indexing proves StringList; bare `.len` is shared with String and would
    // freeze `arguments` as String before call-site StringList upgrades apply.
    let _first_argument = "" + arguments[0];
    // stringify is native Json evidence; bare `.keys()` falls through to HostEval.
    let _environment_proof = rh::json::stringify(environment);
    #{
        program: program_text,
        arguments: arguments,
        timeout_ms: timeout_value,
        environment: environment,
        allow_powershell: allow_value
    }
}

fn empty_environment() {
    rh::json::parse("{}")
}

fn execute(command_spec, repo, scratch, sequence) {
    let prog = "" + command_spec.program;
    // Non-empty string literal seed: empty `[]` is inferred as JSON, not StringList.
    let arg_count = 0 + command_spec.arguments.len;
    require(arg_count > 0, "check_execute_argv_empty");
    let argv = ["" + command_spec.arguments[0]];
    let arg_index = 1;
    while arg_index < arg_count {
        argv.push("" + command_spec.arguments[arg_index]);
        arg_index += 1;
    }
    let timeout_ms = command_spec.timeout_ms;
    let allow_powershell = command_spec.allow_powershell;
    let env_map = command_spec.environment;
    let repo_path = "" + repo;
    let scratch_path = "" + scratch;
    let seq_index = 0 + sequence;
    let seq_text = "" + seq_index;
    // The scratch directory lives under target/, and gates are allowed to wipe
    // target/ -- `--release` runs build.bat, whose cleanup does exactly that
    // (`cargo clean --target-dir target`). Creating it once at startup is
    // therefore not enough: the next gate's redirect then failed with
    // `process_stdout_file: os error 3`. Whoever owns the directory has to
    // guarantee it exists at the moment of use.
    std::fs::create_dir_all(scratch_path);
    let stdout_path = std::path::join(
        scratch_path,
        "command-" + seq_text + ".stdout"
    ).display;
    let stderr_path = std::path::join(
        scratch_path,
        "command-" + seq_text + ".stderr"
    ).display;
    let command = std::process::command(prog);
    command.args(argv);
    command.current_dir(repo_path);
    // Explicit keys: empty `#{}` stays no-op; identity/envs set known AGENTERM_*.
    let env_text = rh::json::stringify(env_map);
    let has_identity_env =
        env_text.contains("\"AGENTERM_BUILD_IDENTITY_VERSION\":") != 0;
    if has_identity_env != 0 {
        let env_version = "" + env_map.AGENTERM_BUILD_IDENTITY_VERSION;
        if env_version != "" {
            command.env("AGENTERM_BUILD_IDENTITY_VERSION", env_version);
            if env_text.contains("\"AGENTERM_BUILD_GIT_COMMIT\":") != 0 {
                command.env(
                    "AGENTERM_BUILD_GIT_COMMIT",
                    "" + env_map.AGENTERM_BUILD_GIT_COMMIT
                );
            }
            if env_text.contains("\"AGENTERM_BUILD_GIT_DIRTY\":") != 0 {
                command.env(
                    "AGENTERM_BUILD_GIT_DIRTY",
                    "" + env_map.AGENTERM_BUILD_GIT_DIRTY
                );
            }
            if env_text.contains("\"AGENTERM_BUILD_CARGO_LOCK_SHA256\":") != 0 {
                command.env(
                    "AGENTERM_BUILD_CARGO_LOCK_SHA256",
                    "" + env_map.AGENTERM_BUILD_CARGO_LOCK_SHA256
                );
            }
            if env_text.contains("\"AGENTERM_BUILD_ARTIFACT_MANIFEST_SHA256\":") != 0 {
                command.env(
                    "AGENTERM_BUILD_ARTIFACT_MANIFEST_SHA256",
                    "" + env_map.AGENTERM_BUILD_ARTIFACT_MANIFEST_SHA256
                );
            }
            if env_text.contains("\"AGENTERM_BUILD_PROFILE\":") != 0 {
                command.env(
                    "AGENTERM_BUILD_PROFILE",
                    "" + env_map.AGENTERM_BUILD_PROFILE
                );
            }
        }
    }
    if env_text.contains("\"CARGO_TARGET_DIR\":") != 0 {
        let cargo_target_dir = "" + env_map.CARGO_TARGET_DIR;
        if cargo_target_dir != "" {
            command.env("CARGO_TARGET_DIR", cargo_target_dir);
        }
    }
    if env_text.contains("\"RUSTC_WRAPPER\":") != 0 {
        let rustc_wrapper = "" + env_map.RUSTC_WRAPPER;
        if rustc_wrapper != "" {
            command.env("RUSTC_WRAPPER", rustc_wrapper);
            if env_text.contains("\"AGENTERM_INTERNAL_RUSTC_WRAPPER\":") != 0 {
                command.env(
                    "AGENTERM_INTERNAL_RUSTC_WRAPPER",
                    "" + env_map.AGENTERM_INTERNAL_RUSTC_WRAPPER
                );
            }
            if env_text.contains("\"AGENTERM_INCREMENTAL_INVOCATION_ID\":") != 0 {
                command.env(
                    "AGENTERM_INCREMENTAL_INVOCATION_ID",
                    "" + env_map.AGENTERM_INCREMENTAL_INVOCATION_ID
                );
            }
            if env_text.contains("\"AGENTERM_INCREMENTAL_TARGET\":") != 0 {
                command.env(
                    "AGENTERM_INCREMENTAL_TARGET",
                    "" + env_map.AGENTERM_INCREMENTAL_TARGET
                );
            }
            if env_text.contains("\"AGENTERM_INCREMENTAL_ROOT\":") != 0 {
                command.env(
                    "AGENTERM_INCREMENTAL_ROOT",
                    "" + env_map.AGENTERM_INCREMENTAL_ROOT
                );
            }
            if env_text.contains("\"AGENTERM_INCREMENTAL_STATE\":") != 0 {
                command.env(
                    "AGENTERM_INCREMENTAL_STATE",
                    "" + env_map.AGENTERM_INCREMENTAL_STATE
                );
            }
        }
    }
    let deadline_ms = timeout_ms + 10000;
    command.timeout(
        std::time::Duration::from_millis(deadline_ms)
    );
    let stdout_file = "" + stdout_path;
    let stderr_file = "" + stderr_path;
    command.stdout_file(stdout_file);
    command.stderr_file(stderr_file);
    let started = std::time::SystemTime::now().unix_millis;
    let result = command.output();
    let stdout = "";
    if std::fs::exists(stdout_file) {
        stdout = std::fs::read_to_string(stdout_file);
    }
    let stderr = "";
    if std::fs::exists(stderr_file) {
        stderr = std::fs::read_to_string(stderr_file);
    }
    let duration =
        std::time::SystemTime::now().unix_millis - started;
    let timed_out = duration > timeout_ms;
    let observed_powershell = empty_task_extra();
    let process_samples = 0;
    let powershell_violation =
        observed_powershell.len > 0 && allow_powershell == 0;
    let gate_success =
        result.success != 0
            && powershell_violation == 0
            && timed_out == 0;
    #{
        success: gate_success,
        exit_code: result.exit_code,
        duration_ms: duration,
        stdout: stdout,
        stderr: compose_execute_stderr(
            stderr,
            powershell_violation,
            observed_powershell,
            timed_out,
            timeout_ms
        ),
        stdout_path: stdout_path,
        stderr_path: stderr_path,
        timed_out: timed_out,
        observed_powershell: observed_powershell,
        process_samples: process_samples
    }
}

fn bounded_text(text, maximum) {
    let value = "" + text;
    let text_len = value.len;
    if text_len <= maximum {
        return value;
    }
    value.sub_string(text_len - maximum, maximum)
}

fn append_text_lines(target, text) {
    for source_line in text.split("\n") {
        let line = source_line;
        line.trim();
        if line != "" {
            target.push(line);
        }
    }
    0
}

fn slice_prefix(text, stop) {
    let value = "" + text;
    if stop < 0 {
        return value;
    }
    value.sub_string(0, stop)
}

/// Pull the innermost script diagnostic out of a nested gate failure.
///
/// A failing inner task reports a JSON envelope whose `message` embeds
/// another envelope, so the actionable code (for example
/// `supply_chain_source_missing:softbuffer:0.4.8`) ends up several quoted
/// layers deep. Surfacing it first keeps the CI summary readable without
/// discarding the full payload printed below it.
fn innermost_diagnostic(_text) {
    ""
}

fn run_gate_step(
    context,
    timing,
    id,
    label,
    command_spec,
    repo,
    scratch,
    sequence,
    started,
    all_output
) {
    let command_sequence = 0 + sequence;
    let next_sequence = command_sequence + 1;
    let allow_powershell = 0 + command_spec.allow_powershell;
    let result = execute(
        command_spec,
        repo,
        scratch,
        command_sequence
    );
    let seq_text = "" + command_sequence;
    let scratch_path = "" + scratch;
    let stdout_path = std::path::join(
        scratch_path,
        "command-" + seq_text + ".stdout"
    ).display;
    let stderr_path = std::path::join(
        scratch_path,
        "command-" + seq_text + ".stderr"
    ).display;
    let stdout_text = result.stdout;
    let stderr_text = result.stderr;
    context = wrap_add_process_observation(
        context,
        result.process_samples,
        empty_task_extra(),
        allow_powershell
    );
    if stdout_text != "" {
        print(stdout_text);
    }
    if stderr_text != "" {
        print(stderr_text);
    }
    if result.observed_powershell.len > 0
            && allow_powershell != 0 {
        print(
            "OBSERVED explicit terminal compatibility payload: " +
                joined_text(result.observed_powershell, ",")
        );
    }
    for source_line in stdout_text.split("\n") {
        let line = source_line;
        line.trim();
        if line != "" {
            all_output.push(line);
        }
    }
    for source_line in stderr_text.split("\n") {
        let line = source_line;
        line.trim();
        if line != "" {
            all_output.push(line);
        }
    }
    if result.success == 0 {
        let duration =
            std::time::SystemTime::now().unix_millis - started;
        timing = wrap_timing_set_gate(
            timing,
            id,
            "failed",
            duration,
            result.exit_code,
            result.timed_out != 0
        );
        timing = wrap_timing_finish(timing, "failed");
        // Bound each stream separately: a single tail-bound over
        // stdout+stderr let cargo's stderr noise evict the stdout
        // failures section (the part that names the failing tests).
        let payload = bounded_text(stdout_text, 8192) + "\n" +
            bounded_text(stderr_text, 8192);
        throw label + " failed with exit code " + result.exit_code +
            "\n" + payload;
    }
    #{context:context,timing:timing,sequence:next_sequence}
}

fn run_gate(context, timing, id, label, command_spec, repo, scratch, sequence) {
    print("\n==> " + label);
    let started = std::time::SystemTime::now().unix_millis;
    let all_output = empty_task_extra();
    let step = run_gate_step(
        context,
        timing,
        id,
        label,
        command_spec,
        repo,
        scratch,
        sequence,
        started,
        all_output
    );
    context = map_context(step);
    timing = map_timing(step);
    let next_sequence = map_sequence(step);
    let duration =
        std::time::SystemTime::now().unix_millis - started;
    context = wrap_add_result(
        context,
        id,
        "passed",
        duration,
        all_output
    );
    timing = wrap_timing_set_gate(
        timing,
        id,
        "passed",
        duration,
        0,
        0
    );
    print("PASS: " + label + " (" + duration + " ms)");
    #{context:context,timing:timing,sequence:next_sequence}
}

fn run_gate_two(
    context,
    timing,
    id,
    label,
    first_spec,
    second_spec,
    repo,
    scratch,
    sequence
) {
    print("\n==> " + label);
    let started = std::time::SystemTime::now().unix_millis;
    let all_output = empty_task_extra();
    let step = run_gate_step(
        context,
        timing,
        id,
        label,
        first_spec,
        repo,
        scratch,
        sequence,
        started,
        all_output
    );
    context = map_context(step);
    timing = map_timing(step);
    let next_sequence = map_sequence(step);
    step = run_gate_step(
        context,
        timing,
        id,
        label,
        second_spec,
        repo,
        scratch,
        next_sequence,
        started,
        all_output
    );
    context = map_context(step);
    timing = map_timing(step);
    next_sequence = map_sequence(step);
    let duration =
        std::time::SystemTime::now().unix_millis - started;
    context = wrap_add_result(
        context,
        id,
        "passed",
        duration,
        all_output
    );
    timing = wrap_timing_set_gate(
        timing,
        id,
        "passed",
        duration,
        0,
        0
    );
    print("PASS: " + label + " (" + duration + " ms)");
    #{context:context,timing:timing,sequence:next_sequence}
}

fn run_quick_gate(timing, id, label, command_spec, repo, scratch, sequence) {
    print("\n==> " + label);
    let started = std::time::SystemTime::now().unix_millis;
    let command_sequence = 0 + sequence;
    let next_sequence = sequence + 1;
    let result = execute(
        command_spec,
        repo,
        scratch,
        sequence
    );
    let seq_text = "" + command_sequence;
    let scratch_path = "" + scratch;
    let stdout_path = std::path::join(
        scratch_path,
        "command-" + seq_text + ".stdout"
    ).display;
    let stderr_path = std::path::join(
        scratch_path,
        "command-" + seq_text + ".stderr"
    ).display;
    let stdout_text = result.stdout;
    let stderr_text = result.stderr;
    if stdout_text != "" {
        print(stdout_text);
    }
    if stderr_text != "" {
        print(stderr_text);
    }
    if result.success == 0 {
        let duration =
            std::time::SystemTime::now().unix_millis - started;
        timing = wrap_timing_set_gate(
            timing,
            id,
            "failed",
            duration,
            result.exit_code,
            result.timed_out != 0
        );
        timing = wrap_timing_finish(timing, "failed");
        // Separate bounds so stderr noise cannot evict the stdout
        // failures section (see run_gate_step's matching note).
        let combined = bounded_text(stdout_text, 8192) + "\n" +
            bounded_text(stderr_text, 8192);
        throw label + " failed with exit code " + result.exit_code +
            "\n" + combined;
    }
    let duration =
        std::time::SystemTime::now().unix_millis - started;
    timing = wrap_timing_set_gate(
        timing,
        id,
        "passed",
        duration,
        0,
        0
    );
    print("PASS: " + label + " (" + duration + " ms)");
    #{timing:timing,sequence:next_sequence}
}

fn run_step(label, command_spec, repo, scratch, sequence) {
    print("\n==> " + label);
    let started = std::time::SystemTime::now().unix_millis;
    let command_sequence = 0 + sequence;
    let next_sequence = sequence + 1;
    let result = execute(
        command_spec,
        repo,
        scratch,
        sequence
    );
    let seq_text = "" + command_sequence;
    let scratch_path = "" + scratch;
    let stdout_path = std::path::join(
        scratch_path,
        "command-" + seq_text + ".stdout"
    ).display;
    let stderr_path = std::path::join(
        scratch_path,
        "command-" + seq_text + ".stderr"
    ).display;
    let stdout_text = result.stdout;
    let stderr_text = result.stderr;
    if stdout_text != "" {
        print(stdout_text);
    }
    if stderr_text != "" {
        print(stderr_text);
    }
    let combined = stdout_text + stderr_text;
    require(
        result.success != 0,
        label + " failed with exit code " + result.exit_code +
            "\n" + bounded_text(combined, 16384)
    );
    print(
        "PASS: " + label + " (" +
            (
                std::time::SystemTime::now().unix_millis - started
            ) +
            " ms)"
    );
    pass_int(next_sequence)
}

fn lint_cli_worker(fallback) {
    let fallback_path = "" + fallback;
    if std::env::has("AGENTERM_BOOTSTRAP_RH_CLI") {
        let path =
            std::path::absolute(std::env::get("AGENTERM_BOOTSTRAP_RH_CLI")).display;
        if std::fs::exists(path)
            && std::fs::metadata(path).is_file
            && std::fs::metadata(path).len > 0 {
            return path;
        }
    }
    fallback_path
}

fn first_nonempty_file(repo, first_relative, second_relative) {
    let first_path = std::path::join(repo, first_relative).display;
    if std::fs::exists(first_path)
            && std::fs::metadata(first_path).is_file
            && std::fs::metadata(first_path).len > 0 {
        return first_path;
    }
    let second_path = std::path::join(repo, second_relative).display;
    if std::fs::exists(second_path)
            && std::fs::metadata(second_path).is_file
            && std::fs::metadata(second_path).len > 0 {
        return second_path;
    }
    ""
}

fn task(worker, manifest, id, timeout_ms, extra, environment, allow_powershell) {
    let worker_path = "" + worker;
    let manifest_path = "" + manifest;
    let task_id = "" + id;
    // JSON string-array extras (see empty_task_extra / *_task_extra helpers).
    let _extra_proof = rh::json::stringify(extra);
    let arguments = [
        "rh", "task", "run", task_id,
        "--manifest", manifest_path
    ];
    if extra.len > 0 {
        arguments.push("--");
        for item in extra {
            arguments.push("" + item);
        }
    }
    let deadline = 0 + timeout_ms + 10000;
    spec(worker_path, arguments, deadline, environment, allow_powershell)
}

fn direct_task(worker, repo, id, timeout_ms, arguments, environment, allow_powershell) {
    let timeout_value = 0 + timeout_ms;
    let worker_path = "" + worker;
    let repo_path = "" + repo;
    let task_id = "" + id;
    let script_path = std::path::join(
        repo_path,
        "scripts/rh/" + task_id + ".rh"
    ).display;
    let command_arguments = ["rh", "run"];
    command_arguments.push("" + script_path);
    command_arguments.push("--profile");
    command_arguments.push("local");
    command_arguments.push("--project-root");
    command_arguments.push(repo_path);
    command_arguments.push("--timeout-ms");
    command_arguments.push("" + timeout_value);
    command_arguments.push("--max-operations");
    command_arguments.push("10000000");
    command_arguments.push("--max-output-bytes");
    command_arguments.push("1048576");
    command_arguments.push("--");
    for item in arguments {
        command_arguments.push(item);
    }
    let deadline = timeout_value + 10000;
    spec(worker_path, command_arguments, deadline, environment, allow_powershell)
}

fn quick_prd_alignment_spec(
    unix_bootstrap,
    bootstrap_worker,
    repo,
    manifest,
    quick_native_bin_root,
    empty_extra
) {
    if unix_bootstrap != 0 {
        let quick_native_bin = std::path::join(
            quick_native_bin_root,
            "agenterm"
        ).display;
        return direct_task(
            bootstrap_worker,
            repo,
            "prd-alignment",
            10000,
            [
                repo,
                quick_native_bin
            ],
            empty_environment(),
            0
        );
    }
    task(
        bootstrap_worker,
        manifest,
        "prd-alignment",
        10000,
        empty_extra,
        empty_environment(),
        0
    )
}

fn compute_quick_native_bin_root(repo, quick_target) {
    let target = "" + quick_target;
    if std::env::has("CARGO_TARGET_DIR") {
        let base =
            std::path::absolute(std::env::get("CARGO_TARGET_DIR")).display;
        if target != "" {
            let with_target = std::path::join(base, target).display;
            return std::path::join(with_target, "debug").display;
        }
        return std::path::join(base, "debug").display;
    }
    let base = std::path::join(repo, "target").display;
    if target != "" {
        let with_target = std::path::join(base, target).display;
        return std::path::join(with_target, "debug").display;
    }
    std::path::join(base, "debug").display
}

fn resolve_task_rh_cli(dist_agenterm, repo) {
    if dist_agenterm != "" {
        return dist_agenterm;
    }
    first_nonempty_file(
        repo,
        "target/debug/agenterm.exe",
        "target/debug/agenterm"
    )
}

fn resolve_worker(dist_agenterm, task_rh_cli) {
    let dist_text = "" + dist_agenterm;
    let task_text = "" + task_rh_cli;
    if dist_text != "" {
        return dist_text;
    }
    task_text
}

fn resolve_dist_lint_cli(dist_agenterm, lint_worker) {
    let dist_text = "" + dist_agenterm;
    let lint_text = "" + lint_worker;
    if dist_text != "" {
        return dist_text;
    }
    lint_text
}

fn resolve_artifact_verification_mode(release) {
    if release != 0 {
        return "release";
    }
    "development"
}

fn assert_declarations(context, worker, repo, scratch, sequence, gate_manifest) {
    let _manifest = context.manifest;
    let sequence_value = 0 + sequence;
    for gate in gate_manifest.required_gates {
        if gate.evidence.len == 0 {
            continue;
        }
        let path = std::path::join(
            repo,
            "scripts/rh/" + gate.id + ".rh"
        ).display;
        let suite_path = "" + path;
        require(
            std::fs::exists(suite_path),
            "check_evidence_suite_missing:" + gate.id
        );
        let worker_program = "" + worker;
        let result = execute(
            evidence_list_spec(worker_program, suite_path),
            repo,
            scratch,
            sequence_value
        );
        sequence_value += 1;
        let stdout_text = result.stdout;
        let stderr_text = result.stderr;
        require(
            result.success != 0,
            "check_evidence_declaration_failed:" + gate.id +
                ":" + stderr_text
        );
        let evidence = [];
        for source_line in stdout_text.split("\n") {
            let line = source_line;
            line.trim();
            if line != "" {
                evidence.push(line);
            }
        }
        require(
            qualification::exact_values(gate.evidence, evidence),
            "check_evidence_declaration_stale:" + gate.id
        );
    }
    pass_int(sequence_value)
}

fn freeze_identity(worker, manifest, repo, scratch, sequence) {
    let path = std::path::join(scratch, "build-identity.cmd").display;
    let command_spec = task(
        worker,
        manifest,
        "build-identity",
        10000,
        three_task_extra(repo, "dev", path),
        empty_environment(),
        0
    );
    let result = execute(
        command_spec,
        repo,
        scratch,
        sequence
    );
    let stdout_text = result.stdout;
    let stderr_text = result.stderr;
    require(
        result.success != 0,
        "check_build_identity:" + stdout_text + stderr_text
    );
    let identity_path = "" + path;
    let identity_text = std::fs::read_to_string(identity_path);
    let line_count = 0;
    for source_line in identity_text.split("\n") {
        let line = source_line;
        line.trim();
        if line == "" {
            continue;
        }
        require(
            line.starts_with("set \"") && line.ends_with("\""),
            "check_build_identity_line:" + line
        );
        let body = line.sub_string(5, line.len - 6);
        let parts = body.split("=");
        require(parts.len == 2, "check_build_identity_value:" + line);
        line_count += 1;
    }
    require(line_count == 6, "check_build_identity_fields");
    let environment = dev_environment(repo);
    #{environment:environment,sequence:sequence + 1}
}

fn slowest_fill(_results, _gate_ids, _ids, _durations) {
    // Typed no-op: all four args are JSON values at the call site.
    let _results_proof = rh::json::stringify(_results);
    let _gate_ids_proof = rh::json::stringify(_gate_ids);
    let _ids_proof = rh::json::stringify(_ids);
    let _durations_proof = rh::json::stringify(_durations);
    0
}

fn copy_release_fast_fixture(repo, upgrade_fixture) {
    let repo_path = "" + repo;
    let fixture_path = "" + upgrade_fixture;
    let source = std::path::join(
        repo_path,
        "target/release-fast/agenterm.exe"
    ).display;
    std::fs::copy(source, fixture_path);
    0
}

fn entry() {
require(args.len >= 1, "expected: REPO [OPTIONS]");
let repo = std::path::absolute(args[0]).display;
require(
    std::env::has("AGENTERM_BOOTSTRAP_WORKER"),
    "check_bootstrap_worker_missing"
);
let bootstrap_worker =
    std::path::absolute(std::env::get("AGENTERM_BOOTSTRAP_WORKER")).display;
let lint_worker = lint_cli_worker(bootstrap_worker);
let quick = 0;
let release = 0;
let skip_smoke = 0;
let include_stress = 0;
let dry_run = 0;
let quick_target = "";
let receipt_path =
    std::path::join(repo, "target/qualification/receipt.json").display;
let timing_path =
    std::path::join(repo, "target/qualification/timing.json").display;
let index = 1;
while index < args.len {
    let value = args[index];
    if value == "--quick" {
        quick = 1;
    } else if value == "--release" {
        release = 1;
    } else if value == "--skip-smoke" {
        skip_smoke = 1;
    } else if value == "--include-stress" {
        include_stress = 1;
    } else if value == "--internal-qualification-dry-run" {
        dry_run = 1;
    } else if value == "--receipt" {
        require(index + 1 < args.len, "check_receipt_value_missing");
        receipt_path = absolute_display(arg_value(index + 1));
        index += 1;
    } else if value == "--target" {
        require(index + 1 < args.len, "check_target_value_missing");
        quick_target = arg_value(index + 1);
        index += 1;
    } else if value == "--timing" {
        require(index + 1 < args.len, "check_timing_value_missing");
        timing_path = absolute_display(arg_value(index + 1));
        index += 1;
    } else {
        throw "check_unknown_argument:" + value;
    }
    index += 1;
}
require(
    quick_target == "" || quick != 0,
    "check_target_only_for_quick"
);
require(
    quick == 0 || !(release != 0 || skip_smoke != 0 || include_stress != 0 || dry_run != 0),
    "check_quick_option_conflict"
);
let unix_bootstrap = 0;
if std::env::has("AGENTERM_BOOTSTRAP_PLATFORM")
        && std::env::get("AGENTERM_BOOTSTRAP_PLATFORM") == "unix" {
    unix_bootstrap = 1;
}
if unix_bootstrap && quick == 0
        && release == 0 && skip_smoke == 0 && include_stress == 0 && dry_run == 0 {
    quick = 1;
}
require(
    unix_bootstrap == 0 || quick != 0,
    "check_full_qualification_requires_windows"
);

let scratch =
    std::path::join(repo, "target/qualification/scratch").display;
std::fs::create_dir_all(scratch);
let manifest = std::path::join(repo, "agenterm.tasks.json").display;
let empty_extra = empty_task_extra();
let sequence = 1;
if dry_run != 0 {
    sequence = run_step(
        "qualification fail-closed dry run",
        task(
            bootstrap_worker,
            manifest,
            "qualification-selftest",
            20000,
            empty_extra,
            #{},
            0
        ),
        repo,
        scratch,
        sequence
    );
    return 0;
}

if std::fs::exists(timing_path) {
    std::fs::remove_file(timing_path);
}

if quick != 0 {
    let quick_started = std::time::SystemTime::now().unix_millis;
    let quick_native_bin_root =
        compute_quick_native_bin_root(repo, quick_target);
    let clippy_arguments = [
        "clippy", "--quiet", "--locked", "--all-targets", "--", "-D", "warnings"
    ];
    let unit_arguments = ["test", "--quiet", "--locked", "--lib"];
    // dev, explicitly: build.rh defaults to release-fast, but
    // compute_quick_native_bin_root (and so prd-alignment's probe)
    // addresses <root>/<triple>/debug — the profile mismatch left the
    // quick chain's client gate green while its consumers found nothing.
    let quick_client_build_args = ["dev"];
    if quick_target != "" {
        let target_text = "" + quick_target;
        clippy_arguments.push("--target");
        clippy_arguments.push(target_text);
        unit_arguments.push("--target");
        unit_arguments.push(target_text);
        quick_client_build_args.push("--target");
        quick_client_build_args.push(target_text);
    }
    let quick_gate_ids = [
        "repo-lint",
        "rustfmt"
    ];
    if unix_bootstrap != 0 {
        quick_gate_ids.push("native-public-catalog-clients");
    }
    quick_gate_ids.push("prd-alignment");
    quick_gate_ids.push("clippy");
    quick_gate_ids.push("unit-tests");
    let timing = wrap_timing_new(
        repo,
        std::path::join(
            repo,
            "scripts/qualification-gates.json"
        ).display,
        timing_path,
        "quick",
        "quick",
        #{unix_bootstrap:unix_bootstrap},
        quick_gate_ids
    );
    let quick_gate = run_quick_gate(
        timing,
        "repo-lint",
        "repository static lint",
        task(
            bootstrap_worker,
            manifest,
            "lint",
            300000,
            two_task_extra(lint_worker, "static"),
            empty_environment(),
            0
        ),
        repo,
        scratch,
        sequence
    );
    timing = map_timing(quick_gate);
    sequence = map_sequence(quick_gate);
    let quick_gate = run_quick_gate(
        timing,
        "rustfmt",
        "rustfmt",
        cargo_fmt_all_check_spec(empty_environment()),
        repo,
        scratch,
        sequence
    );
    timing = map_timing(quick_gate);
    sequence = map_sequence(quick_gate);
    if unix_bootstrap != 0 {
        let quick_gate = run_quick_gate(
            timing,
            "native-public-catalog-clients",
            "native public catalog clients",
            task(
                bootstrap_worker,
                manifest,
                "client-build",
                600000,
                quick_client_build_args,
                empty_environment(),
                0
            ),
            repo,
            scratch,
            sequence
        );
        timing = map_timing(quick_gate);
        sequence = map_sequence(quick_gate);
    }
    let quick_gate = run_quick_gate(
        timing,
        "prd-alignment",
        "PRD capability alignment",
        quick_prd_alignment_spec(
            unix_bootstrap,
            bootstrap_worker,
            repo,
            manifest,
            quick_native_bin_root,
            empty_extra
        ),
        repo,
        scratch,
        sequence
    );
    timing = map_timing(quick_gate);
    sequence = map_sequence(quick_gate);
    let identity_environment = empty_environment();
    let identity_sequence = sequence;
    try {
        let identity = freeze_identity(
            bootstrap_worker,
            manifest,
            repo,
            scratch,
            sequence
        );
        identity_environment = map_environment(identity);
        identity_sequence = map_sequence(identity);
    } catch (error) {
    timing = wrap_timing_fail_stage(
        timing,
            "build-identity"
        );
        throw error;
    }
    sequence = pass_int(identity_sequence);
    let quick_gate = run_quick_gate(
        timing,
        "clippy",
        "all-target Clippy",
        // 60s only fit a warm cache; a crate edit re-lints the workspace.
        spec("cargo", clippy_arguments, 600000, identity_environment, 0),
        repo,
        scratch,
        sequence
    );
    timing = map_timing(quick_gate);
    sequence = map_sequence(quick_gate);
    // rh AOT pack unit tests each run an isolated `cargo build --release` of a
    // generated cdylib (~1m each on cold host). 60s was enough for the pre-rh
    // lib suite and now false-fails the quick gate with gate_deadline_exceeded.
    let quick_gate = run_quick_gate(
        timing,
        "unit-tests",
        "library unit tests",
        spec("cargo", unit_arguments, 600000, identity_environment, 0),
        repo,
        scratch,
        sequence
    );
    timing = map_timing(quick_gate);
    sequence = map_sequence(quick_gate);
    timing = wrap_timing_finish(timing, "passed");
    print(
        "\nPASS: AgenTerm quick development gate (" +
            (
                std::time::SystemTime::now().unix_millis -
                    quick_started
            ) +
            " ms)"
    );
    return 0;
}

if std::fs::exists(receipt_path) {
    std::fs::remove_file(receipt_path);
}
let context = wrap_new_context(
    std::path::join(
        repo,
        "scripts/qualification-gates.json"
    ).display,
    release,
    include_stress
);
let timing_profile = "full";
if release != 0 && include_stress != 0 {
    timing_profile = "release-stress";
} else if skip_smoke != 0 {
    timing_profile = "skip-smoke";
}
let timing_kind = "ordinary";
if release != 0 {
    timing_kind = "candidate";
}
let smoke_included = 1;
if skip_smoke != 0 {
    smoke_included = 0;
}
let gate_manifest = rh::json::parse_file(
    std::path::join(
        repo,
        "scripts/qualification-gates.json"
    ).display
);
let timing_gate_ids = [];
for gate in gate_manifest.required_gates {
    timing_gate_ids.push(gate.id);
}
let timing = wrap_timing_new(
    repo,
    context.manifest_path,
    timing_path,
    timing_kind,
    timing_profile,
    #{
        release: release,
        stress_included: include_stress,
        smoke_included: smoke_included
    },
    timing_gate_ids
);
if release == 0 {
    timing = wrap_timing_set_gate(
        timing, "release-preflight", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "preflight-benchmark", "skipped", 0, 0, 0
    );
}
if skip_smoke != 0 {
    timing = wrap_timing_set_gate(
        timing, "startup-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "wake-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "cli-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "server-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "native-ipc-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "native-ipc-compat-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "remote-ui-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "remote-ui-upgrade-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "fleet-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "script-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "theme-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "working-context-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "workbench-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "control-center-smoke", "skipped", 0, 0, 0
    );
    timing = wrap_timing_set_gate(
        timing, "cu-windows-smoke", "skipped", 0, 0, 0
    );
}
let full_started = std::time::SystemTime::now().unix_millis;
let gate = run_gate(
    context,
    timing,
    "preflight-selftest",
    "read-only preflight self-test",
    cargo_preflight_selftest_spec(#{}),
    repo,
    scratch,
    sequence
);
context = map_context(gate);
timing = map_timing(gate);
sequence = map_sequence(gate);

if release != 0 {
    let release_preflight = run_gate(
        context,
        timing,
        "release-preflight",
        "clean internal candidate preflight",
        task(
            bootstrap_worker,
            manifest,
            "preflight",
            10000,
            two_task_extra(
                repo,
                std::path::join(
                    repo,
                    "target/preflight/preflight.json"
                ).display
            ),
            #{},
            0
        ),
        repo,
        scratch,
        sequence
    );
    context = map_context(release_preflight);
    timing = map_timing(release_preflight);
    sequence = map_sequence(release_preflight);
    // R3 (v0.1.15): agenterm-net-research is no longer a release/Candidate gate.
    // Push CI still runs it (linux job AGENTERM_BOOTSTRAP_TASK=agenterm-net-research).
    let benchmark = run_gate(
        context,
        timing,
        "preflight-benchmark",
        "local preflight p95 benchmark",
        task(
            bootstrap_worker,
            manifest,
            "preflight-benchmark",
            // 5 iterations of a task whose own target is 15s each: 60s could not
            // cover a passing run, let alone a slow one.
            240000,
            five_task_extra(
                bootstrap_worker,
                manifest,
                repo,
                std::path::join(
                    repo,
                    "target/preflight/benchmark.json"
                ).display,
                "5"
            ),
            #{},
            0
        ),
        repo,
        scratch,
        sequence
    );
    context = map_context(benchmark);
    timing = map_timing(benchmark);
    sequence = map_sequence(benchmark);
}

let lint_gate = run_gate_two(
    context,
    timing,
    "repo-lint",
    "repository static lint",
    task(
        bootstrap_worker,
        manifest,
        "lint",
        300000,
        two_task_extra(lint_worker, "--self-test"),
        #{},
        0
    ),
    task(
        bootstrap_worker,
        manifest,
        "lint",
        300000,
        two_task_extra(lint_worker, "static"),
        #{},
        0
    ),
    repo,
    scratch,
    sequence
);
context = map_context(lint_gate);
timing = map_timing(lint_gate);
sequence = map_sequence(lint_gate);
try {
    sequence = assert_declarations(
        context,
        bootstrap_worker,
        repo,
        scratch,
        sequence,
        gate_manifest
    );
} catch (error) {
    timing = wrap_timing_fail_stage(
        timing,
        "evidence-declarations"
    );
    throw error;
}
let rustfmt_gate = run_gate(
    context,
    timing,
    "rustfmt",
    "rustfmt",
    cargo_fmt_check_spec(#{}),
    repo,
    scratch,
    sequence
);
context = map_context(rustfmt_gate);
timing = map_timing(rustfmt_gate);
sequence = map_sequence(rustfmt_gate);

let build_environment = empty_environment();
let build_identity_sequence = sequence;
try {
    let identity = freeze_identity(
        bootstrap_worker,
        manifest,
        repo,
        scratch,
        sequence
    );
    build_environment = map_environment(identity);
    build_identity_sequence = map_sequence(identity);
} catch (error) {
    timing = wrap_timing_fail_stage(
        timing,
        "build-identity"
    );
    throw error;
}
sequence = build_identity_sequence;
let clippy_gate = run_gate(
    context,
    timing,
    "clippy",
    "Clippy",
    cargo_clippy_all_spec(build_environment),
    repo,
    scratch,
    sequence
);
context = map_context(clippy_gate);
timing = map_timing(clippy_gate);
sequence = map_sequence(clippy_gate);
let unit_primary_spec = cargo_unit_primary_spec(build_environment);
let unit_migration_spec = cargo_unit_migration_spec(build_environment);
let unit_gate = run_gate_two(
    context,
    timing,
    "unit-tests",
    "unit tests",
    unit_primary_spec,
    unit_migration_spec,
    repo,
    scratch,
    sequence
);
context = map_context(unit_gate);
timing = map_timing(unit_gate);
sequence = map_sequence(unit_gate);

require(
    std::env::has("TEMP"),
    "qualification_temp_directory_missing"
);
let qualification_temp_dir = std::env::get("TEMP");
let upgrade_fixture = std::path::join(
    qualification_temp_dir,
    "agenterm-qualification-" + std::process::id() +
        "-prior-agenterm.exe"
).display;
// The release build owns and reclaims the complete Cargo target tree. Park
// this cross-build fixture in the OS temporary directory instead, with a
// process-qualified name so parallel qualifications cannot share bytes.
std::fs::try_remove_file(upgrade_fixture);
// The release-fast fixture must be captured before the release build runs:
// a staged release reclaims the development target with `cargo clean`, which
// would otherwise remove target/release-fast/agenterm.exe before the copy.
if skip_smoke == 0 {
    let fixture_gate = run_gate(
        context,
        timing,
        "artifact-build-fast",
        "alternate GUI fixture build",
        cmd_build_bat_spec(repo, "release-fast", 300000, build_environment),
        repo,
        scratch,
        sequence
    );
    context = map_context(fixture_gate);
    timing = map_timing(fixture_gate);
    sequence = map_sequence(fixture_gate);
    try {
        copy_release_fast_fixture(repo, upgrade_fixture);
    } catch (error) {
        timing = wrap_timing_fail_stage(
            timing,
            "upgrade-fixture"
        );
        throw error;
    }
}
let build_timeout_ms = build_artifact_timeout_ms(release);
let build_profile = build_artifact_profile(release);
let final_build_spec = cmd_build_bat_spec(
    repo,
    build_profile,
    build_timeout_ms,
    build_environment
);
let build_gate = run_gate(
    context,
    timing,
    "artifact-build",
    "current artifact",
    final_build_spec,
    repo,
    scratch,
    sequence
);
context = map_context(build_gate);
timing = map_timing(build_gate);
sequence = map_sequence(build_gate);
let dist_agenterm = first_nonempty_file(
    repo,
    "dist/agenterm.exe",
    "dist/agenterm"
);
let task_rh_cli = resolve_task_rh_cli(dist_agenterm, repo);
require(task_rh_cli != "", "check_dist_task_worker_missing");
let worker = resolve_worker(dist_agenterm, task_rh_cli);
let dist_lint_cli = resolve_dist_lint_cli(dist_agenterm, lint_worker);
let artifact_verification_mode =
    resolve_artifact_verification_mode(release);

let ordinary = run_gate(
    context,
    timing,
    "prd-alignment",
    "PRD capability alignment",
    task(worker, manifest, "prd-alignment", 10000, empty_extra, #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "rh-lint",
    "production rh source lint",
    task(
        worker, manifest, "lint", 300000, two_task_extra(dist_lint_cli, "rh"), #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "task-catalog",
    "repository script task catalog",
    task_check_spec(worker, manifest),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "mcp-conformance",
    "public MCP conformance and isolation",
    task(worker, manifest, "mcp-conformance", 600000, empty_extra, #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "migration-audit",
    "PowerShell migration ledger and no-new-PS1 gate",
    task(worker, manifest, "migration-audit", 10000, empty_extra, #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "artifact-verification",
    "binary roles and metadata",
    task(
        worker,
        manifest,
        "artifact-verification",
        30000,
        one_task_extra(artifact_verification_mode), #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "readme-examples",
    "manifest-driven README examples",
    task(worker, manifest, "readme-examples", 10000, empty_extra, #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "docs-site",
    "case-exact static docs assets",
    task(worker, manifest, "verify-docs-site", 10000, empty_extra, #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "supply-chain",
    "locked dependency licenses and SPDX inventory",
    task(
        worker,
        manifest,
        "supply-chain",
        // 60s could not cover its own `cargo metadata` child budget once the
        // cargo package lock was contended; the manifest budget is 300s.
        180000,
        two_task_extra(
            repo,
            std::path::join(
                repo,
                "dist/agenterm-sbom.spdx.json"
            ).display
        ),
        #{},
        0
    ),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "target-report",
    "Cargo target inventory",
    task(worker, manifest, "target-report", 10000, empty_extra, #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "internal-version-policy",
    "internal version publication policy",
    task(worker, manifest, "internal-version-policy", 10000, empty_extra, #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "qualification-selftest",
    "qualification fail-closed self-test",
    task(worker, manifest, "qualification-selftest", 20000, empty_extra, #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "package-boundary-selftest",
    "qualified package boundary self-test",
    task(worker, manifest, "package-qualified-selftest", 60000, empty_extra, #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);
ordinary = run_gate(
    context,
    timing,
    "harness-cleanup-selftest",
    "owned-resource cleanup self-test",
    task(worker, manifest, "harness-cleanup-selftest", 10000, empty_extra, #{}, 0),
    repo,
    scratch,
    sequence
);
context = map_context(ordinary);
timing = map_timing(ordinary);
sequence = map_sequence(ordinary);

if skip_smoke == 0 {
    let no_activate = #{
        "AGENTERM_NO_ACTIVATE": "1",
        "AGENTERM_SCRIPT_WORKER_STDERR": "inherit"
    };
    let smoke_ids = [];
    smoke_ids.push("startup-smoke");
    smoke_ids.push("wake-smoke");
    smoke_ids.push("cli-smoke");
    smoke_ids.push("server-smoke");
    smoke_ids.push("native-ipc-smoke");
    smoke_ids.push("native-ipc-compat-smoke");
    smoke_ids.push("remote-ui-smoke");
    smoke_ids.push("remote-ui-upgrade-smoke");
    smoke_ids.push("fleet-smoke");
    smoke_ids.push("script-smoke");
    smoke_ids.push("theme-smoke");
    smoke_ids.push("working-context-smoke");
    smoke_ids.push("workbench-smoke");
    smoke_ids.push("control-center-smoke");
    smoke_ids.push("cu-windows-smoke");
    let smoke_index = 0;
    while smoke_index < smoke_ids.len {
        let id = smoke_ids[smoke_index];
        let extra = [];
        if id == "remote-ui-upgrade-smoke" {
            extra.push(upgrade_fixture);
        }
        if id == "fleet-smoke" && include_stress != 0 {
            extra.push("--event-load");
        }
        let smoke_allow_powershell = 0;
        if id == "remote-ui-smoke" {
            smoke_allow_powershell = 1;
        }
        let smoke_spec = task(
            worker,
            manifest,
            id,
            smoke_timeout_ms(id),
            extra,
            no_activate,
            smoke_allow_powershell
        );
        // GUI journeys on shared runners are load-sensitive: transient races
        // (pump reclamation, projection lag, input delivery) pass on a second
        // attempt while genuine regressions fail deterministically both
        // times. One bounded retry keeps the gate honest without turning
        // every transient into a 35-minute qualification iteration.
        let smoke_context = context;
        let smoke_timing = timing;
        let smoke_sequence = sequence;
        try {
            let completed = run_gate(
                context,
                timing,
                id,
                id,
                smoke_spec,
                repo,
                scratch,
                sequence
            );
            smoke_context = map_context(completed);
            smoke_timing = map_timing(completed);
            smoke_sequence = map_sequence(completed);
        } catch (first_failure) {
            print(
                "RETRY " + id + " after transient failure: " +
                    "" + first_failure
            );
            try {
                let completed = run_gate(
                    context,
                    timing,
                    id,
                    id + " (retry)",
                    smoke_spec,
                    repo,
                    scratch,
                    sequence + 1000
                );
                smoke_context = map_context(completed);
                smoke_timing = map_timing(completed);
                smoke_sequence = map_sequence(completed);
            } catch (retry_failure) {
                if id == "remote-ui-upgrade-smoke" {
                    std::fs::try_remove_file(upgrade_fixture);
                }
                throw retry_failure;
            }
        }
        if id == "remote-ui-upgrade-smoke" {
            std::fs::try_remove_file(upgrade_fixture);
        }
        context = smoke_context;
        timing = smoke_timing;
        sequence = pass_int(smoke_sequence);
        smoke_index += 1;
    }
}

let diagnostic = task(
    worker,
    manifest,
    "diagnostic-bundle-selftest",
    60000,
    empty_extra,
    #{"AGENTERM_NO_ACTIVATE":"1"},
    0
);
if skip_smoke != 0 {
    timing = wrap_timing_set_gate(
        timing,
        "diagnostic-bundle-selftest",
        "skipped",
        0,
        0,
        0
    );
} else {
    let diagnostic_gate = run_gate(
        context,
        timing,
        "diagnostic-bundle-selftest",
        "CLI GUI and script diagnostic bundle self-test",
        diagnostic,
        repo,
        scratch,
        sequence
    );
    context = map_context(diagnostic_gate);
    timing = map_timing(diagnostic_gate);
    sequence = map_sequence(diagnostic_gate);
}
if skip_smoke != 0 {
    print("\nQUALIFICATION RECEIPT NOT WRITTEN: smoke gates were skipped.");
} else if include_stress == 0 {
    print(
        "\nQUALIFICATION RECEIPT NOT WRITTEN: explicit stress gate was not included."
    );
} else {
    try {
        let written =
            wrap_write_receipt(context, repo, receipt_path);
        print("\nQUALIFICATION RECEIPT " + written);
    } catch (error) {
        timing = wrap_timing_fail_stage(
            timing,
            "qualification-receipt"
        );
        throw error;
    }
}
timing = wrap_timing_finish(
    timing,
    "passed"
);
print("\nSlowest completed gates:");
let gate_results = context.results;
let slow_gate_ids = copy_string_list(timing_gate_ids);
let slow_ids = empty_task_extra();
let slow_durations = empty_task_extra();
slowest_fill(gate_results, slow_gate_ids, slow_ids, slow_durations);
let count = 0 + slow_ids.len;
if count > 8 {
    count = 8;
}
let index = 0;
while index < count {
    print(
        "  " + slow_ids[index] + ": " +
            slow_durations[index] + " ms"
    );
    index += 1;
}
print(
    "Total quality gate: " +
        (
            std::time::SystemTime::now().unix_millis - full_started
        ) +
        " ms"
);
print("\nPASS: AgenTerm quality gate");
    0;
}
