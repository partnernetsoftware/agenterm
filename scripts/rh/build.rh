// Build and optionally stage AgenTerm through one manifest-owned lifecycle.
//
// Args:
//   REPO [release-fast|release|dev]
//        [--target TRIPLE] [--driver cargo|cargo-xwin|cargo-zigbuild]
//        [--glibc VERSION]
//        [--os windows|linux|macos] [--arch x86_64|aarch64]
//        [--clients-only] [--action build|clippy]
//
// Default profile is release-fast: optimized PE staged to dist/, while
// target/debug remains the pure debug cargo layout (only via explicit "dev").
// Whole-root incremental manifest production belongs only to the native
// Windows dev lane that reaches both stage-build and prune. Unix bootstrap
// and cross-client lanes return after artifact listing and report this
// producer as not applicable; they do not claim cleanup integration.

import "scripts/rh/lib/artifact_files" as artifact_files;
import "scripts/rh/lib/build_identity" as build_identity;
import "scripts/rh/lib/bootstrap_timing" as bootstrap_timing;

fn bootstrap_facts() {
    bootstrap_timing::facts()
}

fn require(condition, message) {
    if condition == 0 {
        throw message;
    } else {
        0;
    }
}

fn direct_file(path) {
    if !std::fs::exists(path) {
        return 0;
    }
    let metadata = std::fs::symlink_metadata(path);
    if metadata.is_file
            && !metadata.is_symlink
            && !metadata.is_reparse_point {
        return 1;
    }
    0
}

fn cleanup_incremental_state(path) {
    if path == "" || !std::fs::exists(path) {
        return 0;
    }
    std::fs::remove_dir_all(path);
    0
}

fn promote_bootstrap_worker(repo, candidate, cache_name) {
    if !std::env::has("AGENTERM_BOOTSTRAP_CACHE_WORKER")
            || !std::env::has("AGENTERM_BOOTSTRAP_CACHE_STAMP")
            || !std::env::has("AGENTERM_BOOTSTRAP_FINGERPRINT") {
        return 0;
    }
    require(direct_file(candidate) != 0, "build_bootstrap_candidate_missing");
    let self_check = std::process::command_status(
        candidate,
        ["rh", "version"],
        30000,
        #{ current_dir: repo }
    );
    require(self_check == 0, "build_bootstrap_candidate_self_check");

    let cache_worker = std::path::absolute(
        std::env::get("AGENTERM_BOOTSTRAP_CACHE_WORKER")
    ).display;
    let cache_stamp = std::path::absolute(
        std::env::get("AGENTERM_BOOTSTRAP_CACHE_STAMP")
    ).display;
    let nonce = "" + std::process::id() + "-" +
        std::time::SystemTime::now().unix_millis;
    let worker_temp = cache_worker + ".next-" + nonce;
    let stamp_temp = cache_stamp + ".next-" + nonce;
    let hash_output = cache_stamp + ".hash-" + nonce;
    std::fs::copy(candidate, worker_temp);
    let hash_code = std::process::command_stdout_file(
        "git",
        ["hash-object", "--", worker_temp],
        10000,
        hash_output,
        #{ current_dir: repo }
    );
    require(hash_code == 0, "build_bootstrap_candidate_hash");
    let worker_hash = std::fs::read_to_string(hash_output);
    worker_hash.trim();
    std::fs::try_remove_file(hash_output);
    std::fs::write(
        stamp_temp,
        "2 " + std::env::get("AGENTERM_BOOTSTRAP_FINGERPRINT") + " " +
            worker_hash + "\n"
    );
    // The task executes from an invocation copy, never from CACHE_WORKER, so
    // the fixed LKG path is not an in-use image here. Complete both temporary
    // files before replacing either destination. A crash between replacements
    // leaves a hash mismatch and forces a clean seed instead of trusting bytes
    // with stale provenance.
    if std::fs::exists(cache_worker) {
        require(
            std::fs::try_remove_file(cache_worker) == 1,
            "build_bootstrap_cache_worker_replace"
        );
    }
    std::fs::rename(worker_temp, cache_worker);
    if std::fs::exists(cache_stamp) {
        require(
            std::fs::try_remove_file(cache_stamp) == 1,
            "build_bootstrap_cache_stamp_replace"
        );
    }
    std::fs::rename(stamp_temp, cache_stamp);
    print("AgenTerm bootstrap worker: promoted last-known-good agenterm");
    // 1 = the candidate was proven (direct_file + `rh version` self-check) and
    // may be adopted as the engine for the remaining nested tasks. The early
    // return above yields 0: nothing was validated, so the caller must keep the
    // bootstrap worker.
    1
}

fn target_arch(target) {
    // Bind before map literal — native packs reject if-expr as JSON values.
    if target.starts_with("aarch64") {
        return "aarch64";
    }
    "x86_64"
}

fn target_facts(target) {
    let arch = target_arch(target);
    if target.contains("windows") {
        return #{
            os: "windows",
            arch: arch
        };
    }
    if target.contains("apple") {
        return #{
            os: "macos",
            arch: arch
        };
    }
    if target.contains("linux") {
        return #{
            os: "linux",
            arch: arch
        };
    }
    #{ os: "", arch: "" }
}

fn platform_executables(repo, os_name, target_arch_name) {
    // Bind path before parse_file; keep JSON return type by ending on `executables`
    // (a trailing require poisons infer_return_kind as INT).
    let arch_label = "" + target_arch_name;
    let manifest_path =
        std::path::join(repo, "scripts/artifacts.json").display;
    let manifest = rh::json::parse_file(manifest_path);
    let executables = [];
    let found = 0;
    for platform in manifest.platforms {
        if platform.os == os_name && platform.arch == arch_label {
            require(
                found == 0,
                "build_platform_manifest_match:" + os_name + "-" + arch_label
            );
            found = 1;
            for executable in platform.executables {
                executables.push(executable);
            }
        }
    }
    require(
        found == 1,
        "build_platform_manifest_match:" + os_name + "-" + arch_label
    );
    executables
}

fn platform_libraries(repo, os_name, target_arch_name) {
    let arch_label = "" + target_arch_name;
    let manifest_path =
        std::path::join(repo, "scripts/artifacts.json").display;
    let manifest = rh::json::parse_file(manifest_path);
    let libraries = [];
    let found = 0;
    for platform in manifest.platforms {
        if platform.os == os_name && platform.arch == arch_label {
            require(
                found == 0,
                "build_platform_library_match:" + os_name + "-" + arch_label
            );
            found += 1;
            for library in platform.libraries {
                libraries.push(library);
            }
        }
    }
    require(
        found == 1,
        "build_platform_library_match:" + os_name + "-" + arch_label
    );
    libraries
}

fn cargo_binary(name) {
    if name == "agenterm.com" {
        return "agenterm-com";
    }
    if name.ends_with(".exe") {
        return name.sub_string(0, name.len - 4);
    }
    name
}

fn repo_dir(repo_arg) {
    std::path::absolute(repo_arg).display
}

fn entry() {
    require(args.len >= 1, "expected: REPO [PROFILE] [OPTIONS]");
    let repo_arg = args[0];
    let repo = repo_dir(repo_arg);
    let bootstrap = bootstrap_facts();
    print("AgenTerm bootstrap timing: " + rh::json::stringify(bootstrap));
    // Stage optimized PE by default. Debug PE stays under target/debug unless the
    // caller explicitly asks for "dev" (still may stage to dist for rare debug
    // black-box cases).
    let profile = "release-fast";
    let profile_set = 0;
    let target = "";
    let driver = "cargo";
    // Empty means "whatever the build host happens to have". `cargo-zigbuild`
    // takes a `<triple>.<glibc>` target and links against that version's stubs,
    // which is how one host produces a binary that runs on distributions older
    // than itself. Output paths keep the plain triple.
    let glibc = "";
    let os_name = "";
    let arch = "";
    let clients_only = 0;
    let action = "build";
    let index = 1;
    while index < args.len {
        let value = "" + args[index];
        if value == "release" || value == "release-fast" || value == "dev" {
            require(profile_set == 0, "build_profile_duplicate");
            profile = value;
            profile_set = 1;
        } else if value == "--target" {
            require(index + 1 < args.len, "build_option_value_missing:" + value);
            target = args[index + 1];
            index += 1;
        } else if value == "--glibc" {
            require(index + 1 < args.len, "build_option_value_missing:" + value);
            glibc = args[index + 1];
            index += 1;
        } else if value == "--driver" {
            require(index + 1 < args.len, "build_option_value_missing:" + value);
            driver = args[index + 1];
            index += 1;
        } else if value == "--os" {
            require(index + 1 < args.len, "build_option_value_missing:" + value);
            os_name = args[index + 1];
            index += 1;
        } else if value == "--arch" {
            require(index + 1 < args.len, "build_option_value_missing:" + value);
            arch = args[index + 1];
            index += 1;
        } else if value == "--action" {
            require(index + 1 < args.len, "build_option_value_missing:" + value);
            action = args[index + 1];
            index += 1;
        } else if value == "--clients-only" {
            clients_only = 1;
        } else {
            throw "build_unknown_argument:" + value;
        }
        index += 1;
    }
    require(
        driver == "cargo" || driver == "cargo-xwin" || driver == "cargo-zigbuild",
        "build_driver:" + driver
    );
    require(
        action == "build" || action == "clippy",
        "build_action:" + action
    );
    require(
        target != "" || driver == "cargo",
        "build_xwin_requires_target"
    );
    require(
        glibc == "" || driver == "cargo-zigbuild",
        "build_glibc_requires_zigbuild:" + driver
    );
    if target != "" {
        let facts = target_facts(target);
        require(facts.os != "", "build_target_unsupported:" + target);
        if os_name == "" {
            os_name = "" + facts.os;
        }
        if arch == "" {
            arch = "" + facts.arch;
        }
        require(
            os_name == facts.os && arch == facts.arch,
            "build_target_platform_mismatch"
        );
    }
    if os_name == "" && std::env::has("AGENTERM_HOST_OS") {
        os_name = std::env::get("AGENTERM_HOST_OS");
    }
    if arch == "" && std::env::has("AGENTERM_HOST_ARCH") {
        arch = std::env::get("AGENTERM_HOST_ARCH");
    }

    require(
        std::env::has("AGENTERM_BOOTSTRAP_WORKER"),
        "build_bootstrap_worker_missing"
    );
    let worker =
        std::path::absolute(std::env::get("AGENTERM_BOOTSTRAP_WORKER")).display;
    let task_manifest = std::path::join(repo, "agenterm.tasks.json").display;
    let dist = std::path::join(repo, "dist").display;
    let cross_client = 0;
    if clients_only != 0 || target != "" {
        cross_client = 1;
    }
    let unix_bootstrap = 0;
    if std::env::has("AGENTERM_BOOTSTRAP_PLATFORM")
            && std::env::get("AGENTERM_BOOTSTRAP_PLATFORM") == "unix" {
        unix_bootstrap = 1;
    }
    if cross_client != 0 || unix_bootstrap != 0 {
        require(os_name != "" && arch != "", "build_platform_missing");
    }

    let external_target = 0;
    if std::env::has("CARGO_TARGET_DIR") {
        external_target = 1;
    }
    let cargo_output = std::path::join(repo, "target").display;
    if external_target != 0 {
        cargo_output =
            std::path::absolute(std::env::get("CARGO_TARGET_DIR")).display;
    } else if profile == "release"
            && cross_client == 0
            && unix_bootstrap == 0 {
        cargo_output = std::path::join(repo, "target-release").display;
    }
    let development_target = std::path::join(repo, "target").display;
    // `-Z build-std` and the dedicated-profile merges below need an explicit
    // target even for a native build. Without one, Cargo can compile
    // compiler_builtins with host-dependency semantics, leaving target
    // intrinsics unresolved at the final link.
    let explicit_target = target;
    if explicit_target == "" {
        let rustc_host_path = repo + ".build-rustc-host.tmp";
        let rustc_host_code = std::process::command_stdout_file(
            "rustc",
            ["-vV"],
            10000,
            rustc_host_path,
            #{ current_dir: repo }
        );
        require(rustc_host_code == 0, "build_rustc_host");
        let rustc_metadata = std::fs::read_to_string(rustc_host_path);
        std::fs::try_remove_file(rustc_host_path);
        for source_line in rustc_metadata.split("\n") {
            let line = source_line;
            line.trim();
            if line.starts_with("host: ") {
                explicit_target = line;
                explicit_target.replace("host: ", "");
                explicit_target.trim();
                break;
            }
        }
        require(explicit_target != "", "build_rustc_host_missing");
        let explicit_facts = target_facts(explicit_target);
        require(
            explicit_facts.os != "",
            "build_rustc_host_unsupported:" + explicit_target
        );
    }
    let profile_name = profile;
    if profile == "dev" {
        profile_name = "debug";
    }
    let cargo_profile_root = cargo_output;
    if target != "" {
        cargo_profile_root = std::path::join(cargo_output, target).display;
    }
    let profile_directory =
        std::path::join(cargo_profile_root, profile_name).display;

    let identity = build_identity::facts(repo, profile);
    let environment = build_identity::environment(identity);

    let incremental_producer = 0;
    let incremental_invocation = "";
    let incremental_state = "";
    let incremental_manifest = "";
    let incremental_root = "";
    let stable_wrapper = "";
    if profile == "dev"
            && action == "build"
            && external_target == 0
            && cross_client == 0
            && unix_bootstrap == 0 {
        if std::env::has("AGENTERM_BOOTSTRAP_CACHE_WORKER") {
            let candidate = std::path::absolute(
                std::env::get("AGENTERM_BOOTSTRAP_CACHE_WORKER")
            ).display;
            if direct_file(candidate) != 0 {
                stable_wrapper = candidate;
                incremental_invocation =
                    "build-" + std::process::id() + "-" +
                        std::time::SystemTime::now().unix_millis;
                incremental_root = std::path::join(
                    cargo_output,
                    "debug/incremental"
                ).display;
                let state_parent = std::path::join(
                    cargo_output,
                    "debug/.agenterm-incremental"
                ).display;
                incremental_state = std::path::join(
                    state_parent,
                    incremental_invocation
                ).display;
                require(
                    !std::fs::exists(incremental_state),
                    "build_incremental_state_collision"
                );
                std::fs::create_dir_all(incremental_root);
                std::fs::create_dir_all(incremental_state);
                incremental_manifest = std::path::join(
                    incremental_state,
                    "manifest.json"
                ).display;
                // RUSTC_WRAPPER deliberately names the stable bootstrap cache
                // worker. The per-run task copy must never enter Cargo's compiler
                // identity or turn a hot build into a rebuild.
                incremental_producer = 1;
                print(
                    "AgenTerm incremental root cleanup: " +
                        "producer_state=enabled, lane=native-windows-dev"
                );
            } else {
                print(
                    "AgenTerm incremental root cleanup: producer_state=disabled, " +
                        "stable bootstrap cache worker is absent or indirect"
                );
            }
        } else {
            print(
                "AgenTerm incremental root cleanup: producer_state=disabled, " +
                    "AGENTERM_BOOTSTRAP_CACHE_WORKER is absent"
            );
        }
    } else {
        print(
            "AgenTerm incremental root cleanup: producer_state=not-applicable, " +
                "lane does not own stage-and-prune"
        );
    }

    if incremental_producer != 0 {
        environment = build_identity::environment_with_incremental(
            identity,
            stable_wrapper,
            incremental_invocation,
            cargo_output,
            incremental_root,
            incremental_state
        );
    } else if external_target == 0
            && profile == "release"
            && cross_client == 0
            && unix_bootstrap == 0 {
        environment = build_identity::environment_with_cargo_target(
            identity,
            cargo_output
        );
    }

    // A live dev instance started from the profile directory holds its PE
    // image open, so the cargo bin uplift fails with "failed to remove file
    // ... (os error 5)" — and the linker can hit the same image again through
    // the deps\ hardlink twin (underscored stem). Reap unlocked parked
    // copies, then park every top-level AgenTerm executable (any workspace
    // bin can be the running one, not just shipped artifacts) plus its deps
    // twin via a same-volume rename before cargo runs; launching the app
    // must never block a rebuild.
    if action == "build" && cross_client == 0 && unix_bootstrap == 0 {
        let unlock_manifest_path =
            std::path::join(repo, "scripts/artifacts.json").display;
        let output_directories = [profile_directory];
        for output_directory in output_directories {
            let deps_directory =
                std::path::join(output_directory, "deps").display;
            if !std::fs::exists(output_directory) {
                continue;
            }
            let _reaped = artifact_files::clean_locked(
                output_directory,
                unlock_manifest_path
            );
            if std::fs::exists(deps_directory) {
                let _deps_reaped = artifact_files::clean_locked(
                    deps_directory,
                    unlock_manifest_path
                );
            }
            for entry in std::fs::read_dir(output_directory) {
                let name = "" + entry.file_name;
                if entry.is_file
                    && name.starts_with("agenterm")
                    && name.ends_with(".exe")
                    && !name.contains(".locked-") {
                    let _parked = artifact_files::unlock_output(
                        output_directory,
                        name
                    );
                    let twin = name;
                    twin.replace("-", "_");
                    let twin_path =
                        std::path::join(deps_directory, twin).display;
                    if std::fs::exists(twin_path) {
                        let _twin_parked = artifact_files::unlock_output(
                            deps_directory,
                            twin
                        );
                    }
                }
            }
        }
    }

    // `cargo xwin <action>` wraps both actions through the normal `cargo` driver.
    // `cargo-zigbuild` is invoked as its own program instead, because its build
    // action is named `zigbuild` and `cargo zigbuild clippy` is not a thing --
    // only `cargo-zigbuild clippy` is.
    //
    // Clippy has to go through the wrapper too, even though it emits metadata
    // rather than linking: `ring` compiles C in its build script, so a cross
    // target still needs zig's `cc` in the environment. Plain `cargo clippy
    // --target <linux>` from macOS fails at "failed to run custom build command
    // for ring" -- measured, not assumed.
    let cargo_program = "cargo";
    let cargo_args = [];
    if driver == "cargo-xwin" {
        cargo_args.push("xwin");
        cargo_args.push(action);
    } else if driver == "cargo-zigbuild" {
        cargo_program = "cargo-zigbuild";
        if action == "build" {
            cargo_args.push("zigbuild");
        } else {
            cargo_args.push(action);
        }
    } else {
        cargo_args.push(action);
    }
    cargo_args.push("--locked");
    if profile == "release" {
        cargo_args.push("--release");
    } else if profile == "release-fast" {
        cargo_args.push("--profile");
        cargo_args.push("release-fast");
    }
    if target != "" {
        cargo_args.push("--target");
        if glibc == "" {
            cargo_args.push(target);
        } else {
            cargo_args.push(target + "." + glibc);
        }
    }
    let executable_entries = [];
    let library_entries = [];
    if cross_client != 0 || unix_bootstrap != 0 {
        executable_entries = platform_executables(repo, os_name, arch);
        library_entries = platform_libraries(repo, os_name, arch);
        cargo_args.push("--package");
        cargo_args.push("agenterm");
        cargo_args.push("--package");
        cargo_args.push("agenterm-cu");
        for executable in executable_entries {
            let executable_name = "" + executable.name;
            cargo_args.push("--bin");
            cargo_args.push(cargo_binary(executable_name));
        }
    } else {
        cargo_args.push("--package");
        cargo_args.push("agenterm");
        if os_name == "windows" {
            cargo_args.push("--package");
            cargo_args.push("agenterm-cu");
        }
    }
    if action == "clippy" {
        cargo_args.push("--");
        cargo_args.push("-D");
        cargo_args.push("warnings");
    }

    let stdout_path = repo + ".build.stdout.tmp";
    let stderr_path = repo + ".build.stderr.tmp";
    let cargo_command = std::process::command(cargo_program);
    cargo_command.args(cargo_args);
    cargo_command.current_dir(repo);
    cargo_command.timeout(std::time::Duration::from_millis(3600000));
    cargo_command.stdout_file(stdout_path);
    // cargo reports all progress and diagnostics on stderr. Interactively,
    // stream it live (the "build shows nothing" complaint). On CI (the
    // GITHUB-set CI env), the framed task worker pipes and discards
    // inherited streams, so failures lost their rustc diagnostics — there,
    // capture to a file and replay it into the failure message instead;
    // nobody watches a CI build live anyway.
    let stream_stderr = 1;
    if std::env::has("CI") {
        stream_stderr = 0;
    }
    if stream_stderr != 0 {
        cargo_command.stderr_inherit();
    } else {
        cargo_command.stderr_file(stderr_path);
    }
    let environment_text = rh::json::stringify(environment);
    if environment_text.contains("\"AGENTERM_BUILD_IDENTITY_VERSION\":") != 0 {
        cargo_command.env("AGENTERM_BUILD_IDENTITY_VERSION", "" + environment.AGENTERM_BUILD_IDENTITY_VERSION);
        cargo_command.env("AGENTERM_BUILD_GIT_COMMIT", "" + environment.AGENTERM_BUILD_GIT_COMMIT);
        cargo_command.env("AGENTERM_BUILD_GIT_DIRTY", "" + environment.AGENTERM_BUILD_GIT_DIRTY);
        cargo_command.env("AGENTERM_BUILD_CARGO_LOCK_SHA256", "" + environment.AGENTERM_BUILD_CARGO_LOCK_SHA256);
        cargo_command.env("AGENTERM_BUILD_ARTIFACT_MANIFEST_SHA256", "" + environment.AGENTERM_BUILD_ARTIFACT_MANIFEST_SHA256);
        cargo_command.env("AGENTERM_BUILD_PROFILE", "" + environment.AGENTERM_BUILD_PROFILE);
    }
    if environment_text.contains("\"CARGO_TARGET_DIR\":") != 0 {
        cargo_command.env("CARGO_TARGET_DIR", "" + environment.CARGO_TARGET_DIR);
    }
    if environment_text.contains("\"RUSTC_WRAPPER\":") != 0 {
        cargo_command.env("RUSTC_WRAPPER", "" + environment.RUSTC_WRAPPER);
        cargo_command.env("AGENTERM_INTERNAL_RUSTC_WRAPPER", "" + environment.AGENTERM_INTERNAL_RUSTC_WRAPPER);
        cargo_command.env("AGENTERM_INCREMENTAL_INVOCATION_ID", "" + environment.AGENTERM_INCREMENTAL_INVOCATION_ID);
        cargo_command.env("AGENTERM_INCREMENTAL_TARGET", "" + environment.AGENTERM_INCREMENTAL_TARGET);
        cargo_command.env("AGENTERM_INCREMENTAL_ROOT", "" + environment.AGENTERM_INCREMENTAL_ROOT);
        cargo_command.env("AGENTERM_INCREMENTAL_STATE", "" + environment.AGENTERM_INCREMENTAL_STATE);
    }
    let cargo_result = cargo_command.output();
    let cargo_code = cargo_result.exit_code;
    if cargo_code != 0 {
        if incremental_producer != 0 {
            cleanup_incremental_state(incremental_state);
        }
        let cargo_failure_stdout = std::fs::read_to_string(stdout_path);
        cargo_failure_stdout.trim();
        if cargo_failure_stdout != "" {
            print(cargo_failure_stdout);
        }
        std::fs::try_remove_file(stdout_path);
        let failure_detail = "stderr_streamed_above";
        if stream_stderr == 0 {
            let cargo_failure_stderr = std::fs::read_to_string(stderr_path);
            cargo_failure_stderr.trim();
            failure_detail = cargo_failure_stderr;
            std::fs::try_remove_file(stderr_path);
        }
        require(
            cargo_code == 0,
            "build_cargo:exit=" + cargo_code + ":" + failure_detail
        );
    }
    let cargo_stdout = std::fs::read_to_string(stdout_path);
    cargo_stdout.trim();
    if cargo_stdout != "" {
        print(cargo_stdout);
    }
    std::fs::try_remove_file(stdout_path);
    std::fs::try_remove_file(stderr_path);

    // libagenterm is a C ABI boundary and must retain unwind support. Build it
    // under the dedicated ABI profile, then merge only the dynamic library into the normal
    // profile directory consumed by staging and cross-platform packaging.
    if action == "build" && (os_name == "windows" || library_entries.len > 0) {
        let abi_profile_name = "abi-release";
        if profile == "dev" {
            abi_profile_name = "abi-dev";
        }
        let abi_program = "cargo";
        let abi_args = [];
        if driver == "cargo-xwin" {
            abi_args.push("xwin");
            abi_args.push("build");
        } else if driver == "cargo-zigbuild" {
            abi_program = "cargo-zigbuild";
            abi_args.push("zigbuild");
        } else {
            abi_args.push("build");
        }
        abi_args.push("--locked");
        abi_args.push("--profile");
        abi_args.push(abi_profile_name);
        abi_args.push("--target");
        if glibc == "" {
            abi_args.push(explicit_target);
        } else {
            abi_args.push(explicit_target + "." + glibc);
        }
        abi_args.push("--package");
        abi_args.push("agenterm-abi");
        let abi_command = std::process::command(abi_program);
        abi_command.args(abi_args);
        abi_command.current_dir(repo);
        abi_command.timeout(std::time::Duration::from_millis(3600000));
        if stream_stderr != 0 {
            abi_command.stderr_inherit();
        }
        if environment_text.contains("\"AGENTERM_BUILD_IDENTITY_VERSION\":") != 0 {
            abi_command.env("AGENTERM_BUILD_IDENTITY_VERSION", "" + environment.AGENTERM_BUILD_IDENTITY_VERSION);
            abi_command.env("AGENTERM_BUILD_GIT_COMMIT", "" + environment.AGENTERM_BUILD_GIT_COMMIT);
            abi_command.env("AGENTERM_BUILD_GIT_DIRTY", "" + environment.AGENTERM_BUILD_GIT_DIRTY);
            abi_command.env("AGENTERM_BUILD_CARGO_LOCK_SHA256", "" + environment.AGENTERM_BUILD_CARGO_LOCK_SHA256);
            abi_command.env("AGENTERM_BUILD_ARTIFACT_MANIFEST_SHA256", "" + environment.AGENTERM_BUILD_ARTIFACT_MANIFEST_SHA256);
            abi_command.env("AGENTERM_BUILD_PROFILE", "" + environment.AGENTERM_BUILD_PROFILE);
        }
        if environment_text.contains("\"CARGO_TARGET_DIR\":") != 0 {
            abi_command.env("CARGO_TARGET_DIR", "" + environment.CARGO_TARGET_DIR);
        }
        let abi_output = abi_command.output();
        require(
            abi_output.success != 0,
            "build_abi_cargo:" + abi_output.stdout_text() + abi_output.stderr_text()
        );
        let abi_root = std::path::join(cargo_output, explicit_target).display;
        let abi_directory =
            std::path::join(abi_root, abi_profile_name).display;
        let abi_library_name = "agenterm.dll";
        if os_name == "linux" {
            abi_library_name = "libagenterm.so";
        } else if os_name == "macos" {
            abi_library_name = "libagenterm.dylib";
        }
        let abi_source =
            std::path::join(abi_directory, abi_library_name).display;
        let abi_destination =
            std::path::join(profile_directory, abi_library_name).display;
        require(
            direct_file(abi_source) != 0,
            "build_abi_artifact_source:" + abi_source
        );
        std::fs::try_remove_file(abi_destination);
        require(
            std::fs::try_copy(abi_source, abi_destination) == 1,
            "build_abi_artifact_copy:" + abi_source
        );
        require(
            direct_file(abi_destination) != 0,
            "build_abi_artifact_destination:" + abi_destination
        );
    }

    if action == "build" && external_target == 0 && cross_client == 0 {
        let bootstrap_name = "agenterm";
        if os_name == "windows" {
            bootstrap_name = "agenterm.exe";
        }
        let promoted_worker =
            std::path::join(profile_directory, bootstrap_name).display;
        let promoted = promote_bootstrap_worker(
            repo,
            promoted_worker,
            bootstrap_name
        );
        // The LKG may only be old enough to seed the current source. Once the
        // candidate proves its rh entry, use that engine for every remaining
        // nested task so new task syntax/API never falls back mid-build.
        //
        // Adopt it only when the file is actually there. Without the bootstrap
        // cache environment promote_bootstrap_worker is a no-op that validates
        // nothing, so its return value alone cannot vouch for the path.
        let _promoted = promoted;
        if direct_file(promoted_worker) != 0 {
            worker = promoted_worker;
        }
    }

    if action == "clippy" {
        if target != "" {
            print(
                "PASS client Clippy " + os_name + "-" + arch +
                    " (" + target + ")"
            );
        } else {
            print(
                "PASS client Clippy " + os_name + "-" + arch
            );
        }
        return 0;
    }
    if cross_client != 0 || unix_bootstrap != 0 {
        print("");
        print(
            "Built client artifacts [" + profile + ", " +
                os_name + "-" + arch + "]:"
        );
        for executable in executable_entries {
            print(
                "  " +
                    std::path::join(
                        profile_directory,
                        executable.name
                    ).display
            );
        }
        for library in library_entries {
            print(
                "  " +
                    std::path::join(
                        profile_directory,
                        library.name
                    ).display
            );
        }
        return 0;
    }

    let stage_command = std::process::command(worker);
    stage_command.args([
        "rh", "task", "run", "stage-build",
        "--manifest", task_manifest,
        "--", repo, profile_directory, dist, profile
    ]);
    stage_command.current_dir(repo);
    stage_command.timeout(std::time::Duration::from_millis(30000));
    stage_command.capture_limit(262144);
    if environment_text.contains("\"AGENTERM_BUILD_IDENTITY_VERSION\":") != 0 {
        stage_command.env("AGENTERM_BUILD_IDENTITY_VERSION", "" + environment.AGENTERM_BUILD_IDENTITY_VERSION);
        stage_command.env("AGENTERM_BUILD_GIT_COMMIT", "" + environment.AGENTERM_BUILD_GIT_COMMIT);
        stage_command.env("AGENTERM_BUILD_GIT_DIRTY", "" + environment.AGENTERM_BUILD_GIT_DIRTY);
        stage_command.env("AGENTERM_BUILD_CARGO_LOCK_SHA256", "" + environment.AGENTERM_BUILD_CARGO_LOCK_SHA256);
        stage_command.env("AGENTERM_BUILD_ARTIFACT_MANIFEST_SHA256", "" + environment.AGENTERM_BUILD_ARTIFACT_MANIFEST_SHA256);
        stage_command.env("AGENTERM_BUILD_PROFILE", "" + environment.AGENTERM_BUILD_PROFILE);
    }
    if environment_text.contains("\"CARGO_TARGET_DIR\":") != 0 {
        stage_command.env("CARGO_TARGET_DIR", "" + environment.CARGO_TARGET_DIR);
    }
    if environment_text.contains("\"RUSTC_WRAPPER\":") != 0 {
        stage_command.env("RUSTC_WRAPPER", "" + environment.RUSTC_WRAPPER);
        stage_command.env("AGENTERM_INTERNAL_RUSTC_WRAPPER", "" + environment.AGENTERM_INTERNAL_RUSTC_WRAPPER);
        stage_command.env("AGENTERM_INCREMENTAL_INVOCATION_ID", "" + environment.AGENTERM_INCREMENTAL_INVOCATION_ID);
        stage_command.env("AGENTERM_INCREMENTAL_TARGET", "" + environment.AGENTERM_INCREMENTAL_TARGET);
        stage_command.env("AGENTERM_INCREMENTAL_ROOT", "" + environment.AGENTERM_INCREMENTAL_ROOT);
        stage_command.env("AGENTERM_INCREMENTAL_STATE", "" + environment.AGENTERM_INCREMENTAL_STATE);
    }
    let stage_result = stage_command.output();
    let stage_code = stage_result.exit_code;
    let stage_stdout = stage_result.stdout_text();
    let stage_stderr = stage_result.stderr_text();
    if stage_stdout != "" {
        print(stage_stdout);
    }
    if stage_stderr != "" {
        print(stage_stderr);
    }
    if stage_code != 0 {
        if incremental_producer != 0 {
            cleanup_incremental_state(incremental_state);
        }
        require(
            stage_code == 0,
            "build_stage:" + stage_stdout + stage_stderr
        );
    }

    if profile == "dev" && external_target == 0 {
        let dev_cleanup_failed = 0;
        let dev_cleanup_error = "";
        if incremental_producer != 0 {
            let finalize_code = std::process::command_status(
                stable_wrapper,
                [
                    "--internal-incremental-finalize",
                    incremental_state,
                    cargo_output,
                    incremental_manifest,
                    incremental_invocation
                ],
                300000,
                #{
                    current_dir: repo,
                    env: environment,
                }
            );
            if finalize_code != 0 {
                dev_cleanup_failed = 1;
                dev_cleanup_error = "finalize:exit=" + finalize_code;
            }
        }
        repo = repo_dir(repo_arg);
        task_manifest = std::path::join(repo, "agenterm.tasks.json").display;
        let prune_arguments = [
            "rh", "task", "run", "prune-target-incremental",
            "--manifest", task_manifest,
            "--", repo, cargo_output
        ];
        if incremental_producer != 0 {
            prune_arguments.push("--manifest");
            prune_arguments.push(incremental_manifest);
            prune_arguments.push("--invocation");
            prune_arguments.push(incremental_invocation);
        }
        if dev_cleanup_failed == 0 {
            let prune_stdout_path = repo + ".build-prune.stdout.tmp";
            let prune_code = std::process::command_stdout_file(
                worker,
                prune_arguments,
                300000,
                prune_stdout_path,
                #{
                    current_dir: repo,
                    env: environment,
                }
            );
            if prune_code != 0 {
                dev_cleanup_failed = 1;
                let prune_stdout = std::fs::read_to_string(prune_stdout_path);
                prune_stdout.trim();
                dev_cleanup_error =
                    "prune:exit=" + prune_code + ":" + prune_stdout;
            }
            std::fs::try_remove_file(prune_stdout_path);
        }
        if dev_cleanup_failed != 0 {
            if incremental_producer != 0 {
                cleanup_incremental_state(incremental_state);
            }
            require(
                dev_cleanup_failed == 0,
                "build_incremental_prune:" + dev_cleanup_error
            );
        }
        if incremental_producer != 0 {
            cleanup_incremental_state(incremental_state);
        }
    }

    // The default release-fast lane stages without the dev-only incremental
    // producer, but its debug/ and release-fast/ incremental caches grow the
    // same way. Prune stale fingerprint generations on every native build so
    // target/ stops growing between explicit dev builds.
    if profile == "release-fast" && external_target == 0 {
        let fast_cleanup_failed = 0;
        let fast_cleanup_error = "";
        let fast_repo = repo_dir(repo_arg);
        let fast_manifest =
            std::path::join(fast_repo, "agenterm.tasks.json").display;
        let fast_prune_stdout = fast_repo + ".build-prune.stdout.tmp";
        let fast_prune_arguments = [
            "rh", "task", "run", "prune-target-incremental",
            "--manifest", fast_manifest,
            "--", fast_repo, cargo_output
        ];
        let fast_prune_code = std::process::command_stdout_file(
            worker,
            fast_prune_arguments,
            300000,
            fast_prune_stdout,
            #{
                current_dir: fast_repo,
                env: environment,
            }
        );
        if fast_prune_code != 0 {
            fast_cleanup_failed = 1;
            let fast_prune_text = std::fs::read_to_string(fast_prune_stdout);
            fast_prune_text.trim();
            fast_cleanup_error =
                "prune:exit=" + fast_prune_code + ":" + fast_prune_text;
        }
        std::fs::try_remove_file(fast_prune_stdout);
        if fast_cleanup_failed != 0 {
            print(
                "WARNING: release-fast incremental prune skipped (" +
                    fast_cleanup_error + ")"
            );
        }
    }

    if profile == "release" && external_target == 0 {
        repo = repo_dir(repo_arg);
        task_manifest = std::path::join(repo, "agenterm.tasks.json").display;
        cargo_output = std::path::join(repo, "target-release").display;
        development_target = std::path::join(repo, "target").display;
        let stdout_path = repo + ".build.stdout.tmp";
        // This block cleans BOTH target trees, and `worker` lives inside one of
        // them (target-release/release/agenterm.exe after the promotion above,
        // or target/debug/agenterm.exe when bootstrapped). `cargo clean` then
        // deletes the binary that the remaining stages still have to spawn --
        // the candidate lane's `process_spawn: os error 3`. Run the cleanup
        // stages from a copy parked outside both trees.
        let cleanup_worker = repo + ".build-cleanup-worker.tmp.exe";
        std::fs::try_remove_file(cleanup_worker);
        std::fs::copy(worker, cleanup_worker);
        // std::fs::exists borrows; direct_file() is a script fn and would move
        // the binding that try_remove_file still needs at the end of the block.
        require(
            std::fs::exists(cleanup_worker),
            "build_cleanup_worker_missing"
        );
        worker = cleanup_worker;
        let report_code = std::process::command_stdout_file(
            worker,
            [
                "rh", "task", "run", "target-report",
                "--manifest", task_manifest,
                "--", cargo_output
            ],
            30000,
            stdout_path,
            #{
                current_dir: repo,
                env: environment,
            }
        );
        require(report_code == 0, "build_target_report");
        let report_stdout = std::fs::read_to_string(stdout_path);
        report_stdout.trim();
        if report_stdout != "" {
            print(report_stdout);
        }
        std::fs::try_remove_file(stdout_path);

        task_manifest = std::path::join(repo_dir(repo_arg), "agenterm.tasks.json").display;
        repo = repo_dir(repo_arg);
        cargo_output = std::path::join(repo, "target-release").display;
        let prepare_code = std::process::command_stdout_file(
            worker,
            [
                "rh", "task", "run", "prepare-target-clean",
                "--manifest", task_manifest,
                "--", repo, cargo_output
            ],
            30000,
            stdout_path,
            #{
                current_dir: repo,
                env: environment,
            }
        );
        require(prepare_code == 0, "build_target_clean_prepare");
        let prepare_stdout = std::fs::read_to_string(stdout_path);
        prepare_stdout.trim();
        if prepare_stdout != "" {
            print(prepare_stdout);
        }
        std::fs::try_remove_file(stdout_path);

        cargo_output = std::path::join(repo_dir(repo_arg), "target-release").display;
        let clean_code = std::process::command_stdout_file(
            "cargo",
            ["clean", "--target-dir", cargo_output],
            3600000,
            stdout_path,
            #{
                current_dir: repo,
                env: environment,
            }
        );
        require(clean_code == 0, "build_target_clean");
        let clean_stdout = std::fs::read_to_string(stdout_path);
        clean_stdout.trim();
        if clean_stdout != "" {
            print(clean_stdout);
        }
        std::fs::try_remove_file(stdout_path);

        task_manifest = std::path::join(repo_dir(repo_arg), "agenterm.tasks.json").display;
        let dev_report_code = std::process::command_stdout_file(
            worker,
            [
                "rh", "task", "run", "target-report",
                "--manifest", task_manifest,
                "--", development_target
            ],
            30000,
            stdout_path,
            #{
                current_dir: repo,
                env: environment,
            }
        );
        require(dev_report_code == 0, "build_development_target_report");
        let dev_report_stdout = std::fs::read_to_string(stdout_path);
        dev_report_stdout.trim();
        if dev_report_stdout != "" {
            print(dev_report_stdout);
        }
        std::fs::try_remove_file(stdout_path);

        task_manifest = std::path::join(repo_dir(repo_arg), "agenterm.tasks.json").display;
        repo = repo_dir(repo_arg);
        let dev_prepare_code = std::process::command_stdout_file(
            worker,
            [
                "rh", "task", "run", "prepare-target-clean",
                "--manifest", task_manifest,
                "--", repo, development_target
            ],
            30000,
            stdout_path,
            #{
                current_dir: repo,
                env: environment,
            }
        );
        require(dev_prepare_code == 0, "build_development_target_clean_prepare");
        let dev_prepare_stdout = std::fs::read_to_string(stdout_path);
        dev_prepare_stdout.trim();
        if dev_prepare_stdout != "" {
            print(dev_prepare_stdout);
        }
        std::fs::try_remove_file(stdout_path);

        development_target = std::path::join(repo_dir(repo_arg), "target").display;
        let dev_clean_code = std::process::command_stdout_file(
            "cargo",
            ["clean", "--target-dir", development_target],
            3600000,
            stdout_path,
            #{
                current_dir: repo,
                env: environment,
            }
        );
        require(dev_clean_code == 0, "build_development_target_clean");
        let dev_clean_stdout = std::fs::read_to_string(stdout_path);
        dev_clean_stdout.trim();
        if dev_clean_stdout != "" {
            print(dev_clean_stdout);
        }
        std::fs::try_remove_file(stdout_path);
        // `worker` is the cleanup copy from here on; naming cleanup_worker again
        // would move a binding the assignment above already consumed.
        std::fs::try_remove_file(worker);
    }

    print("");
    print("Built and staged Windows artifacts [" + profile + "] in " + dist);
    0
}
