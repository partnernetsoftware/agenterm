// Shared filesystem operations for validated AgenTerm build artifacts.

fn clean_locked(directory_value, manifest_path_value) {
    let directory = std::path::absolute(directory_value).display;
    let _manifest_path = "" + manifest_path_value;
    if !std::fs::exists(directory) {
        return 0;
    }
    require(
        std::fs::metadata(directory).is_dir,
        "locked_artifact_directory_not_directory"
    );
    let removed = 0;
    for entry in std::fs::read_dir(directory) {
        let name = "" + entry.file_name;
        // Any parked AgenTerm executable/library: `<stem>.locked-<millis>.<ext>`.
        let locked_artifact = name.starts_with("agenterm")
            && name.contains(".locked-")
            && (
                name.ends_with(".exe")
                    || name.ends_with(".com")
                    || name.ends_with(".dll")
            );
        if entry.is_file && locked_artifact {
            std::fs::try_remove_file(entry.path.display);
            removed += 1;
        }
    }
    removed
}

fn remove_obsolete(directory_value, name_value) {
    let directory = std::path::absolute(directory_value).display;
    let name = "" + name_value;
    require(
        name != ""
            && name != "."
            && name != ".."
            && !name.contains("/")
            && !name.contains("\\"),
        "obsolete_artifact_name_invalid:" + name
    );
    let path = std::path::join(directory, name).display;
    if !std::fs::exists(path) {
        return 0;
    }
    require(
        std::fs::metadata(path).is_file,
        "obsolete_artifact_not_file:" + name
    );
    std::fs::remove_file(path);
    print("Removed obsolete artifact " + name + " from " + directory);
    1
}

fn unlock_output(directory_value, name_value) {
    // Cargo cannot delete or overwrite the PE image of a live instance
    // ("os error 5" at the final bin uplift), but Windows always allows a
    // same-volume rename of a running image. Park the possibly-running
    // output under the shared .locked- naming, restore identical bytes at
    // the original path so an unchanged build does not relink, and drop the
    // parked copy immediately when no process holds it. clean_locked reaps
    // any parked copy that outlives its process.
    let directory = std::path::absolute(directory_value).display;
    let name = "" + name_value;
    // Any workspace bin can be the running image that blocks a rebuild
    // (agenterm-con.exe held a workspace build hostage once), so accept every
    // AgenTerm executable name rather than a shipped-artifact whitelist.
    require(
        name.starts_with("agenterm")
            && name.ends_with(".exe")
            && !name.contains(".locked-")
            && !name.contains("/")
            && !name.contains("\\"),
        "unlock_output_name_invalid:" + name
    );
    let path = std::path::join(directory, name).display;
    if !std::fs::exists(path) {
        return 0;
    }
    let metadata = std::fs::symlink_metadata(path);
    if !metadata.is_file || metadata.is_symlink || metadata.is_reparse_point {
        return 0;
    }
    let stem = name;
    stem.replace(".exe", "");
    let parked_name = stem + ".locked-" +
        std::time::SystemTime::now().unix_millis + ".exe";
    let parked = std::path::join(directory, parked_name).display;
    // Best-effort: a data handle without FILE_SHARE_DELETE (scanner, hasher,
    // concurrent cargo) denies even the rename. Skip such a file rather than
    // failing the build — cargo will report it plainly if it still matters.
    if std::fs::try_rename(path, parked) != 1 {
        return 0;
    }
    if std::fs::try_copy(parked, path) != 1 {
        std::fs::try_rename(parked, path);
        return 0;
    }
    if std::fs::try_remove_file(parked) == 1 {
        return 0;
    }
    print("Parked in-use build output; live image remains at " + parked);
    1
}

fn stage(source_directory_value, destination_directory_value, name_value) {
    let source_directory = std::path::absolute(source_directory_value).display;
    let destination_directory =
        std::path::absolute(destination_directory_value).display;
    let name = "" + name_value;
    require(
        name == "agenterm.exe"
            || name == "agenterm.com"
            || name == "agenterm-cc.exe"
            || name == "agenterm-cu.exe"
            || name == "agenterm.dll"
            || name == "agenterm-rh.exe",
        "stage_artifact_name_invalid:" + name
    );
    require(
        std::fs::exists(source_directory)
            && std::fs::metadata(source_directory).is_dir,
        "stage_artifact_source_directory_invalid:" + source_directory
    );
    std::fs::create_dir_all(destination_directory);

    let source_name = name;
    if name == "agenterm.com" {
        source_name = "agenterm-com.exe";
    }
    let source = std::path::join(source_directory, source_name).display;
    let destination = std::path::join(destination_directory, name).display;
    require(std::fs::exists(source), "stage_artifact_source_missing:" + source);
    let source_metadata = std::fs::symlink_metadata(source);
    require(
        source_metadata.is_file
            && !source_metadata.is_symlink
            && !source_metadata.is_reparse_point,
        "stage_artifact_source_invalid:" + source
    );

    let parked = "";
    if std::fs::exists(destination) {
        let stem = name;
        let extension = ".exe";
        stem.replace(".exe", "");
        if name.ends_with(".com") {
            stem.replace(".com", "");
            extension = ".com";
        } else if name.ends_with(".dll") {
            stem.replace(".dll", "");
            extension = ".dll";
        }
        let parked_name = stem + ".locked-" +
            std::time::SystemTime::now().unix_millis + extension;
        parked = std::path::join(destination_directory, parked_name).display;
        std::fs::rename(destination, parked);
    }
    std::fs::copy(source, destination);
    if parked != "" {
        print("Staged new artifact; previous copy remains at " + parked);
        return 1;
    }
    print("Staged artifact: " + destination);
    0
}
