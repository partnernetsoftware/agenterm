// Stage the validated executable set and publish its provenance atomically.
//
// Args:
//   REPO SOURCE_DIRECTORY DESTINATION_DIRECTORY PROFILE
//
// stage returns INT 0/1 (direct copy / park-replace). Callers discard that INT
// and must not assume the old Rhai #{ destination, parked } map.

import "scripts/rh/lib/artifact_files" as artifact_files;
import "scripts/rh/lib/build_metadata" as build_metadata;

fn entry() {
    if args.len != 4 {
        return rh::fail(
            "expected: REPO SOURCE_DIRECTORY DESTINATION_DIRECTORY PROFILE"
        );
    }

    let repo = std::path::absolute(args[0]).display;
    let source_directory = std::path::absolute(args[1]).display;
    let destination_directory = std::path::absolute(args[2]).display;
    let profile = args[3];
    require(
        profile == "dev"
            || profile == "release-fast"
            || profile == "release",
        "stage_build_profile_invalid:" + profile
    );

    // Reject non-root repos before any destination mutation (create_dir_all /
    // staging). Temp stdout lives beside the destination path, not inside it.
    let stdout_path = destination_directory + ".stage-build.stdout.tmp";
    let code = std::process::command_stdout_file(
        "git",
        ["-C", repo, "rev-parse", "--show-prefix"],
        10000,
        stdout_path
    );
    require(code == 0, "stage-build-git-root");
    let prefix = std::fs::read_to_string(stdout_path);
    prefix.trim();
    require(prefix == "", "stage_build_repo_not_exact_git_root:" + repo);
    std::fs::try_remove_file(stdout_path);

    std::fs::create_dir_all(destination_directory);

    let artifact_manifest_path =
        std::path::join(repo, "scripts/artifacts.json").display;
    let text = std::fs::read_to_string(artifact_manifest_path);
    let manifest = rh::json::parse(text);
    require(
        manifest.schema_version == 2
            && type_of(manifest.executables) == "array"
            && type_of(manifest.libraries) == "array",
        "stage_build_artifact_manifest_invalid"
    );

    let _locked = artifact_files::clean_locked(
        destination_directory,
        artifact_manifest_path
    );
    let obsolete_names = [
        "agentermctl.exe",
        "agenterm-script.exe",
        "agenterm-script",
        "agenterm-cli.exe",
        "agenterm-con-native.exe",
        // The lightweight host left for the `minicon` repository; staged copies
        // from earlier builds must be swept, not shipped.
        "agenterm-con.exe",
        "agenterm-con"
    ];
    for obsolete in obsolete_names {
        let _removed =
            artifact_files::remove_obsolete(destination_directory, obsolete);
    }

    for artifact in manifest.executables {
        let _staged = artifact_files::stage(
            source_directory,
            destination_directory,
            artifact.name
        );
        // The CUI trampoline is deliberately runtime-free in every profile.
        // Enforce its budget during staging, not only at the release gate, so
        // a debug/runtime regression cannot silently return to dist/.
        if artifact.name == "agenterm.com" {
            let staged_path =
                std::path::join(destination_directory, artifact.name).display;
            let staged_bytes = std::fs::metadata(staged_path).len;
            // Coerce the JSON integer via int add before string concat —
            // require() evaluates its message eagerly, and `"" + json_int`
            // raises json_string_path (see candidate-verify.rh's matching
            // note), which made this require fail on every run.
            let budget_bytes = 0 + artifact.release_budget_bytes;
            require(
                staged_bytes <= budget_bytes,
                "stage_build_agenterm_com_budget:actual=" + staged_bytes +
                    ":budget=" + budget_bytes
            );
        }
    }
    for library in manifest.libraries {
        let _staged_library = artifact_files::stage(
            source_directory,
            destination_directory,
            library.name
        );
    }

    let output_manifest =
        std::path::join(destination_directory, "agenterm.json").display;
    let _metadata = build_metadata::write(
        repo,
        output_manifest,
        artifact_manifest_path,
        destination_directory,
        profile
    );

    // Size tracking: append one line per staging to dist/size-history.jsonl
    // (local, untracked — a per-machine trend log) so per-artifact byte
    // growth is observable over time instead of anecdotal. Source of truth
    // is the metadata just written: it already records commit, profile, and
    // each staged executable's size.
    let metadata = rh::json::parse(std::fs::read_to_string(output_manifest));
    let history_entry = #{
        build_time_utc: metadata.build_time_utc,
        git_commit: metadata.git_commit,
        git_dirty: metadata.git_dirty,
        profile: metadata.profile,
        executables: metadata.executables,
        libraries: metadata.libraries,
    };
    let history_path =
        std::path::join(destination_directory, "size-history.jsonl").display;
    let history = "";
    if std::fs::exists(history_path) {
        history = std::fs::read_to_string(history_path);
    }
    std::fs::write(
        history_path,
        history + rh::json::stringify(history_entry) + "\n"
    );

    let _locked_again = artifact_files::clean_locked(
        destination_directory,
        artifact_manifest_path
    );
    let obsolete_names_again = [
        "agentermctl.exe",
        "agenterm-script.exe",
        "agenterm-script",
        "agenterm-cli.exe",
        "agenterm-con-native.exe",
        // The lightweight host left for the `minicon` repository; staged copies
        // from earlier builds must be swept, not shipped.
        "agenterm-con.exe",
        "agenterm-con"
    ];
    for obsolete in obsolete_names_again {
        let _removed_again =
            artifact_files::remove_obsolete(destination_directory, obsolete);
    }

    print(
        "PASS: staged build artifacts and metadata in " + destination_directory
    );
    0
}
