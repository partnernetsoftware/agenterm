// CEO: Linux login-session status honesty with independent loginctl/session-env read-back.
// Acceptance is smoke read-back only: CU login-session status must agree with facts
// derived outside agenterm-cu, or return typed login_session_unsupported with Linux
// systemd-logind alternatives (never macOS claims). Typed login-session usage must
// reject AT-SPI --name, --coords, --bogus, and other unexpected arguments; typed
// get-extents --name usage AND host-limit paths must both hold before the loginctl
// read-back court. Prefer host-limit clarity over fake success. Observe-only; no lock
// apply. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.linux-login-session-readback"];
const AT_SPI_PROBE_NAME = "Login Session Court Anchor";

function ensure(c, m) { if (!c) throw m; }

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(v, d) {
  const current = at(v, d);
  return current === undefined || current === null ? "" : "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function cu_env(exe) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(exe), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const k of [
    "DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS", "AT_SPI_BUS", "XDG_SESSION_ID",
  ]) {
    if (rh.has_env(k)) { env[k] = rh.env_or(k, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_reply(dir, exe, args, env) {
  const out = rh.command(exe, ["--target", "current", "--grant", "observe", "login-session"].concat(args), {
    cwd: dir,
    env: env === undefined ? cu_env(exe) : env,
    timeout_ms: 30000,
  });
  ensure(out.stdout.trim() !== "", "cu_linux_login_session_cli:" + out.stdout + out.stderr);
  const reply = JSON.parse(out.stdout.trim());
  ensure(
    text_at(reply, "command") === "login-session" || text_at(reply, "command") === "usage",
    "cu_linux_login_session_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke(dir, exe, args, ok) {
  const reply = invoke_reply(dir, exe, args);
  ensure(reply.ok === ok, "reply:" + JSON.stringify(reply));
  ensure(
    (ok === true && reply.ok === true) || (ok !== true && reply.ok !== true),
    "cu_linux_login_session_reply_state"
  );
  return reply;
}

function invoke_get_extents_reply(dir, exe, args, env) {
  const out = rh.command(exe, ["--target", "current", "--grant", "observe"].concat(args), {
    cwd: dir,
    env: env === undefined ? cu_env(exe) : env,
    timeout_ms: 30000,
  });
  ensure(out.stdout.trim() !== "", "cu_linux_login_session_extents_cli:" + out.stdout + out.stderr);
  return JSON.parse(out.stdout.trim());
}

function probe_atspi_available(exe) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const out = rh.command("python3", ["-c", script], {
    env: cu_env(exe),
    timeout_ms: 10000,
  });
  return out.success === true && out.stdout.trim() === "1";
}

function assert_login_session_usage_limit(dir, exe, env) {
  const status_with_name = invoke_reply(dir, exe, ["status", "--name", AT_SPI_PROBE_NAME], env);
  ensure(!output_success(status_with_name),
    "cu_linux_login_session_usage_status_name_ok:" + JSON.stringify(status_with_name));
  ensure(
    text_at(status_with_name, "error.code") === "usage",
    "cu_linux_login_session_usage_status_name_code:" + JSON.stringify(status_with_name.error)
  );
  ensure(
    text_at(status_with_name, "command") === "usage",
    "cu_linux_login_session_usage_status_name_command:" + JSON.stringify(status_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(status_with_name, "error.message"), "--name"),
    "cu_linux_login_session_usage_status_name_message:" + JSON.stringify(status_with_name.error)
  );

  const plan_with_name = invoke_reply(dir, exe, ["plan", "lock", "--name", AT_SPI_PROBE_NAME], env);
  ensure(!output_success(plan_with_name),
    "cu_linux_login_session_usage_plan_name_ok:" + JSON.stringify(plan_with_name));
  ensure(
    text_at(plan_with_name, "error.code") === "usage",
    "cu_linux_login_session_usage_plan_name_code:" + JSON.stringify(plan_with_name.error)
  );
  ensure(
    text_at(plan_with_name, "command") === "usage",
    "cu_linux_login_session_usage_plan_name_command:" + JSON.stringify(plan_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(plan_with_name, "error.message"), "--name"),
    "cu_linux_login_session_usage_plan_name_message:" + JSON.stringify(plan_with_name.error)
  );

  const plan_ttl_with_name = invoke_reply(dir, exe,
    ["plan", "lock", "--ttl-seconds", "60", "--name", AT_SPI_PROBE_NAME], env);
  ensure(!output_success(plan_ttl_with_name),
    "cu_linux_login_session_usage_plan_ttl_name_ok:" + JSON.stringify(plan_ttl_with_name));
  ensure(
    text_at(plan_ttl_with_name, "error.code") === "usage",
    "cu_linux_login_session_usage_plan_ttl_name_code:" + JSON.stringify(plan_ttl_with_name.error)
  );
  ensure(
    text_at(plan_ttl_with_name, "command") === "usage",
    "cu_linux_login_session_usage_plan_ttl_name_command:" + JSON.stringify(plan_ttl_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(plan_ttl_with_name, "error.message"), "--name"),
    "cu_linux_login_session_usage_plan_ttl_name_message:" + JSON.stringify(plan_ttl_with_name.error)
  );

  const status_bogus = invoke_reply(dir, exe, ["status", "--bogus"], env);
  ensure(!output_success(status_bogus),
    "cu_linux_login_session_usage_status_bogus_ok:" + JSON.stringify(status_bogus));
  ensure(
    text_at(status_bogus, "error.code") === "usage",
    "cu_linux_login_session_usage_status_bogus_code:" + JSON.stringify(status_bogus.error)
  );
  ensure(
    text_at(status_bogus, "command") === "usage",
    "cu_linux_login_session_usage_status_bogus_command:" + JSON.stringify(status_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(status_bogus, "error.message"), "--bogus"),
    "cu_linux_login_session_usage_status_bogus_message:" + JSON.stringify(status_bogus.error)
  );

  const plan_bogus = invoke_reply(dir, exe, ["plan", "lock", "--bogus"], env);
  ensure(!output_success(plan_bogus),
    "cu_linux_login_session_usage_plan_bogus_ok:" + JSON.stringify(plan_bogus));
  ensure(
    text_at(plan_bogus, "error.code") === "usage",
    "cu_linux_login_session_usage_plan_bogus_code:" + JSON.stringify(plan_bogus.error)
  );
  ensure(
    text_at(plan_bogus, "command") === "usage",
    "cu_linux_login_session_usage_plan_bogus_command:" + JSON.stringify(plan_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(plan_bogus, "error.message"), "--bogus"),
    "cu_linux_login_session_usage_plan_bogus_message:" + JSON.stringify(plan_bogus.error)
  );

  const plan_ttl_bogus = invoke_reply(dir, exe,
    ["plan", "lock", "--ttl-seconds", "60", "--bogus"], env);
  ensure(!output_success(plan_ttl_bogus),
    "cu_linux_login_session_usage_plan_ttl_bogus_ok:" + JSON.stringify(plan_ttl_bogus));
  ensure(
    text_at(plan_ttl_bogus, "error.code") === "usage",
    "cu_linux_login_session_usage_plan_ttl_bogus_code:" + JSON.stringify(plan_ttl_bogus.error)
  );
  ensure(
    text_at(plan_ttl_bogus, "command") === "usage",
    "cu_linux_login_session_usage_plan_ttl_bogus_command:" + JSON.stringify(plan_ttl_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(plan_ttl_bogus, "error.message"), "--bogus"),
    "cu_linux_login_session_usage_plan_ttl_bogus_message:" + JSON.stringify(plan_ttl_bogus.error)
  );

  const status_coords = invoke_reply(dir, exe, ["status", "--coords", "10,10"], env);
  ensure(!output_success(status_coords),
    "cu_linux_login_session_usage_status_coords_ok:" + JSON.stringify(status_coords));
  ensure(
    text_at(status_coords, "error.code") === "usage",
    "cu_linux_login_session_usage_status_coords_code:" + JSON.stringify(status_coords.error)
  );
  ensure(
    text_at(status_coords, "command") === "usage",
    "cu_linux_login_session_usage_status_coords_command:" + JSON.stringify(status_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(status_coords, "error.message"), "--coords"),
    "cu_linux_login_session_usage_status_coords_message:" + JSON.stringify(status_coords.error)
  );

  const plan_coords = invoke_reply(dir, exe, ["plan", "lock", "--coords", "10,10"], env);
  ensure(!output_success(plan_coords),
    "cu_linux_login_session_usage_plan_coords_ok:" + JSON.stringify(plan_coords));
  ensure(
    text_at(plan_coords, "error.code") === "usage",
    "cu_linux_login_session_usage_plan_coords_code:" + JSON.stringify(plan_coords.error)
  );
  ensure(
    text_at(plan_coords, "command") === "usage",
    "cu_linux_login_session_usage_plan_coords_command:" + JSON.stringify(plan_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(plan_coords, "error.message"), "--coords"),
    "cu_linux_login_session_usage_plan_coords_message:" + JSON.stringify(plan_coords.error)
  );

  const plan_ttl_coords = invoke_reply(dir, exe,
    ["plan", "lock", "--ttl-seconds", "60", "--coords", "10,10"], env);
  ensure(!output_success(plan_ttl_coords),
    "cu_linux_login_session_usage_plan_ttl_coords_ok:" + JSON.stringify(plan_ttl_coords));
  ensure(
    text_at(plan_ttl_coords, "error.code") === "usage",
    "cu_linux_login_session_usage_plan_ttl_coords_code:" + JSON.stringify(plan_ttl_coords.error)
  );
  ensure(
    text_at(plan_ttl_coords, "command") === "usage",
    "cu_linux_login_session_usage_plan_ttl_coords_command:" + JSON.stringify(plan_ttl_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(plan_ttl_coords, "error.message"), "--coords"),
    "cu_linux_login_session_usage_plan_ttl_coords_message:" + JSON.stringify(plan_ttl_coords.error)
  );

  const missing_subcommand = invoke_reply(dir, exe, [], env);
  ensure(!output_success(missing_subcommand),
    "cu_linux_login_session_usage_missing_subcommand_ok:" + JSON.stringify(missing_subcommand));
  ensure(
    text_at(missing_subcommand, "error.code") === "usage",
    "cu_linux_login_session_usage_missing_subcommand_code:" + JSON.stringify(missing_subcommand.error)
  );
  ensure(
    text_at(missing_subcommand, "command") === "usage",
    "cu_linux_login_session_usage_missing_subcommand_command:" + JSON.stringify(missing_subcommand)
  );
}

function assert_get_extents_usage_limit(dir, exe, env) {
  const zero_handle = invoke_get_extents_reply(dir, exe, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_login_session_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_login_session_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_login_session_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(dir, exe, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_login_session_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_login_session_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_login_session_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_login_session_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(dir, exe, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_login_session_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_login_session_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_login_session_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_login_session_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(dir, exe, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_login_session_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_login_session_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_login_session_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_login_session_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(dir, exe) {
  const reply = invoke_get_extents_reply(dir, exe, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(exe), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_login_session_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_login_session_extents_unavailable_code:" + code
  );
}

function probe() {
  const script = "import json,os,subprocess,sys,shutil\n" +
    "sid=os.environ.get('XDG_SESSION_ID','').strip()\n" +
    "if not sid and shutil.which('loginctl'):\n  out=subprocess.run(['loginctl','list-sessions','--no-legend'],capture_output=True,text=True)\n" +
    "  if out.returncode==0:\n    for line in out.stdout.splitlines():\n      p=line.split()\n      if len(p)>=3 and p[2]==str(os.getuid()): sid=p[0]; break\n" +
    "if not sid: print(json.dumps({'available':False})); sys.exit(0)\n" +
    "def kv(t):\n  d={}\n  for line in t.splitlines():\n    if '=' in line: k,v=line.split('=',1); d[k]=v\n  return d\n" +
    "facts=None\n" +
    "if shutil.which('loginctl'):\n  out=subprocess.run(['loginctl','show-session',sid,'-a'],capture_output=True,text=True)\n" +
    "  if out.returncode==0: facts=kv(out.stdout)\n" +
    "if facts is None and os.path.exists(f'/run/systemd/sessions/{sid}'): facts=kv(open(f'/run/systemd/sessions/{sid}').read())\n" +
    "if facts is None: print(json.dumps({'available':False})); sys.exit(0)\n" +
    "seat=facts.get('Seat',''); typ=facts.get('Type',''); cls=facts.get('Class',''); st=facts.get('State',''); rem=facts.get('Remote','no'); lock=facts.get('LockedHint',facts.get('Locked','no'))\n" +
    "uid=facts.get('User',facts.get('UID','')); name=facts.get('Name',facts.get('USER','')); leader=facts.get('Leader',''); vt=facts.get('VTNr','0')\n" +
    "active=st=='active'; graphical=typ in ('x11','wayland'); on=seat!='' and rem in ('no','0','false','False') and graphical and cls=='user' and active\n" +
    "print(json.dumps({'available':True,'uid':int(uid) if str(uid).isdigit() else None,'username':name,'on_console':on,'login_complete':cls=='user' and active,'locked':lock in ('yes','1','true','True'),'leader':int(leader) if str(leader).isdigit() else None,'vt':int(vt) if str(vt).isdigit() else 0}))\n";
  const out = rh.command("python3", ["-c", script], { env: cu_env(""), timeout_ms: 30000 });
  ensure(out.success, out.stderr);
  const p = JSON.parse(out.stdout.trim());
  return p.available === true ? p : null;
}

function field_at(v, d) {
  let c = v;
  for (const k of d.split(".")) c = rh.field(c, k);
  return c;
}

function probe_absence() {
  const script = "import json,os,shutil\n" +
    "print(json.dumps({'loginctl':shutil.which('loginctl') is not None,'xdg_session_id':os.environ.get('XDG_SESSION_ID','').strip(),'session_dir':os.path.isdir('/run/systemd/sessions')}))";
  const out = rh.command("python3", ["-c", script], { env: cu_env(""), timeout_ms: 30000 });
  ensure(out.success, out.stderr);
  return JSON.parse(out.stdout.trim());
}

function verify_unsupported(st) {
  ensure(st.ok !== true, "false_success");
  ensure(text_at(st,"error.code")==="login_session_unsupported","code");
  ensure(text_at(st,"error.detail.os")==="linux","os");
  ensure(text_at(st,"error.detail.required_os")==="linux","required_os");
  ensure(text_at(st,"error.detail.provider")==="none","provider");
  ensure(text_at(st,"error.detail.mechanism").indexOf("systemd")>=0,"mechanism");
  ensure(text_at(st,"error.message").indexOf("macOS")<0,"macos_claim");
  const alts = field_at(st, "error.detail.alternatives");
  ensure(Array.isArray(alts) && alts.length>0,"alts");
}

const args = rh.args();
if (args.length===1 && args[0]==="--list-evidence") { for (const id of declared_evidence) print(id); return; }
harness.require(args.length===2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]); const exe = rh.absolute(args[1]);
ensure(rh.exists(exe), "missing exe");
const ctx = harness.new_context(repo, "cu-linux-login-session");
const env = cu_env(exe);
const atspi_available = probe_atspi_available(exe);

print("STEP login-session typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
assert_login_session_usage_limit(ctx.run_directory, exe, env);

print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before loginctl read-back court");
assert_get_extents_usage_limit(ctx.run_directory, exe, env);

print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before loginctl read-back court");
assert_get_extents_host_limit_when_atspi_absent(ctx.run_directory, exe);

if (atspi_available !== true) {
  print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; loginctl read-back court still runs when probe facts exist");
}

const p = probe();
if (p === null) {
  const absence = probe_absence();
  print("STEP typed unsupported path (independent probe absent: loginctl="
    + absence.loginctl + " xdg_session_id=" + (absence.xdg_session_id || "(unset)")
    + " session_dir=" + absence.session_dir + ")");
  verify_unsupported(invoke(ctx.run_directory, exe, ["status"], false));
  verify_unsupported(invoke(ctx.run_directory, exe, ["plan","lock"], false));
  harness.emit_evidence(ctx, declared_evidence, "cu.linux-login-session-readback");
  harness.remove_run(ctx);
  if (atspi_available) {
    print("PASS: Linux login-session typed unsupported with independent probe absence read-back and typed login-session --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux login-session typed unsupported with independent probe absence read-back and typed login-session --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
  return;
}
print("STEP readback path");
const st = invoke(ctx.run_directory, exe, ["status"], true);
ensure(text_at(st,"data.provider")==="linux-sd-login","provider");
let console = null;
for (const s of rh.field(st,"data.sessions")) if (rh.field(s,"on_console")===true) console = s;
ensure(console !== null, "console");
ensure(rh.field(console,"uid")===p.uid,"uid");
ensure(text_at(console,"username")===p.username,"username");
ensure(rh.field(console,"on_console")===p.on_console,"on_console");
ensure(rh.field(console,"login_complete")===p.login_complete,"login_complete");
ensure(rh.field(st,"data.locked")===p.locked,"locked");
harness.emit_evidence(ctx, declared_evidence, "cu.linux-login-session-readback");
harness.remove_run(ctx);
if (atspi_available) {
  print("PASS: Linux login-session status matches independent loginctl/session-env read-back with typed login-session --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux login-session status matches independent loginctl/session-env read-back with typed login-session --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
}
