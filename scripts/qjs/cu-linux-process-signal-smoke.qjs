// CEO: Linux process-signal honesty with independent /proc and wait read-back.
// Acceptance is smoke read-back only: CU process-signal delivery to disposable
// children must agree with /proc scheduler state, wait outcome, or handler
// markers derived outside agenterm-cu. Weaker signals may remain verified=false
// when independent evidence cannot close the postcondition (typed gap).
// Typed process-signal usage must reject AT-SPI --name and other unexpected
// arguments; typed get-extents --name usage/host-limit paths must hold before
// the signal/read-back court. AT-SPI/--name only; no --coords or screenshot
// degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-signal-readback",
];

const AT_SPI_PROBE_NAME = "Process Signal Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_actuate_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "actuate",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_signal_actuate_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "process-signal" || text_at(reply, "command") === "usage",
    "cu_linux_process_signal_actuate_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_signal_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "process-state" || text_at(reply, "command") === "usage",
    "cu_linux_process_signal_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_signal_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_process_signal_usage_limit(run_directory, executable, env) {
  const flat_with_name = invoke_actuate_reply(run_directory, executable, [
    "process-signal", "--pid", "1", "STOP", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_process_signal_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_process_signal_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_process_signal_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    text_at(flat_with_name, "error.message").indexOf("--name") >= 0
      || text_at(flat_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_process_signal_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_actuate_reply(run_directory, executable, [
    "process", "signal", "1", "STOP", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_process_signal_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_process_signal_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "error.message").indexOf("--name") >= 0
      || text_at(grouped_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_process_signal_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = invoke_actuate_reply(run_directory, executable, [
    "process-signal", "--pid", "1", "STOP", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_process_signal_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_process_signal_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("unexpected") >= 0
      || text_at(with_bogus, "error.message").indexOf("--bogus") >= 0,
    "cu_linux_process_signal_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_process_signal_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_process_signal_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_process_signal_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_process_signal_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_process_signal_extents_unavailable_code:" + code
  );
}

function verify_readback(run_directory, executable, mode, pid, identity, marker_path, env) {
  const script = [
    "import json, os, subprocess, sys, time",
    "mode = sys.argv[1]",
    "pid = int(sys.argv[2])",
    "cu = sys.argv[3]",
    "identity = sys.argv[4]",
    "marker_path = sys.argv[5]",
    "def proc_state(pid):",
    "    try:",
    "        with open(f'/proc/{pid}/stat') as handle:",
    "            stat = handle.read()",
    "    except FileNotFoundError:",
    "        return {'alive': False, 'stopped': False}",
    "    close = stat.rfind(')')",
    "    if close < 0:",
    "        raise ValueError('process stat has no closing command delimiter')",
    "    state = stat[close + 2]",
    "    return {",
    "        'alive': state not in ('Z', 'X', 'x'),",
    "        'stopped': state == 'T',",
    "    }",
    "def invoke_actuate(signal, timeout_ms=5000, force=False):",
    "    argv = [",
    "        cu, '--target', 'current', '--grant', 'actuate',",
    "        'process-signal', '--pid', str(pid), signal,",
    "        '--start-identity', identity,",
    "        '--timeout-ms', str(timeout_ms),",
    "    ]",
    "    if force:",
    "        argv.append('--force')",
    "    out = subprocess.check_output(argv, text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok'):",
    "        raise SystemExit('cu_linux_process_signal_reply:' + out)",
    "    return reply['data']",
    "def wait_reaped(timeout_ms=5000):",
    "    deadline = time.time() + (timeout_ms / 1000.0)",
    "    while time.time() < deadline:",
    "        try:",
    "            waited_pid, status = os.waitpid(pid, os.WNOHANG)",
    "        except ChildProcessError:",
    "            return True",
    "        if waited_pid == pid:",
    "            return True",
    "        if not proc_state(pid)['alive']:",
    "            return True",
    "        time.sleep(0.05)",
    "    return not proc_state(pid)['alive']",
    "if mode == 'stop-cont':",
    "    before = proc_state(pid)",
    "    if not before['alive'] or before['stopped']:",
    "        raise SystemExit('cu_linux_process_signal_stop_fixture')",
    "    stopped = invoke_actuate('STOP')",
    "    after_stop = proc_state(pid)",
    "    if stopped.get('verified') is not True or stopped.get('state') != 'stopped':",
    "        raise SystemExit('cu_linux_process_signal_stop_cu:' + json.dumps(stopped))",
    "    if not after_stop['alive'] or not after_stop['stopped']:",
    "        raise SystemExit('cu_linux_process_signal_stop_proc')",
    "    resumed = invoke_actuate('CONT')",
    "    after_cont = proc_state(pid)",
    "    if resumed.get('verified') is not True or resumed.get('state') != 'running':",
    "        raise SystemExit('cu_linux_process_signal_cont_cu:' + json.dumps(resumed))",
    "    if not after_cont['alive'] or after_cont['stopped']:",
    "        raise SystemExit('cu_linux_process_signal_cont_proc')",
    "    print('stop-cont', pid)",
    "elif mode == 'term-exit':",
    "    before = proc_state(pid)",
    "    if not before['alive']:",
    "        raise SystemExit('cu_linux_process_signal_term_fixture')",
    "    delivered = invoke_actuate('TERM', timeout_ms=5000)",
    "    reaped = wait_reaped(5000)",
    "    if delivered.get('verified') is not True or delivered.get('state') != 'exited':",
    "        raise SystemExit('cu_linux_process_signal_term_cu:' + json.dumps(delivered))",
    "    if not reaped:",
    "        raise SystemExit('cu_linux_process_signal_term_wait')",
    "    print('term-exit', pid)",
    "elif mode == 'usr1-marker':",
    "    if not marker_path or marker_path == '-':",
    "        raise SystemExit('cu_linux_process_signal_marker_path')",
    "    if os.path.exists(marker_path):",
    "        os.remove(marker_path)",
    "    before = proc_state(pid)",
    "    if not before['alive']:",
    "        raise SystemExit('cu_linux_process_signal_usr1_fixture')",
    "    delivered = invoke_actuate('USR1')",
    "    deadline = time.time() + 5.0",
    "    while time.time() < deadline and not os.path.exists(marker_path):",
    "        time.sleep(0.05)",
    "    after = proc_state(pid)",
    "    if not os.path.exists(marker_path):",
    "        raise SystemExit('cu_linux_process_signal_usr1_marker')",
    "    if delivered.get('delivered') is not True or delivered.get('verified') is not False:",
    "        raise SystemExit('cu_linux_process_signal_usr1_cu:' + json.dumps(delivered))",
    "    if not after['alive']:",
    "        raise SystemExit('cu_linux_process_signal_usr1_alive')",
    "    print('usr1-marker', pid)",
    "elif mode == 'usr1-ignored-gap':",
    "    before = proc_state(pid)",
    "    if not before['alive']:",
    "        raise SystemExit('cu_linux_process_signal_ignored_fixture')",
    "    delivered = invoke_actuate('USR1')",
    "    after = proc_state(pid)",
    "    if delivered.get('delivered') is not True or delivered.get('verified') is not False:",
    "        raise SystemExit('cu_linux_process_signal_ignored_cu:' + json.dumps(delivered))",
    "    if delivered.get('state') != 'live':",
    "        raise SystemExit('cu_linux_process_signal_ignored_state:' + json.dumps(delivered))",
    "    if not after['alive']:",
    "        raise SystemExit('cu_linux_process_signal_ignored_proc')",
    "    print('usr1-ignored-gap', pid)",
    "else:",
    "    raise SystemExit('cu_linux_process_signal_mode:' + mode)",
  ].join("\n");
  const argv = ["-c", script, mode, "" + pid, executable, identity, marker_path || "-"];
  const output = rh.command("python3", argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  ensure(output.success === true, "cu_linux_process_signal_readback:" + mode + ":" + output.stderr + output.stdout);
}

function observe_identity(run_directory, executable, pid, env) {
  const reply = invoke_observe_reply(run_directory, executable, [
    "process-state", "--pid", "" + pid,
  ], env);
  ensure(output_success(reply), "cu_linux_process_signal_observe:" + JSON.stringify(reply));
  ensure(at(reply, "data.state") === "live", "cu_linux_process_signal_observe_state");
  const identity = "" + at(reply, "data.start_identity");
  ensure(identity !== "", "cu_linux_process_signal_identity");
  return identity;
}

function kill_child(run_directory, executable, pid, identity, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "actuate",
    "process-signal", "--pid", "" + pid, "KILL",
    "--start-identity", identity, "--force", "--timeout-ms", "5000",
  ], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_process_signal_cleanup:" + output.stderr);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-signal");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
const children = [];
let succeeded = 0;
let failure = "";
try {
  print("STEP process-signal typed-fails usage when AT-SPI --name or other unexpected arguments are present");
  assert_process_signal_usage_limit(context.run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before signal/read-back court");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP STOP/CONT actuation matches independent /proc scheduler read-back");
  const stop_child = harness.start_child(context, {
    program: "/bin/sh",
    args: ["-c", "while :; do sleep 1; done"],
    current_dir: context.run_directory,
    timeout_ms: 90000,
  }, "stop-cont");
  children.push(stop_child);
  const stop_identity = observe_identity(context.run_directory, executable, stop_child.pid, env);
  verify_readback(context.run_directory, executable, "stop-cont", stop_child.pid, stop_identity, null, env);
  kill_child(context.run_directory, executable, stop_child.pid, stop_identity, env);
  harness.child_wait(stop_child, 10000);

  print("STEP TERM actuation matches independent wait/read-back exit outcome");
  const term_child = harness.start_child(context, {
    program: "sleep",
    args: ["300"],
    current_dir: context.run_directory,
    timeout_ms: 90000,
  }, "term-exit");
  children.push(term_child);
  const term_identity = observe_identity(context.run_directory, executable, term_child.pid, env);
  verify_readback(context.run_directory, executable, "term-exit", term_child.pid, term_identity, null, env);
  harness.child_wait(term_child, 10000);

  print("STEP USR1 handler marker proves delivery beyond CU self-report");
  const marker_path = rh.join(context.run_directory, "usr1-marker");
  const marker_child = harness.start_child(context, {
    program: "/bin/sh",
    args: ["-c", "trap 'touch \"$1\"' USR1; while :; do sleep 1; done", "_", marker_path],
    current_dir: context.run_directory,
    timeout_ms: 90000,
  }, "usr1-marker");
  children.push(marker_child);
  const marker_identity = observe_identity(context.run_directory, executable, marker_child.pid, env);
  verify_readback(
    context.run_directory, executable, "usr1-marker",
    marker_child.pid, marker_identity, marker_path, env,
  );
  kill_child(context.run_directory, executable, marker_child.pid, marker_identity, env);
  harness.child_wait(marker_child, 10000);

  print("STEP ignored USR1 keeps verified=false with live /proc agreement (typed gap)");
  const ignored_child = harness.start_child(context, {
    program: "/bin/sh",
    args: ["-c", "trap '' USR1; while :; do sleep 1; done"],
    current_dir: context.run_directory,
    timeout_ms: 90000,
  }, "usr1-ignored");
  children.push(ignored_child);
  const ignored_identity = observe_identity(context.run_directory, executable, ignored_child.pid, env);
  verify_readback(
    context.run_directory, executable, "usr1-ignored-gap",
    ignored_child.pid, ignored_identity, null, env,
  );
  kill_child(context.run_directory, executable, ignored_child.pid, ignored_identity, env);
  harness.child_wait(ignored_child, 10000);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, children, succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-signal-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux process-signal matches independent /proc and wait read-back with typed process-signal/get-extents usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux process-signal matches independent /proc and wait read-back with typed process-signal/get-extents host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
