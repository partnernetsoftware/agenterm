// CEO: Linux power-status observe with independent /sys and CLOCK_BOOTTIME read-back.
// Acceptance is smoke read-back only: boot_identity and uptime_milliseconds must
// match facts derived outside agenterm-cu; boot_id must stay stable across the
// observation bracket. Typed power-status usage must reject AT-SPI --name and other
// unexpected arguments; typed get-extents --name usage/host-limit paths must hold
// before the /sys read-back court. AT-SPI/--name only; no --coords or screenshot
// degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-power-status-readback",
];

const BOOT_ID_PATH = "/proc/sys/kernel/random/boot_id";
const UPTIME_SLACK_MS = 15000;
const AT_SPI_PROBE_NAME = "Power Status Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function output_success(document) { return at(document, "ok") === true; }

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function isolated_env(run_directory, prefix) {
  const env = cu_env("");
  env.HOME = run_directory;
  env.USERPROFILE = run_directory;
  env.APPDATA = rh.join(run_directory, "config");
  env.LOCALAPPDATA = rh.join(run_directory, "data");
  env.XDG_CONFIG_HOME = rh.join(run_directory, "config");
  env.XDG_DATA_HOME = rh.join(run_directory, "data");
  env.AGENTERM_CU_AUDIT_PATH = rh.join(run_directory, prefix + "-audit.jsonl");
  env.AGENTERM_CU_RECEIPT_PATH = rh.join(run_directory, prefix + "-receipts.jsonl");
  env.AGENTERM_CU_RUNTIME_PATH = rh.join(run_directory, "cu-runtime.json");
  env.AGENTERM_CU_MANAGED_JOB_PATH = rh.join(run_directory, "cu-managed-jobs.json");
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_power_status_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "power-status" || text_at(reply, "command") === "usage",
    "cu_linux_power_status_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_power_status_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_power_status_usage_limit(run_directory, executable, env) {
  const flat_with_name = invoke_observe_reply(run_directory, executable, [
    "power-status", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_power_status_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_power_status_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_power_status_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    text_at(flat_with_name, "error.message").indexOf("--name") >= 0
      || text_at(flat_with_name, "error.message").indexOf("no arguments") >= 0,
    "cu_linux_power_status_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_observe_reply(run_directory, executable, [
    "power", "status", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_power_status_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_power_status_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "error.message").indexOf("--name") >= 0
      || text_at(grouped_with_name, "error.message").indexOf("no arguments") >= 0,
    "cu_linux_power_status_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = invoke_observe_reply(run_directory, executable, ["power-status", "--bogus"], env);
  ensure(!output_success(with_bogus),
    "cu_linux_power_status_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_power_status_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("no arguments") >= 0
      || text_at(with_bogus, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_power_status_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_power_status_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_power_status_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_power_status_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_power_status_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_power_status_extents_unavailable_code:" + code
  );
}

function invoke(run_directory, executable, arguments, expect_success, prefix) {
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: isolated_env(run_directory, prefix),
    timeout_ms: 30000,
  });
  ensure(output.success === expect_success, "cu_linux_power_status_exit:" + output.exit_code);
  const reply = JSON.parse(output.stdout.trim());
  ensure(reply.ok === expect_success, "cu_linux_power_status_reply_state");
  return reply;
}

function boot_id_shape(value) {
  if (value.length !== 36) { return false; }
  for (let index = 0; index < value.length; index = index + 1) {
    const code = value.charCodeAt(index);
    if (index === 8 || index === 13 || index === 18 || index === 23) {
      if (code !== 45) { return false; }
    } else if (code < 48 || (code > 57 && code < 65) || (code > 70 && code < 97) || code > 102) {
      return false;
    }
  }
  return true;
}

function independent_boot_id() {
  ensure(rh.exists(BOOT_ID_PATH), "cu_linux_power_status_boot_id_missing");
  const boot_id = rh.read_text(BOOT_ID_PATH).trim();
  ensure(boot_id_shape(boot_id), "cu_linux_power_status_boot_id_shape:" + boot_id);
  return boot_id;
}

function independent_uptime_milliseconds() {
  const script = [
    "import time",
    "print(int(time.clock_gettime(time.CLOCK_BOOTTIME) * 1000))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], { timeout_ms: 10000 });
  ensure(output.success === true, "cu_linux_power_status_uptime_probe:" + output.stderr);
  const value = Number(output.stdout.trim());
  ensure(value === value && value >= 0, "cu_linux_power_status_uptime_shape:" + output.stdout);
  return value;
}

function independent_proc_uptime_milliseconds() {
  const script = [
    "with open('/proc/uptime') as handle:",
    "    seconds = float(handle.read().split()[0])",
    "print(int(seconds * 1000))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], { timeout_ms: 10000 });
  ensure(output.success === true, "cu_linux_power_status_proc_uptime_probe:" + output.stderr);
  const value = Number(output.stdout.trim());
  ensure(value === value && value >= 0, "cu_linux_power_status_proc_uptime_shape:" + output.stdout);
  return value;
}

function independent_boot_identity(host_identity, boot_id) {
  const script = [
    "import hashlib, struct, sys",
    "host = sys.argv[1]",
    "material = sys.argv[2].strip().encode('ascii')",
    "anchor = hashlib.sha256()",
    "anchor.update(b'agenterm-platform/host-boot-identity/v1\\0')",
    "anchor.update(struct.pack('<Q', len(material)))",
    "anchor.update(material)",
    "anchor = anchor.digest()",
    "digest = hashlib.sha256()",
    "digest.update(b'agenterm-cu/power-status/boot/v1\\0')",
    "digest.update(struct.pack('<Q', len(host)))",
    "digest.update(host.encode('ascii'))",
    "digest.update(struct.pack('<Q', len(anchor)))",
    "digest.update(anchor)",
    "print('agt-cu-boot-v1-' + digest.hexdigest())",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, host_identity, boot_id], {
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_power_status_boot_identity_probe:" + output.stderr);
  const identity = output.stdout.trim();
  ensure(identity.startsWith("agt-cu-boot-v1-") && identity.length === "agt-cu-boot-v1-".length + 64,
         "cu_linux_power_status_boot_identity_shape:" + identity);
  return identity;
}

function uptime_near(candidate, lower, upper) {
  return candidate >= lower - UPTIME_SLACK_MS && candidate <= upper + UPTIME_SLACK_MS;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(rh.exists(executable), "cu_linux_power_status_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-power-status");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
try {
  print("STEP power-status typed-fails usage when AT-SPI --name or other unexpected arguments are present");
  assert_power_status_usage_limit(context.run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before /sys read-back");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP observation refuses to invent an unenrolled host identity");
  const missing = invoke(context.run_directory, executable,
    ["--target", "current", "--grant", "observe", "power", "status"], false, "missing");
  ensure(missing.error.code === "host_identity_unavailable", "cu_linux_power_status_missing_identity");

  print("STEP explicit setup enrolls the private installation identity");
  const setup = invoke(context.run_directory, executable,
    ["--target", "current", "--grant", "actuate", "setup", "--bin-dir",
     rh.join(context.run_directory, "bin")], true, "setup");
  ensure(setup.command === "setup" && setup.data.installation_identity.status === "ready",
         "cu_linux_power_status_setup_identity");

  print("STEP independent /sys boot_id and CLOCK_BOOTTIME bracket one power-status observation");
  const boot_id_before = independent_boot_id();
  const uptime_before = independent_uptime_milliseconds();
  const reply = invoke(context.run_directory, executable,
    ["--target", "current", "--grant", "observe", "power-status"], true, "power");
  const boot_id_after = independent_boot_id();
  const uptime_after = independent_uptime_milliseconds();

  ensure(reply.command === "power-status" && reply.target === "current", "cu_linux_power_status_command");
  ensure(text_at(reply, "data.host_identity").startsWith("agt-cu-host-v1-"),
         "cu_linux_power_status_host_identity");
  ensure(text_at(reply, "data.boot_identity").startsWith("agt-cu-boot-v1-"),
         "cu_linux_power_status_boot_identity");
  ensure(text_at(reply, "data.verified") === "true"
         && text_at(reply, "data.atomic_snapshot") === "false",
         "cu_linux_power_status_truth_fields");
  ensure(text_at(reply, "data.host_identity_scope") === "installation"
         && text_at(reply, "data.boot_identity_scope") === "installation-and-boot"
         && text_at(reply, "data.boot_anchor") === "native-boot-instance",
         "cu_linux_power_status_scope_fields");
  ensure(reply.data.host_uuid === undefined && reply.data.start_identity === undefined,
         "cu_linux_power_status_native_identity_leak");

  ensure(boot_id_before === boot_id_after,
         "cu_linux_power_status_boot_id_changed:" + boot_id_before + "!=" + boot_id_after);

  const uptime_ms = Number(text_at(reply, "data.uptime_milliseconds"));
  ensure(uptime_ms === uptime_ms && uptime_ms >= 0, "cu_linux_power_status_uptime_shape");
  ensure(uptime_near(uptime_ms, uptime_before, uptime_after),
         "cu_linux_power_status_uptime_mismatch:cu=" + uptime_ms
         + ":before=" + uptime_before + ":after=" + uptime_after);
  const proc_uptime_ms = independent_proc_uptime_milliseconds();
  ensure(uptime_near(uptime_ms, proc_uptime_ms, proc_uptime_ms),
         "cu_linux_power_status_proc_uptime_mismatch:cu=" + uptime_ms
         + ":proc=" + proc_uptime_ms);

  print("STEP independent boot_id derivation matches the reported boot_identity");
  const expected_boot_identity = independent_boot_identity(
    text_at(reply, "data.host_identity"),
    boot_id_before
  );
  ensure(text_at(reply, "data.boot_identity") === expected_boot_identity,
         "cu_linux_power_status_boot_identity_mismatch:cu="
         + text_at(reply, "data.boot_identity") + ":expected=" + expected_boot_identity);

  print("STEP repeated observations preserve host and boot identities");
  const second = invoke(context.run_directory, executable,
    ["--target", "current", "--grant", "observe", "power", "status"], true, "power");
  ensure(text_at(reply, "data.host_identity") === text_at(second, "data.host_identity"),
         "cu_linux_power_status_host_stability");
  ensure(text_at(reply, "data.boot_identity") === text_at(second, "data.boot_identity"),
         "cu_linux_power_status_boot_stability");
  ensure(Number(text_at(second, "data.uptime_milliseconds")) >= uptime_ms,
         "cu_linux_power_status_uptime_monotonic");

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-power-status-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux power-status host/boot identities and uptime match independent /sys and CLOCK_BOOTTIME read-back with typed power-status/get-extents usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux power-status host/boot identities and uptime match independent /sys and CLOCK_BOOTTIME read-back with typed power-status/get-extents host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
