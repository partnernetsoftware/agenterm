// CEO: minimize/restore --expect minimized|restored on Linux.
// Acceptance is smoke read-back only: independent xprop _NET_WM_STATE,
// xwininfo Map State, independent pyatspi frame ICONIFIED/SHOWING state,
// and windows inventory minimized field must match --expect after each verb.
// Typed usage, destructive-gate refusals, missing-window and headless
// host-limit paths must hold before any owned fixture window exists. Typed
// minimize/restore usage must reject AT-SPI --name, --coords, --bogus, and
// other unexpected arguments; typed get-extents --name usage AND host-limit
// paths must both hold before the actuate/read-back court. Prefer host-limit
// clarity over fake success. AT-SPI/--name only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-minimize-expect-state",
];

const MISSING_HANDLE = "99999999";
const AT_SPI_PROBE_NAME = "Minimize";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_minimize_expect_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_minimize_expect_reply:" + JSON.stringify(document));
  return document;
}

function minimize_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["minimize"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_minimize_expect_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function restore_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["restore"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_minimize_expect_restore_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function assert_minimize_usage_limit(run_directory, executable) {
  const minimize_zero = run_cu_reply(run_directory, executable, "actuate", [
    "minimize", "--window", "0", "--expect", "minimized",
  ]);
  ensure(!output_success(minimize_zero), "cu_linux_minimize_expect_usage_ok:" + JSON.stringify(minimize_zero));
  ensure(
    text_at(minimize_zero, "error.code") === "usage",
    "cu_linux_minimize_expect_usage_code:" + JSON.stringify(minimize_zero.error)
  );
  ensure(
    text_at(minimize_zero, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_minimize_expect_usage_message:" + JSON.stringify(minimize_zero.error)
  );

  const restore_zero = run_cu_reply(run_directory, executable, "actuate", [
    "restore", "--window", "0", "--expect", "restored",
  ]);
  ensure(!output_success(restore_zero), "cu_linux_minimize_expect_restore_usage_ok:" + JSON.stringify(restore_zero));
  ensure(
    text_at(restore_zero, "error.code") === "usage",
    "cu_linux_minimize_expect_restore_usage_code:" + JSON.stringify(restore_zero.error)
  );
}

function assert_minimize_destructive_gate(run_directory, executable) {
  const missing_target = minimize_refused(
    run_directory, executable, ["--expect", "minimized"], "refused"
  );
  ensure(
    text_at(missing_target, "error.detail.reason") === "destructive_gate"
      && text_at(missing_target, "error.detail.effect") === "not_performed"
      && missing_target.error.detail.missing.length === 1
      && text_of(missing_target.error.detail.missing[0]) === "target",
    "cu_linux_minimize_expect_missing_target:" + JSON.stringify(missing_target)
  );

  const missing_postcondition = restore_refused(
    run_directory, executable, ["--window", "1"], "refused"
  );
  ensure(
    text_at(missing_postcondition, "error.detail.reason") === "destructive_gate"
      && missing_postcondition.error.detail.missing.length === 1
      && text_of(missing_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_minimize_expect_missing_postcondition:" + JSON.stringify(missing_postcondition)
  );

  const wrong_postcondition = minimize_refused(
    run_directory, executable, ["--window", "1", "--expect", "restored"], "refused"
  );
  ensure(
    text_at(wrong_postcondition, "error.detail.reason") === "destructive_gate"
      && wrong_postcondition.error.detail.missing.length === 1
      && text_of(wrong_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_minimize_expect_wrong_postcondition:" + JSON.stringify(wrong_postcondition)
  );

  const restore_missing = restore_refused(
    run_directory, executable, ["--expect", "restored"], "refused"
  );
  ensure(
    text_at(restore_missing, "error.detail.reason") === "destructive_gate"
      && restore_missing.error.detail.missing.length === 1
      && text_of(restore_missing.error.detail.missing[0]) === "target",
    "cu_linux_minimize_expect_restore_missing_target:" + JSON.stringify(restore_missing)
  );
}

function assert_minimize_missing_window(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "actuate", [
    "minimize", "--window", MISSING_HANDLE, "--expect", "minimized",
  ]);
  ensure(!output_success(reply), "cu_linux_minimize_expect_missing_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "window_op_failed",
    "cu_linux_minimize_expect_missing_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_minimize_expect_missing_effect:" + JSON.stringify(reply.error)
  );

  const restore_reply = run_cu_reply(run_directory, executable, "actuate", [
    "restore", "--window", MISSING_HANDLE, "--expect", "restored",
  ]);
  ensure(!output_success(restore_reply), "cu_linux_minimize_expect_restore_missing_ok:" + JSON.stringify(restore_reply));
  ensure(
    text_at(restore_reply, "error.code") === "window_op_failed",
    "cu_linux_minimize_expect_restore_missing_code:" + JSON.stringify(restore_reply.error)
  );
  ensure(
    text_at(restore_reply, "error.detail.effect") === "not_performed",
    "cu_linux_minimize_expect_restore_missing_effect:" + JSON.stringify(restore_reply.error)
  );
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_minimize_expect_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_minimize_restore_unexpected_usage(run_directory, executable, env) {
  const minimize_with_name = run_cu_reply(run_directory, executable, "actuate", [
    "minimize", "--window", "1", "--expect", "minimized", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(
    !output_success(minimize_with_name),
    "cu_linux_minimize_expect_name_usage_ok:" + JSON.stringify(minimize_with_name)
  );
  ensure(
    text_at(minimize_with_name, "error.code") === "usage",
    "cu_linux_minimize_expect_name_usage_code:" + JSON.stringify(minimize_with_name.error)
  );
  ensure(
    text_at(minimize_with_name, "command") === "usage",
    "cu_linux_minimize_expect_name_usage_command:" + JSON.stringify(minimize_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(minimize_with_name, "error.message"), "--name"),
    "cu_linux_minimize_expect_name_usage_message:" + JSON.stringify(minimize_with_name.error)
  );

  const restore_with_name = run_cu_reply(run_directory, executable, "actuate", [
    "restore", "--window", "1", "--expect", "restored", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(
    !output_success(restore_with_name),
    "cu_linux_minimize_expect_restore_name_usage_ok:" + JSON.stringify(restore_with_name)
  );
  ensure(
    text_at(restore_with_name, "error.code") === "usage",
    "cu_linux_minimize_expect_restore_name_usage_code:" + JSON.stringify(restore_with_name.error)
  );
  ensure(
    text_at(restore_with_name, "command") === "usage",
    "cu_linux_minimize_expect_restore_name_usage_command:" + JSON.stringify(restore_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(restore_with_name, "error.message"), "--name"),
    "cu_linux_minimize_expect_restore_name_usage_message:" + JSON.stringify(restore_with_name.error)
  );

  const minimize_with_bogus = run_cu_reply(run_directory, executable, "actuate", [
    "minimize", "--window", "1", "--expect", "minimized", "--bogus",
  ], env);
  ensure(
    !output_success(minimize_with_bogus),
    "cu_linux_minimize_expect_bogus_ok:" + JSON.stringify(minimize_with_bogus)
  );
  ensure(
    text_at(minimize_with_bogus, "error.code") === "usage",
    "cu_linux_minimize_expect_bogus_code:" + JSON.stringify(minimize_with_bogus.error)
  );
  ensure(
    text_at(minimize_with_bogus, "command") === "usage",
    "cu_linux_minimize_expect_bogus_command:" + JSON.stringify(minimize_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(minimize_with_bogus, "error.message"), "--bogus"),
    "cu_linux_minimize_expect_bogus_message:" + JSON.stringify(minimize_with_bogus.error)
  );

  const restore_with_bogus = run_cu_reply(run_directory, executable, "actuate", [
    "restore", "--window", "1", "--expect", "restored", "--bogus",
  ], env);
  ensure(
    !output_success(restore_with_bogus),
    "cu_linux_minimize_expect_restore_bogus_ok:" + JSON.stringify(restore_with_bogus)
  );
  ensure(
    text_at(restore_with_bogus, "error.code") === "usage",
    "cu_linux_minimize_expect_restore_bogus_code:" + JSON.stringify(restore_with_bogus.error)
  );
  ensure(
    text_at(restore_with_bogus, "command") === "usage",
    "cu_linux_minimize_expect_restore_bogus_command:" + JSON.stringify(restore_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(restore_with_bogus, "error.message"), "--bogus"),
    "cu_linux_minimize_expect_restore_bogus_message:" + JSON.stringify(restore_with_bogus.error)
  );

  const minimize_with_coords = run_cu_reply(run_directory, executable, "actuate", [
    "minimize", "--window", "1", "--expect", "minimized", "--coords", "10,10",
  ], env);
  ensure(
    !output_success(minimize_with_coords),
    "cu_linux_minimize_expect_coords_ok:" + JSON.stringify(minimize_with_coords)
  );
  ensure(
    text_at(minimize_with_coords, "error.code") === "usage",
    "cu_linux_minimize_expect_coords_code:" + JSON.stringify(minimize_with_coords.error)
  );
  ensure(
    text_at(minimize_with_coords, "command") === "usage",
    "cu_linux_minimize_expect_coords_command:" + JSON.stringify(minimize_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(minimize_with_coords, "error.message"), "--coords"),
    "cu_linux_minimize_expect_coords_message:" + JSON.stringify(minimize_with_coords.error)
  );

  const restore_with_coords = run_cu_reply(run_directory, executable, "actuate", [
    "restore", "--window", "1", "--expect", "restored", "--coords", "10,10",
  ], env);
  ensure(
    !output_success(restore_with_coords),
    "cu_linux_minimize_expect_restore_coords_ok:" + JSON.stringify(restore_with_coords)
  );
  ensure(
    text_at(restore_with_coords, "error.code") === "usage",
    "cu_linux_minimize_expect_restore_coords_code:" + JSON.stringify(restore_with_coords.error)
  );
  ensure(
    text_at(restore_with_coords, "command") === "usage",
    "cu_linux_minimize_expect_restore_coords_command:" + JSON.stringify(restore_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(restore_with_coords, "error.message"), "--coords"),
    "cu_linux_minimize_expect_restore_coords_message:" + JSON.stringify(restore_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(
    !output_success(zero_handle),
    "cu_linux_minimize_expect_extents_usage_ok:" + JSON.stringify(zero_handle)
  );
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_minimize_expect_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_minimize_expect_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(
    !output_success(missing_name),
    "cu_linux_minimize_expect_extents_usage_name_ok:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_minimize_expect_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_minimize_expect_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_minimize_expect_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(
    !output_success(extents_coords),
    "cu_linux_minimize_expect_extents_coords_ok:" + JSON.stringify(extents_coords)
  );
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_minimize_expect_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_minimize_expect_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_minimize_expect_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(
    !output_success(extents_bogus),
    "cu_linux_minimize_expect_extents_bogus_ok:" + JSON.stringify(extents_bogus)
  );
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_minimize_expect_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_minimize_expect_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_minimize_expect_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(
    !output_success(reply),
    "cu_linux_minimize_expect_extents_unavailable_ok:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_minimize_expect_extents_unavailable_code:" + code
  );
}

function assert_headless_host_limit(run_directory, executable, verb, label) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    [verb, "--window", "1", "--expect", verb === "minimize" ? "minimized" : "restored"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_minimize_expect_headless_ok_" + label + ":" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_minimize_expect_headless_code_" + label + ":" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("mechanism unavailable") >= 0
      || message.indexOf("agt_native_window_minimized") >= 0,
    "cu_linux_minimize_expect_headless_message_" + label + ":" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_minimize_expect_headless_effect_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_rows(reply) {
  const data = reply.data;
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  for (const row of window_rows(reply)) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_net_wm_hidden(run_directory, executable, handle) {
  const xprop = rh.command("xprop", ["-id", "" + handle, "_NET_WM_STATE"], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (!xprop.success) { return false; }
  return xprop.stdout.indexOf("_NET_WM_STATE_HIDDEN") >= 0;
}

function independent_map_viewable(run_directory, executable, handle) {
  const xwininfo = rh.command("xwininfo", ["-id", "" + handle], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (!xwininfo.success) { return false; }
  for (const line of xwininfo.stdout.split("\n")) {
    if (line.indexOf("Map State:") >= 0) {
      return line.indexOf("IsViewable") >= 0;
    }
  }
  return false;
}

function independent_pyatspi_frame_state(run_directory, executable, title) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "frame = None",
    "for i in range(desktop.childCount):",
    "    app = desktop.getChildAtIndex(i)",
    "    if app is None:",
    "        continue",
    "    for j in range(app.childCount):",
    "        candidate = app.getChildAtIndex(j)",
    "        if candidate is not None and candidate.name == title:",
    "            frame = candidate",
    "            break",
    "    if frame is not None:",
    "        break",
    "if frame is None:",
    "    print(json.dumps({'found': False}))",
    "    raise SystemExit(0)",
    "states = frame.getState()",
    "print(json.dumps({",
    "    'found': True,",
    "    'name': frame.name,",
    "    'role': frame.getRoleName(),",
    "    'iconified': bool(states.contains(pyatspi.STATE_ICONIFIED)),",
    "    'showing': bool(states.contains(pyatspi.STATE_SHOWING)),",
    "    'visible': bool(states.contains(pyatspi.STATE_VISIBLE)),",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(
    output.success === true,
    "cu_linux_minimize_expect_pyatspi_probe:" + output.stderr + output.stdout
  );
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_minimize_expect_pyatspi_empty");
  return JSON.parse(trimmed);
}

function ensure_pyatspi_restored(probe, label) {
  ensure(
    flag_at(probe, "found") === true
      && flag_at(probe, "iconified") === false
      && flag_at(probe, "showing") === true
      && flag_at(probe, "visible") === true,
    "cu_linux_minimize_expect_pyatspi_restored_" + label + ":" + JSON.stringify(probe)
  );
}

function ensure_pyatspi_minimized(probe, label) {
  ensure(
    flag_at(probe, "found") === true && flag_at(probe, "iconified") === true,
    "cu_linux_minimize_expect_pyatspi_minimized_" + label + ":" + JSON.stringify(probe)
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-minimize-expect-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_minimize_expect_fixture_missing:" + fixture_source);

print("STEP minimize/restore typed-fails usage when --window handle is zero");
assert_minimize_usage_limit(run_directory, executable);

print("STEP minimize/restore typed-fails refused destructive_gate when target or postcondition is missing");
assert_minimize_destructive_gate(run_directory, executable);

print("STEP minimize/restore typed-fails window_op_failed when handle is absent from inventory");
assert_minimize_missing_window(run_directory, executable);

print("STEP minimize/restore without DISPLAY typed-fails unsupported host-limit");
assert_headless_host_limit(run_directory, executable, "minimize", "minimize");
assert_headless_host_limit(run_directory, executable, "restore", "restore");

print("STEP minimize/restore typed-fail usage when AT-SPI --name/--coords/--bogus is present");
assert_minimize_restore_unexpected_usage(run_directory, executable, env);

print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before actuate/read-back court");
assert_get_extents_usage_limit(run_directory, executable, env);

print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before actuate/read-back court");
assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

if (!atspi_available) {
  print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; minimize read-back still uses xprop/xwininfo/inventory");
}

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_minimize_expect_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_minimize_expect_window_missing");
  const handle = int_at(row, "handle");
  const handle_text = "" + handle;
  ensure(handle > 0, "cu_linux_minimize_expect_handle:" + JSON.stringify(row));
  ensure(
    flag_at(row, "minimized") === false,
    "cu_linux_minimize_expect_baseline_not_minimized:" + JSON.stringify(row)
  );
  ensure(
    independent_net_wm_hidden(run_directory, executable, handle) === false,
    "cu_linux_minimize_expect_baseline_xprop_not_hidden"
  );
  ensure(
    independent_map_viewable(run_directory, executable, handle) === true,
    "cu_linux_minimize_expect_baseline_map_viewable"
  );
  if (atspi_available) {
    print("STEP independent pyatspi baseline: fixture frame must be showing and not iconified");
    ensure_pyatspi_restored(
      independent_pyatspi_frame_state(run_directory, executable, fixture_title),
      "baseline"
    );
  } else {
    print("STEP host-limit: independent pyatspi desktop probe unavailable; skip frame-state court");
  }

  print("STEP destructive_gate refusals on a live handle must not change xprop, map state, or inventory");
  minimize_refused(
    run_directory, executable, ["--window", handle_text, "--expect", "restored"], "refused"
  );
  restore_refused(
    run_directory, executable, ["--window", handle_text, "--expect", "minimized"], "refused"
  );
  ensure(
    independent_net_wm_hidden(run_directory, executable, handle) === false,
    "cu_linux_minimize_expect_refusal_xprop_changed"
  );
  ensure(
    independent_map_viewable(run_directory, executable, handle) === true,
    "cu_linux_minimize_expect_refusal_map_changed"
  );
  const refusal_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(refusal_row !== null, "cu_linux_minimize_expect_refusal_row_missing");
  ensure(
    flag_at(refusal_row, "minimized") === false,
    "cu_linux_minimize_expect_refusal_inventory_changed:" + JSON.stringify(refusal_row)
  );
  if (atspi_available) {
    ensure_pyatspi_restored(
      independent_pyatspi_frame_state(run_directory, executable, fixture_title),
      "refusal"
    );
  }

  print("STEP minimize --window " + handle_text + " --expect minimized");
  const minimized = run_cu(run_directory, executable, "actuate", [
    "minimize", "--window", handle_text, "--expect", "minimized",
  ]);
  ensure(
    flag_at(minimized, "data.verified")
      && flag_at(minimized, "data.after.minimized") === true,
    "cu_linux_minimize_expect_reply_minimized:" + JSON.stringify(minimized.data)
  );

  print("STEP independent xprop _NET_WM_STATE read-back: minimized must be true");
  ensure(
    independent_net_wm_hidden(run_directory, executable, handle) === true,
    "cu_linux_minimize_expect_xprop_minimized"
  );

  print("STEP independent xwininfo Map State read-back: minimized must be unmapped");
  ensure(
    independent_map_viewable(run_directory, executable, handle) === false,
    "cu_linux_minimize_expect_map_unmapped"
  );

  print("STEP independent windows inventory read-back: minimized must be true");
  const minimized_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(minimized_row !== null, "cu_linux_minimize_expect_minimized_row_missing");
  ensure(
    flag_at(minimized_row, "minimized") === true,
    "cu_linux_minimize_expect_inventory_minimized:" + JSON.stringify(minimized_row)
  );

  if (atspi_available) {
    print("STEP independent pyatspi state read-back: minimized frame must be ICONIFIED");
    ensure_pyatspi_minimized(
      independent_pyatspi_frame_state(run_directory, executable, fixture_title),
      "minimized"
    );
  }

  print("STEP restore --window " + handle_text + " --expect restored");
  const restored = run_cu(run_directory, executable, "actuate", [
    "restore", "--window", handle_text, "--expect", "restored",
  ]);
  ensure(
    flag_at(restored, "data.verified")
      && flag_at(restored, "data.after.minimized") === false,
    "cu_linux_minimize_expect_reply_restored:" + JSON.stringify(restored.data)
  );

  print("STEP independent xprop _NET_WM_STATE read-back: minimized must be false");
  ensure(
    independent_net_wm_hidden(run_directory, executable, handle) === false,
    "cu_linux_minimize_expect_xprop_restored"
  );

  print("STEP independent xwininfo Map State read-back: restored must be viewable");
  ensure(
    independent_map_viewable(run_directory, executable, handle) === true,
    "cu_linux_minimize_expect_map_viewable"
  );

  print("STEP independent windows inventory read-back: minimized must be false");
  const restored_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(restored_row !== null, "cu_linux_minimize_expect_restored_row_missing");
  ensure(
    flag_at(restored_row, "minimized") === false,
    "cu_linux_minimize_expect_inventory_restored:" + JSON.stringify(restored_row)
  );

  if (atspi_available) {
    print("STEP independent pyatspi state read-back: restored frame must be showing and not iconified");
    ensure_pyatspi_restored(
      independent_pyatspi_frame_state(run_directory, executable, fixture_title),
      "restored"
    );
  }
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-minimize-expect");
harness.emit_evidence(context, declared_evidence, "cu.linux-minimize-expect-state");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux minimize/restore usage/host-limit/miss honesty + independent xprop, xwininfo Map State, pyatspi ICONIFIED/SHOWING, and windows inventory minimized read-back with typed minimize/restore --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux minimize/restore usage/host-limit/miss honesty + independent xprop, xwininfo Map State, and windows inventory minimized read-back with typed minimize/restore --name/--coords/--bogus usage and get-extents --name host-limit honesty when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
}
return;
