// CEO: Linux app-facts honesty with independent desktop-entry and /proc/exe read-back.
// Acceptance is smoke read-back only: CU app-facts path, name and desktop_entry_id must
// agree with an independent XDG desktop-entry parse, and executable/running must agree
// with /proc/exe inventory or return typed unavailable reasons. Typed app-facts usage
// must reject AT-SPI --name, --coords, --bogus, and other unexpected arguments;
// typed get-extents --name usage AND host-limit paths must both hold before the
// desktop-entry read-back court.
// AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.linux-app-facts-readback"];

const AT_SPI_PROBE_NAME = "App Facts Court Anchor";
const BOGUS_SELECTOR = "__cu_linux_app_facts_bogus_selector__";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS", "AT_SPI_BUS", "XDG_DATA_HOME", "XDG_DATA_DIRS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_app_facts_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "app-facts" || text_at(reply, "command") === "usage",
    "cu_linux_app_facts_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_app_facts_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function invoke(run_directory, executable, arguments, expect_success, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.success === expect_success, "cu_linux_app_facts_exit:" + output.exit_code);
  const reply = JSON.parse(output.stdout.trim());
  ensure(reply.ok === expect_success, "cu_linux_app_facts_reply_state");
  ensure(reply.command === "app-facts", "cu_linux_app_facts_command");
  return reply;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_app_facts_usage_limit(run_directory, executable, env, selector) {
  const with_name = invoke_observe_reply(run_directory, executable, [
    "app-facts", "--selector", selector, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(with_name),
    "cu_linux_app_facts_usage_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_app_facts_usage_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_app_facts_usage_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_name, "error.message"), "--name"),
    "cu_linux_app_facts_usage_name_message:" + JSON.stringify(with_name.error)
  );

  const missing_selector = invoke_observe_reply(run_directory, executable, ["app-facts"], env);
  ensure(!output_success(missing_selector),
    "cu_linux_app_facts_usage_missing_selector_ok:" + JSON.stringify(missing_selector));
  ensure(
    text_at(missing_selector, "error.code") === "usage",
    "cu_linux_app_facts_usage_missing_selector_code:" + JSON.stringify(missing_selector.error)
  );
  ensure(
    text_at(missing_selector, "error.message").indexOf("--selector") >= 0,
    "cu_linux_app_facts_usage_missing_selector_message:" + JSON.stringify(missing_selector.error)
  );

  const with_bogus = invoke_observe_reply(run_directory, executable, [
    "app-facts", "--selector", selector, "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_app_facts_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_app_facts_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_app_facts_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_coords = invoke_observe_reply(run_directory, executable, [
    "app-facts", "--selector", selector, "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords),
    "cu_linux_app_facts_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_app_facts_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_app_facts_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_app_facts_usage_coords_message:" + JSON.stringify(with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_app_facts_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_app_facts_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_app_facts_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_app_facts_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_app_facts_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_app_facts_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_app_facts_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_app_facts_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_app_facts_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_app_facts_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_app_facts_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_app_facts_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_app_facts_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_app_facts_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_app_facts_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_app_facts_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_app_facts_extents_unavailable_code:" + code
  );
}

function assert_bogus_selector(run_directory, executable, env) {
  const reply = invoke(run_directory, executable,
    ["app-facts", "--selector", BOGUS_SELECTOR], false, env);
  ensure(
    text_at(reply, "error.code") === "app_facts_not_found",
    "cu_linux_app_facts_bogus_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").length > 0,
    "cu_linux_app_facts_bogus_message:" + JSON.stringify(reply.error)
  );
}

function assert_unsupported_security_fields(run_directory, executable, selector, env) {
  const reply = invoke(run_directory, executable, [
    "app-facts", "--selector", selector, "--signing", "--verify", "--entitlements",
  ], true, env);
  const data = rh.field(reply, "data");
  ensure(text_at(data, "signature.status") === "unsupported",
    "cu_linux_app_facts_signature_status:" + JSON.stringify(data.signature));
  ensure(text_at(data, "signature.reason").length > 0,
    "cu_linux_app_facts_signature_reason:" + JSON.stringify(data.signature));
  ensure(text_at(data, "signature_verified.status") === "unsupported",
    "cu_linux_app_facts_verify_status:" + JSON.stringify(data.signature_verified));
  ensure(text_at(data, "signature_verified.reason").length > 0,
    "cu_linux_app_facts_verify_reason:" + JSON.stringify(data.signature_verified));
  ensure(text_at(data, "entitlements.status") === "not-applicable",
    "cu_linux_app_facts_entitlements_status:" + JSON.stringify(data.entitlements));
  ensure(text_at(data, "entitlements.reason").length > 0,
    "cu_linux_app_facts_entitlements_reason:" + JSON.stringify(data.entitlements));
}

function probe_identity() {
  const script = [
    "import json, os, sys",
    "PREFERRED = ['xfce4-terminal.desktop', 'picom.desktop', 'plank.desktop', 'python3.13.desktop']",
    "def app_dirs():",
    "    dirs = []",
    "    home = os.environ.get('HOME', '')",
    "    xdg = os.environ.get('XDG_DATA_HOME', '')",
    "    if xdg:",
    "        dirs.append(os.path.join(xdg, 'applications'))",
    "    elif home:",
    "        dirs.append(os.path.join(home, '.local', 'share', 'applications'))",
    "    for entry in os.environ.get('XDG_DATA_DIRS', '/usr/local/share:/usr/share').split(':'):",
    "        if entry:",
    "            dirs.append(os.path.join(entry, 'applications'))",
    "    seen = set(); out = []",
    "    for d in dirs:",
    "        if d not in seen:",
    "            seen.add(d); out.append(d)",
    "    return out",
    "def running_exes():",
    "    exes = set(); bases = {}",
    "    for pid in os.listdir('/proc'):",
    "        if not pid.isdigit(): continue",
    "        try:",
    "            path = os.path.realpath(f'/proc/{pid}/exe')",
    "        except OSError:",
    "            continue",
    "        exes.add(path)",
    "        bases.setdefault(os.path.basename(path), path)",
    "    return exes, bases",
    "def parse_entry(path):",
    "    text = open(path, encoding='utf-8', errors='replace').read()",
    "    in_entry = False; name = None; exec_line = None; typ = None; hidden = False",
    "    for line in text.splitlines():",
    "        line = line.strip()",
    "        if line.startswith('['):",
    "            in_entry = line == '[Desktop Entry]'",
    "            continue",
    "        if not in_entry or not line or line.startswith('#'):",
    "            continue",
    "        if '=' not in line: continue",
    "        key, value = line.split('=', 1)",
    "        key = key.strip(); value = value.strip()",
    "        if key == 'Name' and name is None: name = value",
    "        elif key == 'Exec' and exec_line is None: exec_line = value",
    "        elif key == 'Type': typ = value",
    "        elif key == 'Hidden': hidden = value.lower() == 'true'",
    "    if hidden or typ != 'Application' or not name or not exec_line:",
    "        return None",
    "    token = exec_line.split()[0].strip('\"')",
    "    exec_absolute = token.startswith('/')",
    "    exec_canonical = None",
    "    if exec_absolute:",
    "        try: exec_canonical = os.path.realpath(token)",
    "        except OSError: exec_absolute = False",
    "    return {",
    "        'id': os.path.basename(path),",
    "        'path': os.path.realpath(path),",
    "        'name': name,",
    "        'exec_token': token,",
    "        'exec_absolute': exec_absolute,",
    "        'exec_canonical': exec_canonical,",
    "    }",
    "def is_running(candidate, exes, bases):",
    "    if candidate['exec_absolute'] and candidate['exec_canonical']:",
    "        return candidate['exec_canonical'] in exes",
    "    base = os.path.basename(candidate['exec_token'])",
    "    return base in bases",
    "exes, bases = running_exes()",
    "by_id = {}",
    "for root in app_dirs():",
    "    if not os.path.isdir(root): continue",
    "    for name in os.listdir(root):",
    "        if not name.endswith('.desktop'): continue",
    "        full = os.path.join(root, name)",
    "        if not os.path.isfile(full): continue",
    "        if name in by_id: continue",
    "        parsed = parse_entry(full)",
    "        if parsed is None: continue",
    "        parsed['running'] = is_running(parsed, exes, bases)",
    "        by_id[name] = parsed",
    "ordered = []",
    "for wanted in PREFERRED:",
    "    if wanted in by_id and by_id[wanted]['running']:",
    "        ordered.append(by_id[wanted])",
    "for item in by_id.values():",
    "    if item['running'] and item not in ordered:",
    "        ordered.append(item)",
    "if not ordered:",
    "    print(json.dumps({'available': False})); sys.exit(0)",
    "print(json.dumps({'available': True, 'candidate': ordered[0]}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(""),
    timeout_ms: 30000,
  });
  ensure(output.success, "cu_linux_app_facts_probe:" + output.stderr + output.stdout);
  const parsed = JSON.parse(output.stdout.trim());
  return parsed.available === true ? parsed.candidate : null;
}

function verify_identity(reply, probe, selector) {
  const data = rh.field(reply, "data");
  ensure(text_at(data, "platform") === "linux", "cu_linux_app_facts_platform");
  ensure(text_at(data, "selector") === selector, "cu_linux_app_facts_selector_echo");
  ensure(text_at(data, "desktop_entry_id.status") === "present", "cu_linux_app_facts_id_status");
  ensure(text_at(data, "desktop_entry_id.value") === probe.id, "cu_linux_app_facts_id_value");
  ensure(text_at(data, "name.status") === "present", "cu_linux_app_facts_name_status");
  ensure(text_at(data, "name.value") === probe.name, "cu_linux_app_facts_name_value");
  ensure(text_at(data, "path.status") === "present", "cu_linux_app_facts_path_status");
  ensure(text_at(data, "path.value") === probe.path, "cu_linux_app_facts_path_value");
  if (probe.exec_absolute && probe.exec_canonical) {
    ensure(text_at(data, "executable.status") === "present", "cu_linux_app_facts_executable_status");
    ensure(text_at(data, "executable.value") === probe.exec_canonical, "cu_linux_app_facts_executable_value");
    ensure(text_at(data, "running.status") === "present", "cu_linux_app_facts_running_status");
    const running = rh.field(data, "running.value") === true;
    ensure(running === probe.running, "cu_linux_app_facts_running_value");
  } else {
    ensure(text_at(data, "executable.status") === "unavailable", "cu_linux_app_facts_executable_unavailable");
    ensure(text_at(data, "executable.reason").indexOf("path-search") >= 0,
      "cu_linux_app_facts_executable_reason");
    ensure(text_at(data, "running.status") === "unavailable", "cu_linux_app_facts_running_unavailable");
    ensure(text_at(data, "running.reason").indexOf("path-search") >= 0,
      "cu_linux_app_facts_running_reason");
  }
}

function verify_unsupported(reply) {
  ensure(reply.ok !== true, "cu_linux_app_facts_false_success");
  ensure(text_at(reply, "error.code") === "app_facts_platform_unsupported"
    || text_at(reply, "error.code") === "app_facts_scan_failed", "cu_linux_app_facts_unsupported_code");
  ensure(text_at(reply, "error.message").length > 0, "cu_linux_app_facts_unsupported_message");
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(rh.exists(executable), "cu_linux_app_facts_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-app-facts");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
const probe = probe_identity();
const usage_selector = probe === null ? "xfce4-terminal" : (
  probe.id.endsWith(".desktop")
    ? probe.id.substring(0, probe.id.length - ".desktop".length)
    : probe.id
);
let succeeded = 0;
let failure = "";
try {
  print("STEP app-facts typed-fails usage when AT-SPI --name, --coords, --bogus, or other unexpected arguments are present");
  assert_app_facts_usage_limit(context.run_directory, executable, env, usage_selector);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before app-facts read-back court");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP app-facts typed-fails app_facts_not_found for bogus selector");
  assert_bogus_selector(context.run_directory, executable, env);

  print("STEP requested Linux security facts preserve unsupported and not-applicable truth");
  assert_unsupported_security_fields(context.run_directory, executable, usage_selector, env);

  if (probe === null) {
    print("STEP typed gap when no running desktop application can be probed independently");
    verify_unsupported(invoke(context.run_directory, executable,
      ["app-facts", "--selector", "xfce4-terminal"], false, env));
  } else {
    print("STEP app-facts identity matches independent desktop-entry read-back for "
      + probe.id);
    const selector = usage_selector;
    const reply = invoke(context.run_directory, executable,
      ["app-facts", "--selector", selector], true, env);
    verify_identity(reply, probe, text_at(reply, "data.selector"));
  }

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, declared_evidence[0]);
  harness.remove_run(context);
  if (probe === null) {
    if (atspi_available) {
      print("PASS typed gap with explicit app-facts failure when live probe is unavailable and typed app-facts/get-extents usage honesty (AT-SPI --name, no --coords)");
    } else {
      print("PASS typed gap with explicit app-facts failure when live probe is unavailable and typed app-facts/get-extents host-limit honesty (AT-SPI --name, no --coords)");
    }
  } else if (atspi_available) {
    print("PASS Linux app-facts path, name and id agree with independent desktop/proc read-back with typed app-facts/get-extents usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS Linux app-facts path, name and id agree with independent desktop/proc read-back with typed app-facts/get-extents host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
