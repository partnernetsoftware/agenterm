// CEO#5: movewin --window HANDLE --x X --y Y --expect XxY on Linux.
// Acceptance is smoke read-back only: independent windows inventory bounds,
// xwininfo Absolute upper-left, xprop WM_NAME/_NET_FRAME_EXTENTS geometry,
// and AT-SPI get-extents --name on an owned fixture node must match the
// requested window origin shift. Typed movewin usage must reject AT-SPI
// --name, --coords, --bogus, and other unexpected arguments via
// usage_rejects_unexpected + command=usage, or an honest non-usage typed
// failure (never fake command=usage). Typed get-extents --name usage AND
// host-limit paths must both hold before process-state, desktop-state, and
// the movewin actuate/read-back court (no if/else gating those courts on
// atspi_available); get-extents --coords/--bogus must reject as
// command=usage. process-state and desktop-state courts bind the owned
// fixture before the independent actuate/read-back court. Destructive-gate
// refusals, missing-window and headless host-limit paths must also hold
// before any owned fixture window exists. Prefer host-limit clarity over
// fake success. AT-SPI/--name only; no --coords, screenshot, or coordinate
// degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-window-move-expect",
];

const MISSING_HANDLE = "99999999";
const NAMED_NODE = "Fixture Press";
const AT_SPI_PROBE_NAME = "Window Move Court Anchor";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;
const DELTA_X = 60;
const DELTA_Y = 40;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_move_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}


function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(rh.output_success(document), "cu_linux_window_move_reply:" + JSON.stringify(document));
  return document;
}

function move_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["movewin"].concat(arguments));
  ensure(
    !rh.output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_window_move_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_move_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_cu_windows_enum_available(run_directory, executable, env) {
  const reply = run_cu_reply(run_directory, executable, "observe", ["windows"], env);
  if (rh.output_success(reply)) { return { available: true }; }
  const message = text_at(reply, "error.message");
  if (message.indexOf("Maximum number of clients reached") >= 0
      || message.indexOf("window_enum_failed") >= 0) {
    return { available: false, reason: "x11_window_enum_unavailable" };
  }
  return { available: false, reason: message };
}

function assert_movewin_unexpected_usage(run_directory, executable, env) {
  const with_name = run_cu_reply(run_directory, executable, "actuate", [
    "movewin", "--window", "1",
    "--x", "100", "--y", "100", "--expect", "100x100",
    "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(with_name),
    "cu_linux_window_move_usage_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_window_move_usage_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_window_move_usage_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_name, "error.message"), "--name"),
    "cu_linux_window_move_usage_name_message:" + JSON.stringify(with_name.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, "actuate", [
    "movewin", "--window", "1",
    "--x", "100", "--y", "100", "--expect", "100x100",
    "--bogus",
  ], env);
  ensure(!rh.output_success(with_bogus),
    "cu_linux_window_move_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_window_move_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_window_move_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_window_move_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_coords = run_cu_reply(run_directory, executable, "actuate", [
    "movewin", "--window", "1",
    "--x", "100", "--y", "100", "--expect", "100x100",
    "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(with_coords),
    "cu_linux_window_move_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_window_move_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_window_move_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_window_move_usage_coords_message:" + JSON.stringify(with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_window_move_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_window_move_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_window_move_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_window_move_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_window_move_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_window_move_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_window_move_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_window_move_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_window_move_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_window_move_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_window_move_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_window_move_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_window_move_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_window_move_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_window_move_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_window_move_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_window_move_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_window_move_extents_unavailable_code:" + code
  );
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_window_move_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_window_move_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_window_move_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_window_move_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_window_move_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function assert_movewin_usage_limit(run_directory, executable) {
  const zero_window = run_cu_reply(run_directory, executable, "actuate", [
    "movewin", "--window", "0",
    "--x", "100", "--y", "100", "--expect", "100x100",
  ]);
  ensure(!rh.output_success(zero_window), "cu_linux_window_move_usage_ok:" + JSON.stringify(zero_window));
  ensure(
    text_at(zero_window, "error.code") === "usage",
    "cu_linux_window_move_usage_code:" + JSON.stringify(zero_window.error)
  );
  ensure(
    text_at(zero_window, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_window_move_usage_message:" + JSON.stringify(zero_window.error)
  );

  const missing_y = run_cu_reply(run_directory, executable, "actuate", [
    "movewin", "--window", "1", "--x", "100", "--expect", "100x100",
  ]);
  ensure(!rh.output_success(missing_y), "cu_linux_window_move_missing_y_ok:" + JSON.stringify(missing_y));
  ensure(
    text_at(missing_y, "error.code") === "usage",
    "cu_linux_window_move_missing_y_code:" + JSON.stringify(missing_y.error)
  );
  ensure(
    text_at(missing_y, "error.message").indexOf("--x") >= 0
      && text_at(missing_y, "error.message").indexOf("--y") >= 0,
    "cu_linux_window_move_missing_y_message:" + JSON.stringify(missing_y.error)
  );

  const mismatched_expect = run_cu_reply(run_directory, executable, "actuate", [
    "movewin", "--window", "1",
    "--x", "100", "--y", "100", "--expect", "200x100",
  ]);
  ensure(!rh.output_success(mismatched_expect), "cu_linux_window_move_mismatch_ok:" + JSON.stringify(mismatched_expect));
  ensure(
    text_at(mismatched_expect, "error.code") === "invalid_input",
    "cu_linux_window_move_mismatch_code:" + JSON.stringify(mismatched_expect.error)
  );
  ensure(
    text_at(mismatched_expect, "error.message").indexOf("must match") >= 0,
    "cu_linux_window_move_mismatch_message:" + JSON.stringify(mismatched_expect.error)
  );
}

function assert_movewin_destructive_gate(run_directory, executable) {
  const missing_target = move_refused(run_directory, executable, [
    "--x", "100", "--y", "100", "--expect", "100x100",
  ], "refused");
  ensure(
    text_at(missing_target, "error.detail.reason") === "destructive_gate"
      && text_at(missing_target, "error.detail.effect") === "not_performed"
      && missing_target.error.detail.missing.length >= 1
      && text_of(missing_target.error.detail.missing[0]) === "target",
    "cu_linux_window_move_missing_target:" + JSON.stringify(missing_target)
  );
}

function assert_movewin_missing_window(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "actuate", [
    "movewin", "--window", MISSING_HANDLE,
    "--x", "100", "--y", "100", "--expect", "100x100",
  ]);
  ensure(!rh.output_success(reply), "cu_linux_window_move_missing_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "failed",
    "cu_linux_window_move_missing_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("not found") >= 0,
    "cu_linux_window_move_missing_message:" + JSON.stringify(reply.error)
  );
}

function assert_headless_host_limit(run_directory, executable) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    ["movewin", "--window", "1", "--x", "100", "--y", "100", "--expect", "100x100"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!rh.output_success(reply), "cu_linux_window_move_headless_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_window_move_headless_code:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("window enumeration") >= 0
      || message.indexOf("mechanism unavailable") >= 0,
    "cu_linux_window_move_headless_message:" + JSON.stringify(reply.error)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function bounds_xy(row) {
  const bounds = at(row, "bounds");
  return {
    x: int_at(bounds, "x"),
    y: int_at(bounds, "y"),
    width: int_at(bounds, "width"),
    height: int_at(bounds, "height"),
  };
}

function parse_xwininfo_origin(stdout) {
  let x = 0;
  let y = 0;
  let have_x = false;
  let have_y = false;
  for (const line of stdout.split("\n")) {
    const trimmed = line.trim();
    if (trimmed.indexOf("Absolute upper-left X:") === 0) {
      x = rh.parse_int(trimmed.slice("Absolute upper-left X:".length).trim());
      have_x = true;
    } else if (trimmed.indexOf("Absolute upper-left Y:") === 0) {
      y = rh.parse_int(trimmed.slice("Absolute upper-left Y:".length).trim());
      have_y = true;
    }
  }
  return { x, y, have_x, have_y };
}

function independent_xwininfo_origin(run_directory, executable, handle) {
  const output = rh.command("xwininfo", ["-id", "" + handle], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  ensure(output.success === true,
    "cu_linux_window_move_xwininfo:" + output.stderr + output.stdout);
  const origin = parse_xwininfo_origin(output.stdout);
  ensure(origin.have_x === true && origin.have_y === true,
    "cu_linux_window_move_xwininfo_parse:" + output.stdout);
  return origin;
}

function parse_xprop_quoted_name(stdout, property_name) {
  for (const line of stdout.split("\n")) {
    const trimmed = line.trim();
    if (trimmed.indexOf(property_name) !== 0) { continue; }
    if (trimmed.indexOf("not found") >= 0) { return ""; }
    const eq = trimmed.indexOf("=");
    if (eq < 0) { continue; }
    let value = trimmed.slice(eq + 1).trim();
    if (value.length >= 2 && value.charAt(0) === "\"") {
      value = value.slice(1);
      if (value.charAt(value.length - 1) === "\"") {
        value = value.slice(0, value.length - 1);
      }
    }
    return value;
  }
  return "";
}

function parse_xprop_frame_extents(stdout) {
  for (const line of stdout.split("\n")) {
    const trimmed = line.trim();
    if (trimmed.indexOf("_NET_FRAME_EXTENTS") !== 0) { continue; }
    if (trimmed.indexOf("not found") >= 0) {
      return { available: false, left: 0, right: 0, top: 0, bottom: 0 };
    }
    const eq = trimmed.indexOf("=");
    if (eq < 0) { continue; }
    const parts = trimmed.slice(eq + 1).trim().split(",");
    if (parts.length < 4) { continue; }
    return {
      available: true,
      left: rh.parse_int(parts[0].trim()),
      right: rh.parse_int(parts[1].trim()),
      top: rh.parse_int(parts[2].trim()),
      bottom: rh.parse_int(parts[3].trim()),
    };
  }
  return { available: false, left: 0, right: 0, top: 0, bottom: 0 };
}

function independent_xprop_geometry(run_directory, executable, handle) {
  const output = rh.command("xprop", [
    "-id", "" + handle,
    "_NET_FRAME_EXTENTS",
    "_NET_WM_NAME",
    "WM_NAME",
  ], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  ensure(output.success === true,
    "cu_linux_window_move_xprop:" + output.stderr + output.stdout);
  const net_name = parse_xprop_quoted_name(output.stdout, "_NET_WM_NAME");
  const wm_name = parse_xprop_quoted_name(output.stdout, "WM_NAME");
  const name = net_name !== "" ? net_name : wm_name;
  ensure(name !== "", "cu_linux_window_move_xprop_name:" + output.stdout);
  const extents = parse_xprop_frame_extents(output.stdout);
  return {
    name: name,
    frame_extents_available: extents.available === true,
    left: extents.left,
    right: extents.right,
    top: extents.top,
    bottom: extents.bottom,
  };
}

function assert_xprop_geometry_agrees(probe, title, prior, label) {
  ensure(
    probe.name === title,
    "cu_linux_window_move_xprop_title_" + label + ":" + JSON.stringify(probe)
  );
  if (prior === null) { return; }
  ensure(
    probe.frame_extents_available === prior.frame_extents_available
      && probe.left === prior.left
      && probe.right === prior.right
      && probe.top === prior.top
      && probe.bottom === prior.bottom,
    "cu_linux_window_move_xprop_frame_changed_" + label + ":" + JSON.stringify({
      before: prior,
      after: probe,
    })
  );
}

function independent_probe_script() {
  return [
    "import json, sys",
    "import pyatspi",
    "",
    "config = json.loads(sys.argv[1])",
    "title = config['title']",
    "name = config['name']",
    "I32_MIN = -2147483648",
    "",
    "def node_name(obj):",
    "    try: return obj.name or ''",
    "    except Exception: return ''",
    "",
    "def is_readable(x, y, width, height):",
    "    return width > 0 and height > 0 and x != I32_MIN and y != I32_MIN",
    "",
    "def find_named(root, needle):",
    "    if node_name(root) == needle:",
    "        return root",
    "    try: child_count = root.childCount",
    "    except Exception: child_count = 0",
    "    for index in range(child_count):",
    "        try: child = root.getChildAtIndex(index)",
    "        except Exception: child = None",
    "        if child is None: continue",
    "        found = find_named(child, needle)",
    "        if found is not None: return found",
    "    return None",
    "",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "application = None",
    "for candidate in desktop:",
    "    try:",
    "        for index in range(candidate.childCount):",
    "            window = candidate.getChildAtIndex(index)",
    "            if window is not None and node_name(window) == title:",
    "                application = candidate",
    "                break",
    "        if application is not None: break",
    "    except Exception: continue",
    "if application is None:",
    "    raise SystemExit('cu_linux_window_move_probe_window_missing')",
    "",
    "node = find_named(application, name)",
    "if node is None:",
    "    raise SystemExit('cu_linux_window_move_probe_node_missing:' + name)",
    "",
    "try:",
    "    component = node.queryComponent()",
    "    x, y, width, height = component.getExtents(pyatspi.DESKTOP_COORDS)",
    "except Exception as error:",
    "    print(json.dumps({'available': False, 'reason': str(error)}))",
    "    raise SystemExit(0)",
    "",
    "print(json.dumps({",
    "    'available': is_readable(x, y, width, height),",
    "    'x': x, 'y': y, 'width': width, 'height': height,",
    "}))",
  ].join("\n");
}

function independent_extents(run_directory, title, node_name) {
  const output = rh.command(
    "python3",
    ["-c", independent_probe_script(), JSON.stringify({ title: title, name: node_name })],
    { cwd: run_directory, env: cu_env(""), timeout_ms: 45000 },
  );
  ensure(output.success === true, "cu_linux_window_move_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function get_extents_cu(run_directory, executable, handle_text, node_name) {
  const reply = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", handle_text, "--name", node_name,
  ]);
  ensure(text_at(reply, "data.via") === "get-extents", "cu_linux_window_move_extents_via");
  ensure(
    text_at(reply, "data.addressing") === "accessibility-tree",
    "cu_linux_window_move_extents_addressing"
  );
  return reply;
}

function assert_named_extents_agreement(
  run_directory, executable, handle_text, fixture_title, node_name, label
) {
  const cu = get_extents_cu(run_directory, executable, handle_text, node_name);
  const probe = independent_extents(run_directory, fixture_title, node_name);
  ensure(
    probe.available === true,
    "cu_linux_window_move_probe_readable_" + label + ":" + JSON.stringify(probe)
  );
  ensure(
    int_at(cu, "data.extents.x") === probe.x
      && int_at(cu, "data.extents.y") === probe.y
      && int_at(cu, "data.extents.width") === probe.width
      && int_at(cu, "data.extents.height") === probe.height,
    "cu_linux_window_move_extents_mismatch_" + label + ":" + JSON.stringify({
      cu: cu.data.extents,
      probe: probe,
    })
  );
  return {
    x: probe.x,
    y: probe.y,
    width: probe.width,
    height: probe.height,
  };
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const context = harness.new_context(repo, "cu-linux-window-move");
const run_directory = rh.join(repo, "target/cu-linux-window-move-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_window_move_fixture_missing:" + fixture_source);

const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let window_enum = { available: false, reason: "not_probed" };
let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";

try {
  print("STEP movewin typed-fails usage when --window handle is zero or geometry args are incomplete");
  assert_movewin_usage_limit(run_directory, executable);

  print("STEP movewin typed-fails usage when AT-SPI --name/--coords/--bogus is present (usage_rejects_unexpected + command=usage, or honest non-usage typed failure; never fake command=usage)");
  assert_movewin_unexpected_usage(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (command=usage) before process-state/desktop-state and movewin actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and movewin actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP movewin typed-fails refused destructive_gate when --window target is missing");
  assert_movewin_destructive_gate(run_directory, executable);

  print("STEP movewin typed-fails failed when handle is absent from inventory");
  assert_movewin_missing_window(run_directory, executable);

  print("STEP movewin without DISPLAY typed-fails unsupported host-limit");
  assert_headless_host_limit(run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; movewin read-back still uses xwininfo/xprop/inventory");
  }

  window_enum = probe_cu_windows_enum_available(run_directory, executable, env);
  if (window_enum.available !== true) {
    print("STEP typed host-limit when CU windows enumeration is unavailable before movewin actuate/read-back court");
    succeeded = 1;
  } else {
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_window_move_window_wait");

    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_window_move_window_missing");
    const handle_text = "" + int_at(row, "handle");
    ensure(int_at(row, "handle") > 0, "cu_linux_window_move_handle:" + JSON.stringify(row));

    print("STEP process-state binds the owned fixture pid before movewin actuate/read-back court");
    assert_fixture_process_state(run_directory, executable, fixture_pid);

    print("STEP desktop-state window row agrees with inventory before movewin actuate/read-back court");
    assert_fixture_desktop_state(
      run_directory, executable, fixture_pid, fixture_title, handle_text, row
    );

    const before = bounds_xy(row);
    const target_x = before.x + DELTA_X;
    const target_y = before.y + DELTA_Y;
    const expect_token = "" + target_x + "x" + target_y;

    print("STEP baseline windows bounds read (" + before.x + "," + before.y + ")");
    ensure(before.width > 0 && before.height > 0, "cu_linux_window_move_before_size");

    print("STEP baseline independent xprop WM_NAME/_NET_FRAME_EXTENTS geometry");
    const xprop_before = independent_xprop_geometry(
      run_directory, executable, int_at(row, "handle"));
    assert_xprop_geometry_agrees(xprop_before, fixture_title, null, "baseline");

    let node_before = null;
    if (atspi_available) {
      print("STEP baseline independent get-extents --name " + NAMED_NODE + " agrees with pyatspi");
      node_before = assert_named_extents_agreement(
        run_directory, executable, handle_text, fixture_title, NAMED_NODE, "baseline"
      );
    }

    print("STEP invalid_input refusals on a live handle must not change inventory, xwininfo, xprop, or AT-SPI extents");
    move_refused(run_directory, executable, [
      "--window", handle_text,
      "--x", "" + target_x, "--y", "" + target_y,
      "--expect", "" + (target_x + 1) + "x" + target_y,
    ], "invalid_input");
    const refusal_row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(refusal_row !== null, "cu_linux_window_move_refusal_row_missing");
    const refusal_bounds = bounds_xy(refusal_row);
    ensure(
      refusal_bounds.x === before.x && refusal_bounds.y === before.y,
      "cu_linux_window_move_refusal_inventory_changed:" + JSON.stringify(refusal_bounds)
    );
    const refusal_xwininfo = independent_xwininfo_origin(
      run_directory, executable, int_at(refusal_row, "handle"));
    ensure(
      refusal_xwininfo.x === before.x && refusal_xwininfo.y === before.y,
      "cu_linux_window_move_refusal_xwininfo_changed:" + JSON.stringify(refusal_xwininfo)
    );
    const xprop_refusal = independent_xprop_geometry(
      run_directory, executable, int_at(refusal_row, "handle"));
    assert_xprop_geometry_agrees(xprop_refusal, fixture_title, xprop_before, "refusal");
    if (atspi_available) {
      const node_refusal = assert_named_extents_agreement(
        run_directory, executable, handle_text, fixture_title, NAMED_NODE, "refusal"
      );
      ensure(
        node_refusal.x === node_before.x && node_refusal.y === node_before.y
          && node_refusal.width === node_before.width && node_refusal.height === node_before.height,
        "cu_linux_window_move_refusal_extents_changed:" + JSON.stringify({
          before: node_before,
          after: node_refusal,
        })
      );
    }

    print("STEP movewin --window " + handle_text + " --x " + target_x + " --y " + target_y + " --expect " + expect_token);
    const moved = run_cu(run_directory, executable, "actuate", [
      "movewin", "--window", handle_text, "--x", "" + target_x, "--y", "" + target_y,
      "--expect", expect_token,
    ]);
    ensure(
      int_at(moved, "data.after.x") === target_x
        && int_at(moved, "data.after.y") === target_y,
      "cu_linux_window_move_reply_geometry:" + JSON.stringify(moved.data)
    );

    print("STEP independent windows inventory read-back must match the requested origin");
    const after_row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(after_row !== null, "cu_linux_window_move_after_window_missing");
    const after = bounds_xy(after_row);
    ensure(
      after.x === target_x && after.y === target_y,
      "cu_linux_window_move_readback:got(" + after.x + "," + after.y + ") want(" + target_x + "," + target_y + ")"
    );
    ensure(
      after.width === before.width && after.height === before.height,
      "cu_linux_window_move_size_preserved:" + JSON.stringify(after)
    );

    print("STEP independent xwininfo Absolute upper-left read-back must match the requested origin");
    const xwininfo = independent_xwininfo_origin(
      run_directory, executable, int_at(after_row, "handle"));
    ensure(
      xwininfo.x === target_x && xwininfo.y === target_y,
      "cu_linux_window_move_xwininfo_readback:got(" + xwininfo.x + "," + xwininfo.y
        + ") want(" + target_x + "," + target_y + ")"
    );

    print("STEP independent xprop WM_NAME/_NET_FRAME_EXTENTS geometry must keep identity and frame after the origin shift");
    const xprop_after = independent_xprop_geometry(
      run_directory, executable, int_at(after_row, "handle"));
    assert_xprop_geometry_agrees(xprop_after, fixture_title, xprop_before, "after_move");

    if (atspi_available) {
      print("STEP independent get-extents --name " + NAMED_NODE + " must shift by the same screen delta as the window");
      const node_after = assert_named_extents_agreement(
        run_directory, executable, handle_text, fixture_title, NAMED_NODE, "after_move"
      );
      ensure(
        node_after.x === node_before.x + DELTA_X && node_after.y === node_before.y + DELTA_Y,
        "cu_linux_window_move_named_origin_shift:got(" + node_after.x + "," + node_after.y
          + ") want(" + (node_before.x + DELTA_X) + "," + (node_before.y + DELTA_Y) + ")"
      );
      ensure(
        node_after.width === node_before.width && node_after.height === node_before.height,
        "cu_linux_window_move_named_size_preserved:" + JSON.stringify({
          before: node_before,
          after: node_after,
        })
      );
    }

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid !== 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
}
if (fixture >= 0) {
  try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
}

if (succeeded !== 0 && failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-window-move-expect");
  harness.remove_run(context);
  if (window_enum.available !== true) {
    print("PASS: Linux movewin usage/host-limit/miss honesty with typed movewin --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage) and get-extents --name usage AND host-limit with --coords/--bogus command=usage (no atspi gating) when CU inventory is unavailable (AT-SPI --name, no --coords)");
  } else if (atspi_available) {
    print("PASS: Linux movewin --expect usage/host-limit/miss honesty + process-state/desktop-state courts + independent windows inventory, xwininfo origin, xprop geometry, and pyatspi get-extents --name read-back with typed movewin --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage) and get-extents --name usage AND host-limit with --coords/--bogus command=usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux movewin --expect usage/host-limit/miss honesty + process-state/desktop-state courts + independent windows inventory, xwininfo origin, and xprop geometry read-back with typed movewin --name/--coords/--bogus usage_rejects_unexpected and get-extents --name host-limit plus --coords/--bogus command=usage honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
return;
