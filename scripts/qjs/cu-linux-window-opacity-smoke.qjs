// CEO: window-opacity --opacity/--expect on Linux.
// Acceptance is smoke read-back only: independent xprop _NET_WM_WINDOW_OPACITY
// and windows inventory `opacity` must match --expect after set. Typed usage
// must reject AT-SPI --name and other unexpected arguments; typed get-extents
// --name usage/host-limit paths must hold before the window-opacity actuate/
// read-back court. Destructive-gate refusals, missing-window and headless
// host-limit paths must hold before any owned fixture window exists.
// AT-SPI/--name only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-window-opacity",
];

const AT_SPI_PROBE_NAME = "Window Opacity Court Anchor";
const MISSING_HANDLE = "99999999";
const TARGET_OPACITY = 0.5;
const TARGET_PERMILLE = 500;
const OPAQUE_CARDINAL = 4294967295;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function float_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return Number("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_opacity_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_window_opacity_reply:" + JSON.stringify(document));
  return document;
}

function opacity_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["window-opacity"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_window_opacity_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_window_opacity_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "actuate",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_opacity_actuate_cli:" + output.stderr);
  const reply = JSON.parse(trimmed);
  const command = text_at(reply, "command");
  ensure(
    command === "window-opacity" || command === "usage",
    "cu_linux_window_opacity_actuate_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_opacity_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_opacity_usage_limit(run_directory, executable) {
  const zero_window = run_cu_reply(run_directory, executable, "actuate", [
    "window-opacity", "--window", "0",
    "--opacity", "" + TARGET_OPACITY, "--expect", "" + TARGET_OPACITY,
  ]);
  ensure(!output_success(zero_window), "cu_linux_window_opacity_usage_ok:" + JSON.stringify(zero_window));
  ensure(
    text_at(zero_window, "error.code") === "usage",
    "cu_linux_window_opacity_usage_code:" + JSON.stringify(zero_window.error)
  );
  ensure(
    text_at(zero_window, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_window_opacity_usage_message:" + JSON.stringify(zero_window.error)
  );

  const mismatched_expect = run_cu_reply(run_directory, executable, "actuate", [
    "window-opacity", "--window", "1",
    "--opacity", "" + TARGET_OPACITY, "--expect", "0.8",
  ]);
  ensure(!output_success(mismatched_expect), "cu_linux_window_opacity_mismatch_ok:" + JSON.stringify(mismatched_expect));
  ensure(
    text_at(mismatched_expect, "error.code") === "invalid_input",
    "cu_linux_window_opacity_mismatch_code:" + JSON.stringify(mismatched_expect.error)
  );
  ensure(
    text_at(mismatched_expect, "error.message").indexOf("must match") >= 0,
    "cu_linux_window_opacity_mismatch_message:" + JSON.stringify(mismatched_expect.error)
  );
}

function assert_window_opacity_atspi_name_usage_limit(run_directory, executable, env) {
  const with_name = invoke_window_opacity_reply(run_directory, executable, [
    "window-opacity",
    "--window", "1",
    "--name", AT_SPI_PROBE_NAME,
    "--opacity", "" + TARGET_OPACITY,
    "--expect", "" + TARGET_OPACITY,
  ], env);
  ensure(!output_success(with_name), "cu_linux_window_opacity_usage_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_window_opacity_usage_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_window_opacity_usage_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    text_at(with_name, "error.message").indexOf("--name") >= 0
      || text_at(with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_window_opacity_usage_name_message:" + JSON.stringify(with_name.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_window_opacity_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_window_opacity_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_window_opacity_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_window_opacity_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_window_opacity_extents_unavailable_code:" + code
  );
}

function assert_opacity_destructive_gate(run_directory, executable) {
  const missing_target = opacity_refused(
    run_directory, executable, ["--opacity", "" + TARGET_OPACITY], "refused"
  );
  ensure(
    text_at(missing_target, "error.detail.reason") === "destructive_gate"
      && text_at(missing_target, "error.detail.effect") === "not_performed"
      && missing_target.error.detail.missing.length >= 1
      && text_of(missing_target.error.detail.missing[0]) === "target",
    "cu_linux_window_opacity_missing_target:" + JSON.stringify(missing_target)
  );

  const missing_postcondition = opacity_refused(
    run_directory, executable, ["--window", "1", "--opacity", "" + TARGET_OPACITY], "refused"
  );
  ensure(
    text_at(missing_postcondition, "error.detail.reason") === "destructive_gate"
      && missing_postcondition.error.detail.missing.length === 1
      && text_of(missing_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_window_opacity_missing_postcondition:" + JSON.stringify(missing_postcondition)
  );
}

function assert_opacity_missing_window(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "actuate", [
    "window-opacity", "--window", MISSING_HANDLE,
    "--opacity", "" + TARGET_OPACITY, "--expect", "" + TARGET_OPACITY,
  ]);
  ensure(!output_success(reply), "cu_linux_window_opacity_missing_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "window_op_failed",
    "cu_linux_window_opacity_missing_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_window_opacity_missing_effect:" + JSON.stringify(reply.error)
  );
}

function assert_headless_host_limit(run_directory, executable) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    [
      "window-opacity", "--window", "1",
      "--opacity", "" + TARGET_OPACITY, "--expect", "" + TARGET_OPACITY,
    ],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_window_opacity_headless_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_window_opacity_headless_code:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("mechanism unavailable") >= 0
      || message.indexOf("agt_native_window_opacity") >= 0,
    "cu_linux_window_opacity_headless_message:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_window_opacity_headless_effect:" + JSON.stringify(reply.error)
  );
}

function window_rows(reply) {
  const data = reply.data;
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  for (const row of window_rows(reply)) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function parse_xprop_opacity(stdout) {
  if (stdout.indexOf("not found") >= 0) { return OPAQUE_CARDINAL; }
  const marker = "_NET_WM_WINDOW_OPACITY(CARDINAL) = ";
  const start = stdout.indexOf(marker);
  if (start < 0) { return -1; }
  const tail = stdout.slice(start + marker.length).trim();
  const end = tail.indexOf("\n");
  const number = end < 0 ? tail : tail.slice(0, end);
  if (number === "") { return -1; }
  return rh.parse_int(number);
}

function cardinal_to_permille(cardinal) {
  if (cardinal < 0) { return -1; }
  return Math.round((cardinal * 1000) / OPAQUE_CARDINAL);
}

function opacity_close(got_permille, want_permille) {
  return Math.abs(got_permille - want_permille) <= 2;
}

function independent_net_wm_opacity(run_directory, executable, handle) {
  const xprop = rh.command("xprop", ["-id", "" + handle, "_NET_WM_WINDOW_OPACITY"], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (!xprop.success) { return -1; }
  return parse_xprop_opacity(xprop.stdout);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-window-opacity-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_window_opacity_fixture_missing:" + fixture_source);

print("STEP window-opacity typed-fails usage when --window handle is zero or --expect mismatches --opacity");
assert_opacity_usage_limit(run_directory, executable);

print("STEP window-opacity typed-fails usage when AT-SPI --name is present");
assert_window_opacity_atspi_name_usage_limit(run_directory, executable, env);

const atspi_available = probe_atspi_available(executable);
if (atspi_available) {
  print("STEP get-extents typed-fail invalid_input when --window is zero before window-opacity actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);
} else {
  print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
}

print("STEP window-opacity typed-fails refused destructive_gate when target or postcondition is missing");
assert_opacity_destructive_gate(run_directory, executable);

print("STEP window-opacity typed-fails window_op_failed when handle is absent from inventory");
assert_opacity_missing_window(run_directory, executable);

print("STEP window-opacity without DISPLAY typed-fails unsupported host-limit");
assert_headless_host_limit(run_directory, executable);

const caps = run_cu(run_directory, executable, "observe", ["capabilities"]);
const opacity_readback = text_at(caps, "data.verbs.window-opacity.opacity_readback");
if (opacity_readback !== "available") {
  print("STEP host lacks window opacity; typed unsupported = " + opacity_readback);
  ensure(
    text_at(caps, "data.verbs.window-opacity.status") === "unsupported"
      || opacity_readback !== "",
    "cu_linux_window_opacity_unsupported_shape:" + JSON.stringify(caps.data.verbs["window-opacity"])
  );
  print("PASS: typed unsupported host-limit; alternatives: xprop -id HANDLE _NET_WM_WINDOW_OPACITY");
  return;
}

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_window_opacity_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_window_opacity_window_missing");
  const handle = int_at(row, "handle");
  const handle_text = "" + handle;
  ensure(handle > 0, "cu_linux_window_opacity_handle:" + JSON.stringify(row));
  const baseline_permille = Math.round(float_at(row, "opacity") * 1000);
  ensure(
    opacity_close(baseline_permille, 1000),
    "cu_linux_window_opacity_baseline_opaque:" + JSON.stringify(row)
  );
  ensure(
    opacity_close(cardinal_to_permille(independent_net_wm_opacity(run_directory, executable, handle)), 1000),
    "cu_linux_window_opacity_baseline_xprop_opaque"
  );

  print("STEP destructive_gate refusals on a live handle must not change xprop or inventory");
  opacity_refused(
    run_directory, executable,
    ["--window", handle_text, "--opacity", "" + TARGET_OPACITY],
    "refused"
  );
  const mismatch = run_cu_reply(run_directory, executable, "actuate", [
    "window-opacity", "--window", handle_text,
    "--opacity", "" + TARGET_OPACITY, "--expect", "0.8",
  ]);
  ensure(
    !output_success(mismatch) && text_at(mismatch, "error.code") === "invalid_input",
    "cu_linux_window_opacity_live_mismatch:" + JSON.stringify(mismatch)
  );
  ensure(
    opacity_close(cardinal_to_permille(independent_net_wm_opacity(run_directory, executable, handle)), 1000),
    "cu_linux_window_opacity_refusal_xprop_changed"
  );
  const refusal_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(refusal_row !== null, "cu_linux_window_opacity_refusal_row_missing");
  ensure(
    opacity_close(Math.round(float_at(refusal_row, "opacity") * 1000), 1000),
    "cu_linux_window_opacity_refusal_inventory_changed:" + JSON.stringify(refusal_row)
  );

  print("STEP window-opacity --window " + handle_text + " --opacity " + TARGET_OPACITY + " --expect " + TARGET_OPACITY);
  const set_reply = run_cu(run_directory, executable, "actuate", [
    "window-opacity",
    "--window", handle_text,
    "--opacity", "" + TARGET_OPACITY,
    "--expect", "" + TARGET_OPACITY,
  ]);
  ensure(
    flag_at(set_reply, "data.verified") === true
      && opacity_close(int_at(set_reply, "data.after.opacity_permille"), TARGET_PERMILLE),
    "cu_linux_window_opacity_set_reply:" + JSON.stringify(set_reply.data)
  );

  print("STEP independent xprop _NET_WM_WINDOW_OPACITY read-back");
  const cardinal = independent_net_wm_opacity(run_directory, executable, handle);
  const xprop_permille = cardinal_to_permille(cardinal);
  ensure(
    opacity_close(xprop_permille, TARGET_PERMILLE),
    "cu_linux_window_opacity_xprop_mismatch:cardinal=" + cardinal + ":permille=" + xprop_permille
  );

  print("STEP independent windows inventory opacity read-back");
  const after_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(after_row !== null, "cu_linux_window_opacity_after_row_missing");
  const inventory_permille = Math.round(float_at(after_row, "opacity") * 1000);
  ensure(
    opacity_close(inventory_permille, TARGET_PERMILLE),
    "cu_linux_window_opacity_inventory_mismatch:" + JSON.stringify(after_row)
  );

  print("STEP restore opacity to 1.0");
  const restore = run_cu(run_directory, executable, "actuate", [
    "window-opacity",
    "--window", handle_text,
    "--opacity", "1",
    "--expect", "1",
  ]);
  ensure(
    flag_at(restore, "data.verified") === true
      && opacity_close(int_at(restore, "data.after.opacity_permille"), 1000),
    "cu_linux_window_opacity_restore_reply:" + JSON.stringify(restore.data)
  );

  print("STEP independent xprop _NET_WM_WINDOW_OPACITY read-back: opaque");
  const restored_cardinal = independent_net_wm_opacity(run_directory, executable, handle);
  const restored_xprop_permille = cardinal_to_permille(restored_cardinal);
  ensure(
    opacity_close(restored_xprop_permille, 1000),
    "cu_linux_window_opacity_xprop_restore_mismatch:cardinal=" + restored_cardinal
      + ":permille=" + restored_xprop_permille
  );

  print("STEP independent windows inventory opacity read-back: opaque");
  const restored_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(restored_row !== null, "cu_linux_window_opacity_restored_row_missing");
  const restored_inventory_permille = Math.round(float_at(restored_row, "opacity") * 1000);
  ensure(
    opacity_close(restored_inventory_permille, 1000),
    "cu_linux_window_opacity_inventory_restore_mismatch:" + JSON.stringify(restored_row)
  );
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-window-opacity");
harness.emit_evidence(context, declared_evidence, "cu.linux-window-opacity");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux window-opacity usage/miss/host-limit honesty + independent xprop and windows inventory opacity read-back with typed window-opacity/get-extents usage honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux window-opacity usage/miss/host-limit honesty + independent xprop and windows inventory opacity read-back with typed window-opacity/get-extents host-limit honesty (AT-SPI --name, no --coords)");
}
return;
