// CEO: Linux process-kill honesty with independent waitpid read-back.
// Acceptance is smoke read-back only: CU process-kill with start-identity on
// disposable children must agree with independent waitpid/exit for graceful
// and forceful termination paths. No --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-kill-readback",
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function verify_kill_readback(run_directory, executable, mode) {
  const script = [
    "import json, os, subprocess, sys, time",
    "mode = sys.argv[1]",
    "cu = sys.argv[2]",
    "if mode in ('graceful-exit', 'forceful-exit'):",
    "    proc = subprocess.Popen(",
    "        ['sleep', '300'],",
    "        stdout=subprocess.DEVNULL,",
    "        stderr=subprocess.DEVNULL,",
    "    )",
    "elif mode == 'graceful-refused':",
    "    proc = subprocess.Popen(",
    "        ['/bin/sh', '-c', \"trap '' TERM; while :; do sleep 1; done\"],",
    "        stdout=subprocess.DEVNULL,",
    "        stderr=subprocess.DEVNULL,",
    "    )",
    "else:",
    "    raise SystemExit('cu_linux_process_kill_spawn_mode:' + mode)",
    "pid = proc.pid",
    "def proc_alive():",
    "    try:",
    "        with open(f'/proc/{pid}/stat') as handle:",
    "            stat = handle.read()",
    "    except FileNotFoundError:",
    "        return False",
    "    close = stat.rfind(')')",
    "    if close < 0:",
    "        raise ValueError('process stat has no closing command delimiter')",
    "    state = stat[close + 2]",
    "    return state not in ('Z', 'X', 'x')",
    "def invoke_state():",
    "    out = subprocess.check_output(",
    "        [cu, '--target', 'current', '--grant', 'observe',",
    "         'process-state', '--pid', str(pid)],",
    "        text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok') or reply.get('command') != 'process-state':",
    "        raise SystemExit('cu_linux_process_kill_reply_state')",
    "    return reply['data']",
    "def invoke_kill(identity, kill_mode, timeout_ms=5000):",
    "    out = subprocess.run(",
    "        [cu, '--target', 'current', '--grant', 'observe,actuate',",
    "         'process-kill', '--pid', str(pid),",
    "         '--start-identity', identity,",
    "         '--mode', kill_mode,",
    "         '--timeout-ms', str(timeout_ms),",
    "         '--expect', 'exited'],",
    "        text=True, capture_output=True)",
    "    try:",
    "        reply = json.loads(out.stdout)",
    "    except json.JSONDecodeError:",
    "        raise SystemExit('cu_linux_process_kill_reply_json:' + out.stdout + out.stderr)",
    "    return reply",
    "state = invoke_state()",
    "if int(state.get('pid', -1)) != pid:",
    "    raise SystemExit('cu_linux_process_kill_pid')",
    "if state.get('state') != 'live':",
    "    raise SystemExit(f'cu_linux_process_kill_not_live:{state.get(\"state\")}')",
    "identity = state.get('start_identity')",
    "if not identity:",
    "    raise SystemExit('cu_linux_process_kill_missing_identity')",
    "if state.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_kill_state_not_verified')",
    "if mode == 'graceful-exit':",
    "    kill = invoke_kill(identity, 'graceful')",
    "    if not kill.get('ok'):",
    "        raise SystemExit('cu_linux_process_kill_graceful_reply:' + json.dumps(kill))",
    "    data = kill['data']",
    "    if data.get('performed') is not True or data.get('state') != 'exited':",
    "        raise SystemExit('cu_linux_process_kill_graceful_cu:' + json.dumps(data))",
    "    if data.get('verified') is not True:",
    "        raise SystemExit('cu_linux_process_kill_graceful_verified')",
    "    if data.get('mode') != 'graceful':",
    "        raise SystemExit('cu_linux_process_kill_graceful_mode')",
    "    if data.get('mechanism') != 'native-process-reference':",
    "        raise SystemExit('cu_linux_process_kill_graceful_mechanism')",
    "    actual_exit = proc.wait(timeout=5)",
    "    if proc_alive():",
    "        raise SystemExit('cu_linux_process_kill_graceful_proc_alive')",
    "    print('graceful-exit', pid, actual_exit)",
    "elif mode == 'graceful-refused':",
    "    if not proc_alive():",
    "        raise SystemExit('cu_linux_process_kill_refused_fixture')",
    "    kill = invoke_kill(identity, 'graceful', timeout_ms=1000)",
    "    if kill.get('ok'):",
    "        raise SystemExit('cu_linux_process_kill_refused_ok:' + json.dumps(kill))",
    "    error = kill.get('error', {})",
    "    if error.get('code') != 'process_still_live':",
    "        raise SystemExit('cu_linux_process_kill_refused_code:' + json.dumps(kill))",
    "    if proc_alive():",
    "        print('graceful-refused', pid)",
    "    else:",
    "        raise SystemExit('cu_linux_process_kill_refused_proc_dead')",
    "    force = invoke_kill(identity, 'forceful')",
    "    if not force.get('ok'):",
    "        raise SystemExit('cu_linux_process_kill_force_after_refused:' + json.dumps(force))",
    "    data = force['data']",
    "    if data.get('performed') is not True or data.get('state') != 'exited':",
    "        raise SystemExit('cu_linux_process_kill_force_after_refused_cu:' + json.dumps(data))",
    "    if data.get('verified') is not True or data.get('mode') != 'forceful':",
    "        raise SystemExit('cu_linux_process_kill_force_after_refused_verified')",
    "    actual_exit = proc.wait(timeout=5)",
    "    if proc_alive():",
    "        raise SystemExit('cu_linux_process_kill_force_after_refused_proc_alive')",
    "    print('graceful-then-forceful', pid, actual_exit)",
    "elif mode == 'forceful-exit':",
    "    kill = invoke_kill(identity, 'forceful')",
    "    if not kill.get('ok'):",
    "        raise SystemExit('cu_linux_process_kill_forceful_reply:' + json.dumps(kill))",
    "    data = kill['data']",
    "    if data.get('performed') is not True or data.get('state') != 'exited':",
    "        raise SystemExit('cu_linux_process_kill_forceful_cu:' + json.dumps(data))",
    "    if data.get('verified') is not True or data.get('mode') != 'forceful':",
    "        raise SystemExit('cu_linux_process_kill_forceful_verified')",
    "    actual_exit = proc.wait(timeout=5)",
    "    if proc_alive():",
    "        raise SystemExit('cu_linux_process_kill_forceful_proc_alive')",
    "    print('forceful-exit', pid, actual_exit)",
    "else:",
    "    raise SystemExit('cu_linux_process_kill_mode:' + mode)",
  ].join("\n");
  const argv = ["-c", script, mode, executable];
  const output = rh.command("python3", argv, {
    cwd: run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 60000,
  });
  ensure(output.success === true, "cu_linux_process_kill_readback:" + mode + ":" + output.stderr + output.stdout);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-kill");
let succeeded = 0;
let failure = "";
try {
  print("STEP graceful process-kill on disposable child matches independent waitpid exit read-back");
  verify_kill_readback(context.run_directory, executable, "graceful-exit");

  print("STEP forceful process-kill on disposable child matches independent waitpid exit read-back");
  verify_kill_readback(context.run_directory, executable, "forceful-exit");

  print("STEP graceful refusal on TERM-ignoring child then forceful kill matches independent waitpid");
  verify_kill_readback(context.run_directory, executable, "graceful-refused");

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-kill-readback");
  harness.remove_run(context);
  print("PASS: Linux process-kill matches independent waitpid exit read-back");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
