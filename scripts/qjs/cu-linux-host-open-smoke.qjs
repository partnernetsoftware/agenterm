// Linux public black-box journey for host-open --app via desktop entry and PATH.
// Acceptance is independent /proc/cmdline plus windows/ps/get-text read-back,
// never host-open self-report. Typed host-open usage must reject AT-SPI --name
// and other unexpected arguments; typed get-extents --name usage/miss/host-limit
// paths must hold before the open actuate and windows/ps/get-text read-back
// court. AT-SPI --name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE | --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.host-open.linux", "cu.linux-app-launch"];

const AT_SPI_PROBE_NAME = "Host Open Court Anchor";
const TITLE_PREFIX = "agenterm-host-open-fixture-";
const READY_NAME = "HostOpen Ready";
const READY_TEXT = "host-open-ready";
const DESKTOP_APP = "agenterm-host-open-fixture";
const PATH_APP = "agenterm-host-open-path-exec";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return at(document, "ok") === true; }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(run_directory, bin_dir, executable) {
  const path_parts = [bin_dir];
  const existing = rh.env_or("PATH", "");
  if (existing !== "") { path_parts.push("" + existing); }
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
    AGENTERM_NO_ACTIVATE: "1",
    GTK_MODULES: "gail:atk-bridge",
    PATH: path_parts.join(":"),
    XDG_DATA_HOME: rh.join(run_directory, "share"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_actuate_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "actuate",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_host_open_actuate_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "host-open" || text_at(reply, "command") === "usage",
    "cu_linux_host_open_actuate_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_host_open_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const probe_env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { probe_env[key] = rh.env_or(key, ""); }
  }
  const output = rh.command("python3", ["-c", script], {
    env: probe_env,
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_host_open_usage_limit(run_directory, executable, env) {
  const flat_with_name = invoke_actuate_reply(run_directory, executable, [
    "host-open", "/dev/null", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_host_open_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_host_open_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_host_open_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    text_at(flat_with_name, "error.message").indexOf("--name") >= 0
      || text_at(flat_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_host_open_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const alias_with_name = invoke_actuate_reply(run_directory, executable, [
    "open", "/dev/null", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(alias_with_name),
    "cu_linux_host_open_usage_alias_name_ok:" + JSON.stringify(alias_with_name));
  ensure(
    text_at(alias_with_name, "error.code") === "usage",
    "cu_linux_host_open_usage_alias_name_code:" + JSON.stringify(alias_with_name.error)
  );
  ensure(
    text_at(alias_with_name, "error.message").indexOf("--name") >= 0
      || text_at(alias_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_host_open_usage_alias_name_message:" + JSON.stringify(alias_with_name.error)
  );

  const with_bogus = invoke_actuate_reply(run_directory, executable, [
    "host-open", "/dev/null", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_host_open_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_host_open_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("unexpected") >= 0
      || text_at(with_bogus, "error.message").indexOf("--bogus") >= 0,
    "cu_linux_host_open_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_host_open_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_host_open_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_host_open_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_host_open_extents_missing_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_host_open_extents_missing_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_host_open_extents_missing_name_message:" + JSON.stringify(missing_name.error)
  );
}

function assert_get_extents_name_miss(run_directory, executable, env) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(reply),
    "cu_linux_host_open_extents_miss_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_node_not_found" || code === "bad_handle" || code === "a11y_backend_failed",
    "cu_linux_host_open_extents_miss_code:" + code
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_host_open_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_host_open_extents_unavailable_code:" + code
  );
}

function run_cu(run_directory, executable, grant, command_argv, env, expect_error) {
  const argv = ["--target", "current", "--grant", grant];
  for (const item of command_argv) { argv.push("" + item); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_host_open_empty_stdout");
  const reply = JSON.parse(trimmed);
  if (expect_error !== undefined) {
    ensure(output.success !== true && reply.ok !== true && reply.error.code === expect_error,
      "cu_linux_host_open_wrong_failure:" + JSON.stringify(reply));
    return reply.error;
  }
  ensure(output.success === true && reply.ok === true,
    "cu_linux_host_open_failed:" + JSON.stringify(reply));
  return reply.data;
}

function windows_rows(data) {
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function find_window_by_title_prefix(run_directory, executable, env, prefix) {
  const reply = run_cu(run_directory, executable, "observe", ["windows"], env);
  for (const row of windows_rows(reply)) {
    const title = text_at(row, "title");
    if (title.indexOf(prefix) === 0) { return row; }
  }
  return null;
}

function independent_proc_fixture_evidence(pid, fixture_source) {
  const fixture_basename = rh.file_name(fixture_source);
  const script = [
    "import os, sys",
    "pid = int(sys.argv[1])",
    "fixture = sys.argv[2]",
    "path = f'/proc/{pid}/cmdline'",
    "if not os.path.exists(path):",
    "    print('missing'); sys.exit(0)",
    "with open(path, 'rb') as handle:",
    "    cmdline = handle.read().replace(b'\\x00', b' ').decode('utf-8', 'replace')",
    "if fixture in cmdline and 'python' in cmdline:",
    "    print('ok')",
    "else:",
    "    print('mismatch:' + cmdline)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, fixture_basename], {
    timeout_ms: 10000,
  });
  ensure(output.success === true && output.stdout.trim() === "ok",
    "cu_linux_host_open_proc_cmdline:" + output.stdout + output.stderr);
}

function independent_readback(run_directory, executable, env, fixture_source) {
  const waited = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", TITLE_PREFIX,
  ], env);
  ensure(flag_at(waited, "met"), "cu_linux_host_open_window_wait:" + JSON.stringify(waited));
  const row = find_window_by_title_prefix(run_directory, executable, env, TITLE_PREFIX);
  ensure(row !== null, "cu_linux_host_open_window_missing");
  const pid = parseInt(text_at(row, "process_id"), 10);
  const handle = text_at(row, "handle");
  ensure(pid > 0, "cu_linux_host_open_window_pid");
  ensure(handle !== "", "cu_linux_host_open_window_handle");
  independent_proc_fixture_evidence(pid, fixture_source);

  const ps = run_cu(run_directory, executable, "observe", ["ps", "--pid", "" + pid], env);
  const processes = at(ps, "processes");
  ensure(processes !== undefined && processes.length === 1,
    "cu_linux_host_open_ps_readback:" + JSON.stringify(ps));
  ensure(parseInt(text_at(processes[0], "pid"), 10) === pid,
    "cu_linux_host_open_ps_pid_mismatch:" + JSON.stringify(processes[0]));

  const windows_pid = run_cu(run_directory, executable, "observe", ["windows", "--pid", "" + pid], env);
  let bound = false;
  for (const bound_row of windows_rows(windows_pid)) {
    if (text_at(bound_row, "handle") === handle && text_at(bound_row, "title").indexOf(TITLE_PREFIX) === 0) {
      bound = true;
      break;
    }
  }
  ensure(bound, "cu_linux_host_open_windows_pid_readback");

  const text = run_cu(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", READY_NAME,
  ], env);
  ensure(text_at(text, "text") === READY_TEXT,
    "cu_linux_host_open_get_text:" + JSON.stringify(text));
  return pid;
}

function stop_launched(pid) {
  if (!(pid > 0)) { return; }
  rh.command("kill", ["-TERM", "" + pid], { timeout_ms: 5000 });
  harness.sleep_ms(250);
}

function verify_teardown(run_directory, executable, env, pid) {
  let exited = 0;
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    if (harness.process_present(pid) === 0) { exited = 1; break; }
    harness.sleep_ms(50);
  }
  ensure(exited !== 0, "cu_linux_host_open_process_lingers:" + pid);
  const filtered = run_cu(run_directory, executable, "observe", ["windows", "--pid", "" + pid], env);
  const matched = at(filtered, "matched");
  const rows = windows_rows(filtered);
  ensure(
    (matched !== undefined && parseInt("" + matched, 10) === 0) || rows.length === 0,
    "cu_linux_host_open_windows_linger:" + JSON.stringify(filtered)
  );
}

function stop_and_verify(run_directory, executable, env, pid) {
  stop_launched(pid);
  verify_teardown(run_directory, executable, env, pid);
}

function write_wrapper(path, fixture_source) {
  rh.write_text(path,
    "#!/bin/sh\n"
    + "export GTK_MODULES=gail:atk-bridge\n"
    + "exec python3 '" + fixture_source + "' \"$@\"\n");
  const chmod = rh.command("/bin/chmod", ["0755", path], { timeout_ms: 5000 });
  ensure(chmod.success === true, "cu_linux_host_open_wrapper_chmod:" + path + ":" + chmod.stderr);
}

const script_argv = rh.args();
if (script_argv.length === 1 && script_argv[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(script_argv.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(script_argv[0]);
const executable = rh.absolute(script_argv[1]);
ensure(direct_file(executable), "cu_linux_host_open_executable_missing");

const fixture_source = rh.join(repo, "examples/python/agenterm_host_open_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_host_open_fixture_missing:" + fixture_source);

const context = harness.new_context(repo, "cu-linux-host-open");
const run_directory = context.run_directory;
const bin_dir = rh.join(run_directory, "bin");
const apps_dir = rh.join(run_directory, "share/applications");
rh.create_dir_all(bin_dir);
rh.create_dir_all(apps_dir);

const fixture_wrapper = rh.join(bin_dir, DESKTOP_APP);
const path_wrapper = rh.join(bin_dir, PATH_APP);
write_wrapper(fixture_wrapper, fixture_source);
write_wrapper(path_wrapper, fixture_source);
const desktop_path = rh.join(apps_dir, DESKTOP_APP + ".desktop");
rh.write_text(desktop_path,
  "[Desktop Entry]\n"
  + "Type=Application\n"
  + "Name=Agenterm Host Open Fixture\n"
  + "Exec=" + fixture_wrapper + " %U\n"
  + "Terminal=false\n"
  + "Categories=Utility;\n");

const env = cu_env(run_directory, bin_dir, executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
let launched_pid = 0;

try {
  print("STEP host-open typed-fails usage when AT-SPI --name or other unexpected arguments are present");
  assert_host_open_usage_limit(run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero or --name is missing before open actuate/read-back court");
    assert_get_extents_usage_limit(run_directory, executable, env);
    print("STEP get-extents typed-fail a11y_node_not_found when the named anchor is absent before open actuate/read-back court");
    assert_get_extents_name_miss(run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
  }

  print("STEP host-open --app desktop entry dispatches the fixture without shell involvement");
  const desktop_open = run_cu(run_directory, executable, "actuate", [
    "host-open", "/dev/null", "--app", DESKTOP_APP,
  ], env);
  ensure(
    flag_at(desktop_open, "performed")
      && flag_at(desktop_open, "accepted")
      && flag_at(desktop_open, "verified") === false
      && text_at(desktop_open, "verification") === "dispatcher-accepted-only",
    "cu_linux_host_open_desktop_receipt:" + JSON.stringify(desktop_open)
  );
  ensure(
    text_at(desktop_open, "provider") === "linux-gio-launch"
      || text_at(desktop_open, "provider") === "linux-gtk-launch"
      || text_at(desktop_open, "provider") === "linux-app-exec",
    "cu_linux_host_open_desktop_provider:" + JSON.stringify(desktop_open)
  );
  launched_pid = independent_readback(run_directory, executable, env, fixture_source);
  stop_and_verify(run_directory, executable, env, launched_pid);
  launched_pid = 0;
  harness.sleep_ms(500);

  print("STEP host-open --app PATH executable dispatches the fixture without a desktop entry");
  const path_open = run_cu(run_directory, executable, "actuate", [
    "open", "/dev/null", "--app", PATH_APP,
  ], env);
  ensure(
    flag_at(path_open, "performed")
      && flag_at(path_open, "accepted")
      && text_at(path_open, "provider") === "linux-app-exec",
    "cu_linux_host_open_path_receipt:" + JSON.stringify(path_open)
  );
  launched_pid = independent_readback(run_directory, executable, env, fixture_source);
  stop_and_verify(run_directory, executable, env, launched_pid);
  launched_pid = 0;
  harness.sleep_ms(500);

  print("STEP app launch --path starts the disposable GTK fixture without claiming a pid");
  const launch = run_cu(run_directory, executable, "observe,actuate", [
    "app", "launch", "--path", desktop_path,
  ], env);
  ensure(
    flag_at(launch, "requested")
      && launch.pid === null
      && text_at(launch, "action") === "launch"
      && text_at(launch, "path") === desktop_path,
    "cu_linux_app_launch_reply:" + JSON.stringify(launch)
  );
  launched_pid = independent_readback(run_directory, executable, env, fixture_source);
  stop_and_verify(run_directory, executable, env, launched_pid);
  launched_pid = 0;

  harness.emit_evidence(context, declared_evidence, "cu.host-open.linux");
  harness.emit_evidence(context, declared_evidence, "cu.linux-app-launch");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

stop_launched(launched_pid);
if (succeeded !== 0 && failure === "") {
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux host-open --app and app launch --path with independent /proc/cmdline + windows/ps/get-text read-back and typed host-open/get-extents usage/miss honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux host-open --app and app launch --path with independent /proc/cmdline + windows/ps/get-text read-back and typed host-open/get-extents host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
return;
