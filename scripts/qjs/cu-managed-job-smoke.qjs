// Platform-neutral public black-box journey for durable managed jobs.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
//
// Every operation goes through the public agenterm-cu CLI. The session lease,
// child command, environment override and stdin bytes stay in memory only:
// failure text names the verb and typed code, never the reply or arguments.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.managed-job-lifecycle",
  "cu.managed-job-resources",
  "cu.managed-job-limits",
  "cu.managed-job-adopt",
  "cu.managed-job-state-signal",
  "cu.managed-job-priority",
  "cu.managed-job-policy",
  "cu.managed-job-prune",
  "cu.audit-retention",
  "cu.target-lock-lifecycle",
  "cu.managed-job-spawn-expiry",
  "cu.managed-job-adopt-detach-liveness",
  "cu.managed-job-terminal-trigger",
  "cu.managed-job-expiry-idempotency",
  "cu.managed-job-detach-fixture-cleanup"
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}


function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function invoke_cu(run_directory, executable, arguments, expected_command) {
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: {
      AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
      AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
      AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(run_directory, "cu-requests.json"),
      AGENTERM_CU_MANAGED_JOB_PATH: rh.join(run_directory, "cu-managed-jobs.json"),
      HOME: run_directory,
      XDG_DATA_HOME: rh.join(run_directory, "data"),
      XDG_CONFIG_HOME: rh.join(run_directory, "config")
    },
    timeout_ms: 30000
  });
  const stdout = output.stdout.trim();
  ensure(stdout !== "", "cu_managed_job_empty_reply:" + expected_command);
  let reply = null;
  try { reply = JSON.parse(stdout); }
  catch (error) { throw "cu_managed_job_invalid_reply:" + expected_command; }
  ensure(
    (output.success === true) === (reply.ok === true),
    "cu_managed_job_process_reply_disagree:" + expected_command
  );
  if (reply.ok !== true) {
    throw "cu_managed_job_cli_failed:" + expected_command + ":" + text_of(reply.error.code);
  }
  ensure(reply.command === expected_command, "cu_managed_job_wrong_reply:" + expected_command);
  return reply.data;
}

function invoke_cu_failure(run_directory, executable, arguments, expected_command, expected_code) {
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: {
      AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
      AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
      AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(run_directory, "cu-requests.json"),
      AGENTERM_CU_MANAGED_JOB_PATH: rh.join(run_directory, "cu-managed-jobs.json"),
      HOME: run_directory,
      XDG_DATA_HOME: rh.join(run_directory, "data"),
      XDG_CONFIG_HOME: rh.join(run_directory, "config")
    },
    timeout_ms: 30000
  });
  let reply = null;
  try { reply = JSON.parse(output.stdout.trim()); }
  catch (error) { throw "cu_managed_job_invalid_failure_reply:" + expected_command; }
  ensure(output.success !== true && reply.ok === false, "cu_managed_job_expected_failure:" + expected_command);
  ensure(reply.command === expected_command, "cu_managed_job_wrong_failure_reply:" + expected_command);
  ensure(text_of(reply.error.code) === expected_code, "cu_managed_job_wrong_failure_code:" + expected_command);
  return reply.error;
}

/// A closed-spelling usage rejection: the CLI answers with command/code
/// `usage`, so the typed-code helper does not apply. Returns the message.
function invoke_cu_usage_failure(run_directory, executable, arguments) {
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: {
      AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
      AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
      AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(run_directory, "cu-requests.json"),
      AGENTERM_CU_MANAGED_JOB_PATH: rh.join(run_directory, "cu-managed-jobs.json"),
      HOME: run_directory,
      XDG_DATA_HOME: rh.join(run_directory, "data"),
      XDG_CONFIG_HOME: rh.join(run_directory, "config")
    },
    timeout_ms: 30000
  });
  let reply = null;
  try { reply = JSON.parse(output.stdout.trim()); }
  catch (error) { throw "cu_managed_job_invalid_usage_reply"; }
  ensure(output.success !== true && reply.ok === false, "cu_managed_job_expected_usage_failure");
  ensure(reply.command === "usage", "cu_managed_job_usage_command:" + text_of(reply.command));
  ensure(text_of(reply.error.code) === "usage", "cu_managed_job_usage_code");
  return text_of(reply.error.message);
}

/// End a session that is EXPECTED to refuse a clean sweep, and return the typed
/// code of the first job it could not prove terminal.
function invoke_cu_uncertain_session_end(run_directory, executable, session_id, session_lease) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "actuate",
    "session-end", session_id, "--lease", session_lease, "--confirm"
  ], {
    cwd: run_directory,
    env: {
      AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
      AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
      AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(run_directory, "cu-requests.json"),
      AGENTERM_CU_MANAGED_JOB_PATH: rh.join(run_directory, "cu-managed-jobs.json"),
      HOME: run_directory,
      XDG_DATA_HOME: rh.join(run_directory, "data"),
      XDG_CONFIG_HOME: rh.join(run_directory, "config")
    },
    timeout_ms: 30000
  });
  let reply = null;
  try { reply = JSON.parse(output.stdout.trim()); }
  catch (error) { throw "cu_managed_job_invalid_uncertain_end"; }
  ensure(output.success !== true && reply.ok === false, "cu_managed_job_uncertain_end_expected");
  ensure(
    text_of(reply.error.code) === "runtime_session_cleanup_uncertain",
    "cu_managed_job_uncertain_end_code:" + text_of(reply.error.code)
  );
  const failed = reply.error.detail.jobs.failed;
  ensure(failed.length >= 1, "cu_managed_job_uncertain_end_failed_rows");
  return text_of(failed[0].code);
}

function mutation_prefix(request_id, session_id, session_lease) {
  return [
    "--target", "current", "--grant", "actuate",
    "--request-id", request_id,
    "--session", session_id,
    "--session-lease", session_lease
  ];
}

function append_all(target, values) {
  for (const value of values) { target.push(value); }
  return target;
}

function find_job(inventory, job_id) {
  for (const row of inventory.jobs) {
    if (row.job_id === job_id) { return row; }
  }
  return null;
}

function has_resource_member(members, pid, require_counters) {
  for (const member of members) {
    if (member.pid === pid) {
      if (!require_counters) { return true; }
      return text_of(member.start_identity) !== ""
        && text_of(member.rss_bytes) !== ""
        && text_of(member.cpu_ms) !== ""
        && text_of(member.cpu_time_ns) !== "";
    }
  }
  return false;
}

function valid_resource_samples(samples) {
  for (const sample of samples) {
    if (sample.membership_complete !== true
      || sample.member_count < 1
      || text_of(sample.membership_sha256).length !== 64
      || text_of(sample.rss_bytes) === ""
      || text_of(sample.cpu_ms) === ""
      || text_of(sample.cpu_time_ns) === "") {
      return false;
    }
  }
  return true;
}

function priority_members_are(members, nice) {
  if (members.length < 1) { return false; }
  for (const member of members) {
    if (member.nice !== nice || text_of(member.start_identity) === "") { return false; }
  }
  return true;
}

function members_have_state(members, state) {
  if (members.length < 1) { return false; }
  for (const member of members) {
    if (member.verified !== true || member.state !== state || text_of(member.start_identity) === "") {
      return false;
    }
  }
  return true;
}

function wait_owner_absent(run_directory, executable, job) {
  for (let poll = 0; poll < 100; poll = poll + 1) {
    const status = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe", "job-status", job.job_id
    ], "job-status");
    if (status.io_available === false) { return true; }
    harness.sleep_ms(100);
  }
  return false;
}

/// The closed set a detach handoff may report, so "non-empty" can never stand in
/// for a truthful liveness.
function is_detach_liveness(value) {
  const text = text_of(value);
  return text === "live" || text === "absent" || text === "unknown";
}

function job_status_of(run_directory, executable, job_id) {
  return invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe", "job-status", job_id
  ], "job-status");
}

/// Identity-bound fixture teardown through the PUBLIC verbs only.
///
/// `process-state` re-reads the exact start identity (a reused pid is refused,
/// never signalled), then the tree-capable identity-bound signal terminates the
/// root and its descendants, and absence is proved by re-reading the state.
/// Returns "killed" | "already_absent" | "pid_reused" | "unobservable".
function kill_bound_fixture(run_directory, executable, pid, start_identity) {
  let present = fixture_presence(run_directory, executable, pid, start_identity);
  if (present === "absent") { return "already_absent"; }
  if (present === "reused") { return "pid_reused"; }
  if (present !== "live") { return "unobservable"; }
  try {
    invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "actuate",
      "process-signal", "" + pid, "KILL",
      "--start-identity", start_identity,
      "--tree", "--max", "64", "--force", "--timeout-ms", "5000"
    ], "process-signal");
  } catch (error) {
    return "signal_failed:" + ("" + error);
  }
  // Bounded absence proof: the root and every descendant must be gone.
  for (let poll = 0; poll < 50; poll = poll + 1) {
    const after = fixture_presence(run_directory, executable, pid, start_identity);
    if (after === "absent") { return "killed"; }
    if (after === "reused") { return "pid_reused"; }
    harness.sleep_ms(100);
  }
  return "unobservable";
}

/// "live" | "absent" | "reused" | "unobservable" for one exact identity.
///
/// A different start identity at the same pid is a REFUSAL, never a target: the
/// court must not signal a process it did not observe.
function fixture_presence(run_directory, executable, pid, start_identity) {
  try {
    const state = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe", "process-state", "--pid", "" + pid
    ], "process-state");
    if (state.state !== "live") { return "absent"; }
    return text_of(state.start_identity) === start_identity ? "live" : "reused";
  } catch (error) {
    const message = "" + error;
    // A typed not-found is absence; anything else is unknown, not absence.
    return message.indexOf("process_not_found") >= 0 ? "absent" : "unobservable";
  }
}

/// The four state artifacts a refused spawn must not touch, frozen as exact
/// bytes, plus the run directory listing (lock files included). Compared before
/// and after, this proves the preflight ran BEFORE request idempotency, the
/// runtime session record, the audit row and the managed-job store.
function state_census(run_directory) {
  const artifacts = [
    "cu-runtime.json",
    "cu-requests.json",
    "cu-audit.jsonl",
    "cu-managed-jobs.json"
  ];
  const parts = [];
  for (const name of artifacts) {
    const path = rh.join(run_directory, name);
    parts.push(name + "=" + (rh.exists(path) ? text_of(rh.read_text(path)) : "<absent>"));
  }
  const names = [];
  for (const entry of rh.read_dir(run_directory)) { names.push(entry.name); }
  names.sort();
  return parts.join("\u0000") + "\u0000|" + names.join(",");
}

/// The live managed-job owner census: every recorded owner pid, plus the count
/// of records the store still holds. Independent of the reply under test.
function owner_census(run_directory, executable) {
  const inventory = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe", "job-list"
  ], "job-list");
  const owners = [];
  for (const row of inventory.jobs) { owners.push(text_of(row.owner_pid)); }
  owners.sort();
  return owners.join(",") + "|" + inventory.matched;
}

function stop_owned_job(run_directory, executable, session_id, session_lease, request_id, job) {
  const args = mutation_prefix(request_id, session_id, session_lease);
  append_all(args, [
    "job-stop", job.job_id, "" + job.generation,
    "--grace-ms", "100", "--expect-stopped"
  ]);
  return invoke_cu(run_directory, executable, args, "job-stop");
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.is_direct_file(executable) && harness.host_is_windows()) {
  executable = executable + ".exe";
}
ensure(rh.is_direct_file(executable), "cu_managed_job_executable_missing");

const context = harness.new_context(repo, "cu-managed-job");
const run_directory = context.run_directory;
const audit_path = rh.join(run_directory, "cu-audit.jsonl");
const windows = harness.host_is_windows();
const macos = !windows && rh.exists("/System/Library/CoreServices/SystemVersion.plist");
const request_root = "managed-job-" + context.run_id;
let session_id = "";
let session_lease = "";
let first_job = null;
let detach_live_child = null;
let detach_live_identity = "";
let detach_live_job = null;
let detach_absent_child = null;
let detach_absent_identity = "";
let detach_absent_job = null;
let lost_session_id = "";
let lost_session_lease = "";
let lost_end_attempted = false;
let lost_session_cleanly_ended = false;
let lost_fixture = null;
let lost_fixture_identity = "";
let lost_fixture_clean = false;
let second_job = null;
let session_bound_job = null;
let adopted_job = null;
let adopted_child = null;
let adopted_stop_job = null;
let adopted_stop_child = null;
const owned_children = [];
let first_owner_absent = false;
let second_owner_absent = false;
let session_bound_owner_absent = false;
let session_ended = false;
let succeeded = 0;
let failure = "";

try {
  print("STEP create one bounded runtime session without retaining its private lease in evidence or command logs");
  const session = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "actuate",
    "session-start", "--label", "managed-job-smoke", "--ttl-seconds", "120"
  ], "session-start");
  session_id = text_of(session.session_id);
  session_lease = text_of(session.lease);
  ensure(
    session_id !== "" && session_lease !== "" && session.label === "managed-job-smoke",
    "cu_managed_job_session_contract"
  );

  const interactive_command = windows
    ? [
        "cmd.exe", "/D", "/Q", "/V:ON", "/C",
        "set /p SMOKE_LINE=& echo OUT:!SMOKE_LINE!& echo ERR:!SMOKE_LINE! 1>&2& exit /b 7"
      ]
    : [
        "/bin/sh", "-c",
        "IFS= read -r line; printf 'OUT:%s\\n' \"$line\"; printf 'ERR:%s\\n' \"$line\" >&2; exit 7"
      ];
  const spawn_request = request_root + "-spawn";
  const spawn_args = mutation_prefix(spawn_request, session_id, session_lease);
  append_all(spawn_args, [
    "job-spawn", "--cwd", run_directory,
    "--env", "AGENTERM_JOB_SMOKE_PRIVATE=not-for-logs",
    "--ttl-seconds", "10",
    "--cpu-seconds", "60",
    "--max-processes", "32"
  ]);
  if (windows || !macos) {
    append_all(spawn_args, ["--memory-bytes", "536870912"]);
  }
  if (!windows) {
    append_all(spawn_args, [
      "--file-size-bytes", "67108864",
      "--max-open-files", "256"
    ]);
  }
  spawn_args.push("--");
  append_all(spawn_args, interactive_command);

  print("STEP spawn once and replay the exact request identity without creating a second job");
  const spawned = invoke_cu(run_directory, executable, spawn_args, "job-spawn");
  first_job = { job_id: text_of(spawned.job_id), generation: spawned.generation };
  ensure(first_job.job_id !== "" && first_job.generation > 0, "cu_managed_job_spawn_identity");
  const replayed = invoke_cu(run_directory, executable, spawn_args, "job-spawn");
  ensure(
    replayed.job_id === first_job.job_id && replayed.generation === first_job.generation,
    "cu_managed_job_spawn_replay_identity"
  );

  print("STEP list and inspect the running job while launch command and environment remain absent");
  const inventory = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe", "job-list", "--max", "64"
  ], "job-list");
  const listed = find_job(inventory, first_job.job_id);
  ensure(
    listed !== null && listed.generation === first_job.generation
      && listed.session_id === session_id && listed.state === "running",
    "cu_managed_job_list_contract"
  );
  const status = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe", "job-status", first_job.job_id
  ], "job-status");
  const public_observation = JSON.stringify({inventory: inventory, status: status});
  ensure(
    status.generation === first_job.generation && status.state === "running"
      && status.io_available === true && status.live.state.kind === "running"
      && public_observation.indexOf("AGENTERM_JOB_SMOKE_PRIVATE") < 0
      && public_observation.indexOf("not-for-logs") < 0
      && public_observation.indexOf("SMOKE_LINE") < 0
      && public_observation.indexOf("IFS= read") < 0,
    "cu_managed_job_status_privacy_contract"
  );

  print("STEP sample the owned containment group once and with one bounded watch");
  const resources = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "job-resources", first_job.job_id, "" + first_job.generation
  ], "job-resources");
  ensure(
    resources.scope === "containment-group"
      && (resources.provider === "windows-job-object"
        || resources.provider === "posix-process-group")
      && resources.membership_complete === true
      && resources.tree_complete === resources.breakaway_prevented
      && resources.coherence === "stable-membership-sweep"
      && resources.mode === "point" && resources.verified === true
      && resources.member_count === resources.members.length
      && resources.member_count >= 1
      && text_of(resources.membership_sha256).length === 64
      && text_of(resources.rss_bytes) !== ""
      && text_of(resources.cpu_ms) !== ""
      && text_of(resources.cpu_time_ns) !== ""
      && has_resource_member(resources.members, status.process_pid, true),
    "cu_managed_job_resources_point_contract"
  );
  const watched_resources = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "job", "resources", first_job.job_id, "" + first_job.generation,
    "--watch-ms", "20", "--interval-ms", "5", "--max-samples", "2"
  ], "job-resources");
  ensure(
    watched_resources.scope === "containment-group"
      && watched_resources.membership_complete === true
      && watched_resources.tree_complete === watched_resources.breakaway_prevented
      && watched_resources.coherence === "stable-membership-sweep"
      && watched_resources.mode === "bounded-series" && watched_resources.verified === true
      && watched_resources.duration_ms === 20 && watched_resources.interval_ms === 5
      && watched_resources.max_samples === 2 && watched_resources.completed === false
      && watched_resources.truncated === true && watched_resources.ended_reason === "max-samples"
      && watched_resources.emitted === 2
      && watched_resources.samples.length === watched_resources.emitted
      && watched_resources.members_per_sample === false
      && watched_resources.member_rows === 0
      && watched_resources.samples[0].members === undefined
      && watched_resources.member_count === watched_resources.members.length
      && watched_resources.member_count >= 1
      && has_resource_member(watched_resources.members, status.process_pid, false)
      && valid_resource_samples(watched_resources.samples),
    "cu_managed_job_resources_watch_contract"
  );

  const member_samples = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "job-resources", first_job.job_id, "" + first_job.generation,
    "--watch-ms", "20", "--interval-ms", "5", "--max-samples", "2",
    "--members-per-sample"
  ], "job-resources");
  let counted_member_rows = 0;
  for (let i = 0; i < member_samples.samples.length; i = i + 1) {
    const sample = member_samples.samples[i];
    ensure(Array.isArray(sample.members)
        && sample.members.length === sample.member_count
        && sample.membership_complete === true,
      "cu_managed_job_resource_sample_members:" + i);
    counted_member_rows = counted_member_rows + sample.members.length;
  }
  ensure(member_samples.members_per_sample === true
      && counted_member_rows === member_samples.member_rows
      && member_samples.member_rows <= member_samples.max_member_rows
      && member_samples.max_member_rows === 131072,
    "cu_managed_job_resource_member_row_bound");
  const completed_resources = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "job-resources", first_job.job_id, "" + first_job.generation,
    "--watch-ms", "5", "--interval-ms", "60000", "--max-samples", "1000"
  ], "job-resources");
  ensure(
    completed_resources.duration_ms === 5 && completed_resources.interval_ms === 60000
      && completed_resources.max_samples === 1000 && completed_resources.completed === true
      && completed_resources.truncated === false
      && completed_resources.ended_reason === "duration"
      && completed_resources.emitted >= 1,
    "cu_managed_job_resources_duration_contract"
  );

  print("STEP renew the resident lease, then atomically write five bytes and close stdin");
  const renew_args = mutation_prefix(request_root + "-renew", session_id, session_lease);
  append_all(renew_args, [
    "job-renew", first_job.job_id, "" + first_job.generation, "--ttl-seconds", "5"
  ]);
  const renewed = invoke_cu(run_directory, executable, renew_args, "job-renew");
  ensure(renewed.renewed_ttl_ms === 5000, "cu_managed_job_renew_contract");
  const write_args = mutation_prefix(request_root + "-write", session_id, session_lease);
  append_all(write_args, [
    "job-write", first_job.job_id, "" + first_job.generation,
    "--data-base64", "cGluZwo=", "--close-stdin"
  ]);
  const wrote = invoke_cu(run_directory, executable, write_args, "job-write");
  ensure(
    wrote.accepted_bytes === 5 && wrote.delivery === "complete" && wrote.stdin_closed === true,
    "cu_managed_job_write_contract"
  );

  print("STEP read stdout and stderr through two independently advancing loss-aware cursors");
  const first_events = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "job-events", first_job.job_id, "" + first_job.generation,
    "--stdout-cursor", "0", "--stderr-cursor", "0",
    "--timeout-ms", "10000", "--max-bytes", "4096"
  ], "job-events");
  const stdout_cursor = text_of(first_events.stdout.next_cursor);
  const stderr_cursor = text_of(first_events.stderr.next_cursor);
  ensure(
    first_events.stdout.bytes > 0 && first_events.stderr.bytes > 0
      && stdout_cursor !== "0" && stderr_cursor !== "0",
    "cu_managed_job_events_initial_contract"
  );
  const stderr_output = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "job-output", first_job.job_id, "" + first_job.generation,
    "--stream", "stderr", "--cursor", "0", "--max-bytes", "4096"
  ], "job-output");
  ensure(
    stderr_output.stream === "stderr"
      && stderr_output.output.data_base64 === first_events.stderr.data_base64
      && stderr_output.output.bytes === first_events.stderr.bytes
      && stderr_output.output.next_cursor === stderr_cursor,
    "cu_managed_job_output_single_stream_contract"
  );
  const stderr_replay = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "job-events", first_job.job_id, "" + first_job.generation,
    "--stdout-cursor", stdout_cursor, "--stderr-cursor", "0", "--max-bytes", "4096"
  ], "job-events");
  ensure(
    stderr_replay.stdout.bytes === 0 && stderr_replay.stdout.next_cursor === stdout_cursor
      && stderr_replay.stderr.bytes === first_events.stderr.bytes
      && stderr_replay.stderr.next_cursor === stderr_cursor,
    "cu_managed_job_events_stderr_cursor_contract"
  );
  const stdout_replay = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "job-events", first_job.job_id, "" + first_job.generation,
    "--stdout-cursor", "0", "--stderr-cursor", stderr_cursor, "--max-bytes", "4096"
  ], "job-events");
  ensure(
    stdout_replay.stdout.bytes === first_events.stdout.bytes
      && stdout_replay.stdout.next_cursor === stdout_cursor
      && stdout_replay.stderr.bytes === 0
      && stdout_replay.stderr.next_cursor === stderr_cursor,
    "cu_managed_job_events_stdout_cursor_contract"
  );

  print("STEP wait for the exact exit code and for the renewed resident owner to release itself");
  const waited = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "job-wait", first_job.job_id, "" + first_job.generation,
    "--timeout-ms", "10000", "--expect-exit", "7"
  ], "job-wait");
  ensure(
    waited.completed === true && waited.status.state.kind === "exited"
      && waited.status.state.exit_code === 7,
    "cu_managed_job_wait_contract"
  );
  first_owner_absent = wait_owner_absent(run_directory, executable, first_job);
  ensure(first_owner_absent, "cu_managed_job_first_owner_cleanup");

  print("STEP stop a second long-running job by exact identity and observe owned owner cleanup");
  const long_command = windows
    ? ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", "Start-Sleep -Seconds 30"]
    : ["/bin/sh", "-c", "trap 'printf signal-usr1\\n' USR1; printf 'signal-ready\\n'; while :; do :; done"];
  const second_spawn_args = mutation_prefix(request_root + "-spawn-stop", session_id, session_lease);
  // Full-system x86 emulation can spend several seconds in each independent
  // priority/policy/state assertion. Keep this owned fixture alive for the
  // complete court; explicit job-stop and harness cleanup still prove reaping.
  append_all(second_spawn_args, ["job-spawn", "--ttl-seconds", "60", "--"]);
  append_all(second_spawn_args, long_command);
  const second_spawned = invoke_cu(run_directory, executable, second_spawn_args, "job-spawn");
  second_job = { job_id: text_of(second_spawned.job_id), generation: second_spawned.generation };
  ensure(second_job.job_id !== "" && second_job.generation > 0, "cu_managed_job_second_identity");

  print("STEP set one owned process group's priority with write-ahead identity and exact readback");
  const priority_args = mutation_prefix(request_root + "-priority", session_id, session_lease);
  append_all(priority_args, [
    "job-priority", second_job.job_id, "" + second_job.generation, "19"
  ]);
  if (windows) {
    invoke_cu_failure(
      run_directory, executable, priority_args, "job-priority", "managed_job_priority_unsupported"
    );
  } else {
    const priority = invoke_cu(run_directory, executable, priority_args, "job-priority");
    ensure(
      priority.job_id === second_job.job_id
        && priority.generation === second_job.generation
        && priority.requested_nice === 19
        && priority.performed === true && priority.verified === true
        && text_of(priority.membership_sha256).length === 64
        && priority.before.length === priority.after.length
        && priority_members_are(priority.after, 19),
      "cu_managed_job_priority_contract"
    );
    const priority_replay = invoke_cu(
      run_directory, executable, priority_args, "job-priority"
    );
    ensure(
      priority_replay.effect === "not_repeated" && priority_replay.idempotent === true,
      "cu_managed_job_priority_replay_contract"
    );
  }

  print("STEP install resident resource enforcement and observe its exact postcondition");
  const policy_set_args = mutation_prefix(request_root + "-policy-set", session_id, session_lease);
  append_all(policy_set_args, [
    "job-policy", second_job.job_id, "" + second_job.generation, "set",
    "--max-rss-bytes", "1048576", "--interval-ms", "250", "--samples", "1",
    "--action", "stop"
  ]);
  if (windows) {
    invoke_cu_failure(
      run_directory, executable, policy_set_args, "job-policy",
      "managed_job_policy_stop_unsupported"
    );
    const policy_absent = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe",
      "job-policy", second_job.job_id, "" + second_job.generation, "status"
    ], "job-policy");
    ensure(
      policy_absent.policy === null && policy_absent.status.state === "inactive",
      "cu_managed_job_policy_windows_refusal_contract"
    );
  } else {
    const installed_policy = invoke_cu(
      run_directory, executable, policy_set_args, "job-policy"
    );
    ensure(
      installed_policy.changed === true && installed_policy.resident_enforcement === true
        && installed_policy.status.state === "armed",
      "cu_managed_job_policy_install_contract"
    );
    let policy_status = null;
    for (let policy_attempt = 0; policy_attempt < 20; policy_attempt += 1) {
      policy_status = invoke_cu(run_directory, executable, [
        "--target", "current", "--grant", "observe",
        "job-policy", second_job.job_id, "" + second_job.generation, "status"
      ], "job-policy");
      if (policy_status.status.state === "enforced") { break; }
      harness.sleep_ms(50);
    }
    ensure(
      policy_status !== null && policy_status.status.state === "enforced"
        && policy_status.status.consecutive_violations === 1
        && policy_status.status.violations[0] === "max_rss_bytes"
        && text_of(policy_status.status.last_metrics.rss_bytes) !== "",
      "cu_managed_job_policy_enforcement_contract"
    );
    const policy_replay = invoke_cu(
      run_directory, executable, policy_set_args, "job-policy"
    );
    ensure(
      policy_replay.effect === "not_repeated" && policy_replay.idempotent === true,
      "cu_managed_job_policy_request_replay_contract"
    );
    const policy_clear_args = mutation_prefix(
      request_root + "-policy-clear", session_id, session_lease
    );
    append_all(policy_clear_args, [
      "job-policy", second_job.job_id, "" + second_job.generation, "clear"
    ]);
    const cleared_policy = invoke_cu(
      run_directory, executable, policy_clear_args, "job-policy"
    );
    ensure(
      cleared_policy.changed === true && cleared_policy.policy === null
        && cleared_policy.status.state === "inactive",
      "cu_managed_job_policy_clear_contract"
    );
    const policy_resume_args = mutation_prefix(
      request_root + "-policy-resume", session_id, session_lease
    );
    append_all(policy_resume_args, [
      "job-set-state", second_job.job_id, "" + second_job.generation,
      "running", "--timeout-ms", "5000"
    ]);
    const policy_resumed = invoke_cu(
      run_directory, executable, policy_resume_args, "job-set-state"
    );
    ensure(
      policy_resumed.verified === true && members_have_state(policy_resumed.members, "running"),
      "cu_managed_job_policy_clear_does_not_resume_contract"
    );
  }

  print("STEP control the complete owned job tree through exact, crash-recoverable state and signal verbs");
  const state_args = mutation_prefix(request_root + "-state-stop", session_id, session_lease);
  append_all(state_args, [
    "job-set-state", second_job.job_id, "" + second_job.generation,
    "stopped", "--timeout-ms", "5000"
  ]);
  if (windows) {
    invoke_cu_failure(
      run_directory, executable, state_args, "job-set-state", "process_tree_signal_unsupported"
    );
  } else {
    const state_stopped = invoke_cu(run_directory, executable, state_args, "job-set-state");
    ensure(
      state_stopped.job_id === second_job.job_id
        && state_stopped.generation === second_job.generation
        && state_stopped.requested_state === "stopped"
        && state_stopped.verified === true
        && members_have_state(state_stopped.members, "stopped"),
      "cu_managed_job_state_stop_contract"
    );
    const signal_args = mutation_prefix(request_root + "-signal-cont", session_id, session_lease);
    append_all(signal_args, [
      "job-signal", second_job.job_id, "" + second_job.generation,
      "CONT", "--timeout-ms", "5000"
    ]);
    const continued = invoke_cu(run_directory, executable, signal_args, "job-signal");
    ensure(
      continued.job_id === second_job.job_id
        && continued.generation === second_job.generation
        && continued.signal === "SIGCONT" && continued.verified === true
        && members_have_state(continued.members, "running"),
      "cu_managed_job_signal_continue_contract"
    );

    print("STEP deliver one non-idempotent signal exactly once through durable request replay");
    const before_signal = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe",
      "job-output", second_job.job_id, "" + second_job.generation,
      "--stream", "stdout", "--cursor", "0", "--max-bytes", "4096"
    ], "job-output");
    const signal_usr1_args = mutation_prefix(
      request_root + "-signal-usr1", session_id, session_lease
    );
    append_all(signal_usr1_args, [
      "job-signal", second_job.job_id, "" + second_job.generation,
      "USR1", "--timeout-ms", "5000"
    ]);
    const user_signal = invoke_cu(
      run_directory, executable, signal_usr1_args, "job-signal"
    );
    ensure(
      user_signal.job_id === second_job.job_id
        && user_signal.generation === second_job.generation
        && user_signal.signal === "SIGUSR1"
        && user_signal.delivered === true && user_signal.verified === null,
      "cu_managed_job_user_signal_contract"
    );
    const signal_output = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe",
      "job-events", second_job.job_id, "" + second_job.generation,
      "--stdout-cursor", text_of(before_signal.output.next_cursor),
      "--stderr-cursor", "0", "--timeout-ms", "5000", "--max-bytes", "4096"
    ], "job-events");
    ensure(signal_output.stdout.bytes > 0, "cu_managed_job_user_signal_observed");
    const user_signal_replay = invoke_cu(
      run_directory, executable, signal_usr1_args, "job-signal"
    );
    ensure(
      user_signal_replay.effect === "not_repeated"
        && user_signal_replay.idempotent === true,
      "cu_managed_job_user_signal_replay_contract"
    );
  }
  const cleanup_renew_args = mutation_prefix(
    request_root + "-renew-for-cleanup", session_id, session_lease
  );
  append_all(cleanup_renew_args, [
    "job-renew", second_job.job_id, "" + second_job.generation, "--ttl-seconds", "1"
  ]);
  const cleanup_renewed = invoke_cu(
    run_directory, executable, cleanup_renew_args, "job-renew"
  );
  ensure(cleanup_renewed.renewed_ttl_ms === 1000,
    "cu_managed_job_cleanup_renew_contract");
  const stopped = stop_owned_job(
    run_directory, executable, session_id, session_lease,
    request_root + "-stop", second_job
  );
  ensure(
    stopped.stopped === true && stopped.job_id === second_job.job_id
      && stopped.generation === second_job.generation
      && stopped.status.state.kind !== "running",
    "cu_managed_job_stop_contract"
  );
  second_owner_absent = wait_owner_absent(run_directory, executable, second_job);
  ensure(second_owner_absent, "cu_managed_job_second_owner_cleanup");

  print("STEP plan and apply bounded terminal receipt retention without touching live or uncertain jobs");
  const prune_plan = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "job-prune", "--max-age-seconds", "0", "--keep-newest", "0"
  ], "job-prune");
  ensure(
    prune_plan.apply === false && prune_plan.eligible >= 2
      && prune_plan.removed === 0 && prune_plan.remaining === prune_plan.total
      && prune_plan.active === 0 && prune_plan.detached === 0 && prune_plan.uncertain === 0,
    "cu_managed_job_prune_plan_contract"
  );
  const prune_args = mutation_prefix(request_root + "-prune", session_id, session_lease);
  append_all(prune_args, [
    "job-prune", "--max-age-seconds", "0", "--keep-newest", "0", "--apply"
  ]);
  const prune_apply = invoke_cu(run_directory, executable, prune_args, "job-prune");
  ensure(
    prune_apply.apply === true && prune_apply.removed === prune_plan.eligible
      && prune_apply.remaining === 0
      && JSON.stringify(prune_apply.candidate_ids) === JSON.stringify(prune_plan.candidate_ids),
    "cu_managed_job_prune_apply_contract"
  );
  const pruned_jobs = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe", "job-list"
  ], "job-list");
  ensure(
    pruned_jobs.matched === 0 && pruned_jobs.returned === 0 && pruned_jobs.jobs.length === 0,
    "cu_managed_job_prune_readback"
  );

  if (windows) {
    print("STEP refuse process-group adoption on Windows instead of inventing retroactive Job Object ownership");
    const adopt_args = mutation_prefix(request_root + "-adopt-unsupported", session_id, session_lease);
    append_all(adopt_args, [
      "job-adopt", "42", "--start-identity", "windows-has-no-posix-group", "--ttl-seconds", "30"
    ]);
    invoke_cu_failure(
      run_directory, executable, adopt_args, "job-adopt", "managed_job_adopt_unsupported"
    );
  } else {
    print("STEP adopt one exact external process group without taking its stdio or default expiry ownership");
    adopted_child = harness.start_child(context, {
      program: "/bin/sh",
      args: ["-c", "while :; do sleep 1; done"],
      env: {},
      timeout_ms: 300000
    }, "managed-job-adopt-fixture");
    owned_children.push(adopted_child);
    const adopted_process = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe",
      "process-state", "--pid", "" + adopted_child.pid
    ], "process-state");
    ensure(
      adopted_process.state === "live" && text_of(adopted_process.start_identity) !== "",
      "cu_managed_job_adopt_fixture_identity"
    );
    const adopt_args = mutation_prefix(request_root + "-adopt", session_id, session_lease);
    append_all(adopt_args, [
      "job-adopt", "" + adopted_child.pid,
      "--start-identity", adopted_process.start_identity,
      "--ttl-seconds", "30", "--expiry", "detach"
    ]);
    const adopted = invoke_cu(run_directory, executable, adopt_args, "job-adopt");
    const adopted_replay = invoke_cu(run_directory, executable, adopt_args, "job-adopt");
    adopted_job = {job_id: text_of(adopted.job_id), generation: adopted.generation};
    ensure(
      adopted_job.job_id !== "" && adopted_job.generation > 0
        && adopted_replay.job_id === adopted_job.job_id
        && adopted_replay.generation === adopted_job.generation,
      "cu_managed_job_adopt_replay_identity"
    );
    const adopted_status = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe", "job-status", adopted_job.job_id
    ], "job-status");
    const adopted_resources = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe",
      "job-resources", adopted_job.job_id, "" + adopted_job.generation
    ], "job-resources");
    ensure(
      adopted_status.origin === "adopted" && adopted_status.io_available === false
        && adopted_status.live.adopted === true && adopted_status.live.stdin_open === false
        && adopted_status.process_pid === adopted_child.pid
        && has_resource_member(adopted_resources.members, adopted_child.pid, true),
      "cu_managed_job_adopt_status_resources"
    );

    print("STEP pre-retain exact native authority before force-stopping an adopted process group");
    adopted_stop_child = harness.start_child(context, {
      program: "/bin/sh",
      args: ["-c", "while :; do sleep 1; done"],
      env: {},
      timeout_ms: 300000
    }, "managed-job-adopt-stop-fixture");
    owned_children.push(adopted_stop_child);
    const stop_process = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe",
      "process-state", "--pid", "" + adopted_stop_child.pid
    ], "process-state");
    const stop_adopt_args = mutation_prefix(request_root + "-adopt-stop", session_id, session_lease);
    append_all(stop_adopt_args, [
      "job-adopt", "" + adopted_stop_child.pid,
      "--start-identity", stop_process.start_identity,
      "--ttl-seconds", "30", "--expiry", "stop", "--force"
    ]);
    const adopted_stop = invoke_cu(run_directory, executable, stop_adopt_args, "job-adopt");
    adopted_stop_job = {
      job_id: text_of(adopted_stop.job_id), generation: adopted_stop.generation
    };
    const stopped_adopt_args = mutation_prefix(
      request_root + "-stop-adopted", session_id, session_lease
    );
    append_all(stopped_adopt_args, [
      "job-stop", adopted_stop_job.job_id, "" + adopted_stop_job.generation,
      "--expect-stopped"
    ]);
    const stopped_adopt = invoke_cu(
      run_directory, executable, stopped_adopt_args, "job-stop"
    );
    harness.child_wait(adopted_stop_child, 5000);
    ensure(
      stopped_adopt.stopped === true
        && stopped_adopt.status.adopted === true
        && stopped_adopt.status.state.kind === "signaled"
        && harness.child_state(adopted_stop_child) === "exited",
      "cu_managed_job_adopt_exact_stop"
    );
  }

  print("STEP spawn expiry: default and explicit stop are accepted; detach is a typed pre-effect refusal");
  const short_command = windows
    ? ["cmd.exe", "/c", "exit", "0"]
    : ["/bin/sh", "-c", "exit 0"];
  // (1) No --expiry: the default must be `stop` (unchanged behaviour).
  const default_args = mutation_prefix(request_root + "-expiry-default", session_id, session_lease);
  append_all(default_args, ["job-spawn", "--ttl-seconds", "60", "--"]);
  append_all(default_args, long_command);
  const default_spawned = invoke_cu(run_directory, executable, default_args, "job-spawn");
  const default_job = { job_id: text_of(default_spawned.job_id), generation: default_spawned.generation };
  const default_status = job_status_of(run_directory, executable, default_job.job_id);
  ensure(default_status.on_expiry === "stop", "cu_managed_job_spawn_default_expiry");
  const default_replay = invoke_cu(run_directory, executable, default_args, "job-spawn");
  ensure(
    text_of(default_replay.job_id) === default_job.job_id
      && default_replay.generation === default_job.generation,
    "cu_managed_job_spawn_replay_identity"
  );
  // (2) Explicit --expiry stop.
  const stop_args = mutation_prefix(request_root + "-expiry-stop", session_id, session_lease);
  append_all(stop_args, ["job-spawn", "--ttl-seconds", "60", "--expiry", "stop", "--"]);
  append_all(stop_args, long_command);
  const stop_spawned = invoke_cu(run_directory, executable, stop_args, "job-spawn");
  const stop_job = { job_id: text_of(stop_spawned.job_id), generation: stop_spawned.generation };
  ensure(
    job_status_of(run_directory, executable, stop_job.job_id).on_expiry === "stop",
    "cu_managed_job_spawn_explicit_stop_expiry"
  );
  // (3) --expiry detach: stable typed code with NO side effect. Three
  //     independent censuses (store bytes+directory, job-list owners, the
  //     reply-independent inventory) must be unchanged.
  const store_before = state_census(run_directory);
  const owners_before = owner_census(run_directory, executable);
  const detached_retired_args = mutation_prefix(
    request_root + "-expiry-detach", session_id, session_lease
  );
  append_all(detached_retired_args, ["job-spawn", "--ttl-seconds", "60", "--expiry", "detach", "--"]);
  append_all(detached_retired_args, long_command);
  invoke_cu_failure(
    run_directory, executable, detached_retired_args, "job-spawn", "managed_job_detach_retired"
  );
  ensure(state_census(run_directory) === store_before, "cu_managed_job_detach_state_unchanged");
  ensure(
    owner_census(run_directory, executable) === owners_before,
    "cu_managed_job_detach_owner_census_unchanged"
  );
  // A bogus spelling stays a usage error, not the typed retirement.
  const bogus_args = mutation_prefix(request_root + "-expiry-bogus", session_id, session_lease);
  append_all(bogus_args, ["job-spawn", "--ttl-seconds", "60", "--expiry", "bogus", "--"]);
  append_all(bogus_args, long_command);
  const bogus_message = invoke_cu_usage_failure(run_directory, executable, bogus_args);
  ensure(
    bogus_message.indexOf("--expiry must be stop or detach") >= 0,
    "cu_managed_job_expiry_spelling:" + bogus_message
  );

  print("STEP terminal triggers: explicit stop, lease expiry and root exit are recorded verbatim");
  stop_owned_job(
    run_directory, executable, session_id, session_lease,
    request_root + "-trigger-stop", stop_job
  );
  const stopped_trigger = job_status_of(run_directory, executable, stop_job.job_id).terminal_trigger;
  ensure(stopped_trigger === "explicit_stop", "cu_managed_job_trigger_explicit_stop:" + stopped_trigger);
  // A repeated stop is a replay: the same trigger, never a second transition.
  const stopped_again = stop_owned_job(
    run_directory, executable, session_id, session_lease,
    request_root + "-trigger-stop-replay", stop_job
  );
  ensure(stopped_again.stopped === true, "cu_managed_job_trigger_stop_replay");
  ensure(
    job_status_of(run_directory, executable, stop_job.job_id).terminal_trigger === "explicit_stop",
    "cu_managed_job_trigger_stop_exactly_once"
  );
  // Lease expiry: a one-second lease expires while the job is still running.
  const expiring_args = mutation_prefix(request_root + "-trigger-expiry", session_id, session_lease);
  append_all(expiring_args, ["job-spawn", "--ttl-seconds", "1", "--"]);
  append_all(expiring_args, long_command);
  const expiring_spawned = invoke_cu(run_directory, executable, expiring_args, "job-spawn");
  const expiring_job = { job_id: text_of(expiring_spawned.job_id), generation: expiring_spawned.generation };
  let expiry_trigger = "";
  for (let poll = 0; poll < 100; poll = poll + 1) {
    const status = job_status_of(run_directory, executable, expiring_job.job_id);
    if (status.state !== "running" && status.state !== "starting" && status.state !== "start_intent") {
      expiry_trigger = text_of(status.terminal_trigger);
      break;
    }
    harness.sleep_ms(100);
  }
  ensure(expiry_trigger === "lease_expiry", "cu_managed_job_trigger_lease_expiry:" + expiry_trigger);
  // Root exit: a job that exits on its own is a root_exit, not a stop.
  const exit_args = mutation_prefix(request_root + "-trigger-rootexit", session_id, session_lease);
  append_all(exit_args, ["job-spawn", "--ttl-seconds", "60", "--"]);
  append_all(exit_args, short_command);
  const exit_spawned = invoke_cu(run_directory, executable, exit_args, "job-spawn");
  const exit_job = { job_id: text_of(exit_spawned.job_id), generation: exit_spawned.generation };
  let exit_trigger = "";
  for (let poll = 0; poll < 100; poll = poll + 1) {
    const status = job_status_of(run_directory, executable, exit_job.job_id);
    if (status.state === "exited" || status.state === "signaled") {
      exit_trigger = text_of(status.terminal_trigger);
      ensure(status.terminal_trigger === "root_exit", "cu_managed_job_trigger_root_exit_published");
      break;
    }
    harness.sleep_ms(100);
  }
  ensure(exit_trigger === "root_exit", "cu_managed_job_trigger_root_exit:" + exit_trigger);
  // Owner lost: only the store's exact-owner-death reconciliation writes it. It
  // lives in its OWN session, because an uncertain record must make that
  // session's teardown refuse rather than report a clean sweep.
  const lost_session = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "actuate",
    "session-start", "--label", "managed-job-owner-lost", "--ttl-seconds", "120"
  ], "session-start");
  lost_session_id = text_of(lost_session.session_id);
  lost_session_lease = text_of(lost_session.lease);
  ensure(lost_session_id !== "" && lost_session_lease !== "", "cu_managed_job_lost_session");
  // The job adopts a COURT-OWNED fixture (registered in `owned_children`, exact
  // identity held here), so every teardown below is an identity-bound public
  // verb rather than a bare signal or an unregistered child.
  lost_fixture = harness.start_child(context, {
    program: "/bin/sh",
    args: ["-c", "while :; do sleep 1; done"],
    env: {},
    timeout_ms: 300000
  }, "managed-job-owner-lost-fixture");
  owned_children.push(lost_fixture);
  const lost_process = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "process-state", "--pid", "" + lost_fixture.pid
  ], "process-state");
  lost_fixture_identity = text_of(lost_process.start_identity);
  ensure(lost_fixture_identity !== "", "cu_managed_job_lost_fixture_identity");
  const lost_args = mutation_prefix(
    request_root + "-trigger-ownerlost", lost_session_id, lost_session_lease
  );
  append_all(lost_args, [
    "job-adopt", "" + lost_fixture.pid,
    "--start-identity", lost_fixture_identity,
    "--ttl-seconds", "600", "--expiry", "stop", "--force"
  ]);
  const lost_adopted = invoke_cu(run_directory, executable, lost_args, "job-adopt");
  const lost_job = { job_id: text_of(lost_adopted.job_id), generation: lost_adopted.generation };
  const lost_status = job_status_of(run_directory, executable, lost_job.job_id);
  ensure(text_of(lost_status.owner_pid) !== "", "cu_managed_job_owner_pid_present");
  // Kill the OWNER through the same public, identity-bound, tree-capable verb.
  const owner_process = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "process-state", "--pid", text_of(lost_status.owner_pid)
  ], "process-state");
  const owner_identity = text_of(owner_process.start_identity);
  ensure(owner_identity !== "", "cu_managed_job_owner_identity");
  const owner_kill = kill_bound_fixture(
    run_directory, executable, lost_status.owner_pid, owner_identity
  );
  ensure(owner_kill === "killed", "cu_managed_job_owner_kill:" + owner_kill);
  let lost_trigger = "";
  for (let poll = 0; poll < 100; poll = poll + 1) {
    const status = job_status_of(run_directory, executable, lost_job.job_id);
    if (status.state === "orphaned_uncertain") {
      lost_trigger = text_of(status.terminal_trigger);
      ensure(status.detach_liveness === null, "cu_managed_job_owner_lost_is_not_detached");
      break;
    }
    harness.sleep_ms(100);
  }
  ensure(lost_trigger === "owner_lost", "cu_managed_job_trigger_owner_lost:" + lost_trigger);
  // The owning session must refuse to claim a clean sweep for an uncertain job,
  // and the refusal must name that job's typed code.
  const lost_end = invoke_cu_uncertain_session_end(
    run_directory, executable, lost_session_id, lost_session_lease
  );
  lost_end_attempted = true;
  ensure(
    text_of(lost_end) === "managed_job_orphaned_uncertain",
    "cu_managed_job_owner_lost_session_refusal:" + text_of(lost_end)
  );
  // The refusal MUST NOT be recorded as a clean teardown.
  lost_session_cleanly_ended = false;
  // The adopted fixture is still alive (CU never owned its lifetime); the court
  // removes it by exact identity and proves root+descendants absent BEFORE the
  // cleanup-closure identity is emitted.
  const lost_fixture_kill = kill_bound_fixture(
    run_directory, executable, lost_fixture.pid, lost_fixture_identity
  );
  ensure(lost_fixture_kill === "killed", "cu_managed_job_lost_fixture_kill:" + lost_fixture_kill);
  ensure(
    fixture_presence(run_directory, executable, lost_fixture.pid, lost_fixture_identity) === "absent",
    "cu_managed_job_lost_fixture_absent"
  );
  lost_fixture_clean = true;
  lost_fixture = null;

  print("STEP adopt detach liveness: live and absent are distinguished, never rounded to live");
  if (!windows) {
    // (a) live: the adopted process is still there when the lease expires.
    detach_live_child = harness.start_child(context, {
      program: "/bin/sh",
      args: ["-c", "while :; do sleep 1; done"],
      env: {},
      timeout_ms: 300000
    }, "managed-job-detach-live-fixture");
    owned_children.push(detach_live_child);
    const live_process = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe",
      "process-state", "--pid", "" + detach_live_child.pid
    ], "process-state");
    detach_live_identity = text_of(live_process.start_identity);
    ensure(detach_live_identity !== "", "cu_managed_job_detach_live_identity");
    const live_args = mutation_prefix(request_root + "-detach-live", session_id, session_lease);
    append_all(live_args, [
      "job-adopt", "" + detach_live_child.pid,
      "--start-identity", detach_live_identity,
      "--ttl-seconds", "1", "--expiry", "detach"
    ]);
    const adopted_live = invoke_cu(run_directory, executable, live_args, "job-adopt");
    detach_live_job = { job_id: text_of(adopted_live.job_id), generation: adopted_live.generation };
    ensure(
      job_status_of(run_directory, executable, detach_live_job.job_id).on_expiry === "detach",
      "cu_managed_job_adopt_detach_policy"
    );
    let live_state = null;
    for (let poll = 0; poll < 100; poll = poll + 1) {
      const status = job_status_of(run_directory, executable, detach_live_job.job_id);
      if (status.state === "detached") { live_state = status; break; }
      harness.sleep_ms(100);
    }
    ensure(live_state !== null, "cu_managed_job_adopt_detach_reached");
    ensure(
      live_state.detach_liveness === "live",
      "cu_managed_job_adopt_detach_liveness_live:" + text_of(live_state.detach_liveness)
    );
    ensure(
      text_of(live_state.terminal_trigger) === "lease_expiry",
      "cu_managed_job_adopt_detach_trigger"
    );
    // The detached process is still running; the court must remove it by exact
    // identity (never a bare pid).
    const live_kill = kill_bound_fixture(
      run_directory, executable, detach_live_child.pid, detach_live_identity
    );
    ensure(live_kill === "killed", "cu_managed_job_detach_fixture_cleanup:" + live_kill);
    detach_live_child = null;

    // (b) absent: the process exits before the lease expires, so an absent
    //     liveness is reported instead of a survival claim.
    // Alive when adopted, gone before the lease expires: exactly the shape that
    // must report `absent` rather than a survival claim.
    detach_absent_child = harness.start_child(context, {
      program: "/bin/sh",
      args: ["-c", "sleep 1"],
      env: {},
      timeout_ms: 300000
    }, "managed-job-detach-absent-fixture");
    owned_children.push(detach_absent_child);
    const absent_process = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe",
      "process-state", "--pid", "" + detach_absent_child.pid
    ], "process-state");
    detach_absent_identity = text_of(absent_process.start_identity);
    ensure(detach_absent_identity !== "", "cu_managed_job_detach_absent_identity");
    const absent_args = mutation_prefix(request_root + "-detach-absent", session_id, session_lease);
    append_all(absent_args, [
      "job-adopt", "" + detach_absent_child.pid,
      "--start-identity", detach_absent_identity,
      "--ttl-seconds", "2", "--expiry", "detach"
    ]);
    const adopted_absent = invoke_cu(run_directory, executable, absent_args, "job-adopt");
    detach_absent_job = { job_id: text_of(adopted_absent.job_id), generation: adopted_absent.generation };
    harness.child_wait(detach_absent_child, 5000);
    detach_absent_child = null;
    let absent_state = null;
    for (let poll = 0; poll < 100; poll = poll + 1) {
      const status = job_status_of(run_directory, executable, detach_absent_job.job_id);
      if (status.state === "detached") { absent_state = status; break; }
      harness.sleep_ms(100);
    }
    ensure(absent_state !== null, "cu_managed_job_adopt_absent_detach_reached");
    ensure(
      absent_state.detach_liveness === "absent",
      "cu_managed_job_adopt_detach_liveness_absent:" + text_of(absent_state.detach_liveness)
    );
  }

  print("STEP bind one running job and target lock to the session before terminal cleanup");
  const bound_spawn_args = mutation_prefix(request_root + "-spawn-session-bound", session_id, session_lease);
  append_all(bound_spawn_args, ["job-spawn", "--ttl-seconds", "30", "--"]);
  append_all(bound_spawn_args, long_command);
  const bound_spawned = invoke_cu(run_directory, executable, bound_spawn_args, "job-spawn");
  session_bound_job = {
    job_id: text_of(bound_spawned.job_id),
    generation: bound_spawned.generation
  };
  const bound_lock = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "actuate",
    "lock-acquire", session_id, session_lease, "court:session-end", "--ttl-seconds", "30"
  ], "lock-acquire");
  ensure(
    session_bound_job.job_id !== "" && session_bound_job.generation > 0
      && bound_lock.lock.session_id === session_id,
    "cu_managed_job_session_bound_fixture"
  );

  print("STEP end the owning runtime session, stop its running job, and release its target lock");
  const ended = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "actuate",
    "session-end", session_id, "--lease", session_lease, "--confirm"
  ], "session-end");
  session_ended = true;
  ensure(
    ended.session.session_id === session_id && ended.session.state === "ended"
      && ended.released_locks === 1 && ended.jobs.complete === true
      && ended.jobs.stopped >= 1 && ended.jobs.failed.length === 0,
    "cu_managed_job_session_end_contract"
  );
  session_bound_owner_absent = wait_owner_absent(run_directory, executable, session_bound_job);
  ensure(session_bound_owner_absent, "cu_managed_job_session_end_owner_cleanup");
  const bound_status = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "job-status", session_bound_job.job_id
  ], "job-status");
  ensure(
    bound_status.terminal !== null && bound_status.state !== "running",
    "cu_managed_job_session_end_terminal_readback"
  );
  // The bound SPAWNED job must record session_end as its trigger.
  ensure(
    text_of(bound_status.terminal_trigger) === "session_end",
    "cu_managed_job_session_end_trigger:" + text_of(bound_status.terminal_trigger)
  );
  if (adopted_job !== null) {
    ensure(ended.jobs.detached >= 1, "cu_managed_job_session_end_adopt_detached_count");
    ensure(wait_owner_absent(run_directory, executable, adopted_job), "cu_managed_job_adopt_owner_cleanup");
    const adopted_after = invoke_cu(run_directory, executable, [
      "--target", "current", "--grant", "observe", "job-status", adopted_job.job_id
    ], "job-status");
    ensure(
      adopted_after.state === "detached" && harness.child_state(adopted_child) === "running",
      "cu_managed_job_adopt_default_detach_preserves_external_group"
    );
    // An ADOPTED detach reached through session-end records the same trigger,
    // and its liveness is the bounded observation, not a survival claim.
    ensure(
      text_of(adopted_after.terminal_trigger) === "session_end",
      "cu_managed_job_session_end_adopt_trigger:" + text_of(adopted_after.terminal_trigger)
    );
    ensure(
      is_detach_liveness(adopted_after.detach_liveness),
      "cu_managed_job_session_end_adopt_liveness:" + text_of(adopted_after.detach_liveness)
    );
  }

  print("STEP repeat session-end with the same lease without repeating any cleanup effect");
  const repeated_end = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "actuate",
    "session-end", session_id, "--lease", session_lease, "--confirm"
  ], "session-end");
  ensure(
    repeated_end.session.session_id === session_id
      && repeated_end.session.state === "ended"
      && repeated_end.released_locks === 0
      && repeated_end.jobs.complete === true
      && repeated_end.jobs.stopped === 0,
    "cu_managed_job_session_end_idempotent"
  );

  print("STEP expire a short session and prove its owned target lock is swept from public state");
  const expiring = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "actuate",
    "session-start", "--label", "expiry-smoke", "--ttl-seconds", "3"
  ], "session-start");
  const expiring_id = text_of(expiring.session_id);
  const expiring_lease = text_of(expiring.lease);
  const expiring_lock = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "actuate",
    "lock-acquire", expiring_id, expiring_lease, "court:expiry", "--ttl-seconds", "3"
  ], "lock-acquire");
  ensure(expiring_lock.lock.session_id === expiring_id, "cu_runtime_expiring_lock_contract");
  harness.sleep_ms(4200);
  const expired = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe", "session-status", expiring_id
  ], "session-status");
  const active_locks = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe", "lock-list"
  ], "lock-list");
  ensure(
    expired.state === "expired" && active_locks.locks.length === 0,
    "cu_runtime_expiry_cleanup_contract"
  );

  print("STEP plan and atomically apply bounded audit retention without hiding malformed or expired drops");
  rh.write_text(
    audit_path,
    rh.read_text(audit_path)
      + "{malformed\n"
      + "{\"ts_ms\":1,\"verb\":\"expired-fixture\",\"outcome\":\"ok\"}\n"
  );
  const retention_plan = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "audit-compact", "--max-age-days", "1", "--max-events", "100",
    "--max-bytes", "65536"
  ], "audit-compact");
  ensure(
    retention_plan.status === "planned" && retention_plan.apply_required === true
      && retention_plan.destination_durable === null
      && retention_plan.malformed_dropped >= 1 && retention_plan.expired_dropped >= 1,
    "cu_audit_retention_plan_contract"
  );
  const retention_apply = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "actuate",
    "audit-compact", "--max-age-days", "1", "--max-events", "100",
    "--max-bytes", "65536", "--apply"
  ], "audit-compact");
  ensure(
    retention_apply.status === "applied" && retention_apply.apply_required === false
      && retention_apply.destination_durable === true
      && retention_apply.malformed_dropped >= 1 && retention_apply.expired_dropped >= 1
      && retention_apply.after_bytes <= 65536,
    "cu_audit_retention_apply_contract"
  );
  const retained_audit = invoke_cu(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "audit-query", "--verb", "audit-compact", "--max", "10"
  ], "audit-query");
  ensure(
    retained_audit.records.length >= 2 && retained_audit.malformed === 0,
    "cu_audit_retention_readback_contract"
  );
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

// Cleanup is identity-bound. Never use a process-name pattern, and do not
// retain a failure string containing a lease, command, environment or stdin.
if (session_id !== "" && session_lease !== "") {
  if (first_job !== null && !first_owner_absent) {
    try {
      stop_owned_job(
        run_directory, executable, session_id, session_lease,
        request_root + "-cleanup-first", first_job
      );
    } catch (error) {}
    try { first_owner_absent = wait_owner_absent(run_directory, executable, first_job); }
    catch (error) {}
  }
  if (second_job !== null && !second_owner_absent) {
    try {
      stop_owned_job(
        run_directory, executable, session_id, session_lease,
        request_root + "-cleanup-second", second_job
      );
    } catch (error) {}
    try { second_owner_absent = wait_owner_absent(run_directory, executable, second_job); }
    catch (error) {}
  }
  if (session_bound_job !== null && !session_bound_owner_absent) {
    try {
      invoke_cu(run_directory, executable, [
        "--target", "current", "--grant", "actuate",
        "session-end", session_id, "--lease", session_lease, "--confirm"
      ], "session-end");
    } catch (error) {}
    try {
      session_bound_owner_absent = wait_owner_absent(run_directory, executable, session_bound_job);
    } catch (error) {}
  }
  if (!session_ended) {
    try {
      invoke_cu(run_directory, executable, [
        "--target", "current", "--grant", "actuate",
        "session-end", session_id, "--lease", session_lease, "--confirm"
      ], "session-end");
      session_ended = true;
    } catch (error) {}
  }
}
if (first_job !== null && !first_owner_absent) {
  failure = failure === "" ? "cu_managed_job_first_owner_cleanup" : failure;
}
if (second_job !== null && !second_owner_absent) {
  failure = failure === "" ? "cu_managed_job_second_owner_cleanup" : failure;
}
if (session_bound_job !== null && !session_bound_owner_absent) {
  failure = failure === "" ? "cu_managed_job_session_bound_owner_cleanup" : failure;
}
for (const bound of [
  [detach_live_child, detach_live_identity],
  [detach_absent_child, detach_absent_identity]
]) {
  if (bound[0] === null) { continue; }
  let verdict = "unobservable";
  try { verdict = kill_bound_fixture(run_directory, executable, bound[0].pid, bound[1]); }
  catch (error) { verdict = "unobservable"; }
  if (verdict === "killed" || verdict === "already_absent") { continue; }
  failure = failure === "" ? "cu_managed_job_detach_fixture_cleanup:" + verdict : failure;
}
// The uncertain session end is EXPECTED to refuse, so `cleanly ended` stays
// false; what matters is that the attempt happened and every fixture is closed.
if (lost_session_id !== "" && !lost_end_attempted) {
  failure = failure === "" ? "cu_managed_job_lost_session_end_not_attempted" : failure;
}
if (lost_session_cleanly_ended) {
  failure = failure === "" ? "cu_managed_job_uncertain_session_reported_clean" : failure;
}
if (lost_fixture !== null) {
  let verdict = "unobservable";
  try { verdict = kill_bound_fixture(run_directory, executable, lost_fixture.pid, lost_fixture_identity); }
  catch (error) { verdict = "unobservable"; }
  if (verdict === "killed" || verdict === "already_absent") { lost_fixture_clean = true; }
  else { failure = failure === "" ? "cu_managed_job_lost_fixture_cleanup:" + verdict : failure; }
}
if (!lost_fixture_clean && lost_session_id !== "") {
  failure = failure === "" ? "cu_managed_job_lost_fixture_residue" : failure;
}
if (session_id !== "" && !session_ended) {
  failure = failure === "" ? "cu_managed_job_session_cleanup" : failure;
}
if (failure !== "") { succeeded = 0; }

let completion_failure = "";
try { harness.complete_children(context, owned_children, succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-lifecycle");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-resources");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-limits");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-adopt");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-state-signal");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-priority");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-policy");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-prune");
  harness.emit_evidence(context, declared_evidence, "cu.audit-retention");
  harness.emit_evidence(context, declared_evidence, "cu.target-lock-lifecycle");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-spawn-expiry");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-adopt-detach-liveness");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-terminal-trigger");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-expiry-idempotency");
  harness.emit_evidence(context, declared_evidence, "cu.managed-job-detach-fixture-cleanup");
  harness.remove_run(context);
  print("PASS: agenterm-cu managed-job lifecycle, containment resources and bounded audit retention");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
