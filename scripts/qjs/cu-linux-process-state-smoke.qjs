// CEO: Linux process-state honesty with independent /proc/<pid>/stat and status read-back.
// Acceptance is smoke read-back only: CU process-state must agree with pid, live/dead
// classification and start identity derived outside agenterm-cu for the same PID.
// Typed process-state usage must reject AT-SPI --name and other unexpected arguments;
// typed get-extents --name usage/host-limit paths must hold before the /proc status/stat
// read-back court. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-state-readback",
];

const AT_SPI_PROBE_NAME = "Process State Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_state_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "process-state" || text_at(reply, "command") === "usage",
    "cu_linux_process_state_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_state_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_process_state_usage_limit(run_directory, executable, env) {
  const flat_with_name = invoke_observe_reply(run_directory, executable, [
    "process-state", "--pid", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_process_state_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_process_state_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_process_state_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    text_at(flat_with_name, "error.message").indexOf("--name") >= 0
      || text_at(flat_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_process_state_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_observe_reply(run_directory, executable, [
    "process", "state", "--pid", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_process_state_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_process_state_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "error.message").indexOf("--name") >= 0
      || text_at(grouped_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_process_state_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = invoke_observe_reply(run_directory, executable, [
    "process-state", "--pid", "1", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_process_state_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_process_state_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("unexpected") >= 0
      || text_at(with_bogus, "error.message").indexOf("--bogus") >= 0,
    "cu_linux_process_state_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_process_state_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_process_state_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_process_state_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_process_state_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_process_state_extents_unavailable_code:" + code
  );
}

function verify_readback(run_directory, executable, pid, env) {
  const script = [
    "import json, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "def parse_proc(pid):",
    "    try:",
    "        with open(f'/proc/{pid}/stat') as handle:",
    "            stat = handle.read()",
    "    except FileNotFoundError:",
    "        return {'exists': False}",
    "    close = stat.rfind(')')",
    "    if close < 0:",
    "        raise ValueError('process stat has no closing command delimiter')",
    "    fields = stat[close + 2:].split()",
    "    if len(fields) < 20:",
    "        raise ValueError('process stat missing starttime field')",
    "    proc_state = fields[0]",
    "    stat_ppid = int(fields[1])",
    "    start_ticks = fields[19]",
    "    status_pid = None",
    "    status_ppid = None",
    "    with open(f'/proc/{pid}/status') as handle:",
    "        for line in handle:",
    "            if line.startswith('Pid:'):",
    "                status_pid = int(line.split()[1])",
    "            elif line.startswith('PPid:'):",
    "                status_ppid = int(line.split()[1])",
    "    if status_pid != pid:",
    "        raise SystemExit('cu_linux_process_state_status_pid')",
    "    if status_ppid != stat_ppid:",
    "        raise SystemExit('cu_linux_process_state_stat_status_ppid')",
    "    if proc_state in ('Z', 'X', 'x'):",
    "        expected_state = 'dead'",
    "    else:",
    "        expected_state = 'live'",
    "    return {",
    "        'exists': True,",
    "        'expected_state': expected_state,",
    "        'start_identity': f'proc-start-ticks:{start_ticks}',",
    "        'stat_ppid': stat_ppid,",
    "    }",
    "def invoke_state():",
    "    out = subprocess.check_output(",
    "        [cu, '--target', 'current', '--grant', 'observe',",
    "         'process-state', '--pid', str(pid)],",
    "        text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok') or reply.get('command') != 'process-state':",
    "        raise SystemExit('cu_linux_process_state_reply_state')",
    "    return reply['data']",
    "proc = parse_proc(pid)",
    "cu = invoke_state()",
    "if int(cu.get('pid', -1)) != pid:",
    "    raise SystemExit('cu_linux_process_state_pid')",
    "if not proc['exists']:",
    "    if cu.get('state') != 'dead':",
    "        raise SystemExit('cu_linux_process_state_missing_not_dead')",
    "    if cu.get('verified') is not True:",
    "        raise SystemExit('cu_linux_process_state_missing_not_verified')",
    "    print('pid', pid, 'dead')",
    "    raise SystemExit(0)",
    "if cu.get('state') != proc['expected_state']:",
    "    raise SystemExit(f'cu_linux_process_state_state:{cu.get(\"state\")}:{proc[\"expected_state\"]}')",
    "if proc['expected_state'] == 'live':",
    "    if cu.get('start_identity') != proc['start_identity']:",
    "        raise SystemExit(f'cu_linux_process_state_start_identity:{cu.get(\"start_identity\")}:{proc[\"start_identity\"]}')",
    "    if cu.get('verified') is not True:",
    "        raise SystemExit('cu_linux_process_state_live_not_verified')",
    "else:",
    "    if cu.get('verified') is not True:",
    "        raise SystemExit('cu_linux_process_state_dead_not_verified')",
    "print('pid', pid)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, executable], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_process_state_readback:" + output.stderr + output.stdout);
}

function verify_pid(run_directory, executable, pid, env) {
  verify_readback(run_directory, executable, pid, env);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-state");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
try {
  print("STEP process-state typed-fails usage when AT-SPI --name or other unexpected arguments are present");
  assert_process_state_usage_limit(context.run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before /proc status/stat read-back");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP process-state observe matches independent /proc stat and status read-back for self");
  verify_pid(context.run_directory, executable, rh.pid(), env);

  print("STEP spawn disposable child and verify --pid read-back");
  const child = harness.start({
    program: "sleep",
    args: ["300"],
    current_dir: context.run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 60000,
  });
  verify_pid(context.run_directory, executable, harness.spawned_pid(child), env);
  harness.kill(child);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-state-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux process-state matches independent /proc/<pid>/stat and status read-back with typed process-state/get-extents usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux process-state matches independent /proc/<pid>/stat and status read-back with typed process-state/get-extents host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
