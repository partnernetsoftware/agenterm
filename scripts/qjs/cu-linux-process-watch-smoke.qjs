// CEO: Linux process-watch honesty with independent /proc scan diff read-back.
// Acceptance is smoke read-back only: CU process-watch started/exited events must
// agree with pid/start-identity add/remove diffs from an independent /proc poll
// over the same selector window. Typed process-watch usage must reject unexpected
// arguments; native --name remains the executable-name selector (not AT-SPI).
// Typed get-extents --name usage/host-limit paths must hold before the /proc scan
// diff read-back court. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-watch-readback",
];

const AT_SPI_PROBE_NAME = "Process Watch Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_watch_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "process-watch" || text_at(reply, "command") === "usage",
    "cu_linux_process_watch_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_watch_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_process_watch_usage_limit(run_directory, executable, env) {
  const flat_with_bogus = invoke_observe_reply(run_directory, executable, [
    "process-watch", "--parent", "1", "--bogus", "--duration-ms", "1",
  ], env);
  ensure(!output_success(flat_with_bogus),
    "cu_linux_process_watch_usage_flat_bogus_ok:" + JSON.stringify(flat_with_bogus));
  ensure(
    text_at(flat_with_bogus, "error.code") === "usage",
    "cu_linux_process_watch_usage_flat_bogus_code:" + JSON.stringify(flat_with_bogus.error)
  );
  ensure(
    text_at(flat_with_bogus, "command") === "usage",
    "cu_linux_process_watch_usage_flat_bogus_command:" + JSON.stringify(flat_with_bogus)
  );
  ensure(
    text_at(flat_with_bogus, "error.message").indexOf("unexpected") >= 0
      || text_at(flat_with_bogus, "error.message").indexOf("--bogus") >= 0,
    "cu_linux_process_watch_usage_flat_bogus_message:" + JSON.stringify(flat_with_bogus.error)
  );

  const grouped_with_bogus = invoke_observe_reply(run_directory, executable, [
    "process", "watch", "--parent", "1", "--bogus", "--duration-ms", "1",
  ], env);
  ensure(!output_success(grouped_with_bogus),
    "cu_linux_process_watch_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_process_watch_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    text_at(grouped_with_bogus, "error.message").indexOf("unexpected") >= 0
      || text_at(grouped_with_bogus, "error.message").indexOf("--bogus") >= 0,
    "cu_linux_process_watch_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const missing_selector = invoke_observe_reply(run_directory, executable, [
    "process-watch", "--duration-ms", "1",
  ], env);
  ensure(!output_success(missing_selector),
    "cu_linux_process_watch_usage_missing_selector_ok:" + JSON.stringify(missing_selector));
  ensure(
    text_at(missing_selector, "error.code") === "usage",
    "cu_linux_process_watch_usage_missing_selector_code:" + JSON.stringify(missing_selector.error)
  );
  ensure(
    text_at(missing_selector, "error.message").indexOf("--pid") >= 0
      || text_at(missing_selector, "error.message").indexOf("--parent") >= 0
      || text_at(missing_selector, "error.message").indexOf("--name") >= 0
      || text_at(missing_selector, "error.message").indexOf("--all") >= 0,
    "cu_linux_process_watch_usage_missing_selector_message:" + JSON.stringify(missing_selector.error)
  );

  const native_name = invoke_observe_reply(run_directory, executable, [
    "process-watch", "--name", "sleep",
    "--duration-ms", "1", "--interval-ms", "1",
    "--max-events", "1", "--max-processes", "4",
  ], env);
  ensure(output_success(native_name),
    "cu_linux_process_watch_usage_native_name:" + JSON.stringify(native_name));
  ensure(
    text_at(native_name, "command") === "process-watch",
    "cu_linux_process_watch_usage_native_name_command:" + JSON.stringify(native_name)
  );
  ensure(
    text_at(native_name, "data.selector.name") === "sleep",
    "cu_linux_process_watch_usage_native_name_selector:" + JSON.stringify(native_name.data)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_process_watch_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_process_watch_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_process_watch_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_process_watch_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_process_watch_extents_unavailable_code:" + code
  );
}

function verify_parent_watch(run_directory, executable, env) {
  const script = [
    "import json, os, subprocess, sys, threading, time",
    "cu = sys.argv[1]",
    "run_dir = sys.argv[2]",
    "parent_pid = os.getpid()",
    "duration_ms = 6000",
    "interval_ms = 40",
    "max_events = 8",
    "max_processes = 64",
    "def parse_row(pid):",
    "    try:",
    "        stat = open(f'/proc/{pid}/stat').read()",
    "    except OSError:",
    "        return None",
    "    close = stat.rfind(')')",
    "    if close < 0:",
    "        return None",
    "    fields = stat[close + 2:].split()",
    "    if len(fields) < 20:",
    "        return None",
    "    state = fields[0]",
    "    if state in ('Z', 'X', 'x'):",
    "        return None",
    "    ppid = int(fields[1])",
    "    start_ticks = fields[19]",
    "    try:",
    "        exe = os.path.basename(os.readlink(f'/proc/{pid}/exe'))",
    "    except OSError:",
    "        return None",
    "    identity = f'proc-start-ticks:{start_ticks}'",
    "    return {",
    "        'pid': pid,",
    "        'parent_pid': ppid,",
    "        'executable_name': exe,",
    "        'start_identity': identity,",
    "        '_key': (pid, identity),",
    "    }",
    "def child_snapshot(parent):",
    "    rows = {}",
    "    for entry in os.scandir('/proc'):",
    "        if not entry.name.isdigit():",
    "            continue",
    "        row = parse_row(int(entry.name))",
    "        if row is None or row['parent_pid'] != parent:",
    "            continue",
    "        rows[row['_key']] = row",
    "    return rows",
    "def diff_events(previous, current, t_ms):",
    "    events = []",
    "    for key, row in previous.items():",
    "        if key not in current:",
    "            events.append({'t_ms': t_ms, 'kind': 'exited', 'process': row})",
    "    for key, row in current.items():",
    "        if key not in previous:",
    "            events.append({'t_ms': t_ms, 'kind': 'started', 'process': row})",
    "    return events",
    "def public_row(row):",
    "    return {",
    "        'pid': row['pid'],",
    "        'parent_pid': row['parent_pid'],",
    "        'executable_name': row['executable_name'],",
    "        'start_identity': row['start_identity'],",
    "    }",
    "probe_events = []",
    "stop_probe = threading.Event()",
    "def probe_loop():",
    "    started = time.monotonic()",
    "    deadline = started + duration_ms / 1000.0",
    "    previous = child_snapshot(parent_pid)",
    "    while time.monotonic() < deadline and not stop_probe.is_set():",
    "        time.sleep(interval_ms / 1000.0)",
    "        t_ms = int((time.monotonic() - started) * 1000)",
    "        current = child_snapshot(parent_pid)",
    "        for event in diff_events(previous, current, t_ms):",
    "            if len(probe_events) < max_events:",
    "                probe_events.append(event)",
    "        previous = current",
    "thread = threading.Thread(target=probe_loop, daemon=True)",
    "thread.start()",
    "cu_proc = subprocess.Popen(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-watch', '--parent', str(parent_pid),",
    "     '--duration-ms', str(duration_ms),",
    "     '--interval-ms', str(interval_ms),",
    "     '--max-events', str(max_events),",
    "     '--max-processes', str(max_processes)],",
    "    cwd=run_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)",
    "time.sleep(0.15)",
    "child = subprocess.Popen(['sleep', '300'], cwd=run_dir)",
    "child_pid = child.pid",
    "time.sleep(0.25)",
    "child.terminate()",
    "try:",
    "    child.wait(timeout=3)",
    "except subprocess.TimeoutExpired:",
    "    child.kill()",
    "    child.wait(timeout=3)",
    "cu_stdout, cu_stderr = cu_proc.communicate(timeout=duration_ms / 1000 + 10)",
    "stop_probe.set()",
    "thread.join(timeout=2)",
    "if cu_proc.returncode != 0:",
    "    raise SystemExit('cu_linux_process_watch_parent_cli:' + cu_stderr + cu_stdout)",
    "reply = json.loads(cu_stdout)",
    "if not reply.get('ok') or reply.get('command') != 'process-watch':",
    "    raise SystemExit('cu_linux_process_watch_parent_reply')",
    "data = reply['data']",
    "if data.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_watch_parent_verified')",
    "cu_events = data.get('events') or []",
    "cu_child = [event for event in cu_events if int(event['process']['pid']) == child_pid]",
    "probe_child = [event for event in probe_events if int(event['process']['pid']) == child_pid]",
    "if not any(event['kind'] == 'started' for event in cu_child):",
    "    raise SystemExit('cu_linux_process_watch_parent_cu_started')",
    "if not any(event['kind'] == 'exited' for event in cu_child):",
    "    raise SystemExit('cu_linux_process_watch_parent_cu_exited')",
    "if not any(event['kind'] == 'started' for event in probe_child):",
    "    raise SystemExit('cu_linux_process_watch_parent_probe_started')",
    "if not any(event['kind'] == 'exited' for event in probe_child):",
    "    raise SystemExit('cu_linux_process_watch_parent_probe_exited')",
    "def event_identity(event):",
    "    return (int(event['process']['pid']), event['process']['start_identity'])",
    "cu_started = next(event for event in cu_child if event['kind'] == 'started')",
    "cu_exited = next(event for event in cu_child if event['kind'] == 'exited')",
    "probe_started = next(event for event in probe_child if event['kind'] == 'started')",
    "probe_exited = next(event for event in probe_child if event['kind'] == 'exited')",
    "if event_identity(cu_started) != event_identity(probe_started):",
    "    raise SystemExit('cu_linux_process_watch_parent_started_identity')",
    "if event_identity(cu_exited) != event_identity(probe_exited):",
    "    raise SystemExit('cu_linux_process_watch_parent_exited_identity')",
    "if cu_started['process']['executable_name'] != probe_started['process']['executable_name']:",
    "    raise SystemExit('cu_linux_process_watch_parent_executable_name')",
    "baseline_keys = {(int(row['pid']), row['start_identity']) for row in data.get('baseline') or []}",
    "initial_probe = child_snapshot(parent_pid)",
    "for key, row in initial_probe.items():",
    "    if key[0] == child_pid:",
    "        continue",
    "    if key not in baseline_keys:",
    "        raise SystemExit('cu_linux_process_watch_parent_baseline_missing')",
    "print('parent', parent_pid, 'child', child_pid)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, executable, run_directory], {
    cwd: run_directory,
    env: env,
    timeout_ms: 120000,
  });
  ensure(output.success === true, "cu_linux_process_watch_parent:" + output.stderr + output.stdout);
}

function verify_pid_exit_watch(run_directory, executable, env) {
  const script = [
    "import json, os, subprocess, sys, threading, time",
    "cu = sys.argv[1]",
    "run_dir = sys.argv[2]",
    "duration_ms = 8000",
    "interval_ms = 40",
    "max_events = 4",
    "def parse_row(pid):",
    "    try:",
    "        stat = open(f'/proc/{pid}/stat').read()",
    "    except OSError:",
    "        return None",
    "    close = stat.rfind(')')",
    "    if close < 0:",
    "        return None",
    "    fields = stat[close + 2:].split()",
    "    if len(fields) < 20:",
    "        return None",
    "    state = fields[0]",
    "    if state in ('Z', 'X', 'x'):",
    "        return None",
    "    start_ticks = fields[19]",
    "    try:",
    "        exe = os.path.basename(os.readlink(f'/proc/{pid}/exe'))",
    "    except OSError:",
    "        return None",
    "    identity = f'proc-start-ticks:{start_ticks}'",
    "    return {",
    "        'pid': pid,",
    "        'parent_pid': int(fields[1]),",
    "        'executable_name': exe,",
    "        'start_identity': identity,",
    "    }",
    "child = subprocess.Popen(['sleep', '2'], cwd=run_dir)",
    "child_pid = child.pid",
    "row = parse_row(child_pid)",
    "if row is None:",
    "    raise SystemExit('cu_linux_process_watch_pid_baseline_missing')",
    "probe_events = []",
    "stop_probe = threading.Event()",
    "def probe_loop():",
    "    started = time.monotonic()",
    "    deadline = started + duration_ms / 1000.0",
    "    seen_live = row is not None",
    "    while time.monotonic() < deadline and not stop_probe.is_set():",
    "        time.sleep(interval_ms / 1000.0)",
    "        t_ms = int((time.monotonic() - started) * 1000)",
    "        current = parse_row(child_pid)",
    "        if seen_live and current is None:",
    "            probe_events.append({'t_ms': t_ms, 'kind': 'exited', 'process': row})",
    "            break",
    "        if current is not None:",
    "            seen_live = True",
    "thread = threading.Thread(target=probe_loop, daemon=True)",
    "thread.start()",
    "cu_proc = subprocess.Popen(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-watch', '--pid', str(child_pid),",
    "     '--duration-ms', str(duration_ms),",
    "     '--interval-ms', str(interval_ms),",
    "     '--max-events', str(max_events), '--max-processes', '4'],",
    "    cwd=run_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)",
    "cu_stdout, cu_stderr = cu_proc.communicate(timeout=duration_ms / 1000 + 10)",
    "stop_probe.set()",
    "thread.join(timeout=2)",
    "try:",
    "    child.wait(timeout=3)",
    "except subprocess.TimeoutExpired:",
    "    child.kill()",
    "    child.wait(timeout=3)",
    "if cu_proc.returncode != 0:",
    "    raise SystemExit('cu_linux_process_watch_pid_cli:' + cu_stderr + cu_stdout)",
    "reply = json.loads(cu_stdout)",
    "if not reply.get('ok') or reply.get('command') != 'process-watch':",
    "    raise SystemExit('cu_linux_process_watch_pid_reply')",
    "data = reply['data']",
    "if data.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_watch_pid_verified')",
    "baseline = data.get('baseline') or []",
    "if len(baseline) != 1:",
    "    raise SystemExit('cu_linux_process_watch_pid_baseline_count')",
    "if int(baseline[0]['pid']) != child_pid:",
    "    raise SystemExit('cu_linux_process_watch_pid_baseline_pid')",
    "if baseline[0]['start_identity'] != row['start_identity']:",
    "    raise SystemExit('cu_linux_process_watch_pid_baseline_identity')",
    "cu_events = [event for event in data.get('events') or [] if event.get('kind') == 'exited']",
    "if len(cu_events) != 1:",
    "    raise SystemExit('cu_linux_process_watch_pid_cu_exited_count')",
    "if len(probe_events) != 1:",
    "    raise SystemExit('cu_linux_process_watch_pid_probe_exited_count')",
    "cu_exited = cu_events[0]",
    "probe_exited = probe_events[0]",
    "if int(cu_exited['process']['pid']) != child_pid:",
    "    raise SystemExit('cu_linux_process_watch_pid_cu_pid')",
    "if cu_exited['process']['start_identity'] != probe_exited['process']['start_identity']:",
    "    raise SystemExit('cu_linux_process_watch_pid_exited_identity')",
    "if cu_exited['process']['start_identity'] != row['start_identity']:",
    "    raise SystemExit('cu_linux_process_watch_pid_exited_identity_drift')",
    "print('pid', child_pid)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, executable, run_directory], {
    cwd: run_directory,
    env: env,
    timeout_ms: 120000,
  });
  ensure(output.success === true, "cu_linux_process_watch_pid:" + output.stderr + output.stdout);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-watch");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
try {
  print("STEP process-watch typed-fails usage when unexpected arguments are present; native --name remains executable selector");
  assert_process_watch_usage_limit(context.run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before /proc scan diff read-back");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP process-watch --parent diff matches independent /proc child add/remove read-back");
  verify_parent_watch(context.run_directory, executable, env);

  print("STEP process-watch --pid exit diff matches independent /proc disappearance read-back");
  verify_pid_exit_watch(context.run_directory, executable, env);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-watch-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux process-watch matches independent /proc scan diff read-back with typed process-watch/get-extents usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux process-watch matches independent /proc scan diff read-back with typed process-watch/get-extents host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
