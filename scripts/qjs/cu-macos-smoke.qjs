// Prove the macOS agenterm-cu default loop through libagenterm's AX backend:
// capabilities -> windows (inventory filters) -> bounded tree / query ->
// invoke -> verify / wait --expect.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
//
// Runs under --profile tool on a real macOS desktop whose Accessibility
// permission covers the process that spawns this journey. Slices 1 and 2 of
// plan/design-mcu-absorption.md: observation, then semantic actuation that
// never activates or raises the fixture (the focused window before and after
// the actuation section must be the same one). No screenshot, no coordinate
// fallback, no keystroke injection; every write is read back.
//
// The owned fixture is examples/objc/agenterm_ax_fixture.m, compiled here
// with clang and spawned as a door handle (process_spawn); its pid is
// `harness.spawned_pid(handle)`, SIGTERM ends it with exit 0, and
// `harness.wait` reaps it. A system application cannot stand in: a directly
// exec'd system app binary is killed by launch constraints, and `open -a`
// hands the process to LaunchServices, so its pid is not ours to kill.
// Every agenterm-cu call is `rh.command` (exit_code, success, stdout,
// stderr); the worker's JSON reply is parsed, never grepped.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.macos-ax-capabilities",
  "cu.macos-ax-window-identity",
  "cu.macos-ax-query",
  "cu.macos-ax-tree-bounded",
  "cu.macos-ax-tree-actions",
  "cu.macos-ax-invoke-set-value",
  "cu.macos-ax-invoke-set-checked",
  "cu.macos-ax-invoke-press",
  "cu.macos-ax-invoke-value-readback",
  "cu.macos-ax-invoke-refusals",
  "cu.macos-ax-fixture-cleanup"
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

// rh's `"" + json_null` is "" while JS's `"" + null` is "null".
function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

// Null-safe dotted-path read: a refused reply carries `data: null` while an
// accepted one carries `error: null`, and reading a property of null traps.
function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  return text_of(at(value, dotted));
}

function int_at(value, dotted) {
  return rh.int_of(at(value, dotted));
}

function flag_at(value, dotted) {
  return at(value, dotted) === true;
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function remove_directory_bounded(path) {
  if (!rh.exists(path)) { return true; }
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    rh.try_remove_dir_all(path);
    if (!rh.exists(path)) { return true; }
    harness.sleep_ms(50);
  }
  return false;
}

// One agenterm-cu call whose reply must be `ok: true`.
function run_cu_json(run_directory, executable, arguments) {
  const output = rh.command(executable, arguments, { cwd: run_directory, timeout_ms: 30000 });
  ensure(
    output.success === true,
    "cu_macos_smoke_cli_process:" + output.stdout + output.stderr
  );
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_macos_smoke_cli_empty");
  const document = JSON.parse(trimmed);
  ensure(
    flag_at(document, "ok"),
    "cu_macos_smoke_cli_reply:" + JSON.stringify(document)
  );
  return document;
}

// One agenterm-cu call whose reply is returned as parsed, ok or not.
function run_cu_reply(run_directory, executable, arguments) {
  const output = rh.command(executable, arguments, { cwd: run_directory, timeout_ms: 30000 });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_macos_smoke_cli_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function compile_fixture(run_directory, repo) {
  const source = rh.join(repo, "examples/objc/agenterm_ax_fixture.m");
  ensure(direct_file(source), "cu_macos_smoke_fixture_source_missing");
  const fixture_executable = rh.join(run_directory, "agenterm_ax_fixture");
  const compiled = rh.command(
    "clang",
    [
      "-fobjc-arc", "-framework", "Cocoa", "-Wall", "-Wextra", "-Werror",
      source, "-o", fixture_executable
    ],
    { cwd: repo, timeout_ms: 60000 }
  );
  ensure(
    compiled.success === true && direct_file(fixture_executable),
    "cu_macos_smoke_fixture_compile:" + compiled.stdout + compiled.stderr
  );
  return fixture_executable;
}

// The `windows --pid` inventory row for the fixture, or null.
function fixture_window_row(run_directory, executable, pid, title) {
  const inventory = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "windows", "--pid", "" + pid]
  );
  let row = null;
  let matches = 0;
  for (const candidate of inventory.data.windows) {
    if (int_at(candidate, "process_id") === pid && text_at(candidate, "title") === title) {
      matches = matches + 1;
      row = candidate;
    }
  }
  ensure(
    int_at(inventory, "data.matched") === matches
      && int_at(inventory, "data.returned") === matches
      && !flag_at(inventory, "data.truncated"),
    "cu_macos_smoke_windows_counts:" + JSON.stringify(inventory.data)
  );
  return matches === 1 ? row : null;
}

// The focused top-level window handle right now (0 when none is focused),
// read through the public inventory so the background invariant is checked
// with the same tool the agent would use.
function focused_window_handle(run_directory, executable) {
  const focused = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "windows", "--focused", "true", "--max", "1"]
  );
  if (int_at(focused, "data.returned") !== 1) { return 0; }
  return int_at(focused.data.windows[0], "handle");
}

// argv for one invoke: the engine has no Array.prototype.concat.
function invoke_arguments(grant, handle_text, selector, action_and_value) {
  const arguments_list = ["--target", "current", "--grant", grant, "invoke", "--window", handle_text];
  for (const item of selector) { arguments_list.push(item); }
  for (const item of action_and_value) { arguments_list.push(item); }
  return arguments_list;
}

// One authorized invoke whose reply must be ok; returns the receipt `data`.
function invoke_ok(run_directory, executable, handle_text, selector, action_and_value) {
  const reply = run_cu_json(
    run_directory,
    executable,
    invoke_arguments("actuate", handle_text, selector, action_and_value)
  );
  ensure(
    text_at(reply, "data.addressing") === "accessibility-tree"
      && text_at(reply, "data.mechanism") === "libagenterm"
      && text_at(reply, "data.backend") === "ax",
    "cu_macos_smoke_invoke_shape:" + JSON.stringify(reply.data)
  );
  return reply.data;
}

// One invoke whose reply must be a typed refusal with `code`.
function invoke_refused(run_directory, executable, grant, handle_text, selector, action_and_value, code) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    invoke_arguments(grant, handle_text, selector, action_and_value)
  );
  ensure(
    !flag_at(reply, "ok") && text_at(reply, "error.code") === code,
    "cu_macos_smoke_invoke_refusal:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function verify_reply(run_directory, executable, handle_text, expect) {
  return run_cu_reply(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "verify",
      "--window", handle_text, "--expect", JSON.stringify(expect)
    ]
  );
}

function verify_ok(run_directory, executable, handle_text, expect) {
  const reply = verify_reply(run_directory, executable, handle_text, expect);
  ensure(
    flag_at(reply, "ok") && flag_at(reply, "data.verified"),
    "cu_macos_smoke_verify:" + JSON.stringify(expect) + ":" + JSON.stringify(reply)
  );
  return reply;
}

// ---- entry ----------------------------------------------------------------

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_macos_smoke_executable_missing:" + executable);
ensure(
  direct_file(rh.join(rh.parent(executable), "libagenterm.dylib")),
  "cu_macos_smoke_library_missing:" + rh.parent(executable)
);

const context = harness.new_context(repo, "cu-macos");
const run_directory = rh.join(repo, "target/cu-macos-smoke-run");
ensure(remove_directory_bounded(run_directory), "cu_macos_smoke_stale_directory_locked");
rh.create_dir_all(run_directory);

let succeeded = 0;
let failure = "";
let fixture_pid = 0;
let fixture = -1;
let fixture_reaped = false;

try {
  print("STEP capabilities declare the AX tree and query available on current");
  const version_output = rh.command(executable, ["--version"], { cwd: run_directory, timeout_ms: 30000 });
  ensure(
    version_output.success === true && version_output.stdout.trim().startsWith("agenterm-cu "),
    "cu_macos_smoke_version:" + version_output.stdout + version_output.stderr
  );
  const capabilities = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "capabilities"]
  );
  ensure(
    text_at(capabilities, "data.target") === "current"
      && text_at(capabilities, "data.mechanism") === "libagenterm"
      && text_at(capabilities, "data.capabilities.tree") === "Available"
      && text_at(capabilities, "data.verbs.tree.status") === "available"
      && text_at(capabilities, "data.verbs.query.status") === "available"
      && text_at(capabilities, "data.mapping.tree").includes("macOS AX"),
    "cu_macos_smoke_capabilities:" + JSON.stringify(capabilities.data)
  );
  // A refused observe is typed, never an empty tree.
  const refused = run_cu_reply(
    run_directory,
    executable,
    ["--target", "current", "windows"]
  );
  ensure(
    !flag_at(refused, "ok") && text_at(refused, "error.code") === "refused",
    "cu_macos_smoke_refusal:" + JSON.stringify(refused)
  );

  print("STEP compile and start the owned no-activate Cocoa AX fixture");
  const fixture_executable = compile_fixture(run_directory, repo);
  fixture = harness.start({
    program: fixture_executable,
    args: [],
    current_dir: run_directory,
    timeout_ms: 30000
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-ax-fixture-" + fixture_pid;

  print("STEP public wait and windows --pid prove PID, title and CGWindow identity");
  const window_wait = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "wait",
      "--timeout-ms", "5000", "--window-title-contains", fixture_title
    ]
  );
  ensure(flag_at(window_wait, "data.met"), "cu_macos_smoke_window_wait_not_met");
  const row = fixture_window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_macos_smoke_window_identity");
  const fixture_handle = int_at(row, "handle");
  ensure(
    fixture_handle > 0
      && int_at(row, "bounds.width") > 0
      && int_at(row, "bounds.height") > 0,
    "cu_macos_smoke_window_row:" + JSON.stringify(row)
  );
  const handle_text = "" + fixture_handle;
  // The bare verb keeps its array shape; the title filter is case-insensitive
  // and reports its counts.
  const bare = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "windows"]
  );
  ensure(rh.is_array(bare.data), "cu_macos_smoke_windows_bare_shape");
  const by_title = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "windows",
      "--title", "AGENTERM-AX-FIXTURE-" + fixture_pid, "--max", "1"
    ]
  );
  ensure(
    int_at(by_title, "data.matched") === 1
      && int_at(by_title, "data.returned") === 1
      && int_at(by_title.data.windows[0], "handle") === fixture_handle,
    "cu_macos_smoke_windows_title_filter:" + JSON.stringify(by_title.data)
  );

  print("STEP query by role, identifier and exact text hits the fixture controls");
  const by_role = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "query",
      "--window", handle_text, "--role", "AXTextArea"
    ]
  );
  ensure(
    text_at(by_role, "data.backend") === "ax"
      && text_at(by_role, "data.addressing") === "accessibility-tree"
      && text_at(by_role, "data.mechanism") === "libagenterm"
      && int_at(by_role, "data.visited") > 1
      && int_at(by_role, "data.matched") >= 1
      && int_at(by_role, "data.returned") === int_at(by_role, "data.matched")
      && !flag_at(by_role, "data.truncated"),
    "cu_macos_smoke_query_role:" + JSON.stringify(by_role.data)
  );
  let seeded_text_matches = 0;
  let text_area_id = "";
  for (const node of by_role.data.nodes) {
    ensure(text_at(node, "role") === "text-area", "cu_macos_smoke_query_role_leak:" + JSON.stringify(node));
    if (text_at(node, "text") === "345AXTREE"
        && text_at(node, "identifier") === "fixture-text"
        && rh.has_item(node.states, "showing")) {
      seeded_text_matches = seeded_text_matches + 1;
      text_area_id = text_at(node, "id");
    }
  }
  ensure(seeded_text_matches === 1, "cu_macos_smoke_query_seeded_text:" + JSON.stringify(by_role.data.nodes));
  const by_identifier = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "query",
      "--window", handle_text, "--identifier", "fixture-press", "--actionable"
    ]
  );
  ensure(
    int_at(by_identifier, "data.matched") === 1
      && text_at(by_identifier.data.nodes[0], "role") === "button"
      && text_at(by_identifier.data.nodes[0], "name") === "Fixture Press"
      && rh.has_item(by_identifier.data.nodes[0].actions, "click"),
    "cu_macos_smoke_query_identifier:" + JSON.stringify(by_identifier.data)
  );
  const by_exact = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "query",
      "--window", handle_text, "--text-exact", "345AXTREE"
    ]
  );
  ensure(
    int_at(by_exact, "data.matched") === 1
      && text_at(by_exact.data.nodes[0], "id") === text_area_id,
    "cu_macos_smoke_query_text_exact:" + JSON.stringify(by_exact.data)
  );
  // A closed CLI shape: an unknown flag fails before any tree is read.
  const bogus = run_cu_reply(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "query", "--window", handle_text, "--bogus"]
  );
  ensure(
    !flag_at(bogus, "ok") && text_at(bogus, "error.code") === "usage",
    "cu_macos_smoke_query_unknown_flag:" + JSON.stringify(bogus)
  );

  print("STEP tree --max-nodes 5 and --depth 0 report truncated; --flat numbers the walk");
  const bounded = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "tree",
      "--window", handle_text, "--max-nodes", "5"
    ]
  );
  ensure(
    text_at(bounded, "data.backend") === "ax"
      && flag_at(bounded, "data.truncated")
      && int_at(bounded, "data.returned") === 5
      && int_at(bounded, "data.visited") === 5
      && bounded.data.nodes.length === 5
      && int_at(bounded, "data.budget.max_nodes") === 5,
    "cu_macos_smoke_tree_max_nodes:" + JSON.stringify(bounded.data)
  );
  const root_only = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "tree",
      "--window", handle_text, "--depth", "0", "--flat"
    ]
  );
  ensure(
    flag_at(root_only, "data.truncated")
      && flag_at(root_only, "data.flat")
      && int_at(root_only, "data.returned") === 1
      && int_at(root_only.data.nodes[0], "index") === 0
      && int_at(root_only.data.nodes[0], "depth") === 0
      && text_at(root_only.data.nodes[0], "role") === "window"
      && text_at(root_only.data.nodes[0], "name") === fixture_title,
    "cu_macos_smoke_tree_depth_zero:" + JSON.stringify(root_only.data)
  );
  const too_deep = run_cu_reply(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "tree",
      "--window", handle_text, "--max-nodes", "0"
    ]
  );
  ensure(
    !flag_at(too_deep, "ok") && text_at(too_deep, "error.code") === "invalid_input",
    "cu_macos_smoke_tree_budget_bounds:" + JSON.stringify(too_deep)
  );

  print("STEP full tree reports truncated false and AX action names on its controls");
  const full = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "tree", "--window", handle_text, "--flat"]
  );
  ensure(
    text_at(full, "data.backend") === "ax"
      && !flag_at(full, "data.degraded")
      && !flag_at(full, "data.truncated")
      && int_at(full, "data.returned") === full.data.nodes.length
      && int_at(full, "data.visited") === full.data.nodes.length
      && full.data.nodes.length > 5,
    "cu_macos_smoke_tree_full:" + JSON.stringify(full.data)
  );
  let nodes_with_actions = 0;
  let press_button_matches = 0;
  let text_area_matches = 0;
  let expected_index = 0;
  for (const node of full.data.nodes) {
    ensure(int_at(node, "index") === expected_index, "cu_macos_smoke_flat_index_order");
    expected_index = expected_index + 1;
    if (node.actions.length > 0) { nodes_with_actions = nodes_with_actions + 1; }
    if (text_at(node, "role") === "button" && text_at(node, "name") === "Fixture Press"
        && rh.has_item(node.actions, "click")) {
      press_button_matches = press_button_matches + 1;
    }
    if (text_at(node, "id") === text_area_id && text_at(node, "role") === "text-area") {
      text_area_matches = text_area_matches + 1;
    }
  }
  ensure(
    nodes_with_actions >= 1 && press_button_matches === 1 && text_area_matches === 1,
    "cu_macos_smoke_tree_actions:actions=" + nodes_with_actions
      + ":press=" + press_button_matches + ":text=" + text_area_matches
  );

  // ---- slice 2: actuation, read back through the same tree -------------
  const focused_before = focused_window_handle(run_directory, executable);

  print("STEP invoke set-value writes the text field and verify --expect reads it back");
  const set_value = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-field"], ["set-value", "written by cu"]
  );
  ensure(
    text_at(set_value, "action") === "set-value"
      && flag_at(set_value, "performed")
      && flag_at(set_value, "verified")
      && text_at(set_value, "verification.method") === "value-readback"
      && text_at(set_value, "node.role") === "text-field"
      && text_at(set_value, "node.identifier") === "fixture-field"
      && text_at(set_value, "before.text") === "seed"
      && text_at(set_value, "after.text") === "written by cu",
    "cu_macos_smoke_invoke_set_value:" + JSON.stringify(set_value)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-field", value: "written by cu" },
    { identifier: "fixture-text", role: "AXTextArea", value: "345AXTREE" }
  ]);
  const mismatch = verify_reply(run_directory, executable, handle_text, [
    { identifier: "fixture-field", value: "seed" }
  ]);
  ensure(
    !flag_at(mismatch, "ok") && text_at(mismatch, "error.code") === "unverified"
      && text_at(mismatch.error.detail.observation.results[0], "node.text") === "written by cu",
    "cu_macos_smoke_verify_mismatch:" + JSON.stringify(mismatch)
  );
  // A state the node does not expose fails closed, never "probably fine".
  const unobservable = verify_reply(run_directory, executable, handle_text, [
    { identifier: "fixture-field", checked: true }
  ]);
  ensure(
    !flag_at(unobservable, "ok") && text_at(unobservable, "error.code") === "unsupported"
      && text_at(unobservable, "error.detail.reason") === "state_unobservable",
    "cu_macos_smoke_verify_unobservable:" + JSON.stringify(unobservable)
  );
  const misspelled = run_cu_reply(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "verify", "--window", handle_text,
      "--expect", "[{\"identifier\":\"fixture-field\",\"cheked\":true}]"
    ]
  );
  ensure(
    !flag_at(misspelled, "ok") && text_at(misspelled, "error.code") === "usage",
    "cu_macos_smoke_verify_unknown_key:" + JSON.stringify(misspelled)
  );

  print("STEP invoke set-checked true twice: the first presses, the second is a verified no-op");
  const checked_first = invoke_ok(
    run_directory, executable, handle_text,
    ["--name", "Fixture Check", "--role", "AXCheckBox"], ["set-checked", "true"]
  );
  ensure(
    flag_at(checked_first, "performed")
      && flag_at(checked_first, "verified")
      && text_at(checked_first, "verification.method") === "checked-readback"
      && at(checked_first, "before.checked") === false
      && at(checked_first, "after.checked") === true,
    "cu_macos_smoke_invoke_set_checked_first:" + JSON.stringify(checked_first)
  );
  const checked_again = invoke_ok(
    run_directory, executable, handle_text,
    ["--name", "Fixture Check", "--role", "AXCheckBox"], ["set-checked", "true"]
  );
  ensure(
    !flag_at(checked_again, "performed")
      && flag_at(checked_again, "verified")
      && at(checked_again, "before.checked") === true
      && at(checked_again, "after.checked") === true,
    "cu_macos_smoke_invoke_set_checked_noop:" + JSON.stringify(checked_again)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-check", checked: true }
  ]);
  const unchecked = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-check"], ["set-checked", "false"]
  );
  ensure(
    flag_at(unchecked, "performed") && flag_at(unchecked, "verified")
      && at(unchecked, "after.checked") === false,
    "cu_macos_smoke_invoke_set_checked_off:" + JSON.stringify(unchecked)
  );
  verify_ok(run_directory, executable, handle_text, [
    { name: "Fixture Check", checked: false }
  ]);

  print("STEP invoke press advances the count label; wait --expect and verify read it on another node");
  const pressed = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-press"], ["press"]
  );
  ensure(
    text_at(pressed, "action") === "press"
      && flag_at(pressed, "performed")
      && flag_at(pressed, "verified")
      && text_at(pressed, "verification.method") === "tree-diff"
      && flag_at(pressed, "tree_changed")
      && text_at(pressed, "node.name") === "Fixture Press",
    "cu_macos_smoke_invoke_press:" + JSON.stringify(pressed)
  );
  const label_wait = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "wait", "--timeout-ms", "3000",
      "--window", handle_text,
      "--expect", JSON.stringify([{ identifier: "fixture-press-count", value: "pressed 1" }])
    ]
  );
  ensure(
    flag_at(label_wait, "data.met") && flag_at(label_wait, "data.verified")
      && int_at(label_wait, "data.polls") >= 1,
    "cu_macos_smoke_wait_expect:" + JSON.stringify(label_wait.data)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-press-count", role: "AXStaticText", value: "pressed 1" }
  ]);
  const never = run_cu_reply(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "wait", "--timeout-ms", "300",
      "--window", handle_text,
      "--expect", JSON.stringify([{ identifier: "fixture-press-count", value: "pressed 99" }])
    ]
  );
  ensure(
    !flag_at(never, "ok") && text_at(never, "error.code") === "timeout"
      && text_at(never.error.detail.observation.results[0], "node.text") === "pressed 1",
    "cu_macos_smoke_wait_expect_timeout:" + JSON.stringify(never)
  );

  print("STEP invoke increment / decrement on the stepper and select-option on the pop-up read back");
  const incremented = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-stepper"], ["increment"]
  );
  ensure(
    flag_at(incremented, "verified")
      && text_at(incremented, "node.role") === "incrementor"
      && text_at(incremented, "before.text") === "3"
      && text_at(incremented, "after.text") === "4",
    "cu_macos_smoke_invoke_increment:" + JSON.stringify(incremented)
  );
  const decremented = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-stepper"], ["decrement"]
  );
  ensure(
    flag_at(decremented, "verified") && text_at(decremented, "after.text") === "3",
    "cu_macos_smoke_invoke_decrement:" + JSON.stringify(decremented)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-stepper", value: "3" }
  ]);
  const selected = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-popup"], ["select-option", "Beta"]
  );
  ensure(
    flag_at(selected, "verified")
      && text_at(selected, "node.role") === "pop-up-button"
      && text_at(selected, "before.text") === "Alpha"
      && text_at(selected, "after.text") === "Beta",
    "cu_macos_smoke_invoke_select_option:" + JSON.stringify(selected)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-popup", value: "Beta" }
  ]);
  const no_option = invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-popup"], ["select-option", "Omega"], "a11y_option_not_found"
  );
  ensure(
    text_at(no_option, "error.detail.receipt.after.text") === "Beta",
    "cu_macos_smoke_invoke_select_option_missing:" + JSON.stringify(no_option)
  );

  print("STEP ambiguous --name, missing action, unobservable state, missing target and observe-only grant are typed refusals");
  const ambiguous = invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--name", "Fixture Twin"], ["press"], "ambiguous"
  );
  ensure(int_at(ambiguous, "error.count") === 2, "cu_macos_smoke_invoke_ambiguous_count:" + JSON.stringify(ambiguous));
  const missing_action = invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-check"], ["increment"], "unsupported"
  );
  ensure(
    text_at(missing_action, "error.detail.reason") === "node_action_missing",
    "cu_macos_smoke_invoke_missing_action:" + JSON.stringify(missing_action)
  );
  const blind_state = invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-press"], ["set-checked", "true"], "unsupported"
  );
  ensure(
    text_at(blind_state, "error.detail.reason") === "state_unobservable",
    "cu_macos_smoke_invoke_blind_state:" + JSON.stringify(blind_state)
  );
  invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-nowhere"], ["press"], "a11y_node_not_found"
  );
  invoke_refused(
    run_directory, executable, "observe", handle_text,
    ["--identifier", "fixture-press"], ["press"], "refused"
  );
  invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-press"], ["raise"], "usage"
  );
  invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-check"], ["set-checked", "maybe"], "invalid_input"
  );
  // The refusals and the whole actuation section changed nothing outside the
  // fixture: the count label still says exactly one press, and the focused
  // window is the same one as before the section (the fixture never took it).
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-press-count", value: "pressed 1" }
  ]);
  const focused_after = focused_window_handle(run_directory, executable);
  ensure(
    focused_after === focused_before && focused_after !== fixture_handle,
    "cu_macos_smoke_foreground_stolen:before=" + focused_before + ":after=" + focused_after
      + ":fixture=" + fixture_handle
  );

  print("STEP SIGTERM ends only the owned fixture, which exits 0 and is reaped");
  const terminated = rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  ensure(terminated.success === true, "cu_macos_smoke_fixture_terminate:" + terminated.stderr);
  let fixture_exited = 0;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    if (harness.state(fixture) === "exited") {
      fixture_exited = 1;
      break;
    }
    harness.sleep_ms(25);
  }
  ensure(fixture_exited !== 0, "cu_macos_smoke_fixture_exit_timeout");
  const fixture_output = harness.wait(fixture, 2000);
  fixture_reaped = true;
  ensure(
    fixture_output.success === true && fixture_output.exit_code === 0,
    "cu_macos_smoke_fixture_exit:" + JSON.stringify(fixture_output)
  );
  const ready_parts = fixture_output.stdout.trim().split(" ");
  ensure(
    ready_parts.length === 2 && ready_parts[0] === "ready"
      && rh.parse_int("" + ready_parts[1]) === fixture_pid,
    "cu_macos_smoke_fixture_ready:" + fixture_output.stdout
  );
  ensure(harness.process_present(fixture_pid) === 0, "cu_macos_smoke_fixture_orphan");
  const gone = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "windows", "--pid", "" + fixture_pid]
  );
  ensure(int_at(gone, "data.matched") === 0, "cu_macos_smoke_fixture_window_lingers");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture >= 0 && !fixture_reaped) {
  // Only the pid this run spawned; never a name pattern.
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  let reaped = false;
  try {
    const output = harness.wait(fixture, 3000);
    reaped = output !== null;
  } catch (wait_error) {
    reaped = false;
  }
  if (!reaped && fixture_pid !== 0) {
    rh.command("kill", ["-KILL", "" + fixture_pid], { timeout_ms: 5000 });
    try { harness.wait(fixture, 3000); } catch (kill_error) { failure = failure + ":cu_macos_smoke_fixture_unreaped"; }
  }
}

if (succeeded === 0) {
  if (!remove_directory_bounded(run_directory)) {
    failure = failure + ":cu_macos_smoke_cleanup_locked";
  }
  harness.remove_run(context);
  throw failure;
}

ensure(remove_directory_bounded(run_directory), "cu_macos_smoke_cleanup_locked");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-capabilities");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-window-identity");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-query");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-tree-bounded");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-tree-actions");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-invoke-set-value");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-invoke-set-checked");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-invoke-press");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-invoke-value-readback");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-invoke-refusals");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-fixture-cleanup");
harness.remove_run(context);
print("PASS: agenterm-cu macOS AX journey (capabilities, windows, query, bounded tree, invoke, verify)");
return;
