// Prove the macOS agenterm-cu default loop through libagenterm's AX backend:
// capabilities -> windows (inventory filters) -> bounded tree / query ->
// invoke -> verify / wait --expect, then the background verbs: menu inspect
// / invoke on the application's menu bar, focused / invoke --focused on its
// App-local focused control, and observe (poll-diff event stream); then
// slice 4: click by --node / --name with the real pointer read before and
// after, the window-place `frame` transaction, the destructive `close`
// gate (exact target + prior snapshot + checkable postcondition, refused
// typed when any part is missing) on the fixture's second window, and the
// crash-persistent receipt file read back with `receipts`; then slice 5:
// the node-level text and geometry verbs Linux and Windows already carried
// (`get-extents`, `select` / `get-selection`, `set-caret` / `get-caret`)
// now live on AX, plus the typed `scroll` refusal that names the actions
// the node does offer, and `send-keys` as the AX action a chord means
// (`enter` is `AXConfirm`) with a typed refusal for every chord that has
// no AX equivalent -- macOS delivers a keystroke only to the active
// application, and this journey never activates one.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
//
// Runs under --profile tool on a real macOS desktop whose Accessibility
// permission covers the process that spawns this journey. Slices 1 to 4
// of plan/design-mcu-absorption.md: observation, semantic actuation,
// background menus / focused control / observation, then the destructive
// gate and receipts, none of which activates or raises the fixture (the
// focused window before and after each actuating section must be the same
// one) or moves the real pointer (pointer-position is read around every
// click and close). No screenshot, no coordinate fallback, no keystroke
// injection; every write is read back. The observer for `observe` is a
// second agenterm-cu spawned through the door (harness.start) so the script
// can issue the change it must capture while the observer runs. Every cu
// call runs with AGENTERM_CU_AUDIT_PATH inside the run directory, so the
// audit log and the receipt file (<audit dir>/cu-receipts/current.jsonl)
// are this run's own.
//
// The owned fixture is examples/objc/agenterm_ax_fixture.m, compiled here
// with clang and spawned as a door handle (process_spawn); its pid is
// `harness.spawned_pid(handle)`, SIGTERM ends it with exit 0, and
// `harness.wait` reaps it. A system application cannot stand in: a directly
// exec'd system app binary is killed by launch constraints, and `open -a`
// hands the process to LaunchServices, so its pid is not ours to kill.
// Every agenterm-cu call is `rh.command` (exit_code, success, stdout,
// stderr); the worker's JSON reply is parsed, never grepped.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.macos-ax-capabilities",
  "cu.macos-ax-window-identity",
  "cu.macos-ax-query",
  "cu.macos-ax-tree-bounded",
  "cu.macos-ax-tree-actions",
  "cu.macos-ax-invoke-set-value",
  "cu.macos-ax-invoke-set-checked",
  "cu.macos-ax-invoke-press",
  "cu.macos-ax-invoke-value-readback",
  "cu.macos-ax-invoke-refusals",
  "cu.macos-ax-menu-inspect",
  "cu.macos-ax-menu-invoke",
  "cu.macos-ax-focused",
  "cu.macos-ax-observe",
  "cu.macos-ax-observe-notifications",
  "cu.macos-ax-click",
  "cu.macos-ax-screenshot",
  "cu.macos-ax-frame",
  "cu.macos-ax-destructive-refusals",
  "cu.macos-ax-destructive-close",
  "cu.macos-ax-receipts",
  "cu.macos-ax-node-text-geometry",
  "cu.macos-ax-send-keys",
  "cu.macos-ax-mcu-actions",
  "cu.macos-ax-stacking",
  "cu.macos-ax-orderwin",
  "cu.macos-ax-app-lifecycle",
  "cu.macos-ax-app-inventory",
  "cu.macos-process-state",
  "cu.macos-process-usage",
  "cu.macos-process-wait",
  "cu.macos-ax-snapshot-diff",
  "cu.macos-ax-hit-zoom",
  "cu.macos-ax-window-state",
  "cu.macos-ax-raise",
  "cu.macos-ax-fixture-cleanup"
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

// rh's `"" + json_null` is "" while JS's `"" + null` is "null".
function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

// Null-safe dotted-path read: a refused reply carries `data: null` while an
// accepted one carries `error: null`, and reading a property of null traps.
function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  return text_of(at(value, dotted));
}

function int_at(value, dotted) {
  return rh.int_of(at(value, dotted));
}

function flag_at(value, dotted) {
  return at(value, dotted) === true;
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function remove_directory_bounded(path) {
  if (!rh.exists(path)) { return true; }
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    rh.try_remove_dir_all(path);
    if (!rh.exists(path)) { return true; }
    harness.sleep_ms(50);
  }
  return false;
}

// The audit log (and beside it the receipt file) of this run, never the
// user's default location.
function cu_env(run_directory) {
  return { AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl") };
}

function receipt_file(run_directory) {
  return rh.join(run_directory, "cu-receipts/current.jsonl");
}

// One agenterm-cu call whose reply must be `ok: true`.
function run_cu_json(run_directory, executable, arguments) {
  const output = rh.command(
    executable, arguments,
    { cwd: run_directory, env: cu_env(run_directory), timeout_ms: 30000 }
  );
  ensure(
    output.success === true,
    "cu_macos_smoke_cli_process:" + output.stdout + output.stderr
  );
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_macos_smoke_cli_empty");
  const document = JSON.parse(trimmed);
  ensure(
    flag_at(document, "ok"),
    "cu_macos_smoke_cli_reply:" + JSON.stringify(document)
  );
  return document;
}

// The text of one fixture node, by AX identifier (which is also its name).
function node_text(run_directory, executable, handle_text, identifier) {
  const reply = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "get-text",
    "--window", handle_text, "--name", identifier
  ]);
  return text_at(reply, "data.text");
}

// One agenterm-cu call whose reply is returned as parsed, ok or not.
function run_cu_reply(run_directory, executable, arguments) {
  const output = rh.command(
    executable, arguments,
    { cwd: run_directory, env: cu_env(run_directory), timeout_ms: 30000 }
  );
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_macos_smoke_cli_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

// Wrap the compiled fixture in a real `.app` bundle, so `app launch` has
// something to start that this run owns. A bundle is what LaunchServices
// opens; a bare executable is not.
function bundle_fixture(run_directory, fixture_executable) {
  const bundle = rh.join(run_directory, "AgentermFixture.app");
  const macos = rh.join(bundle, "Contents/MacOS");
  rh.create_dir_all(macos);
  const inner = rh.join(macos, "AgentermFixture");
  rh.copy(fixture_executable, inner);
  // The copy does not necessarily carry the executable bit, and a bundle
  // whose binary cannot be executed fails to launch in a way that looks
  // like a bug in `app launch` rather than in this helper.
  const marked = rh.command("chmod", ["+x", inner], { timeout_ms: 5000 });
  ensure(marked.success === true, "cu_macos_smoke_bundle_chmod:" + marked.stderr);
  rh.write_text(rh.join(bundle, "Contents/Info.plist"),
    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
    + "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
    + "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
    + "<plist version=\"1.0\"><dict>"
    + "<key>CFBundleName</key><string>AgentermFixture</string>"
    + "<key>CFBundleExecutable</key><string>AgentermFixture</string>"
    + "<key>CFBundleIdentifier</key><string>dev.agenterm.fixture</string>"
    + "<key>CFBundlePackageType</key><string>APPL</string>"
    // Accessory policy, so launching it never takes the foreground.
    + "<key>LSUIElement</key><true/>"
    + "</dict></plist>\n");
  return bundle;
}

function compile_fixture(run_directory, repo) {
  const source = rh.join(repo, "examples/objc/agenterm_ax_fixture.m");
  ensure(direct_file(source), "cu_macos_smoke_fixture_source_missing");
  const fixture_executable = rh.join(run_directory, "agenterm_ax_fixture");
  const compiled = rh.command(
    "clang",
    [
      "-fobjc-arc", "-framework", "Cocoa", "-Wall", "-Wextra", "-Werror",
      source, "-o", fixture_executable
    ],
    { cwd: repo, timeout_ms: 60000 }
  );
  ensure(
    compiled.success === true && direct_file(fixture_executable),
    "cu_macos_smoke_fixture_compile:" + compiled.stdout + compiled.stderr
  );
  return fixture_executable;
}

// The `windows --pid` inventory row of the fixture window with exactly
// `title`, or null. The fixture owns two windows since slice 4, so the
// inventory counts are checked against every row of the pid.
function fixture_window_row(run_directory, executable, pid, title) {
  const inventory = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "windows", "--pid", "" + pid]
  );
  let row = null;
  let matches = 0;
  let rows_for_pid = 0;
  for (const candidate of inventory.data.windows) {
    if (int_at(candidate, "process_id") === pid) { rows_for_pid = rows_for_pid + 1; }
    if (int_at(candidate, "process_id") === pid && text_at(candidate, "title") === title) {
      matches = matches + 1;
      row = candidate;
    }
  }
  ensure(
    int_at(inventory, "data.matched") === rows_for_pid
      && int_at(inventory, "data.returned") === rows_for_pid
      && !flag_at(inventory, "data.truncated"),
    "cu_macos_smoke_windows_counts:" + JSON.stringify(inventory.data)
  );
  return matches === 1 ? row : null;
}

// The real pointer's coordinates as "x,y", read without injecting anything
// (macOS: a CGEvent sample). Read immediately before and after every click
// and close: PRD 31's pointer invariant.
function pointer_text(run_directory, executable) {
  const reply = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "pointer-position"]
  );
  ensure(
    text_at(reply, "data.effect") === "observed"
      && text_at(reply, "data.addressing") === "absolute-screen-coordinates"
      && reply.data.coords.length === 2,
    "cu_macos_smoke_pointer_shape:" + JSON.stringify(reply.data)
  );
  return text_of(reply.data.coords[0]) + "," + text_of(reply.data.coords[1]);
}

function close_reply(run_directory, executable, grant, extra) {
  const arguments_list = ["--target", "current", "--grant", grant, "close"];
  for (const item of extra) { arguments_list.push(item); }
  return run_cu_reply(run_directory, executable, arguments_list);
}

// A `close` that must be refused typed with `code` before anything happens.
function close_refused(run_directory, executable, grant, extra, code) {
  const reply = close_reply(run_directory, executable, grant, extra);
  ensure(
    !flag_at(reply, "ok") && text_at(reply, "error.code") === code,
    "cu_macos_smoke_close_refusal:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function receipts_reply(run_directory, executable, extra) {
  const arguments_list = ["--target", "current", "--grant", "observe", "receipts"];
  for (const item of extra) { arguments_list.push(item); }
  return run_cu_reply(run_directory, executable, arguments_list);
}

// Every `reserved` line must be followed by its own `completed` / `failed`
// line (same receipt_id); returns the number of pairs.
function count_receipt_pairs(lines) {
  let pairs = 0;
  let index = 0;
  while (index < lines.length) {
    const reserved = lines[index];
    ensure(text_at(reserved, "phase") === "reserved", "cu_macos_smoke_receipt_order:" + JSON.stringify(reserved));
    ensure(index + 1 < lines.length, "cu_macos_smoke_receipt_unpaired:" + JSON.stringify(reserved));
    const closing = lines[index + 1];
    ensure(
      text_at(closing, "receipt_id") === text_at(reserved, "receipt_id")
        && (text_at(closing, "phase") === "completed" || text_at(closing, "phase") === "failed")
        && text_at(closing, "verb") === text_at(reserved, "verb")
        && int_at(closing, "window") === int_at(reserved, "window")
        && int_at(closing, "ts_ms") >= int_at(reserved, "ts_ms"),
      "cu_macos_smoke_receipt_pair:" + JSON.stringify(reserved) + ":" + JSON.stringify(closing)
    );
    pairs = pairs + 1;
    index = index + 2;
  }
  return pairs;
}

// The focused top-level window handle right now (0 when none is focused),
// read through the public inventory so the background invariant is checked
// with the same tool the agent would use.
function focused_window_handle(run_directory, executable) {
  const focused = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "windows", "--focused", "true", "--max", "1"]
  );
  if (int_at(focused, "data.returned") !== 1) { return 0; }
  return int_at(focused.data.windows[0], "handle");
}

// argv for one invoke.
function invoke_arguments(grant, handle_text, selector, action_and_value) {
  const prefix = ["--target", "current", "--grant", grant, "invoke", "--window", handle_text];
  return prefix.concat(selector, action_and_value);
}

// One authorized invoke whose reply must be ok; returns the receipt `data`.
function invoke_ok(run_directory, executable, handle_text, selector, action_and_value) {
  const reply = run_cu_json(
    run_directory,
    executable,
    invoke_arguments("actuate", handle_text, selector, action_and_value)
  );
  ensure(
    text_at(reply, "data.addressing") === "accessibility-tree"
      && text_at(reply, "data.mechanism") === "libagenterm"
      && text_at(reply, "data.backend") === "ax",
    "cu_macos_smoke_invoke_shape:" + JSON.stringify(reply.data)
  );
  return reply.data;
}

// One invoke whose reply must be a typed refusal with `code`.
function invoke_refused(run_directory, executable, grant, handle_text, selector, action_and_value, code) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    invoke_arguments(grant, handle_text, selector, action_and_value)
  );
  ensure(
    !flag_at(reply, "ok") && text_at(reply, "error.code") === code,
    "cu_macos_smoke_invoke_refusal:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function verify_reply(run_directory, executable, handle_text, expect) {
  return run_cu_reply(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "verify",
      "--window", handle_text, "--expect", JSON.stringify(expect)
    ]
  );
}

// `File/Do Thing` from an item's path array.
function path_text(item) {
  const segments = [];
  for (const segment of item.path) { segments.push(text_of(segment)); }
  return segments.join("/");
}

function menu_inspect(run_directory, executable, handle_text, extra) {
  const arguments_list = ["--target", "current", "--grant", "observe", "menu", "inspect", "--window", handle_text];
  for (const item of extra) { arguments_list.push(item); }
  return run_cu_json(run_directory, executable, arguments_list);
}

function menu_invoke_reply(run_directory, executable, grant, handle_text, path) {
  return run_cu_reply(
    run_directory,
    executable,
    ["--target", "current", "--grant", grant, "menu", "invoke", "--window", handle_text, "--path", path]
  );
}

function menu_invoke_refused(run_directory, executable, grant, handle_text, path, code) {
  const reply = menu_invoke_reply(run_directory, executable, grant, handle_text, path);
  ensure(
    !flag_at(reply, "ok") && text_at(reply, "error.code") === code,
    "cu_macos_smoke_menu_refusal:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function focused_reply(run_directory, executable, handle_text, extra) {
  const arguments_list = ["--target", "current", "--grant", "observe", "focused", "--window", handle_text];
  for (const item of extra) { arguments_list.push(item); }
  return run_cu_reply(run_directory, executable, arguments_list);
}

// Spawn an `observe` worker through the door; the caller changes the tree
// while it runs and reaps it with `harness.wait` to read its one JSON reply.
function start_observer(run_directory, executable, handle_text, extra) {
  const arguments_list = ["--target", "current", "--grant", "observe", "observe", "--window", handle_text];
  for (const item of extra) { arguments_list.push(item); }
  return harness.start({
    program: executable,
    args: arguments_list,
    current_dir: run_directory,
    env: cu_env(run_directory),
    timeout_ms: 30000
  });
}

function observer_result(handle) {
  const output = harness.wait(handle, 15000);
  ensure(output.success === true, "cu_macos_smoke_observer_process:" + JSON.stringify(output));
  const document = JSON.parse(output.stdout.trim());
  ensure(flag_at(document, "ok"), "cu_macos_smoke_observer_reply:" + JSON.stringify(document));
  return document.data;
}

function verify_ok(run_directory, executable, handle_text, expect) {
  const reply = verify_reply(run_directory, executable, handle_text, expect);
  ensure(
    flag_at(reply, "ok") && flag_at(reply, "data.verified"),
    "cu_macos_smoke_verify:" + JSON.stringify(expect) + ":" + JSON.stringify(reply)
  );
  return reply;
}

// ---- entry ----------------------------------------------------------------

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_macos_smoke_executable_missing:" + executable);
ensure(
  direct_file(rh.join(rh.parent(executable), "libagenterm.dylib")),
  "cu_macos_smoke_library_missing:" + rh.parent(executable)
);

const context = harness.new_context(repo, "cu-macos");
const run_directory = rh.join(repo, "target/cu-macos-smoke-run");
ensure(remove_directory_bounded(run_directory), "cu_macos_smoke_stale_directory_locked");
rh.create_dir_all(run_directory);

let succeeded = 0;
let failure = "";
let fixture_pid = 0;
let fixture = -1;
let fixture_reaped = false;

try {
  print("STEP capabilities declare the AX tree and query available on current");
  const version_output = rh.command(executable, ["--version"], { cwd: run_directory, timeout_ms: 30000 });
  ensure(
    version_output.success === true && version_output.stdout.trim().startsWith("agenterm-cu "),
    "cu_macos_smoke_version:" + version_output.stdout + version_output.stderr
  );
  const capabilities = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "capabilities"]
  );
  ensure(
    text_at(capabilities, "data.target") === "current"
      && text_at(capabilities, "data.mechanism") === "libagenterm"
      && text_at(capabilities, "data.capabilities.tree") === "Available"
      && text_at(capabilities, "data.verbs.tree.status") === "available"
      && text_at(capabilities, "data.verbs.query.status") === "available"
      && text_at(capabilities, "data.verbs.process-state.status") === "available"
      && text_at(capabilities, "data.verbs.process-usage.status") === "available"
      && text_at(capabilities, "data.mapping.tree").includes("macOS AX"),
    "cu_macos_smoke_capabilities:" + JSON.stringify(capabilities.data)
  );
  // One place to look for "what am I not allowed to do, and how is that
  // fixed". The wizard stays in MCU, but the reporting has to be complete:
  // the same Accessibility grant that gates the tree also gates every
  // input verb, and a caller should not have to know that to find it.
  ensure(
    text_at(capabilities, "data.permissions.accessibility.grant.status") === "granted"
      && capabilities.data.permissions.accessibility.gates.length > 10
      // Window capture works now, so Screen Recording really is required.
      // The report says the grant gates the verb and where to fix it; it
      // does not claim to know whether it is held, because the capture API
      // reports "no permission" and "window is gone" identically.
      && text_at(capabilities, "data.permissions.screen_recording.grant.status") === "required"
      && text_at(capabilities, "data.permissions.screen_recording.grant.repair") !== ""
      && text_at(capabilities, "data.verbs.screenshot.status") === "available",
    "cu_macos_smoke_permissions:" + JSON.stringify(capabilities.data.permissions)
  );
  let gates_input = 0;
  let gates_tree = 0;
  for (const verb of capabilities.data.permissions.accessibility.gates) {
    if (verb === "pointer-move") { gates_input = 1; }
    if (verb === "tree") { gates_tree = 1; }
  }
  ensure(
    gates_input === 1 && gates_tree === 1,
    "cu_macos_smoke_permission_gates:" + JSON.stringify(capabilities.data.permissions.accessibility.gates)
  );

  // A refused observe is typed, never an empty tree.
  const refused = run_cu_reply(
    run_directory,
    executable,
    ["--target", "current", "windows"]
  );
  ensure(
    !flag_at(refused, "ok") && text_at(refused, "error.code") === "refused",
    "cu_macos_smoke_refusal:" + JSON.stringify(refused)
  );

  print("STEP compile and start the owned no-activate Cocoa AX fixture");
  const fixture_executable = compile_fixture(run_directory, repo);
  fixture = harness.start({
    program: fixture_executable,
    args: [],
    current_dir: run_directory,
    timeout_ms: 30000
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-ax-fixture-" + fixture_pid;

  print("STEP process state and usage bind one live fixture identity");
  const process_state = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "process-state", "--pid", "" + fixture_pid]
  );
  const process_identity = text_at(process_state, "data.start_identity");
  ensure(
    text_at(process_state, "data.state") === "live"
      && flag_at(process_state, "data.verified")
      && process_identity !== "",
    "cu_macos_smoke_process_state:" + JSON.stringify(process_state)
  );
  const process_usage = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "process-usage", "--pid", "" + fixture_pid]
  );
  const cpu_time_ns = text_at(process_usage, "data.cpu_time_ns");
  const resident_bytes = text_at(process_usage, "data.resident_bytes");
  const page_faults = text_at(process_usage, "data.page_faults.total");
  ensure(
    flag_at(process_usage, "data.verified")
      && text_at(process_usage, "data.start_identity") === process_identity
      && cpu_time_ns !== "" && rh.only_chars(cpu_time_ns, rh.DIGITS)
      && resident_bytes !== "" && rh.only_chars(resident_bytes, rh.DIGITS)
      && page_faults !== "" && rh.only_chars(page_faults, rh.DIGITS),
    "cu_macos_smoke_process_usage:" + JSON.stringify(process_usage)
  );
  print("STEP process wait times out on that exact still-live fixture instead of polling a reusable pid");
  const process_wait = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "process-wait", "--pid", "" + fixture_pid,
      "--start-identity", process_identity, "--timeout-ms", "5"]
  );
  ensure(
    text_at(process_wait, "data.state") === "timeout"
      && !flag_at(process_wait, "data.completed")
      && flag_at(process_wait, "data.verified")
      && text_at(process_wait, "data.mechanism") === "native-process-reference",
    "cu_macos_smoke_process_wait:" + JSON.stringify(process_wait)
  );

  print("STEP public wait and windows --pid prove PID, title and CGWindow identity");
  const window_wait = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "wait",
      "--timeout-ms", "5000", "--window-title-contains", fixture_title
    ]
  );
  ensure(flag_at(window_wait, "data.met"), "cu_macos_smoke_window_wait_not_met");
  const row = fixture_window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_macos_smoke_window_identity");
  const fixture_handle = int_at(row, "handle");
  ensure(
    fixture_handle > 0
      && int_at(row, "bounds.width") > 0
      && int_at(row, "bounds.height") > 0,
    "cu_macos_smoke_window_row:" + JSON.stringify(row)
  );
  const handle_text = "" + fixture_handle;
  // The bare verb keeps its array shape; the title filter is case-insensitive
  // and reports its counts.
  const bare = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "windows"]
  );
  ensure(rh.is_array(bare.data), "cu_macos_smoke_windows_bare_shape");
  const by_title = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "windows",
      "--title", "AGENTERM-AX-FIXTURE-" + fixture_pid, "--max", "1"
    ]
  );
  ensure(
    int_at(by_title, "data.matched") === 1
      && int_at(by_title, "data.returned") === 1
      && int_at(by_title.data.windows[0], "handle") === fixture_handle,
    "cu_macos_smoke_windows_title_filter:" + JSON.stringify(by_title.data)
  );

  print("STEP query by role, identifier and exact text hits the fixture controls");
  const by_role = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "query",
      "--window", handle_text, "--role", "AXTextArea"
    ]
  );
  ensure(
    text_at(by_role, "data.backend") === "ax"
      && text_at(by_role, "data.addressing") === "accessibility-tree"
      && text_at(by_role, "data.mechanism") === "libagenterm"
      && int_at(by_role, "data.visited") > 1
      && int_at(by_role, "data.matched") >= 1
      && int_at(by_role, "data.returned") === int_at(by_role, "data.matched")
      && !flag_at(by_role, "data.truncated"),
    "cu_macos_smoke_query_role:" + JSON.stringify(by_role.data)
  );
  let seeded_text_matches = 0;
  let text_area_id = "";
  for (const node of by_role.data.nodes) {
    ensure(text_at(node, "role") === "text-area", "cu_macos_smoke_query_role_leak:" + JSON.stringify(node));
    if (text_at(node, "text") === "345AXTREE"
        && text_at(node, "identifier") === "fixture-text"
        && rh.has_item(node.states, "showing")) {
      seeded_text_matches = seeded_text_matches + 1;
      text_area_id = text_at(node, "id");
    }
  }
  ensure(seeded_text_matches === 1, "cu_macos_smoke_query_seeded_text:" + JSON.stringify(by_role.data.nodes));
  const by_identifier = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "query",
      "--window", handle_text, "--identifier", "fixture-press", "--actionable"
    ]
  );
  ensure(
    int_at(by_identifier, "data.matched") === 1
      && text_at(by_identifier.data.nodes[0], "role") === "button"
      && text_at(by_identifier.data.nodes[0], "name") === "Fixture Press"
      && rh.has_item(by_identifier.data.nodes[0].actions, "click"),
    "cu_macos_smoke_query_identifier:" + JSON.stringify(by_identifier.data)
  );
  const by_exact = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "query",
      "--window", handle_text, "--text-exact", "345AXTREE"
    ]
  );
  ensure(
    int_at(by_exact, "data.matched") === 1
      && text_at(by_exact.data.nodes[0], "id") === text_area_id,
    "cu_macos_smoke_query_text_exact:" + JSON.stringify(by_exact.data)
  );
  // A closed CLI shape: an unknown flag fails before any tree is read.
  const bogus = run_cu_reply(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "query", "--window", handle_text, "--bogus"]
  );
  ensure(
    !flag_at(bogus, "ok") && text_at(bogus, "error.code") === "usage",
    "cu_macos_smoke_query_unknown_flag:" + JSON.stringify(bogus)
  );

  print("STEP tree --max-nodes 5 and --depth 0 report truncated; --flat numbers the walk");
  const bounded = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "tree",
      "--window", handle_text, "--max-nodes", "5"
    ]
  );
  ensure(
    text_at(bounded, "data.backend") === "ax"
      && flag_at(bounded, "data.truncated")
      && int_at(bounded, "data.returned") === 5
      && int_at(bounded, "data.visited") === 5
      && bounded.data.nodes.length === 5
      && int_at(bounded, "data.budget.max_nodes") === 5,
    "cu_macos_smoke_tree_max_nodes:" + JSON.stringify(bounded.data)
  );
  const root_only = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "tree",
      "--window", handle_text, "--depth", "0", "--flat"
    ]
  );
  ensure(
    flag_at(root_only, "data.truncated")
      && flag_at(root_only, "data.flat")
      && int_at(root_only, "data.returned") === 1
      && int_at(root_only.data.nodes[0], "index") === 0
      && int_at(root_only.data.nodes[0], "depth") === 0
      && text_at(root_only.data.nodes[0], "role") === "window"
      && text_at(root_only.data.nodes[0], "name") === fixture_title,
    "cu_macos_smoke_tree_depth_zero:" + JSON.stringify(root_only.data)
  );
  const too_deep = run_cu_reply(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "tree",
      "--window", handle_text, "--max-nodes", "0"
    ]
  );
  ensure(
    !flag_at(too_deep, "ok") && text_at(too_deep, "error.code") === "invalid_input",
    "cu_macos_smoke_tree_budget_bounds:" + JSON.stringify(too_deep)
  );

  print("STEP full tree reports truncated false and AX action names on its controls");
  const full = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "tree", "--window", handle_text, "--flat"]
  );
  ensure(
    text_at(full, "data.backend") === "ax"
      && !flag_at(full, "data.degraded")
      && !flag_at(full, "data.truncated")
      && int_at(full, "data.returned") === full.data.nodes.length
      && int_at(full, "data.visited") === full.data.nodes.length
      && full.data.nodes.length > 5,
    "cu_macos_smoke_tree_full:" + JSON.stringify(full.data)
  );
  let nodes_with_actions = 0;
  let press_button_matches = 0;
  let text_area_matches = 0;
  let expected_index = 0;
  for (const node of full.data.nodes) {
    ensure(int_at(node, "index") === expected_index, "cu_macos_smoke_flat_index_order");
    expected_index = expected_index + 1;
    if (node.actions.length > 0) { nodes_with_actions = nodes_with_actions + 1; }
    if (text_at(node, "role") === "button" && text_at(node, "name") === "Fixture Press"
        && rh.has_item(node.actions, "click")) {
      press_button_matches = press_button_matches + 1;
    }
    if (text_at(node, "id") === text_area_id && text_at(node, "role") === "text-area") {
      text_area_matches = text_area_matches + 1;
    }
  }
  ensure(
    nodes_with_actions >= 1 && press_button_matches === 1 && text_area_matches === 1,
    "cu_macos_smoke_tree_actions:actions=" + nodes_with_actions
      + ":press=" + press_button_matches + ":text=" + text_area_matches
  );

  // ---- slice 2: actuation, read back through the same tree -------------
  const focused_before = focused_window_handle(run_directory, executable);

  print("STEP invoke set-value writes the text field and verify --expect reads it back");
  const set_value = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-field"], ["set-value", "written by cu"]
  );
  ensure(
    text_at(set_value, "action") === "set-value"
      && flag_at(set_value, "performed")
      && flag_at(set_value, "verified")
      && text_at(set_value, "verification.method") === "value-readback"
      && text_at(set_value, "node.role") === "text-field"
      && text_at(set_value, "node.identifier") === "fixture-field"
      && text_at(set_value, "before.text") === "seed"
      && text_at(set_value, "after.text") === "written by cu",
    "cu_macos_smoke_invoke_set_value:" + JSON.stringify(set_value)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-field", value: "written by cu" },
    { identifier: "fixture-text", role: "AXTextArea", value: "345AXTREE" }
  ]);
  const mismatch = verify_reply(run_directory, executable, handle_text, [
    { identifier: "fixture-field", value: "seed" }
  ]);
  ensure(
    !flag_at(mismatch, "ok") && text_at(mismatch, "error.code") === "unverified"
      && text_at(mismatch.error.detail.observation.results[0], "node.text") === "written by cu",
    "cu_macos_smoke_verify_mismatch:" + JSON.stringify(mismatch)
  );
  // A state the node does not expose fails closed, never "probably fine".
  const unobservable = verify_reply(run_directory, executable, handle_text, [
    { identifier: "fixture-field", checked: true }
  ]);
  ensure(
    !flag_at(unobservable, "ok") && text_at(unobservable, "error.code") === "unsupported"
      && text_at(unobservable, "error.detail.reason") === "state_unobservable",
    "cu_macos_smoke_verify_unobservable:" + JSON.stringify(unobservable)
  );
  const misspelled = run_cu_reply(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "verify", "--window", handle_text,
      "--expect", "[{\"identifier\":\"fixture-field\",\"cheked\":true}]"
    ]
  );
  ensure(
    !flag_at(misspelled, "ok") && text_at(misspelled, "error.code") === "usage",
    "cu_macos_smoke_verify_unknown_key:" + JSON.stringify(misspelled)
  );

  print("STEP invoke set-checked true twice: the first presses, the second is a verified no-op");
  const checked_first = invoke_ok(
    run_directory, executable, handle_text,
    ["--name", "Fixture Check", "--role", "AXCheckBox"], ["set-checked", "true"]
  );
  ensure(
    flag_at(checked_first, "performed")
      && flag_at(checked_first, "verified")
      && text_at(checked_first, "verification.method") === "checked-readback"
      && at(checked_first, "before.checked") === false
      && at(checked_first, "after.checked") === true,
    "cu_macos_smoke_invoke_set_checked_first:" + JSON.stringify(checked_first)
  );
  const checked_again = invoke_ok(
    run_directory, executable, handle_text,
    ["--name", "Fixture Check", "--role", "AXCheckBox"], ["set-checked", "true"]
  );
  ensure(
    !flag_at(checked_again, "performed")
      && flag_at(checked_again, "verified")
      && at(checked_again, "before.checked") === true
      && at(checked_again, "after.checked") === true,
    "cu_macos_smoke_invoke_set_checked_noop:" + JSON.stringify(checked_again)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-check", checked: true }
  ]);
  const unchecked = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-check"], ["set-checked", "false"]
  );
  ensure(
    flag_at(unchecked, "performed") && flag_at(unchecked, "verified")
      && at(unchecked, "after.checked") === false,
    "cu_macos_smoke_invoke_set_checked_off:" + JSON.stringify(unchecked)
  );
  verify_ok(run_directory, executable, handle_text, [
    { name: "Fixture Check", checked: false }
  ]);

  print("STEP invoke press advances the count label; wait --expect and verify read it on another node");
  const pressed = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-press"], ["press"]
  );
  ensure(
    text_at(pressed, "action") === "press"
      && flag_at(pressed, "performed")
      && flag_at(pressed, "verified")
      && text_at(pressed, "verification.method") === "tree-diff"
      && flag_at(pressed, "tree_changed")
      && text_at(pressed, "node.name") === "Fixture Press",
    "cu_macos_smoke_invoke_press:" + JSON.stringify(pressed)
  );
  const label_wait = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "wait", "--timeout-ms", "3000",
      "--window", handle_text,
      "--expect", JSON.stringify([{ identifier: "fixture-press-count", value: "pressed 1" }])
    ]
  );
  ensure(
    flag_at(label_wait, "data.met") && flag_at(label_wait, "data.verified")
      && int_at(label_wait, "data.polls") >= 1,
    "cu_macos_smoke_wait_expect:" + JSON.stringify(label_wait.data)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-press-count", role: "AXStaticText", value: "pressed 1" }
  ]);
  const never = run_cu_reply(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "observe", "wait", "--timeout-ms", "300",
      "--window", handle_text,
      "--expect", JSON.stringify([{ identifier: "fixture-press-count", value: "pressed 99" }])
    ]
  );
  ensure(
    !flag_at(never, "ok") && text_at(never, "error.code") === "timeout"
      && text_at(never.error.detail.observation.results[0], "node.text") === "pressed 1",
    "cu_macos_smoke_wait_expect_timeout:" + JSON.stringify(never)
  );

  print("STEP invoke increment / decrement on the stepper and select-option on the pop-up read back");
  const incremented = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-stepper"], ["increment"]
  );
  ensure(
    flag_at(incremented, "verified")
      && text_at(incremented, "node.role") === "incrementor"
      && text_at(incremented, "before.text") === "3"
      && text_at(incremented, "after.text") === "4",
    "cu_macos_smoke_invoke_increment:" + JSON.stringify(incremented)
  );
  const decremented = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-stepper"], ["decrement"]
  );
  ensure(
    flag_at(decremented, "verified") && text_at(decremented, "after.text") === "3",
    "cu_macos_smoke_invoke_decrement:" + JSON.stringify(decremented)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-stepper", value: "3" }
  ]);
  const selected = invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-popup"], ["select-option", "Beta"]
  );
  ensure(
    flag_at(selected, "verified")
      && text_at(selected, "node.role") === "pop-up-button"
      && text_at(selected, "before.text") === "Alpha"
      && text_at(selected, "after.text") === "Beta",
    "cu_macos_smoke_invoke_select_option:" + JSON.stringify(selected)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-popup", value: "Beta" }
  ]);
  const no_option = invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-popup"], ["select-option", "Omega"], "a11y_option_not_found"
  );
  ensure(
    text_at(no_option, "error.detail.receipt.after.text") === "Beta",
    "cu_macos_smoke_invoke_select_option_missing:" + JSON.stringify(no_option)
  );

  print("STEP ambiguous --name, missing action, unobservable state, missing target and observe-only grant are typed refusals");
  const ambiguous = invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--name", "Fixture Twin"], ["press"], "ambiguous"
  );
  ensure(int_at(ambiguous, "error.count") === 2, "cu_macos_smoke_invoke_ambiguous_count:" + JSON.stringify(ambiguous));
  const missing_action = invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-check"], ["increment"], "unsupported"
  );
  ensure(
    text_at(missing_action, "error.detail.reason") === "node_action_missing",
    "cu_macos_smoke_invoke_missing_action:" + JSON.stringify(missing_action)
  );
  const blind_state = invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-press"], ["set-checked", "true"], "unsupported"
  );
  ensure(
    text_at(blind_state, "error.detail.reason") === "state_unobservable",
    "cu_macos_smoke_invoke_blind_state:" + JSON.stringify(blind_state)
  );
  invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-nowhere"], ["press"], "a11y_node_not_found"
  );
  invoke_refused(
    run_directory, executable, "observe", handle_text,
    ["--identifier", "fixture-press"], ["press"], "refused"
  );
  invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-press"], ["raise"], "usage"
  );
  invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--identifier", "fixture-check"], ["set-checked", "maybe"], "invalid_input"
  );
  // The refusals and the whole actuation section changed nothing outside the
  // fixture: the count label still says exactly one press, and the focused
  // window is the same one as before the section (the fixture never took it).
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-press-count", value: "pressed 1" }
  ]);
  const focused_after = focused_window_handle(run_directory, executable);
  ensure(
    focused_after === focused_before && focused_after !== fixture_handle,
    "cu_macos_smoke_foreground_stolen:before=" + focused_before + ":after=" + focused_after
      + ":fixture=" + fixture_handle
  );

  // ---- slice 3: background menus, focused control, observation ----------
  print("STEP menu inspect reads the background menu bar and finds File/Do Thing without opening it");
  const menu_all = menu_inspect(run_directory, executable, handle_text, ["--depth", "2"]);
  ensure(
    text_at(menu_all, "data.addressing") === "menu-path"
      && text_at(menu_all, "data.backend") === "ax"
      && text_at(menu_all, "data.mechanism") === "libagenterm"
      && int_at(menu_all, "data.budget.depth") === 2
      && !flag_at(menu_all, "data.truncated")
      && int_at(menu_all, "data.visited") >= 5
      && int_at(menu_all, "data.returned") === menu_all.data.items.length,
    "cu_macos_smoke_menu_inspect_shape:" + JSON.stringify(menu_all.data)
  );
  let do_things = 0;
  let disabled_things = 0;
  let twin_things = 0;
  let more_items = 0;
  let deeper_things = 0;
  for (const item of menu_all.data.items) {
    const path = path_text(item);
    if (path === "File/Do Thing" && flag_at(item, "enabled") && int_at(item, "depth") === 1
        && !flag_at(item, "has_submenu") && !flag_at(item, "checked")) {
      do_things = do_things + 1;
    }
    if (path === "File/Disabled Thing" && !flag_at(item, "enabled")) { disabled_things = disabled_things + 1; }
    if (path === "File/Twin Thing") { twin_things = twin_things + 1; }
    if (path === "File/More" && flag_at(item, "has_submenu")) { more_items = more_items + 1; }
    if (path === "File/More/Deeper Thing" && int_at(item, "depth") === 2 && flag_at(item, "enabled")) {
      deeper_things = deeper_things + 1;
    }
  }
  ensure(
    do_things === 1 && disabled_things === 1 && twin_things === 2 && more_items === 1 && deeper_things === 1,
    "cu_macos_smoke_menu_inspect_items:do=" + do_things + ":disabled=" + disabled_things
      + ":twin=" + twin_things + ":more=" + more_items + ":deeper=" + deeper_things
  );
  const menu_exact = menu_inspect(run_directory, executable, handle_text, ["--title", "Do Thing", "--exact"]);
  ensure(
    int_at(menu_exact, "data.matched") === 1
      && path_text(menu_exact.data.items[0]) === "File/Do Thing",
    "cu_macos_smoke_menu_inspect_exact:" + JSON.stringify(menu_exact.data)
  );
  const menu_disabled = menu_inspect(run_directory, executable, handle_text, ["--title", "thing", "--enabled", "false"]);
  ensure(
    int_at(menu_disabled, "data.matched") === 1
      && text_at(menu_disabled.data.items[0], "title") === "Disabled Thing",
    "cu_macos_smoke_menu_inspect_disabled:" + JSON.stringify(menu_disabled.data)
  );
  const menu_bar_only = menu_inspect(run_directory, executable, handle_text, ["--depth", "0", "--max-nodes", "3"]);
  ensure(
    flag_at(menu_bar_only, "data.truncated") && flag_at(menu_bar_only, "data.scan_truncated")
      && int_at(menu_bar_only, "data.nodes_visited") === 3
      && menu_bar_only.data.items.length >= 1,
    "cu_macos_smoke_menu_inspect_bounded:" + JSON.stringify(menu_bar_only.data)
  );
  for (const item of menu_bar_only.data.items) {
    ensure(int_at(item, "depth") === 0, "cu_macos_smoke_menu_inspect_depth_zero:" + JSON.stringify(item));
  }
  const menu_too_deep = run_cu_reply(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "menu", "inspect", "--window", handle_text, "--depth", "9"]
  );
  ensure(
    !flag_at(menu_too_deep, "ok") && text_at(menu_too_deep, "error.code") === "invalid_input",
    "cu_macos_smoke_menu_inspect_depth_bound:" + JSON.stringify(menu_too_deep)
  );
  const menu_bogus = run_cu_reply(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "menu", "inspect", "--window", handle_text, "--bogus"]
  );
  ensure(
    !flag_at(menu_bogus, "ok") && text_at(menu_bogus, "error.code") === "usage",
    "cu_macos_smoke_menu_inspect_unknown_flag:" + JSON.stringify(menu_bogus)
  );

  print("STEP menu invoke presses File/Do Thing in the background; the label changes and the focused window does not");
  const focused_before_menu = focused_window_handle(run_directory, executable);
  const did_thing = menu_invoke_reply(run_directory, executable, "actuate", handle_text, "File/Do Thing");
  ensure(
    flag_at(did_thing, "ok")
      && text_at(did_thing, "data.addressing") === "menu-path"
      && text_at(did_thing, "data.backend") === "ax"
      && text_at(did_thing, "data.action") === "press"
      && flag_at(did_thing, "data.performed")
      && flag_at(did_thing, "data.verified")
      && flag_at(did_thing, "data.tree_changed")
      && did_thing.data.path.length === 2
      && text_of(did_thing.data.path[1]) === "Do Thing",
    "cu_macos_smoke_menu_invoke:" + JSON.stringify(did_thing)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-menu-label", role: "AXStaticText", value: "did thing 1" }
  ]);
  const deeper = menu_invoke_reply(
    run_directory, executable, "actuate", handle_text, "[\"File\",\"More\",\"Deeper Thing\"]"
  );
  ensure(
    flag_at(deeper, "ok") && flag_at(deeper, "data.verified") && deeper.data.path.length === 3,
    "cu_macos_smoke_menu_invoke_submenu:" + JSON.stringify(deeper)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-menu-label", value: "deeper thing" }
  ]);
  menu_invoke_refused(run_directory, executable, "actuate", handle_text, "File/Twin Thing", "a11y_menu_item_ambiguous");
  menu_invoke_refused(run_directory, executable, "actuate", handle_text, "File/Disabled Thing", "a11y_menu_item_disabled");
  menu_invoke_refused(run_directory, executable, "actuate", handle_text, "File/Nowhere", "a11y_menu_item_not_found");
  menu_invoke_refused(run_directory, executable, "actuate", handle_text, "File/More", "a11y_menu_item_not_leaf");
  menu_invoke_refused(run_directory, executable, "actuate", handle_text, "File", "usage");
  menu_invoke_refused(run_directory, executable, "observe", handle_text, "File/Do Thing", "refused");
  // The refusals pressed nothing: the label still reads the last accepted
  // press, and the user's focused window is still the same one.
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-menu-label", value: "deeper thing" }
  ]);
  const focused_after_menu = focused_window_handle(run_directory, executable);
  ensure(
    focused_after_menu === focused_before_menu && focused_after_menu !== fixture_handle,
    "cu_macos_smoke_menu_foreground_stolen:before=" + focused_before_menu + ":after=" + focused_after_menu
  );

  print("STEP focus moves the first responder to the text field and focused / invoke --focused bind it");
  const initially_focused = focused_reply(run_directory, executable, handle_text, []);
  ensure(
    flag_at(initially_focused, "ok")
      && text_at(initially_focused, "data.addressing") === "focused-control"
      && text_at(initially_focused, "data.backend") === "ax"
      && text_at(initially_focused, "data.node.role") === "text-area"
      && text_at(initially_focused, "data.node.identifier") === "fixture-text"
      && text_at(initially_focused, "data.node.id") === text_area_id
      && at(initially_focused, "data.node.focused") === true
      && text_at(initially_focused, "data.value") === "345AXTREE"
      && int_at(initially_focused, "data.value_bytes") === 9
      && !flag_at(initially_focused, "data.value_truncated"),
    "cu_macos_smoke_focused_initial:" + JSON.stringify(initially_focused)
  );
  const field_query = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "query", "--window", handle_text, "--identifier", "fixture-field"]
  );
  ensure(int_at(field_query, "data.matched") === 1, "cu_macos_smoke_focused_field_query");
  const field_id = text_at(field_query.data.nodes[0], "id");
  const focus_field = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "actuate", "focus", "--window", handle_text, "--node", field_id]
  );
  ensure(
    text_at(focus_field, "data.action") === "focus"
      && flag_at(focus_field, "data.verified")
      && text_at(focus_field, "data.verification.method") === "focused-readback"
      && at(focus_field, "data.after.focused") === true
      && text_at(focus_field, "data.receipt.id") !== "",
    "cu_macos_smoke_focus_field:" + JSON.stringify(focus_field)
  );
  const now_focused = focused_reply(
    run_directory, executable, handle_text, ["--role", "AXTextField", "--max-value-bytes", "2"]
  );
  ensure(
    flag_at(now_focused, "ok")
      && text_at(now_focused, "data.node.id") === field_id
      && text_at(now_focused, "data.node.role") === "text-field"
      && text_at(now_focused, "data.node.identifier") === "fixture-field"
      && at(now_focused, "data.node.focused") === true
      && text_at(now_focused, "data.role_bound") === "AXTextField"
      && text_at(now_focused, "data.value") === "wr"
      && int_at(now_focused, "data.value_bytes") === 13
      && flag_at(now_focused, "data.value_truncated"),
    "cu_macos_smoke_focused_field:" + JSON.stringify(now_focused)
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-field", focused: true },
    { identifier: "fixture-text", focused: false }
  ]);
  const wrong_role = focused_reply(run_directory, executable, handle_text, ["--role", "AXButton"]);
  ensure(
    !flag_at(wrong_role, "ok") && text_at(wrong_role, "error.code") === "unverified"
      && text_at(wrong_role, "error.detail.observed.identifier") === "fixture-field",
    "cu_macos_smoke_focused_wrong_role:" + JSON.stringify(wrong_role)
  );
  const typed = invoke_ok(
    run_directory, executable, handle_text,
    ["--focused", "--role", "AXTextField"], ["set-value", "typed into focus"]
  );
  ensure(
    flag_at(typed, "verified")
      && flag_at(typed, "target.focused")
      && text_at(typed, "node.id") === field_id
      && text_at(typed, "node.identifier") === "fixture-field"
      && text_at(typed, "before.text") === "written by cu"
      && text_at(typed, "after.text") === "typed into focus",
    "cu_macos_smoke_invoke_focused:" + JSON.stringify(typed)
  );
  invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--focused", "--role", "AXButton"], ["set-value", "never"], "unverified"
  );
  invoke_refused(
    run_directory, executable, "actuate", handle_text,
    ["--focused", "--identifier", "fixture-field"], ["press"], "usage"
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-field", value: "typed into focus" }
  ]);

  print("STEP observe --duration 1.5 captures the ValueChanged of a set-value issued while it runs");
  const observer = start_observer(
    run_directory, executable, handle_text,
    ["--duration", "1.5", "--notification", "ValueChanged", "--max-events", "50"]
  );
  harness.sleep_ms(300);
  invoke_ok(run_directory, executable, handle_text, ["--identifier", "fixture-field"], ["set-value", "observed"]);
  const observed = observer_result(observer);
  ensure(
    text_at(observed, "mode") === "poll-diff"
      && text_at(observed, "backend") === "ax"
      && int_at(observed, "duration_ms") === 1500
      && int_at(observed, "polls") > 1
      && int_at(observed, "poll_errors") === 0
      && int_at(observed, "emitted") === observed.events.length
      && int_at(observed, "emitted") >= 1
      && !flag_at(observed, "truncated")
      && text_at(observed, "stopped") === "deadline",
    "cu_macos_smoke_observe_shape:" + JSON.stringify(observed)
  );
  let value_changes = 0;
  let last_t = -1;
  let expected_seq = 0;
  for (const event of observed.events) {
    ensure(int_at(event, "seq") === expected_seq, "cu_macos_smoke_observe_seq:" + JSON.stringify(event));
    ensure(int_at(event, "t_ms") >= last_t, "cu_macos_smoke_observe_monotonic:" + JSON.stringify(event));
    ensure(text_at(event, "notification") === "ValueChanged", "cu_macos_smoke_observe_filter:" + JSON.stringify(event));
    expected_seq = expected_seq + 1;
    last_t = int_at(event, "t_ms");
    if (text_at(event, "node.identifier") === "fixture-field"
        && text_at(event, "before") === "typed into focus"
        && text_at(event, "after") === "observed") {
      value_changes = value_changes + 1;
    }
  }
  ensure(value_changes === 1, "cu_macos_smoke_observe_value_changed:" + JSON.stringify(observed.events));
  // --max-events stops the stream early and says so.
  const capped = start_observer(
    run_directory, executable, handle_text,
    ["--duration", "3", "--notification", "ValueChanged", "--max-events", "1"]
  );
  harness.sleep_ms(300);
  invoke_ok(run_directory, executable, handle_text, ["--identifier", "fixture-field"], ["set-value", "second"]);
  harness.sleep_ms(200);
  invoke_ok(run_directory, executable, handle_text, ["--identifier", "fixture-field"], ["set-value", "third"]);
  const capped_result = observer_result(capped);
  ensure(
    int_at(capped_result, "emitted") === 1
      && flag_at(capped_result, "truncated")
      && text_at(capped_result, "stopped") === "max-events"
      && int_at(capped_result, "elapsed_ms") < 3000
      && text_at(capped_result.events[0], "after") === "second",
    "cu_macos_smoke_observe_capped:" + JSON.stringify(capped_result)
  );
  const bad_notification = run_cu_reply(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "observe", "--window", handle_text, "--duration", "1", "--notification", "Moved"]
  );
  ensure(
    !flag_at(bad_notification, "ok") && text_at(bad_notification, "error.code") === "usage",
    "cu_macos_smoke_observe_bad_notification:" + JSON.stringify(bad_notification)
  );
  const focused_after_slice3 = focused_window_handle(run_directory, executable);
  ensure(
    focused_after_slice3 === focused_before && focused_after_slice3 !== fixture_handle,
    "cu_macos_smoke_slice3_foreground_stolen:before=" + focused_before + ":after=" + focused_after_slice3
  );

  // ---- slice 4: click, frame, the destructive gate, receipts -----------
  print("STEP observe --mode notifications takes the events from the backend itself: no polls, arrival times, and a value that reverts is still seen");
  // The default mode compares two tree walks, so it carries before / after
  // but cannot see a change that reverts between them. This mode
  // subscribes to the application's own AX notifications instead, so it
  // sees the order and arrival of every change -- and says so, since the
  // two are not interchangeable.
  const native_observer = start_observer(
    run_directory, executable, handle_text,
    ["--duration", "2", "--mode", "notifications", "--max-events", "50"]
  );
  harness.sleep_ms(300);
  // Write and write back: the second value equals the first, so a walk
  // taken after both would see no difference at all.
  invoke_ok(run_directory, executable, handle_text, ["--identifier", "fixture-field"], ["set-value", "reverted once"]);
  harness.sleep_ms(150);
  invoke_ok(run_directory, executable, handle_text, ["--identifier", "fixture-field"], ["set-value", "observed"]);
  const native_events = observer_result(native_observer);
  ensure(
    text_at(native_events, "mode") === "notifications"
      && text_at(native_events, "backend") === "ax"
      && int_at(native_events, "duration_ms") === 2000
      && int_at(native_events, "emitted") === native_events.events.length
      && int_at(native_events, "emitted") >= 2
      && !flag_at(native_events, "truncated")
      && text_at(native_events, "stopped") === "deadline",
    "cu_macos_smoke_native_observe_shape:" + JSON.stringify(native_events)
  );
  // No `polls` field: there were none, and a caller comparing two runs has
  // to be able to tell which mechanism produced the events.
  ensure(
    native_events.polls === undefined && native_events.interval_ms === undefined,
    "cu_macos_smoke_native_observe_has_poll_fields:" + JSON.stringify(native_events)
  );
  let native_value_changes = 0;
  let native_last_t = -1;
  let native_seq = 0;
  for (const event of native_events.events) {
    ensure(int_at(event, "seq") === native_seq, "cu_macos_smoke_native_seq:" + JSON.stringify(event));
    ensure(int_at(event, "t_ms") >= native_last_t, "cu_macos_smoke_native_monotonic:" + JSON.stringify(event));
    native_seq = native_seq + 1;
    native_last_t = int_at(event, "t_ms");
    if (text_at(event, "notification") === "ValueChanged") {
      native_value_changes = native_value_changes + 1;
    }
  }
  // Both writes are seen, including the one a poll-diff between the same
  // two instants would have missed entirely.
  ensure(
    native_value_changes >= 2,
    "cu_macos_smoke_native_reverting_write:" + JSON.stringify(native_events.events)
  );

  print("STEP click --node and click --name press the button; the label advances, the real pointer and the focused window do not move");
  const press_id = text_at(by_identifier.data.nodes[0], "id");
  const pointer_before_click = pointer_text(run_directory, executable);
  const clicked_by_node = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "actuate", "click", "--window", handle_text, "--node", press_id]
  );
  const pointer_after_click = pointer_text(run_directory, executable);
  ensure(
    text_at(clicked_by_node, "data.addressing") === "accessibility-tree"
      && text_at(clicked_by_node, "data.action") === "click"
      && text_at(clicked_by_node, "data.node") === press_id
      && flag_at(clicked_by_node, "data.performed")
      && flag_at(clicked_by_node, "data.verified")
      && text_at(clicked_by_node, "data.verification.method") === "tree-diff"
      && text_at(clicked_by_node, "data.receipt.id") !== "",
    "cu_macos_smoke_click_node:" + JSON.stringify(clicked_by_node)
  );
  ensure(
    pointer_after_click === pointer_before_click,
    "cu_macos_smoke_click_pointer_moved:" + pointer_before_click + "->" + pointer_after_click
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-press-count", value: "pressed 2" }
  ]);
  const pointer_before_name = pointer_text(run_directory, executable);
  const clicked_by_name = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "actuate", "click", "--window", handle_text, "--name", "Fixture Press"]
  );
  const pointer_after_name = pointer_text(run_directory, executable);
  ensure(
    flag_at(clicked_by_name, "data.verified")
      && text_at(clicked_by_name, "data.node") === press_id
      && text_at(clicked_by_name, "data.matched.name") === "Fixture Press"
      && text_at(clicked_by_name, "data.backend") === "ax",
    "cu_macos_smoke_click_name:" + JSON.stringify(clicked_by_name)
  );
  ensure(
    pointer_after_name === pointer_before_name,
    "cu_macos_smoke_click_name_pointer_moved:" + pointer_before_name + "->" + pointer_after_name
  );
  verify_ok(run_directory, executable, handle_text, [
    { identifier: "fixture-press-count", value: "pressed 3" }
  ]);
  const click_ambiguous = run_cu_reply(
    run_directory,
    executable,
    ["--target", "current", "--grant", "actuate", "click", "--window", handle_text, "--name", "Fixture Twin"]
  );
  ensure(
    !flag_at(click_ambiguous, "ok") && text_at(click_ambiguous, "error.code") === "a11y_node_ambiguous",
    "cu_macos_smoke_click_ambiguous:" + JSON.stringify(click_ambiguous)
  );
  const focused_after_click = focused_window_handle(run_directory, executable);
  ensure(
    focused_after_click === focused_before && focused_after_click !== fixture_handle,
    "cu_macos_smoke_click_foreground_stolen:before=" + focused_before + ":after=" + focused_after_click
  );

  print("STEP screenshot captures the fixture window's own pixels through the symbol the SDK dropped, sized in device pixels rather than points");
  // `CGWindowListCreateImage` is gone from the SDK -- the compiler refuses
  // it -- but it is still in the framework and still captures, so it is
  // reached by dlsym the way SkyLight already is. The reply reports the
  // *device* pixel size, which on a Retina display is the window's points
  // times the backing scale: reporting the point size would describe an
  // image nobody wrote.
  const shot_path = rh.join(run_directory, "fixture.png");
  const shot = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "screenshot",
    "--out", shot_path, "--window", handle_text
  ]);
  const shot_row = fixture_window_row(run_directory, executable, fixture_pid, fixture_title);
  const scale_w = int_at(shot, "data.output_width") / int_at(shot_row, "bounds.width");
  const scale_h = int_at(shot, "data.output_height") / int_at(shot_row, "bounds.height");
  ensure(
    scale_w === scale_h && scale_w >= 1 && scale_w === Math.round(scale_w),
    "cu_macos_smoke_shot_scale:" + JSON.stringify(shot.data) + JSON.stringify(shot_row.bounds)
  );
  ensure(direct_file(shot_path), "cu_macos_smoke_shot_missing");
  // A capture of a real window compresses to far more than a flat image,
  // which is what an obsoleted stub returning blank pixels would give.
  ensure(
    rh.metadata(shot_path).len > 5000,
    "cu_macos_smoke_shot_empty:" + rh.metadata(shot_path).len
  );
  // A handle that is not a window refuses typed rather than capturing the
  // desktop instead.
  const shot_refused = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe", "screenshot",
    "--out", rh.join(run_directory, "nope.png"), "--window", "999999999"
  ]);
  ensure(
    !flag_at(shot_refused, "ok"),
    "cu_macos_smoke_shot_bad_handle:" + JSON.stringify(shot_refused)
  );

  print("STEP window-place --action frame moves the fixture window to a requested rect in one transaction and the inventory reads it back");
  const framed = run_cu_json(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "actuate", "window-place", "--action", "frame",
      "--window", handle_text, "--x", "200", "--y", "200", "--width", "500", "--height", "400"
    ]
  );
  ensure(
    text_at(framed, "data.effect") === "committed"
      && text_at(framed, "data.action") === "frame"
      && text_at(framed, "data.history") === "committed"
      && int_at(framed, "data.after.width") === 500
      && int_at(framed, "data.after.height") === 400
      && int_at(framed, "data.after.x") === 200
      && int_at(framed, "data.after.y") === 200,
    "cu_macos_smoke_frame:" + JSON.stringify(framed.data)
  );
  const framed_row = fixture_window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(
    framed_row !== null
      && int_at(framed_row, "bounds.x") === 200
      && int_at(framed_row, "bounds.y") === 200
      && int_at(framed_row, "bounds.width") === 500
      && int_at(framed_row, "bounds.height") === 400,
    "cu_macos_smoke_frame_readback:" + JSON.stringify(framed_row)
  );
  const frame_missing = run_cu_reply(
    run_directory,
    executable,
    ["--target", "current", "--grant", "actuate", "window-place", "--action", "frame", "--window", handle_text, "--x", "1"]
  );
  ensure(
    !flag_at(frame_missing, "ok") && text_at(frame_missing, "error.code") === "usage",
    "cu_macos_smoke_frame_missing:" + JSON.stringify(frame_missing)
  );
  const frame_on_catalog = run_cu_reply(
    run_directory,
    executable,
    [
      "--target", "current", "--grant", "actuate", "window-place", "--action", "center",
      "--window", handle_text, "--x", "1", "--y", "1", "--width", "10", "--height", "10"
    ]
  );
  ensure(
    !flag_at(frame_on_catalog, "ok") && text_at(frame_on_catalog, "error.code") === "invalid_input",
    "cu_macos_smoke_frame_on_catalog:" + JSON.stringify(frame_on_catalog)
  );

  print("STEP the inventory reports a front-to-back z-order and how much of each window is covered; moving the front window onto the back one takes it from visible to fully hidden");
  // Both fixture windows are owned by this run, so the overlap is
  // deliberate rather than whatever the desktop happened to look like.
  const second_window_title = "agenterm-ax-second-" + fixture_pid;
  const stacked_before = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "windows", "--pid", "" + fixture_pid
  ]);
  ensure(
    text_at(stacked_before, "data.stacking.status") === "available"
      && text_at(stacked_before, "data.stacking.order") === "front-to-back",
    "cu_macos_smoke_stacking_declaration:" + JSON.stringify(stacked_before.data.stacking)
  );
  let front_row = null;
  let back_row = null;
  for (const row of stacked_before.data.windows) {
    if (text_at(row, "title") === fixture_title) { front_row = row; }
    if (text_at(row, "title") === second_window_title) { back_row = row; }
  }
  ensure(front_row !== null && back_row !== null, "cu_macos_smoke_stacking_rows_missing");
  // The fixture orders the second window front first and the main window
  // last, so the main one is ahead of it.
  ensure(
    int_at(front_row, "z_index") < int_at(back_row, "z_index")
      && int_at(front_row, "occluded_percent") === 0
      && int_at(back_row, "occluded_percent") === 0,
    "cu_macos_smoke_stacking_start:" + JSON.stringify([front_row, back_row])
  );
  // Each window also names the managed Spaces it sits on, and those ids
  // are the ones the Space inventory lists. A window on another Space is
  // present but not on screen -- neither minimized nor closed -- and an
  // inventory that could not say so would send an agent looking for a
  // window it will never see.
  const space_inventory = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "spaces"
  ]);
  let known_space_ids = [];
  for (const display of space_inventory.data.displays) {
    for (const space of display.spaces) { known_space_ids.push(text_at(space, "id")); }
  }
  ensure(known_space_ids.length >= 1, "cu_macos_smoke_space_inventory_empty:" + JSON.stringify(space_inventory.data));
  for (const row of stacked_before.data.windows) {
    const spaces = row.spaces;
    ensure(
      spaces !== undefined && spaces.length >= 1,
      "cu_macos_smoke_window_without_space:" + JSON.stringify(row)
    );
    for (const id of spaces) {
      let known = 0;
      for (const candidate of known_space_ids) {
        if (candidate === "" + id) { known = 1; }
      }
      ensure(known === 1, "cu_macos_smoke_unknown_space:" + id + " of " + JSON.stringify(known_space_ids));
    }
  }

  // Every window on the desktop gets a distinct index, so the order is a
  // real ranking and not a per-window guess.
  const all_stacked = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "windows", "--max", "50"
  ]);
  let previous_index = -1;
  let ranking_is_dense = 1;
  for (const row of all_stacked.data.windows) {
    const index = int_at(row, "z_index");
    if (index !== previous_index + 1) { ranking_is_dense = 0; }
    previous_index = index;
    if (int_at(row, "occluded_percent") < 0 || int_at(row, "occluded_percent") > 100) {
      ranking_is_dense = 0;
    }
  }
  ensure(
    ranking_is_dense === 1 && previous_index >= 1,
    "cu_macos_smoke_stacking_ranking:" + JSON.stringify(all_stacked.data.windows)
  );

  // Put the front window exactly over the back one: the back one goes from
  // fully visible to fully hidden, computed from the rectangles.
  const cover = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "window-place",
    "--action", "frame", "--window", handle_text,
    "--x", "" + int_at(back_row, "bounds.x"), "--y", "" + int_at(back_row, "bounds.y"),
    "--width", "" + int_at(back_row, "bounds.width"),
    "--height", "" + int_at(back_row, "bounds.height")
  ]);
  ensure(flag_at(cover, "ok"), "cu_macos_smoke_stacking_cover:" + JSON.stringify(cover));
  const stacked_after = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "windows", "--pid", "" + fixture_pid
  ]);
  let covered_row = null;
  for (const row of stacked_after.data.windows) {
    if (text_at(row, "title") === second_window_title) { covered_row = row; }
  }
  ensure(
    covered_row !== null && int_at(covered_row, "occluded_percent") === 100,
    "cu_macos_smoke_stacking_covered:" + JSON.stringify(covered_row)
  );

  print("STEP orderwin answers from the order it reads back: on macOS AXRaise cannot reorder a background app's windows, so it refuses typed instead of reporting the raise it sent");
  // Measured on this host: AXRaise on a window of an application that is
  // not frontmost does not move it in the global window list -- the second
  // window went from z=1 to z=2, i.e. further back, while the request was
  // to put it in front. cu will not activate the application to make the
  // raise take (that would steal the foreground, which every verb here is
  // built not to do), so the honest answer is a refusal that names the
  // order it actually read. Reporting success from having *sent* AXRaise
  // is what this verb used to do.
  const order_target_handle = int_at(back_row, "handle");
  const order_raise = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "orderwin",
    "--window", "" + order_target_handle, "--relation", "above", "--relative", handle_text
  ]);
  ensure(
    !flag_at(order_raise, "ok")
      && text_at(order_raise, "error.code") === "window_order_not_applied"
      && int_at(order_raise, "error.detail.after.window_z")
         > int_at(order_raise, "error.detail.after.relative_z"),
    "cu_macos_smoke_orderwin_refusal:" + JSON.stringify(order_raise)
  );
  // The refusal carries both readings, so a caller can see it was measured
  // rather than assumed.
  ensure(
    int_at(order_raise, "error.detail.before.relative_z") >= 0
      && int_at(order_raise, "error.detail.after.relative_z") >= 0,
    "cu_macos_smoke_orderwin_readings:" + JSON.stringify(order_raise)
  );
  // Asking for an order that already holds is a success that moves
  // nothing: the front window is already above the back one.
  const order_holds = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "orderwin",
    "--window", handle_text, "--relation", "above", "--relative", "" + order_target_handle
  ]);
  ensure(
    flag_at(order_holds, "ok")
      && int_at(order_holds, "data.after.window_z") < int_at(order_holds, "data.after.relative_z"),
    "cu_macos_smoke_orderwin_holds:" + JSON.stringify(order_holds)
  );
  // Naming one handle twice is refused before anything is raised.
  const order_same = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "orderwin",
    "--window", handle_text, "--relation", "above", "--relative", handle_text
  ]);
  ensure(
    !flag_at(order_same, "ok") && text_at(order_same, "error.code") === "invalid_input",
    "cu_macos_smoke_orderwin_same_handle:" + JSON.stringify(order_same)
  );
  // An observe-only grant never reaches the mechanism.
  const order_unauthorized = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe", "orderwin",
    "--window", "" + order_target_handle, "--relation", "above", "--relative", handle_text
  ]);
  ensure(
    !flag_at(order_unauthorized, "ok"),
    "cu_macos_smoke_orderwin_grant:" + JSON.stringify(order_unauthorized)
  );
  harness.emit_evidence(context, declared_evidence, "cu.macos-ax-orderwin");

  print("STEP close without a snapshot, a postcondition or a target, and with a wrong --pid / --title, is refused typed; the second window stays");
  const second_title = "agenterm-ax-second-" + fixture_pid;
  const second_row = fixture_window_row(run_directory, executable, fixture_pid, second_title);
  ensure(second_row !== null, "cu_macos_smoke_second_window_missing");
  const second_handle = int_at(second_row, "handle");
  const second_text = "" + second_handle;
  ensure(second_handle > 0 && second_handle !== fixture_handle, "cu_macos_smoke_second_window_handle");
  const no_snapshot = close_refused(
    run_directory, executable, "actuate", ["--window", second_text, "--expect", "gone"], "refused"
  );
  ensure(
    text_at(no_snapshot, "error.detail.reason") === "destructive_gate"
      && no_snapshot.error.detail.missing.length === 1
      && text_of(no_snapshot.error.detail.missing[0]) === "snapshot"
      && text_at(no_snapshot, "error.detail.effect") === "not_performed",
    "cu_macos_smoke_close_no_snapshot:" + JSON.stringify(no_snapshot)
  );
  const no_postcondition = close_refused(
    run_directory, executable, "actuate", ["--window", second_text, "--snapshot"], "refused"
  );
  ensure(
    text_at(no_postcondition, "error.detail.reason") === "destructive_gate"
      && no_postcondition.error.detail.missing.length === 1
      && text_of(no_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_macos_smoke_close_no_postcondition:" + JSON.stringify(no_postcondition)
  );
  const nothing = close_refused(run_directory, executable, "actuate", [], "refused");
  ensure(
    text_at(nothing, "error.detail.reason") === "destructive_gate"
      && nothing.error.detail.missing.length === 3
      && text_of(nothing.error.detail.missing[0]) === "target",
    "cu_macos_smoke_close_nothing:" + JSON.stringify(nothing)
  );
  close_refused(
    run_directory, executable, "actuate",
    ["--window", second_text, "--snapshot", "--expect", "vanish"], "invalid_input"
  );
  const wrong_pid = close_refused(
    run_directory, executable, "actuate",
    ["--window", second_text, "--pid", "1", "--snapshot", "--expect", "gone"], "window_identity_mismatch"
  );
  ensure(
    text_at(wrong_pid, "error.detail.effect") === "not_performed"
      && int_at(wrong_pid, "error.detail.observed.pid") === fixture_pid,
    "cu_macos_smoke_close_wrong_pid:" + JSON.stringify(wrong_pid)
  );
  close_refused(
    run_directory, executable, "actuate",
    ["--window", second_text, "--title", fixture_title, "--snapshot", "--expect", "gone"], "window_identity_mismatch"
  );
  close_refused(
    run_directory, executable, "actuate",
    ["--window", "1", "--snapshot", "--expect", "gone"], "window_not_found"
  );
  close_refused(
    run_directory, executable, "observe",
    ["--window", second_text, "--snapshot", "--expect", "gone"], "refused"
  );
  close_refused(
    run_directory, executable, "actuate",
    ["--window", second_text, "--snapshot", "--expect", "gone", "--bogus"], "usage"
  );
  // Nothing was performed: the second window is still there, and no
  // receipt was reserved for it (a refusal before the mechanism writes none).
  ensure(
    fixture_window_row(run_directory, executable, fixture_pid, second_title) !== null,
    "cu_macos_smoke_close_refusal_closed_it"
  );
  const receipts_before_close = receipts_reply(run_directory, executable, ["--window", second_text]);
  ensure(
    flag_at(receipts_before_close, "ok") && int_at(receipts_before_close, "data.total") === 0,
    "cu_macos_smoke_close_refusal_receipt:" + JSON.stringify(receipts_before_close)
  );

  print("STEP close --pid --title --snapshot --expect gone closes the second window in the background; the inventory reads it gone, the pointer and the focused window are unchanged");
  const pointer_before_close = pointer_text(run_directory, executable);
  const closed = close_reply(
    run_directory, executable, "actuate",
    ["--window", second_text, "--pid", "" + fixture_pid, "--title", second_title, "--snapshot", "--expect", "gone"]
  );
  const pointer_after_close = pointer_text(run_directory, executable);
  ensure(
    flag_at(closed, "ok")
      && text_at(closed, "data.addressing") === "window-handle"
      && text_at(closed, "data.backend") === "ax"
      && text_at(closed, "data.action") === "close"
      && text_at(closed, "data.postcondition") === "gone"
      && flag_at(closed, "data.performed")
      && flag_at(closed, "data.verified")
      && text_at(closed, "data.verification.method") === "window-inventory"
      && int_at(closed, "data.verification.polls") >= 1
      && text_at(closed, "data.target.title") === second_title
      && int_at(closed, "data.target.pid") === fixture_pid
      && int_at(closed, "data.snapshot.returned") >= 2
      && flag_at(closed, "data.snapshot.in_receipt")
      && at(closed, "data.after.present") === false
      && text_at(closed, "data.receipt.id") !== "",
    "cu_macos_smoke_close:" + JSON.stringify(closed)
  );
  ensure(
    pointer_after_close === pointer_before_close,
    "cu_macos_smoke_close_pointer_moved:" + pointer_before_close + "->" + pointer_after_close
  );
  ensure(
    fixture_window_row(run_directory, executable, fixture_pid, second_title) === null,
    "cu_macos_smoke_close_window_lingers"
  );
  ensure(
    fixture_window_row(run_directory, executable, fixture_pid, fixture_title) !== null
      && harness.process_present(fixture_pid) === 1,
    "cu_macos_smoke_close_took_the_main_window"
  );
  const closed_again = close_refused(
    run_directory, executable, "actuate",
    ["--window", second_text, "--snapshot", "--expect", "gone"], "window_not_found"
  );
  ensure(
    text_at(closed_again, "error.detail.effect") === "not_performed",
    "cu_macos_smoke_close_again:" + JSON.stringify(closed_again)
  );
  const focused_after_close = focused_window_handle(run_directory, executable);
  ensure(
    focused_after_close === focused_before && focused_after_close !== fixture_handle,
    "cu_macos_smoke_close_foreground_stolen:before=" + focused_before + ":after=" + focused_after_close
  );

  print("STEP receipts lists every actuation of this run in order from the crash-persistent file, reserved before and completed after each");
  const second_receipts = receipts_reply(run_directory, executable, ["--window", second_text]);
  ensure(
    flag_at(second_receipts, "ok")
      && text_at(second_receipts, "data.addressing") === "receipt-file"
      && text_at(second_receipts, "data.path") === receipt_file(run_directory)
      && int_at(second_receipts, "data.total") === 2
      && int_at(second_receipts, "data.returned") === 2
      && !flag_at(second_receipts, "data.truncated"),
    "cu_macos_smoke_receipts_second_shape:" + JSON.stringify(second_receipts)
  );
  ensure(count_receipt_pairs(second_receipts.data.receipts) === 1, "cu_macos_smoke_receipts_second_pairs");
  const close_reserved = second_receipts.data.receipts[0];
  const close_completed = second_receipts.data.receipts[1];
  ensure(
    text_at(close_reserved, "verb") === "close"
      && text_at(close_reserved, "target") === "current"
      && text_at(close_reserved, "action") === "close"
      && text_at(close_reserved, "postcondition") === "gone"
      && text_at(close_reserved, "target") === "current"
      && text_at(close_reserved, "window_identity.title") === second_title
      && int_at(close_reserved, "pid") > 0
      && close_reserved.snapshot.nodes.length >= 2
      && text_at(close_reserved.snapshot.nodes[0], "role") === "window"
      && text_at(close_reserved, "receipt_id") === text_at(closed, "data.receipt.id")
      && text_at(close_completed, "phase") === "completed"
      && flag_at(close_completed, "verified")
      && at(close_completed, "after.present") === false,
    "cu_macos_smoke_receipts_close:" + JSON.stringify(second_receipts.data.receipts)
  );
  const main_receipts = receipts_reply(run_directory, executable, ["--window", handle_text, "--max", "1000"]);
  ensure(flag_at(main_receipts, "ok") && !flag_at(main_receipts, "data.truncated"), "cu_macos_smoke_receipts_main:" + JSON.stringify(main_receipts));
  const main_lines = main_receipts.data.receipts;
  const main_pairs = count_receipt_pairs(main_lines);
  let invoke_receipts = 0;
  let menu_receipts = 0;
  let focus_receipts = 0;
  let click_receipts = 0;
  let failed_receipts = 0;
  for (const line of main_lines) {
    if (text_at(line, "phase") !== "reserved") {
      if (text_at(line, "phase") === "failed") { failed_receipts = failed_receipts + 1; }
      continue;
    }
    const verb = text_at(line, "verb");
    if (verb === "invoke") { invoke_receipts = invoke_receipts + 1; }
    if (verb === "menu-invoke") { menu_receipts = menu_receipts + 1; }
    if (verb === "focus") { focus_receipts = focus_receipts + 1; }
    if (verb === "click") { click_receipts = click_receipts + 1; }
  }
  // The first actuation of the run was `invoke set-value` on the seed; the
  // last two were the clicks; `select-option Omega` and the four platform
  // menu refusals left `failed` partners (reserved, then refused by the
  // mechanism), and the pure refusals (ambiguous, missing action, grant,
  // usage) reserved nothing.
  ensure(
    main_pairs >= 12
      && invoke_receipts >= 10
      && menu_receipts === 6
      && focus_receipts === 1
      && click_receipts === 2
      && failed_receipts === 5
      && text_at(main_lines[0], "verb") === "invoke"
      && text_at(main_lines[0], "action") === "set-value"
      && text_at(main_lines[0], "value") === "written by cu"
      && text_at(main_lines[0], "before.text") === "seed"
      && text_at(main_lines[1], "phase") === "completed"
      && text_at(main_lines[1], "after.text") === "written by cu"
      && text_at(main_lines[main_lines.length - 2], "verb") === "click"
      && text_at(main_lines[main_lines.length - 1], "phase") === "completed",
    "cu_macos_smoke_receipts_main_counts:pairs=" + main_pairs + ":invoke=" + invoke_receipts
      + ":menu=" + menu_receipts + ":focus=" + focus_receipts + ":click=" + click_receipts
      + ":failed=" + failed_receipts + ":first=" + JSON.stringify(main_lines[0])
  );
  // The file itself: one JSON line per receipt line the verb reported.
  const all_receipts = receipts_reply(run_directory, executable, ["--max", "1000"]);
  const file_lines = rh.read_text(receipt_file(run_directory)).trim().split("\n");
  ensure(
    int_at(all_receipts, "data.total") === file_lines.length
      && file_lines.length === main_lines.length + 2,
    "cu_macos_smoke_receipts_file:" + file_lines.length + ":" + JSON.stringify(all_receipts.data)
  );
  const capped_receipts = receipts_reply(run_directory, executable, ["--window", handle_text, "--max", "2"]);
  ensure(
    int_at(capped_receipts, "data.returned") === 2
      && flag_at(capped_receipts, "data.truncated")
      && int_at(capped_receipts, "data.total") === main_lines.length
      && text_at(capped_receipts.data.receipts[1], "receipt_id") === text_at(main_lines[main_lines.length - 1], "receipt_id"),
    "cu_macos_smoke_receipts_capped:" + JSON.stringify(capped_receipts.data)
  );
  const zero_max = receipts_reply(run_directory, executable, ["--max", "0"]);
  ensure(
    !flag_at(zero_max, "ok") && text_at(zero_max, "error.code") === "invalid_input",
    "cu_macos_smoke_receipts_zero_max:" + JSON.stringify(zero_max)
  );

  // ---- slice 5: the node-level text and geometry reads/writes ----------
  // Linux and Windows have carried these since the AT-SPI / UIA cuts; on
  // macOS every one of them was a PLACEHOLDER refusal until this slice, so
  // the same six verbs now answer on all three backends.
  print("STEP get-extents, select / get-selection and set-caret / get-caret read and write the text area through AX; scroll is a typed refusal that names the actions the node does offer");
  const extents = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "get-extents",
    "--window", handle_text, "--name", "fixture-text"
  ]);
  // An independent AXPosition + AXSize read, not the snapshot's bounds:
  // the reply carries both and they agree on a control that has not moved.
  ensure(
    text_at(extents, "data.via") === "get-extents"
      && text_at(extents, "data.backend") === "ax"
      && int_at(extents, "data.extents.width") > 0
      && int_at(extents, "data.extents.height") > 0
      && int_at(extents, "data.extents.x") === int_at(extents, "data.matched.bounds.x")
      && int_at(extents, "data.extents.y") === int_at(extents, "data.matched.bounds.y")
      && int_at(extents, "data.extents.width") === int_at(extents, "data.matched.bounds.width")
      && int_at(extents, "data.extents.height") === int_at(extents, "data.matched.bounds.height"),
    "cu_macos_smoke_get_extents:" + JSON.stringify(extents.data)
  );

  // `345AXTREE` is nine characters, so 2..6 is a strict interior range and
  // a wrong endpoint could not pass by accident.
  const text_selected = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "select",
    "--window", handle_text, "--name", "fixture-text", "--start", "2", "--end", "6"
  ]);
  ensure(
    text_at(text_selected, "data.via") === "set-selection"
      && int_at(text_selected, "data.start") === 2 && int_at(text_selected, "data.end") === 6,
    "cu_macos_smoke_select:" + JSON.stringify(text_selected.data)
  );
  const selection = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "get-selection",
    "--window", handle_text, "--name", "fixture-text"
  ]);
  ensure(
    text_at(selection, "data.via") === "get-selection"
      && int_at(selection, "data.n") === 1
      && int_at(selection, "data.start") === 2 && int_at(selection, "data.end") === 6,
    "cu_macos_smoke_get_selection:" + JSON.stringify(selection.data)
  );

  const caret = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "set-caret",
    "--window", handle_text, "--name", "fixture-text", "--offset", "4"
  ]);
  ensure(
    text_at(caret, "data.via") === "set-caret-offset" && int_at(caret, "data.offset") === 4,
    "cu_macos_smoke_set_caret:" + JSON.stringify(caret.data)
  );
  const caret_readback = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "get-caret",
    "--window", handle_text, "--name", "fixture-text"
  ]);
  ensure(
    text_at(caret_readback, "data.via") === "get-caret-offset"
      && int_at(caret_readback, "data.offset") === 4,
    "cu_macos_smoke_get_caret:" + JSON.stringify(caret_readback.data)
  );
  // Moving the insertion point collapses the selection: AX carries one
  // range, and `get-selection` reports the AT-SPI shape for "none".
  const collapsed = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "get-selection",
    "--window", handle_text, "--name", "fixture-text"
  ]);
  ensure(
    int_at(collapsed, "data.n") === 0 && int_at(collapsed, "data.start") === 0
      && int_at(collapsed, "data.end") === 0,
    "cu_macos_smoke_selection_collapsed:" + JSON.stringify(collapsed.data)
  );

  // macOS spells `Component.ScrollTo` as the AX action AXScrollToVisible.
  // AppKit does not publish it (measured on NSButton, a plain NSView and
  // NSTableView rows); Chromium and WebKit web content do. A node that does
  // not offer it is refused typed and the refusal names what it does offer,
  // so an agent can tell "not scrollable here" from "verb not implemented".
  const scroll_refusal = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "scroll",
    "--window", handle_text, "--name", "fixture-text"
  ]);
  ensure(
    !flag_at(scroll_refusal, "ok")
      && text_at(scroll_refusal, "error.code") === "a11y_scroll_unavailable"
      && text_at(scroll_refusal, "error.message").indexOf("AXScrollToVisible") >= 0
      && text_at(scroll_refusal, "error.message").indexOf("AXShowMenu") >= 0,
    "cu_macos_smoke_scroll_refusal:" + JSON.stringify(scroll_refusal)
  );

  // A node with no text interface at all separates "no selection" from
  // "not a text control": the press button answers the unavailable code.
  const no_text_selection = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe", "get-selection",
    "--window", handle_text, "--name", "Fixture Press"
  ]);
  ensure(
    !flag_at(no_text_selection, "ok")
      && text_at(no_text_selection, "error.code") === "a11y_selection_unavailable",
    "cu_macos_smoke_selection_unavailable:" + JSON.stringify(no_text_selection)
  );

  print("STEP send-keys enter performs the AX action the chord means and its postcondition advances; a chord with no AX equivalent is a typed refusal, not a keystroke into the void");
  const confirms_before = node_text(run_directory, executable, handle_text, "fixture-confirm-count");
  const confirm_chord = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "send-keys",
    "--window", handle_text, "--name", "fixture-field", "--", "enter"
  ]);
  // `ax-action`, not `device-event`: macOS cannot hand a keystroke to an
  // application it refuses to activate, so the reply must not claim a key
  // was delivered when an AX action was performed instead.
  ensure(
    text_at(confirm_chord, "data.via") === "ax-action"
      && text_at(confirm_chord, "data.keys") === "enter"
      && text_at(confirm_chord, "data.matched.identifier") === "fixture-field",
    "cu_macos_smoke_send_keys_enter:" + JSON.stringify(confirm_chord.data)
  );
  const confirms_after = node_text(run_directory, executable, handle_text, "fixture-confirm-count");
  ensure(
    confirms_before === "confirmed 0" && confirms_after === "confirmed 1",
    "cu_macos_smoke_send_keys_postcondition:" + confirms_before + "->" + confirms_after
  );
  // A chord the control does not offer, and a chord no AX action means at
  // all, are two different refusals and both name what is missing.
  const no_cancel = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "send-keys",
    "--window", handle_text, "--name", "fixture-field", "--", "escape"
  ]);
  ensure(
    !flag_at(no_cancel, "ok")
      && text_at(no_cancel, "error.code") === "a11y_key_unavailable"
      && text_at(no_cancel, "error.message").indexOf("AXCancel") >= 0,
    "cu_macos_smoke_send_keys_no_cancel:" + JSON.stringify(no_cancel)
  );
  const no_equivalent = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "send-keys",
    "--window", handle_text, "--name", "fixture-field", "--", "z"
  ]);
  ensure(
    !flag_at(no_equivalent, "ok")
      && text_at(no_equivalent, "error.code") === "a11y_key_unavailable"
      && text_at(no_equivalent, "error.message").indexOf("active application") >= 0,
    "cu_macos_smoke_send_keys_no_equivalent:" + JSON.stringify(no_equivalent)
  );

  print("STEP invoke set-selected selects a table row and repeats as a verified no-op; cancel and show-default-ui are typed refusals that name the actions the node does offer");
  // A table row is the ordinary macOS control whose selection AX owns. A
  // web `aria-selected` option publishes the state read-only and a plain
  // button publishes none at all, so all three answers differ and each one
  // says which it is.
  const rows = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "query",
    "--window", handle_text, "--role", "AXRow"
  ]);
  ensure(
    int_at(rows, "data.matched") === 3,
    "cu_macos_smoke_rows:" + JSON.stringify(rows.data)
  );
  const selectable_row = text_at(rows.data.nodes[1], "id");
  const row_selected = invoke_ok(
    run_directory, executable, handle_text, ["--node", selectable_row], ["set-selected", "true"]
  );
  ensure(
    flag_at(row_selected, "performed") && flag_at(row_selected, "verified")
      && text_at(row_selected, "verification.method") === "selected-readback"
      && text_at(row_selected, "before.id") === selectable_row,
    "cu_macos_smoke_set_selected:" + JSON.stringify(row_selected)
  );
  // Desired state, so asking again performs nothing and still verifies --
  // the same rule `set-checked` follows.
  const already_selected = invoke_ok(
    run_directory, executable, handle_text, ["--node", selectable_row], ["set-selected", "true"]
  );
  ensure(
    !flag_at(already_selected, "performed") && flag_at(already_selected, "verified"),
    "cu_macos_smoke_set_selected_noop:" + JSON.stringify(already_selected)
  );
  // The other two rows stay unselected, so the write named one node rather
  // than the table.
  const after_rows = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "query",
    "--window", handle_text, "--role", "AXRow"
  ]);
  let rows_marked_selected = 0;
  let rows_marked_unselected = 0;
  for (const node of after_rows.data.nodes) {
    for (const state of node.states) {
      if (state === "selected") { rows_marked_selected = rows_marked_selected + 1; }
      if (state === "unselected") { rows_marked_unselected = rows_marked_unselected + 1; }
    }
  }
  ensure(
    rows_marked_selected === 1 && rows_marked_unselected === 2,
    "cu_macos_smoke_row_states:" + JSON.stringify(after_rows.data.nodes)
  );

  // A node with no selection of its own never reaches the mechanism:
  // `set-selected` is a desired state, so cu refuses it the same way it
  // refuses `set-checked` on a node with no check state -- before acting,
  // naming the state rather than the verb.
  const not_selectable = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "invoke",
    "--window", handle_text, "--identifier", "fixture-press", "set-selected", "true"
  ]);
  ensure(
    !flag_at(not_selectable, "ok")
      && text_at(not_selectable, "error.code") === "unsupported"
      && text_at(not_selectable, "error.detail.reason") === "state_unobservable"
      && text_at(not_selectable, "error.detail.state") === "selected",
    "cu_macos_smoke_set_selected_unobservable:" + JSON.stringify(not_selectable)
  );
  for (const spelling of ["cancel", "show-default-ui"]) {
    const refusal = run_cu_reply(run_directory, executable, [
      "--target", "current", "--grant", "observe,actuate", "invoke",
      "--window", handle_text, "--identifier", "fixture-field", spelling
    ]);
    ensure(
      !flag_at(refusal, "ok")
        && text_at(refusal, "error.code") === "a11y_action_unavailable"
        && text_at(refusal, "error.message").indexOf("AXConfirm") >= 0,
      "cu_macos_smoke_invoke_" + spelling + ":" + JSON.stringify(refusal)
    );
  }

  print("STEP snapshot names one bounded baseline and diff returns only the independently changed node while atomically advancing the baseline");
  const baseline = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "snapshot",
    "--window", handle_text, "--depth", "16", "--max-nodes", "2000"
  ]);
  const baseline_id = text_at(baseline, "data.snapshot_id");
  ensure(
    baseline_id !== "" && int_at(baseline, "data.nodes") > 1
      && !flag_at(baseline, "data.truncated"),
    "cu_macos_smoke_snapshot:" + JSON.stringify(baseline.data)
  );
  invoke_ok(
    run_directory, executable, handle_text,
    ["--identifier", "fixture-text"], ["set-value", "desktop closure delta"]
  );
  const delta = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "diff",
    "--window", handle_text, "--base", baseline_id, "--advance", "--max", "100"
  ]);
  ensure(
    text_at(delta, "data.base.snapshot_id") === baseline_id
      && text_at(delta, "data.base_selected_by") === "explicit"
      && int_at(delta, "data.changes") >= 1
      && int_at(delta, "data.counts.changed") >= 1
      && text_at(delta, "data.next_base") !== ""
      && text_at(delta, "data.next_base") !== baseline_id,
    "cu_macos_smoke_diff:" + JSON.stringify(delta.data)
  );

  print("STEP hit resolves a screen point to the same stable accessibility node, and zoom crops that node's screen rectangle without leaving an implicit full-screen capture");
  const hit_x = int_at(extents, "data.extents.x") + 1;
  const hit_y = int_at(extents, "data.extents.y") + 1;
  const hit = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "hit",
    "--window", handle_text, "--x", "" + hit_x, "--y", "" + hit_y,
    "--depth", "16", "--max-nodes", "2000"
  ]);
  ensure(
    text_at(hit, "data.resolution") === "bounded-walk-hit-test"
      && text_at(hit, "data.node.identifier") === "fixture-text"
      && !flag_at(hit, "data.truncated"),
    "cu_macos_smoke_hit:" + JSON.stringify(hit.data)
  );
  const zoom_path = rh.join(run_directory, "fixture-text-zoom.png");
  const zoom = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "zoom",
    "--window", handle_text,
    "--region", "" + int_at(extents, "data.extents.x") + ","
      + int_at(extents, "data.extents.y") + ","
      + int_at(extents, "data.extents.width") + ","
      + int_at(extents, "data.extents.height"),
    "--out", zoom_path, "--pad", "4"
  ]);
  ensure(
    text_at(zoom, "data.via") === "window-capture-clip"
      && int_at(zoom, "data.output_width") > 0
      && int_at(zoom, "data.output_height") > 0
      && direct_file(zoom_path) && rh.metadata(zoom_path).len > 100,
    "cu_macos_smoke_zoom:" + JSON.stringify(zoom.data)
  );

  print("STEP raise keeps the system frontmost application unchanged; minimize and restore require explicit postconditions and prove the window state by read-back");
  const raised_main = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "raise", "--window", handle_text
  ]);
  ensure(
    flag_at(raised_main, "data.frontmost_app_unchanged")
      && flag_at(raised_main, "data.verified"),
    "cu_macos_smoke_raise:" + JSON.stringify(raised_main.data)
  );
  const minimize_ungated = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "minimize", "--window", handle_text
  ]);
  ensure(
    !flag_at(minimize_ungated, "ok")
      && text_at(minimize_ungated, "error.code") === "refused"
      && text_at(minimize_ungated, "error.detail.effect") === "not_performed",
    "cu_macos_smoke_minimize_ungated:" + JSON.stringify(minimize_ungated)
  );
  const minimized = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "minimize",
    "--window", handle_text, "--expect", "minimized"
  ]);
  ensure(
    flag_at(minimized, "data.verified") && flag_at(minimized, "data.after.minimized")
      && flag_at(minimized, "data.frontmost_app_unchanged"),
    "cu_macos_smoke_minimize:" + JSON.stringify(minimized.data)
  );
  const restored_window = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "restore",
    "--window", handle_text, "--expect", "restored"
  ]);
  ensure(
    flag_at(restored_window, "data.verified")
      && !flag_at(restored_window, "data.after.minimized")
      && flag_at(restored_window, "data.frontmost_app_unchanged"),
    "cu_macos_smoke_restore:" + JSON.stringify(restored_window.data)
  );

  print("STEP app hide / show step a second owned fixture aside and back, and app quit ends it through its own Quit menu item behind the destructive gate");
  // A second fixture, so nothing here disturbs the one the rest of the
  // journey is still using.
  const victim = harness.start({
    program: fixture_executable,
    args: [],
    current_dir: run_directory,
    timeout_ms: 30000
  });
  const victim_pid = harness.spawned_pid(victim);
  const victim_title = "agenterm-ax-fixture-" + victim_pid;
  const victim_wait = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "wait",
    "--timeout-ms", "10000", "--window-title-contains", victim_title
  ]);
  ensure(flag_at(victim_wait, "data.met"), "cu_macos_smoke_app_victim_not_ready");
  const victim_row = fixture_window_row(run_directory, executable, victim_pid, victim_title);
  ensure(victim_row !== null, "cu_macos_smoke_app_victim_window");
  const victim_handle = "" + int_at(victim_row, "handle");

  // Hiding is the application stepping aside: its windows stop being
  // enumerable, which is neither minimizing nor closing.
  const hidden = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "app", "hide", "--window", victim_handle
  ]);
  ensure(
    flag_at(hidden, "data.verified") && int_at(hidden, "data.windows_listed") === 0
      && int_at(hidden, "data.process_id") === victim_pid,
    "cu_macos_smoke_app_hide:" + JSON.stringify(hidden.data)
  );
  // The process is still there -- hidden is not closed.
  ensure(harness.process_present(victim_pid) !== 0, "cu_macos_smoke_app_hide_killed_it");
  // `show` cannot take a window handle: hiding removed the windows, so the
  // pid is the only thing left that names the application.
  const show_without_pid = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "app", "show", "--window", victim_handle
  ]);
  ensure(
    !flag_at(show_without_pid, "ok")
      && text_at(show_without_pid, "error.code") === "invalid_input",
    "cu_macos_smoke_app_show_by_handle:" + JSON.stringify(show_without_pid)
  );
  const shown = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "app", "show", "--pid", "" + victim_pid
  ]);
  ensure(
    flag_at(shown, "data.verified") && int_at(shown, "data.windows_listed") >= 1,
    "cu_macos_smoke_app_show:" + JSON.stringify(shown.data)
  );

  // The destructive gate, exactly as `close` applies it.
  const quit_ungated = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "app", "quit", "--window", victim_handle
  ]);
  ensure(
    !flag_at(quit_ungated, "ok") && text_at(quit_ungated, "error.code") === "refused"
      && text_at(quit_ungated, "error.detail.effect") === "not_performed",
    "cu_macos_smoke_app_quit_ungated:" + JSON.stringify(quit_ungated)
  );
  const quit_wrong_pid = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "app", "quit",
    "--window", victim_handle, "--pid", "1", "--snapshot", "--expect", "gone"
  ]);
  ensure(
    !flag_at(quit_wrong_pid, "ok")
      && text_at(quit_wrong_pid, "error.code") === "window_identity_mismatch"
      && text_at(quit_wrong_pid, "error.detail.effect") === "not_performed",
    "cu_macos_smoke_app_quit_wrong_pid:" + JSON.stringify(quit_wrong_pid)
  );
  ensure(harness.process_present(victim_pid) !== 0, "cu_macos_smoke_app_refusal_killed_it");

  const quit = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "app", "quit",
    "--window", victim_handle, "--pid", "" + victim_pid, "--snapshot", "--expect", "gone"
  ]);
  // The mechanism is the application's own Quit item, named in the reply:
  // a signal would be a kill, and the app would never run its own shutdown.
  ensure(
    flag_at(quit, "data.verified") && flag_at(quit, "data.performed")
      && text_at(quit, "data.verification.method") === "window-inventory-by-pid"
      && quit.data.verification.menu_path.length === 2,
    "cu_macos_smoke_app_quit:" + JSON.stringify(quit.data)
  );
  let victim_exited = 0;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    if (harness.state(victim) === "exited") { victim_exited = 1; break; }
    harness.sleep_ms(25);
  }
  ensure(victim_exited !== 0, "cu_macos_smoke_app_quit_process_lingers");
  const victim_output = harness.wait(victim, 2000);
  ensure(victim_output.exit_code === 0, "cu_macos_smoke_app_quit_exit:" + victim_output.exit_code);
  ensure(harness.process_present(victim_pid) === 0, "cu_macos_smoke_app_quit_orphan");

  print("STEP apps --all lists installed applications a window cannot reveal, and app launch starts one this run owns; its window appears and app quit ends it");
  // The declaration has to keep up with the verbs: a capability block that
  // still says `running_only` with no word about the installed half is the
  // kind of drift a caller plans around.
  ensure(
    text_at(capabilities, "data.verbs.apps.installed") === "available"
      && text_at(capabilities, "data.verbs.app.actions.launch") === "available"
      && capabilities.data.verbs.app.launch_returns_pid === false,
    "cu_macos_smoke_app_declaration:" + JSON.stringify(capabilities.data.verbs.app)
  );
  const inventory = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "apps", "--all"
  ]);
  ensure(
    flag_at(inventory, "data.installed_available")
      && inventory.data.installed_apps.length > 0,
    "cu_macos_smoke_apps_all:" + JSON.stringify(inventory.data.installed_reason)
  );
  // The point of the flag: applications that are installed and NOT running
  // are exactly the ones the window inventory can never show.
  let not_running = 0;
  let rows_have_paths = 1;
  for (const app of inventory.data.installed_apps) {
    if (!flag_at(app, "running")) { not_running = not_running + 1; }
    if (text_at(app, "path") === "" || text_at(app, "name") === "") { rows_have_paths = 0; }
  }
  ensure(
    not_running > 0 && rows_have_paths === 1,
    "cu_macos_smoke_apps_all_rows:" + not_running + ":" + JSON.stringify(inventory.data.installed_apps[0])
  );

  // Launch one this run owns rather than one of the user's.
  const bundle = bundle_fixture(run_directory, fixture_executable);
  const launched = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "app", "launch", "--path", bundle
  ]);
  // The reply says the request was accepted and refuses to claim a pid:
  // LaunchServices owns the process it starts.
  ensure(
    flag_at(launched, "data.requested") && launched.data.pid === null,
    "cu_macos_smoke_app_launch:" + JSON.stringify(launched.data)
  );
  // The window appearing is the only evidence it actually started. It has
  // to be waited for BY APPLICATION: the fixture already running carries
  // the same title shape, so `wait --window-title-contains` would match it
  // instantly and this step would prove nothing about the launch.
  let bundle_windows = null;
  for (let attempt = 0; attempt < 150; attempt = attempt + 1) {
    const probe = run_cu_json(run_directory, executable, [
      "--target", "current", "--grant", "observe", "windows", "--app", "AgentermFixture"
    ]);
    if (int_at(probe, "data.matched") >= 1) { bundle_windows = probe; break; }
    harness.sleep_ms(100);
  }
  ensure(bundle_windows !== null, "cu_macos_smoke_app_launch_no_window");
  const launched_row = bundle_windows.data.windows[0];
  const launched_pid = int_at(launched_row, "process_id");
  const launched_handle = "" + int_at(launched_row, "handle");
  ensure(launched_pid !== fixture_pid, "cu_macos_smoke_app_launch_same_process");

  // Quit what we launched, through its own Quit item and the same gate.
  const bundle_quit = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "app", "quit",
    "--window", launched_handle, "--pid", "" + launched_pid, "--snapshot", "--expect", "gone"
  ]);
  ensure(
    flag_at(bundle_quit, "data.verified")
      && bundle_quit.data.verification.menu_path[0] === "AgentermFixture"
      && bundle_quit.data.verification.menu_path[1] === "Quit AgentermFixture",
    "cu_macos_smoke_app_launch_quit:" + JSON.stringify(bundle_quit.data)
  );
  let launched_gone = 0;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    if (harness.process_present(launched_pid) === 0) { launched_gone = 1; break; }
    harness.sleep_ms(25);
  }
  ensure(launched_gone !== 0, "cu_macos_smoke_app_launch_orphan:" + launched_pid);

  print("STEP SIGTERM ends only the owned fixture, which exits 0 and is reaped");
  const terminated = rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  ensure(terminated.success === true, "cu_macos_smoke_fixture_terminate:" + terminated.stderr);
  let fixture_exited = 0;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    if (harness.state(fixture) === "exited") {
      fixture_exited = 1;
      break;
    }
    harness.sleep_ms(25);
  }
  ensure(fixture_exited !== 0, "cu_macos_smoke_fixture_exit_timeout");
  const fixture_output = harness.wait(fixture, 2000);
  fixture_reaped = true;
  ensure(
    fixture_output.success === true && fixture_output.exit_code === 0,
    "cu_macos_smoke_fixture_exit:" + JSON.stringify(fixture_output)
  );
  const ready_parts = fixture_output.stdout.trim().split(" ");
  ensure(
    ready_parts.length === 2 && ready_parts[0] === "ready"
      && rh.parse_int("" + ready_parts[1]) === fixture_pid,
    "cu_macos_smoke_fixture_ready:" + fixture_output.stdout
  );
  ensure(harness.process_present(fixture_pid) === 0, "cu_macos_smoke_fixture_orphan");
  const gone = run_cu_json(
    run_directory,
    executable,
    ["--target", "current", "--grant", "observe", "windows", "--pid", "" + fixture_pid]
  );
  ensure(int_at(gone, "data.matched") === 0, "cu_macos_smoke_fixture_window_lingers");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture >= 0 && !fixture_reaped) {
  // Only the pid this run spawned; never a name pattern.
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  let reaped = false;
  try {
    const output = harness.wait(fixture, 3000);
    reaped = output !== null;
  } catch (wait_error) {
    reaped = false;
  }
  if (!reaped && fixture_pid !== 0) {
    rh.command("kill", ["-KILL", "" + fixture_pid], { timeout_ms: 5000 });
    try { harness.wait(fixture, 3000); } catch (kill_error) { failure = failure + ":cu_macos_smoke_fixture_unreaped"; }
  }
}

if (succeeded === 0) {
  if (!remove_directory_bounded(run_directory)) {
    failure = failure + ":cu_macos_smoke_cleanup_locked";
  }
  harness.remove_run(context);
  throw failure;
}

ensure(remove_directory_bounded(run_directory), "cu_macos_smoke_cleanup_locked");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-capabilities");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-window-identity");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-query");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-tree-bounded");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-tree-actions");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-invoke-set-value");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-invoke-set-checked");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-invoke-press");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-invoke-value-readback");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-invoke-refusals");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-menu-inspect");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-menu-invoke");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-focused");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-observe");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-observe-notifications");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-click");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-screenshot");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-frame");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-destructive-refusals");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-destructive-close");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-receipts");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-node-text-geometry");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-send-keys");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-mcu-actions");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-stacking");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-app-lifecycle");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-app-inventory");
harness.emit_evidence(context, declared_evidence, "cu.macos-process-state");
harness.emit_evidence(context, declared_evidence, "cu.macos-process-usage");
harness.emit_evidence(context, declared_evidence, "cu.macos-process-wait");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-snapshot-diff");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-hit-zoom");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-window-state");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-raise");
harness.emit_evidence(context, declared_evidence, "cu.macos-ax-fixture-cleanup");
harness.remove_run(context);
print("PASS: agenterm-cu macOS AX journey (capabilities, windows, query, bounded tree, invoke, verify, menu, focused, observe, click, frame, snapshot/diff, hit/zoom, raise, minimize/restore, close, receipts)");
return;
