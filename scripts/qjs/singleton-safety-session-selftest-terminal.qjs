// Shard C of the browser-session -> ownership selftest: the terminal seat --
// finish/abort wrapping, cleanup-deadline failures, the removal proof and the
// status2 owner/browser exact-match refusals.
//
// This shard imports ONLY the support library: it never reaches the runner or the
// session module directly, so the runner is inlined once and that one reach is the
// one `session` already had.
//
// Owned root: target/singleton-safety-session-selftest-c (independent from the
// other shards' roots). Removed on success and failure.
import * as fx from "lib/singleton_safety_session_selftest_support";

const PIECE = "c";

function require(condition, message) { if (!condition) { throw message; } }

function test_session_to_ownership(template) {
  // P1-1: the public finish wraps session cleanup exactly once, then native finish.
  const wrap_root = fx.piece_path(PIECE, "run-wrap");
  const wrap_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3,
    expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  const wrap_ctx = fx.context(wrap_root);
  const ok_ctx = fx.session_to_ownership_ok(fx.session_executor(fx.replies(), null), wrap_ad, template, wrap_ctx);
  const finished = ok_ctx.finish();
  require(finished.checkpoint === "native-finished" && wrap_ctx.state.finished === 1, "session_finish_wraps_once");
  require(wrap_ctx.terminal_owned === true, "session_terminal_owned");

  // E1b: a finish whose session cleanup FAILS must not claim a finished run; it
  // drives the native abort (root retained) and surfaces both failures.
  const failroot = fx.piece_path(PIECE, "run-finishfail");
  const fail_ctx = fx.context(failroot);
  const fail_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3,
    expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  // start/status succeed, but stop/remove fail as transport errors.
  const fail_exec = fx.session_executor(fx.replies({ stop: { exit_code: 1, stdout: "", stderr: "x" },
    remove: { exit_code: 1, stdout: "", stderr: "x" } }), null);
  const ok_ctx2 = fx.session_to_ownership(fail_exec.run, fail_ad, template, fail_ctx, fx.session_options(failroot));
  let seen_finfail = null;
  try { ok_ctx2.finish(); } catch (e) { seen_finfail = e; }
  require(seen_finfail !== null && seen_finfail.primary === "session_finish_cleanup_failed",
          "session_finish_cleanup_not_success:" + JSON.stringify(seen_finfail));
  require(fail_ctx.state.finished === 0 && fail_ctx.state.root_removed === false && fail_ctx.state.aborted === true,
          "session_finish_failure_retains_root");

  // E1b: a native abort's OWN cleanup failures are merged, not dropped.
  const abortroot = fx.piece_path(PIECE, "run-abortmerge");
  const abort_ctx = fx.context(abortroot, { native_abort_failures_count: 2 });
  const abort_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3,
    expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  const ok_ctx3 = fx.session_to_ownership(fx.session_executor(fx.replies(), null).run, abort_ad, template, abort_ctx, fx.session_options(abortroot));
  let seen_abortmerge = null;
  try { ok_ctx3.abort("later"); } catch (e) { seen_abortmerge = e; }
  require(seen_abortmerge !== null && fx.has_item(seen_abortmerge.cleanup_failures, "native_abort:0")
          && fx.has_item(seen_abortmerge.cleanup_failures, "native_abort:1"),
          "session_abort_native_failures_merged:" + JSON.stringify(seen_abortmerge));

  // E1c P0-1: removal is proven ONLY by the exact typed not_found. A transport
  // failure AFTER remove is not absent -> remove_not_effective (red, not false-green).
  const transport_after = fx.session_executor(fx.replies(), null);
  let after_remove = 0;
  const ta = { seen: [], run: function (argv, ms) {
    let verb = "";
    for (let i = 0; i < argv.length; i = i + 1) {
      if (argv[i] === "browser-session-remove") { verb = "remove"; }
      else if (argv[i] === "browser-session-status") { verb = "status"; }
    }
    if (verb === "remove") { after_remove = 1; return transport_after.run(argv, ms); }
    if (verb === "status" && after_remove === 1) { return { exit_code: 1, stdout: "", stderr: "transport" }; }
    return transport_after.run(argv, ms); } };
  let seen_transport = null;
  const tc = fx.context(fx.piece_path(PIECE, "run-transport"));
  try {
    const tctx = fx.session_to_ownership(ta.run, fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3, expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }), template, tc, fx.session_options(fx.piece_path(PIECE, "run-transport")));
    tctx.finish();
  } catch (e) { seen_transport = e; }
  // E1d P0: an unknown after remove must NOT skip the native abort: the terminal
  // records the query failure, the native abort runs (aborted=true), the run is not
  // finished and the root is retained, and the ORIGINAL primary survives.
  require(seen_transport !== null && tc.state.aborted === true && tc.state.finished === 0
          && tc.state.root_removed === false, "session_transport_after_remove_native_abort:" + JSON.stringify(seen_transport));
  require(seen_transport.primary === "session_finish_cleanup_failed", "session_transport_primary:" + JSON.stringify(seen_transport));
  let saw_remove_unknown = false;
  for (let i = 0; i < seen_transport.cleanup_failures.length; i = i + 1) {
    if (seen_transport.cleanup_failures[i].indexOf("session_remove_after_unknown:") === 0) { saw_remove_unknown = true; }
  }
  require(saw_remove_unknown, "session_transport_query_failure_recorded:" + JSON.stringify(seen_transport));

  // E1d P0: an unknown BEFORE remove (status query transport loss before the first
  // remove) is likewise a failure, not a silent pass, and reaches the native abort.
  let status_calls = 0;
  const before_unknown = { seen: [], run: function (argv, ms) {
    let status = false;
    for (let i = 0; i < argv.length; i = i + 1) { if (argv[i] === "browser-session-status") { status = true; } }
    if (status) { status_calls = status_calls + 1; if (status_calls >= 3) { return { exit_code: 1, stdout: "", stderr: "transport" }; } }
    return fx.session_executor(fx.replies(), null).run(argv, ms); } };
  const bu_ctx = fx.context(fx.piece_path(PIECE, "run-beforeunknown"));
  let seen_before = null;
  try {
    const bctx = fx.session_to_ownership(before_unknown.run, fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3, expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }), template, bu_ctx, fx.session_options(fx.piece_path(PIECE, "run-beforeunknown")));
    bctx.finish();
  } catch (e) { seen_before = e; }
  require(seen_before !== null && bu_ctx.state.aborted === true && bu_ctx.state.root_removed === false,
          "session_before_unknown_native_abort:" + JSON.stringify(seen_before));

  // E1d P1: a latest-state with an EXTRA root key is refused.
  const bad_roots_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3, expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid, roots_extra: true });
  let seen_roots = null;
  try {
    fx.session_to_ownership(fx.session_executor(fx.replies(), null).run, bad_roots_ad, template,
      fx.context(fx.piece_path(PIECE, "run-rootsextra")), fx.session_options(fx.piece_path(PIECE, "run-rootsextra")));
  } catch (e) { seen_roots = e; }
  require(seen_roots !== null && ("" + fx.session_primary(seen_roots)).indexOf("latest_state_root_key_count") !== -1,
          "session_roots_extra_refused:" + JSON.stringify(seen_roots));
  // E1c P0-2: a second terminal call performs no extra stop/remove.
  const once_root = fx.piece_path(PIECE, "run-once");
  const once_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3, expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  const once_exec = fx.session_executor(fx.replies(), null);
  const once_ctx = fx.session_to_ownership(once_exec.run, once_ad, template, fx.context(once_root), fx.session_options(once_root));
  once_ctx.finish();
  const stop_len_before = once_exec.seen.length;
  fx.expect_throw(function () { once_ctx.finish(); }, "terminal_second_finish");
  require(once_exec.seen.length === stop_len_before, "terminal_second_finish_no_calls");

  // E1c P0-2: a clean abort still throws and retains the primary.
  const clean_abort_root = fx.piece_path(PIECE, "run-cleanabort");
  const ca_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3, expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  const ca_ctx = fx.session_to_ownership(fx.session_executor(fx.replies(), null).run, ca_ad, template, fx.context(clean_abort_root), fx.session_options(clean_abort_root));
  let seen_cleanabort = null;
  try { ca_ctx.abort("clean-abort"); } catch (e) { seen_cleanabort = e; }
  require(seen_cleanabort !== null && seen_cleanabort.primary === "clean-abort", "session_clean_abort_throws");

  // E1c P0-3: the stop argv reflects the configured stop_timeout (never a hard cap).
  const st_root = fx.piece_path(PIECE, "run-stoptimeout");
  const st_exec = fx.session_executor(fx.replies(), null);
  const st_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3, expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  const st_ctx = fx.session_to_ownership(st_exec.run, st_ad, template, fx.context(st_root), fx.session_options(st_root, { stop_timeout_ms: 7000, cleanup_budget_ms: 40000 }));
  st_ctx.finish();
  let saw_stop_7000 = false;
  for (let i = 0; i < st_exec.seen.length; i = i + 1) {
    const a = st_exec.seen[i].argv;
    for (let j = 0; j < a.length - 1; j = j + 1) { if (a[j] === "--timeout-ms" && a[j + 1] === "7000") { saw_stop_7000 = true; } }
  }
  require(saw_stop_7000, "session_stop_timeout_argv");

  // E1c P1: an owner/browser identity with an EXTRA key is refused.
  let seen_extra = null;
  const extra_status = fx.reply("browser-session-status", fx.session_data("ready", "live", fx.browser_obj));
  extra_status.stdout = fx.canonical({ ok: true, target: "current", command: "browser-session-status", data: {
    schema_version: 1, generation: 1, name: fx.subject, session_nonce: "0123456789abcdef", state: "ready",
    owner: { pid: fx.owner_pid, start_identity: fx.owner_identity }, owner_spawn_mode: "detached",
    profile_identity: { device: 1, inode: 2 }, owner_observation: "live", owned: true,
    browser: { pid: fx.browser_pid, start_identity: fx.browser_identity, extra: 1 } } });
  try {
    fx.session_to_ownership(fx.session_executor(fx.replies({ status: extra_status }), null).run,
      fx.session_adapter({ expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }), template,
      fx.context(fx.piece_path(PIECE, "run-extra")), fx.session_options(fx.piece_path(PIECE, "run-extra")));
  } catch (e) { seen_extra = e; }
  require(seen_extra !== null && ("" + fx.session_primary(seen_extra)).indexOf("session_browser_key_count") !== -1,
          "session_nested_extra_refused:" + JSON.stringify(seen_extra));

  // E1e P0-2: the cleanup DEADLINE construction can throw (clock failure); the
  // wrapper records it and STILL reaches the native abort with the root retained.
  const dlroot = fx.piece_path(PIECE, "run-deadlinefail");
  const dl_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3,
    expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  const dl_ctx = fx.session_to_ownership_ok(fx.session_executor(fx.replies(), null), dl_ad, template, fx.context(dlroot));
  dl_ad.arm_now_throw(0);
  let seen_dl = null;
  try { dl_ctx.finish(); } catch (e) { seen_dl = e; }
  require(seen_dl !== null && dl_ctx.state.aborted === true && dl_ctx.state.finished === 0
          && dl_ctx.state.root_removed === false, "session_deadline_failure_native_abort:" + JSON.stringify(seen_dl));
  require(fx.count_item(seen_dl.cleanup_failures, "session_cleanup_prepare:clock_failed") === 1,
          "session_deadline_failure_recorded_once:" + JSON.stringify(seen_dl));

  // E1e P0-2: cleanup_session ITSELF can throw (clock failure AFTER construction);
  // it is recorded as a cleanup failure and the native abort still runs.
  const csroot = fx.piece_path(PIECE, "run-cleanupthrow");
  const cs_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3,
    expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  const cs_ctx = fx.session_to_ownership_ok(fx.session_executor(fx.replies(), null), cs_ad, template, fx.context(csroot));
  cs_ad.arm_now_throw(1);
  let seen_cs = null;
  try { cs_ctx.finish(); } catch (e) { seen_cs = e; }
  require(seen_cs !== null && cs_ctx.state.aborted === true && cs_ctx.state.root_removed === false,
          "session_cleanup_throw_native_abort:" + JSON.stringify(seen_cs));
  require(fx.count_item(seen_cs.cleanup_failures, "session_cleanup_unknown:clock_failed") === 1,
          "session_cleanup_throw_recorded_once:" + JSON.stringify(seen_cs));

  // E1e P0-3/P0-4: a structured primary carrying cleanup_failures is merged into the
  // upstream BEFORE the native abort, so the root is retained and each failure is
  // counted EXACTLY once (no append-double-count).
  const sproot = fx.piece_path(PIECE, "run-structured");
  const sp_ctx = fx.context(sproot);
  const sp_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3,
    expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  const sp_exec = { seen: [], run: function (argv, ms) {
    const e = { primary: "structured_boom", cleanup_failures: [] };
    e.cleanup_failures.push("step_a"); e.cleanup_failures.push("step_b");
    throw e; } };
  let seen_sp = null;
  try {
    fx.session_to_ownership(sp_exec.run, sp_ad, template, sp_ctx, fx.session_options(sproot));
  } catch (e) { seen_sp = e; }
  require(seen_sp !== null && sp_ctx.state.aborted === true && sp_ctx.state.root_removed === false,
          "session_structured_primary_retains_root:" + JSON.stringify(seen_sp));
  require(fx.count_item(seen_sp.cleanup_failures, "step_a") === 1 && fx.count_item(seen_sp.cleanup_failures, "step_b") === 1,
          "session_structured_failures_exactly_once:" + JSON.stringify(seen_sp));
  require("" + fx.session_primary(seen_sp) === "structured_boom",
          "session_structured_primary_preserved:" + JSON.stringify(seen_sp));

  // E1e P0-3: a wrapper abort whose reason carries cleanup_failures merges them into
  // the upstream before the native abort (each exactly once).
  const wrroot = fx.piece_path(PIECE, "run-wrapperreason");
  const wr_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3,
    expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  const wr_ctx = fx.session_to_ownership_ok(fx.session_executor(fx.replies(), null), wr_ad, template, fx.context(wrroot));
  let seen_wr = null;
  try { wr_ctx.abort({ primary: "wrapper_reason", cleanup_failures: ["rr1", "rr2"] }); } catch (e) { seen_wr = e; }
  require(seen_wr !== null && wr_ctx.state.aborted === true && wr_ctx.state.root_removed === false,
          "session_wrapper_reason_retains_root:" + JSON.stringify(seen_wr));
  require(fx.count_item(seen_wr.cleanup_failures, "rr1") === 1 && fx.count_item(seen_wr.cleanup_failures, "rr2") === 1,
          "session_wrapper_reason_failures_once:" + JSON.stringify(seen_wr));
  require("" + fx.session_primary(seen_wr) === "wrapper_reason",
          "session_wrapper_reason_primary:" + JSON.stringify(seen_wr));

  // E1e P1-1: status2's OWNER is exact-validated and byte-matched against status1.
  // A second-status override executor returns a mutated reply on the 2nd status call.
  function status2_owner(owner) {
    const d = fx.session_data("ready", "live", fx.browser_obj);
    d.owner = owner;
    return d;
  }
  function status2_browser(browser) {
    const d = fx.session_data("ready", "live", fx.browser_obj);
    d.browser = browser;
    return d;
  }
  function second_status(second) {
    let n = 0;
    return { seen: [], run: function (argv, ms) {
      let is_status = false;
      for (let i = 0; i < argv.length; i = i + 1) { if (argv[i] === "browser-session-status") { is_status = true; } }
      if (is_status) { n = n + 1; if (n === 2) { return second; } }
      return fx.session_executor(fx.replies(), null).run(argv, ms); } };
  }
  const owner_extra2 = fx.reply("browser-session-status", status2_owner({ pid: fx.owner_pid, start_identity: fx.owner_identity, extra: 1 }));
  let seen_owner2 = null;
  try {
    fx.session_to_ownership(second_status(owner_extra2).run,
      fx.session_adapter({ expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }), template,
      fx.context(fx.piece_path(PIECE, "run-owner2extra")), fx.session_options(fx.piece_path(PIECE, "run-owner2extra")));
  } catch (e) { seen_owner2 = e; }
  require(seen_owner2 !== null && ("" + fx.session_primary(seen_owner2)).indexOf("session_owner2_key_count") !== -1,
          "session_owner2_extra_refused:" + JSON.stringify(seen_owner2));

  const owner_changed2 = fx.reply("browser-session-status", status2_owner({ pid: fx.owner_pid, start_identity: "macos-start-time:1.1" }));
  let seen_ownerchg = null;
  try {
    fx.session_to_ownership(second_status(owner_changed2).run,
      fx.session_adapter({ expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }), template,
      fx.context(fx.piece_path(PIECE, "run-owner2chg")), fx.session_options(fx.piece_path(PIECE, "run-owner2chg")));
  } catch (e) { seen_ownerchg = e; }
  require(seen_ownerchg !== null && ("" + fx.session_primary(seen_ownerchg)).indexOf("session_owner_identity_changed") !== -1,
          "session_owner2_identity_changed:" + JSON.stringify(seen_ownerchg));

  const browser_changed2 = fx.reply("browser-session-status", status2_browser({ pid: fx.browser_pid, start_identity: "macos-start-time:1.1" }));
  let seen_browserchg = null;
  try {
    fx.session_to_ownership(second_status(browser_changed2).run,
      fx.session_adapter({ expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }), template,
      fx.context(fx.piece_path(PIECE, "run-browser2chg")), fx.session_options(fx.piece_path(PIECE, "run-browser2chg")));
  } catch (e) { seen_browserchg = e; }
  require(seen_browserchg !== null && ("" + fx.session_primary(seen_browserchg)).indexOf("session_browser_identity_changed") !== -1,
          "session_browser2_identity_changed:" + JSON.stringify(seen_browserchg));
}

function run() {
  const template = fx.load_template();
  fx.create_dir_all(fx.piece_root(PIECE));
  fx.with_piece_cleanup(PIECE, function () {
    test_session_to_ownership(template);
  });
  print("singleton-safety session selftest (terminal) ok");
  return 0;
}

return run();
