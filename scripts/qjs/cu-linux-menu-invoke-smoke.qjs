// CEO#3: GTK menu invoke by AT-SPI menu path on the owned fixture.
// Acceptance is smoke read-back only: menu inspect paths/states, invoke
// changes the menu label, disabled items are refused typed, and a checkable
// item round-trips its mark. Typed menu-invoke usage must reject AT-SPI
// --name, --coords, --bogus, and other unexpected arguments via
// usage_rejects_unexpected (or an honest non-usage typed failure; never fake
// command=usage). Typed get-extents --name usage AND host-limit courts must
// both hold before process-state, desktop-state, and the actuate/read-back
// court (no if/else gating those courts on atspi_available); get-extents
// --coords/--bogus must reject as command=usage. process-state and
// desktop-state fixture binding courts must hold before actuate/read-back.
// Typed usage and AT-SPI host-limit paths must hold when the independent
// pyatspi desktop probe is unavailable. Prefer host-limit clarity over fake
// success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-menu-inspect",
  "cu.linux-atspi-menu-invoke",
];

const AT_SPI_PROBE_NAME = "Menu Invoke Court Anchor";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_menu_invoke_empty:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(document), "cu_linux_menu_invoke_cli:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_menu_invoke_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function assert_menu_invoke_usage_limit(run_directory, executable, env) {
  const flat_with_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu-invoke", "--window", "1", "--path", "File/Do Thing", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_menu_invoke_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_menu_invoke_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_menu_invoke_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_name, "error.message"), "--name"),
    "cu_linux_menu_invoke_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", "1", "--path", "File/Do Thing", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_menu_invoke_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_menu_invoke_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "command") === "usage",
    "cu_linux_menu_invoke_usage_grouped_name_command:" + JSON.stringify(grouped_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_name, "error.message"), "--name"),
    "cu_linux_menu_invoke_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const zero_window = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", "0", "--path", "File/Do Thing",
  ], env);
  ensure(!output_success(zero_window),
    "cu_linux_menu_invoke_usage_zero_window_ok:" + JSON.stringify(zero_window));
  ensure(
    text_at(zero_window, "error.code") === "usage",
    "cu_linux_menu_invoke_usage_zero_window_code:" + JSON.stringify(zero_window.error)
  );
  ensure(
    text_at(zero_window, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_menu_invoke_usage_zero_window_message:" + JSON.stringify(zero_window.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", "1", "--path", "File/Do Thing", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_menu_invoke_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_menu_invoke_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_menu_invoke_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_menu_invoke_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const flat_with_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu-invoke", "--window", "1", "--path", "File/Do Thing", "--coords", "10,10",
  ], env);
  ensure(!output_success(flat_with_coords),
    "cu_linux_menu_invoke_usage_flat_coords_ok:" + JSON.stringify(flat_with_coords));
  ensure(
    text_at(flat_with_coords, "error.code") === "usage",
    "cu_linux_menu_invoke_usage_flat_coords_code:" + JSON.stringify(flat_with_coords.error)
  );
  ensure(
    text_at(flat_with_coords, "command") === "usage",
    "cu_linux_menu_invoke_usage_flat_coords_command:" + JSON.stringify(flat_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_coords, "error.message"), "--coords"),
    "cu_linux_menu_invoke_usage_flat_coords_message:" + JSON.stringify(flat_with_coords.error)
  );

  const grouped_with_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", "1", "--path", "File/Do Thing", "--coords", "10,10",
  ], env);
  ensure(!output_success(grouped_with_coords),
    "cu_linux_menu_invoke_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_menu_invoke_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    text_at(grouped_with_coords, "command") === "usage",
    "cu_linux_menu_invoke_usage_grouped_coords_command:" + JSON.stringify(grouped_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_coords, "error.message"), "--coords"),
    "cu_linux_menu_invoke_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_menu_invoke_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_menu_invoke_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_menu_invoke_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_menu_invoke_extents_missing_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_menu_invoke_extents_missing_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_menu_invoke_extents_missing_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_menu_invoke_extents_missing_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_menu_invoke_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_menu_invoke_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_menu_invoke_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_menu_invoke_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_menu_invoke_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_menu_invoke_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_menu_invoke_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_menu_invoke_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_menu_invoke_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_menu_invoke_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_menu_invoke_extents_unavailable_code:" + code
  );
}

function assert_menu_invoke_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", "1", "--path", "File/Do Thing",
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_menu_invoke_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_menu_invoke_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle",
    "cu_linux_menu_invoke_unavailable_code:" + code
  );
  if (code === "a11y_backend_failed") {
    const message = text_at(reply, "error.message").toLowerCase();
    ensure(
      message.indexOf("accessibility") >= 0
        || message.indexOf("address") >= 0
        || message.indexOf("bus") >= 0,
      "cu_linux_menu_invoke_unavailable_message:" + JSON.stringify(reply.error)
    );
  }
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_menu_invoke_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_menu_invoke_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_menu_invoke_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_menu_invoke_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_menu_invoke_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function tree_nodes(run_directory, executable, handle_text, depth) {
  const reply = run_cu(run_directory, executable, "observe", [
    "tree", "--window", handle_text, "--depth", depth,
  ]);
  return reply.data.nodes;
}

function label_text(run_directory, executable, handle_text, prefix) {
  const nodes = tree_nodes(run_directory, executable, handle_text, "8");
  for (const node of nodes) {
    if (("" + node.role) !== "label") { continue; }
    const name = "" + node.name;
    if (name.startsWith(prefix)) { return name; }
  }
  return "";
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_menu_invoke_executable_missing");
const context = harness.new_context(repo, "cu-linux-menu-invoke");
const run_directory = rh.join(repo, "target/cu-linux-menu-invoke-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_menu_invoke_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP menu invoke typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present (usage_rejects_unexpected or honest non-usage typed failure; never fake command=usage)");
  assert_menu_invoke_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (command=usage) before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP menu invoke typed-fail host-limit on invalid AT-SPI bus before process-state/desktop-state and actuate/read-back court");
  assert_menu_invoke_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held");
    harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-menu-inspect");
    harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-menu-invoke");
    succeeded = 1;
  } else {
    print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_menu_invoke_window_wait");
    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_menu_invoke_window_identity");
    const handle_text = "" + int_at(row, "handle");
    ensure(int_at(row, "handle") > 0, "cu_linux_menu_invoke_handle:" + JSON.stringify(row));

    print("STEP process-state binds the owned fixture pid before menu invoke actuate/read-back court");
    assert_fixture_process_state(run_directory, executable, fixture_pid);

    print("STEP desktop-state window row agrees with inventory before menu invoke actuate/read-back court");
    assert_fixture_desktop_state(
      run_directory, executable, fixture_pid, fixture_title, handle_text, row
    );

    print("STEP menu inspect walks the background menu bar and reports the paths menu invoke accepts");
    const menu = run_cu(run_directory, executable, "observe", [
      "menu", "inspect", "--window", handle_text,
    ]);
    const items = menu.data.items;
    ensure(items.length >= 4, "cu_linux_menu_invoke_menu_items:" + JSON.stringify(items));
    let saw_bar_entry = 0;
    let saw_do_thing = 0;
    let saw_disabled = 0;
    let saw_checkable = 0;
    for (const item of items) {
      const path = item.path.join("/");
      if (path === "File") { saw_bar_entry = 1; }
      if (path === "File/Do Thing") { saw_do_thing = item.enabled === true ? 1 : 0; }
      if (path === "File/Disabled Thing") { saw_disabled = item.enabled === false ? 1 : 0; }
      if (path === "File/Marked Thing") { saw_checkable = 1; }
    }
    ensure(
      saw_bar_entry === 1 && saw_do_thing === 1 && saw_disabled === 1 && saw_checkable === 1,
      "cu_linux_menu_invoke_menu_shape:" + JSON.stringify(items)
    );
    harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-menu-inspect");

    print("STEP menu invoke presses File/Do Thing and the menu label read-back changes");
    const menu_before = label_text(run_directory, executable, handle_text, "menu idle");
    ensure(menu_before === "menu idle", "cu_linux_menu_invoke_menu_label_before:" + menu_before);
    const invoked = run_cu(run_directory, executable, "observe,actuate", [
      "menu", "invoke", "--window", handle_text, "--path", "File/Do Thing",
    ]);
    ensure(flag_at(invoked, "data.performed"), "cu_linux_menu_invoke_performed:" + JSON.stringify(invoked.data));
    ensure(
      label_text(run_directory, executable, handle_text, "did thing ") === "did thing 1",
      "cu_linux_menu_invoke_menu_label_after"
    );

    print("STEP disabled menu item is refused typed with nothing performed");
    const menu_refused = run_cu_reply(run_directory, executable, "observe,actuate", [
      "menu", "invoke", "--window", handle_text, "--path", "File/Disabled Thing",
    ]);
    ensure(
      !flag_at(menu_refused, "ok") && text_at(menu_refused, "error.code") === "a11y_menu_item_disabled",
      "cu_linux_menu_invoke_menu_disabled:" + JSON.stringify(menu_refused)
    );
    ensure(
      label_text(run_directory, executable, handle_text, "did thing ") === "did thing 1",
      "cu_linux_menu_invoke_menu_disabled_side_effect"
    );

    print("STEP checkable menu item round-trips its mark through menu invoke");
    const marked_on = run_cu(run_directory, executable, "observe,actuate", [
      "menu", "invoke", "--window", handle_text, "--path", "File/Marked Thing",
    ]);
    ensure(
      text_at(marked_on, "data.mark_after").length === 1
        && text_at(marked_on, "data.mark_before") === "",
      "cu_linux_menu_invoke_mark_on:" + JSON.stringify(marked_on.data)
    );
    const marked_off = run_cu(run_directory, executable, "observe,actuate", [
      "menu", "invoke", "--window", handle_text, "--path", "File/Marked Thing",
    ]);
    ensure(
      text_at(marked_off, "data.mark_before").length === 1
        && text_at(marked_off, "data.mark_after") === "",
      "cu_linux_menu_invoke_mark_off:" + JSON.stringify(marked_off.data)
    );
    harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-menu-invoke");

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_menu_invoke_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: CEO#3 Linux GTK menu invoke by AT-SPI path (inspect + label/mark read-back with typed menu-invoke --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), and process-state/desktop-state courts before actuate; AT-SPI --name, no --coords)");
} else {
  print("PASS: CEO#3 Linux menu invoke typed-fails with typed menu-invoke --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage) and get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
}
return;
