// CEO#3: Chrome focus → send-text SEED → get-text == SEED on Linux.
// Acceptance is independent AT-SPI --name read-back only; no --coords or
// screenshot. send-text may write through Chrome CDP AX set-value when
// EditableText is absent; get-text must still poll Text.GetText.
// Typed focus/send-text/get-text usage must reject missing --window/--name and
// --coords/--bogus misuse with usage_rejects_unexpected + command=usage, or an
// honest non-usage typed failure (never fake command=usage), or stay on named
// AT-SPI — never coordinate degradation. Typed get-extents --name usage AND
// host-limit paths must both hold before process-state, desktop-state, and the
// chrome/send-text actuate/read-back court (no if/else gating those courts on
// atspi_available); get-extents --coords/--bogus must reject as command=usage.
// process-state and desktop-state fixture binding courts must hold before
// actuate/read-back. Miss paths must not mutate the field (independent
// get-text read-back). Prefer host-limit clarity over fake success.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-chrome-text-focus",
  "cu.linux-chrome-text-send-text",
  "cu.linux-chrome-text-get-text",
];

const FIELD_NAME = "GetTextField";
const MISSING_NODE = "No Such GetTextField";
const AT_SPI_PROBE_NAME = "Chrome Text Court Anchor";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function honest_actuate_non_usage_code(code) {
  return code === "a11y_backend_failed"
    || code === "unsupported"
    || code === "bad_handle"
    || code === "window_not_found"
    || code === "a11y_window_gone"
    || code === "invalid_input"
    || code === "a11y_focus_unavailable"
    || code === "a11y_node_not_found";
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function reply_avoids_coords_degradation(document) {
  const encoded = JSON.stringify(document);
  return encoded.indexOf("coordinate") < 0 && encoded.indexOf("XTest") < 0;
}

function assert_usage_or_honest_non_usage(reply, label, token) {
  ensure(!output_success(reply),
    "cu_linux_chrome_text_" + label + "_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  const command = text_at(reply, "command");
  if (code === "usage" || command === "usage") {
    ensure(
      code === "usage",
      "cu_linux_chrome_text_" + label + "_code:" + JSON.stringify(reply.error)
    );
    ensure(
      command === "usage",
      "cu_linux_chrome_text_" + label + "_command:" + JSON.stringify(reply)
    );
    ensure(
      usage_rejects_unexpected(text_at(reply, "error.message"), token)
        || text_at(reply, "error.message").indexOf("--name") >= 0,
      "cu_linux_chrome_text_" + label + "_message:" + JSON.stringify(reply.error)
    );
  } else {
    ensure(
      command !== "usage" && honest_actuate_non_usage_code(code),
      "cu_linux_chrome_text_" + label + "_honest:" + JSON.stringify(reply)
    );
  }
  ensure(
    reply_avoids_coords_degradation(reply),
    "cu_linux_chrome_text_" + label + "_degraded:" + JSON.stringify(reply)
  );
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_chrome_text_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, cu_args, env) {
  const document = run_cu_reply(run_directory, executable, grant, cu_args, env);
  ensure(output_success(document), "cu_linux_chrome_text_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_chrome_text_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_cu_windows_enum_available(run_directory, executable, env) {
  const reply = run_cu_reply(run_directory, executable, "observe", ["windows"], env);
  if (output_success(reply)) { return { available: true }; }
  const message = text_at(reply, "error.message");
  if (message.indexOf("Maximum number of clients reached") >= 0
      || message.indexOf("window_enum_failed") >= 0) {
    return { available: false, reason: "x11_window_enum_unavailable" };
  }
  return { available: false, reason: message };
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_chrome_text_usage_limit(run_directory, executable) {
  const send_missing_window = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--name", FIELD_NAME, "--", "probe",
  ]);
  ensure(!output_success(send_missing_window),
    "cu_linux_chrome_text_send_usage_ok:" + JSON.stringify(send_missing_window));
  ensure(
    text_at(send_missing_window, "error.code") === "invalid_input",
    "cu_linux_chrome_text_send_usage_code:" + JSON.stringify(send_missing_window.error)
  );
  ensure(
    text_at(send_missing_window, "error.message").indexOf("--window") >= 0,
    "cu_linux_chrome_text_send_usage_message:" + JSON.stringify(send_missing_window.error)
  );

  const send_role_without_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "1", "--role", "entry", "--", "probe",
  ]);
  ensure(!output_success(send_role_without_name),
    "cu_linux_chrome_text_send_role_ok:" + JSON.stringify(send_role_without_name));
  ensure(
    text_at(send_role_without_name, "error.code") === "invalid_input",
    "cu_linux_chrome_text_send_role_code:" + JSON.stringify(send_role_without_name.error)
  );
  ensure(
    text_at(send_role_without_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_chrome_text_send_role_message:" + JSON.stringify(send_role_without_name.error)
  );

  const send_zero_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "0", "--name", FIELD_NAME, "--", "probe",
  ]);
  ensure(!output_success(send_zero_handle),
    "cu_linux_chrome_text_send_zero_handle_ok:" + JSON.stringify(send_zero_handle));
  ensure(
    text_at(send_zero_handle, "error.code") === "invalid_input",
    "cu_linux_chrome_text_send_zero_handle_code:" + JSON.stringify(send_zero_handle.error)
  );
  ensure(
    text_at(send_zero_handle, "error.message").indexOf("--window") >= 0,
    "cu_linux_chrome_text_send_zero_handle_message:" + JSON.stringify(send_zero_handle.error)
  );

  const get_role_without_name = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--role", "entry",
  ]);
  ensure(!output_success(get_role_without_name),
    "cu_linux_chrome_text_get_role_ok:" + JSON.stringify(get_role_without_name));
  ensure(
    text_at(get_role_without_name, "error.code") === "usage"
      || text_at(get_role_without_name, "error.code") === "invalid_input",
    "cu_linux_chrome_text_get_role_code:" + JSON.stringify(get_role_without_name.error)
  );
  ensure(
    text_at(get_role_without_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_chrome_text_get_role_message:" + JSON.stringify(get_role_without_name.error)
  );

  const focus_zero_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "0", "--name", FIELD_NAME,
  ]);
  ensure(!output_success(focus_zero_handle),
    "cu_linux_chrome_text_focus_zero_handle_ok:" + JSON.stringify(focus_zero_handle));
  ensure(
    text_at(focus_zero_handle, "error.code") === "usage"
      || text_at(focus_zero_handle, "error.code") === "invalid_input",
    "cu_linux_chrome_text_focus_zero_handle_code:" + JSON.stringify(focus_zero_handle.error)
  );
  ensure(
    text_at(focus_zero_handle, "error.message").indexOf("--window") >= 0
      || text_at(focus_zero_handle, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_chrome_text_focus_zero_handle_message:" + JSON.stringify(focus_zero_handle.error)
  );

  const focus_missing_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "1",
  ]);
  ensure(!output_success(focus_missing_name),
    "cu_linux_chrome_text_focus_missing_name_ok:" + JSON.stringify(focus_missing_name));
  ensure(
    text_at(focus_missing_name, "error.code") === "usage"
      || text_at(focus_missing_name, "error.code") === "invalid_input",
    "cu_linux_chrome_text_focus_missing_name_code:" + JSON.stringify(focus_missing_name.error)
  );
  ensure(
    text_at(focus_missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_chrome_text_focus_missing_name_message:" + JSON.stringify(focus_missing_name.error)
  );

  const focus_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "1", "--coords", "10,10",
  ]);
  assert_usage_or_honest_non_usage(focus_coords, "focus_coords", "--coords");

  const focus_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "1", "--bogus",
  ]);
  assert_usage_or_honest_non_usage(focus_bogus, "focus_bogus", "--bogus");

  const send_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "1", "--coords", "10,10", "--", "probe",
  ]);
  assert_usage_or_honest_non_usage(send_coords, "send_coords", "--coords");

  const send_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "1", "--bogus", "--", "probe",
  ]);
  assert_usage_or_honest_non_usage(send_bogus, "send_bogus", "--bogus");

  const get_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--coords", "10,10",
  ]);
  assert_usage_or_honest_non_usage(get_coords, "get_coords", "--coords");

  const get_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--bogus",
  ]);
  assert_usage_or_honest_non_usage(get_bogus, "get_bogus", "--bogus");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_chrome_text_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_chrome_text_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_chrome_text_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_chrome_text_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_chrome_text_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_chrome_text_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_chrome_text_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_chrome_text_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_chrome_text_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_chrome_text_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_chrome_text_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_chrome_text_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_chrome_text_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_chrome_text_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_chrome_text_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_chrome_text_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_chrome_text_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_chrome_text_extents_unavailable_code:" + code
  );
}

function assert_chrome_text_host_limit_when_atspi_absent(run_directory, executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
  const focus_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "1", "--name", FIELD_NAME,
  ], env);
  ensure(!output_success(focus_reply),
    "cu_linux_chrome_text_focus_unavailable_ok:" + JSON.stringify(focus_reply));
  const focus_code = text_at(focus_reply, "error.code");
  ensure(
    focus_code === "a11y_backend_failed" || focus_code === "unsupported" || focus_code === "bad_handle",
    "cu_linux_chrome_text_focus_unavailable_code:" + focus_code
  );

  const send_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "1", "--name", FIELD_NAME, "--", "probe",
  ], env);
  ensure(!output_success(send_reply),
    "cu_linux_chrome_text_send_unavailable_ok:" + JSON.stringify(send_reply));
  const send_code = text_at(send_reply, "error.code");
  ensure(
    send_code === "a11y_backend_failed" || send_code === "unsupported" || send_code === "bad_handle",
    "cu_linux_chrome_text_send_unavailable_code:" + send_code
  );

  const get_reply = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--name", FIELD_NAME,
  ], env);
  ensure(!output_success(get_reply),
    "cu_linux_chrome_text_get_unavailable_ok:" + JSON.stringify(get_reply));
  const get_code = text_at(get_reply, "error.code");
  ensure(
    get_code === "a11y_backend_failed" || get_code === "unsupported" || get_code === "bad_handle",
    "cu_linux_chrome_text_get_unavailable_code:" + get_code
  );
}

function assert_send_text_missing_node(run_directory, executable, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", handle, "--name", MISSING_NODE, "--", "probe",
  ]);
  ensure(!output_success(reply), "cu_linux_chrome_text_send_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_chrome_text_send_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function assert_get_text_missing_node(run_directory, executable, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!output_success(reply), "cu_linux_chrome_text_get_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_chrome_text_get_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function assert_get_text_reject_coords_or_stay_named(
  run_directory, executable, handle, expected_text, label
) {
  const get_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", FIELD_NAME, "--coords", "10,10",
  ]);
  if (!output_success(get_coords)) {
    assert_usage_or_honest_non_usage(get_coords, "get_coords_" + label, "--coords");
  } else {
    ensure(
      get_text_readback(get_coords) === expected_text,
      "cu_linux_chrome_text_get_coords_named_" + label + ":" + JSON.stringify(get_coords.data)
    );
  }

  const get_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", FIELD_NAME, "--bogus",
  ]);
  if (!output_success(get_bogus)) {
    assert_usage_or_honest_non_usage(get_bogus, "get_bogus_" + label, "--bogus");
  } else {
    ensure(
      get_text_readback(get_bogus) === expected_text,
      "cu_linux_chrome_text_get_bogus_named_" + label + ":" + JSON.stringify(get_bogus.data)
    );
  }
}

function assert_fixture_process_state(run_directory, executable, fixture_pid, env) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ], env);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_chrome_text_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_chrome_text_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row, env
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ], env);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_chrome_text_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_chrome_text_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_chrome_text_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function chrome_window(run_directory, executable, title_prefix, env) {
  const inventory = run_cu(run_directory, executable, "observe", ["windows"], env);
  const rows = inventory.data.windows === undefined ? inventory.data : inventory.data.windows;
  for (const row of rows) {
    if (text_at(row, "app_name") === "chrome"
      && text_at(row, "title").indexOf(title_prefix) === 0) {
      return {
        handle: "" + at(row, "handle"),
        pid: int_at(row, "process_id"),
        title: text_at(row, "title"),
        row: row,
      };
    }
  }
  return null;
}

function get_text_readback(got) {
  const matched = text_at(got, "data.matched.text");
  if (matched !== "") { return matched; }
  return text_at(got, "data.text");
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "cu_linux_chrome_text_executable_missing:" + executable);
ensure(direct_file(abi_library), "cu_linux_chrome_text_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-chrome-text");
const run_directory = rh.join(repo, "target/cu-linux-chrome-text-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let window_enum = { available: false, reason: "not_probed" };
let ran_actuate_court = false;

const fixture_title = "CEO3 Chrome Text " + context.run_id;
const fixture_source = rh.join(repo, "fixtures/cu/311b-chrome-gettext.html");
const fixture = rh.join(run_directory, "311b-chrome-gettext.html");
let fixture_html = rh.read_text(fixture_source);
fixture_html = fixture_html.replace("311b Chrome GetText Fixture", fixture_title);
fixture_html = fixture_html.replace(
  "Prefill HELLO. Independent get-text --name GetTextField must equal HELLO.",
  "Prefill HELLO for independent get-text read-back."
);
rh.write_text(fixture, fixture_html);

const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
const port = 9400 + (rh.pid() % 500);
let chrome_child = -1;
let succeeded = 0;
let failure = "";

try {
  print("STEP focus/send-text/get-text typed-fail usage when --window/--name is missing or --coords/--bogus is supplied (usage_rejects_unexpected + command=usage, or honest non-usage typed failure; never fake command=usage)");
  assert_chrome_text_usage_limit(run_directory, executable);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before process-state/desktop-state and chrome/send-text court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and chrome/send-text court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP focus/send-text/get-text typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and chrome/send-text court");
  assert_chrome_text_host_limit_when_atspi_absent(run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held; chrome text read-back still uses AT-SPI --name");
  }

  window_enum = probe_cu_windows_enum_available(run_directory, executable, env);
  if (window_enum.available !== true) {
    print("STEP typed host-limit when CU windows enumeration is unavailable before actuate/read-back court");
    succeeded = 1;
  } else {
      const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
        cwd: run_directory,
        timeout_ms: 3000,
      });
      ensure(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
        "cu_linux_chrome_text_port_in_use:" + port);

      print("STEP launch owned Chrome with AT-SPI and a visible named GetTextField");
      chrome_child = harness.start({
        program: launcher,
        args: [
          "--user-data-dir=" + profile,
          "--remote-debugging-port=" + port,
          "--remote-debugging-address=127.0.0.1",
          "--new-window",
          "file://" + fixture,
        ],
        current_dir: run_directory,
        env: env,
        timeout_ms: 45000,
      });
      for (let attempt = 0; attempt < 80; attempt = attempt + 1) {
        const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
          cwd: run_directory,
          timeout_ms: 3000,
        });
        if (probe.success === true && probe.stdout.indexOf("Browser") >= 0) { break; }
        harness.sleep_ms(250);
      }

      const window_wait = run_cu(run_directory, executable, "observe", [
        "wait", "--timeout-ms", "20000", "--window-title-contains", fixture_title,
      ], env);
      ensure(flag_at(window_wait, "data.met"), "cu_linux_chrome_text_window_wait");

      let window = null;
      for (let attempt = 0; attempt < 40 && window === null; attempt = attempt + 1) {
        window = chrome_window(run_directory, executable, fixture_title, env);
        if (window === null) { harness.sleep_ms(250); }
      }
      ensure(window !== null, "cu_linux_chrome_text_window_missing");
      const handle = window.handle;
      const fixture_pid = window.pid;
      ensure(fixture_pid > 0, "cu_linux_chrome_text_pid_missing:" + JSON.stringify(window.row));

      print("STEP process-state binds the owned fixture pid before chrome/send-text actuate/read-back court");
      assert_fixture_process_state(run_directory, executable, fixture_pid, env);

      print("STEP desktop-state window row agrees with inventory before chrome/send-text actuate/read-back court");
      assert_fixture_desktop_state(
        run_directory, executable, fixture_pid, window.title, handle, window.row, env
      );

      print("STEP unlock enables the Chrome renderer accessibility tree before named writes");
      const unlocked = run_cu(run_directory, executable, "observe,actuate", [
        "unlock", "--window", handle,
      ], env);
      ensure(flag_at(unlocked, "data.poked"), "cu_linux_chrome_text_unlock:" + JSON.stringify(unlocked.data));

      print("STEP send-text/get-text typed-fail a11y_node_not_found when the named field is missing");
      assert_send_text_missing_node(run_directory, executable, handle, "before_focus");
      assert_get_text_missing_node(run_directory, executable, handle, "before_focus");

      print("STEP focus --name GetTextField moves AT-SPI focus to the Chrome entry");
      const focused = run_cu(run_directory, executable, "observe,actuate", [
        "focus", "--window", handle, "--name", FIELD_NAME,
      ], env);
      ensure(
        text_at(focused, "data.after.name") === FIELD_NAME,
        "cu_linux_chrome_text_focused:" + JSON.stringify(focused.data)
      );
      harness.emit_evidence(context, declared_evidence, "cu.linux-chrome-text-focus");

      const seed = "ceo3-chrome-" + context.run_id;
      print("STEP send-text --name writes SEED through AT-SPI/CDP honesty");
      const dash_end = "-" + "-";
      const sent = run_cu(run_directory, executable, "observe,actuate", [
        "send-text", "--window", handle, "--name", FIELD_NAME, dash_end, seed,
      ], env);
      ensure(
        text_at(sent, "data.typed") === seed
          && text_at(sent, "data.addressing") === "accessibility-tree",
        "cu_linux_chrome_text_send:" + JSON.stringify(sent.data)
      );
      harness.emit_evidence(context, declared_evidence, "cu.linux-chrome-text-send-text");

      print("STEP get-text --name reads SEED back through AT-SPI Text.GetText");
      const got = run_cu(run_directory, executable, "observe", [
        "get-text", "--window", handle, "--name", FIELD_NAME,
      ], env);
      const readback = get_text_readback(got);
      ensure(
        readback === seed,
        "cu_linux_chrome_text_get:" + JSON.stringify({ seed: seed, readback: readback })
      );
      harness.emit_evidence(context, declared_evidence, "cu.linux-chrome-text-get-text");

      print("STEP get-text --name with --coords/--bogus rejects as command=usage or honest non-usage, or stays named AT-SPI after seed read-back");
      assert_get_text_reject_coords_or_stay_named(run_directory, executable, handle, seed, "after_seed");

      ran_actuate_court = true;
      succeeded = 1;
    }
} catch (error) {
  failure = "" + error;
}

if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup: " + error); }
}

ensure(succeeded === 1, failure || "cu_linux_chrome_text_failed");
harness.remove_run(context);
if (window_enum.available !== true) {
  print("PASS: CEO#3 Chrome typed focus/send-text/get-text --coords/--bogus usage_rejects_unexpected (never fake command=usage) and get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty with x11 window-enum host-limit when CU inventory is unavailable (AT-SPI --name, no --coords)");
} else if (ran_actuate_court) {
  print("PASS: CEO#3 Chrome focus → send-text → get-text with typed focus/send-text/get-text --coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty, process-state/desktop-state courts before actuate, and independent get-text --name read-back (AT-SPI --name, no --coords)");
} else {
  print("PASS: CEO#3 Chrome typed focus/send-text/get-text --coords/--bogus usage_rejects_unexpected (never fake command=usage) and get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (AT-SPI --name, no --coords)");
}
return;
