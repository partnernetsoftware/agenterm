// Package one manifest-defined cross-platform client release.
//
// Args:
//   REPO VERSION OS ARCH BINARY_DIRECTORY [--unsigned-preview|--signed]
//
// Platform credential import, signing, notarization and system-library
// installation remain host adapters. Payload selection and archive policy live
// here and are driven only by scripts/artifacts.json.
// Ported from scripts/rh/package-client-release.rh; runs under `--profile tool`.
import * as rh from "lib/rh_compat";

function copy_required(source, destination, code) {
  // Name the file: every one of these tags is reused across the whole
  // executable set, so a bare code says only "one of four is absent".
  rh.require(rh.exists(source), "" + code + ":" + source);
  rh.copy(source, destination);
}

function valid_source_sha(value) {
  const text = "" + value;
  if (text.length !== 40) { return false; }
  return rh.only_chars(text, rh.HEX);
}

const args = rh.args();
if (args.length !== 5 && args.length !== 6) { throw "package_client_arguments"; }

const repo = rh.absolute(args[0]);
const version = args[1];
const os_name = args[2];
const arch = args[3];
let binary_directory = rh.join(repo, args[4]);
if (rh.exists(args[4])) {
  binary_directory = args[4];
}
let mode = "";
if (args.length === 6) {
  mode = args[5];
}
rh.require(
  mode === "" || mode === "--unsigned-preview" || mode === "--signed",
  "package_client_mode:" + mode
);
const unsigned_preview = mode === "--unsigned-preview";
const signed = mode === "--signed";
let host_os = "windows";
if (rh.has_env("AGENTERM_HOST_OS")) {
  host_os = rh.env_or("AGENTERM_HOST_OS", "");
}
if (!rh.has_env("AGENTERM_HOST_OS") && rh.exists("/System/Library/CoreServices")) {
  host_os = "macos";
}
if (!rh.has_env("AGENTERM_HOST_OS")
    && !rh.exists("/System/Library/CoreServices")
    && rh.exists("/proc")) {
  host_os = "linux";
}
let host_arch = "";
if (rh.has_env("AGENTERM_HOST_ARCH")) {
  host_arch = rh.env_or("AGENTERM_HOST_ARCH", "");
}
if (!rh.has_env("AGENTERM_HOST_ARCH") && rh.env_or("RUNNER_ARCH", "") === "ARM64") {
  host_arch = "aarch64";
}
if (!rh.has_env("AGENTERM_HOST_ARCH") && rh.env_or("RUNNER_ARCH", "") === "X64") {
  host_arch = "x86_64";
}
rh.require(
  !version.includes("/") && !version.includes("\\") && version !== "",
  "package_client_version"
);
const cargo = rh.read_text(rh.join(repo, "Cargo.toml"));
let cargo_version = "";
let in_cargo_package = 0;
for (const source_line of cargo.split("\n")) {
  const line = source_line.trim();
  if (line.startsWith("[")) {
    in_cargo_package = 0;
    if (line === "[package]") {
      in_cargo_package = 1;
    }
  }
  if (in_cargo_package !== 0 && line.startsWith("version")) {
    const parts = line.split("\"");
    if (parts.length >= 2) {
      cargo_version = "" + parts[1];
    }
  }
}
rh.require(version === cargo_version, "package_client_version_source_mismatch");
rh.require(rh.exists(binary_directory), "package_client_binary_directory:" + binary_directory);

const artifact_manifest_path = rh.join(repo, "scripts/artifacts.json");
const artifact_manifest = rh.parse_file(artifact_manifest_path);
rh.require(artifact_manifest.schema_version === 2, "package_client_manifest_schema");
let platform_matched = 0;
// The one platform entry for OS/ARCH; rh re-scanned `platforms` at each use.
let platform = null;
for (const candidate of artifact_manifest.platforms) {
  const candidate_os = "" + candidate.os;
  const candidate_arch = "" + candidate.arch;
  if (candidate_os === os_name && candidate_arch === arch) {
    rh.require(platform_matched === 0, "package_client_platform_match:" + os_name + "-" + arch);
    platform_matched = 1;
    platform = candidate;
  }
}
rh.require(platform_matched === 1, "package_client_platform_match:" + os_name + "-" + arch);
let package_format = "zip";
if (os_name === "linux") {
  package_format = "tar.gz";
}
rh.require(
  package_format === "zip" || package_format === "tar.gz",
  "package_client_format:" + package_format
);
rh.require(!unsigned_preview || os_name === "macos", "package_client_preview_platform");
rh.require(!signed || os_name === "macos", "package_client_signed_platform");

let dist = rh.join(repo, "dist");
if (rh.has_env("AGENTERM_PACKAGE_DIST")) {
  dist = rh.absolute(rh.env_or("AGENTERM_PACKAGE_DIST", ""));
}
rh.create_dir_all(dist);
const scratch = rh.join(repo, ".package-client-release-scratch");
const staging = rh.join(scratch, "payload");
rh.create_dir_all(staging);

const executable_names = [];
for (const executable of platform.executables) {
  const name = "" + executable.name;
  executable_names.push(name);
  // Cargo emits the console forwarder as `agenterm-com.exe`; the shipped
  // name is `agenterm.com`. This packager reads the build directory
  // directly, so it maps the name itself.
  let source_name = name;
  if (name === "agenterm.com") {
    source_name = "agenterm-com.exe";
  }
  const source = rh.join(binary_directory, source_name);
  const staged_binary = rh.join(staging, name);
  const staged_hidden = rh.join(staging, "." + name + ".bin");
  const role = "" + executable.role;
  if (os_name === "linux" && (role === "gui" || role === "control-center-gui")) {
    copy_required(source, staged_hidden, "package_client_binary_missing");
    copy_required(
      rh.join(repo, "scripts/linux/agenterm-gui-wrapper.sh"),
      staged_binary,
      "package_client_linux_wrapper_missing"
    );
  } else {
    copy_required(source, staged_binary, "package_client_binary_missing");
  }
}
for (const library of platform.libraries) {
  const name = "" + library.name;
  copy_required(
    rh.join(binary_directory, name),
    rh.join(staging, name),
    "package_client_library_missing"
  );
}
const chmod_options = { cwd: repo, timeout_ms: 300000 };
if (os_name !== "windows" && host_os !== "windows") {
  for (const name of executable_names) {
    const chmod_code = rh.command_status("chmod", ["+x", rh.join(staging, "" + name)], chmod_options);
    rh.require(chmod_code === 0, "package_client_chmod");
  }
  if (os_name === "linux") {
    for (const executable of platform.executables) {
      const role = "" + executable.role;
      if (role === "gui" || role === "control-center-gui") {
        const chmod_bin = rh.join(staging, "." + ("" + executable.name) + ".bin");
        const chmod_code = rh.command_status("chmod", ["+x", chmod_bin], chmod_options);
        rh.require(chmod_code === 0, "package_client_chmod");
      }
    }
  }
}
if (os_name === "linux" && host_os === "linux") {
  const adapter = rh.join(repo, "scripts/stage-linux-gui-libs.sh");
  if (rh.exists(adapter)) {
    const adapter_code = rh.command_status(adapter, [staging, arch], chmod_options);
    rh.require(adapter_code === 0, "package_client_linux_libraries");
  }
}

for (const name of ["LICENSE-APACHE", "LICENSE-MIT", "THIRD_PARTY_NOTICES.md"]) {
  copy_required(rh.join(repo, name), rh.join(staging, name), "package_client_notice_missing");
}
copy_required(
  artifact_manifest_path,
  rh.join(staging, "artifacts.json"),
  "package_client_manifest_missing"
);
let sbom_source = rh.join(repo, "dist/agenterm-sbom.spdx.json");
if (rh.has_env("AGENTERM_PACKAGE_SBOM")) {
  sbom_source = rh.absolute(rh.env_or("AGENTERM_PACKAGE_SBOM", ""));
}
if (os_name === "macos") {
  copy_required(sbom_source, rh.join(staging, "agenterm-sbom.spdx.json"), "package_client_sbom_missing");
}
if (unsigned_preview) {
  const preview_source = rh.join(repo, "docs/macos-unsigned-preview.md");
  copy_required(
    preview_source,
    rh.join(staging, "MACOS_UNSIGNED_PREVIEW_README.md"),
    "package_client_preview_readme"
  );
  const preview_zh_source = rh.join(repo, "docs/macos-unsigned-preview.zh-Hant.md");
  copy_required(
    preview_zh_source,
    rh.join(staging, "MACOS_UNSIGNED_PREVIEW_README.zh-Hant.md"),
    "package_client_preview_readme_zh"
  );
  rh.copy(preview_source, rh.join(dist, "MACOS_UNSIGNED_PREVIEW_README.md"));
  rh.copy(preview_zh_source, rh.join(dist, "MACOS_UNSIGNED_PREVIEW_README.zh-Hant.md"));
}

let suffix = "";
if (unsigned_preview) {
  suffix = "-unsigned-preview";
}
let archive_extension = ".tar.gz";
if (package_format === "zip") {
  archive_extension = ".zip";
}
const archive_name = "agenterm-" + version + "-" + os_name + "-" + arch + suffix + archive_extension;
const archive = rh.join(dist, archive_name);
if (rh.exists(archive)) {
  rh.remove_file(archive);
}
if (package_format === "zip") {
  if (host_os === "linux") {
    const zip_code = rh.command_status("zip", ["-q", "-r", archive, "."], { cwd: staging, timeout_ms: 300000 });
    rh.require(zip_code === 0, "package_client_zip");
  } else {
    const zip_code = rh.command_status("tar", ["-a", "-c", "-f", archive, "-C", staging, "."], chmod_options);
    rh.require(zip_code === 0, "package_client_zip");
  }
} else {
  const tar_code = rh.command_status("tar", ["-czf", archive, "-C", staging, "."], chmod_options);
  rh.require(tar_code === 0, "package_client_tar");
}
const archive_hash = rh.sha256_file(archive);
let source_commit = "";
if (rh.has_env("AGENTERM_CANDIDATE_SOURCE_SHA")) {
  const value = rh.env_or("AGENTERM_CANDIDATE_SOURCE_SHA", "");
  rh.require(valid_source_sha(value), "package_client_candidate_source");
  const git_stdout_path = repo + ".package-client-release.git.stdout.tmp";
  const git_exit_code = rh.command_stdout_file(
    "git", ["rev-parse", "HEAD"], git_stdout_path, { cwd: repo, timeout_ms: 10000 }
  );
  rh.require(git_exit_code === 0, "package_client_git_head");
  const git_head_value = rh.read_text(git_stdout_path).trim();
  rh.try_remove_file(git_stdout_path);
  rh.require(valid_source_sha(git_head_value), "package_client_git_head_invalid");
  rh.require(value === git_head_value, "package_client_candidate_source_mismatch");
  source_commit = value;
}
if (!rh.has_env("AGENTERM_CANDIDATE_SOURCE_SHA") && rh.has_env("GITHUB_SHA")) {
  source_commit = rh.env_or("GITHUB_SHA", "");
}
let release_channel = "release";
if (unsigned_preview) {
  release_channel = "macos-unsigned-preview";
}
let execution_evidence = "cross_build_existence_only";
if (host_os === os_name && host_arch === arch) {
  execution_evidence = "native_execution_eligible";
}
let build_log = "";
if (rh.has_env("GITHUB_SERVER_URL") && rh.has_env("GITHUB_REPOSITORY") && rh.has_env("GITHUB_RUN_ID")) {
  build_log = rh.env_or("GITHUB_SERVER_URL", "") + "/" +
    rh.env_or("GITHUB_REPOSITORY", "") + "/actions/runs/" +
    rh.env_or("GITHUB_RUN_ID", "");
}
const artifact_manifest_sha256 = rh.sha256_file(artifact_manifest_path);
const cargo_lock_sha256 = rh.sha256_file(rh.join(repo, "Cargo.lock"));
// Only macOS packages carry an SBOM, and only macOS lanes generate one;
// record the absence explicitly rather than hashing a file this platform's
// package does not contain.
let sbom_sha256 = "";
if (rh.exists(sbom_source)) {
  sbom_sha256 = rh.sha256_file(sbom_source);
}
const package_manifest = {
  schema_version: 1,
  product: "AgenTerm",
  version: version,
  os: os_name,
  arch: arch,
  channel: release_channel,
  signed: signed,
  notarized: false,
  artifact: archive_name,
  sha256: archive_hash,
  source_commit: source_commit,
  source_tag: "v" + version,
  artifact_manifest_sha256: artifact_manifest_sha256,
  cargo_lock_sha256: cargo_lock_sha256,
  sbom_sha256: sbom_sha256,
  execution_evidence: execution_evidence,
  build_log: build_log
};
rh.atomic_write(archive + ".provenance.json", rh.stringify_pretty(package_manifest) + "\n");
rh.atomic_write(archive + ".sha256", archive_hash + "  " + archive_name + "\n");
if (rh.exists(scratch)) {
  rh.try_remove_dir_all(scratch);
  rh.require(!rh.exists(scratch), "package_client_scratch_cleanup");
}
print("PACKAGED " + archive);
return 0;
