// CEO: Linux browser-open then independent Chrome/CDP tabs inventory read-back.
// Typed browser-tabs/browser-open usage must reject AT-SPI --name, --coords,
// --bogus, and other unexpected arguments via usage_rejects_unexpected;
// typed get-extents --name usage AND host-limit paths must both hold before
// the browser-open/browser-tabs actuate/read-back court, including
// get-extents --coords/--bogus command=usage honesty. Independent curl /json
// (and AT-SPI tab names when the desktop probe is live) must agree with CU
// browser-tabs. Prefer host-limit clarity over fake success. AT-SPI/--name
// only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-browser-tabs-inventory",
];

const AT_SPI_PROBE_NAME = "Browser Tabs Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}


function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function isolated_env(run_directory, executable) {
  const env = {
    HOME: run_directory,
    XDG_CONFIG_HOME: rh.join(run_directory, ".config"),
    XDG_DATA_HOME: rh.join(run_directory, ".data"),
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
    AGENTERM_CU_RECEIPT_PATH: rh.join(run_directory, "cu-receipts.jsonl"),
    AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  const cu = cu_env(executable);
  env.AGENTERM_ABI_LIB = cu.AGENTERM_ABI_LIB;
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (cu[key] !== undefined) { env[key] = cu[key]; }
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_browser_tabs_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_browser_tabs_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_unexpected_flag(
  run_directory, executable, grant, arguments, env, label, token
) {
  const reply = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(
    !rh.output_success(reply),
    "cu_linux_browser_tabs_usage_" + label + "_ok:" + JSON.stringify(reply)
  );
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_browser_tabs_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_browser_tabs_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  ensure(
    usage_rejects_unexpected(text_at(reply, "error.message"), token),
    "cu_linux_browser_tabs_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_browser_tabs_unexpected_usage(run_directory, executable, env) {
  assert_unexpected_flag(run_directory, executable, "observe", [
    "browser-tabs", "--match", "fixture", "--name", AT_SPI_PROBE_NAME,
  ], env, "flat_name", "--name");
  assert_unexpected_flag(run_directory, executable, "observe", [
    "browser", "tabs", "--match", "fixture", "--name", AT_SPI_PROBE_NAME,
  ], env, "grouped_name", "--name");
  assert_unexpected_flag(run_directory, executable, "observe", [
    "browser-tabs", "--match", "fixture", "--bogus",
  ], env, "flat_bogus", "--bogus");
  assert_unexpected_flag(run_directory, executable, "observe", [
    "browser", "tabs", "--match", "fixture", "--bogus",
  ], env, "grouped_bogus", "--bogus");
  assert_unexpected_flag(run_directory, executable, "observe", [
    "browser-tabs", "--match", "fixture", "--coords", "10,10",
  ], env, "flat_coords", "--coords");
  assert_unexpected_flag(run_directory, executable, "observe", [
    "browser", "tabs", "--match", "fixture", "--coords", "10,10",
  ], env, "grouped_coords", "--coords");

  assert_unexpected_flag(run_directory, executable, "actuate", [
    "browser-open", "--profile", "court-alpha", "--name", AT_SPI_PROBE_NAME,
  ], env, "open_flat_name", "--name");
  assert_unexpected_flag(run_directory, executable, "actuate", [
    "browser", "open", "--profile", "court-alpha", "--name", AT_SPI_PROBE_NAME,
  ], env, "open_grouped_name", "--name");
  assert_unexpected_flag(run_directory, executable, "actuate", [
    "browser-open", "--profile", "court-alpha", "--bogus",
  ], env, "open_flat_bogus", "--bogus");
  assert_unexpected_flag(run_directory, executable, "actuate", [
    "browser", "open", "--profile", "court-alpha", "--bogus",
  ], env, "open_grouped_bogus", "--bogus");
  assert_unexpected_flag(run_directory, executable, "actuate", [
    "browser-open", "--profile", "court-alpha", "--coords", "10,10",
  ], env, "open_flat_coords", "--coords");
  assert_unexpected_flag(run_directory, executable, "actuate", [
    "browser", "open", "--profile", "court-alpha", "--coords", "10,10",
  ], env, "open_grouped_coords", "--coords");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_browser_tabs_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_browser_tabs_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_browser_tabs_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_browser_tabs_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_browser_tabs_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_browser_tabs_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_browser_tabs_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_browser_tabs_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_browser_tabs_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_browser_tabs_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_browser_tabs_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_browser_tabs_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_browser_tabs_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_browser_tabs_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_browser_tabs_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_browser_tabs_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_browser_tabs_extents_unavailable_code:" + code
  );
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(rh.output_success(document), "cu_linux_browser_tabs_reply:" + JSON.stringify(document));
  return document;
}

function chrome_handles(document) {
  const rows = document.data.windows === undefined ? document.data : document.data.windows;
  const handles = [];
  for (const row of rows) {
    const app = text_at(row, "app_name").toLowerCase();
    if (app.indexOf("chrome") >= 0 || app === "google-chrome" || app === "google-chrome-stable") {
      handles.push("" + at(row, "handle"));
    }
  }
  return handles;
}

function independent_cdp_port(run_directory, needle) {
  const script = [
    "import os, sys",
    "needle = sys.argv[1]",
    "found = []",
    "for name in os.listdir('/proc'):",
    "    if not name.isdigit():",
    "        continue",
    "    path = '/proc/' + name + '/cmdline'",
    "    try:",
    "        data = open(path, 'rb').read().split(b'\\0')",
    "    except OSError:",
    "        continue",
    "    words = [w.decode('utf-8', 'replace') for w in data if w]",
    "    text = ' '.join(words)",
    "    if needle not in text:",
    "        continue",
    "    if any(w.startswith('--type=') for w in words):",
    "        continue",
    "    port = ''",
    "    i = 0",
    "    while i < len(words):",
    "        word = words[i]",
    "        if word.startswith('--remote-debugging-port='):",
    "            port = word.split('=', 1)[1]",
    "        elif word == '--remote-debugging-port' and i + 1 < len(words):",
    "            port = words[i + 1]",
    "        i += 1",
    "    if port.isdigit() and int(port) > 0:",
    "        found.append(port)",
    "print(','.join(sorted(set(found))))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, needle], {
    cwd: run_directory,
    timeout_ms: 10000,
  });
  ensure(output.success === true,
    "cu_linux_browser_tabs_proc_cmdline:" + output.stderr + output.stdout);
  const text = output.stdout.trim();
  ensure(text !== "",
    "cu_linux_browser_tabs_independent_cdp_port_missing:" + needle);
  const parts = text.split(",");
  ensure(parts.length === 1,
    "cu_linux_browser_tabs_independent_cdp_port_ambiguous:" + text);
  return rh.parse_int(parts[0]);
}

function independent_curl_json(run_directory, port) {
  const output = rh.command("curl", [
    "-s", "--max-time", "5", "http://127.0.0.1:" + port + "/json",
  ], {
    cwd: run_directory,
    timeout_ms: 10000,
  });
  ensure(
    output.success === true && output.stdout.trim() !== "",
    "cu_linux_browser_tabs_curl:" + output.stdout + output.stderr
  );
  return JSON.parse(output.stdout.trim());
}

function curl_page_matches(raw, title_needle, url_needle) {
  if (!Array.isArray(raw)) { return false; }
  for (const row of raw) {
    const title = row.title === undefined || row.title === null ? "" : "" + row.title;
    const url = row.url === undefined || row.url === null ? "" : "" + row.url;
    const type = row.type === undefined || row.type === null ? "" : "" + row.type;
    if (type !== "" && type !== "page") { continue; }
    if (title.indexOf(title_needle) >= 0 && url.indexOf(url_needle) >= 0) {
      return true;
    }
  }
  return false;
}

function independent_atspi_tab_titles(run_directory, executable, env, title_needle) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "want = sys.argv[1]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "names = []",
    "def walk(node, depth):",
    "    if node is None or depth > 24:",
    "        return",
    "    name = node.name or ''",
    "    role = ''",
    "    try:",
    "        role = node.getRoleName() or ''",
    "    except Exception:",
    "        role = ''",
    "    role_l = role.lower()",
    "    if want in name and ('tab' in role_l or 'page' in role_l or 'document' in role_l or 'frame' in role_l):",
    "        names.append({'name': name, 'role': role})",
    "    try:",
    "        count = node.childCount",
    "    except Exception:",
    "        return",
    "    for i in range(count):",
    "        try:",
    "            child = node.getChildAtIndex(i)",
    "        except Exception:",
    "            continue",
    "        walk(child, depth + 1)",
    "for i in range(desktop.childCount):",
    "    app = desktop.getChildAtIndex(i)",
    "    if app is None:",
    "        continue",
    "    walk(app, 0)",
    "print(json.dumps(names))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title_needle], {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 20000,
  });
  if (output.success !== true) {
    return null;
  }
  const trimmed = output.stdout.trim();
  if (trimmed === "") { return null; }
  return JSON.parse(trimmed);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
harness.require(!harness.host_is_windows(),
  "cu.linux-browser-tabs requires Linux browser-open + CDP tab inventory");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(rh.is_direct_file(executable), "cu_linux_browser_tabs_executable_missing:" + executable);
ensure(rh.is_direct_file(abi_library), "cu_linux_browser_tabs_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-browser-tabs");
const run_directory = context.run_directory;
const user_data = rh.join(run_directory, ".config/google-chrome");
const local_state = rh.join(user_data, "Local State");
const html_dir = rh.join(run_directory, "html");
const fixture = rh.join(html_dir, "fixture.html");
const fixture_title = "CEO Browser Tabs " + context.run_id;
const env = isolated_env(run_directory, executable);
const atspi_available = probe_atspi_available(executable);

let succeeded = 0;
let failure = "";

try {
  print("STEP browser-tabs/browser-open typed-fail usage when AT-SPI --name/--coords/--bogus is present (usage_rejects_unexpected)");
  assert_browser_tabs_unexpected_usage(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before browser-open/browser-tabs court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before browser-open/browser-tabs court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; tab read-back still uses independent Chrome/CDP /json");
  }

  print("STEP write synthetic Chromium Local State under an invocation-owned HOME");
  rh.create_dir_all(rh.join(user_data, "Default"));
  rh.create_dir_all(html_dir);
  rh.write_text(fixture, "<!DOCTYPE html><html><head><title>"
    + fixture_title + "</title></head><body>ok</body></html>");
  rh.write_text(local_state, JSON.stringify({
    profile: {
      last_used: "Profile 7",
      profiles_order: ["Profile 7", "Default"],
      info_cache: {
        Default: { name: "court-alpha" },
        "Profile 7": { name: "court-beta" },
      },
    },
  }));

  print("STEP record independent chrome window handles before browser-open");
  const before_inventory = run_cu(run_directory, executable, "observe", ["windows"], env);
  const before_handles = chrome_handles(before_inventory);
  const before_set = {};
  for (const handle of before_handles) { before_set[handle] = true; }

  print("STEP browser-open court-alpha and verify a new chrome window through windows inventory");
  const fixture_url = "file://" + fixture;
  const opened = run_cu(run_directory, executable, "actuate", [
    "browser-open",
    "--profile", "court-alpha",
    "--url", fixture_url,
    "--app", "Google Chrome",
    "--timeout-ms", "30000",
  ], env);
  ensure(opened.command === "browser-open", "cu_linux_browser_tabs_open_identity");
  const open_handle = "" + at(opened, "data.handle");
  ensure(open_handle !== "" && open_handle !== "0",
    "cu_linux_browser_tabs_open_handle:" + JSON.stringify(opened.data));

  let readback_handle = null;
  for (let attempt = 0; attempt < 40 && readback_handle === null; attempt = attempt + 1) {
    const inventory = run_cu(run_directory, executable, "observe", ["windows"], env);
    for (const handle of chrome_handles(inventory)) {
      if (before_set[handle] !== true) {
        readback_handle = handle;
        break;
      }
    }
    if (readback_handle === null) { harness.sleep_ms(250); }
  }
  ensure(readback_handle !== null, "cu_linux_browser_tabs_open_readback_missing");
  ensure(readback_handle === open_handle,
    "cu_linux_browser_tabs_open_handle_mismatch:" + JSON.stringify({
      open: open_handle,
      readback: readback_handle,
    }));

  print("STEP independent Chrome CDP /json lists the opened tab by title and URL");
  const independent_port = independent_cdp_port(run_directory, fixture);
  let curl_rows = null;
  for (let attempt = 0; attempt < 40 && curl_rows === null; attempt = attempt + 1) {
    try {
      const raw = independent_curl_json(run_directory, independent_port);
      if (curl_page_matches(raw, fixture_title, "fixture.html")) {
        curl_rows = raw;
        break;
      }
    } catch (error) {
      curl_rows = null;
    }
    harness.sleep_ms(250);
  }
  ensure(curl_rows !== null,
    "cu_linux_browser_tabs_independent_cdp_missing:" + independent_port);

  print("STEP browser-tabs independently lists the opened tab by title match and agrees with curl /json");
  let tabs = null;
  for (let attempt = 0; attempt < 40 && tabs === null; attempt = attempt + 1) {
    const reply = run_cu(run_directory, executable, "observe", [
      "browser-tabs", "--match", fixture_title,
    ], env);
    if (reply.command === "browser-tabs"
        && text_at(reply, "data.mechanism") === "cdp-json"
        && at(reply, "data.returned") >= 1) {
      tabs = reply;
      break;
    }
    harness.sleep_ms(250);
  }
  ensure(tabs !== null, "cu_linux_browser_tabs_inventory_missing");
  ensure(text_at(tabs, "data.mechanism") === "cdp-json",
    "cu_linux_browser_tabs_mechanism:" + JSON.stringify(tabs.data));
  ensure(flag_at(tabs, "data.verified") === true && flag_at(tabs, "data.focus_changed") === false,
    "cu_linux_browser_tabs_contract:" + JSON.stringify(tabs.data));
  ensure(int_at(tabs, "data.port") === independent_port,
    "cu_linux_browser_tabs_port_mismatch:" + JSON.stringify({
      cu: at(tabs, "data.port"),
      independent: independent_port,
    }));
  const tab_rows = at(tabs, "data.tabs");
  ensure(Array.isArray(tab_rows) && tab_rows.length >= 1,
    "cu_linux_browser_tabs_rows:" + JSON.stringify(tab_rows));
  const tab = tab_rows[0];
  ensure(text_at(tab, "title").indexOf(fixture_title) >= 0,
    "cu_linux_browser_tabs_title:" + JSON.stringify(tab));
  ensure(text_at(tab, "url").indexOf("fixture.html") >= 0,
    "cu_linux_browser_tabs_url:" + JSON.stringify(tab));
  ensure(at(tab, "tab_id") >= 1, "cu_linux_browser_tabs_tab_id:" + JSON.stringify(tab));
  ensure(
    curl_page_matches(curl_rows, text_at(tab, "title"), "fixture.html"),
    "cu_linux_browser_tabs_curl_disagree:" + JSON.stringify({
      cu: tab,
      curl: curl_rows,
    })
  );

  if (atspi_available) {
    print("STEP independent AT-SPI tab/document names include the opened title when the desktop probe is live");
    const atspi_names = independent_atspi_tab_titles(
      run_directory, executable, env, fixture_title
    );
    if (atspi_names === null || !Array.isArray(atspi_names) || atspi_names.length < 1) {
      print("STEP independent AT-SPI tab names unavailable on this host; Chrome/CDP /json read-back already held");
    } else {
      ensure(
        atspi_names.length >= 1,
        "cu_linux_browser_tabs_atspi_empty:" + JSON.stringify(atspi_names)
      );
    }
  }

  harness.emit_evidence(context, declared_evidence, "cu.linux-browser-tabs-inventory");

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux browser-open + independent Chrome/CDP tabs inventory read-back with typed browser-tabs/browser-open --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux browser-open + independent Chrome/CDP tabs inventory read-back with typed browser-tabs/browser-open --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
