// CEO: Linux page-screenshot honesty — CU CDP capture writes a real PNG file.
// Acceptance is smoke read-back only: page-screenshot --port must leave a
// nonempty file whose magic bytes and decoded dimensions are verified by
// independent host tools, not by the CU JSON alone. Typed page-screenshot
// usage/miss/no-CDP host-limit paths and independent pyatspi get-extents --name
// agreement must hold before the PNG read-back court. Disposable Chrome+CDP;
// AT-SPI/--name only; no --coords or screenshot-window degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-cdp-page-screenshot-readback",
];

const PNG_MAGIC_HEX = "89504e470d0a1a0a";
const MARKER_NAME = "ScreenshotMarker";
const MISSING_NODE = "No Such Marker";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function output_success(document) { return flag_at(document, "ok"); }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_page_screenshot_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(document), "cu_linux_page_screenshot_reply:" + JSON.stringify(document));
  return document;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_page_screenshot_usage(run_directory, executable, env, port, out_path) {
  const missing_out = run_cu_reply(run_directory, executable, "observe", [
    "page-screenshot", "--port", "" + port, "--target-id", "unused",
  ], env);
  ensure(!output_success(missing_out), "cu_linux_page_screenshot_usage_ok:" + JSON.stringify(missing_out));
  ensure(
    text_at(missing_out, "error.code") === "usage",
    "cu_linux_page_screenshot_usage_code:" + JSON.stringify(missing_out.error)
  );
  ensure(
    text_at(missing_out, "error.message").indexOf("--out") >= 0,
    "cu_linux_page_screenshot_usage_message:" + JSON.stringify(missing_out.error)
  );

  const dual_target = run_cu_reply(run_directory, executable, "observe", [
    "page-screenshot", "--port", "" + port, "--target-id", "unused",
    "--target-title", "CEO", "--out", out_path,
  ], env);
  ensure(!output_success(dual_target), "cu_linux_page_screenshot_dual_ok:" + JSON.stringify(dual_target));
  ensure(
    text_at(dual_target, "error.code") === "usage",
    "cu_linux_page_screenshot_dual_code:" + JSON.stringify(dual_target.error)
  );
  ensure(
    text_at(dual_target, "error.message").indexOf("at most one") >= 0,
    "cu_linux_page_screenshot_dual_message:" + JSON.stringify(dual_target.error)
  );
}

function assert_no_cdp_listener(run_directory, executable, env, port, out_path) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "page-screenshot", "--port", "" + port, "--target-id", "unused", "--out", out_path,
  ], env);
  ensure(reply.ok !== true, "cu_linux_page_screenshot_false_success:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_page_screenshot_host_limit_code:" + JSON.stringify(reply)
  );
  const message = text_at(reply, "error.message");
  ensure(
    message.indexOf("no CDP listener") >= 0 && message.indexOf("" + port) >= 0,
    "cu_linux_page_screenshot_host_limit_message:" + JSON.stringify(reply.error)
  );
}

function assert_page_screenshot_miss(run_directory, executable, env, port, out_path) {
  const bad_target = run_cu_reply(run_directory, executable, "observe", [
    "page-screenshot", "--port", "" + port, "--target-id", "deadbeef", "--out", out_path,
  ], env);
  ensure(!output_success(bad_target), "cu_linux_page_screenshot_miss_ok:" + JSON.stringify(bad_target));
  ensure(
    text_at(bad_target, "error.code") === "cdp_target_not_found",
    "cu_linux_page_screenshot_miss_code:" + JSON.stringify(bad_target.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "0", "--name", MARKER_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_page_screenshot_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_page_screenshot_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_page_screenshot_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--name", MARKER_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_page_screenshot_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle",
    "cu_linux_page_screenshot_extents_unavailable_code:" + code
  );
}

function assert_get_extents_missing_node(run_directory, executable, env, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", MISSING_NODE,
  ], env);
  ensure(!output_success(reply), "cu_linux_page_screenshot_extents_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_page_screenshot_extents_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_row_for_title(run_directory, executable, env, title_needle) {
  const reply = run_cu(run_directory, executable, "observe", ["windows"], env);
  const data = at(reply, "data");
  const rows = data.windows === undefined ? data : data.windows;
  for (const row of rows) {
    const title = text_at(row, "title");
    if (title.indexOf(title_needle) < 0) { continue; }
    const handle = int_at(row, "handle");
    if (handle > 0) { return row; }
  }
  return null;
}

function independent_pyatspi_extents(run_directory, executable, env, fixture_title, node_name) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "want = sys.argv[2]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and title in (w.name or ''):",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    if (node.name or '') == want:",
    "        return node",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_page_screenshot_atspi_no_frame')",
    "node = walk(frame)",
    "if node is None:",
    "    raise SystemExit('cu_linux_page_screenshot_atspi_miss:' + want)",
    "component = node.queryComponent()",
    "ext = component.getExtents(pyatspi.DESKTOP_COORDS)",
    "x, y, w, h = int(ext.x), int(ext.y), int(ext.width), int(ext.height)",
    "print(json.dumps({",
    "    'name': want,",
    "    'x': x, 'y': y, 'width': w, 'height': h,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, fixture_title, node_name], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_page_screenshot_pyatspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function assert_get_extents_agreement(run_directory, executable, env, handle, fixture_title, node_name) {
  const pyatspi_marker = independent_pyatspi_extents(
    run_directory, executable, env, fixture_title, node_name
  );
  const marker_extents = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", node_name,
  ], env);
  ensure(
    int_at(marker_extents, "data.extents.x") === pyatspi_marker.x
      && int_at(marker_extents, "data.extents.y") === pyatspi_marker.y
      && int_at(marker_extents, "data.extents.width") === pyatspi_marker.width
      && int_at(marker_extents, "data.extents.height") === pyatspi_marker.height,
    "cu_linux_page_screenshot_extents_agree:" + JSON.stringify({
      cu: marker_extents.data.extents,
      pyatspi_marker: pyatspi_marker,
    })
  );
}

function cdp_ready(run_directory, port) {
  const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  return probe.success === true && probe.stdout.indexOf("Browser") >= 0;
}

function assert_x11_display_usable(run_directory, env) {
  const output = rh.command("xdpyinfo", [], {
    cwd: run_directory,
    env: env,
    timeout_ms: 5000,
  });
  if (output.success === true) { return; }
  const text = output.stdout + output.stderr;
  ensure(
    text.indexOf("Maximum number of clients reached") < 0
      && text.indexOf("unable to open display") < 0,
    "cu_linux_page_screenshot_host_limit:x11_display_unavailable:" + text.trim()
  );
  ensure(false, "cu_linux_page_screenshot_host_limit:xdpyinfo:" + text.trim());
}

function page_target(rows) {
  for (const row of rows) {
    if (text_at(row, "type") === "page") { return row; }
  }
  return null;
}

function inspect_png(path) {
  if (image_inspect_png(path) !== 0) { throw "image_inspect_png:" + tool_result(); }
  return JSON.parse(tool_result());
}

function independent_png_magic_hex(path) {
  const script = [
    "import sys",
    "path = sys.argv[1]",
    "data = open(path, 'rb').read(8)",
    "if len(data) != 8:",
    "    raise SystemExit('cu_linux_page_screenshot_magic_short')",
    "print(data.hex())",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, path], {
    timeout_ms: 10000,
  });
  ensure(output.success === true && output.stdout.trim() !== "",
    "cu_linux_page_screenshot_magic:" + output.stdout + output.stderr);
  return output.stdout.trim().toLowerCase();
}

function independent_sha256(path) {
  const output = rh.command("sha256sum", [path], {
    timeout_ms: 10000,
  });
  ensure(output.success === true && output.stdout.trim() !== "",
    "cu_linux_page_screenshot_sha256:" + output.stdout + output.stderr);
  const line = output.stdout.trim();
  let token = "";
  for (let index = 0; index < line.length; index = index + 1) {
    const ch = line.charAt(index);
    if (ch === " " || ch === "\t") { break; }
    token = token + ch;
  }
  ensure(token.length === 64, "cu_linux_page_screenshot_sha256_shape:" + token);
  return token;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "cu_linux_page_screenshot_executable_missing:" + executable);
ensure(direct_file(abi_library), "cu_linux_page_screenshot_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-page-screenshot");
const run_directory = context.run_directory;
const env = cu_env(executable);
const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
env.CHROME_USER_DATA_DIR = profile;

const fixture_title = "CEO Page Screenshot " + context.run_id;
const fixture = rh.join(run_directory, "page-screenshot.html");
rh.write_text(fixture, "<!DOCTYPE html><html><head><title>"
  + fixture_title + "</title></head><body style='background:#3366cc;color:#fff;font:48px sans-serif'>"
  + "<div aria-label=\"" + MARKER_NAME + "\">SHOT " + context.run_id + "</div></body></html>");

const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
const port = 9600 + (rh.pid() % 500);
env.SAND_CHROME_REMOTE_DEBUG_PORT = "" + port;
const screenshot_path = rh.join(run_directory, "page-shot-" + context.run_id + ".png");
let chrome_child = -1;
let succeeded = 0;
let failure = "";
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP verify the configured X11 display is usable before owning Chrome");
  assert_x11_display_usable(run_directory, env);

  print("STEP get-extents typed-fail invalid_input when --window handle is zero");
  assert_get_extents_usage_limit(run_directory, executable, env);

  if (!atspi_available) {
    print("STEP typed host-limit when independent pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
  }

  print("STEP page-screenshot typed usage rejects missing --out and dual target selectors before Chrome starts");
  assert_page_screenshot_usage(run_directory, executable, env, port, screenshot_path);

  print("STEP clear stale box-chrome singletons on this display before owned CDP launch");
  rh.command_status("pkill", ["-9", "-f", "/usr/local/bin/box-chrome"], { timeout_ms: 5000 });
  harness.sleep_ms(1000);

  const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  ensure(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
    "cu_linux_page_screenshot_port_in_use:" + port);

  print("STEP page-screenshot typed-fails no CDP listener on the owned free port before Chrome starts");
  assert_no_cdp_listener(run_directory, executable, env, port, screenshot_path);

  print("STEP launch owned Chrome with CDP port and a disposable file:// tab");
  chrome_child = harness.start({
    program: launcher,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--remote-allow-origins=*",
      "--new-window",
      "file://" + fixture,
    ],
    current_dir: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  for (let attempt = 0; attempt < 80 && !cdp_ready(run_directory, port); attempt = attempt + 1) {
    harness.sleep_ms(250);
  }
  ensure(cdp_ready(run_directory, port), "cu_linux_page_screenshot_cdp_not_ready:" + port);

  print("STEP page-targets selects the owned fixture tab");
  let target_id = "";
  for (let attempt = 0; attempt < 40 && target_id === ""; attempt = attempt + 1) {
    const targets = run_cu(run_directory, executable, "observe", [
      "page-targets", "--port", "" + port,
    ], env);
    const row = page_target(at(targets, "data.targets"));
    if (row !== null && text_at(row, "title").indexOf(fixture_title) >= 0) {
      target_id = text_at(row, "id");
      break;
    }
    harness.sleep_ms(250);
  }
  ensure(target_id !== "", "cu_linux_page_screenshot_target_missing");

  print("STEP page-screenshot typed miss paths reject bad targets before capture");
  assert_page_screenshot_miss(run_directory, executable, env, port, screenshot_path);

  if (atspi_available) {
    print("STEP resolve owned Chrome window and unlock the renderer accessibility tree");
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "20000", "--window-title-contains", fixture_title,
    ], env);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_page_screenshot_window_wait");

    let window_row = null;
    for (let attempt = 0; attempt < 40 && window_row === null; attempt = attempt + 1) {
      window_row = window_row_for_title(run_directory, executable, env, fixture_title);
      if (window_row === null) { harness.sleep_ms(250); }
    }
    ensure(window_row !== null, "cu_linux_page_screenshot_window_missing:" + fixture_title);
    const window_handle = "" + int_at(window_row, "handle");
    const window_title = text_at(window_row, "title");
    ensure(window_handle !== "" && window_handle !== "0",
      "cu_linux_page_screenshot_window_handle:" + JSON.stringify(window_row));

    const unlocked = run_cu(run_directory, executable, "observe,actuate", [
      "unlock", "--window", window_handle,
    ], env);
    ensure(flag_at(unlocked, "data.poked"), "cu_linux_page_screenshot_unlock:" + JSON.stringify(unlocked.data));

    print("STEP get-extents typed-fail a11y_node_not_found when the named marker is missing");
    assert_get_extents_missing_node(run_directory, executable, env, window_handle, "before_capture");

    print("STEP independent pyatspi extents and CU get-extents --name agree before page-screenshot");
    assert_get_extents_agreement(
      run_directory, executable, env, window_handle, window_title, MARKER_NAME
    );
  }

  print("STEP page-screenshot --port captures the owned page to --out");
  const shot = run_cu(run_directory, executable, "observe", [
    "page-screenshot", "--port", "" + port, "--target-id", target_id,
    "--out", screenshot_path,
  ], env);
  ensure(shot.command === "page-screenshot",
    "cu_linux_page_screenshot_identity:" + JSON.stringify(shot));
  ensure(text_at(shot, "data.out") === screenshot_path,
    "cu_linux_page_screenshot_out:" + JSON.stringify(shot.data));
  ensure(flag_at(shot, "data.focus_changed") === false,
    "cu_linux_page_screenshot_focus:" + JSON.stringify(shot.data));
  const reported_sha = text_at(shot, "data.sha256");
  ensure(reported_sha.length === 64, "cu_linux_page_screenshot_reply_sha:" + reported_sha);

  print("STEP independent file read-back proves PNG magic, size, digest, and decode");
  ensure(direct_file(screenshot_path), "cu_linux_page_screenshot_missing:" + screenshot_path);
  const file_len = rh.metadata(screenshot_path).len;
  ensure(file_len > 1000, "cu_linux_page_screenshot_size:" + file_len);
  ensure(independent_png_magic_hex(screenshot_path) === PNG_MAGIC_HEX,
    "cu_linux_page_screenshot_magic_mismatch");
  const file_sha = independent_sha256(screenshot_path);
  ensure(file_sha === reported_sha,
    "cu_linux_page_screenshot_sha_mismatch:" + JSON.stringify({
      file: file_sha,
      reply: reported_sha,
    }));
  const decoded = inspect_png(screenshot_path);
  ensure(decoded.width > 0 && decoded.height > 0 && decoded.samples > 0,
    "cu_linux_page_screenshot_decode:" + JSON.stringify(decoded));

  harness.emit_evidence(context, declared_evidence, "cu.linux-cdp-page-screenshot-readback");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup: " + error); }
}

ensure(succeeded === 1, failure || "cu_linux_page_screenshot_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux page-screenshot CDP capture verified by independent PNG read-back with get-extents --name pyatspi agreement and typed usage/miss/host-limit honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux page-screenshot CDP capture verified by independent PNG read-back with typed get-extents host-limit honesty (AT-SPI --name, no --coords)");
}
return;
