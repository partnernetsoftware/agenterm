// CEO: Linux unlock honesty with independent pyatspi tree depth/node-count read-back.
// Acceptance is smoke read-back only: CU unlock returned_before/returned_after,
// web_nodes_before/web_nodes_after, grew, and org.a11y.Status snapshots must
// agree with independent AT-SPI BFS counts and dbus-send flag facts on the same
// owned Chrome window before and after the poke. Typed unlock usage must reject
// AT-SPI --name and other unexpected arguments; typed get-extents --name
// usage/host-limit paths must hold before the native actuate/read-back court.
// Typed usage and AT-SPI host-limit paths must also hold when the independent
// pyatspi desktop probe is unavailable. AT-SPI/--name only; no --coords or
// screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-unlock-readback",
];

const TREE_DEPTH = 64;
const MAX_NODES = 6000;
const AT_SPI_PROBE_NAME = "Unlock Honesty Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function last_json_line(text) {
  const lines = text.trim().split("\n");
  for (let index = lines.length - 1; index >= 0; index = index - 1) {
    const line = lines[index].trim();
    if (line !== "") { return JSON.parse(line); }
  }
  throw "cu_linux_unlock_honesty_missing_json";
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_unlock_honesty_cli:" + output.stdout + output.stderr);
  return last_json_line(output.stdout);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_unlock_honesty_reply:" + JSON.stringify(document));
  return document;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function invoke_unlock_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe,actuate",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_unlock_honesty_unlock_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  const command = text_at(reply, "command");
  ensure(
    command === "unlock" || command === "usage",
    "cu_linux_unlock_honesty_unlock_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_unlock_honesty_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function assert_unlock_usage_limit(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "unlock", "--window", "0",
  ]);
  ensure(!output_success(reply), "cu_linux_unlock_honesty_usage_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_unlock_honesty_usage_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_unlock_honesty_usage_message:" + JSON.stringify(reply.error)
  );
}

function assert_unlock_atspi_name_usage_limit(run_directory, executable, env) {
  const with_name = invoke_unlock_reply(run_directory, executable, [
    "unlock", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(with_name),
    "cu_linux_unlock_honesty_usage_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_unlock_honesty_usage_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_unlock_honesty_usage_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    text_at(with_name, "error.message").indexOf("--name") >= 0
      || text_at(with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_unlock_honesty_usage_name_message:" + JSON.stringify(with_name.error)
  );

  const with_bogus = invoke_unlock_reply(run_directory, executable, [
    "unlock", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_unlock_honesty_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_unlock_honesty_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("unexpected") >= 0
      || text_at(with_bogus, "error.message").indexOf("--bogus") >= 0,
    "cu_linux_unlock_honesty_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_unlock_honesty_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_unlock_honesty_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_unlock_honesty_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_unlock_honesty_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_unlock_honesty_extents_unavailable_code:" + code
  );
}

function assert_unlock_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "unlock", "--window", "1",
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_unlock_honesty_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle",
    "cu_linux_unlock_honesty_unavailable_code:" + code
  );
  if (code === "a11y_backend_failed") {
    const message = text_at(reply, "error.message").toLowerCase();
    ensure(
      message.indexOf("accessibility") >= 0
        || message.indexOf("address") >= 0
        || message.indexOf("bus") >= 0,
      "cu_linux_unlock_honesty_unavailable_message:" + JSON.stringify(reply.error)
    );
  }
}

function safe_command(program, args, options) {
  try {
    return rh.command(program, args, options);
  } catch (error) {
    return null;
  }
}

function dbus_name_has_owner(service, env) {
  const output = safe_command("dbus-send", [
    "--session",
    "--dest=org.freedesktop.DBus",
    "--type=method_call",
    "--print-reply",
    "/org/freedesktop/DBus",
    "org.freedesktop.DBus.NameHasOwner",
    "string:" + service,
  ], {
    env: env,
    timeout_ms: 10000,
  });
  return output !== null && output.success === true && output.stdout.indexOf("boolean true") >= 0;
}

function independent_a11y_status_flag(flag, env) {
  const output = safe_command("dbus-send", [
    "--session",
    "--dest=org.a11y.Bus",
    "--type=method_call",
    "--print-reply",
    "/org/a11y/bus",
    "org.freedesktop.DBus.Properties.Get",
    "string:org.a11y.Status",
    "string:" + flag,
  ], {
    env: env,
    timeout_ms: 10000,
  });
  if (output === null || !output.success) { return null; }
  if (output.stdout.indexOf("boolean true") >= 0) { return true; }
  if (output.stdout.indexOf("boolean false") >= 0) { return false; }
  return null;
}

function independent_a11y_status_flags(env) {
  if (!dbus_name_has_owner("org.a11y.Bus", env)) { return null; }
  const flags = {};
  for (const flag of ["IsEnabled", "ScreenReaderEnabled"]) {
    const value = independent_a11y_status_flag(flag, env);
    if (value === null) { return null; }
    flags[flag] = value;
  }
  return flags;
}

function assert_a11y_status_readback(label, snapshot) {
  const status = text_at(snapshot, "status");
  ensure(
    status === "ok" || status === "partial",
    "cu_linux_unlock_honesty_a11y_status_" + label + ":" + JSON.stringify(snapshot)
  );
  ensure(
    text_at(snapshot, "org_a11y_status.destination") === "org.a11y.Bus",
    "cu_linux_unlock_honesty_a11y_destination_" + label + ":" + JSON.stringify(snapshot)
  );
  for (const flag of ["IsEnabled", "ScreenReaderEnabled"]) {
    ensure(
      text_at(snapshot, "org_a11y_status.flags." + flag + ".read") === "ok",
      "cu_linux_unlock_honesty_a11y_flag_read_" + label + "_" + flag + ":" + JSON.stringify(snapshot)
    );
    const value = at(snapshot, "org_a11y_status.flags." + flag + ".value");
    ensure(
      value === true || value === false,
      "cu_linux_unlock_honesty_a11y_flag_value_" + label + "_" + flag + ":" + JSON.stringify(snapshot)
    );
  }
  const independent = independent_a11y_status_flags(cu_env(""));
  ensure(independent !== null, "cu_linux_unlock_honesty_a11y_independent_missing_" + label);
  for (const flag of ["IsEnabled", "ScreenReaderEnabled"]) {
    ensure(
      at(independent, flag) === at(snapshot, "org_a11y_status.flags." + flag + ".value"),
      "cu_linux_unlock_honesty_a11y_flag_mismatch_" + label + "_" + flag + ":"
        + JSON.stringify({ snapshot: snapshot.org_a11y_status.flags[flag], independent: independent })
    );
  }
}

function chrome_window(run_directory, executable, title_prefix) {
  const inventory = run_cu(run_directory, executable, "observe", ["windows"]);
  const rows = inventory.data.windows === undefined ? inventory.data : inventory.data.windows;
  for (const row of rows) {
    if (text_at(row, "app_name") === "chrome"
      && text_at(row, "title").indexOf(title_prefix) === 0) {
      return {
        handle: "" + at(row, "handle"),
        pid: int_at(row, "process_id"),
      };
    }
  }
  return null;
}

function native_tree_stats(run_directory, executable, pid) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "",
    "pid = int(sys.argv[1])",
    "max_depth = int(sys.argv[2])",
    "max_nodes = int(sys.argv[3])",
    "",
    "def node_role(obj):",
    "    try:",
    "        rn = obj.getRoleName()",
    "        if rn and rn.strip(): return rn.lower()",
    "    except Exception: pass",
    "    return pyatspi.role.getName(obj.getRole()).lower()",
    "",
    "def walk_bfs(root, max_depth, budget):",
    "    out = []",
    "    queue = [(root, 0)]",
    "    while queue and len(out) < budget:",
    "        current, depth = queue.pop(0)",
    "        role = node_role(current)",
    "        out.append({'depth': depth, 'role': role})",
    "        if depth >= max_depth: continue",
    "        try: child_count = current.childCount",
    "        except Exception: continue",
    "        for i in range(child_count):",
    "            try: child = current.getChildAtIndex(i)",
    "            except Exception: child = None",
    "            if child is not None: queue.append((child, depth + 1))",
    "    return out",
    "",
    "def web_nodes(nodes):",
    "    roots = [i for i, n in enumerate(nodes) if n['role'] in ('web area', 'webarea')]",
    "    if not roots: return 0",
    "    web_depth = nodes[roots[0]]['depth']",
    "    return sum(1 for n in nodes if n['depth'] >= web_depth)",
    "",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "app = None",
    "for i in range(desktop.childCount):",
    "    candidate = desktop.getChildAtIndex(i)",
    "    try:",
    "        if candidate.get_process_id() == pid:",
    "            app = candidate",
    "            break",
    "    except Exception: pass",
    "if app is None:",
    "    raise SystemExit('cu_linux_unlock_honesty_no_app')",
    "",
    "nodes = walk_bfs(app, max_depth, max_nodes)",
    "max_seen = max((n['depth'] for n in nodes), default=0)",
    "print(json.dumps({",
    "    'count': len(nodes),",
    "    'max_depth': max_seen,",
    "    'web_nodes': web_nodes(nodes),",
    "}))",
  ].join("\n");
  const output = rh.command("/usr/bin/python3", [
    "-c", script,
    "" + pid,
    "" + TREE_DEPTH,
    "" + MAX_NODES,
  ], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 60000,
  });
  ensure(output.success === true,
    "cu_linux_unlock_honesty_native:" + output.stderr + output.stdout);
  const line = output.stdout.trim().split("\n").pop();
  return JSON.parse(line);
}

function wait_native_ready(run_directory, executable, pid, minimum) {
  let last = null;
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    last = native_tree_stats(run_directory, executable, pid);
    if (last.count >= minimum) { return last; }
    harness.sleep_ms(250);
  }
  throw "cu_linux_unlock_honesty_native_not_ready:" + JSON.stringify(last);
}
const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "cu_linux_unlock_honesty_executable_missing:" + executable);
ensure(direct_file(abi_library), "cu_linux_unlock_honesty_library_missing:" + abi_library);

const uname = rh.command("/usr/bin/uname", ["-s"], { timeout_ms: 10000 });
ensure(uname.success === true && uname.stdout.trim() === "Linux",
  "cu_linux_unlock_honesty_requires_linux");

const context = harness.new_context(repo, "cu-linux-unlock-honesty");
const run_directory = rh.join(repo, "target/cu-linux-unlock-honesty-smoke-run");
rh.create_dir_all(run_directory);

const fixture_title = "CEO Unlock " + context.run_id;
const fixture_source = rh.join(repo, "fixtures/cu/311c-chrome-unlock.html");
const fixture = rh.join(run_directory, "311c-chrome-unlock.html");
let fixture_html = rh.read_text(fixture_source);
fixture_html = fixture_html.replace("311c Chrome Unlock Fixture", fixture_title);
rh.write_text(fixture, fixture_html);

const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
const port = 9900 + (rh.pid() % 500);
let chrome_child = -1;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP unlock typed-fails usage when --window handle is zero");
  assert_unlock_usage_limit(run_directory, executable);

  print("STEP unlock typed-fails usage when AT-SPI --name or other unexpected arguments are present");
  assert_unlock_atspi_name_usage_limit(run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before actuate/read-back court");
    assert_get_extents_usage_limit(run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
  }

  if (!atspi_available) {
    print("STEP unlock typed-fail host-limit when independent pyatspi desktop probe is unavailable");
    assert_unlock_host_limit_when_atspi_absent(run_directory, executable);
    succeeded = 1;
  } else {
  const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  ensure(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
    "cu_linux_unlock_honesty_port_in_use:" + port);

  print("STEP launch owned Chrome with AT-SPI renderer accessibility enabled");
  chrome_child = harness.start({
    program: launcher,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--new-window",
      "file://" + fixture,
    ],
    current_dir: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  for (let attempt = 0; attempt < 80; attempt = attempt + 1) {
    const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
      cwd: run_directory,
      timeout_ms: 3000,
    });
    if (probe.success === true && probe.stdout.indexOf("Browser") >= 0) { break; }
    harness.sleep_ms(250);
  }

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "20000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_unlock_honesty_window_wait");

  let window = null;
  for (let attempt = 0; attempt < 40 && window === null; attempt = attempt + 1) {
    window = chrome_window(run_directory, executable, fixture_title);
    if (window === null) { harness.sleep_ms(250); }
  }
  ensure(window !== null, "cu_linux_unlock_honesty_window_missing");
  const handle = window.handle;
  const chrome_pid = window.pid;
  ensure(chrome_pid > 0, "cu_linux_unlock_honesty_pid:" + JSON.stringify(window));

  print("STEP locked baseline: independent pyatspi tree stats before unlock");
  const before_native = wait_native_ready(run_directory, executable, chrome_pid, 10);

  print("STEP CU unlock pokes org.a11y.Status and re-reads the bounded tree");
  const unlocked = run_cu(run_directory, executable, "observe,actuate", [
    "unlock", "--window", handle,
  ]);
  const poked = flag_at(unlocked, "data.poked");
  const reason = text_at(unlocked, "data.reason");

  if (!poked) {
    ensure(
      reason.indexOf("org.a11y.Status") >= 0 || reason.indexOf("AT-SPI") >= 0,
      "cu_linux_unlock_honesty_typed_gap_missing_reason:" + JSON.stringify(unlocked.data)
    );
    print("PASS typed gap: unlock could not poke org.a11y.Status (" + reason + ")");
    succeeded = 1;
  } else {
    ensure(
      text_at(unlocked, "data.poke").indexOf("org.a11y.Status") >= 0,
      "cu_linux_unlock_honesty_poke:" + JSON.stringify(unlocked.data)
    );

    print("STEP unlocked readback: independent pyatspi tree stats after unlock agree with CU counts");
    const after_native = native_tree_stats(run_directory, executable, chrome_pid);
    const cu_before = int_at(unlocked, "data.returned_before");
    const cu_after = int_at(unlocked, "data.returned");
    const cu_web_before = int_at(unlocked, "data.web_nodes_before");
    const cu_web_after = int_at(unlocked, "data.web_nodes_after");
    const grew = flag_at(unlocked, "data.grew");

    assert_a11y_status_readback("before", at(unlocked, "data.a11y_status_before"));
    assert_a11y_status_readback("after", at(unlocked, "data.a11y_status_after"));

    ensure(
      after_native.count >= before_native.count,
      "cu_linux_unlock_honesty_native_shrank:"
        + JSON.stringify({ before: before_native, after: after_native })
    );
    ensure(
      cu_before === before_native.count,
      "cu_linux_unlock_honesty_cu_before_mismatch:"
        + JSON.stringify({ cu_before: cu_before, native_before: before_native.count })
    );
    ensure(
      cu_after === after_native.count,
      "cu_linux_unlock_honesty_cu_after_mismatch:"
        + JSON.stringify({ cu_after: cu_after, native_after: after_native.count })
    );
    ensure(
      cu_web_before === before_native.web_nodes,
      "cu_linux_unlock_honesty_cu_web_before_mismatch:"
        + JSON.stringify({ cu_web_before: cu_web_before, native_before: before_native.web_nodes })
    );
    ensure(
      cu_web_after === after_native.web_nodes,
      "cu_linux_unlock_honesty_cu_web_after_mismatch:"
        + JSON.stringify({ cu_web_after: cu_web_after, native_after: after_native.web_nodes })
    );
    ensure(
      grew === (after_native.count > before_native.count || after_native.web_nodes > before_native.web_nodes),
      "cu_linux_unlock_honesty_grew_mismatch:"
        + JSON.stringify({
          grew: grew,
          before: before_native,
          after: after_native,
          cu_web_before: cu_web_before,
          cu_web_after: cu_web_after,
        })
    );
    if (after_native.count > before_native.count || after_native.web_nodes > before_native.web_nodes) {
      print("PASS unlocked: native tree grew before " + before_native.count + " after " + after_native.count
        + " web " + before_native.web_nodes + " -> " + after_native.web_nodes);
    } else {
      ensure(
        text_at(unlocked, "data.ax") === "empty-chrome" || text_at(unlocked, "data.ax") === "content",
        "cu_linux_unlock_honesty_no_growth_unexpected_ax:" + JSON.stringify(unlocked.data)
      );
      print("PASS locked baseline and unlocked agreement without growth native "
        + before_native.count + " web " + before_native.web_nodes
        + " cu " + cu_before + " -> " + cu_after
        + " ax=" + text_at(unlocked, "data.ax"));
    }
    succeeded = 1;
  }
  }
} catch (error) {
  failure = "" + error;
}

if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup: " + error); }
}

if (succeeded !== 0) {
  harness.emit_evidence(context, declared_evidence, declared_evidence[0]);
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux unlock honesty with independent AT-SPI read-back and typed unlock/get-extents usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux unlock typed-fails with typed unlock/get-extents host-limit honesty when independent pyatspi desktop probe is unavailable");
  }
}
if (failure !== "") { throw failure; }
return;
