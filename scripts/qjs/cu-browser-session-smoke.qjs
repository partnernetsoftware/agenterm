// Public macOS black-box contract for one ACU-owned browser profile.
// Args: REPO AGENTERM_EXE AGENTERM_CU_EXE; AGENTERM_CU_BROWSER_EXE names the browser.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.browser-managed-profile.macos",
  "cu.browser-bridge-owned-profile.macos",
  "cu.browser-bridge-reload.macos",
  "cu.browser-window-lifecycle.macos",
  "cu.browser-cdp-actuate.macos",
  "cu.browser-cdp-screenshot.macos",
  "cu.browser-cdp-pointer-dialog-files.macos",
  "cu.browser-download.macos"
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 3, "expected: REPO AGENTERM_EXE AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let product = rh.absolute(args[1]);
let executable = rh.absolute(args[2]);
const browser_input = rh.env_or("AGENTERM_CU_BROWSER_EXE", "");
ensure(browser_input !== "", "cu_browser_session_browser_env_missing");
const browser = rh.absolute(browser_input);
if (!direct_file(product) && harness.host_is_windows()) { product = product + ".exe"; }
if (!direct_file(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(direct_file(product), "cu_browser_session_product_missing");
ensure(direct_file(executable), "cu_browser_session_executable_missing");
ensure(direct_file(browser), "cu_browser_session_browser_missing");

const context = harness.new_context(repo, "cu-browser-session");
const audit_path = rh.join(context.run_directory, "cu-audit.jsonl");
const name = "qjswasm-owned-profile";
let controlled_focus_handle = null;
let focus_fixture = null;
let runtime_session = null;
const children = [];

function invoke(grant, arguments) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: context.run_directory,
    env: {
      AGENTERM_CU_AUDIT_PATH: audit_path,
      AGENTERM_CU_RUNTIME_PATH: rh.join(context.run_directory, "cu-runtime.json"),
      AGENTERM_NO_ACTIVATE: "1"
    },
    timeout_ms: 30000
  });
  const text = output.stdout.trim();
  ensure(text !== "", "cu_browser_session_empty_reply");
  return { output: output, reply: JSON.parse(text) };
}

function require_ok(result, label) {
  ensure(result.output.success === true && result.reply.ok === true, label);
  return result.reply;
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const result = at(value, dotted);
  return result === undefined || result === null ? "" : "" + result;
}

function page_target(rows) {
  for (const row of rows) {
    if (row.type === "page") { return row; }
  }
  return null;
}

function center(box) {
  return {
    x: box.x + box.width / 2,
    y: box.y + box.height / 2
  };
}

function cleanup() {
  if (runtime_session !== null) {
    invoke("actuate", [
      "session-end", runtime_session.session_id, "--lease", runtime_session.lease, "--confirm"
    ]);
    runtime_session = null;
  }
  const stopped = invoke("actuate", [
    "browser-session-stop", name, "--expect", "stopped", "--timeout-ms", "15000"
  ]);
  if (stopped.reply.ok === true) {
    invoke("actuate", ["browser-session-remove", name, "--expect", "stopped"]);
  }
  shutdown_focus_fixture();
}

function restore_exact_focus(handle, label) {
  if (handle === null) { return; }
  const current = invoke("observe", ["windows", "--focused", "true", "--max", "2"]);
  if (current.reply.ok === true && current.reply.data.returned === 1 &&
      current.reply.data.windows[0].handle === handle) { return; }
  const restored = invoke("actuate", ["activate", "--window", "" + handle]);
  ensure(restored.reply.ok === true && restored.reply.data.verified === true,
    label);
}

function shutdown_focus_fixture() {
  if (focus_fixture === null) { return; }
  const spec = harness.configured_cli_spec(context, product, ["shutdown"]);
  const stopped = rh.command(spec.program, spec.args, {
    cwd: context.run_directory,
    env: spec.env,
    timeout_ms: 30000
  });
  ensure(stopped.success === true, "cu_browser_session_focus_fixture_shutdown_failed");
  focus_fixture = null;
}

function connection_in(rows, id) {
  for (const row of rows) {
    if (row.connection_id === id) { return true; }
  }
  return false;
}

function one_new_bridge_connection(deadline_ms, baseline) {
  while (rh.now_ms() < deadline_ms) {
    const inventory = invoke("observe", ["browser-bridge-connections"]);
    if (inventory.reply.ok === true) {
      const added = [];
      for (const row of inventory.reply.data.connections) {
        if (!connection_in(baseline, row.connection_id)) { added.push(row); }
      }
      if (added.length === 1) { return added[0]; }
      ensure(added.length < 2, "cu_browser_bridge_connection_ambiguous");
    }
    rh.sleep_ms(50);
  }
  throw "cu_browser_bridge_connection_timeout";
}

let succeeded = 0;
let failure = "";
try {
  print("STEP start one owned foreground fixture for exact cross-application focus restoration");
  const fixture_spec = harness.configured_spec_with_env(
    context, product, ["--address", context.address], {}, ["AGENTERM_NO_ACTIVATE"]
  );
  focus_fixture = harness.start_child(context, fixture_spec, "focus-fixture");
  children.push(focus_fixture);
  harness.wait_for_spawned_server(context, product, focus_fixture.handle);
  const fixture_pid = focus_fixture.pid;
  let fixture_row = null;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    const rows = invoke("observe", ["windows", "--pid", "" + fixture_pid, "--max", "2"]);
    if (rows.reply.ok === true && rows.reply.data.returned === 1) {
      fixture_row = rows.reply.data.windows[0];
      break;
    }
    rh.sleep_ms(25);
  }
  ensure(fixture_row !== null, "cu_browser_session_focus_fixture_window_missing");
  controlled_focus_handle = fixture_row.handle;
  restore_exact_focus(controlled_focus_handle,
    "cu_browser_session_focus_fixture_activation_failed");
  const baseline_list = require_ok(invoke("observe", ["browser-session-list"]), "cu_browser_session_baseline_failed");
  const baseline_connections = require_ok(invoke("observe", ["browser-bridge-connections"]), "cu_browser_bridge_baseline_failed").data.connections;
  print("STEP start one isolated headless browser with exact owner identity");
  const started = require_ok(invoke("actuate", [
    "browser-session-start", name, "--browser", browser,
    "--bridge",
    "--ready-timeout-ms", "15000", "--ttl-ms", "120000"
  ]), "cu_browser_session_start_failed");
  ensure(started.command === "browser-session-start", "cu_browser_session_start_command");
  ensure(started.data.state === "ready" && started.data.owned === true, "cu_browser_session_start_state");
  ensure(started.data.owner_observation === "live", "cu_browser_session_owner_not_live");
  ensure(started.data.owner.pid > 0 && started.data.browser.pid > 0, "cu_browser_session_process_identity");
  ensure(started.data.owner.pid !== started.data.browser.pid, "cu_browser_session_process_alias");
  ensure(started.data.endpoint.port > 0, "cu_browser_session_endpoint");

  print("STEP fixed MV3 identity creates one exact connection without a window or focus effect");
  const connection = one_new_bridge_connection(rh.now_ms() + 15000, baseline_connections);
  ensure(connection.process.pid > 0, "cu_browser_bridge_process_identity");
  ensure(connection.endpoint.extension_id === "knofdkmmpkbnjhdkcjddbakbpmgpmjpe", "cu_browser_bridge_extension_identity");
  let bridge_id = connection.connection_id;
  const bridge_status = require_ok(invoke("observe", [
    "browser-bridge-status", bridge_id
  ]), "cu_browser_bridge_status_failed");
  ensure(bridge_status.data.result.protocol === 2, "cu_browser_bridge_protocol");
  ensure(bridge_status.data.result.extension_version === "1.1.0",
    "cu_browser_bridge_extension_version");
  ensure(bridge_status.data.result.profile_instance_id.length === 32,
    "cu_browser_bridge_profile_identity");
  const profile_instance_id = bridge_status.data.result.profile_instance_id;
  const commands = bridge_status.data.result.commands;
  ensure(commands.length === 7 && commands[0] === "status" && commands[1] === "tabs" &&
    commands[2] === "windows" && commands[3] === "window-open" &&
    commands[4] === "window-state" && commands[5] === "debug-read" && commands[6] === "reload",
    "cu_browser_bridge_commands");
  const bridge_tabs = require_ok(invoke("observe", [
    "browser-bridge-tabs", bridge_id
  ]), "cu_browser_bridge_tabs_failed");
  const bridge_windows = require_ok(invoke("observe", [
    "browser-bridge-windows", bridge_id
  ]), "cu_browser_bridge_windows_failed");
  ensure(Array.isArray(bridge_tabs.data.result.tabs), "cu_browser_bridge_tabs_shape");
  ensure(Array.isArray(bridge_windows.data.result.windows), "cu_browser_bridge_windows_shape");

  print("STEP typed MV3 window lifecycle creates one focused and one background window");
  const first_window = require_ok(invoke("observe,actuate", [
    "browser-bridge-window-open", bridge_id, "--url", "data:text/html,acu-first", "--focused"
  ]), "cu_browser_bridge_first_window_open_failed");
  ensure(first_window.data.result.performed === true && first_window.data.result.verified === true,
    "cu_browser_bridge_first_window_unverified");
  ensure(first_window.data.result.requested_focused === true &&
    first_window.data.result.window.focused === true,
    "cu_browser_bridge_first_window_focus");
  const first_window_id = first_window.data.result.window.window_id;
  const second_window = require_ok(invoke("observe,actuate", [
    "browser-bridge-window-open", bridge_id, "--url", "data:text/html,acu-second"
  ]), "cu_browser_bridge_second_window_open_failed");
  ensure(second_window.data.result.performed === true && second_window.data.result.verified === true,
    "cu_browser_bridge_second_window_unverified");
  ensure(second_window.data.result.focus_changed === false &&
    second_window.data.result.focused_window_before === first_window_id &&
    second_window.data.result.focused_window_after === first_window_id &&
    second_window.data.result.window.focused === false,
    "cu_browser_bridge_background_window_focus_changed");
  const second_window_id = second_window.data.result.window.window_id;
  const attached_tab_id = second_window.data.result.window.active_tab_id;

  print("STEP stable profile identity owns one exact tab across a background bridge reload");
  runtime_session = require_ok(invoke("actuate", [
    "session-start", "--label", "browser-bridge-court", "--ttl-seconds", "120"
  ]), "cu_browser_bridge_runtime_session_failed").data;
  const attached = require_ok(invoke("actuate", [
    "browser-bridge-attach", bridge_id,
    "--tab-id", "" + attached_tab_id,
    "--session", runtime_session.session_id,
    "--lease", runtime_session.lease,
    "--ttl-seconds", "90"
  ]), "cu_browser_bridge_attach_failed");
  ensure(attached.data.profile_instance_id === profile_instance_id &&
    attached.data.tab.tab_id === attached_tab_id &&
    attached.data.focus_changed === false && attached.data.verified === true,
    "cu_browser_bridge_attach_unverified");
  const reloaded = require_ok(invoke("actuate", [
    "browser-bridge-reload", bridge_id,
    "--tab-id", "" + attached_tab_id,
    "--session", runtime_session.session_id,
    "--lease", runtime_session.lease,
    "--ttl-seconds", "90", "--timeout-ms", "15000"
  ]), "cu_browser_bridge_reload_failed");
  ensure(reloaded.data.old_connection_id === bridge_id &&
    reloaded.data.connection_id !== bridge_id &&
    reloaded.data.profile_instance_id === profile_instance_id &&
    reloaded.data.reload_scope === "native-connection" &&
    reloaded.data.tab.tab_id === attached_tab_id &&
    reloaded.data.old_connection_gone === true &&
    reloaded.data.unique_reconnect === true &&
    reloaded.data.focus_changed === false && reloaded.data.verified === true,
    "cu_browser_bridge_reload_unverified");
  const bridge_audit = rh.read_text(audit_path);
  ensure(!bridge_audit.includes(profile_instance_id) &&
    !bridge_audit.includes(runtime_session.lease),
    "cu_browser_bridge_audit_leaked_identity_or_lease");
  bridge_id = reloaded.data.connection_id;
  const live_windows = require_ok(invoke("observe", [
    "browser-bridge-windows", bridge_id
  ]), "cu_browser_bridge_live_windows_failed");
  ensure(live_windows.data.result.windows.length === 2,
    "cu_browser_bridge_live_window_count");

  print("STEP exact background window minimizes, restores, maximizes and restores with stable focus");
  for (const state of ["minimized", "normal", "maximized", "normal"]) {
    const changed = require_ok(invoke("observe,actuate", [
      "browser-bridge-window-state", bridge_id,
      "--window-id", "" + second_window_id, "--state", state
    ]), "cu_browser_bridge_window_state_failed_" + state);
    ensure(changed.data.result.requested_state === state &&
      changed.data.result.after.state === state &&
      changed.data.result.verified === true &&
      changed.data.result.focus_preserved === true &&
      changed.data.desktop_focus.verified === true &&
      changed.data.desktop_focus.after === changed.data.desktop_focus.before &&
      changed.data.result.after.focused === false &&
      changed.data.result.after.active_tab_id === second_window.data.result.window.active_tab_id,
      "cu_browser_bridge_window_state_unverified_" + state);
  }

  print("STEP whole-browser background state changes preserve the exact native foreground window");
  restore_exact_focus(controlled_focus_handle,
    "cu_browser_session_controlled_focus_restore_failed");
  for (const state of ["minimized", "normal"]) {
    const changed = require_ok(invoke("observe,actuate", [
      "browser-bridge-window-state", bridge_id,
      "--window-id", "" + second_window_id, "--state", state
    ]), "cu_browser_bridge_background_state_failed_" + state);
    ensure(changed.data.result.after.state === state &&
      changed.data.result.focus_preserved === true &&
      changed.data.desktop_focus.before === controlled_focus_handle &&
      changed.data.desktop_focus.after === controlled_focus_handle &&
      changed.data.desktop_focus.verified === true,
      "cu_browser_bridge_background_native_focus_changed_" + state);
  }

  print("STEP list and status preserve the exact generation and process identities");
  const listed = require_ok(invoke("observe", ["browser-session-list"]), "cu_browser_session_list_failed");
  ensure(listed.data.total === baseline_list.data.total + 1, "cu_browser_session_list_count");
  let listed_own = null;
  for (const row of listed.data.sessions) {
    if (row.name === name) { listed_own = row; }
  }
  ensure(listed_own !== null, "cu_browser_session_list_own_missing");
  ensure(listed_own.generation === started.data.generation, "cu_browser_session_list_generation");
  ensure(listed_own.owner.pid === started.data.owner.pid, "cu_browser_session_list_owner");
  ensure(listed_own.browser.pid === started.data.browser.pid, "cu_browser_session_list_browser");
  const status = require_ok(invoke("observe", ["browser-session-status", name]), "cu_browser_session_status_failed");
  ensure(status.data.state === "ready" && status.data.owner_observation === "live", "cu_browser_session_status_state");

  print("STEP public CDP verbs act on the owned page without foreground activation");
  const port = "" + started.data.endpoint.port;
  const targets = require_ok(invoke("observe", [
    "page-targets", "--port", port
  ]), "cu_browser_session_targets_failed");
  const target = page_target(targets.data.targets);
  ensure(target !== null && target.id !== "", "cu_browser_session_page_target_missing");
  const target_id = "" + target.id;
  const fixture = "data:text/html,<title>acu-qjs-browser</title>"
    + "<form onsubmit='document.getElementById(\"out\").textContent=\"submitted\";return false'>"
    + "<input id='q'><button id='go' type='button' onclick='document.getElementById(\"out\").textContent=\"clicked\"'>Go</button></form>"
    + "<p id='out'>idle</p><input id='upload' type='file'>"
    + "<a id='download' download='smoke.txt' href='data:text/plain,acu-download-smoke'>Download</a>"
    + "<div id='drag-from' style='display:inline-block;width:80px;height:40px'>From</div>"
    + "<div id='drag-to' style='display:inline-block;width:80px;height:40px'>To</div>"
    + "<script>let d=false;document.getElementById('drag-from').onmousedown=e=>{d=e.isTrusted};"
    + "document.getElementById('drag-to').onmouseup=e=>{if(d&&e.isTrusted){document.body.dataset.drag='done'}}</script>"
    + "<div id='scroll' style='height:80px;overflow:auto'><div style='height:900px'>Tall</div></div>";
  const nav = require_ok(invoke("observe,actuate", [
    "page-nav", "--port", port, "--target-id", target_id,
    "--url", fixture, "--wait-ms", "10000"
  ]), "cu_browser_session_nav_failed");
  ensure(nav.data.verified === true && nav.data.focus_changed === false, "cu_browser_session_nav_unverified");
  ensure(nav.data.final_title === "acu-qjs-browser", "cu_browser_session_nav_title");

  const input = require_ok(invoke("observe", [
    "page-find", "--port", port, "--target-id", target_id, "--selector", "#q"
  ]), "cu_browser_session_find_input_failed");
  ensure(input.data.returned === 1 && input.data.nodes[0].editable === true, "cu_browser_session_input_shape");
  const filled = require_ok(invoke("observe,actuate", [
    "page-fill", "--port", port, "--target-id", target_id,
    "--node", "" + input.data.nodes[0].node, "--text", "qjswasm", "--clear"
  ]), "cu_browser_session_fill_failed");
  ensure(filled.data.verified === true && filled.data.focus_changed === false, "cu_browser_session_fill_unverified");
  const clicked = require_ok(invoke("observe,actuate", [
    "page-click", "--port", port, "--target-id", target_id, "--selector", "#go"
  ]), "cu_browser_session_click_failed");
  ensure(clicked.data.performed === true && clicked.data.verified === true && clicked.data.focus_changed === false,
    "cu_browser_session_click_unverified");
  const business = require_ok(invoke("observe", [
    "page-js", "--port", port, "--target-id", target_id,
    "--expression", "document.getElementById('out').textContent"
  ]), "cu_browser_session_business_read_failed");
  ensure(text_at(business, "data.value") === "clicked", "cu_browser_session_click_business_state");

  print("STEP pointer, dialog and file verbs prove exact post-state and secret-free receipts");
  const button = require_ok(invoke("observe", [
    "page-find", "--port", port, "--target-id", target_id, "--selector", "#go"
  ]), "cu_browser_session_find_button_failed");
  const button_xy = center(button.data.nodes[0].box);
  const hovered = require_ok(invoke("observe,actuate", [
    "page-hover", "--port", port, "--target-id", target_id,
    "--x", "" + button_xy.x, "--y", "" + button_xy.y
  ]), "cu_browser_session_hover_failed");
  ensure(hovered.data.verified === true && hovered.data.focus_changed === false, "cu_browser_session_hover_unverified");
  const scroll_node = require_ok(invoke("observe", [
    "page-find", "--port", port, "--target-id", target_id, "--selector", "#scroll"
  ]), "cu_browser_session_find_scroll_failed");
  const scroll_xy = center(scroll_node.data.nodes[0].box);
  const scrolled = require_ok(invoke("observe,actuate", [
    "page-scroll", "--port", port, "--target-id", target_id,
    "--x", "" + scroll_xy.x, "--y", "" + scroll_xy.y, "--dy", "120"
  ]), "cu_browser_session_scroll_failed");
  ensure(scrolled.data.verified === true && scrolled.data.focus_changed === false, "cu_browser_session_scroll_unverified");
  const from_node = require_ok(invoke("observe", [
    "page-find", "--port", port, "--target-id", target_id, "--selector", "#drag-from"
  ]), "cu_browser_session_find_drag_from_failed");
  const to_node = require_ok(invoke("observe", [
    "page-find", "--port", port, "--target-id", target_id, "--selector", "#drag-to"
  ]), "cu_browser_session_find_drag_to_failed");
  const from_xy = center(from_node.data.nodes[0].box);
  const to_xy = center(to_node.data.nodes[0].box);
  const dragged = require_ok(invoke("observe,actuate", [
    "page-drag", "--port", port, "--target-id", target_id,
    "--x1", "" + from_xy.x, "--y1", "" + from_xy.y,
    "--x2", "" + to_xy.x, "--y2", "" + to_xy.y
  ]), "cu_browser_session_drag_failed");
  ensure(dragged.data.verified === true && dragged.data.release_attempted === true,
    "cu_browser_session_drag_unverified");

  const upload = rh.join(context.run_directory, "upload.txt");
  rh.write_text(upload, "hello");
  const files = require_ok(invoke("observe,actuate", [
    "page-files", "--port", port, "--target-id", target_id,
    "--selector", "#upload", upload
  ]), "cu_browser_session_files_failed");
  ensure(files.data.verified === true, "cu_browser_session_files_unverified");
  ensure(files.data.verification.observed[0].name === "upload.txt"
    && files.data.verification.observed[0].size === 5, "cu_browser_session_files_readback");
  ensure(JSON.stringify(files).indexOf(upload) < 0, "cu_browser_session_files_path_leak");

  const dialog_secret = "dialog-" + rh.pid();
  const armed = require_ok(invoke("observe", [
    "page-js", "--port", port, "--target-id", target_id,
    "--expression", "setTimeout(()=>{document.body.dataset.dialog=prompt('Question','')||'dismissed'},100);'armed'"
  ]), "cu_browser_session_dialog_arm_failed");
  ensure(text_at(armed, "data.value") === "armed", "cu_browser_session_dialog_not_armed");
  const dialog = require_ok(invoke("observe,actuate", [
    "page-dialog", "--port", port, "--target-id", target_id,
    "--text", dialog_secret, "--wait-ms", "3000"
  ]), "cu_browser_session_dialog_failed");
  ensure(dialog.data.verified === true && JSON.stringify(dialog).indexOf(dialog_secret) < 0,
    "cu_browser_session_dialog_receipt");
  const dialog_read = require_ok(invoke("observe", [
    "page-js", "--port", port, "--target-id", target_id,
    "--expression", "document.body.dataset.dialog"
  ]), "cu_browser_session_dialog_read_failed");
  ensure(text_at(dialog_read, "data.value") === dialog_secret, "cu_browser_session_dialog_business_state");

  print("STEP screenshot and download publish bounded files while download contents stay unread");
  const screenshot_path = rh.join(context.run_directory, "page.png");
  const screenshot = require_ok(invoke("observe", [
    "page-screenshot", "--port", port, "--target-id", target_id, "--out", screenshot_path
  ]), "cu_browser_session_screenshot_failed");
  ensure(screenshot.data.focus_changed === false && direct_file(screenshot_path), "cu_browser_session_screenshot_missing");
  ensure(rh.metadata(screenshot_path).len > 100, "cu_browser_session_screenshot_empty");
  const download_directory = rh.join(context.run_directory, "downloads");
  rh.create_dir_all(download_directory);
  const downloaded = require_ok(invoke("observe,actuate", [
    "page-download", "--port", port, "--target-id", target_id,
    "--selector", "#download", "--download-dir", download_directory, "--wait-ms", "10000"
  ]), "cu_browser_session_download_failed");
  ensure(downloaded.data.state === "completed" && downloaded.data.suggested_filename === "smoke.txt",
    "cu_browser_session_download_state");
  ensure(downloaded.data.content_read === false && downloaded.data.focus_changed === false,
    "cu_browser_session_download_authority");
  ensure(direct_file(downloaded.data.final_path) && rh.metadata(downloaded.data.final_path).len > 0,
    "cu_browser_session_download_missing");
  ensure(downloaded.data.final_path.startsWith(download_directory + "/"), "cu_browser_session_download_escape");

  print("STEP explicit stop proves owner and browser cleanup before removal");
  const ended_runtime = require_ok(invoke("actuate", [
    "session-end", runtime_session.session_id, "--lease", runtime_session.lease, "--confirm"
  ]), "cu_browser_bridge_runtime_session_end_failed");
  ensure(ended_runtime.data.released_locks === 1,
    "cu_browser_bridge_runtime_lock_not_released");
  runtime_session = null;
  const stopped = require_ok(invoke("actuate", [
    "browser-session-stop", name, "--expect", "stopped", "--timeout-ms", "15000"
  ]), "cu_browser_session_stop_failed");
  ensure(stopped.data.state === "stopped", "cu_browser_session_stop_state");
  ensure(stopped.data.owner_observation === "dead", "cu_browser_session_owner_not_reaped");
  restore_exact_focus(controlled_focus_handle,
    "cu_browser_session_controlled_focus_after_stop_failed");
  const bridge_after_stop = require_ok(invoke("observe", [
    "browser-bridge-connections"
  ]), "cu_browser_bridge_cleanup_inventory_failed");
  ensure(bridge_after_stop.data.connections.length === baseline_connections.length, "cu_browser_bridge_host_not_reaped");
  for (const row of baseline_connections) {
    ensure(connection_in(bridge_after_stop.data.connections, row.connection_id), "cu_browser_bridge_baseline_changed");
  }
  const removed = require_ok(invoke("actuate", [
    "browser-session-remove", name, "--expect", "stopped"
  ]), "cu_browser_session_remove_failed");
  ensure(removed.data.state === "removed" && removed.data.verified === true, "cu_browser_session_remove_state");
  const empty = require_ok(invoke("observe", ["browser-session-list"]), "cu_browser_session_empty_list_failed");
  ensure(empty.data.total === baseline_list.data.total, "cu_browser_session_not_empty");

  print("STEP same name restarts cleanly and TTL owns bounded cleanup");
  const restarted = require_ok(invoke("actuate", [
    "browser-session-start", name, "--browser", browser,
    "--bridge",
    "--ready-timeout-ms", "15000", "--ttl-ms", "1200"
  ]), "cu_browser_session_restart_failed");
  ensure(restarted.data.state === "ready", "cu_browser_session_restart_state");
  const deadline = rh.now_ms() + 15000;
  let expired = null;
  while (rh.now_ms() < deadline) {
    const observed = invoke("observe", ["browser-session-status", name]);
    if (observed.reply.ok === true && observed.reply.data.state === "stopped") {
      expired = observed.reply;
      break;
    }
    rh.sleep_ms(100);
  }
  ensure(expired !== null, "cu_browser_session_ttl_timeout");
  ensure(expired.data.owner_observation === "dead", "cu_browser_session_ttl_owner_not_reaped");
  ensure(expired.data.last_error_code === "browser_ttl_expired", "cu_browser_session_ttl_reason");
  const expired_removed = require_ok(invoke("actuate", [
    "browser-session-remove", name, "--expect", "stopped"
  ]), "cu_browser_session_ttl_remove_failed");
  ensure(expired_removed.data.verified === true, "cu_browser_session_ttl_remove_unverified");
  shutdown_focus_fixture();
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (succeeded === 0) {
  try { cleanup(); } catch (_) {}
}
let completion_failure = "";
try { harness.complete_children(context, children, succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  for (const id of declared_evidence) {
    harness.emit_evidence(context, declared_evidence, id);
  }
  harness.remove_run(context);
  print("PASS: owned browser profile, MV3 bridge and public CDP lifecycle are verified");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
