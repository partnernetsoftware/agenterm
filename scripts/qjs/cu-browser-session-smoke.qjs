// Public macOS black-box contract for one ACU-owned headless browser profile.
// Args: REPO AGENTERM_CU_EXE; AGENTERM_CU_BROWSER_EXE names the browser.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.browser-managed-profile.macos",
  "cu.browser-bridge-owned-profile.macos"
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
const browser_input = rh.env_or("AGENTERM_CU_BROWSER_EXE", "");
ensure(browser_input !== "", "cu_browser_session_browser_env_missing");
const browser = rh.absolute(browser_input);
if (!direct_file(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(direct_file(executable), "cu_browser_session_executable_missing");
ensure(direct_file(browser), "cu_browser_session_browser_missing");

const context = harness.new_context(repo, "cu-browser-session");
const name = "qjswasm-owned-profile";

function invoke(grant, arguments) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: context.run_directory,
    env: {
      AGENTERM_CU_AUDIT_PATH: rh.join(context.run_directory, "cu-audit.jsonl"),
      AGENTERM_NO_ACTIVATE: "1"
    },
    timeout_ms: 30000
  });
  const text = output.stdout.trim();
  ensure(text !== "", "cu_browser_session_empty_reply");
  return { output: output, reply: JSON.parse(text) };
}

function require_ok(result, label) {
  ensure(result.output.success === true && result.reply.ok === true, label);
  return result.reply;
}

function cleanup() {
  const stopped = invoke("actuate", [
    "browser-session-stop", name, "--expect", "stopped", "--timeout-ms", "15000"
  ]);
  if (stopped.reply.ok === true) {
    invoke("actuate", ["browser-session-remove", name, "--expect", "stopped"]);
  }
}

function connection_in(rows, id) {
  for (const row of rows) {
    if (row.connection_id === id) { return true; }
  }
  return false;
}

function one_new_bridge_connection(deadline_ms, baseline) {
  while (rh.now_ms() < deadline_ms) {
    const inventory = invoke("observe", ["browser-bridge-connections"]);
    if (inventory.reply.ok === true) {
      const added = [];
      for (const row of inventory.reply.data.connections) {
        if (!connection_in(baseline, row.connection_id)) { added.push(row); }
      }
      if (added.length === 1) { return added[0]; }
      ensure(added.length < 2, "cu_browser_bridge_connection_ambiguous");
    }
    rh.sleep_ms(50);
  }
  throw "cu_browser_bridge_connection_timeout";
}

let succeeded = 0;
let failure = "";
try {
  const baseline_list = require_ok(invoke("observe", ["browser-session-list"]), "cu_browser_session_baseline_failed");
  const baseline_connections = require_ok(invoke("observe", ["browser-bridge-connections"]), "cu_browser_bridge_baseline_failed").data.connections;
  print("STEP start one isolated headless browser with exact owner identity");
  const started = require_ok(invoke("actuate", [
    "browser-session-start", name, "--browser", browser,
    "--bridge",
    "--ready-timeout-ms", "15000", "--ttl-ms", "60000"
  ]), "cu_browser_session_start_failed");
  ensure(started.command === "browser-session-start", "cu_browser_session_start_command");
  ensure(started.data.state === "ready" && started.data.owned === true, "cu_browser_session_start_state");
  ensure(started.data.owner_observation === "live", "cu_browser_session_owner_not_live");
  ensure(started.data.owner.pid > 0 && started.data.browser.pid > 0, "cu_browser_session_process_identity");
  ensure(started.data.owner.pid !== started.data.browser.pid, "cu_browser_session_process_alias");
  ensure(started.data.endpoint.port > 0, "cu_browser_session_endpoint");

  print("STEP fixed MV3 identity creates one exact connection without a window or focus effect");
  const connection = one_new_bridge_connection(rh.now_ms() + 15000, baseline_connections);
  ensure(connection.process.pid > 0, "cu_browser_bridge_process_identity");
  ensure(connection.endpoint.extension_id === "knofdkmmpkbnjhdkcjddbakbpmgpmjpe", "cu_browser_bridge_extension_identity");
  const bridge_id = connection.connection_id;
  const bridge_status = require_ok(invoke("observe", [
    "browser-bridge-status", bridge_id
  ]), "cu_browser_bridge_status_failed");
  ensure(bridge_status.data.result.protocol === 1, "cu_browser_bridge_protocol");
  const commands = bridge_status.data.result.commands;
  ensure(commands.length === 5 && commands[0] === "status" && commands[1] === "tabs" &&
    commands[2] === "windows" && commands[3] === "window-state" &&
    commands[4] === "debug-read", "cu_browser_bridge_commands");
  const bridge_tabs = require_ok(invoke("observe", [
    "browser-bridge-tabs", bridge_id
  ]), "cu_browser_bridge_tabs_failed");
  const bridge_windows = require_ok(invoke("observe", [
    "browser-bridge-windows", bridge_id
  ]), "cu_browser_bridge_windows_failed");
  ensure(Array.isArray(bridge_tabs.data.result.tabs), "cu_browser_bridge_tabs_shape");
  ensure(Array.isArray(bridge_windows.data.result.windows), "cu_browser_bridge_windows_shape");

  print("STEP list and status preserve the exact generation and process identities");
  const listed = require_ok(invoke("observe", ["browser-session-list"]), "cu_browser_session_list_failed");
  ensure(listed.data.total === baseline_list.data.total + 1, "cu_browser_session_list_count");
  let listed_own = null;
  for (const row of listed.data.sessions) {
    if (row.name === name) { listed_own = row; }
  }
  ensure(listed_own !== null, "cu_browser_session_list_own_missing");
  ensure(listed_own.generation === started.data.generation, "cu_browser_session_list_generation");
  ensure(listed_own.owner.pid === started.data.owner.pid, "cu_browser_session_list_owner");
  ensure(listed_own.browser.pid === started.data.browser.pid, "cu_browser_session_list_browser");
  const status = require_ok(invoke("observe", ["browser-session-status", name]), "cu_browser_session_status_failed");
  ensure(status.data.state === "ready" && status.data.owner_observation === "live", "cu_browser_session_status_state");

  print("STEP explicit stop proves owner and browser cleanup before removal");
  const stopped = require_ok(invoke("actuate", [
    "browser-session-stop", name, "--expect", "stopped", "--timeout-ms", "15000"
  ]), "cu_browser_session_stop_failed");
  ensure(stopped.data.state === "stopped", "cu_browser_session_stop_state");
  ensure(stopped.data.owner_observation === "dead", "cu_browser_session_owner_not_reaped");
  const bridge_after_stop = require_ok(invoke("observe", [
    "browser-bridge-connections"
  ]), "cu_browser_bridge_cleanup_inventory_failed");
  ensure(bridge_after_stop.data.connections.length === baseline_connections.length, "cu_browser_bridge_host_not_reaped");
  for (const row of baseline_connections) {
    ensure(connection_in(bridge_after_stop.data.connections, row.connection_id), "cu_browser_bridge_baseline_changed");
  }
  const removed = require_ok(invoke("actuate", [
    "browser-session-remove", name, "--expect", "stopped"
  ]), "cu_browser_session_remove_failed");
  ensure(removed.data.state === "removed" && removed.data.verified === true, "cu_browser_session_remove_state");
  const empty = require_ok(invoke("observe", ["browser-session-list"]), "cu_browser_session_empty_list_failed");
  ensure(empty.data.total === baseline_list.data.total, "cu_browser_session_not_empty");

  print("STEP same name restarts cleanly and TTL owns bounded cleanup");
  const restarted = require_ok(invoke("actuate", [
    "browser-session-start", name, "--browser", browser,
    "--bridge",
    "--ready-timeout-ms", "15000", "--ttl-ms", "1200"
  ]), "cu_browser_session_restart_failed");
  ensure(restarted.data.state === "ready", "cu_browser_session_restart_state");
  const deadline = rh.now_ms() + 15000;
  let expired = null;
  while (rh.now_ms() < deadline) {
    const observed = invoke("observe", ["browser-session-status", name]);
    if (observed.reply.ok === true && observed.reply.data.state === "stopped") {
      expired = observed.reply;
      break;
    }
    rh.sleep_ms(100);
  }
  ensure(expired !== null, "cu_browser_session_ttl_timeout");
  ensure(expired.data.owner_observation === "dead", "cu_browser_session_ttl_owner_not_reaped");
  ensure(expired.data.last_error_code === "browser_ttl_expired", "cu_browser_session_ttl_reason");
  const expired_removed = require_ok(invoke("actuate", [
    "browser-session-remove", name, "--expect", "stopped"
  ]), "cu_browser_session_ttl_remove_failed");
  ensure(expired_removed.data.verified === true, "cu_browser_session_ttl_remove_unverified");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (succeeded === 0) {
  try { cleanup(); } catch (_) {}
}
let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  for (const id of declared_evidence) {
    harness.emit_evidence(context, declared_evidence, id);
  }
  harness.remove_run(context);
  print("PASS: owned browser profile and exact MV3 bridge lifecycle are verified");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
