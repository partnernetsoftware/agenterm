// CEO: topmost/untopmost --expect topmost|untopmost on Linux.
// Acceptance is smoke read-back only: independent xprop _NET_WM_STATE_ABOVE,
// independent pyatspi frame showing/visible state, and windows inventory above
// field must match --expect after each verb. AT-SPI does not expose always-on-
// top; pyatspi proves the fixture frame is still showing, xprop proves ABOVE.
// Typed topmost/untopmost usage must reject AT-SPI --name, --coords, --bogus,
// and other unexpected arguments; typed get-extents --name usage AND host-limit
// paths must both hold before the topmost actuate/read-back court. Typed usage,
// destructive-gate refusals, missing-window and headless host-limit paths must
// hold before any owned fixture window exists. Prefer host-limit clarity over
// fake success. AT-SPI/--name only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-topmost-expect-state",
];

const AT_SPI_PROBE_NAME = "Topmost Court Anchor";
const MISSING_HANDLE = "99999999";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_topmost_expect_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_topmost_expect_reply:" + JSON.stringify(document));
  return document;
}

function invoke_topmost_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "actuate",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_topmost_expect_actuate_cli:" + output.stderr);
  const reply = JSON.parse(trimmed);
  const command = text_at(reply, "command");
  ensure(
    command === "topmost" || command === "untopmost" || command === "usage",
    "cu_linux_topmost_expect_actuate_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_topmost_expect_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function topmost_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["topmost"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_topmost_expect_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function untopmost_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["untopmost"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_topmost_expect_untopmost_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function assert_topmost_usage_limit(run_directory, executable) {
  const topmost_zero = run_cu_reply(run_directory, executable, "actuate", [
    "topmost", "--window", "0", "--expect", "topmost",
  ]);
  ensure(!output_success(topmost_zero), "cu_linux_topmost_expect_usage_ok:" + JSON.stringify(topmost_zero));
  ensure(
    text_at(topmost_zero, "error.code") === "usage",
    "cu_linux_topmost_expect_usage_code:" + JSON.stringify(topmost_zero.error)
  );
  ensure(
    text_at(topmost_zero, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_topmost_expect_usage_message:" + JSON.stringify(topmost_zero.error)
  );

  const untopmost_zero = run_cu_reply(run_directory, executable, "actuate", [
    "untopmost", "--window", "0", "--expect", "untopmost",
  ]);
  ensure(!output_success(untopmost_zero), "cu_linux_topmost_expect_untopmost_usage_ok:" + JSON.stringify(untopmost_zero));
  ensure(
    text_at(untopmost_zero, "error.code") === "usage",
    "cu_linux_topmost_expect_untopmost_usage_code:" + JSON.stringify(untopmost_zero.error)
  );
}

function assert_topmost_atspi_name_usage_limit(run_directory, executable, env) {
  const topmost_with_name = invoke_topmost_reply(run_directory, executable, [
    "topmost",
    "--window", "1",
    "--name", AT_SPI_PROBE_NAME,
    "--expect", "topmost",
  ], env);
  ensure(!output_success(topmost_with_name), "cu_linux_topmost_expect_usage_name_ok:" + JSON.stringify(topmost_with_name));
  ensure(
    text_at(topmost_with_name, "error.code") === "usage",
    "cu_linux_topmost_expect_usage_name_code:" + JSON.stringify(topmost_with_name.error)
  );
  ensure(
    text_at(topmost_with_name, "command") === "usage",
    "cu_linux_topmost_expect_usage_name_command:" + JSON.stringify(topmost_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(topmost_with_name, "error.message"), "--name"),
    "cu_linux_topmost_expect_usage_name_message:" + JSON.stringify(topmost_with_name.error)
  );

  const untopmost_with_name = invoke_topmost_reply(run_directory, executable, [
    "untopmost",
    "--window", "1",
    "--name", AT_SPI_PROBE_NAME,
    "--expect", "untopmost",
  ], env);
  ensure(!output_success(untopmost_with_name), "cu_linux_topmost_expect_untopmost_usage_name_ok:" + JSON.stringify(untopmost_with_name));
  ensure(
    text_at(untopmost_with_name, "error.code") === "usage",
    "cu_linux_topmost_expect_untopmost_usage_name_code:" + JSON.stringify(untopmost_with_name.error)
  );
  ensure(
    text_at(untopmost_with_name, "command") === "usage",
    "cu_linux_topmost_expect_untopmost_usage_name_command:" + JSON.stringify(untopmost_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(untopmost_with_name, "error.message"), "--name"),
    "cu_linux_topmost_expect_untopmost_usage_name_message:" + JSON.stringify(untopmost_with_name.error)
  );

  const topmost_with_bogus = invoke_topmost_reply(run_directory, executable, [
    "topmost",
    "--window", "1",
    "--expect", "topmost",
    "--bogus",
  ], env);
  ensure(!output_success(topmost_with_bogus), "cu_linux_topmost_expect_usage_bogus_ok:" + JSON.stringify(topmost_with_bogus));
  ensure(
    text_at(topmost_with_bogus, "error.code") === "usage",
    "cu_linux_topmost_expect_usage_bogus_code:" + JSON.stringify(topmost_with_bogus.error)
  );
  ensure(
    text_at(topmost_with_bogus, "command") === "usage",
    "cu_linux_topmost_expect_usage_bogus_command:" + JSON.stringify(topmost_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(topmost_with_bogus, "error.message"), "--bogus"),
    "cu_linux_topmost_expect_usage_bogus_message:" + JSON.stringify(topmost_with_bogus.error)
  );

  const untopmost_with_bogus = invoke_topmost_reply(run_directory, executable, [
    "untopmost",
    "--window", "1",
    "--expect", "untopmost",
    "--bogus",
  ], env);
  ensure(!output_success(untopmost_with_bogus), "cu_linux_topmost_expect_untopmost_usage_bogus_ok:" + JSON.stringify(untopmost_with_bogus));
  ensure(
    text_at(untopmost_with_bogus, "error.code") === "usage",
    "cu_linux_topmost_expect_untopmost_usage_bogus_code:" + JSON.stringify(untopmost_with_bogus.error)
  );
  ensure(
    text_at(untopmost_with_bogus, "command") === "usage",
    "cu_linux_topmost_expect_untopmost_usage_bogus_command:" + JSON.stringify(untopmost_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(untopmost_with_bogus, "error.message"), "--bogus"),
    "cu_linux_topmost_expect_untopmost_usage_bogus_message:" + JSON.stringify(untopmost_with_bogus.error)
  );

  const topmost_with_coords = invoke_topmost_reply(run_directory, executable, [
    "topmost",
    "--window", "1",
    "--expect", "topmost",
    "--coords", "10,10",
  ], env);
  ensure(!output_success(topmost_with_coords), "cu_linux_topmost_expect_usage_coords_ok:" + JSON.stringify(topmost_with_coords));
  ensure(
    text_at(topmost_with_coords, "error.code") === "usage",
    "cu_linux_topmost_expect_usage_coords_code:" + JSON.stringify(topmost_with_coords.error)
  );
  ensure(
    text_at(topmost_with_coords, "command") === "usage",
    "cu_linux_topmost_expect_usage_coords_command:" + JSON.stringify(topmost_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(topmost_with_coords, "error.message"), "--coords"),
    "cu_linux_topmost_expect_usage_coords_message:" + JSON.stringify(topmost_with_coords.error)
  );

  const untopmost_with_coords = invoke_topmost_reply(run_directory, executable, [
    "untopmost",
    "--window", "1",
    "--expect", "untopmost",
    "--coords", "10,10",
  ], env);
  ensure(!output_success(untopmost_with_coords), "cu_linux_topmost_expect_untopmost_usage_coords_ok:" + JSON.stringify(untopmost_with_coords));
  ensure(
    text_at(untopmost_with_coords, "error.code") === "usage",
    "cu_linux_topmost_expect_untopmost_usage_coords_code:" + JSON.stringify(untopmost_with_coords.error)
  );
  ensure(
    text_at(untopmost_with_coords, "command") === "usage",
    "cu_linux_topmost_expect_untopmost_usage_coords_command:" + JSON.stringify(untopmost_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(untopmost_with_coords, "error.message"), "--coords"),
    "cu_linux_topmost_expect_untopmost_usage_coords_message:" + JSON.stringify(untopmost_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_topmost_expect_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_topmost_expect_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_topmost_expect_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_topmost_expect_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_topmost_expect_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_topmost_expect_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_topmost_expect_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords), "cu_linux_topmost_expect_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_topmost_expect_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_topmost_expect_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_topmost_expect_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus), "cu_linux_topmost_expect_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_topmost_expect_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_topmost_expect_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_topmost_expect_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_topmost_expect_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_topmost_expect_extents_unavailable_code:" + code
  );
}

function assert_topmost_destructive_gate(run_directory, executable) {
  const missing_target = topmost_refused(
    run_directory, executable, ["--expect", "topmost"], "refused"
  );
  ensure(
    text_at(missing_target, "error.detail.reason") === "destructive_gate"
      && text_at(missing_target, "error.detail.effect") === "not_performed"
      && missing_target.error.detail.missing.length === 1
      && text_of(missing_target.error.detail.missing[0]) === "target",
    "cu_linux_topmost_expect_missing_target:" + JSON.stringify(missing_target)
  );

  const missing_postcondition = untopmost_refused(
    run_directory, executable, ["--window", "1"], "refused"
  );
  ensure(
    text_at(missing_postcondition, "error.detail.reason") === "destructive_gate"
      && missing_postcondition.error.detail.missing.length === 1
      && text_of(missing_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_topmost_expect_missing_postcondition:" + JSON.stringify(missing_postcondition)
  );

  const wrong_postcondition = topmost_refused(
    run_directory, executable, ["--window", "1", "--expect", "untopmost"], "refused"
  );
  ensure(
    text_at(wrong_postcondition, "error.detail.reason") === "destructive_gate"
      && wrong_postcondition.error.detail.missing.length === 1
      && text_of(wrong_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_topmost_expect_wrong_postcondition:" + JSON.stringify(wrong_postcondition)
  );

  const untopmost_missing = untopmost_refused(
    run_directory, executable, ["--expect", "untopmost"], "refused"
  );
  ensure(
    text_at(untopmost_missing, "error.detail.reason") === "destructive_gate"
      && untopmost_missing.error.detail.missing.length === 1
      && text_of(untopmost_missing.error.detail.missing[0]) === "target",
    "cu_linux_topmost_expect_untopmost_missing_target:" + JSON.stringify(untopmost_missing)
  );
}

function assert_topmost_missing_window(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "actuate", [
    "topmost", "--window", MISSING_HANDLE, "--expect", "topmost",
  ]);
  ensure(!output_success(reply), "cu_linux_topmost_expect_missing_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "window_op_failed",
    "cu_linux_topmost_expect_missing_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_topmost_expect_missing_effect:" + JSON.stringify(reply.error)
  );

  const untopmost_reply = run_cu_reply(run_directory, executable, "actuate", [
    "untopmost", "--window", MISSING_HANDLE, "--expect", "untopmost",
  ]);
  ensure(!output_success(untopmost_reply), "cu_linux_topmost_expect_untopmost_missing_ok:" + JSON.stringify(untopmost_reply));
  ensure(
    text_at(untopmost_reply, "error.code") === "window_op_failed",
    "cu_linux_topmost_expect_untopmost_missing_code:" + JSON.stringify(untopmost_reply.error)
  );
  ensure(
    text_at(untopmost_reply, "error.detail.effect") === "not_performed",
    "cu_linux_topmost_expect_untopmost_missing_effect:" + JSON.stringify(untopmost_reply.error)
  );
}

function assert_headless_host_limit(run_directory, executable, verb, label) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    [verb, "--window", "1", "--expect", verb === "topmost" ? "topmost" : "untopmost"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_topmost_expect_headless_ok_" + label + ":" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_topmost_expect_headless_code_" + label + ":" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("mechanism unavailable") >= 0
      || message.indexOf("agt_native_window_set_topmost") >= 0,
    "cu_linux_topmost_expect_headless_message_" + label + ":" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_topmost_expect_headless_effect_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_rows(reply) {
  const data = reply.data;
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  for (const row of window_rows(reply)) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_net_wm_above(run_directory, executable, handle) {
  const xprop = rh.command("xprop", ["-id", "" + handle, "_NET_WM_STATE"], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (!xprop.success) { return false; }
  return xprop.stdout.indexOf("_NET_WM_STATE_ABOVE") >= 0;
}

function independent_pyatspi_frame_state(run_directory, executable, title) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "frame = None",
    "for i in range(desktop.childCount):",
    "    app = desktop.getChildAtIndex(i)",
    "    if app is None:",
    "        continue",
    "    for j in range(app.childCount):",
    "        candidate = app.getChildAtIndex(j)",
    "        if candidate is not None and candidate.name == title:",
    "            frame = candidate",
    "            break",
    "    if frame is not None:",
    "        break",
    "if frame is None:",
    "    print(json.dumps({'found': False}))",
    "    raise SystemExit(0)",
    "states = frame.getState()",
    "print(json.dumps({",
    "    'found': True,",
    "    'name': frame.name,",
    "    'role': frame.getRoleName(),",
    "    'showing': bool(states.contains(pyatspi.STATE_SHOWING)),",
    "    'visible': bool(states.contains(pyatspi.STATE_VISIBLE)),",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(
    output.success === true,
    "cu_linux_topmost_expect_pyatspi_probe:" + output.stderr + output.stdout
  );
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_topmost_expect_pyatspi_empty");
  return JSON.parse(trimmed);
}

function ensure_pyatspi_frame_showing(probe, label) {
  ensure(
    flag_at(probe, "found") === true
      && flag_at(probe, "showing") === true
      && flag_at(probe, "visible") === true,
    "cu_linux_topmost_expect_pyatspi_" + label + ":" + JSON.stringify(probe)
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-topmost-expect-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_topmost_expect_fixture_missing:" + fixture_source);

print("STEP topmost/untopmost typed-fails usage when --window handle is zero");
assert_topmost_usage_limit(run_directory, executable);

print("STEP topmost/untopmost typed-fails usage when AT-SPI --name/--coords/--bogus is present");
assert_topmost_atspi_name_usage_limit(run_directory, executable, env);

print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before topmost actuate/read-back court");
assert_get_extents_usage_limit(run_directory, executable, env);

print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before topmost actuate/read-back court");
assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

print("STEP topmost/untopmost typed-fails refused destructive_gate when target or postcondition is missing");
assert_topmost_destructive_gate(run_directory, executable);

print("STEP topmost/untopmost typed-fails window_op_failed when handle is absent from inventory");
assert_topmost_missing_window(run_directory, executable);

print("STEP topmost/untopmost without DISPLAY typed-fails unsupported host-limit");
assert_headless_host_limit(run_directory, executable, "topmost", "topmost");
assert_headless_host_limit(run_directory, executable, "untopmost", "untopmost");

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_topmost_expect_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_topmost_expect_window_missing");
  const handle = int_at(row, "handle");
  const handle_text = "" + handle;
  ensure(handle > 0, "cu_linux_topmost_expect_handle:" + JSON.stringify(row));
  ensure(
    flag_at(row, "above") === false,
    "cu_linux_topmost_expect_baseline_not_above:" + JSON.stringify(row)
  );
  ensure(
    independent_net_wm_above(run_directory, executable, handle) === false,
    "cu_linux_topmost_expect_baseline_xprop_not_above"
  );
  if (atspi_available) {
    print("STEP independent pyatspi frame state baseline: showing/visible, AT-SPI has no always-on-top");
    ensure_pyatspi_frame_showing(
      independent_pyatspi_frame_state(run_directory, executable, fixture_title),
      "baseline"
    );
  } else {
    print("STEP host-limit: independent pyatspi desktop probe is unavailable; xprop _NET_WM_STATE remains the topmost state court");
  }

  print("STEP destructive_gate refusals on a live handle must not change xprop or inventory");
  topmost_refused(
    run_directory, executable, ["--window", handle_text, "--expect", "untopmost"], "refused"
  );
  untopmost_refused(
    run_directory, executable, ["--window", handle_text, "--expect", "topmost"], "refused"
  );
  ensure(
    independent_net_wm_above(run_directory, executable, handle) === false,
    "cu_linux_topmost_expect_refusal_xprop_changed"
  );
  const refusal_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(refusal_row !== null, "cu_linux_topmost_expect_refusal_row_missing");
  ensure(
    flag_at(refusal_row, "above") === false,
    "cu_linux_topmost_expect_refusal_inventory_changed:" + JSON.stringify(refusal_row)
  );
  if (atspi_available) {
    ensure_pyatspi_frame_showing(
      independent_pyatspi_frame_state(run_directory, executable, fixture_title),
      "refusal"
    );
  }

  print("STEP topmost --window " + handle_text + " --expect topmost");
  const topmost = run_cu(run_directory, executable, "actuate", [
    "topmost", "--window", handle_text, "--expect", "topmost",
  ]);
  ensure(
    flag_at(topmost, "data.verified")
      && flag_at(topmost, "data.after.above") === true,
    "cu_linux_topmost_expect_reply_topmost:" + JSON.stringify(topmost.data)
  );

  print("STEP independent xprop _NET_WM_STATE read-back: topmost must be true");
  ensure(
    independent_net_wm_above(run_directory, executable, handle) === true,
    "cu_linux_topmost_expect_xprop_above"
  );

  print("STEP independent windows inventory read-back: above must be true");
  const topmost_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(topmost_row !== null, "cu_linux_topmost_expect_topmost_row_missing");
  ensure(
    flag_at(topmost_row, "above") === true,
    "cu_linux_topmost_expect_inventory_above:" + JSON.stringify(topmost_row)
  );

  if (atspi_available) {
    print("STEP independent pyatspi frame state after topmost: still showing/visible (AT-SPI has no ABOVE)");
    ensure_pyatspi_frame_showing(
      independent_pyatspi_frame_state(run_directory, executable, fixture_title),
      "topmost"
    );
  }

  print("STEP untopmost --window " + handle_text + " --expect untopmost");
  const untopmost = run_cu(run_directory, executable, "actuate", [
    "untopmost", "--window", handle_text, "--expect", "untopmost",
  ]);
  ensure(
    flag_at(untopmost, "data.verified")
      && flag_at(untopmost, "data.after.above") === false,
    "cu_linux_topmost_expect_reply_untopmost:" + JSON.stringify(untopmost.data)
  );

  print("STEP independent xprop _NET_WM_STATE read-back: topmost must be false");
  ensure(
    independent_net_wm_above(run_directory, executable, handle) === false,
    "cu_linux_topmost_expect_xprop_untopmost"
  );

  print("STEP independent windows inventory read-back: above must be false");
  const restored_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(restored_row !== null, "cu_linux_topmost_expect_untopmost_row_missing");
  ensure(
    flag_at(restored_row, "above") === false,
    "cu_linux_topmost_expect_inventory_untopmost:" + JSON.stringify(restored_row)
  );

  if (atspi_available) {
    print("STEP independent pyatspi frame state after untopmost: still showing/visible (AT-SPI has no ABOVE)");
    ensure_pyatspi_frame_showing(
      independent_pyatspi_frame_state(run_directory, executable, fixture_title),
      "untopmost"
    );
  }
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-topmost-expect");
harness.emit_evidence(context, declared_evidence, "cu.linux-topmost-expect-state");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux topmost/untopmost usage/host-limit/miss honesty + independent xprop, pyatspi showing/visible, and windows inventory topmost read-back with typed topmost/untopmost --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux topmost/untopmost usage/host-limit/miss honesty + independent xprop and windows inventory topmost read-back with typed topmost/untopmost --name/--coords/--bogus usage and get-extents --name host-limit honesty when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
}
return;
