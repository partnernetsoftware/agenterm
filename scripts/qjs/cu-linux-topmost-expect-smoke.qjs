// CEO: topmost/untopmost --expect topmost|untopmost on Linux.
// Acceptance is smoke read-back only: independent xprop _NET_WM_STATE_ABOVE and
// windows inventory above field must match --expect after each verb.
// Typed usage, destructive-gate refusals, missing-window and headless
// host-limit paths must hold before any owned fixture window exists.
// No --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-topmost-expect-state",
];

const MISSING_HANDLE = "99999999";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_topmost_expect_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_topmost_expect_reply:" + JSON.stringify(document));
  return document;
}

function topmost_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["topmost"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_topmost_expect_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function untopmost_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["untopmost"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_topmost_expect_untopmost_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function assert_topmost_usage_limit(run_directory, executable) {
  const topmost_zero = run_cu_reply(run_directory, executable, "actuate", [
    "topmost", "--window", "0", "--expect", "topmost",
  ]);
  ensure(!output_success(topmost_zero), "cu_linux_topmost_expect_usage_ok:" + JSON.stringify(topmost_zero));
  ensure(
    text_at(topmost_zero, "error.code") === "usage",
    "cu_linux_topmost_expect_usage_code:" + JSON.stringify(topmost_zero.error)
  );
  ensure(
    text_at(topmost_zero, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_topmost_expect_usage_message:" + JSON.stringify(topmost_zero.error)
  );

  const untopmost_zero = run_cu_reply(run_directory, executable, "actuate", [
    "untopmost", "--window", "0", "--expect", "untopmost",
  ]);
  ensure(!output_success(untopmost_zero), "cu_linux_topmost_expect_untopmost_usage_ok:" + JSON.stringify(untopmost_zero));
  ensure(
    text_at(untopmost_zero, "error.code") === "usage",
    "cu_linux_topmost_expect_untopmost_usage_code:" + JSON.stringify(untopmost_zero.error)
  );
}

function assert_topmost_destructive_gate(run_directory, executable) {
  const missing_target = topmost_refused(
    run_directory, executable, ["--expect", "topmost"], "refused"
  );
  ensure(
    text_at(missing_target, "error.detail.reason") === "destructive_gate"
      && text_at(missing_target, "error.detail.effect") === "not_performed"
      && missing_target.error.detail.missing.length === 1
      && text_of(missing_target.error.detail.missing[0]) === "target",
    "cu_linux_topmost_expect_missing_target:" + JSON.stringify(missing_target)
  );

  const missing_postcondition = untopmost_refused(
    run_directory, executable, ["--window", "1"], "refused"
  );
  ensure(
    text_at(missing_postcondition, "error.detail.reason") === "destructive_gate"
      && missing_postcondition.error.detail.missing.length === 1
      && text_of(missing_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_topmost_expect_missing_postcondition:" + JSON.stringify(missing_postcondition)
  );

  const wrong_postcondition = topmost_refused(
    run_directory, executable, ["--window", "1", "--expect", "untopmost"], "refused"
  );
  ensure(
    text_at(wrong_postcondition, "error.detail.reason") === "destructive_gate"
      && wrong_postcondition.error.detail.missing.length === 1
      && text_of(wrong_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_topmost_expect_wrong_postcondition:" + JSON.stringify(wrong_postcondition)
  );

  const untopmost_missing = untopmost_refused(
    run_directory, executable, ["--expect", "untopmost"], "refused"
  );
  ensure(
    text_at(untopmost_missing, "error.detail.reason") === "destructive_gate"
      && untopmost_missing.error.detail.missing.length === 1
      && text_of(untopmost_missing.error.detail.missing[0]) === "target",
    "cu_linux_topmost_expect_untopmost_missing_target:" + JSON.stringify(untopmost_missing)
  );
}

function assert_topmost_missing_window(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "actuate", [
    "topmost", "--window", MISSING_HANDLE, "--expect", "topmost",
  ]);
  ensure(!output_success(reply), "cu_linux_topmost_expect_missing_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "window_op_failed",
    "cu_linux_topmost_expect_missing_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_topmost_expect_missing_effect:" + JSON.stringify(reply.error)
  );

  const untopmost_reply = run_cu_reply(run_directory, executable, "actuate", [
    "untopmost", "--window", MISSING_HANDLE, "--expect", "untopmost",
  ]);
  ensure(!output_success(untopmost_reply), "cu_linux_topmost_expect_untopmost_missing_ok:" + JSON.stringify(untopmost_reply));
  ensure(
    text_at(untopmost_reply, "error.code") === "window_op_failed",
    "cu_linux_topmost_expect_untopmost_missing_code:" + JSON.stringify(untopmost_reply.error)
  );
  ensure(
    text_at(untopmost_reply, "error.detail.effect") === "not_performed",
    "cu_linux_topmost_expect_untopmost_missing_effect:" + JSON.stringify(untopmost_reply.error)
  );
}

function assert_headless_host_limit(run_directory, executable, verb, label) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    [verb, "--window", "1", "--expect", verb === "topmost" ? "topmost" : "untopmost"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_topmost_expect_headless_ok_" + label + ":" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_topmost_expect_headless_code_" + label + ":" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("mechanism unavailable") >= 0
      || message.indexOf("agt_native_window_set_topmost") >= 0,
    "cu_linux_topmost_expect_headless_message_" + label + ":" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_topmost_expect_headless_effect_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_rows(reply) {
  const data = reply.data;
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  for (const row of window_rows(reply)) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_net_wm_above(run_directory, executable, handle) {
  const xprop = rh.command("xprop", ["-id", "" + handle, "_NET_WM_STATE"], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (!xprop.success) { return false; }
  return xprop.stdout.indexOf("_NET_WM_STATE_ABOVE") >= 0;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-topmost-expect-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_topmost_expect_fixture_missing:" + fixture_source);

print("STEP topmost/untopmost typed-fails usage when --window handle is zero");
assert_topmost_usage_limit(run_directory, executable);

print("STEP topmost/untopmost typed-fails refused destructive_gate when target or postcondition is missing");
assert_topmost_destructive_gate(run_directory, executable);

print("STEP topmost/untopmost typed-fails window_op_failed when handle is absent from inventory");
assert_topmost_missing_window(run_directory, executable);

print("STEP topmost/untopmost without DISPLAY typed-fails unsupported host-limit");
assert_headless_host_limit(run_directory, executable, "topmost", "topmost");
assert_headless_host_limit(run_directory, executable, "untopmost", "untopmost");

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_topmost_expect_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_topmost_expect_window_missing");
  const handle = int_at(row, "handle");
  const handle_text = "" + handle;
  ensure(handle > 0, "cu_linux_topmost_expect_handle:" + JSON.stringify(row));
  ensure(
    flag_at(row, "above") === false,
    "cu_linux_topmost_expect_baseline_not_above:" + JSON.stringify(row)
  );
  ensure(
    independent_net_wm_above(run_directory, executable, handle) === false,
    "cu_linux_topmost_expect_baseline_xprop_not_above"
  );

  print("STEP destructive_gate refusals on a live handle must not change xprop or inventory");
  topmost_refused(
    run_directory, executable, ["--window", handle_text, "--expect", "untopmost"], "refused"
  );
  untopmost_refused(
    run_directory, executable, ["--window", handle_text, "--expect", "topmost"], "refused"
  );
  ensure(
    independent_net_wm_above(run_directory, executable, handle) === false,
    "cu_linux_topmost_expect_refusal_xprop_changed"
  );
  const refusal_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(refusal_row !== null, "cu_linux_topmost_expect_refusal_row_missing");
  ensure(
    flag_at(refusal_row, "above") === false,
    "cu_linux_topmost_expect_refusal_inventory_changed:" + JSON.stringify(refusal_row)
  );

  print("STEP topmost --window " + handle_text + " --expect topmost");
  const topmost = run_cu(run_directory, executable, "actuate", [
    "topmost", "--window", handle_text, "--expect", "topmost",
  ]);
  ensure(
    flag_at(topmost, "data.verified")
      && flag_at(topmost, "data.after.above") === true,
    "cu_linux_topmost_expect_reply_topmost:" + JSON.stringify(topmost.data)
  );

  print("STEP independent xprop _NET_WM_STATE read-back: topmost must be true");
  ensure(
    independent_net_wm_above(run_directory, executable, handle) === true,
    "cu_linux_topmost_expect_xprop_above"
  );

  print("STEP independent windows inventory read-back: above must be true");
  const topmost_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(topmost_row !== null, "cu_linux_topmost_expect_topmost_row_missing");
  ensure(
    flag_at(topmost_row, "above") === true,
    "cu_linux_topmost_expect_inventory_above:" + JSON.stringify(topmost_row)
  );

  print("STEP untopmost --window " + handle_text + " --expect untopmost");
  const untopmost = run_cu(run_directory, executable, "actuate", [
    "untopmost", "--window", handle_text, "--expect", "untopmost",
  ]);
  ensure(
    flag_at(untopmost, "data.verified")
      && flag_at(untopmost, "data.after.above") === false,
    "cu_linux_topmost_expect_reply_untopmost:" + JSON.stringify(untopmost.data)
  );

  print("STEP independent xprop _NET_WM_STATE read-back: topmost must be false");
  ensure(
    independent_net_wm_above(run_directory, executable, handle) === false,
    "cu_linux_topmost_expect_xprop_untopmost"
  );

  print("STEP independent windows inventory read-back: above must be false");
  const restored_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(restored_row !== null, "cu_linux_topmost_expect_untopmost_row_missing");
  ensure(
    flag_at(restored_row, "above") === false,
    "cu_linux_topmost_expect_inventory_untopmost:" + JSON.stringify(restored_row)
  );
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-topmost-expect");
harness.emit_evidence(context, declared_evidence, "cu.linux-topmost-expect-state");
harness.remove_run(context);
print("PASS: Linux topmost/untopmost usage/host-limit/miss honesty + independent xprop and windows inventory topmost read-back (no --coords)");
return;
