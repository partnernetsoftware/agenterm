// Prove the split headless server's lease, PTY, receipt, event, and workspace authority.
//
// Args:
//   --list-evidence
// or:
//   REPO SERVER_EXE CLI_EXE
//
// Ported from scripts/rh/server-smoke.rh; runs under `--profile tool`. The
// server is a door handle (process_spawn / _state / _wait), started, polled,
// told to shut down, and drained; `complete_unwaited` covers whatever was
// not. Windows-shaped like the original (`cmd.exe` in the PTY legs).
//
// Gap, one door op short: a handle carries neither the child's OS pid nor
// rh's `platform_facts`, so `protocol.pid == server.id` and the
// top-level-window facts of the original's first assertion are not checked
// here; the server-reported pid (`protocol.pid`) is what every later pid
// comparison uses.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

function catch_text(error) {
  return "" + error;
}

function configured_server_spec(server_exe, address, workspace_path, settings_path, instance_directory) {
  // rh's capture_limit(262144) has no spec field; the door caps capture at
  // its bridge limit (1 MiB) per stream.
  return {
    program: "" + server_exe,
    args: ["server", "--address", "" + address],
    env: {
      AGENTERM_IPC_ADDRESS: "" + address,
      AGENTERM_WORKSPACE_PATH: "" + workspace_path,
      AGENTERM_SETTINGS_PATH: "" + settings_path,
      AGENTERM_INSTANCE_DIR: "" + instance_directory,
      AGENTERM_NO_ACTIVATE: "1"
    },
    timeout_ms: 60000
  };
}

function invoke(context, cli, arguments, expected_failure) {
  return harness.invoke_cli_bounded(context, cli, arguments, expected_failure, []);
}

function command_text(context, cli, arguments) {
  const output = invoke(context, cli, arguments, 0);
  return ("" + output.stdout + output.stderr).trim();
}

function command_text_expect(context, cli, arguments, expected_failure) {
  const output = invoke(context, cli, arguments, expected_failure);
  return ("" + output.stdout + output.stderr).trim();
}

function command_json(context, cli, arguments, expected_failure) {
  const output = invoke(context, cli, arguments, expected_failure);
  const text = ("" + output.stdout + output.stderr).trim();
  return JSON.parse(text);
}

function count_tab_events(events, tab_id, kind) {
  const tab_id_text = "" + tab_id;
  const kind_text = "" + kind;
  let count = 0;
  for (const event of events) {
    if (("" + event.tab_id) === tab_id_text && ("" + event.kind) === kind_text) {
      count = count + 1;
    }
  }
  return count;
}

function wait_for_server(context, cli, server, waited) {
  for (let attempt = 0; attempt < 400; attempt = attempt + 1) {
    const probe = harness.run_cli_bounded(context, cli, ["protocol-info", "--running"], 0, []);
    if (probe.success) { return 0; }
    if (harness.state(server) === "exited") {
      const output = harness.drain(server, 2000, waited);
      throw "server_smoke_early_exit:" + output.stderr;
    }
    harness.sleep_ms(25);
  }
  throw "server_smoke_ready_timeout";
}

function wait_for_exit(child, code, waited) {
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    if (harness.state(child) === "exited") {
      return harness.drain(child, 2000, waited);
    }
    harness.sleep_ms(50);
  }
  throw code;
}

function find_tab(tabs, tab_id) {
  for (const tab of tabs) {
    if (("" + tab.id) === tab_id) { return tab; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  print("server.headless-authority");
  return 0;
}

harness.require(args.length === 3, "expected: REPO SERVER_EXE CLI_EXE");
const repo = rh.absolute(args[0]);
const server_exe = rh.absolute(args[1]);
const cli = rh.absolute(args[2]);
harness.require(rh.exists(server_exe), "server_smoke_server_missing");
harness.require(rh.exists(cli), "server_smoke_cli_missing");

const context = harness.new_context(repo, "server");
const run_id = context.run_id;
const server_address = "" + context.address;
const server_workspace = "" + context.workspace_path;
const server_settings = "" + context.settings_path;
const server_instance = "" + context.instance_directory;
const worker_pid = rh.pid();
const owned_children = [];
const waited = [];
let succeeded = false;
let failure = "";

try {
  print("STEP start internal headless server");
  const server = harness.start(configured_server_spec(
    server_exe, server_address, server_workspace, server_settings, server_instance
  ));
  owned_children.push(server);
  wait_for_server(context, cli, server, waited);
  const protocol = command_json(context, cli, ["protocol-info", "--running"], 0);
  // gap: no `server.platform_facts` and no `server.id` on a door handle
  // (see the header); the server's own pid stands in for `server.id`.
  const server_pid = protocol.pid;
  const ui_bridge = protocol.ui_bridge;
  harness.require(ui_bridge !== undefined && ui_bridge !== null, "server_smoke_process_ownership_boundary");
  const ownership_mode = "" + ui_bridge.ownership_mode;
  const server_executable = "" + ui_bridge.server_executable;
  harness.require(
    typeof server_pid === "number"
      && server_pid > 0
      && ownership_mode === "split_server_client"
      && server_executable === "agenterm.exe"
      && ui_bridge.replaceable_ui
      && ui_bridge.interactive_lease
      && ui_bridge.reconnect
      && ui_bridge.rollback_proven,
    "server_smoke_process_ownership_boundary"
  );

  print("STEP acquire, renew, conflict, heartbeat, and detach the UI lease");
  const lease_client_id = "server-smoke-ui-" + run_id;
  const attach_args = [
    "ui-lease", "attach",
    "--client-id", lease_client_id,
    "--client-pid", "" + worker_pid
  ];
  const lease = command_json(context, cli, attach_args, 0);
  const same_lease = command_json(context, cli, attach_args, 0);
  // UI leases are CAPACITY-bounded (`UI_LEASE_MAX_CLIENTS`), not exclusive:
  // a second client legitimately gets its OWN lease. What must hold is that
  // it does not inherit the first client's lease identity, and that the
  // first lease stays addressable (the `unauthorized` leg below still
  // proves a wrong lease id is rejected). See the rh original for the
  // history of this leg.
  const second_client = command_json(
    context, cli,
    [
      "ui-lease", "attach",
      "--client-id", "conflict-" + run_id,
      "--client-pid", "" + server_pid
    ],
    0
  );
  harness.require(
    ("" + lease.lease_id).startsWith("ui-")
      && same_lease.lease_id === lease.lease_id
      && same_lease.expires_unix_ms >= lease.expires_unix_ms
      && ("" + second_client.lease_id).startsWith("ui-")
      && second_client.lease_id !== lease.lease_id,
    "server_smoke_ui_lease_owner"
  );
  // Release it again so the rest of this smoke observes exactly one lease;
  // the later detach step asserts `attached == 0`.
  command_json(
    context, cli,
    [
      "ui-lease", "detach",
      "--lease-id", second_client.lease_id,
      "--client-pid", "" + server_pid
    ],
    0
  );
  const heartbeat = command_json(
    context, cli,
    [
      "ui-lease", "heartbeat",
      "--lease-id", lease.lease_id,
      "--client-pid", "" + worker_pid
    ],
    0
  );
  harness.require(
    heartbeat.lease_id === lease.lease_id && heartbeat.client_pid === worker_pid,
    "server_smoke_ui_lease_heartbeat"
  );

  print("STEP require the lease for UI select, resize, and binary input");
  const interaction_tab = command_text(
    context, cli,
    [
      "new-window", "-d", "-P", "-F", "#{window_id}",
      "-n", "interaction-" + run_id,
      "--", "cmd.exe", "/d", "/q"
    ]
  );
  const unauthorized = command_text_expect(
    context, cli,
    [
      "ui-interact", "select",
      "--lease-id", "wrong-lease",
      "--client-pid", "" + worker_pid,
      "-t", interaction_tab
    ],
    1
  );
  const selected = command_json(
    context, cli,
    [
      "ui-interact", "select",
      "--lease-id", lease.lease_id,
      "--client-pid", "" + worker_pid,
      "-t", interaction_tab
    ],
    0
  );
  const resized = command_json(
    context, cli,
    [
      "ui-interact", "resize",
      "--lease-id", lease.lease_id,
      "--client-pid", "" + worker_pid,
      "-t", interaction_tab,
      "--rows", "24", "--columns", "90"
    ],
    0
  );
  const interaction_marker = "AGENTERM_UI_INPUT";
  const input_text = "echo AGENTERM_UI_INPUT\r";
  const input = command_json(
    context, cli,
    [
      "ui-interact", "input",
      "--lease-id", lease.lease_id,
      "--client-pid", "" + worker_pid,
      "-t", interaction_tab,
      "--hex", "6563686f204147454e5445524d5f55495f494e5055540d"
    ],
    0
  );
  command_text(
    context, cli,
    [
      "wait-pane", "-t", interaction_tab,
      "--contains", interaction_marker,
      "--timeout-ms", "30000"
    ]
  );
  const interaction_bootstrap = command_json(context, cli, ["ui-bootstrap"], 0);
  let interaction_rows = 0;
  let interaction_columns = 0;
  const interaction_tab_state = find_tab(interaction_bootstrap.tabs, interaction_tab);
  if (interaction_tab_state !== null && interaction_tab_state.screen !== undefined) {
    interaction_rows = 0 + interaction_tab_state.screen.rows;
    interaction_columns = 0 + interaction_tab_state.screen.columns;
  }
  // The product rejects a wrong lease id with `ui_lease_not_attached` ("no
  // live UI lease matches the supplied identity") or, when the pid does
  // match a live lease, `ui_lease_owner_mismatch` ("... does not match a
  // live lease"). Accept either real rejection rather than inventing prose.
  harness.require(
    (unauthorized.includes("no live UI lease matches the supplied identity")
      || unauthorized.includes("does not match a live lease"))
      && selected.action === "select"
      && selected.tab_id === interaction_tab
      && resized.rows === 24
      && resized.columns === 90
      && input.input_bytes === input_text.length
      && interaction_bootstrap.active_tab_id === interaction_tab
      && interaction_rows === 24
      && interaction_columns === 90,
    "server_smoke_lease_gated_interaction"
  );
  const acknowledged = command_json(
    context, cli,
    [
      "ui-lease", "acknowledge",
      "--lease-id", lease.lease_id,
      "--client-pid", "" + worker_pid,
      "--sequence", "" + interaction_bootstrap.position.sequence
    ],
    0
  );
  const regression = command_text_expect(
    context, cli,
    [
      "ui-lease", "acknowledge",
      "--lease-id", lease.lease_id,
      "--client-pid", "" + worker_pid,
      "--sequence", "" + (interaction_bootstrap.position.sequence - 1)
    ],
    1
  );
  harness.require(
    acknowledged.observed_sequence === interaction_bootstrap.position.sequence
      && regression.includes("advance monotonically"),
    "server_smoke_ui_position_regression"
  );
  const detached = command_json(
    context, cli,
    [
      "ui-lease", "detach",
      "--lease-id", lease.lease_id,
      "--client-pid", "" + worker_pid
    ],
    0
  );
  const lease_status = command_json(context, cli, ["ui-lease", "status"], 0);
  harness.require(
    detached.detached && lease_status.attached === 0,
    "server_smoke_ui_lease_detach"
  );

  print("STEP create and observe a real PTY through public IPC");
  const hello = command_json(
    context, cli,
    [
      "ui-hello", "--minimum", "1", "--maximum", "1",
      "--client-id", "server-smoke-" + run_id
    ],
    0
  );
  for (const capability of [
    "interactive_lease",
    "lease_gated_interaction",
    "replaceable_ui_client",
    "lease_owned_client_state",
    "lease_owned_client_commands",
    "in_place_reconnect"
  ]) {
    harness.require(
      rh.array_has(hello.capabilities, capability),
      "server_smoke_capability_missing:" + capability
    );
  }
  const tab_id = command_text(
    context, cli,
    [
      "new-window", "-d", "-P", "-F", "#{window_id}",
      "-n", "headless-" + run_id,
      "--", "cmd.exe", "/d", "/c", "echo AGENTERM_HEADLESS_OK"
    ]
  );
  harness.require(tab_id.startsWith("@"), "server_smoke_stable_tab_id");
  command_text(
    context, cli,
    [
      "wait-pane", "-t", tab_id,
      "--contains", "AGENTERM_HEADLESS_OK",
      "--timeout-ms", "30000"
    ]
  );
  const capture = command_text(
    context, cli,
    ["capture-pane", "-p", "-t", tab_id, "--max-bytes", "16384"]
  );
  harness.require(capture.includes("AGENTERM_HEADLESS_OK"), "server_smoke_terminal_capture");

  print("STEP prove server-owned receipt replay and asynchronous completion");
  const receipt_request_id = "server-receipt-" + run_id;
  const receipt_args = [
    "--request-id", receipt_request_id, "--receipt-json",
    "set-tab-note", "-t", tab_id, "receipt-note-" + run_id
  ];
  const first_receipt = command_json(context, cli, receipt_args, 0);
  const replayed_receipt = command_json(context, cli, receipt_args, 0);
  const conflict_receipt = command_json(
    context, cli,
    [
      "--request-id", receipt_request_id, "--receipt-json",
      "set-tab-note", "-t", tab_id, "different-note"
    ],
    1
  );
  harness.require(
    first_receipt.outcome === "committed"
      && first_receipt.request_id === receipt_request_id
      && first_receipt.after_position.sequence === replayed_receipt.after_position.sequence
      && conflict_receipt.outcome === "no_op"
      && conflict_receipt.error !== undefined
      && conflict_receipt.error.code === "request_id_conflict",
    "server_smoke_receipt_replay"
  );
  let bootstrap = command_json(context, cli, ["ui-bootstrap"], 0);
  const interactive_tab = bootstrap.active_tab_id;
  const submission_marker = "AGENTERM_SERVER_RECEIPT_" + run_id;
  command_text(
    context, cli,
    ["set-composer", "-t", interactive_tab, "echo " + submission_marker]
  );
  const submission_request_id = "server-submit-" + run_id;
  const submission_args = [
    "--request-id", submission_request_id, "--receipt-json",
    "send-composer", "-t", interactive_tab
  ];
  const accepted_receipt = command_json(context, cli, submission_args, 0);
  harness.require(
    accepted_receipt.outcome === "accepted"
      && accepted_receipt.wait !== undefined
      && accepted_receipt.wait !== null
      && accepted_receipt.wait.condition === "submission_complete",
    "server_smoke_receipt_acceptance"
  );
  command_text(
    context, cli,
    [
      "wait-pane", "-t", interactive_tab,
      "--contains", submission_marker,
      "--submit-complete", "--timeout-ms", "30000"
    ]
  );
  const committed_receipt = command_json(context, cli, submission_args, 0);
  harness.require(
    committed_receipt.outcome === "committed"
      && (committed_receipt.wait === undefined || committed_receipt.wait === null)
      && committed_receipt.after_position.sequence > accepted_receipt.after_position.sequence,
    "server_smoke_receipt_completion"
  );

  print("STEP follow server-owned events into terminal post-state");
  const note = "server-note-" + run_id;
  command_text(context, cli, ["set-tab-note", "-t", tab_id, note]);
  bootstrap = command_json(context, cli, ["ui-bootstrap"], 0);
  const deltas = command_json(
    context, cli,
    [
      "ui-deltas",
      "--epoch", "" + hello.position.server_epoch,
      "--after", "" + hello.position.sequence,
      "--limit", "64"
    ],
    0
  );
  let tab_note = "";
  const noted_tab = find_tab(bootstrap.tabs, tab_id);
  if (noted_tab !== null) { tab_note = "" + noted_tab.note; }
  let post_note = "";
  const updated_tab = find_tab(deltas.tab_updates, tab_id);
  if (updated_tab !== null) { post_note = "" + updated_tab.note; }
  harness.require(
    hello.server_pid === server_pid
      && bootstrap.server_pid === server_pid
      && tab_note === note
      && post_note === note
      && count_tab_events(deltas.events, tab_id, "terminal.output") > 0
      && deltas.complete
      && !deltas.truncated,
    "server_smoke_causal_post_state"
  );

  print("STEP persist and stop server without a GUI process");
  command_text(context, cli, ["save-workspace"]);
  harness.require(rh.exists(server_workspace), "server_smoke_workspace_missing");
  harness.emit_evidence(context, ["server.headless-authority"], "server.headless-authority");
  command_text(context, cli, ["shutdown"]);
  const server_output = wait_for_exit(server, "server_smoke_shutdown_timeout", waited);
  harness.require(server_output.success, "server_smoke_server_exit_failure");
  print("PASS: headless server owns PTY, parser, workspace, events, and no HWND");
  succeeded = true;
} catch (error) {
  failure = catch_text(error);
}

let completion_failure = "";
try {
  harness.complete_unwaited(context, owned_children, waited, succeeded, failure);
} catch (error) {
  completion_failure = catch_text(error);
}
if (succeeded && completion_failure === "") {
  harness.remove_run(context);
}
if (failure !== "") {
  throw failure;
}
if (completion_failure !== "") {
  throw completion_failure;
}
return;
