// One deliberately cancelled embedded agenterm:acu invocation.
//
// The parent court owns setup and cleanup. This child blocks in the real
// 60-second job-wait, records the provider's typed cancellation reply, and
// finishes while the same borrowed token remains visible to Script auditing.
import * as acu from "agenterm:acu";

function require(condition, message) {
  if (!condition) { throw message; }
}

if (arg_count() === 1) {
  require(arg(0) === 0, "mode_argument_read_failed");
  require(tool_result() === "--sleeper", "unknown_child_mode");
  time_sleep_ms(60000);
  return;
}

require(arg_count() === 2, "expected: JOB_ID GENERATION");
require(arg(0) === 0, "job_id_argument_read_failed");
const job_id = tool_result();
require(arg(1) === 0, "generation_argument_read_failed");
const generation = tool_result();

// This is the frozen wait under test. The provider may observe the borrowed
// token just before the engine does and return its typed cancellation reply.
// In that race, remain in guest code so the same token still owns the public
// Script result instead of misclassifying the expected cancellation as throw.
const waited = acu.argv([
  "--target", "current", "--grant", "observe",
  "job-wait", job_id, generation,
  "--timeout-ms", "60000"
]);
require(waited !== null && typeof waited === "object", "job_wait_reply_shape");
require(waited.ok !== true, "job_wait_returned_before_supervisor_cancel");
require(waited.error !== null && waited.error.code === "cancelled",
  "job_wait_unexpected_failure");
print(JSON.stringify({
  schema_version: 1,
  kind: "wait-cancelled",
  code: waited.error.code
}));
