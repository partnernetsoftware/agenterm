// Stage the public Windows archive and versioned SBOM from exact qualified
// candidate bytes. This task never builds, tags, pushes, or publishes.
//
// Args: REPO RECEIPT_PATH OUTPUT_DIRECTORY
// Runs under `--profile tool`.
import * as rh from "lib/rh_compat";
import * as package_qualified from "lib/package_qualified";

if (arg_count() !== 3) { throw "expected: REPO RECEIPT_PATH OUTPUT_DIRECTORY"; }
const args = [];
for (let i = 0; i < arg_count(); i = i + 1) {
  if (arg(i) !== 0) { throw "arg: " + tool_result(); }
  args.push(tool_result());
}
const repo = rh.absolute(args[0]);
const output = rh.join(repo, args[2]);
rh.create_dir_all(output);
const run_root = rh.join(repo, "target/qualification/package-release");
package_qualified.build_release_package(repo, args[1], "target/qualification/package-release");
const sidecar_path = run_root + "/.latest-package-run";
const qualified_run = rh.read_text(sidecar_path).trim();
const result_path = qualified_run + "/release-result.json";
const result = rh.parse_file(result_path);
if (result.dry_run) { throw "release_package_marked_dry_run"; }
const archive_name = "" + result.archive;
const archive_source = qualified_run + "/" + archive_name;
const archive_destination = output + "/" + archive_name;
rh.copy(archive_source, archive_destination);
const archive_copy_hash = rh.sha256_file(archive_destination);
const archive_expected_hash = "" + result.archive_sha256;
if (archive_copy_hash !== archive_expected_hash) { throw "release_package_copy_hash"; }

const metadata_path = repo + "/dist/agenterm.json";
const metadata = rh.parse_file(metadata_path);
const receipt = rh.parse_file(args[1]);
const sbom_source = repo + "/dist/agenterm-sbom.spdx.json";
const version = "" + metadata.version;
const sbom_name = "agenterm-" + version + "-sbom.spdx.json";
const sbom_destination = output + "/" + sbom_name;
rh.copy(sbom_source, sbom_destination);
const sbom_copy_hash = rh.sha256_file(sbom_destination);
const sbom_source_hash = rh.sha256_file(sbom_source);
if (sbom_copy_hash !== sbom_source_hash) { throw "release_sbom_copy_hash"; }

const archive_hash = rh.sha256_file(archive_destination);
let build_log = "";
if (env_has("GITHUB_SERVER_URL") === 1
    && env_has("GITHUB_REPOSITORY") === 1
    && env_has("GITHUB_RUN_ID") === 1) {
  build_log = rh.env_or("GITHUB_SERVER_URL", "") + "/"
    + rh.env_or("GITHUB_REPOSITORY", "") + "/actions/runs/"
    + rh.env_or("GITHUB_RUN_ID", "");
}
const provenance = {
  schema_version: 1,
  product: "AgenTerm",
  version: version,
  os: "windows",
  arch: "x86_64",
  channel: "release",
  signed: false,
  notarized: false,
  artifact: archive_name,
  sha256: archive_hash,
  payload_uncompressed_bytes: result.payload_uncompressed_bytes,
  archive_bytes: result.archive_bytes,
  source_commit: receipt.provenance.git_head,
  source_tag: "v" + version,
  artifact_manifest_sha256: receipt.provenance.artifact_manifest_sha256,
  cargo_lock_sha256: receipt.provenance.cargo_lock_sha256,
  sbom_sha256: sbom_copy_hash,
  build_log: build_log
};
const provenance_destination = archive_destination + ".provenance.json";
const checksum_destination = archive_destination + ".sha256";
rh.atomic_write(provenance_destination, rh.stringify_pretty(provenance) + "\n");
rh.atomic_write(checksum_destination, archive_hash + "  " + archive_name + "\n");
print(
  "RELEASE ASSETS " + archive_destination + " " + sbom_destination + " "
    + provenance_destination + " " + checksum_destination
);
return;
