// CEO#7: GTK entry selection by --name, proved by independent get-selection.
// P0: plant SEED with send-text, select one interior region via select --start/--end
// (AT-SPI Text.SetSelection), then get-selection must return that scalar slice.
// Also proves semantic ctrl+a select-all via send-keys. AT-SPI --name only.
// No --coords, screenshot, or clipboard proof.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-gtk-entry-select-region",
  "cu.linux-gtk-entry-select-all",
  "cu.linux-gtk-entry-get-selection",
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function run_cu(run_directory, executable, grant, arguments) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_gtk_entry_selection_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_entry_selection_empty");
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_linux_gtk_entry_selection_reply:" + JSON.stringify(document));
  return document;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const context = harness.new_context(repo, "cu-linux-gtk-entry-selection");
const run_directory = rh.join(repo, "target/cu-linux-gtk-entry-selection-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_gtk_entry_selection_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";

try {
  print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_gtk_entry_selection_window_wait");
  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_gtk_entry_selection_window_identity");
  const handle = "" + at(row, "handle");

  print("STEP focus moves AT-SPI focus to the named GTK entry");
  run_cu(run_directory, executable, "observe,actuate", [
    "focus", "--window", handle, "--name", "Fixture Entry",
  ]);
  const focused = run_cu(run_directory, executable, "observe", [
    "focused", "--window", handle,
  ]);
  ensure(
    text_at(focused, "data.node.name") === "Fixture Entry",
    "cu_linux_gtk_entry_selection_focused:" + JSON.stringify(focused.data)
  );

  const region = "REGION";
  const prefix = "pre-";
  const suffix = "-post-" + context.run_id;
  const seed = prefix + region + suffix;
  const region_start = prefix.length;
  const region_end = region_start + region.length;
  print("STEP send-text --name plants SEED through AT-SPI EditableText/Text");
  const sent = run_cu(run_directory, executable, "observe,actuate", [
    "send-text", "--window", handle, "--name", "Fixture Entry", "--", seed,
  ]);
  ensure(
    text_at(sent, "data.typed") === seed
      && text_at(sent, "data.addressing") === "accessibility-tree",
    "cu_linux_gtk_entry_selection_send:" + JSON.stringify(sent.data)
  );

  print("STEP independent get-selection before select is empty or not the REGION slice");
  const before = run_cu(run_directory, executable, "observe", [
    "get-selection", "--window", handle, "--name", "Fixture Entry",
  ]);
  ensure(
    text_at(before, "data.via") === "get-selection",
    "cu_linux_gtk_entry_selection_before_via:" + JSON.stringify(before.data)
  );
  const before_text = text_at(before, "data.text");
  ensure(
    before_text !== region,
    "cu_linux_gtk_entry_selection_before_not_region:" + JSON.stringify(before.data)
  );

  print("STEP select --start --end --name performs one-shot AT-SPI Text.SetSelection on the interior slice");
  const selected = run_cu(run_directory, executable, "observe,actuate", [
    "select", "--window", handle, "--name", "Fixture Entry",
    "--start", "" + region_start, "--end", "" + region_end,
  ]);
  ensure(
    text_at(selected, "data.addressing") === "accessibility-tree"
      && text_at(selected, "data.via") === "set-selection"
      && int_at(selected, "data.start") === region_start
      && int_at(selected, "data.end") === region_end,
    "cu_linux_gtk_entry_selection_select_region:" + JSON.stringify(selected.data)
  );

  print("STEP independent get-selection --name must return the REGION scalar slice");
  const region_selection = run_cu(run_directory, executable, "observe", [
    "get-selection", "--window", handle, "--name", "Fixture Entry",
  ]);
  ensure(
    text_at(region_selection, "data.via") === "get-selection"
      && int_at(region_selection, "data.n") === 1
      && int_at(region_selection, "data.start") === region_start
      && int_at(region_selection, "data.end") === region_end
      && text_at(region_selection, "data.text") === region,
    "cu_linux_gtk_entry_selection_region_readback:" + JSON.stringify({
      region: region,
      selection: region_selection.data,
    })
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-select-region");

  print("STEP send-keys ctrl+a --name performs semantic select-all through AT-SPI Text.SetSelection");
  const keyed = run_cu(run_directory, executable, "observe,actuate", [
    "send-keys", "--window", handle, "--name", "Fixture Entry", "--", "ctrl+a",
  ]);
  ensure(
    text_at(keyed, "data.addressing") === "accessibility-tree"
      && text_at(keyed, "data.via") === "set-selection",
    "cu_linux_gtk_entry_selection_ctrl_a:" + JSON.stringify(keyed.data)
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-select-all");

  print("STEP independent get-selection --name must return the full SEED slice");
  const selection = run_cu(run_directory, executable, "observe", [
    "get-selection", "--window", handle, "--name", "Fixture Entry",
  ]);
  const seed_len = seed.length;
  ensure(
    text_at(selection, "data.via") === "get-selection"
      && int_at(selection, "data.n") === 1
      && int_at(selection, "data.start") === 0
      && int_at(selection, "data.end") === seed_len
      && text_at(selection, "data.text") === seed,
    "cu_linux_gtk_entry_selection_readback:" + JSON.stringify({
      seed: seed,
      selection: selection.data,
    })
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-get-selection");

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_gtk_entry_selection_failed");
print("PASS: CEO#7 GTK entry select region + select-all by --name with independent get-selection read-back");
