// CEO#7: GTK entry selection by --name, proved by independent get-selection
// and get-text read-back. Plant SEED with send-text, select one interior
// region via select --start/--end (AT-SPI Text.SetSelection), then
// get-selection must return that scalar slice. Also proves semantic ctrl+a
// select-all via send-keys. Typed get-selection/select usage and host-limit
// paths must hold when --window/--name are missing or the AT-SPI bus is
// unavailable; typed get-extents --name usage AND host-limit courts must both
// hold before process-state, desktop-state, and the native actuate/read-back
// court (no if/else gating those courts on atspi_available). Typed
// get-selection/select must reject --coords/--bogus without --name as usage
// (usage_rejects_unexpected) with command=usage, or honest non-usage typed
// failure (never fake command=usage); named --coords/--bogus must reject as
// command=usage or stay accessibility-tree --name (never coordinate
// addressing). get-extents --coords/--bogus must reject as command=usage.
// process-state and desktop-state fixture binding courts must hold before
// actuate/read-back. Miss paths must not mutate the entry (independent
// get-text read-back). AT-SPI --name only; no --coords, screenshot, or
// clipboard proof.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-gtk-entry-select-region",
  "cu.linux-gtk-entry-select-all",
  "cu.linux-gtk-entry-get-selection",
];

const ENTRY_NAME = "Fixture Entry";
const MISSING_NODE = "No Such Entry";
const UNAVAILABLE_NODE = "Fixture Check";
const FIXTURE_SEED = "seed";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invalid_atspi_env(executable) {
  return {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
}

function assert_host_limit_code(code, label, reply) {
  ensure(
    text_at(reply, "command") !== "usage",
    label + "_fake_usage:" + JSON.stringify(reply)
  );
  const allowed = code === "a11y_backend_failed"
    || code === "unsupported"
    || code === "bad_handle"
    || code === "a11y_node_not_found"
    || code === "a11y_selection_unavailable";
  ensure(allowed, label + ":" + code + ":" + JSON.stringify(reply.error));
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_entry_selection_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(rh.output_success(document), "cu_linux_gtk_entry_selection_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_entry_selection_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_entry_text(run_directory, executable, handle, expected, label) {
  const got = run_cu(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", ENTRY_NAME,
  ]);
  const readback = text_at(got, "data.text");
  ensure(
    readback === expected && text_at(got, "data.via") === "gettext",
    "cu_linux_gtk_entry_selection_get_text_" + label + ":" + JSON.stringify({
      expected: expected,
      readback: readback,
    })
  );
  return got;
}

function assert_selection_usage_limit(run_directory, executable) {
  const missing_window = run_cu_reply(run_directory, executable, "observe", [
    "get-selection", "--name", ENTRY_NAME,
  ]);
  ensure(!rh.output_success(missing_window), "cu_linux_gtk_entry_selection_usage_ok:" + JSON.stringify(missing_window));
  ensure(
    text_at(missing_window, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_selection_usage_code:" + JSON.stringify(missing_window.error)
  );
  ensure(
    text_at(missing_window, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_entry_selection_usage_message:" + JSON.stringify(missing_window.error)
  );

  const missing_name = run_cu_reply(run_directory, executable, "observe", [
    "get-selection", "--window", "1",
  ]);
  ensure(!rh.output_success(missing_name), "cu_linux_gtk_entry_selection_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_gtk_entry_selection_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_gtk_entry_selection_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_selection_name_message:" + JSON.stringify(missing_name.error)
  );

  const zero_handle = run_cu_reply(run_directory, executable, "observe", [
    "get-selection", "--window", "0", "--name", ENTRY_NAME,
  ]);
  ensure(!rh.output_success(zero_handle), "cu_linux_gtk_entry_selection_zero_handle_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_selection_zero_handle_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_entry_selection_zero_handle_message:" + JSON.stringify(zero_handle.error)
  );

  const select_missing = run_cu_reply(run_directory, executable, "observe,actuate", [
    "select", "--window", "1", "--start", "0", "--end", "1",
  ]);
  ensure(!rh.output_success(select_missing), "cu_linux_gtk_entry_selection_select_usage_ok:" + JSON.stringify(select_missing));
  ensure(
    text_at(select_missing, "error.code") === "usage",
    "cu_linux_gtk_entry_selection_select_usage_code:" + JSON.stringify(select_missing.error)
  );
  ensure(
    text_at(select_missing, "command") === "usage",
    "cu_linux_gtk_entry_selection_select_usage_command:" + JSON.stringify(select_missing)
  );
  ensure(
    text_at(select_missing, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_selection_select_usage_message:" + JSON.stringify(select_missing.error)
  );

  const bad_range = run_cu_reply(run_directory, executable, "observe,actuate", [
    "select", "--window", "1", "--name", ENTRY_NAME, "--start", "2", "--end", "1",
  ]);
  ensure(!rh.output_success(bad_range), "cu_linux_gtk_entry_selection_bad_range_ok:" + JSON.stringify(bad_range));
  ensure(
    text_at(bad_range, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_selection_bad_range_code:" + JSON.stringify(bad_range.error)
  );
  ensure(
    text_at(bad_range, "error.message").indexOf("--start") >= 0,
    "cu_linux_gtk_entry_selection_bad_range_message:" + JSON.stringify(bad_range.error)
  );

  const get_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-selection", "--window", "1", "--coords", "10,10",
  ]);
  ensure(!rh.output_success(get_coords), "cu_linux_gtk_entry_selection_coords_ok:" + JSON.stringify(get_coords));
  ensure(
    text_at(get_coords, "error.code") === "usage",
    "cu_linux_gtk_entry_selection_coords_code:" + JSON.stringify(get_coords.error)
  );
  ensure(
    text_at(get_coords, "command") === "usage",
    "cu_linux_gtk_entry_selection_coords_command:" + JSON.stringify(get_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(get_coords, "error.message"), "--coords")
      || text_at(get_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_selection_coords_message:" + JSON.stringify(get_coords.error)
  );

  const get_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-selection", "--window", "1", "--bogus",
  ]);
  ensure(!rh.output_success(get_bogus), "cu_linux_gtk_entry_selection_bogus_ok:" + JSON.stringify(get_bogus));
  ensure(
    text_at(get_bogus, "error.code") === "usage",
    "cu_linux_gtk_entry_selection_bogus_code:" + JSON.stringify(get_bogus.error)
  );
  ensure(
    text_at(get_bogus, "command") === "usage",
    "cu_linux_gtk_entry_selection_bogus_command:" + JSON.stringify(get_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(get_bogus, "error.message"), "--bogus")
      || text_at(get_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_selection_bogus_message:" + JSON.stringify(get_bogus.error)
  );

  const select_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "select", "--window", "1", "--start", "0", "--end", "1", "--coords", "10,10",
  ]);
  ensure(!rh.output_success(select_coords), "cu_linux_gtk_entry_selection_select_coords_ok:" + JSON.stringify(select_coords));
  ensure(
    text_at(select_coords, "error.code") === "usage",
    "cu_linux_gtk_entry_selection_select_coords_code:" + JSON.stringify(select_coords.error)
  );
  ensure(
    text_at(select_coords, "command") === "usage",
    "cu_linux_gtk_entry_selection_select_coords_command:" + JSON.stringify(select_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(select_coords, "error.message"), "--coords")
      || text_at(select_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_selection_select_coords_message:" + JSON.stringify(select_coords.error)
  );

  const select_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "select", "--window", "1", "--start", "0", "--end", "1", "--bogus",
  ]);
  ensure(!rh.output_success(select_bogus), "cu_linux_gtk_entry_selection_select_bogus_ok:" + JSON.stringify(select_bogus));
  ensure(
    text_at(select_bogus, "error.code") === "usage",
    "cu_linux_gtk_entry_selection_select_bogus_code:" + JSON.stringify(select_bogus.error)
  );
  ensure(
    text_at(select_bogus, "command") === "usage",
    "cu_linux_gtk_entry_selection_select_bogus_command:" + JSON.stringify(select_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(select_bogus, "error.message"), "--bogus")
      || text_at(select_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_selection_select_bogus_message:" + JSON.stringify(select_bogus.error)
  );
}

function assert_named_stay_or_misuse(reply, label, via, token) {
  if (!rh.output_success(reply)) {
    ensure(
      text_at(reply, "error.code") === "usage",
      "cu_linux_gtk_entry_selection_" + label + "_code:" + JSON.stringify(reply.error)
    );
    ensure(
      text_at(reply, "command") === "usage",
      "cu_linux_gtk_entry_selection_" + label + "_command:" + JSON.stringify(reply)
    );
    ensure(
      usage_rejects_unexpected(text_at(reply, "error.message"), token)
        || text_at(reply, "error.message").indexOf("--name") >= 0,
      "cu_linux_gtk_entry_selection_" + label + "_message:" + JSON.stringify(reply.error)
    );
    return false;
  }
  ensure(
    text_at(reply, "data.addressing") === "accessibility-tree"
      && text_at(reply, "data.via") === via,
    "cu_linux_gtk_entry_selection_" + label + "_degraded:" + JSON.stringify(reply.data)
  );
  return true;
}

function assert_selection_reject_coords_or_stay_named(
  run_directory, executable, handle, start, end, expected_text, label
) {
  const get_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-selection", "--window", handle, "--name", ENTRY_NAME, "--coords", "10,10",
  ]);
  if (assert_named_stay_or_misuse(get_coords, "get_coords_" + label, "get-selection", "--coords")) {
    ensure(
      text_at(get_coords, "data.text") === expected_text
        && int_at(get_coords, "data.start") === start
        && int_at(get_coords, "data.end") === end,
      "cu_linux_gtk_entry_selection_get_coords_slice_" + label + ":" + JSON.stringify(get_coords.data)
    );
  }

  const get_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-selection", "--window", handle, "--name", ENTRY_NAME, "--bogus",
  ]);
  if (assert_named_stay_or_misuse(get_bogus, "get_bogus_" + label, "get-selection", "--bogus")) {
    ensure(
      text_at(get_bogus, "data.text") === expected_text
        && int_at(get_bogus, "data.start") === start
        && int_at(get_bogus, "data.end") === end,
      "cu_linux_gtk_entry_selection_get_bogus_slice_" + label + ":" + JSON.stringify(get_bogus.data)
    );
  }

  const select_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "select", "--window", handle, "--name", ENTRY_NAME,
    "--start", "" + start, "--end", "" + end, "--coords", "10,10",
  ]);
  if (assert_named_stay_or_misuse(select_coords, "select_coords_" + label, "set-selection", "--coords")) {
    ensure(
      int_at(select_coords, "data.start") === start
        && int_at(select_coords, "data.end") === end,
      "cu_linux_gtk_entry_selection_select_coords_range_" + label + ":" + JSON.stringify(select_coords.data)
    );
  }

  const select_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "select", "--window", handle, "--name", ENTRY_NAME,
    "--start", "" + start, "--end", "" + end, "--bogus",
  ]);
  if (assert_named_stay_or_misuse(select_bogus, "select_bogus_" + label, "set-selection", "--bogus")) {
    ensure(
      int_at(select_bogus, "data.start") === start
        && int_at(select_bogus, "data.end") === end,
      "cu_linux_gtk_entry_selection_select_bogus_range_" + label + ":" + JSON.stringify(select_bogus.data)
    );
  }

  const readback = run_cu(run_directory, executable, "observe", [
    "get-selection", "--window", handle, "--name", ENTRY_NAME,
  ]);
  ensure(
    text_at(readback, "data.via") === "get-selection"
      && text_at(readback, "data.text") === expected_text
      && int_at(readback, "data.start") === start
      && int_at(readback, "data.end") === end,
    "cu_linux_gtk_entry_selection_coords_bogus_readback_" + label + ":" + JSON.stringify(readback.data)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", ENTRY_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle), "cu_linux_gtk_entry_selection_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_selection_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_gtk_entry_selection_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name), "cu_linux_gtk_entry_selection_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_gtk_entry_selection_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_gtk_entry_selection_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_selection_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords), "cu_linux_gtk_entry_selection_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_gtk_entry_selection_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_gtk_entry_selection_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_selection_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus), "cu_linux_gtk_entry_selection_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_gtk_entry_selection_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_gtk_entry_selection_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_selection_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", ENTRY_NAME,
  ], invalid_atspi_env(executable));
  ensure(!rh.output_success(reply), "cu_linux_gtk_entry_selection_extents_unavailable_ok:" + JSON.stringify(reply));
  assert_host_limit_code(
    text_at(reply, "error.code"),
    "cu_linux_gtk_entry_selection_extents_unavailable_code",
    reply
  );
}

function assert_selection_host_limit_when_atspi_absent(run_directory, executable) {
  const env = invalid_atspi_env(executable);
  const get_reply = run_cu_reply(run_directory, executable, "observe", [
    "get-selection", "--window", "1", "--name", ENTRY_NAME,
  ], env);
  ensure(!rh.output_success(get_reply), "cu_linux_gtk_entry_selection_unavailable_ok:" + JSON.stringify(get_reply));
  assert_host_limit_code(
    text_at(get_reply, "error.code"),
    "cu_linux_gtk_entry_selection_unavailable_code",
    get_reply
  );

  const select_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "select", "--window", "1", "--name", ENTRY_NAME, "--start", "0", "--end", "1",
  ], env);
  ensure(!rh.output_success(select_reply), "cu_linux_gtk_entry_selection_select_unavailable_ok:" + JSON.stringify(select_reply));
  assert_host_limit_code(
    text_at(select_reply, "error.code"),
    "cu_linux_gtk_entry_selection_select_unavailable_code",
    select_reply
  );
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_gtk_entry_selection_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_gtk_entry_selection_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_gtk_entry_selection_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_gtk_entry_selection_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_gtk_entry_selection_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function assert_selection_missing_node(run_directory, executable, handle, label) {
  const get_reply = run_cu_reply(run_directory, executable, "observe", [
    "get-selection", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!rh.output_success(get_reply), "cu_linux_gtk_entry_selection_missing_ok_" + label);
  ensure(
    text_at(get_reply, "error.code") === "a11y_node_not_found",
    "cu_linux_gtk_entry_selection_missing_code_" + label + ":" + JSON.stringify(get_reply.error)
  );

  const select_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "select", "--window", handle, "--name", MISSING_NODE, "--start", "0", "--end", "1",
  ]);
  ensure(!rh.output_success(select_reply), "cu_linux_gtk_entry_selection_select_missing_ok_" + label);
  ensure(
    text_at(select_reply, "error.code") === "a11y_node_not_found",
    "cu_linux_gtk_entry_selection_select_missing_code_" + label + ":" + JSON.stringify(select_reply.error)
  );
}

function selection_unavailable_code_ok(code) {
  return code === "a11y_selection_unavailable" || code === "a11y_backend_failed";
}

function assert_selection_unavailable(run_directory, executable, handle, node_name, label) {
  const get_reply = run_cu_reply(run_directory, executable, "observe", [
    "get-selection", "--window", handle, "--name", node_name,
  ]);
  ensure(!rh.output_success(get_reply), "cu_linux_gtk_entry_selection_unavailable_ok_" + label);
  const get_code = text_at(get_reply, "error.code");
  ensure(
    selection_unavailable_code_ok(get_code),
    "cu_linux_gtk_entry_selection_unavailable_code_" + label + ":" + JSON.stringify(get_reply.error)
  );
  if (get_code === "a11y_backend_failed") {
    const message = text_at(get_reply, "error.message").toLowerCase();
    ensure(
      message.indexOf("selection") >= 0 || message.indexOf("gettext") >= 0
        || message.indexOf("text") >= 0,
      "cu_linux_gtk_entry_selection_unavailable_message_" + label + ":" + JSON.stringify(get_reply.error)
    );
  }

  const select_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "select", "--window", handle, "--name", node_name, "--start", "0", "--end", "1",
  ]);
  ensure(!rh.output_success(select_reply), "cu_linux_gtk_entry_selection_select_unavailable_ok_" + label);
  const select_code = text_at(select_reply, "error.code");
  ensure(
    selection_unavailable_code_ok(select_code),
    "cu_linux_gtk_entry_selection_select_unavailable_code_" + label + ":" + JSON.stringify(select_reply.error)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_gtk_entry_selection_executable_missing");
const context = harness.new_context(repo, "cu-linux-gtk-entry-selection");
const run_directory = rh.join(repo, "target/cu-linux-gtk-entry-selection-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_gtk_entry_selection_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP get-selection / select typed-fail usage when --window or --name is missing, or --coords/--bogus is present without --name (usage_rejects_unexpected + command=usage)");
  assert_selection_usage_limit(run_directory, executable);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (command=usage) before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP get-selection / select typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
  assert_selection_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held");
    succeeded = 1;
  } else {
    print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_gtk_entry_selection_window_wait");
    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_gtk_entry_selection_window_identity");
    const handle = "" + at(row, "handle");

    print("STEP process-state binds the owned fixture pid before get-selection/select actuate/read-back court");
    assert_fixture_process_state(run_directory, executable, fixture_pid);

    print("STEP desktop-state window row agrees with inventory before get-selection/select actuate/read-back court");
    assert_fixture_desktop_state(
      run_directory, executable, fixture_pid, fixture_title, handle, row
    );

    print("STEP get-extents --name locates the GTK entry before get-selection/select actuate/read-back court");
    const entry_extents = run_cu(run_directory, executable, "observe", [
      "get-extents", "--window", handle, "--name", ENTRY_NAME,
    ]);
    ensure(
      text_at(entry_extents, "data.matched.name") === ENTRY_NAME
        && int_at(entry_extents, "data.extents.width") > 0
        && int_at(entry_extents, "data.extents.height") > 0,
      "cu_linux_gtk_entry_selection_extents_before_actuate:" + JSON.stringify(entry_extents.data)
    );

    print("STEP get-selection / select typed-fail a11y_node_not_found when the named entry is missing");
    assert_selection_missing_node(run_directory, executable, handle, "before_focus");
    print("STEP independent get-text proves the entry stayed at the fixture seed after the miss");
    assert_entry_text(run_directory, executable, handle, FIXTURE_SEED, "after_missing");

    print("STEP get-selection / select typed-fail a11y_selection_unavailable when the target has no Text selection interface");
    assert_selection_unavailable(run_directory, executable, handle, UNAVAILABLE_NODE, "check_without_text");
    print("STEP independent get-text proves the unavailable select did not mutate the entry");
    assert_entry_text(run_directory, executable, handle, FIXTURE_SEED, "after_unavailable");

    print("STEP focus moves AT-SPI focus to the named GTK entry");
    run_cu(run_directory, executable, "observe,actuate", [
      "focus", "--window", handle, "--name", ENTRY_NAME,
    ]);
    const focused = run_cu(run_directory, executable, "observe", [
      "focused", "--window", handle,
    ]);
    ensure(
      text_at(focused, "data.node.name") === ENTRY_NAME,
      "cu_linux_gtk_entry_selection_focused:" + JSON.stringify(focused.data)
    );

    const region = "REGION";
    const prefix = "pre-";
    const suffix = "-post-" + context.run_id;
    const seed = prefix + region + suffix;
    const region_start = prefix.length;
    const region_end = region_start + region.length;
    print("STEP send-text --name plants SEED through AT-SPI EditableText/Text");
    const sent = run_cu(run_directory, executable, "observe,actuate", [
      "send-text", "--window", handle, "--name", ENTRY_NAME, "--", seed,
    ]);
    ensure(
      text_at(sent, "data.typed") === seed
        && text_at(sent, "data.addressing") === "accessibility-tree",
      "cu_linux_gtk_entry_selection_send:" + JSON.stringify(sent.data)
    );
    print("STEP independent get-text --name reads SEED back through AT-SPI Text.GetText");
    assert_entry_text(run_directory, executable, handle, seed, "after_send");

    print("STEP independent get-selection before select is empty or not the REGION slice");
    const before = run_cu(run_directory, executable, "observe", [
      "get-selection", "--window", handle, "--name", ENTRY_NAME,
    ]);
    ensure(
      text_at(before, "data.via") === "get-selection",
      "cu_linux_gtk_entry_selection_before_via:" + JSON.stringify(before.data)
    );
    const before_text = text_at(before, "data.text");
    ensure(
      before_text !== region,
      "cu_linux_gtk_entry_selection_before_not_region:" + JSON.stringify(before.data)
    );

    print("STEP select --start --end --name performs one-shot AT-SPI Text.SetSelection on the interior slice");
    const selected = run_cu(run_directory, executable, "observe,actuate", [
      "select", "--window", handle, "--name", ENTRY_NAME,
      "--start", "" + region_start, "--end", "" + region_end,
    ]);
    ensure(
      text_at(selected, "data.addressing") === "accessibility-tree"
        && text_at(selected, "data.via") === "set-selection"
        && int_at(selected, "data.start") === region_start
        && int_at(selected, "data.end") === region_end,
      "cu_linux_gtk_entry_selection_select_region:" + JSON.stringify(selected.data)
    );

    print("STEP independent get-selection --name must return the REGION scalar slice");
    const region_selection = run_cu(run_directory, executable, "observe", [
      "get-selection", "--window", handle, "--name", ENTRY_NAME,
    ]);
    ensure(
      text_at(region_selection, "data.via") === "get-selection"
        && int_at(region_selection, "data.n") === 1
        && int_at(region_selection, "data.start") === region_start
        && int_at(region_selection, "data.end") === region_end
        && text_at(region_selection, "data.text") === region,
      "cu_linux_gtk_entry_selection_region_readback:" + JSON.stringify({
        region: region,
        selection: region_selection.data,
      })
    );
    print("STEP independent get-text --name still reads the full SEED after interior select");
    assert_entry_text(run_directory, executable, handle, seed, "after_region_select");
    print("STEP get-selection/select --name with --coords/--bogus rejects or stays accessibility-tree on the REGION slice");
    assert_selection_reject_coords_or_stay_named(
      run_directory, executable, handle, region_start, region_end, region, "after_region"
    );
    assert_entry_text(run_directory, executable, handle, seed, "after_region_coords_bogus");
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-select-region");

    print("STEP send-keys ctrl+a --name performs semantic select-all through AT-SPI Text.SetSelection");
    const keyed = run_cu(run_directory, executable, "observe,actuate", [
      "send-keys", "--window", handle, "--name", ENTRY_NAME, "--", "ctrl+a",
    ]);
    ensure(
      text_at(keyed, "data.addressing") === "accessibility-tree"
        && text_at(keyed, "data.via") === "set-selection",
      "cu_linux_gtk_entry_selection_ctrl_a:" + JSON.stringify(keyed.data)
    );
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-select-all");

    print("STEP independent get-selection --name must return the full SEED slice");
    const selection = run_cu(run_directory, executable, "observe", [
      "get-selection", "--window", handle, "--name", ENTRY_NAME,
    ]);
    const seed_len = seed.length;
    ensure(
      text_at(selection, "data.via") === "get-selection"
        && int_at(selection, "data.n") === 1
        && int_at(selection, "data.start") === 0
        && int_at(selection, "data.end") === seed_len
        && text_at(selection, "data.text") === seed,
      "cu_linux_gtk_entry_selection_readback:" + JSON.stringify({
        seed: seed,
        selection: selection.data,
      })
    );
    print("STEP independent get-text --name still reads the full SEED after select-all");
    assert_entry_text(run_directory, executable, handle, seed, "after_select_all");
    print("STEP get-selection/select --name with --coords/--bogus rejects or stays accessibility-tree on the full SEED slice");
    assert_selection_reject_coords_or_stay_named(
      run_directory, executable, handle, 0, seed_len, seed, "after_select_all"
    );
    assert_entry_text(run_directory, executable, handle, seed, "after_select_all_coords_bogus");
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-get-selection");

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_gtk_entry_selection_failed");
if (atspi_available) {
  print("PASS: CEO#7 GTK entry select region + select-all by --name with independent get-selection/get-text read-back, typed get-selection/select --coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), and process-state/desktop-state courts before actuate (AT-SPI --name, no --coords)");
} else {
  print("PASS: CEO#7 GTK entry selection typed-fails with typed get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty, get-selection/select host-limit (never fake command=usage), when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
}
