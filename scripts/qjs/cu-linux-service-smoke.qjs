// CEO: Linux service list/system-status honesty with independent systemd D-Bus
// manager read-back. Acceptance is smoke read-back only: CU service
// list|status|system-list|system-status must agree with facts derived outside
// agenterm-cu from an independently reachable org.freedesktop.systemd1 manager,
// or return typed service_unsupported host-limit with linux systemd alternatives
// (never fake running units). A missing system bus socket or unreachable systemd
// manager is a typed skip/limit, not a positive-path pass; systemctl inventory
// alone must not promote a scope. Typed service usage must reject AT-SPI --name
// and other unexpected arguments; typed get-extents --name usage/host-limit
// paths must hold before any list/system-status path. Observe-only; no lifecycle
// mutation. AT-SPI/--name only; no --coords.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.linux-service-readback"];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function cu_env() {
  const env = { AGENTERM_NO_ACTIVATE: "1" };
  for (const key of ["DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS"]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  return env;
}

function invoke(run_directory, executable, args, expect_success) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe", "service",
  ].concat(args), {
    cwd: run_directory,
    env: cu_env(),
    timeout_ms: 30000,
  });
  ensure(output.success === expect_success, "cu_linux_service_exit:" + output.exit_code + ":" + output.stdout);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_service_empty");
  const reply = JSON.parse(trimmed);
  ensure(reply.ok === expect_success, "cu_linux_service_reply:" + trimmed);
  return reply;
}

function first_line(text) {
  const value = ("" + text).trim();
  if (value === "") { return ""; }
  const lines = value.split("\n");
  return lines.length > 0 ? lines[0] : "";
}

function probe_script() {
  return [
    "import json, os, shutil, subprocess, sys",
    "def map_state(active):",
    "    return {",
    "        'active': 'running', 'reloading': 'running',",
    "        'activating': 'activating', 'deactivating': 'deactivating',",
    "        'inactive': 'loaded_inactive', 'failed': 'failed',",
    "    }.get(active, 'unknown')",
    "def first_err(text):",
    "    value = str(text or '').strip()",
    "    if value == '':",
    "        return ''",
    "    return value.splitlines()[0][:240]",
    "def which_bin(*names):",
    "    for name in names:",
    "        found = shutil.which(name)",
    "        if found:",
    "            return found",
    "        if os.path.isfile(name):",
    "            return name",
    "    return None",
    "def systemctl_bin():",
    "    return which_bin('systemctl', '/usr/bin/systemctl', '/bin/systemctl')",
    "def dbus_send_bin():",
    "    return which_bin('dbus-send', '/usr/bin/dbus-send')",
    "def has_dbus_python():",
    "    try:",
    "        import dbus  # noqa: F401",
    "        return True",
    "    except ImportError:",
    "        return False",
    "def has_gio():",
    "    try:",
    "        from gi.repository import Gio  # noqa: F401",
    "        return True",
    "    except Exception:",
    "        return False",
    "def system_bus_socket_path():",
    "    addr = os.environ.get('DBUS_SYSTEM_BUS_ADDRESS', '')",
    "    if addr.startswith('unix:path='):",
    "        return addr[len('unix:path='):].split(',', 1)[0]",
    "    for candidate in ('/run/dbus/system_bus_socket', '/var/run/dbus/system_bus_socket'):",
    "        if os.path.exists(candidate):",
    "            return candidate",
    "    return '/run/dbus/system_bus_socket'",
    "def rows_to_services(rows):",
    "    services = []",
    "    for row in rows:",
    "        name = str(row[0])",
    "        if not name.endswith('.service'):",
    "            continue",
    "        services.append({",
    "            'name': name,",
    "            'state': map_state(str(row[3])),",
    "            'substate': str(row[4]),",
    "            'description': str(row[1]),",
    "        })",
    "    return services",
    "def gio_list(scope):",
    "    try:",
    "        from gi.repository import Gio",
    "    except Exception as error:",
    "        return None, 'gio-missing:' + first_err(error)",
    "    bus_type = Gio.BusType.SESSION if scope == 'user' else Gio.BusType.SYSTEM",
    "    try:",
    "        bus = Gio.bus_get_sync(bus_type, None)",
    "    except Exception as error:",
    "        return None, 'gio-connect:' + first_err(error)",
    "    try:",
    "        proxy = Gio.DBusProxy.new_sync(",
    "            bus, Gio.DBusProxyFlags.NONE, None,",
    "            'org.freedesktop.systemd1', '/org/freedesktop/systemd1',",
    "            'org.freedesktop.systemd1.Manager', None)",
    "        variant = proxy.call_sync('ListUnits', None, Gio.DBusCallFlags.NONE, 8000, None)",
    "        unpacked = variant.unpack()",
    "        rows = unpacked[0] if unpacked else []",
    "        return rows_to_services(rows), ''",
    "    except Exception as error:",
    "        return None, 'gio-listunits:' + first_err(error)",
    "def dbus_python_list(scope):",
    "    try:",
    "        import dbus",
    "    except ImportError as error:",
    "        return None, 'dbus-python-missing:' + first_err(error)",
    "    try:",
    "        bus = dbus.SessionBus() if scope == 'user' else dbus.SystemBus()",
    "        manager = bus.get_object('org.freedesktop.systemd1', '/org/freedesktop/systemd1')",
    "        iface = dbus.Interface(manager, 'org.freedesktop.systemd1.Manager')",
    "        return rows_to_services(iface.ListUnits()), ''",
    "    except Exception as error:",
    "        return None, 'dbus-python-listunits:' + first_err(error)",
    "def dbus_send_call(scope, dest, path, method):",
    "    binary = dbus_send_bin()",
    "    if binary is None:",
    "        return False, 'dbus-send-missing'",
    "    cmd = [binary, '--session' if scope == 'user' else '--system', '--print-reply',",
    "           '--dest=' + dest, path, method]",
    "    out = subprocess.run(cmd, capture_output=True, text=True)",
    "    if out.returncode == 0:",
    "        return True, ''",
    "    return False, first_err(out.stderr or out.stdout or 'dbus-send-failed')",
    "def systemctl_list(scope):",
    "    sc = systemctl_bin()",
    "    if sc is None:",
    "        return None",
    "    cmd = [sc]",
    "    if scope == 'user':",
    "        cmd.append('--user')",
    "    cmd.extend(['list-units', '--type=service', '--all', '--no-pager', '--no-legend', '--plain'])",
    "    out = subprocess.run(cmd, capture_output=True, text=True)",
    "    if out.returncode != 0:",
    "        return None",
    "    services = []",
    "    for line in out.stdout.splitlines():",
    "        parts = line.split(None, 4)",
    "        if len(parts) < 5:",
    "            continue",
    "        name = parts[0]",
    "        if not name.endswith('.service'):",
    "            continue",
    "        services.append({",
    "            'name': name,",
    "            'state': map_state(parts[3]),",
    "            'substate': parts[2],",
    "            'description': parts[4],",
    "        })",
    "    return services",
    "socket_path = system_bus_socket_path()",
    "session_bus_ok, session_bus_err = dbus_send_call(",
    "    'user', 'org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus.Peer.Ping')",
    "if not session_bus_ok and has_gio():",
    "    try:",
    "        from gi.repository import Gio",
    "        Gio.bus_get_sync(Gio.BusType.SESSION, None)",
    "        session_bus_ok, session_bus_err = True, ''",
    "    except Exception as error:",
    "        session_bus_err = session_bus_err or ('gio-session:' + first_err(error))",
    "system_bus_ok, system_bus_err = dbus_send_call(",
    "    'system', 'org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus.Peer.Ping')",
    "if not system_bus_ok and has_gio():",
    "    try:",
    "        from gi.repository import Gio",
    "        Gio.bus_get_sync(Gio.BusType.SYSTEM, None)",
    "        system_bus_ok, system_bus_err = True, ''",
    "    except Exception as error:",
    "        system_bus_err = system_bus_err or ('gio-system:' + first_err(error))",
    "scopes = {}",
    "manager = {}",
    "for scope in ('user', 'system'):",
    "    services, err = gio_list(scope)",
    "    mechanism = 'gio-listunits'",
    "    if services is None:",
    "        services, err2 = dbus_python_list(scope)",
    "        mechanism = 'dbus-python'",
    "        if err2:",
    "            err = err or err2",
    "    ping_ok, ping_err = dbus_send_call(",
    "        scope, 'org.freedesktop.systemd1', '/org/freedesktop/systemd1',",
    "        'org.freedesktop.DBus.Peer.Ping')",
    "    reachable = services is not None or ping_ok",
    "    if services is None and ping_ok:",
    "        err = err or ping_err",
    "    if services is None and not ping_ok:",
    "        err = err or ping_err",
    "    manager[scope] = {'reachable': reachable, 'error': err or ''}",
    "    if not reachable:",
    "        continue",
    "    if services is None:",
    "        services = systemctl_list(scope)",
    "        mechanism = 'systemctl'",
    "    if services is None:",
    "        continue",
    "    scopes[scope] = {'scope': scope, 'mechanism': mechanism, 'services': services}",
    "absence = {",
    "    'systemctl': systemctl_bin() is not None,",
    "    'dbus_python': has_dbus_python(),",
    "    'dbus_send': dbus_send_bin() is not None,",
    "    'gio': has_gio(),",
    "    'system_bus_socket': socket_path,",
    "    'system_bus_socket_exists': os.path.exists(socket_path),",
    "    'session_bus_connect': session_bus_ok,",
    "    'session_bus_connect_error': session_bus_err,",
    "    'system_bus_connect': system_bus_ok,",
    "    'system_bus_connect_error': system_bus_err,",
    "    'session_systemd_manager': manager['user']['reachable'],",
    "    'system_systemd_manager': manager['system']['reachable'],",
    "    'session_systemd_error': manager['user']['error'],",
    "    'system_systemd_error': manager['system']['error'],",
    "    'xdg_runtime_dir': os.environ.get('XDG_RUNTIME_DIR', ''),",
    "    'dbus_session_bus_address': os.environ.get('DBUS_SESSION_BUS_ADDRESS', ''),",
    "}",
    "print(json.dumps({'absence': absence, 'scopes': scopes}))",
  ].join("\n");
}

function independent_facts() {
  const output = rh.command("python3", ["-c", probe_script()], {
    env: cu_env(),
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_service_probe:" + output.stderr);
  const parsed = JSON.parse(output.stdout.trim());
  ensure(parsed.absence !== undefined && parsed.absence !== null, "cu_linux_service_probe_absence_shape");
  const scopes = parsed.scopes;
  return {
    absence: parsed.absence,
    scopes: scopes === undefined || scopes === null ? {} : scopes,
  };
}

function absence_text(absence) {
  return "systemctl=" + absence.systemctl
    + " dbus_python=" + absence.dbus_python
    + " dbus_send=" + absence.dbus_send
    + " gio=" + absence.gio
    + " system_bus_socket_exists=" + absence.system_bus_socket_exists
    + " system_bus_connect=" + absence.system_bus_connect
    + " session_systemd_manager=" + absence.session_systemd_manager
    + " system_systemd_manager=" + absence.system_systemd_manager
    + " system_bus_error=" + first_line(text_at(absence, "system_bus_connect_error"))
    + " system_systemd_error=" + first_line(text_at(absence, "system_systemd_error"));
}

const missing_service_name = "com.example.agenterm.missing-court.service";
const AT_SPI_PROBE_NAME = "Service Court Anchor";

function output_success(document) { return at(document, "ok") === true; }

function cu_env_full(executable) {
  const env = cu_env();
  env.AGENTERM_ABI_LIB = rh.join(rh.parent(executable), "libagenterm.so");
  for (const key of ["AT_SPI_BUS_ADDRESS", "AT_SPI_BUS"]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_reply(run_directory, executable, args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe", "service",
  ].concat(args), {
    cwd: run_directory,
    env: env === undefined ? cu_env() : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_service_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "service" || text_at(reply, "command") === "usage",
    "cu_linux_service_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(args), {
    cwd: run_directory,
    env: env === undefined ? cu_env() : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_service_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env_full(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_service_usage_limit(run_directory, executable, env) {
  const list_with_name = invoke_reply(run_directory, executable, ["list", "--name", AT_SPI_PROBE_NAME], env);
  ensure(!output_success(list_with_name), "cu_linux_service_usage_list_name_ok:" + JSON.stringify(list_with_name));
  ensure(
    text_at(list_with_name, "error.code") === "usage",
    "cu_linux_service_usage_list_name_code:" + JSON.stringify(list_with_name.error)
  );
  ensure(
    text_at(list_with_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_service_usage_list_name_message:" + JSON.stringify(list_with_name.error)
  );

  const system_list_with_name = invoke_reply(run_directory, executable,
    ["system-list", "--name", AT_SPI_PROBE_NAME], env);
  ensure(!output_success(system_list_with_name),
    "cu_linux_service_usage_system_list_name_ok:" + JSON.stringify(system_list_with_name));
  ensure(
    text_at(system_list_with_name, "error.code") === "usage",
    "cu_linux_service_usage_system_list_name_code:" + JSON.stringify(system_list_with_name.error)
  );
  ensure(
    text_at(system_list_with_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_service_usage_system_list_name_message:" + JSON.stringify(system_list_with_name.error)
  );

  const status_with_name = invoke_reply(run_directory, executable,
    ["status", missing_service_name, "--name", AT_SPI_PROBE_NAME], env);
  ensure(!output_success(status_with_name),
    "cu_linux_service_usage_status_name_ok:" + JSON.stringify(status_with_name));
  ensure(
    text_at(status_with_name, "error.code") === "usage",
    "cu_linux_service_usage_status_name_code:" + JSON.stringify(status_with_name.error)
  );
  ensure(
    text_at(status_with_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_service_usage_status_name_message:" + JSON.stringify(status_with_name.error)
  );

  const system_status_with_name = invoke_reply(run_directory, executable,
    ["system-status", missing_service_name, "--name", AT_SPI_PROBE_NAME], env);
  ensure(!output_success(system_status_with_name),
    "cu_linux_service_usage_system_status_name_ok:" + JSON.stringify(system_status_with_name));
  ensure(
    text_at(system_status_with_name, "error.code") === "usage",
    "cu_linux_service_usage_system_status_name_code:" + JSON.stringify(system_status_with_name.error)
  );
  ensure(
    text_at(system_status_with_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_service_usage_system_status_name_message:" + JSON.stringify(system_status_with_name.error)
  );

  const bad_max = invoke_reply(run_directory, executable, ["list", "--max", "5001"], env);
  ensure(!output_success(bad_max), "cu_linux_service_usage_bad_max_ok:" + JSON.stringify(bad_max));
  ensure(
    text_at(bad_max, "error.code") === "usage",
    "cu_linux_service_usage_bad_max_code:" + JSON.stringify(bad_max.error)
  );
  ensure(
    text_at(bad_max, "error.message").indexOf("max") >= 0,
    "cu_linux_service_usage_bad_max_message:" + JSON.stringify(bad_max.error)
  );

  const missing_status_name = invoke_reply(run_directory, executable, ["status"], env);
  ensure(!output_success(missing_status_name),
    "cu_linux_service_usage_missing_status_ok:" + JSON.stringify(missing_status_name));
  ensure(
    text_at(missing_status_name, "error.code") === "usage",
    "cu_linux_service_usage_missing_status_code:" + JSON.stringify(missing_status_name.error)
  );

  const missing_subcommand = invoke_reply(run_directory, executable, [], env);
  ensure(!output_success(missing_subcommand),
    "cu_linux_service_usage_missing_subcommand_ok:" + JSON.stringify(missing_subcommand));
  ensure(
    text_at(missing_subcommand, "error.code") === "usage",
    "cu_linux_service_usage_missing_subcommand_code:" + JSON.stringify(missing_subcommand.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_service_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_service_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_service_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_service_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_service_extents_unavailable_code:" + code
  );
}

function missing_status_script() {
  return [
    "import json, os, shutil, subprocess, sys",
    "def map_state(active):",
    "    return {",
    "        'active': 'running', 'reloading': 'running',",
    "        'activating': 'activating', 'deactivating': 'deactivating',",
    "        'inactive': 'loaded_inactive', 'failed': 'failed',",
    "    }.get(active, 'unknown')",
    "def systemctl_bin():",
    "    for candidate in ('systemctl', '/usr/bin/systemctl', '/bin/systemctl'):",
    "        if shutil.which(candidate) or os.path.isfile(candidate):",
    "            return candidate",
    "    return None",
    "def unit_missing_text(text):",
    "    return 'NoSuchUnit' in text or 'not loaded' in text or 'Unknown object' in text",
    "def gio_missing(scope, name):",
    "    try:",
    "        from gi.repository import Gio, GLib",
    "    except Exception:",
    "        return None",
    "    bus_type = Gio.BusType.SESSION if scope == 'user' else Gio.BusType.SYSTEM",
    "    try:",
    "        bus = Gio.bus_get_sync(bus_type, None)",
    "        proxy = Gio.DBusProxy.new_sync(",
    "            bus, Gio.DBusProxyFlags.NONE, None,",
    "            'org.freedesktop.systemd1', '/org/freedesktop/systemd1',",
    "            'org.freedesktop.systemd1.Manager', None)",
    "        proxy.call_sync('GetUnit', GLib.Variant('(s)', (name,)), Gio.DBusCallFlags.NONE, 8000, None)",
    "        return {'missing': False, 'name': name}",
    "    except Exception as error:",
    "        text = str(error)",
    "        if unit_missing_text(text):",
    "            return {'missing': True, 'name': name}",
    "        return None",
    "def dbus_missing(scope, name):",
    "    try:",
    "        import dbus",
    "    except ImportError:",
    "        return None",
    "    try:",
    "        bus = dbus.SessionBus() if scope == 'user' else dbus.SystemBus()",
    "        manager = bus.get_object('org.freedesktop.systemd1', '/org/freedesktop/systemd1')",
    "        iface = dbus.Interface(manager, 'org.freedesktop.systemd1.Manager')",
    "        iface.GetUnit(name)",
    "        return {'missing': False, 'name': name}",
    "    except Exception as error:",
    "        text = str(error)",
    "        if unit_missing_text(text):",
    "            return {'missing': True, 'name': name}",
    "        return None",
    "def systemctl_missing(scope, name):",
    "    sc = systemctl_bin()",
    "    if sc is None:",
    "        return None",
    "    cmd = [sc]",
    "    if scope == 'user':",
    "        cmd.append('--user')",
    "    cmd.extend(['show', name, '--property=Id,ActiveState,SubState,Description', '--value'])",
    "    out = subprocess.run(cmd, capture_output=True, text=True)",
    "    if out.returncode != 0:",
    "        return {'missing': True, 'name': name}",
    "    values = [line.strip() for line in out.stdout.splitlines() if line.strip() != '']",
    "    if len(values) < 4:",
    "        return None",
    "    return {'missing': False, 'name': values[0], 'state': map_state(values[1]), 'substate': values[2]}",
    "scope = sys.argv[1]",
    "name = sys.argv[2]",
    "result = gio_missing(scope, name)",
    "mechanism = 'gio-getunit'",
    "if result is None:",
    "    result = dbus_missing(scope, name)",
    "    mechanism = 'dbus-python'",
    "if result is None:",
    "    result = systemctl_missing(scope, name)",
    "    mechanism = 'systemctl'",
    "if result is None:",
    "    print(json.dumps({'available': False})); sys.exit(0)",
    "print(json.dumps({'available': True, 'mechanism': mechanism, 'result': result}))",
  ].join("\n");
}

function independent_missing_status(scope, name) {
  const output = rh.command("python3", ["-c", missing_status_script(), scope, name], {
    env: cu_env(),
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_service_missing_probe:" + output.stderr);
  const parsed = JSON.parse(output.stdout.trim());
  if (parsed.available !== true || !parsed.result) { return null; }
  return parsed;
}

function verify_unsupported(reply) {
  ensure(reply.ok !== true, "cu_linux_service_false_success");
  ensure(text_at(reply, "error.code") === "service_unsupported", "cu_linux_service_code:" + JSON.stringify(reply.error));
  ensure(text_at(reply, "error.message").length > 0, "cu_linux_service_message");
  ensure(text_at(reply, "error.message").indexOf("macOS") < 0, "cu_linux_service_macos_claim");
  const detail = at(reply, "error.detail");
  ensure(text_at(detail, "os") === "linux", "cu_linux_service_os");
  ensure(text_at(detail, "required_os") === "linux", "cu_linux_service_required_os");
  ensure(text_at(detail, "provider") === "none", "cu_linux_service_provider");
  ensure(text_at(detail, "limit") === "host", "cu_linux_service_limit");
  ensure(text_at(detail, "group") === "system", "cu_linux_service_group");
  ensure(text_at(detail, "mechanism").indexOf("systemd") >= 0, "cu_linux_service_mechanism");
  const alts = at(detail, "alternatives");
  ensure(Array.isArray(alts) && alts.length > 0, "cu_linux_service_alternatives");
  ensure(JSON.stringify(alts).indexOf("systemctl") >= 0, "cu_linux_service_systemctl_alt");
  ensure(JSON.stringify(reply).indexOf("launchctl") < 0 || text_at(detail, "required_os") === "macos",
         "cu_linux_service_no_macos_claim");
  const encoded = JSON.stringify(reply);
  ensure(encoded.indexOf('"state":"running"') < 0, "cu_linux_service_fake_running:" + encoded);
}

function verify_scope_unsupported(run_directory, executable, scope) {
  const list_args = scope === "system" ? ["system-list", "--max", "8"] : ["list", "--max", "8"];
  const status_args = scope === "system"
    ? ["system-status", missing_service_name]
    : ["status", missing_service_name];
  verify_unsupported(invoke(run_directory, executable, list_args, false));
  verify_unsupported(invoke(run_directory, executable, status_args, false));
}

function scope_manager_ready(absence, scope) {
  if (scope === "system") {
    return absence.system_bus_socket_exists === true
      && absence.system_bus_connect === true
      && absence.system_systemd_manager === true;
  }
  return absence.session_bus_connect === true
    && absence.session_systemd_manager === true;
}

function index_services(services) {
  const map = {};
  for (let index = 0; index < services.length; index = index + 1) {
    map[services[index].name] = services[index];
  }
  return map;
}

function verify_list_scope(run_directory, executable, scope, probe, max_items) {
  const list_args = scope === "system"
    ? ["system-list", "--max", "" + max_items]
    : ["list", "--max", "" + max_items];
  const reply = invoke(run_directory, executable, list_args, true);
  const data = reply.data;
  const expected_scope = scope === "system" ? "system" : "user";
  ensure(text_at(data, "scope") === expected_scope, "cu_linux_service_scope:" + scope);
  ensure(Array.isArray(data.services), "cu_linux_service_services");
  ensure(data.services.length <= max_items, "cu_linux_service_bound");
  ensure(data.services.length > 0, "cu_linux_service_inventory_empty:" + scope);
  const independent = index_services(probe.services);
  for (let index = 0; index < data.services.length; index = index + 1) {
    const row = data.services[index];
    const name = text_at(row, "identity.name");
    ensure(name.endsWith(".service"), "cu_linux_service_name_suffix:" + name);
    ensure(text_at(row, "identity.provider") === "systemd", "cu_linux_service_provider:" + name);
    ensure(text_at(row, "identity.provider_scope") === expected_scope, "cu_linux_service_domain:" + name);
    const probe_row = independent[name];
    ensure(probe_row !== undefined, "cu_linux_service_missing_in_probe:" + name);
    ensure(text_at(row, "state") === probe_row.state, "cu_linux_service_state:" + name + ":" + text_at(row, "state") + ":" + probe_row.state);
    ensure(text_at(row, "substate") === probe_row.substate, "cu_linux_service_substate:" + name);
  }
  return data.services[0].identity.name;
}

function verify_status_scope(run_directory, executable, scope, name, probe) {
  const status_args = scope === "system" ? ["system-status", name] : ["status", name];
  const reply = invoke(run_directory, executable, status_args, true);
  const data = reply.data;
  const expected_scope = scope === "system" ? "system" : "user";
  ensure(text_at(data, "identity.name") === name, "cu_linux_service_status_name");
  ensure(text_at(data, "identity.scope") === expected_scope, "cu_linux_service_status_scope");
  ensure(text_at(data, "identity.provider") === "systemd", "cu_linux_service_status_provider");
  const probe_row = index_services(probe.services)[name];
  ensure(probe_row !== undefined, "cu_linux_service_status_probe_missing:" + name);
  ensure(text_at(data, "state") === probe_row.state, "cu_linux_service_status_state:" + name);
  ensure(text_at(data, "substate") === probe_row.substate, "cu_linux_service_status_substate:" + name);
}

function verify_missing_status_scope(run_directory, executable, scope) {
  const missing_probe = independent_missing_status(scope, missing_service_name);
  ensure(missing_probe !== null, "cu_linux_service_missing_probe_unavailable:" + scope);
  ensure(missing_probe.result.missing === true, "cu_linux_service_missing_probe_not_missing:" + scope);
  const status_args = scope === "system"
    ? ["system-status", missing_service_name]
    : ["status", missing_service_name];
  const reply = invoke(run_directory, executable, status_args, true);
  const data = reply.data;
  const expected_scope = scope === "system" ? "system" : "user";
  ensure(text_at(data, "identity.name") === missing_service_name, "cu_linux_service_missing_name");
  ensure(text_at(data, "identity.scope") === expected_scope, "cu_linux_service_missing_scope");
  ensure(text_at(data, "identity.provider") === "systemd", "cu_linux_service_missing_provider");
  ensure(text_at(data, "state") === "missing", "cu_linux_service_missing_state:" + scope);
  ensure(text_at(data, "substate") === "", "cu_linux_service_missing_substate:" + scope);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(rh.exists(executable), "missing_agenterm_cu:" + executable);

const context = harness.new_context(repo, "cu-linux-service");
const env = cu_env_full(executable);
const atspi_available = probe_atspi_available(executable);

print("STEP service typed-fails usage when AT-SPI --name or other unexpected arguments are present");
assert_service_usage_limit(context.run_directory, executable, env);

if (atspi_available) {
  print("STEP get-extents typed-fail invalid_input when --window is zero before systemd read-back");
  assert_get_extents_usage_limit(context.run_directory, executable, env);
} else {
  print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
  assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
}

const facts = independent_facts();
const absence = facts.absence;
const scopes = facts.scopes;
const extents_note = atspi_available
  ? "typed service/get-extents usage honesty (AT-SPI --name, no --coords)"
  : "typed service/get-extents host-limit honesty (AT-SPI --name, no --coords)";

print("STEP independent systemd D-Bus absence/presence read-back " + absence_text(absence));

let positive_count = 0;
const scope_names = ["user", "system"];
for (let scope_index = 0; scope_index < scope_names.length; scope_index = scope_index + 1) {
  const scope = scope_names[scope_index];
  const probe = at(scopes, scope);
  const manager_ready = scope_manager_ready(absence, scope);
  if (manager_ready !== true || probe === undefined || probe === null) {
    print("STEP " + scope + " scope typed service_unsupported host-limit; independent systemd manager absent ("
      + absence_text(absence) + ")");
    ensure(manager_ready !== true, "cu_linux_service_manager_ready_without_inventory:" + scope);
    verify_scope_unsupported(context.run_directory, executable, scope);
  } else {
    print("STEP " + scope + " service inventory/status match independent "
      + text_at(probe, "mechanism") + " read-back");
    const max_items = scope === "system" ? 8 : 16;
    const name = verify_list_scope(context.run_directory, executable, scope, probe, max_items);
    verify_status_scope(context.run_directory, executable, scope, name, probe);
    print("STEP missing service status for " + scope + " agrees with independent "
      + "systemd D-Bus read-back (" + missing_service_name + ")");
    verify_missing_status_scope(context.run_directory, executable, scope);
    positive_count = positive_count + 1;
  }
}

harness.emit_evidence(context, declared_evidence, "cu.linux-service-readback");
harness.remove_run(context);
if (positive_count === 0) {
  print("PASS: Linux service typed unsupported with independent probe absence read-back and "
    + extents_note);
} else if (positive_count === 2) {
  print("PASS: Linux service list/system-status with independent systemd probe read-back and "
    + extents_note);
} else {
  print("PASS: Linux service mixed inventory/host-limit with independent systemd manager read-back and "
    + extents_note);
}
