// Shard B of the browser-session -> ownership selftest: the happy path, the
// browser-root acknowledgement, ownership-boundary causality, the admission
// refusals and the refusal matrix up to (and including) the foreign-session case.
//
// A fake executor and a fake adapter stand in for the real CLI and filesystem, so
// no browser, GUI or court is touched. The macOS identity parser and the CLI
// guards live in `singleton-safety-session-selftest-identity.qjs`; the
// terminal/cleanup seat and the status2 refusals live in
// `singleton-safety-session-selftest-terminal.qjs`.
//
// This shard imports ONLY the support library (the single copy of the fixture,
// the fake executor/adapter and the two frozen identity goldens), so the runner is
// inlined once and that one reach is the one `session` already had.
//
// Owned root: target/singleton-safety-session-selftest-b (independent from the
// other shards' roots, so the shards can run concurrently without sharing an
// owned tree). Removed on success and failure.
import * as fx from "lib/singleton_safety_session_selftest_support";

const PIECE = "b";

function require(condition, message) { if (!condition) { throw message; } }

function test_session_to_ownership(template) {
  // happy path: browser-root(seq0) uses the BROWSER identity, ownership-boundary(seq1).
  const happy_root = fx.piece_path(PIECE, "run-session");
  const ex = fx.session_executor(fx.replies(), null);
  const ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3,
    expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  const hc = fx.context(happy_root);
  const ctx = fx.session_to_ownership_ok(ex, ad, template, hc);
  require(ctx.browser_session_ready === true && ctx.control_sequence === 1, "session_context_extended");
  require(ctx.ownership.sample_sequence === 3, "session_ownership_sequence");
  require(ctx.session.browser_pid === fx.browser_pid && ctx.session.owner_pid === fx.owner_pid, "session_browser_not_owner");
  const boundary_roles = [];
  for (let i = 0; i < ad.appends.length; i = i + 1) {
    if (ad.appends[i].text.indexOf('"role":"browser-root"') !== -1) { boundary_roles.push("browser-root"); }
    if (ad.appends[i].text.indexOf('"role":"ownership-boundary"') !== -1) { boundary_roles.push("ownership-boundary"); }
  }
  require(boundary_roles.length === 2 && boundary_roles[0] === "browser-root" && boundary_roles[1] === "ownership-boundary",
          "session_control_order:" + JSON.stringify(boundary_roles));
  // the browser-root record carries the BROWSER pid, not the owner pid
  require(ad.appends[0].text.indexOf('"pid":' + fx.browser_pid) !== -1, "browser_root_identity_is_browser");

  // P0-1: a session whose `browser` is missing is refused (no browser root).
  let seen_nobrowser = null;
  try {
    const no_browser = fx.reply("browser-session-status", fx.session_data("ready", "live", null));
    fx.session_to_ownership(fx.session_executor(fx.replies({ status: no_browser }), null).run,
      fx.session_adapter({ expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }), template,
      fx.context(fx.piece_path(PIECE, "run-nobrowser")), fx.session_options(fx.piece_path(PIECE, "run-nobrowser")));
  } catch (e) { seen_nobrowser = e; }
  require(seen_nobrowser !== null && ("" + fx.session_primary(seen_nobrowser)).indexOf("session_browser_missing") !== -1,
          "session_browser_missing_refused:" + JSON.stringify(seen_nobrowser));

  // The contract does NOT forbid browser.pid == owner.pid (no distinctness rule),
  // so that shape is ACCEPTED (the browser identity is still required and used).
  const same_status = fx.reply("browser-session-status", fx.session_data("ready", "live", { pid: fx.owner_pid, start_identity: fx.owner_identity }));
  const same_start = fx.reply("browser-session-start", fx.session_data("ready", "live", { pid: fx.owner_pid, start_identity: fx.owner_identity }));
  const same_row = { handle: 42, ref: "App#1", title: "t", process_id: fx.owner_pid, app_name: "a",
    bounds: { x: 0, y: 0, width: 1, height: 1 }, focused: true, minimized: false, maximized: false,
    fullscreen: false, above: false, browser_profile: null };
  const same_windows = fx.reply("windows", { mechanism: "libagenterm", focus: {}, stacking: {}, filter: {},
    visited: 1, matched: 1, returned: 1, offset: 0, truncated: false, windows: [same_row] });
  const same_process = fx.reply("process-state", { pid: fx.owner_pid, state: "live", start_identity: fx.owner_identity, reason: null, verified: true });
  const same_digest = fx.SAME_DIGEST;
  const same_ctx = fx.context(fx.piece_path(PIECE, "run-same"));
  fx.session_to_ownership(fx.session_executor(fx.replies({ start: same_start, status: same_status, windows: same_windows, process: same_process }), null).run,
    fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3, expected_root_digest: same_digest, browser_pid: fx.owner_pid }),
    template, same_ctx, fx.session_options(fx.piece_path(PIECE, "run-same")));
  require(same_ctx.browser_session_ready === true, "session_browser_equals_owner_allowed");

  // P0-5: an ack whose observed digest does not match the control we wrote is refused.
  let seen_baddigest = null;
  try {
    fx.session_to_ownership(fx.session_executor(fx.replies(), null).run,
      fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3,
        expected_root_digest: "0".repeat(64), browser_pid: fx.browser_pid }),
      template, fx.context(fx.piece_path(PIECE, "run-baddigest")), fx.session_options(fx.piece_path(PIECE, "run-baddigest")));
  } catch (e) { seen_baddigest = e; }
  require(seen_baddigest !== null, "session_bad_digest_refused");

  // P0-1 (E1e): a row that is `observed` while control_record_count is still 0 is a
  // NORMAL stale snapshot -- keep polling. The FIRST frame reports 0 here, a later
  // frame reports the true count, and the ack must SUCCEED (never throw on frame 1).
  const firstzero_ad = fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3,
    count_first_zero: true, expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  const firstzero_ctx = fx.context(fx.piece_path(PIECE, "run-firstzero"));
  const firstzero_ok = fx.session_to_ownership_ok(fx.session_executor(fx.replies(), null), firstzero_ad, template, firstzero_ctx);
  require(firstzero_ok.browser_session_ready === true, "session_first_count_zero_acked");

  // P0-1 (E1e): a count that NEVER reaches the control is not a hard failure any
  // more; it simply never satisfies the predicate and times out on the phase.
  let seen_count0 = null;
  try {
    fx.session_to_ownership(fx.session_executor(fx.replies(), null).run,
      fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3, force_control_count: 0, step_ms: 2000,
        expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }),
      template, fx.context(fx.piece_path(PIECE, "run-count0")), fx.session_options(fx.piece_path(PIECE, "run-count0"), { phase_budget_ms: 6000 }));
  } catch (e) { seen_count0 = e; }
  require(seen_count0 !== null && ("" + fx.session_primary(seen_count0)).indexOf("browser_root_ack_timeout") !== -1,
          "session_control_count_poll_timeout:" + JSON.stringify(seen_count0));

  // P0-5: a pre-boundary non-null ownership sequence is refused.
  let seen_oldnonnull = null;
  try {
    fx.session_to_ownership(fx.session_executor(fx.replies(), null).run,
      fx.session_adapter({ ownership_sequence: 2, new_ownership_sequence: 3,
        expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }),
      template, fx.context(fx.piece_path(PIECE, "run-oldnonnull")), fx.session_options(fx.piece_path(PIECE, "run-oldnonnull")));
  } catch (e) { seen_oldnonnull = e; }
  require(seen_oldnonnull !== null && ("" + fx.session_primary(seen_oldnonnull)).indexOf("ownership_sequence_not_null_before_boundary") !== -1,
          "session_old_nonnull_refused:" + JSON.stringify(seen_oldnonnull));

  // non-macOS platform is refused (still aborts the context).
  let seen_platform = null;
  const plat_ctx = fx.context(fx.piece_path(PIECE, "run-plat"));
  try {
    fx.session_to_ownership(fx.session_executor(fx.replies(), null).run, fx.session_adapter({}), template,
      plat_ctx, fx.session_options(fx.piece_path(PIECE, "run-plat"), { platform: "linux" }));
  } catch (e) { seen_platform = e; }
  require(seen_platform !== null && ("" + fx.session_primary(seen_platform)).indexOf("platform_not_macos") !== -1,
          "session_platform_refused");
  require(plat_ctx.state.aborted === true, "session_platform_still_aborts");

  // P0-3: a bad argument AFTER the context is obtained still aborts the context.
  let seen_badarg = null;
  const badarg_ctx = fx.context(fx.piece_path(PIECE, "run-badarg"));
  try {
    fx.session_to_ownership(fx.session_executor(fx.replies(), null).run, fx.session_adapter({}), template,
      badarg_ctx, fx.session_options(fx.piece_path(PIECE, "run-badarg"), { ready_timeout_ms: 999 }));
  } catch (e) { seen_badarg = e; }
  require(seen_badarg !== null && badarg_ctx.state.aborted === true, "session_badarg_aborts");

  // PID reuse (process-state identity differs) is refused.
  const pid_reuse = fx.reply("process-state", { pid: fx.browser_pid, state: "live", start_identity: "macos-start-time:1.1", reason: null, verified: true });
  let seen_reuse = null;
  try {
    fx.session_to_ownership(fx.session_executor(fx.replies({ process: pid_reuse }), null).run,
      fx.session_adapter({ expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }), template,
      fx.context(fx.piece_path(PIECE, "run-reuse")), fx.session_options(fx.piece_path(PIECE, "run-reuse")));
  } catch (e) { seen_reuse = e; }
  require(seen_reuse !== null && ("" + fx.session_primary(seen_reuse)).indexOf("pid_reuse") !== -1,
          "session_pid_reuse_refused:" + JSON.stringify(seen_reuse));

  // browser-root ack timeout.
  let seen_ack = null;
  try {
    fx.session_to_ownership(fx.session_executor(fx.replies(), null).run,
      fx.session_adapter({ root_status: "pending", step_ms: 2000, expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }),
      template, fx.context(fx.piece_path(PIECE, "run-ack")), fx.session_options(fx.piece_path(PIECE, "run-ack"), { phase_budget_ms: 6000 }));
  } catch (e) { seen_ack = e; }
  require(seen_ack !== null && ("" + fx.session_primary(seen_ack)).indexOf("browser_root_ack_timeout") !== -1,
          "session_ack_timeout:" + JSON.stringify(seen_ack));

  // P0-4: cleanup uses its OWN bounded deadline even when the main phase is
  // exhausted, so a stop/remove is still attempted.
  const cleanup_ad = fx.session_adapter({ root_status: "pending", step_ms: 2000,
    expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid });
  let seen_cleanup = null;
  try {
    fx.session_to_ownership(fx.session_executor(fx.replies(), null).run, cleanup_ad, template,
      fx.context(fx.piece_path(PIECE, "run-cleanup")), fx.session_options(fx.piece_path(PIECE, "run-cleanup"), { phase_budget_ms: 6000 }));
  } catch (e) { seen_cleanup = e; }
  require(seen_cleanup !== null, "session_cleanup_ran");
  // The cleanup ran on its own deadline: the stop/remove succeeded, so there is no
  // `session_stop_deadline_exhausted` failure (the primary is the ack timeout).
  require(("" + fx.session_primary(seen_cleanup)).indexOf("browser_root_ack_timeout") !== -1,
          "session_cleanup_own_deadline_primary:" + JSON.stringify(seen_cleanup));
  if (typeof seen_cleanup === "object" && seen_cleanup !== null) {
    for (let i = 0; i < seen_cleanup.cleanup_failures.length; i = i + 1) {
      require(seen_cleanup.cleanup_failures[i].indexOf("session_stop_deadline_exhausted") !== 0,
              "session_cleanup_own_deadline_leaked:" + JSON.stringify(seen_cleanup));
    }
  }

  // E1b: a same-named session whose START returns no nonce leaves ownership
  // unproven -> `session_publication_uncertain`, nothing foreign is stopped/removed.
  const no_nonce_start = { exit_code: 0, stdout: fx.canonical({ ok: true, target: "current", command: "browser-session-start", data: {
    schema_version: 1, generation: 1, name: fx.subject, state: "ready",
    owner: { pid: fx.owner_pid, start_identity: fx.owner_identity }, owner_spawn_mode: "detached",
    profile_identity: { device: 1, inode: 2 }, owner_observation: "live", owned: true } }) };
  let seen_uncertain = null;
  try {
    fx.session_to_ownership(fx.session_executor(fx.replies({ start: no_nonce_start }), null).run,
      fx.session_adapter({ expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }), template,
      fx.context(fx.piece_path(PIECE, "run-uncertain")), fx.session_options(fx.piece_path(PIECE, "run-uncertain")));
  } catch (e) { seen_uncertain = e; }
  require(seen_uncertain !== null && fx.has_item(seen_uncertain.cleanup_failures, "session_publication_uncertain"),
          "session_uncertain_flagged:" + JSON.stringify(seen_uncertain));

  // E1b: a same-named FOREIGN session (status nonce differs) is NOT deleted: no
  // stop/remove is issued.
  let stop_calls = 0;
  const foreign_status = fx.reply("browser-session-status", fx.session_data("ready", "live", fx.browser_obj));
  foreign_status.stdout = fx.canonical({ ok: true, target: "current", command: "browser-session-status", data: {
    schema_version: 1, generation: 1, name: fx.subject, session_nonce: "ffffffffffffffff", state: "ready",
    owner: { pid: fx.owner_pid, start_identity: fx.owner_identity }, owner_spawn_mode: "detached",
    profile_identity: { device: 1, inode: 2 }, owner_observation: "live", owned: true, browser: fx.browser_obj } });
  const foreign_ex = fx.session_executor(fx.replies({ status: foreign_status }), null);
  const wrapped_foreign = { seen: [], run: function (argv, ms) {
    for (let i = 0; i < argv.length; i = i + 1) { if (argv[i] === "browser-session-stop" || argv[i] === "browser-session-remove") { stop_calls = stop_calls + 1; } }
    return foreign_ex.run(argv, ms); } };
  let seen_foreign = null;
  try {
    fx.session_to_ownership(wrapped_foreign.run, fx.session_adapter({ ownership_sequence: null, new_ownership_sequence: 3, expected_root_digest: fx.BROWSER_DIGEST, browser_pid: fx.browser_pid }),
      template, fx.context(fx.piece_path(PIECE, "run-foreign")), fx.session_options(fx.piece_path(PIECE, "run-foreign")));
  } catch (e) { seen_foreign = e; }
  require(seen_foreign !== null, "session_foreign_refused");
  require(stop_calls === 0, "session_foreign_not_deleted:" + stop_calls);
}

function run() {
  const template = fx.load_template();
  fx.create_dir_all(fx.piece_root(PIECE));
  fx.with_piece_cleanup(PIECE, function () {
    test_session_to_ownership(template);
  });
  print("singleton-safety session selftest (ack/refusal) ok");
  return 0;
}

return run();
