// Build and optionally stage AgenTerm through one manifest-owned lifecycle.
//
// Args:
//   REPO [release-fast|release|dev]
//        [--target TRIPLE] [--driver cargo|cargo-xwin|cargo-zigbuild]
//        [--glibc VERSION]
//        [--os windows|linux|macos] [--arch x86_64|aarch64]
//        [--clients-only] [--action build|clippy]
//
// Default profile is release-fast: optimized PE staged to dist/, while
// target/debug remains the pure debug cargo layout (only via explicit "dev").
// Whole-root incremental manifest production belongs only to the native
// Windows dev lane that reaches both stage-build and prune. Unix bootstrap
// and cross-client lanes return after artifact listing and report this
// producer as not applicable; they do not claim cleanup integration.
//
// Runs under `--profile tool`. Moved from rh on 2026-08-29.
//
// Changed from rh, each on purpose:
//   - Nested tasks ran through the worker as `rh task run TASK --manifest
//     FILE -- ARGS`; rh is retired here, so they run as `cli script task run
//     TASK --manifest FILE -- ARGS`, and the worker self-check `rh version`
//     is `cli script version`.
//   - The door's `command` captures both streams; rh's `stderr_inherit`
//     (stream cargo's progress live) has no spelling on it. Captured stderr
//     is printed after the command instead, so the diagnostics still reach
//     the log -- later rather than live.
//   - rh parked command stdout in `<repo>.build*.stdout.tmp` side files; the
//     door answers stdout directly, so those files are gone.
//   - `capture_limit(262144)` on the stage command is the door's own bridge
//     cap now; there is no per-command spelling.
//   - Environment for the nested commands is passed as the whole map
//     (`env: environment`) rather than rh's key-by-key `.env(...)` calls
//     guarded by `contains("\"KEY\":")`; the keys present are the same.

import * as rh from "lib/rh_compat";
import * as artifact_files from "lib/artifact_files";
import * as build_identity from "lib/build_identity";
import * as bootstrap_timing from "lib/bootstrap_timing";

function bootstrap_facts() {
  return bootstrap_timing.facts();
}

function require(condition, message) {
  if (!condition) { throw message; }
}

function direct_file(path) {
  if (!rh.exists(path)) { return 0; }
  const metadata = rh.symlink_metadata(path);
  if (metadata.is_file && !metadata.is_symlink) { return 1; }
  return 0;
}

function cleanup_incremental_state(path) {
  if (path === "" || !rh.exists(path)) { return 0; }
  rh.remove_dir_all(path);
  return 0;
}

// Print what a finished command wrote, stdout then stderr, when non-empty.
function replay(output) {
  const out = output.stdout.trim();
  if (out !== "") { print(out); }
  const err = output.stderr.trim();
  if (err !== "") { print(err); }
}

function promote_bootstrap_worker(repo, candidate, cache_name) {
  if (!rh.has_env("AGENTERM_BOOTSTRAP_CACHE_WORKER") ||
      !rh.has_env("AGENTERM_BOOTSTRAP_CACHE_STAMP") ||
      !rh.has_env("AGENTERM_BOOTSTRAP_FINGERPRINT")) {
    return 0;
  }
  require(direct_file(candidate) !== 0, "build_bootstrap_candidate_missing");
  const self_check = rh.command_status(candidate, ["cli", "script", "version"], { cwd: repo, timeout_ms: 30000 });
  require(self_check === 0, "build_bootstrap_candidate_self_check");

  const cache_worker = rh.absolute(rh.env_or("AGENTERM_BOOTSTRAP_CACHE_WORKER", ""));
  const cache_stamp = rh.absolute(rh.env_or("AGENTERM_BOOTSTRAP_CACHE_STAMP", ""));
  const nonce = "" + rh.pid() + "-" + rh.now_ms();
  const worker_temp = cache_worker + ".next-" + nonce;
  const stamp_temp = cache_stamp + ".next-" + nonce;
  rh.copy(candidate, worker_temp);
  const hash = rh.command("git", ["hash-object", "--", worker_temp], { cwd: repo, timeout_ms: 10000 });
  require(hash.exit_code === 0, "build_bootstrap_candidate_hash");
  const worker_hash = hash.stdout.trim();
  rh.write_text(
    stamp_temp,
    "2 " + rh.env_or("AGENTERM_BOOTSTRAP_FINGERPRINT", "") + " " + worker_hash + "\n"
  );
  // The task executes from an invocation copy, never from CACHE_WORKER, so
  // the fixed LKG path is not an in-use image here. Complete both temporary
  // files before replacing either destination. A crash between replacements
  // leaves a hash mismatch and forces a clean seed instead of trusting bytes
  // with stale provenance.
  if (rh.exists(cache_worker)) {
    require(rh.try_remove_file(cache_worker), "build_bootstrap_cache_worker_replace");
  }
  rh.rename(worker_temp, cache_worker);
  if (rh.exists(cache_stamp)) {
    require(rh.try_remove_file(cache_stamp), "build_bootstrap_cache_stamp_replace");
  }
  rh.rename(stamp_temp, cache_stamp);
  print("AgenTerm bootstrap worker: promoted last-known-good agenterm");
  // 1 = the candidate was proven (direct_file + version self-check) and may
  // be adopted as the engine for the remaining nested tasks. The early return
  // above yields 0: nothing was validated, so the caller must keep the
  // bootstrap worker.
  return 1;
}

function target_arch(target) {
  if (target.startsWith("aarch64")) { return "aarch64"; }
  return "x86_64";
}

function target_facts(target) {
  const arch = target_arch(target);
  if (target.includes("windows")) { return { os: "windows", arch: arch }; }
  if (target.includes("apple")) { return { os: "macos", arch: arch }; }
  if (target.includes("linux")) { return { os: "linux", arch: arch }; }
  return { os: "", arch: "" };
}

function platform_executables(repo, os_name, target_arch_name) {
  const arch_label = "" + target_arch_name;
  const manifest_path = rh.join(repo, "scripts/artifacts.json");
  const manifest = rh.parse_file(manifest_path);
  const executables = [];
  let found = 0;
  for (const platform of manifest.platforms) {
    if (platform.os === os_name && platform.arch === arch_label) {
      require(found === 0, "build_platform_manifest_match:" + os_name + "-" + arch_label);
      found = 1;
      for (const executable of platform.executables) { executables.push(executable); }
    }
  }
  require(found === 1, "build_platform_manifest_match:" + os_name + "-" + arch_label);
  return executables;
}

function platform_libraries(repo, os_name, target_arch_name) {
  const arch_label = "" + target_arch_name;
  const manifest_path = rh.join(repo, "scripts/artifacts.json");
  const manifest = rh.parse_file(manifest_path);
  const libraries = [];
  let found = 0;
  for (const platform of manifest.platforms) {
    if (platform.os === os_name && platform.arch === arch_label) {
      require(found === 0, "build_platform_library_match:" + os_name + "-" + arch_label);
      found = found + 1;
      for (const library of platform.libraries) { libraries.push(library); }
    }
  }
  require(found === 1, "build_platform_library_match:" + os_name + "-" + arch_label);
  return libraries;
}

function cargo_binary(name) {
  if (name === "agenterm.com") { return "agenterm-com"; }
  if (name.endsWith(".exe")) {
    // rh's `sub_string(0, len - 4)`; no `slice` on strings in this engine, so
    // drop the last dot-separated piece and rebuild the rest.
    const parts = name.split(".");
    let stem = "";
    for (let i = 0; i < parts.length - 1; i = i + 1) {
      stem = i === 0 ? parts[i] : stem + "." + parts[i];
    }
    return stem;
  }
  return name;
}

function repo_dir(repo_arg) {
  return rh.absolute(repo_arg);
}

// Nested task invocation through the worker: rh's `rh task run ...`.
function task_arguments(task, task_manifest, task_args) {
  const all = ["cli", "script", "task", "run", task, "--manifest", task_manifest, "--"];
  for (const a of task_args) { all.push("" + a); }
  return all;
}

// ---- entry ----------------------------------------------------------------

const arg_total = arg_count();
require(arg_total >= 1, "expected: REPO [PROFILE] [OPTIONS]");
const args = [];
for (let i = 0; i < arg_total; i = i + 1) {
  if (arg(i) !== 0) { throw "arg: " + tool_result(); }
  args.push(tool_result());
}

const repo_arg = args[0];
let repo = repo_dir(repo_arg);
const bootstrap = bootstrap_facts();
print("AgenTerm bootstrap timing: " + JSON.stringify(bootstrap));
// Stage optimized PE by default. Debug PE stays under target/debug unless the
// caller explicitly asks for "dev" (still may stage to dist for rare debug
// black-box cases).
let profile = "release-fast";
let profile_set = 0;
let target = "";
let driver = "cargo";
// Empty means "whatever the build host happens to have". `cargo-zigbuild`
// takes a `<triple>.<glibc>` target and links against that version's stubs,
// which is how one host produces a binary that runs on distributions older
// than itself. Output paths keep the plain triple.
let glibc = "";
let os_name = "";
let arch = "";
let clients_only = 0;
let action = "build";
let index = 1;
while (index < args.length) {
  const value = "" + args[index];
  if (value === "release" || value === "release-fast" || value === "dev") {
    require(profile_set === 0, "build_profile_duplicate");
    profile = value;
    profile_set = 1;
  } else if (value === "--target") {
    require(index + 1 < args.length, "build_option_value_missing:" + value);
    target = args[index + 1];
    index = index + 1;
  } else if (value === "--glibc") {
    require(index + 1 < args.length, "build_option_value_missing:" + value);
    glibc = args[index + 1];
    index = index + 1;
  } else if (value === "--driver") {
    require(index + 1 < args.length, "build_option_value_missing:" + value);
    driver = args[index + 1];
    index = index + 1;
  } else if (value === "--os") {
    require(index + 1 < args.length, "build_option_value_missing:" + value);
    os_name = args[index + 1];
    index = index + 1;
  } else if (value === "--arch") {
    require(index + 1 < args.length, "build_option_value_missing:" + value);
    arch = args[index + 1];
    index = index + 1;
  } else if (value === "--action") {
    require(index + 1 < args.length, "build_option_value_missing:" + value);
    action = args[index + 1];
    index = index + 1;
  } else if (value === "--clients-only") {
    clients_only = 1;
  } else {
    throw "build_unknown_argument:" + value;
  }
  index = index + 1;
}
require(
  driver === "cargo" || driver === "cargo-xwin" || driver === "cargo-zigbuild",
  "build_driver:" + driver
);
require(action === "build" || action === "clippy", "build_action:" + action);
require(target !== "" || driver === "cargo", "build_xwin_requires_target");
require(glibc === "" || driver === "cargo-zigbuild", "build_glibc_requires_zigbuild:" + driver);
if (target !== "") {
  const facts = target_facts(target);
  require(facts.os !== "", "build_target_unsupported:" + target);
  if (os_name === "") { os_name = "" + facts.os; }
  if (arch === "") { arch = "" + facts.arch; }
  require(os_name === facts.os && arch === facts.arch, "build_target_platform_mismatch");
}
if (os_name === "" && rh.has_env("AGENTERM_HOST_OS")) {
  os_name = rh.env_or("AGENTERM_HOST_OS", "");
}
if (arch === "" && rh.has_env("AGENTERM_HOST_ARCH")) {
  arch = rh.env_or("AGENTERM_HOST_ARCH", "");
}

require(rh.has_env("AGENTERM_BOOTSTRAP_WORKER"), "build_bootstrap_worker_missing");
let worker = rh.absolute(rh.env_or("AGENTERM_BOOTSTRAP_WORKER", ""));
let task_manifest = rh.join(repo, "agenterm.tasks.json");
const dist = rh.join(repo, "dist");
let cross_client = 0;
if (clients_only !== 0 || target !== "") { cross_client = 1; }
let unix_bootstrap = 0;
if (rh.env_or("AGENTERM_BOOTSTRAP_PLATFORM", "") === "unix") { unix_bootstrap = 1; }
if (cross_client !== 0 || unix_bootstrap !== 0) {
  require(os_name !== "" && arch !== "", "build_platform_missing");
}

let external_target = 0;
if (rh.has_env("CARGO_TARGET_DIR")) { external_target = 1; }
let cargo_output = rh.join(repo, "target");
if (external_target !== 0) {
  cargo_output = rh.absolute(rh.env_or("CARGO_TARGET_DIR", ""));
} else if (profile === "release" && cross_client === 0 && unix_bootstrap === 0) {
  cargo_output = rh.join(repo, "target-release");
}
let development_target = rh.join(repo, "target");
// `-Z build-std` and the dedicated-profile merges below need an explicit
// target even for a native build. Without one, Cargo can compile
// compiler_builtins with host-dependency semantics, leaving target
// intrinsics unresolved at the final link.
let explicit_target = target;
if (explicit_target === "") {
  const rustc_host = rh.command("rustc", ["-vV"], { cwd: repo, timeout_ms: 10000 });
  require(rustc_host.exit_code === 0, "build_rustc_host");
  for (const source_line of rustc_host.stdout.split("\n")) {
    const line = source_line.trim();
    if (line.startsWith("host: ")) {
      explicit_target = line.replaceAll("host: ", "").trim();
      break;
    }
  }
  require(explicit_target !== "", "build_rustc_host_missing");
  const explicit_facts = target_facts(explicit_target);
  require(explicit_facts.os !== "", "build_rustc_host_unsupported:" + explicit_target);
}
let profile_name = profile;
if (profile === "dev") { profile_name = "debug"; }
let cargo_profile_root = cargo_output;
if (target !== "") { cargo_profile_root = rh.join(cargo_output, target); }
const profile_directory = rh.join(cargo_profile_root, profile_name);

const identity = build_identity.facts(repo, profile);
let environment = build_identity.environment(identity);

let incremental_producer = 0;
let incremental_invocation = "";
let incremental_state = "";
let incremental_manifest = "";
let incremental_root = "";
let stable_wrapper = "";
if (profile === "dev" && action === "build" && external_target === 0 && cross_client === 0 && unix_bootstrap === 0) {
  if (rh.has_env("AGENTERM_BOOTSTRAP_CACHE_WORKER")) {
    const candidate = rh.absolute(rh.env_or("AGENTERM_BOOTSTRAP_CACHE_WORKER", ""));
    if (direct_file(candidate) !== 0) {
      stable_wrapper = candidate;
      incremental_invocation = "build-" + rh.pid() + "-" + rh.now_ms();
      incremental_root = rh.join(cargo_output, "debug/incremental");
      const state_parent = rh.join(cargo_output, "debug/.agenterm-incremental");
      incremental_state = rh.join(state_parent, incremental_invocation);
      require(!rh.exists(incremental_state), "build_incremental_state_collision");
      rh.create_dir_all(incremental_root);
      rh.create_dir_all(incremental_state);
      incremental_manifest = rh.join(incremental_state, "manifest.json");
      // RUSTC_WRAPPER deliberately names the stable bootstrap cache worker.
      // The per-run task copy must never enter Cargo's compiler identity or
      // turn a hot build into a rebuild.
      incremental_producer = 1;
      print("AgenTerm incremental root cleanup: producer_state=enabled, lane=native-windows-dev");
    } else {
      print("AgenTerm incremental root cleanup: producer_state=disabled, stable bootstrap cache worker is absent or indirect");
    }
  } else {
    print("AgenTerm incremental root cleanup: producer_state=disabled, AGENTERM_BOOTSTRAP_CACHE_WORKER is absent");
  }
} else {
  print("AgenTerm incremental root cleanup: producer_state=not-applicable, lane does not own stage-and-prune");
}

if (incremental_producer !== 0) {
  environment = build_identity.environment_with_incremental(
    identity,
    stable_wrapper,
    incremental_invocation,
    cargo_output,
    incremental_root,
    incremental_state
  );
} else if (external_target === 0 && profile === "release" && cross_client === 0 && unix_bootstrap === 0) {
  environment = build_identity.environment_with_cargo_target(identity, cargo_output);
}

// A live dev instance started from the profile directory holds its PE
// image open, so the cargo bin uplift fails with "failed to remove file
// ... (os error 5)" -- and the linker can hit the same image again through
// the deps\ hardlink twin (underscored stem). Reap unlocked parked
// copies, then park every top-level AgenTerm executable (any workspace
// bin can be the running one, not just shipped artifacts) plus its deps
// twin via a same-volume rename before cargo runs; launching the app
// must never block a rebuild.
if (action === "build" && cross_client === 0 && unix_bootstrap === 0) {
  const unlock_manifest_path = rh.join(repo, "scripts/artifacts.json");
  const output_directories = [profile_directory];
  for (const output_directory of output_directories) {
    const deps_directory = rh.join(output_directory, "deps");
    if (!rh.exists(output_directory)) { continue; }
    const _reaped = artifact_files.clean_locked(output_directory, unlock_manifest_path);
    if (rh.exists(deps_directory)) {
      const _deps_reaped = artifact_files.clean_locked(deps_directory, unlock_manifest_path);
    }
    for (const entry of rh.read_dir(output_directory)) {
      const name = "" + entry.name;
      if (entry.is_file && name.startsWith("agenterm") && name.endsWith(".exe") && !name.includes(".locked-")) {
        const _parked = artifact_files.unlock_output(output_directory, name);
        const twin = name.replaceAll("-", "_");
        const twin_path = rh.join(deps_directory, twin);
        if (rh.exists(twin_path)) {
          const _twin_parked = artifact_files.unlock_output(deps_directory, twin);
        }
      }
    }
  }
}

// `cargo xwin <action>` wraps both actions through the normal `cargo` driver.
// `cargo-zigbuild` is invoked as its own program instead, because its build
// action is named `zigbuild` and `cargo zigbuild clippy` is not a thing --
// only `cargo-zigbuild clippy` is.
//
// Clippy has to go through the wrapper too, even though it emits metadata
// rather than linking: `ring` compiles C in its build script, so a cross
// target still needs zig's `cc` in the environment. Plain `cargo clippy
// --target <linux>` from macOS fails at "failed to run custom build command
// for ring" -- measured, not assumed.
let cargo_program = "cargo";
const cargo_args = [];
if (driver === "cargo-xwin") {
  cargo_args.push("xwin");
  cargo_args.push(action);
} else if (driver === "cargo-zigbuild") {
  cargo_program = "cargo-zigbuild";
  if (action === "build") {
    cargo_args.push("zigbuild");
  } else {
    cargo_args.push(action);
  }
} else {
  cargo_args.push(action);
}
cargo_args.push("--locked");
if (profile === "release") {
  cargo_args.push("--release");
} else if (profile === "release-fast") {
  cargo_args.push("--profile");
  cargo_args.push("release-fast");
}
if (target !== "") {
  cargo_args.push("--target");
  if (glibc === "") {
    cargo_args.push(target);
  } else {
    cargo_args.push(target + "." + glibc);
  }
}
let executable_entries = [];
let library_entries = [];
if (cross_client !== 0 || unix_bootstrap !== 0) {
  executable_entries = platform_executables(repo, os_name, arch);
  library_entries = platform_libraries(repo, os_name, arch);
  cargo_args.push("--package");
  cargo_args.push("agenterm");
  cargo_args.push("--package");
  cargo_args.push("agenterm-cu");
  for (const executable of executable_entries) {
    const executable_name = "" + executable.name;
    cargo_args.push("--bin");
    cargo_args.push(cargo_binary(executable_name));
  }
} else {
  cargo_args.push("--package");
  cargo_args.push("agenterm");
  if (os_name === "windows") {
    cargo_args.push("--package");
    cargo_args.push("agenterm-cu");
  }
}
if (action === "clippy") {
  cargo_args.push("--");
  cargo_args.push("-D");
  cargo_args.push("warnings");
}

// cargo reports all progress and diagnostics on stderr. rh streamed it live
// interactively and captured it on CI; the door only captures, so it is
// replayed after the command in both cases.
const cargo_result = rh.command(cargo_program, cargo_args, { cwd: repo, env: environment, timeout_ms: 3600000 });
const cargo_code = cargo_result.exit_code === null ? -1 : cargo_result.exit_code;
if (cargo_code !== 0) {
  if (incremental_producer !== 0) { cleanup_incremental_state(incremental_state); }
  const cargo_failure_stdout = cargo_result.stdout.trim();
  if (cargo_failure_stdout !== "") { print(cargo_failure_stdout); }
  const failure_detail = cargo_result.stderr.trim();
  require(cargo_code === 0, "build_cargo:exit=" + cargo_code + ":" + failure_detail);
}
replay(cargo_result);

// libagenterm is a C ABI boundary and must retain unwind support. Build it
// under the dedicated ABI profile, then merge only the dynamic library into
// the normal profile directory consumed by staging and cross-platform
// packaging.
if (action === "build" && (os_name === "windows" || library_entries.length > 0)) {
  let abi_profile_name = "abi-release";
  if (profile === "dev") { abi_profile_name = "abi-dev"; }
  let abi_program = "cargo";
  const abi_args = [];
  if (driver === "cargo-xwin") {
    abi_args.push("xwin");
    abi_args.push("build");
  } else if (driver === "cargo-zigbuild") {
    abi_program = "cargo-zigbuild";
    abi_args.push("zigbuild");
  } else {
    abi_args.push("build");
  }
  abi_args.push("--locked");
  abi_args.push("--profile");
  abi_args.push(abi_profile_name);
  abi_args.push("--target");
  if (glibc === "") {
    abi_args.push(explicit_target);
  } else {
    abi_args.push(explicit_target + "." + glibc);
  }
  abi_args.push("--package");
  abi_args.push("agenterm-abi");
  // rh passed the identity keys and CARGO_TARGET_DIR here but not the
  // incremental-wrapper keys; the wrapper must not see the ABI build.
  let abi_environment = build_identity.environment(identity);
  if (environment.CARGO_TARGET_DIR !== undefined) {
    abi_environment = build_identity.environment_with_cargo_target(identity, environment.CARGO_TARGET_DIR);
  }
  const abi_output = rh.command(abi_program, abi_args, { cwd: repo, env: abi_environment, timeout_ms: 3600000 });
  require(abi_output.success, "build_abi_cargo:" + abi_output.stdout + abi_output.stderr);
  const abi_root = rh.join(cargo_output, explicit_target);
  const abi_directory = rh.join(abi_root, abi_profile_name);
  let abi_library_name = "agenterm.dll";
  if (os_name === "linux") {
    abi_library_name = "libagenterm.so";
  } else if (os_name === "macos") {
    abi_library_name = "libagenterm.dylib";
  }
  const abi_source = rh.join(abi_directory, abi_library_name);
  const abi_destination = rh.join(profile_directory, abi_library_name);
  require(direct_file(abi_source) !== 0, "build_abi_artifact_source:" + abi_source);
  rh.try_remove_file(abi_destination);
  require(rh.try_copy(abi_source, abi_destination) === 1, "build_abi_artifact_copy:" + abi_source);
  require(direct_file(abi_destination) !== 0, "build_abi_artifact_destination:" + abi_destination);
}

if (action === "build" && external_target === 0 && cross_client === 0) {
  let bootstrap_name = "agenterm";
  if (os_name === "windows") { bootstrap_name = "agenterm.exe"; }
  const promoted_worker = rh.join(profile_directory, bootstrap_name);
  const promoted = promote_bootstrap_worker(repo, promoted_worker, bootstrap_name);
  // The LKG may only be old enough to seed the current source. Once the
  // candidate proves its entry, use that engine for every remaining nested
  // task so new task syntax/API never falls back mid-build.
  //
  // Adopt it only when the file is actually there. Without the bootstrap
  // cache environment promote_bootstrap_worker is a no-op that validates
  // nothing, so its return value alone cannot vouch for the path.
  const _promoted = promoted;
  if (direct_file(promoted_worker) !== 0) { worker = promoted_worker; }
}

if (action === "clippy") {
  if (target !== "") {
    print("PASS client Clippy " + os_name + "-" + arch + " (" + target + ")");
  } else {
    print("PASS client Clippy " + os_name + "-" + arch);
  }
  return 0;
}
if (cross_client !== 0 || unix_bootstrap !== 0) {
  print("");
  print("Built client artifacts [" + profile + ", " + os_name + "-" + arch + "]:");
  for (const executable of executable_entries) {
    print("  " + rh.join(profile_directory, executable.name));
  }
  for (const library of library_entries) {
    print("  " + rh.join(profile_directory, library.name));
  }
  return 0;
}

const stage_result = rh.command(
  worker,
  task_arguments("stage-build", task_manifest, [repo, profile_directory, dist, profile]),
  { cwd: repo, env: environment, timeout_ms: 30000 }
);
const stage_code = stage_result.exit_code === null ? -1 : stage_result.exit_code;
const stage_stdout = stage_result.stdout;
const stage_stderr = stage_result.stderr;
if (stage_stdout !== "") { print(stage_stdout); }
if (stage_stderr !== "") { print(stage_stderr); }
if (stage_code !== 0) {
  if (incremental_producer !== 0) { cleanup_incremental_state(incremental_state); }
  require(stage_code === 0, "build_stage:" + stage_stdout + stage_stderr);
}

if (profile === "dev" && external_target === 0) {
  let dev_cleanup_failed = 0;
  let dev_cleanup_error = "";
  if (incremental_producer !== 0) {
    const finalize_code = rh.command_status(
      stable_wrapper,
      [
        "--internal-incremental-finalize",
        incremental_state,
        cargo_output,
        incremental_manifest,
        incremental_invocation
      ],
      { cwd: repo, env: environment, timeout_ms: 300000 }
    );
    if (finalize_code !== 0) {
      dev_cleanup_failed = 1;
      dev_cleanup_error = "finalize:exit=" + finalize_code;
    }
  }
  repo = repo_dir(repo_arg);
  task_manifest = rh.join(repo, "agenterm.tasks.json");
  const prune_task_args = [repo, cargo_output];
  if (incremental_producer !== 0) {
    prune_task_args.push("--manifest");
    prune_task_args.push(incremental_manifest);
    prune_task_args.push("--invocation");
    prune_task_args.push(incremental_invocation);
  }
  if (dev_cleanup_failed === 0) {
    const prune = rh.command(
      worker,
      task_arguments("prune-target-incremental", task_manifest, prune_task_args),
      { cwd: repo, env: environment, timeout_ms: 300000 }
    );
    const prune_code = prune.exit_code === null ? -1 : prune.exit_code;
    if (prune_code !== 0) {
      dev_cleanup_failed = 1;
      dev_cleanup_error = "prune:exit=" + prune_code + ":" + prune.stdout.trim();
    }
  }
  if (dev_cleanup_failed !== 0) {
    if (incremental_producer !== 0) { cleanup_incremental_state(incremental_state); }
    require(dev_cleanup_failed === 0, "build_incremental_prune:" + dev_cleanup_error);
  }
  if (incremental_producer !== 0) { cleanup_incremental_state(incremental_state); }
}

// The default release-fast lane stages without the dev-only incremental
// producer, but its debug/ and release-fast/ incremental caches grow the
// same way. Prune stale fingerprint generations on every native build so
// target/ stops growing between explicit dev builds.
if (profile === "release-fast" && external_target === 0) {
  const fast_repo = repo_dir(repo_arg);
  const fast_manifest = rh.join(fast_repo, "agenterm.tasks.json");
  const fast_prune = rh.command(
    worker,
    task_arguments("prune-target-incremental", fast_manifest, [fast_repo, cargo_output]),
    { cwd: fast_repo, env: environment, timeout_ms: 300000 }
  );
  const fast_prune_code = fast_prune.exit_code === null ? -1 : fast_prune.exit_code;
  if (fast_prune_code !== 0) {
    const fast_cleanup_error = "prune:exit=" + fast_prune_code + ":" + fast_prune.stdout.trim();
    print("WARNING: release-fast incremental prune skipped (" + fast_cleanup_error + ")");
  }
}

if (profile === "release" && external_target === 0) {
  repo = repo_dir(repo_arg);
  task_manifest = rh.join(repo, "agenterm.tasks.json");
  cargo_output = rh.join(repo, "target-release");
  development_target = rh.join(repo, "target");
  // This block cleans BOTH target trees, and `worker` lives inside one of
  // them (target-release/release/agenterm.exe after the promotion above,
  // or target/debug/agenterm.exe when bootstrapped). `cargo clean` then
  // deletes the binary that the remaining stages still have to spawn.
  // Run the cleanup stages from a copy parked outside both trees.
  const cleanup_worker = repo + ".build-cleanup-worker.tmp.exe";
  rh.try_remove_file(cleanup_worker);
  rh.copy(worker, cleanup_worker);
  require(rh.exists(cleanup_worker), "build_cleanup_worker_missing");
  worker = cleanup_worker;

  const report = rh.command(
    worker,
    task_arguments("target-report", task_manifest, [cargo_output]),
    { cwd: repo, env: environment, timeout_ms: 30000 }
  );
  require(report.exit_code === 0, "build_target_report");
  const report_stdout = report.stdout.trim();
  if (report_stdout !== "") { print(report_stdout); }

  const prepare = rh.command(
    worker,
    task_arguments("prepare-target-clean", task_manifest, [repo, cargo_output]),
    { cwd: repo, env: environment, timeout_ms: 30000 }
  );
  require(prepare.exit_code === 0, "build_target_clean_prepare");
  const prepare_stdout = prepare.stdout.trim();
  if (prepare_stdout !== "") { print(prepare_stdout); }

  const clean = rh.command(
    "cargo",
    ["clean", "--target-dir", cargo_output],
    { cwd: repo, env: environment, timeout_ms: 3600000 }
  );
  require(clean.exit_code === 0, "build_target_clean");
  const clean_stdout = clean.stdout.trim();
  if (clean_stdout !== "") { print(clean_stdout); }

  const dev_report = rh.command(
    worker,
    task_arguments("target-report", task_manifest, [development_target]),
    { cwd: repo, env: environment, timeout_ms: 30000 }
  );
  require(dev_report.exit_code === 0, "build_development_target_report");
  const dev_report_stdout = dev_report.stdout.trim();
  if (dev_report_stdout !== "") { print(dev_report_stdout); }

  const dev_prepare = rh.command(
    worker,
    task_arguments("prepare-target-clean", task_manifest, [repo, development_target]),
    { cwd: repo, env: environment, timeout_ms: 30000 }
  );
  require(dev_prepare.exit_code === 0, "build_development_target_clean_prepare");
  const dev_prepare_stdout = dev_prepare.stdout.trim();
  if (dev_prepare_stdout !== "") { print(dev_prepare_stdout); }

  const dev_clean = rh.command(
    "cargo",
    ["clean", "--target-dir", development_target],
    { cwd: repo, env: environment, timeout_ms: 3600000 }
  );
  require(dev_clean.exit_code === 0, "build_development_target_clean");
  const dev_clean_stdout = dev_clean.stdout.trim();
  if (dev_clean_stdout !== "") { print(dev_clean_stdout); }
  rh.try_remove_file(worker);
}

print("");
print("Built and staged Windows artifacts [" + profile + "] in " + dist);
return 0;
