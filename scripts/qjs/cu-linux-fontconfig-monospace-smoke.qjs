// CEO: Linux fontconfig monospace discovery with independent fc-match/fc-list
// read-back. Acceptance is smoke read-back only: CU font-discovery must agree
// with independent `fc-match monospace` and `fc-list :spacing=mono` probes or
// declare a typed hardcoded fallback. Typed font-discovery usage must reject
// AT-SPI --name, --coords, --bogus, and other unexpected arguments; typed
// get-extents --name usage AND host-limit paths must both hold before the
// fontconfig read-back court. Prefer host-limit clarity over fake success.
// AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-fontconfig-monospace",
];

const AT_SPI_PROBE_NAME = "Fontconfig Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_font_discovery_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "font-discovery" || text_at(reply, "command") === "usage",
    "cu_linux_font_discovery_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_font_discovery_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_font_discovery_usage_limit(run_directory, executable, env) {
  const with_name = run_cu_reply(run_directory, executable, [
    "font-discovery", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(with_name),
    "cu_linux_font_discovery_usage_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_font_discovery_usage_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_font_discovery_usage_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_name, "error.message"), "--name")
      || text_at(with_name, "error.message").indexOf("no arguments") >= 0,
    "cu_linux_font_discovery_usage_name_message:" + JSON.stringify(with_name.error)
  );

  const grouped_with_name = run_cu_reply(run_directory, executable, [
    "font", "discovery", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_font_discovery_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_font_discovery_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_name, "error.message"), "--name")
      || text_at(grouped_with_name, "error.message").indexOf("no arguments") >= 0,
    "cu_linux_font_discovery_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, ["font-discovery", "--bogus"], env);
  ensure(!output_success(with_bogus),
    "cu_linux_font_discovery_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_font_discovery_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_font_discovery_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus")
      || text_at(with_bogus, "error.message").indexOf("no arguments") >= 0,
    "cu_linux_font_discovery_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const grouped_with_bogus = run_cu_reply(run_directory, executable, [
    "font", "discovery", "--bogus",
  ], env);
  ensure(!output_success(grouped_with_bogus),
    "cu_linux_font_discovery_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_font_discovery_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    text_at(grouped_with_bogus, "command") === "usage",
    "cu_linux_font_discovery_usage_grouped_bogus_command:" + JSON.stringify(grouped_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_bogus, "error.message"), "--bogus")
      || text_at(grouped_with_bogus, "error.message").indexOf("no arguments") >= 0,
    "cu_linux_font_discovery_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const with_coords = run_cu_reply(run_directory, executable, [
    "font-discovery", "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords),
    "cu_linux_font_discovery_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_font_discovery_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_font_discovery_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords")
      || text_at(with_coords, "error.message").indexOf("no arguments") >= 0,
    "cu_linux_font_discovery_usage_coords_message:" + JSON.stringify(with_coords.error)
  );

  const grouped_with_coords = run_cu_reply(run_directory, executable, [
    "font", "discovery", "--coords", "10,10",
  ], env);
  ensure(!output_success(grouped_with_coords),
    "cu_linux_font_discovery_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_font_discovery_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    text_at(grouped_with_coords, "command") === "usage",
    "cu_linux_font_discovery_usage_grouped_coords_command:" + JSON.stringify(grouped_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_coords, "error.message"), "--coords")
      || text_at(grouped_with_coords, "error.message").indexOf("no arguments") >= 0,
    "cu_linux_font_discovery_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_font_discovery_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_font_discovery_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_font_discovery_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_font_discovery_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_font_discovery_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_font_discovery_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_font_discovery_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_font_discovery_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_font_discovery_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_font_discovery_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_font_discovery_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_font_discovery_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_font_discovery_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_font_discovery_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_font_discovery_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_name_miss(run_directory, executable, env) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(reply),
    "cu_linux_font_discovery_extents_miss_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_node_not_found" || code === "bad_handle" || code === "a11y_backend_failed",
    "cu_linux_font_discovery_extents_miss_code:" + code
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_font_discovery_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_font_discovery_extents_unavailable_code:" + code
  );
}

function invoke(run_directory, executable, arguments, expect_success, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(
    output.success === expect_success || (expect_success !== true && output.exit_code === 1),
    "cu_linux_font_discovery_exit:" + output.exit_code + ":" + output.stdout + output.stderr
  );
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_font_discovery_empty:" + output.stderr);
  const reply = JSON.parse(trimmed);
  ensure(reply.ok === expect_success, "cu_linux_font_discovery_reply_state:" + JSON.stringify(reply));
  ensure(text_at(reply, "command") === "font-discovery",
         "cu_linux_font_discovery_identity:" + JSON.stringify(reply));
  return reply;
}

function independent_fc_match() {
  const output = rh.command("fc-match", [
    "-f", "%{family}\n%{file}\n", "monospace",
  ], { timeout_ms: 15000 });
  if (!output.success) {
    return { available: false, family: "", file: "" };
  }
  const lines = output.stdout.split("\n");
  const family = (lines[0] || "").trim();
  const file = (lines[1] || "").trim();
  if (family === "" || file === "") {
    return { available: false, family: "", file: "" };
  }
  if (!rh.exists(file)) {
    return { available: false, family: family, file: file };
  }
  return { available: true, family: family, file: file };
}

function independent_fc_list() {
  const output = rh.command("fc-list", [
    ":spacing=mono", "family", "file",
  ], { timeout_ms: 15000 });
  if (!output.success) {
    return { available: false, entries: [] };
  }
  const entries = [];
  for (const line of output.stdout.split("\n")) {
    const trimmed = line.trim();
    if (trimmed === "") { continue; }
    const colon = trimmed.indexOf(": ");
    if (colon < 0) { continue; }
    const file = trimmed.slice(0, colon).trim();
    const family = trimmed.slice(colon + 2).trim();
    if (file !== "" && family !== "" && rh.exists(file)) {
      entries.push({ family: family, file: file });
    }
  }
  return { available: entries.length > 0, entries: entries };
}

function fc_list_contains(list, family, file) {
  for (const entry of list.entries) {
    if (entry.family === family && entry.file === file) { return true; }
  }
  return false;
}

function fc_list_has_family(list, family) {
  for (const entry of list.entries) {
    if (entry.family === family) { return true; }
  }
  return false;
}

function assert_fontconfig_independent_evidence(fc, list) {
  if (fc.available) {
    ensure(list.available,
      "cu_linux_font_discovery_fc_list_unavailable_while_fc_match_ok");
    ensure(fc_list_contains(list, fc.family, fc.file),
      "cu_linux_font_discovery_fc_list_primary_missing:fc=" + fc.family
        + ":" + fc.file);
  }
}

function assert_ok_readback(fc, list, reply) {
  const data = reply.data;
  const source = text_at(data, "source");
  ensure(
    source === "fontconfig"
      || source === "hardcoded-fallback"
      || source === "unavailable",
    "cu_linux_font_discovery_source:" + source
  );

  if (fc.available) {
    ensure(source === "fontconfig", "cu_linux_font_discovery_expected_fontconfig:" + source);
    ensure(text_at(data, "primary_family") === fc.family,
           "cu_linux_font_discovery_family_mismatch:cu=" + text_at(data, "primary_family")
             + ":fc=" + fc.family);
    ensure(text_at(data, "primary_path") === fc.file,
           "cu_linux_font_discovery_path_mismatch:cu=" + text_at(data, "primary_path")
             + ":fc=" + fc.file);
    ensure(text_at(data, "fontconfig.family") === fc.family,
           "cu_linux_font_discovery_fontconfig_family_mismatch");
    ensure(text_at(data, "fontconfig.file") === fc.file,
           "cu_linux_font_discovery_fontconfig_file_mismatch");
    ensure(fc_list_contains(list, fc.family, fc.file),
           "cu_linux_font_discovery_fc_list_readback_missing:" + fc.family);
  } else if (source === "hardcoded-fallback") {
    const primary_path = text_at(data, "primary_path");
    ensure(primary_path !== "" && rh.exists(primary_path),
           "cu_linux_font_discovery_fallback_path_missing:" + primary_path);
    const alternatives = data.alternatives;
    ensure(Array.isArray(alternatives),
           "cu_linux_font_discovery_alternatives_shape");
    if (list.available) {
      for (const alt of alternatives) {
        ensure(fc_list_has_family(list, "" + alt),
               "cu_linux_font_discovery_fallback_alt_not_in_fc_list:" + alt);
      }
    }
  } else {
    ensure(source === "unavailable",
           "cu_linux_font_discovery_unexpected_unavailable:" + source);
  }
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(rh.exists(executable), "cu_linux_font_discovery_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-fontconfig-monospace");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
try {
  print("STEP font-discovery typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_font_discovery_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before fontconfig read-back court");
  assert_get_extents_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before fontconfig read-back court");
  assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);

  if (atspi_available) {
    print("STEP get-extents typed-fail miss when anchor name is absent from the desktop before fontconfig read-back court");
    assert_get_extents_name_miss(context.run_directory, executable, env);
  } else {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; font-discovery read-back still uses fc-match/fc-list");
  }

  print("STEP independent fc-match monospace captures fontconfig facts");
  const fc = independent_fc_match();
  print("STEP independent fc-list :spacing=mono captures installed monospace inventory");
  const list = independent_fc_list();
  assert_fontconfig_independent_evidence(fc, list);

  print("STEP font-discovery observe returns explicit source and primary face");
  const reply = invoke(context.run_directory, executable, ["font-discovery"], true, env);
  ensure(reply.target === "current", "cu_linux_font_discovery_target");
  assert_ok_readback(fc, list, reply);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-fontconfig-monospace");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux font-discovery matches independent fc-match/fc-list monospace read-back with typed font-discovery --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux font-discovery matches independent fc-match/fc-list monospace read-back with typed font-discovery --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
