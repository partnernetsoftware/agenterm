// CEO: Linux file-inspect honesty with independent os.lstat read-back.
// Acceptance is smoke read-back only: CU file-inspect must agree with size,
// unix mode, modified time, kind and inode identity derived outside agenterm-cu
// for a regular file, directory and final symlink. Typed file-inspect usage must
// reject AT-SPI --name, --coords, --bogus, and other unexpected arguments; typed
// get-extents --name usage AND host-limit paths must both hold before the os.lstat
// read-back court. Prefer host-limit clarity over fake success. AT-SPI/--name only;
// no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-file-inspect-readback",
];

const AT_SPI_PROBE_NAME = "File Inspect Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function file_inspect_usage_rejects(message, token) {
  return usage_rejects_unexpected(message, token)
    || message.indexOf("exactly one") >= 0;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_file_inspect_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "file-inspect" || text_at(reply, "command") === "usage",
    "cu_linux_file_inspect_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_file_inspect_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_file_inspect_usage_limit(run_directory, executable, env, probe_path) {
  const flat_with_name = run_cu_reply(run_directory, executable, [
    "file-inspect", probe_path, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(flat_with_name),
    "cu_linux_file_inspect_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_file_inspect_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_file_inspect_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    file_inspect_usage_rejects(text_at(flat_with_name, "error.message"), "--name"),
    "cu_linux_file_inspect_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = run_cu_reply(run_directory, executable, [
    "file", "inspect", probe_path, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(grouped_with_name),
    "cu_linux_file_inspect_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_file_inspect_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    file_inspect_usage_rejects(text_at(grouped_with_name, "error.message"), "--name"),
    "cu_linux_file_inspect_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const flat_with_bogus = run_cu_reply(run_directory, executable, [
    "file-inspect", probe_path, "--bogus",
  ], env);
  ensure(!rh.output_success(flat_with_bogus),
    "cu_linux_file_inspect_usage_flat_bogus_ok:" + JSON.stringify(flat_with_bogus));
  ensure(
    text_at(flat_with_bogus, "error.code") === "usage",
    "cu_linux_file_inspect_usage_flat_bogus_code:" + JSON.stringify(flat_with_bogus.error)
  );
  ensure(
    text_at(flat_with_bogus, "command") === "usage",
    "cu_linux_file_inspect_usage_flat_bogus_command:" + JSON.stringify(flat_with_bogus)
  );
  ensure(
    file_inspect_usage_rejects(text_at(flat_with_bogus, "error.message"), "--bogus"),
    "cu_linux_file_inspect_usage_flat_bogus_message:" + JSON.stringify(flat_with_bogus.error)
  );

  const grouped_with_bogus = run_cu_reply(run_directory, executable, [
    "file", "inspect", probe_path, "--bogus",
  ], env);
  ensure(!rh.output_success(grouped_with_bogus),
    "cu_linux_file_inspect_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_file_inspect_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    text_at(grouped_with_bogus, "command") === "usage",
    "cu_linux_file_inspect_usage_grouped_bogus_command:" + JSON.stringify(grouped_with_bogus)
  );
  ensure(
    file_inspect_usage_rejects(text_at(grouped_with_bogus, "error.message"), "--bogus"),
    "cu_linux_file_inspect_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const flat_with_coords = run_cu_reply(run_directory, executable, [
    "file-inspect", probe_path, "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(flat_with_coords),
    "cu_linux_file_inspect_usage_flat_coords_ok:" + JSON.stringify(flat_with_coords));
  ensure(
    text_at(flat_with_coords, "error.code") === "usage",
    "cu_linux_file_inspect_usage_flat_coords_code:" + JSON.stringify(flat_with_coords.error)
  );
  ensure(
    text_at(flat_with_coords, "command") === "usage",
    "cu_linux_file_inspect_usage_flat_coords_command:" + JSON.stringify(flat_with_coords)
  );
  ensure(
    file_inspect_usage_rejects(text_at(flat_with_coords, "error.message"), "--coords"),
    "cu_linux_file_inspect_usage_flat_coords_message:" + JSON.stringify(flat_with_coords.error)
  );

  const grouped_with_coords = run_cu_reply(run_directory, executable, [
    "file", "inspect", probe_path, "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(grouped_with_coords),
    "cu_linux_file_inspect_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_file_inspect_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    text_at(grouped_with_coords, "command") === "usage",
    "cu_linux_file_inspect_usage_grouped_coords_command:" + JSON.stringify(grouped_with_coords)
  );
  ensure(
    file_inspect_usage_rejects(text_at(grouped_with_coords, "error.message"), "--coords"),
    "cu_linux_file_inspect_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_file_inspect_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_file_inspect_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_file_inspect_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_file_inspect_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_file_inspect_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_file_inspect_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_inspect_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_file_inspect_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_file_inspect_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_file_inspect_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_inspect_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_file_inspect_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_file_inspect_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_file_inspect_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_inspect_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_file_inspect_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_file_inspect_extents_unavailable_code:" + code
  );
}

function verify_readback(run_directory, executable, env) {
  const script = [
    "import json, os, shutil, stat, subprocess, sys",
    "from pathlib import Path",
    "root = Path(sys.argv[1])",
    "cu = sys.argv[2]",
    "fixture = root / 'file-inspect-readback-fixture'",
    "file_path = fixture / 'item.txt'",
    "dir_path = fixture / 'subdir'",
    "link_path = fixture / 'link'",
    "target_path = fixture / 'target.txt'",
    "def kind_from_mode(mode):",
    "    if stat.S_ISLNK(mode):",
    "        return 'link-like'",
    "    if stat.S_ISDIR(mode):",
    "        return 'directory'",
    "    if stat.S_ISREG(mode):",
    "        return 'file'",
    "    return 'other'",
    "def expected_identity(st, kind):",
    "    if kind == 'link-like':",
    "        return ('token', f'unix:{st.st_dev:x}:{st.st_ino:x}')",
    "    return ('opened', str(st.st_dev), str(st.st_ino))",
    "def assert_entry(path):",
    "    st = os.lstat(path)",
    "    kind = kind_from_mode(st.st_mode)",
    "    out = subprocess.check_output(",
    "        [cu, '--target', 'current', '--grant', 'observe', 'file-inspect', str(path)],",
    "        text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok') or reply.get('command') != 'file-inspect':",
    "        raise SystemExit('cu_linux_file_inspect_reply_state:' + path)",
    "    data = reply['data']",
    "    if data.get('followed_final_link') is not False:",
    "        raise SystemExit('cu_linux_file_inspect_followed:' + path)",
    "    if data.get('kind') != kind:",
    "        raise SystemExit(f'cu_linux_file_inspect_kind:{path}:cu={data.get(\"kind\")}:lstat={kind}')",
    "    if data.get('size_bytes') != str(st.st_size):",
    "        raise SystemExit(f'cu_linux_file_inspect_size:{path}:cu={data.get(\"size_bytes\")}:lstat={st.st_size}')",
    "    if data.get('unix_mode') != format(st.st_mode, 'o'):",
    "        raise SystemExit(f'cu_linux_file_inspect_mode:{path}:cu={data.get(\"unix_mode\")}:lstat={format(st.st_mode, \"o\")}')",
    "    if int(data.get('modified_unix_ns', '-1')) != st.st_mtime_ns:",
    "        raise SystemExit(f'cu_linux_file_inspect_mtime:{path}:cu={data.get(\"modified_unix_ns\")}:lstat={st.st_mtime_ns}')",
    "    identity = data.get('identity') or {}",
    "    if identity.get('available') is not True:",
    "        raise SystemExit('cu_linux_file_inspect_identity_unavailable:' + path)",
    "    expected = expected_identity(st, kind)",
    "    if expected[0] == 'token':",
    "        if identity.get('scope') != 'final-entry-metadata' or identity.get('token') != expected[1]:",
    "            raise SystemExit(f'cu_linux_file_inspect_identity:{path}:cu={identity}:expected_token={expected[1]}')",
    "    else:",
    "        if identity.get('scope') != 'opened-object':",
    "            raise SystemExit('cu_linux_file_inspect_identity_scope:' + path)",
    "        if identity.get('filesystem_id') != expected[1] or identity.get('object_id') != expected[2]:",
    "            raise SystemExit(f'cu_linux_file_inspect_identity:{path}:cu={identity}:expected_fs={expected[1]}:expected_ino={expected[2]}')",
    "    print(path, kind, data['size_bytes'], data['unix_mode'])",
    "fixture.mkdir(parents=True, exist_ok=True)",
    "file_path.write_text('file-inspect-readback', encoding='utf-8')",
    "dir_path.mkdir()",
    "target_path.write_text('link-target', encoding='utf-8')",
    "os.symlink(str(target_path), str(link_path))",
    "try:",
    "    assert_entry(file_path)",
    "    assert_entry(dir_path)",
    "    assert_entry(link_path)",
    "finally:",
    "    shutil.rmtree(fixture, ignore_errors=True)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, run_directory, executable], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_file_inspect_readback:" + output.stderr + output.stdout);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-file-inspect");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
const probe_path = rh.join(context.run_directory, "usage-probe.txt");
rh.write_text(probe_path, "file-inspect-usage-probe");
let succeeded = 0;
let failure = "";
try {
  print("STEP file-inspect typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_file_inspect_usage_limit(context.run_directory, executable, env, probe_path);

  if (atspi_available) {
    print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before os.lstat read-back court");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP file-inspect observe matches independent os.lstat size/mode/mtime/kind/inode read-back");
  verify_readback(context.run_directory, executable, env);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-file-inspect-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux file-inspect matches independent os.lstat size/mode/mtime/kind/inode read-back with typed file-inspect --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux file-inspect matches independent os.lstat size/mode/mtime/kind/inode read-back with typed file-inspect --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
