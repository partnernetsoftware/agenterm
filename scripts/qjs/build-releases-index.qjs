// Derive machine-readable releases.json from one sealed Candidate.
//
// Pure index: every field is copied or mapped from the candidate-manifest
// and per-archive .provenance.json companions.  No second release truth.
//
// Args: CANDIDATE_MANIFEST ASSET_DIRECTORY OUTPUT_JSON
// Ported from scripts/rh/build-releases-index.rh; runs under `--profile tool`.
import * as rh from "lib/rh_compat";

// Reading a property of `undefined` traps in this engine and the trap is not
// catchable, so an optional sub-object is read through this: absent reads as
// an empty object and the field checks that follow fail (or default) by name.
function child(value, key) {
  if (typeof value !== "object" || value === null) { return {}; }
  const inner = value[key];
  if (typeof inner !== "object" || inner === null) { return {}; }
  return inner;
}

// rh's `type_of(x) == "map"` / `"array"`, over `Array.isArray` (tinyvm
// `12cfdfe`).
function is_map(value) {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function is_array(value) {
  return Array.isArray(value);
}

const args = rh.args();
if (args.length === 1 && (args[0] === "--help" || args[0] === "-h")) {
  print("usage: build-releases-index CANDIDATE_MANIFEST ASSET_DIRECTORY OUTPUT_JSON");
  return 0;
}
if (args.length !== 3) {
  throw "releases_index_arguments: expected CANDIDATE_MANIFEST ASSET_DIRECTORY OUTPUT_JSON";
}

const manifest_path = rh.absolute(args[0]);
const asset_root = rh.absolute(args[1]);
const output_path = rh.absolute(args[2]);
rh.require(
  rh.exists(manifest_path) && rh.metadata(manifest_path).is_file,
  "releases_index_manifest_missing"
);
rh.require(
  rh.exists(asset_root) && rh.metadata(asset_root).is_dir,
  "releases_index_assets_missing"
);

const manifest = rh.parse_file(manifest_path);
rh.require(
  manifest.schema_version === 1
    && manifest.product === "AgenTerm"
    && is_array(manifest.assets)
    && manifest.assets.length > 0
    && manifest.version !== ""
    && manifest.expected_tag === "v" + manifest.version
    && manifest.source_sha !== "",
  "releases_index_manifest"
);

const artifacts = [];
let artifact_count = 0;
let has_stable = false;
let has_preview = false;
for (const asset of manifest.assets) {
  const asset_name = "" + asset.name;
  const asset_os = "" + asset.os;
  const asset_arch = "" + asset.arch;
  const channel = "" + asset.channel;
  const asset_sha = "" + asset.sha256;
  const asset_provenance = child(asset, "provenance");
  const provenance_name = "" + asset_provenance.name;
  const asset_prov_sha = "" + asset_provenance.sha256;
  rh.require(
    asset_name !== ""
      && asset_os !== ""
      && asset_arch !== ""
      && channel !== ""
      && asset_sha !== ""
      && is_map(asset.provenance)
      && provenance_name !== ""
      && asset_prov_sha !== "",
    "releases_index_asset:" + asset_name
  );
  let distribution = "";
  let variant = "";
  if (channel === "macos-unsigned-preview") {
    distribution = "preview";
    variant = "unsigned-preview";
  } else if (channel === "release") {
    distribution = "stable";
    variant = "release";
  } else {
    throw "releases_index_unknown_channel:" + channel;
  }
  if (distribution === "stable") { has_stable = true; }
  if (distribution === "preview") { has_preview = true; }

  const provenance_path = asset_root + "/" + provenance_name;
  rh.require(
    rh.exists(provenance_path) && rh.metadata(provenance_path).is_file,
    "releases_index_provenance_missing:" + provenance_name
  );
  const provenance_hash = rh.sha256_file(provenance_path);
  rh.require(provenance_hash === asset_prov_sha, "releases_index_provenance_hash:" + provenance_name);
  const provenance = rh.parse_file(provenance_path);
  // Force string compares: bare JSON==JSON emits integer paths.
  const provenance_version = "" + provenance.version;
  const manifest_version = "" + manifest.version;
  const provenance_artifact = "" + provenance.artifact;
  const provenance_sha = "" + provenance.sha256;
  const provenance_os = "" + provenance.os;
  const provenance_arch = "" + provenance.arch;
  const provenance_channel = "" + provenance.channel;
  const provenance_commit = "" + provenance.source_commit;
  const manifest_source_sha = "" + manifest.source_sha;
  const provenance_tag = "" + provenance.source_tag;
  const expected_tag = "" + manifest.expected_tag;
  rh.require(
    provenance.schema_version === 1
      && provenance.product === "AgenTerm"
      && provenance_version === manifest_version
      && provenance_artifact === asset_name
      && provenance_sha === asset_sha
      && provenance_os === asset_os
      && provenance_arch === asset_arch
      && provenance_channel === channel
      && provenance.signed === asset.signed
      && provenance.notarized === asset.notarized
      && provenance_commit === manifest_source_sha
      && provenance_tag === expected_tag,
    "releases_index_provenance_mismatch:" + asset_name
  );

  // Optional JSON fields: absent reads as `undefined` here (rh's "()").
  const asset_checksum = child(asset, "checksum");
  let checksum_name = asset_name + ".sha256";
  if (typeof asset_checksum.name === "string") {
    const declared_name = "" + asset_checksum.name;
    if (declared_name !== "") { checksum_name = declared_name; }
  }
  let checksum_sha = "";
  if (typeof asset_checksum.sha256 === "string") { checksum_sha = "" + asset_checksum.sha256; }
  let sbom_sha256 = "";
  if (typeof provenance.sbom_sha256 === "string") { sbom_sha256 = "" + provenance.sbom_sha256; }
  let build_log = "";
  if (typeof provenance.build_log === "string") { build_log = "" + provenance.build_log; }

  artifacts.push({
    os: asset.os,
    arch: asset.arch,
    variant: variant,
    channel: channel,
    distribution: distribution,
    name: asset_name,
    sha256: asset.sha256,
    size: asset.size,
    signed: asset.signed,
    notarized: asset.notarized,
    provenance: { name: provenance_name, sha256: asset_provenance.sha256 },
    checksum: { name: checksum_name, sha256: checksum_sha },
    source_commit: provenance.source_commit,
    source_tag: provenance.source_tag,
    sbom_sha256: sbom_sha256,
    build_log: build_log
  });
  artifact_count = artifact_count + 1;
}

rh.require(artifact_count === manifest.assets.length, "releases_index_artifact_count");

const channel_ptr = {
  version: manifest.version,
  tag: manifest.expected_tag,
  source_commit: manifest.source_sha
};

const release_entry = {
  version: manifest.version,
  tag: manifest.expected_tag,
  source_commit: manifest.source_sha,
  artifacts: artifacts
};

const releases = [];
releases.push(release_entry);

const manifest_sha256 = rh.sha256_file(manifest_path);
const source_block = {
  kind: "agenterm-release-candidate",
  source_sha: manifest.source_sha,
  version: manifest.version,
  tag: manifest.expected_tag,
  candidate_run_id: child(manifest, "run").id,
  candidate_run_attempt: child(manifest, "run").attempt,
  manifest_sha256: manifest_sha256
};

let channel_layout = 0;
if (has_stable) { channel_layout = channel_layout + 1; }
if (has_preview) { channel_layout = channel_layout + 2; }
rh.require(channel_layout !== 0, "releases_index_empty_channels");

let channels = {};
if (channel_layout === 3) { channels = { stable: channel_ptr, preview: channel_ptr }; }
if (channel_layout === 1) { channels = { stable: channel_ptr }; }
if (channel_layout === 2) { channels = { preview: channel_ptr }; }
const index = {
  schema_version: 1,
  kind: "agenterm-releases-index",
  product: "AgenTerm",
  source: source_block,
  channels: channels,
  releases: releases
};
const index_text = rh.stringify_pretty(index) + "\n";

rh.atomic_write(output_path, index_text);

const expected_tag = "" + manifest.expected_tag;
print("RELEASES_INDEX " + expected_tag + " artifacts=" + artifact_count + " " + output_path);
return;
