// CEO: Linux tree honesty with independent pyatspi BFS read-back.
// Acceptance is smoke read-back only: CU tree --flat node names/roles/states
// for one owned GTK fixture window must agree with an independent AT-SPI dump
// of the same application walk (BFS order, matching depth/node budget, volatile
// focus/active/armed/selected states excluded). Typed tree/elements --name/
// --coords/--bogus uses usage_rejects_unexpected + command=usage or an honest
// non-usage typed failure (never fake command=usage). Typed get-extents --name
// usage AND host-limit courts must both hold before process-state, desktop-state,
// and the tree observe/read-back court (no if/else gating those courts on
// atspi_available); get-extents --coords/--bogus must reject as command=usage.
// process-state and desktop-state fixture binding courts must hold before
// observe/read-back. Typed usage and AT-SPI host-limit paths must hold when the
// independent pyatspi desktop probe is unavailable. Prefer host-limit clarity
// over fake success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-tree-honesty",
];

const TREE_DEPTH = 6;
const MAX_NODES = 300;
const AT_SPI_PROBE_NAME = "Fixture Entry";
const NAMED_FIXTURE_NODES = [
  AT_SPI_PROBE_NAME,
  "Fixture Press",
  "Fixture Check",
];
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function last_json_line(text) {
  const lines = text.trim().split("\n");
  for (let index = lines.length - 1; index >= 0; index = index - 1) {
    const line = lines[index].trim();
    if (line !== "") { return JSON.parse(line); }
  }
  throw "cu_linux_tree_honesty_missing_json";
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_tree_honesty_cli:" + output.stdout + output.stderr);
  return last_json_line(output.stdout);
}

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_tree_honesty_reply:" + JSON.stringify(document));
  return document;
}

function output_success(document) { return flag_at(document, "ok"); }

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_tree_honesty_extents_cli:" + output.stderr);
  return last_json_line(output.stdout);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function honest_non_usage_code(code) {
  return code === "a11y_backend_failed"
    || code === "unsupported"
    || code === "bad_handle"
    || code === "window_not_found"
    || code === "a11y_window_gone"
    || code === "invalid_input"
    || code === "a11y_node_not_found";
}

function assert_usage_or_honest_non_usage(reply, label, token) {
  ensure(!output_success(reply),
    "cu_linux_tree_honesty_" + label + "_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  const command = text_at(reply, "command");
  if (code === "usage" || command === "usage") {
    ensure(
      code === "usage",
      "cu_linux_tree_honesty_" + label + "_code:" + JSON.stringify(reply.error)
    );
    ensure(
      command === "usage",
      "cu_linux_tree_honesty_" + label + "_command:" + JSON.stringify(reply)
    );
    ensure(
      usage_rejects_unexpected(text_at(reply, "error.message"), token),
      "cu_linux_tree_honesty_" + label + "_message:" + JSON.stringify(reply.error)
    );
  } else {
    ensure(
      command !== "usage" && honest_non_usage_code(code),
      "cu_linux_tree_honesty_" + label + "_honest:" + JSON.stringify(reply)
    );
    ensure(
      JSON.stringify(reply).indexOf("coordinate") < 0
        && JSON.stringify(reply).indexOf("XTest") < 0,
      "cu_linux_tree_honesty_" + label + "_degraded:" + JSON.stringify(reply)
    );
  }
}

function assert_tree_usage_limit(run_directory, executable) {
  const zero_handle = run_cu_reply(run_directory, executable, "observe", [
    "tree", "--window", "0",
    "--depth", "" + TREE_DEPTH,
    "--max-nodes", "" + MAX_NODES,
    "--flat",
  ]);
  ensure(!output_success(zero_handle), "cu_linux_tree_honesty_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "usage",
    "cu_linux_tree_honesty_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_tree_honesty_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const with_name = run_cu_reply(run_directory, executable, "observe", [
    "tree", "--window", "1",
    "--depth", "" + TREE_DEPTH,
    "--max-nodes", "" + MAX_NODES,
    "--flat",
    "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(!output_success(with_name), "cu_linux_tree_honesty_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_tree_honesty_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_tree_honesty_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_name, "error.message"), "--name"),
    "cu_linux_tree_honesty_name_message:" + JSON.stringify(with_name.error)
  );

  const elements_with_name = run_cu_reply(run_directory, executable, "observe", [
    "elements", "--window", "1",
    "--depth", "" + TREE_DEPTH,
    "--max-nodes", "" + MAX_NODES,
    "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(!output_success(elements_with_name),
    "cu_linux_tree_honesty_elements_name_ok:" + JSON.stringify(elements_with_name));
  ensure(
    text_at(elements_with_name, "error.code") === "usage",
    "cu_linux_tree_honesty_elements_name_code:" + JSON.stringify(elements_with_name.error)
  );
  ensure(
    text_at(elements_with_name, "command") === "usage",
    "cu_linux_tree_honesty_elements_name_command:" + JSON.stringify(elements_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(elements_with_name, "error.message"), "--name"),
    "cu_linux_tree_honesty_elements_name_message:" + JSON.stringify(elements_with_name.error)
  );

  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe", [
    "elements", "--window", "1",
    "--depth", "" + TREE_DEPTH,
    "--max-nodes", "" + MAX_NODES,
    "--bogus",
  ]), "elements_bogus", "--bogus");

  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe", [
    "elements", "--window", "1",
    "--depth", "" + TREE_DEPTH,
    "--max-nodes", "" + MAX_NODES,
    "--coords", "10,10",
  ]), "elements_coords", "--coords");

  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe", [
    "tree", "--window", "1",
    "--depth", "" + TREE_DEPTH,
    "--max-nodes", "" + MAX_NODES,
    "--flat",
    "--bogus",
  ]), "bogus", "--bogus");

  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe", [
    "tree", "--window", "1",
    "--depth", "" + TREE_DEPTH,
    "--max-nodes", "" + MAX_NODES,
    "--flat",
    "--coords", "10,10",
  ]), "coords", "--coords");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_tree_honesty_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_tree_honesty_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_tree_honesty_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_tree_honesty_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_tree_honesty_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_tree_honesty_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_tree_honesty_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_tree_honesty_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_tree_honesty_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_tree_honesty_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_tree_honesty_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_tree_honesty_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_tree_honesty_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_tree_honesty_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_tree_honesty_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_tree_honesty_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_tree_honesty_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_tree_honesty_extents_unavailable_code:" + code
  );
}

function assert_tree_budget_bounds(run_directory, executable, handle) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "tree", "--window", "" + handle,
    "--depth", "" + TREE_DEPTH,
    "--max-nodes", "0",
    "--flat",
  ]);
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === "invalid_input",
    "cu_linux_tree_honesty_budget_bounds:" + JSON.stringify(reply)
  );
}

function assert_tree_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "tree", "--window", "1",
    "--depth", "" + TREE_DEPTH,
    "--max-nodes", "" + MAX_NODES,
    "--flat",
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_tree_honesty_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_tree_honesty_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle",
    "cu_linux_tree_honesty_unavailable_code:" + code
  );
  if (code === "a11y_backend_failed") {
    const message = text_at(reply, "error.message").toLowerCase();
    ensure(
      message.indexOf("accessibility") >= 0
        || message.indexOf("address") >= 0
        || message.indexOf("bus") >= 0,
      "cu_linux_tree_honesty_unavailable_message:" + JSON.stringify(reply.error)
    );
  }
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_tree_honesty_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_tree_honesty_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_tree_honesty_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_tree_honesty_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_tree_honesty_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function verify_readback(run_directory, executable, fixture_pid, handle, cu_tree_path) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "",
    "pid = int(sys.argv[1])",
    "handle = int(sys.argv[2])",
    "cu_path = sys.argv[3]",
    "max_depth = int(sys.argv[4])",
    "max_nodes = int(sys.argv[5])",
    "",
    "ROLE_CHECKABLE = {'check box', 'radio button', 'check menu item', 'radio menu item', 'toggle button'}",
    "ROLE_EXPANDABLE = {'combo box', 'tree item', 'list item', 'menu'}",
    "ROLE_SELECTABLE = {'page tab'}",
    "VOLATILE = {'focused', 'active', 'armed', 'selected'}",
    "",
    "def role_is_checkable(role): return role in ROLE_CHECKABLE",
    "def role_is_expandable(role): return role in ROLE_EXPANDABLE",
    "def role_is_selectable(role): return role in ROLE_SELECTABLE",
    "",
    "def complete_two_way(labels, role):",
    "    has = lambda w: w in labels",
    "    if (has('checkable') or role_is_checkable(role)) and not has('mixed'):",
    "        if has('indeterminate'):",
    "            labels.append('mixed')",
    "        elif not has('checked'):",
    "            labels.append('unchecked')",
    "    if (has('expandable') or role_is_expandable(role)) and not has('expanded') and not has('collapsed'):",
    "        labels.append('collapsed')",
    "    if (has('selectable') or role_is_selectable(role)) and not has('selected'):",
    "        labels.append('unselected')",
    "    return labels",
    "",
    "def normalize_state(word):",
    "    if word == 'multi_line': return 'multiline'",
    "    if word == 'single_line': return 'singleline'",
    "    return word",
    "",
    "def state_labels(obj, role):",
    "    labels = []",
    "    st = obj.getState()",
    "    for attr in dir(pyatspi):",
    "        if not attr.startswith('STATE_') or attr in ('STATE_LAST_DEFINED', 'STATE_VALUE_TO_NAME'):",
    "            continue",
    "        if st.contains(getattr(pyatspi, attr)):",
    "            labels.append(normalize_state(attr[6:].lower()))",
    "    labels = complete_two_way(labels, role)",
    "    return sorted(labels)",
    "",
    "def node_name(obj):",
    "    try: return obj.name or ''",
    "    except Exception: return ''",
    "",
    "def node_role(obj):",
    "    try:",
    "        rn = obj.getRoleName()",
    "        if rn and rn.strip(): return rn",
    "    except Exception: pass",
    "    return pyatspi.role.getName(obj.getRole()).lower()",
    "",
    "def walk_bfs(obj, max_depth, budget):",
    "    out = []",
    "    queue = [(obj, 0)]",
    "    while queue and len(out) < budget:",
    "        current, depth = queue.pop(0)",
    "        role = node_role(current)",
    "        out.append({",
    "            'depth': depth,",
    "            'role': role,",
    "            'name': node_name(current),",
    "            'states': state_labels(current, role),",
    "        })",
    "        if depth >= max_depth: continue",
    "        try: child_count = current.childCount",
    "        except Exception: continue",
    "        for i in range(child_count):",
    "            try: child = current.getChildAtIndex(i)",
    "            except Exception: child = None",
    "            if child is not None: queue.append((child, depth + 1))",
    "    return out",
    "",
    "def norm_states(st): return sorted(s for s in st if s not in VOLATILE)",
    "",
    "def node_key(node):",
    "    return (",
    "        node.get('depth'),",
    "        node.get('role'),",
    "        node.get('name') or '',",
    "        tuple(norm_states(node.get('states') or [])),",
    "    )",
    "",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "app = None",
    "for i in range(desktop.childCount):",
    "    child = desktop.getChildAtIndex(i)",
    "    try:",
    "        if child.get_process_id() == pid:",
    "            app = child",
    "            break",
    "    except Exception: pass",
    "if app is None:",
    "    raise SystemExit('cu_linux_tree_honesty_no_app')",
    "",
    "native = walk_bfs(app, max_depth, max_nodes)",
    "cu = json.load(open(cu_path))",
    "if not cu.get('ok') or cu.get('command') != 'tree':",
    "    raise SystemExit('cu_linux_tree_honesty_cu_reply')",
    "cu_nodes = cu['data']['nodes']",
    "if len(native) != len(cu_nodes):",
    "    raise SystemExit(f'cu_linux_tree_honesty_count:{len(native)}:{len(cu_nodes)}')",
    "",
    "mismatches = []",
    "for i, (n, c) in enumerate(zip(native, cu_nodes)):",
    "    cn = {",
    "        'depth': c.get('depth'),",
    "        'role': c.get('role'),",
    "        'name': c.get('name') or '',",
    "        'states': norm_states(c.get('states') or []),",
    "    }",
    "    nn = {",
    "        'depth': n['depth'],",
    "        'role': n['role'],",
    "        'name': n['name'],",
    "        'states': norm_states(n['states']),",
    "    }",
    "    if cn != nn:",
    "        mismatches.append((i, nn, cn))",
    "if mismatches:",
    "    raise SystemExit(f'cu_linux_tree_honesty_mismatch:{mismatches[0]}')",
    "",
    "named = {name: None for name in sys.argv[6:]}",
    "for node in cu_nodes:",
    "    name = node.get('name') or ''",
    "    if name in named:",
    "        named[name] = node",
    "for name, node in named.items():",
    "    if node is None:",
    "        raise SystemExit(f'cu_linux_tree_honesty_named_missing:{name}')",
    "    if not node.get('role'):",
    "        raise SystemExit(f'cu_linux_tree_honesty_named_role:{name}')",
    "    if not isinstance(node.get('states'), list) or len(node.get('states')) == 0:",
    "        raise SystemExit(f'cu_linux_tree_honesty_named_states:{name}')",
    "",
    "print('native', len(native), 'cu', len(cu_nodes), 'handle', handle)",
  ].join("\n");
  const output = rh.command("/usr/bin/python3", [
    "-c", script,
    "" + fixture_pid,
    "" + handle,
    cu_tree_path,
    "" + TREE_DEPTH,
    "" + MAX_NODES,
  ].concat(NAMED_FIXTURE_NODES), {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true,
    "cu_linux_tree_honesty_readback:" + output.stderr + output.stdout);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_tree_honesty_executable_missing");

const uname = rh.command("/usr/bin/uname", ["-s"], { timeout_ms: 10000 });
ensure(uname.success === true && uname.stdout.trim() === "Linux",
  "cu_linux_tree_honesty_requires_linux");

const context = harness.new_context(repo, "cu-linux-tree-honesty");
const run_directory = rh.join(repo, "target/cu-linux-tree-honesty-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_tree_honesty_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP tree/elements typed-fails usage when --window handle is zero or AT-SPI --name/--coords/--bogus is present (usage_rejects_unexpected + command=usage, or honest non-usage typed failure; never fake command=usage)");
  assert_tree_usage_limit(run_directory, executable);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (command=usage) before process-state/desktop-state and tree observe/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and tree observe/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP tree typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and tree observe/read-back court");
  assert_tree_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held; tree read-back requires pyatspi");
    succeeded = 1;
  } else {
    print("STEP start owned GTK fixture and resolve one window handle");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_tree_honesty_window_wait");

  const inventory_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(inventory_row !== null, "cu_linux_tree_honesty_inventory_missing");
  const handle = int_at(inventory_row, "handle");
  ensure(handle > 0, "cu_linux_tree_honesty_handle:" + JSON.stringify(inventory_row));
  const handle_text = "" + handle;

  print("STEP process-state binds the owned fixture pid before tree observe/read-back court");
  assert_fixture_process_state(run_directory, executable, fixture_pid);

  print("STEP desktop-state window row agrees with inventory before tree observe/read-back court");
  assert_fixture_desktop_state(
    run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
  );

  print("STEP CU tree --flat returns a bounded flat projection for the fixture window");
  const tree = run_cu(run_directory, executable, "observe", [
    "tree", "--window", "" + handle,
    "--depth", "" + TREE_DEPTH,
    "--max-nodes", "" + MAX_NODES,
    "--flat",
  ]);
  ensure(
    text_at(tree, "data.backend") === "at-spi2"
      && text_at(tree, "data.addressing") === "accessibility-tree"
      && int_at(tree, "data.window") === handle
      && flag_at(tree, "data.flat")
      && !flag_at(tree, "data.degraded")
      && !flag_at(tree, "data.truncated")
      && int_at(tree, "data.budget.depth") === TREE_DEPTH
      && int_at(tree, "data.budget.max_nodes") === MAX_NODES
      && int_at(tree, "data.visited") === tree.data.nodes.length
      && int_at(tree, "data.returned") === tree.data.nodes.length
      && int_at(tree, "data.visited") <= MAX_NODES
      && Array.isArray(tree.data.nodes)
      && tree.data.nodes.length > 5,
    "cu_linux_tree_honesty_tree_shape:" + JSON.stringify(tree.data)
  );
  for (let index = 0; index < tree.data.nodes.length; index += 1) {
    const node = tree.data.nodes[index];
    ensure(
      int_at(node, "index") === index
        && typeof node.depth === "number"
        && typeof node.role === "string",
      "cu_linux_tree_honesty_flat_index:" + JSON.stringify(node)
    );
  }

  const cu_tree_path = rh.join(run_directory, "cu-tree-flat.json");
  rh.write_text(cu_tree_path, JSON.stringify(tree));

  print("STEP independent pyatspi BFS dump agrees on names/roles/states");
  verify_readback(run_directory, executable, fixture_pid, handle, cu_tree_path);

  print("STEP tree typed-fails invalid_input when --max-nodes is zero");
  assert_tree_budget_bounds(run_directory, executable, handle);

  succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
}

if (succeeded !== 0) {
  harness.emit_evidence(context, declared_evidence, declared_evidence[0]);
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux tree --flat names/roles/states match independent AT-SPI dump with typed tree/elements --name/--coords/--bogus usage_rejects_unexpected or honest non-usage (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), and process-state/desktop-state courts before observe (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux tree typed-fails with typed tree/elements --name/--coords/--bogus usage_rejects_unexpected or honest non-usage (never fake command=usage) and get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
return;
