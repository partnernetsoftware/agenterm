// CEO: Linux file-copy honesty with independent src/dst byte+mode read-back.
// Acceptance is smoke read-back only: CU file-copy plan source_snapshot must
// agree with independent os.lstat+sha256 on a temp regular file; the default
// plan must not mutate; actuate --apply must publish destination bytes and
// permissions that agree with independent read-back. Typed file-copy usage must
// reject AT-SPI --name, --coords, --bogus, and other unexpected arguments;
// typed get-extents --name usage AND host-limit paths must both hold before
// the copy/read-back court. Permission-denied open host-limit paths must match
// an independent os.open probe. Prefer host-limit clarity over fake success.
// AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-file-copy-readback",
];

const AT_SPI_PROBE_NAME = "File Copy Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function isolated_env(run_directory, executable) {
  const env = {
    HOME: rh.join(run_directory, "home"),
    USERPROFILE: rh.join(run_directory, "home"),
    XDG_CONFIG_HOME: rh.join(run_directory, "config"),
    XDG_DATA_HOME: rh.join(run_directory, "data"),
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
    AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
    AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(run_directory, "cu-requests.json"),
    AGENTERM_CU_FILE_TRANSACTION_DIR: rh.join(run_directory, "transactions"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  const cu = cu_env(executable);
  env.AGENTERM_ABI_LIB = cu.AGENTERM_ABI_LIB;
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (cu[key] !== undefined) { env[key] = cu[key]; }
  }
  return env;
}

function invoke_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (let i = 0; i < arguments.length; i = i + 1) { argv.push(arguments[i]); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_file_copy_cli:" + output.stdout + output.stderr);
  let reply = null;
  try { reply = JSON.parse(output.stdout.trim()); }
  catch (error) { throw "cu_linux_file_copy_invalid_reply"; }
  ensure(
    text_at(reply, "command") === "file-copy" || text_at(reply, "command") === "usage",
    "cu_linux_file_copy_wrong_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_file_copy_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function invoke(run_directory, executable, grant, arguments, expected_error, env) {
  const reply = invoke_reply(run_directory, executable, grant, arguments, env);
  if (expected_error !== undefined) {
    ensure(!rh.output_success(reply), "cu_linux_file_copy_expected_failure");
    ensure(text_at(reply, "error.code") === expected_error,
      "cu_linux_file_copy_wrong_error:" + JSON.stringify(reply.error));
    return reply.error;
  }
  ensure(rh.output_success(reply), "cu_linux_file_copy_failed:" + JSON.stringify(reply));
  return reply.data;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function file_copy_usage_rejects(message, token) {
  return usage_rejects_unexpected(message, token)
    || message.indexOf("requires SOURCE DESTINATION") >= 0;
}

function assert_file_copy_usage_limit(run_directory, executable, source, destination, env) {
  const flat_with_name = invoke_reply(run_directory, executable, "observe", [
    "file-copy", source, destination, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(flat_with_name),
    "cu_linux_file_copy_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_file_copy_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_file_copy_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    file_copy_usage_rejects(text_at(flat_with_name, "error.message"), "--name"),
    "cu_linux_file_copy_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_reply(run_directory, executable, "observe", [
    "file", "copy", source, destination, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(grouped_with_name),
    "cu_linux_file_copy_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_file_copy_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "command") === "usage",
    "cu_linux_file_copy_usage_grouped_name_command:" + JSON.stringify(grouped_with_name)
  );
  ensure(
    file_copy_usage_rejects(text_at(grouped_with_name, "error.message"), "--name"),
    "cu_linux_file_copy_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const flat_with_bogus = invoke_reply(run_directory, executable, "observe", [
    "file-copy", source, destination, "--bogus",
  ], env);
  ensure(!rh.output_success(flat_with_bogus),
    "cu_linux_file_copy_usage_flat_bogus_ok:" + JSON.stringify(flat_with_bogus));
  ensure(
    text_at(flat_with_bogus, "error.code") === "usage",
    "cu_linux_file_copy_usage_flat_bogus_code:" + JSON.stringify(flat_with_bogus.error)
  );
  ensure(
    text_at(flat_with_bogus, "command") === "usage",
    "cu_linux_file_copy_usage_flat_bogus_command:" + JSON.stringify(flat_with_bogus)
  );
  ensure(
    file_copy_usage_rejects(text_at(flat_with_bogus, "error.message"), "--bogus"),
    "cu_linux_file_copy_usage_flat_bogus_message:" + JSON.stringify(flat_with_bogus.error)
  );

  const grouped_with_bogus = invoke_reply(run_directory, executable, "observe", [
    "file", "copy", source, destination, "--bogus",
  ], env);
  ensure(!rh.output_success(grouped_with_bogus),
    "cu_linux_file_copy_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_file_copy_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    text_at(grouped_with_bogus, "command") === "usage",
    "cu_linux_file_copy_usage_grouped_bogus_command:" + JSON.stringify(grouped_with_bogus)
  );
  ensure(
    file_copy_usage_rejects(text_at(grouped_with_bogus, "error.message"), "--bogus"),
    "cu_linux_file_copy_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const flat_with_coords = invoke_reply(run_directory, executable, "observe", [
    "file-copy", source, destination, "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(flat_with_coords),
    "cu_linux_file_copy_usage_flat_coords_ok:" + JSON.stringify(flat_with_coords));
  ensure(
    text_at(flat_with_coords, "error.code") === "usage",
    "cu_linux_file_copy_usage_flat_coords_code:" + JSON.stringify(flat_with_coords.error)
  );
  ensure(
    text_at(flat_with_coords, "command") === "usage",
    "cu_linux_file_copy_usage_flat_coords_command:" + JSON.stringify(flat_with_coords)
  );
  ensure(
    file_copy_usage_rejects(text_at(flat_with_coords, "error.message"), "--coords"),
    "cu_linux_file_copy_usage_flat_coords_message:" + JSON.stringify(flat_with_coords.error)
  );

  const grouped_with_coords = invoke_reply(run_directory, executable, "observe", [
    "file", "copy", source, destination, "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(grouped_with_coords),
    "cu_linux_file_copy_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_file_copy_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    text_at(grouped_with_coords, "command") === "usage",
    "cu_linux_file_copy_usage_grouped_coords_command:" + JSON.stringify(grouped_with_coords)
  );
  ensure(
    file_copy_usage_rejects(text_at(grouped_with_coords, "error.message"), "--coords"),
    "cu_linux_file_copy_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_file_copy_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_file_copy_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_file_copy_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_file_copy_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_file_copy_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_file_copy_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_copy_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_file_copy_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_file_copy_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_file_copy_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_copy_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_file_copy_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_file_copy_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_file_copy_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_copy_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_file_copy_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_file_copy_extents_unavailable_code:" + code
  );
}

function probe_file_open(path) {
  const script = [
    "import json, os, sys",
    "path = sys.argv[1]",
    "readable = False",
    "error_kind = None",
    "try:",
    "    handle = os.open(path, os.O_RDONLY)",
    "    os.close(handle)",
    "    readable = True",
    "except OSError as error:",
    "    if error.errno == 13:",
    "        error_kind = 'PermissionDenied'",
    "    elif error.errno == 2:",
    "        error_kind = 'NotFound'",
    "    else:",
    "        error_kind = error.__class__.__name__",
    "print(json.dumps({",
    "    'readable': readable,",
    "    'error_kind': error_kind,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, path], {
    timeout_ms: 10000,
  });
  ensure(output.success === true,
    "cu_linux_file_copy_open_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function assert_file_copy_open_denied_host_limit(
  run_directory, executable, source, destination, grant, env, apply
) {
  const probe = probe_file_open(source);
  ensure(probe.readable !== true && probe.error_kind === "PermissionDenied",
    "cu_linux_file_copy_denied_probe_not_denied:" + JSON.stringify(probe));
  const arguments = ["file-copy", source, destination];
  if (apply === true) { arguments.push("--apply"); }
  const reply = invoke_reply(run_directory, executable, grant, arguments, env);
  ensure(!rh.output_success(reply),
    "cu_linux_file_copy_denied_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "file_transaction_entry_invalid",
    "cu_linux_file_copy_denied_code:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message");
  ensure(
    message.indexOf("Permission denied") >= 0 || message.indexOf("os error 13") >= 0,
    "cu_linux_file_copy_denied_message:" + message
  );
}

function independent_snapshot(path) {
  const script = [
    "import hashlib, json, os, stat, sys",
    "path = sys.argv[1]",
    "st = os.lstat(path)",
    "with open(path, 'rb') as handle:",
    "    payload = handle.read()",
    "print(json.dumps({",
    "    'size_bytes': str(st.st_size),",
    "    'modified_unix_ns': str(st.st_mtime_ns),",
    "    'unix_mode': st.st_mode,",
    "    'sha256': hashlib.sha256(payload).hexdigest(),",
    "    'filesystem_id': str(st.st_dev),",
    "    'object_id': str(st.st_ino),",
    "}))",
  ].join("\n");
  const output = rh.command("/usr/bin/python3", ["-c", script, path], {
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_file_copy_readback_failed:" + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function ensure_snapshot(actual, expected, label) {
  ensure(actual !== null && typeof actual === "object", label + ":object");
  ensure(actual.size_bytes === expected.size_bytes,
    label + ":size:" + JSON.stringify(actual) + ":expected:" + JSON.stringify(expected));
  ensure(actual.sha256 === expected.sha256,
    label + ":sha256:" + JSON.stringify(actual) + ":expected:" + JSON.stringify(expected));
  ensure(Number(actual.unix_mode) === Number(expected.unix_mode),
    label + ":mode:" + JSON.stringify(actual) + ":expected:" + JSON.stringify(expected));
  ensure(actual.modified_unix_ns === expected.modified_unix_ns,
    label + ":mtime:" + JSON.stringify(actual) + ":expected:" + JSON.stringify(expected));
  ensure(actual.filesystem_id === expected.filesystem_id,
    label + ":filesystem_id:" + JSON.stringify(actual) + ":expected:" + JSON.stringify(expected));
  ensure(actual.object_id === expected.object_id,
    label + ":object_id:" + JSON.stringify(actual) + ":expected:" + JSON.stringify(expected));
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_file_copy_executable_missing");

const uname = rh.command("/usr/bin/uname", ["-s"], { timeout_ms: 10000 });
ensure(uname.success === true && uname.stdout.trim() === "Linux",
  "cu_linux_file_copy_requires_linux");

const context = harness.new_context(repo, "cu-linux-file-copy");
const run_directory = context.run_directory;
const env = isolated_env(run_directory, executable);
const atspi_available = probe_atspi_available(executable);
const source = rh.join(run_directory, "source.bin");
const destination = rh.join(run_directory, "destination.bin");
const denied_source = rh.join(run_directory, "denied-source.bin");
const denied_destination = rh.join(run_directory, "denied-destination.bin");
let succeeded = 0;
let failure = "";

try {
  rh.write_text(source, "file-copy-readback-fixture");
  const prepared = rh.command("/bin/chmod", ["0640", source], {
    cwd: run_directory,
    timeout_ms: 10000,
  });
  ensure(prepared.success === true, "cu_linux_file_copy_fixture_setup_failed:" + prepared.stderr);
  const source_before = independent_snapshot(source);

  print("STEP file-copy typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_file_copy_usage_limit(run_directory, executable, source, destination, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before copy/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before copy/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; file-copy read-back still uses os.lstat+sha256");
  }

  print("STEP dry plan source_snapshot matches independent src byte+mode read-back");
  const plan = invoke(run_directory, executable, "observe", [
    "file-copy", source, destination,
  ], undefined, env);
  ensure(plan.operation === "file.copy" && plan.replace === false,
    "cu_linux_file_copy_plan_shape:" + JSON.stringify(plan));
  ensure(plan.destination_snapshot === null,
    "cu_linux_file_copy_plan_destination_snapshot:" + JSON.stringify(plan));
  ensure_snapshot(plan.source_snapshot, source_before, "cu_linux_file_copy_plan_source");
  ensure(!rh.exists(destination), "cu_linux_file_copy_plan_created_destination");
  ensure(independent_snapshot(source).sha256 === source_before.sha256,
    "cu_linux_file_copy_plan_mutated_source");

  print("STEP observe plus --apply is denied before mutation");
  invoke(run_directory, executable, "observe", [
    "file-copy", source, destination, "--apply",
  ], "refused", env);
  ensure(!rh.exists(destination), "cu_linux_file_copy_refusal_created_destination");

  print("STEP actuate apply publishes destination bytes+mode matching independent read-back");
  const applied = invoke(run_directory, executable, "actuate", [
    "file-copy", source, destination, "--apply",
  ], undefined, env);
  ensure(applied.state === "completed" && applied.destination_durable === true,
    "cu_linux_file_copy_apply_state:" + JSON.stringify(applied));
  ensure(applied.result_snapshot !== null && typeof applied.result_snapshot === "object",
    "cu_linux_file_copy_apply_result_snapshot");
  const destination_after = independent_snapshot(destination);
  ensure_snapshot(applied.result_snapshot, destination_after, "cu_linux_file_copy_apply_result");
  ensure(destination_after.sha256 === source_before.sha256,
    "cu_linux_file_copy_apply_bytes_mismatch:" + JSON.stringify(destination_after));
  ensure(Number(destination_after.unix_mode) === Number(source_before.unix_mode),
    "cu_linux_file_copy_apply_mode_mismatch:" + JSON.stringify(destination_after));
  ensure(independent_snapshot(source).sha256 === source_before.sha256,
    "cu_linux_file_copy_apply_mutated_source");

  print("STEP rollback removes the newly-created destination");
  const rollback_argv = [
    "--target", "current", "--grant", "actuate",
    "file-transaction", "rollback", applied.transaction_id,
  ];
  const rollback_output = rh.command(executable, rollback_argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  let rollback_reply = null;
  try { rollback_reply = JSON.parse(rollback_output.stdout.trim()); }
  catch (error) { throw "cu_linux_file_copy_rollback_invalid_reply"; }
  ensure(rollback_output.success === true && rollback_reply.ok === true,
    "cu_linux_file_copy_rollback_failed:" + JSON.stringify(rollback_reply));
  ensure(rollback_reply.data.state === "rolled_back", "cu_linux_file_copy_rollback_state");
  ensure(!rh.exists(destination), "cu_linux_file_copy_rollback_left_destination");

  rh.write_text(denied_source, "file-copy-denied-fixture");
  const denied_prep = rh.command("/bin/chmod", ["0000", denied_source], {
    cwd: run_directory,
    timeout_ms: 10000,
  });
  ensure(denied_prep.success === true,
    "cu_linux_file_copy_denied_fixture_setup_failed:" + denied_prep.stderr);
  const denied_probe = probe_file_open(denied_source);
  if (denied_probe.readable !== true && denied_probe.error_kind === "PermissionDenied") {
    print("STEP file-copy typed-fails file_transaction_entry_invalid host-limit when independent os.open probe is denied");
    assert_file_copy_open_denied_host_limit(
      run_directory, executable, denied_source, denied_destination, "observe", env, false);
    assert_file_copy_open_denied_host_limit(
      run_directory, executable, denied_source, denied_destination, "actuate", env, true);
    ensure(!rh.exists(denied_destination),
      "cu_linux_file_copy_denied_created_destination");
    ensure(independent_snapshot(source).sha256 === source_before.sha256,
      "cu_linux_file_copy_denied_mutated_source");
  } else {
    print("STEP skip permission-denied host-limit: independent os.open probe is readable on this host");
  }

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-file-copy-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux file-copy plan/apply agree with independent src/dst byte+mode read-back with typed file-copy --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux file-copy plan/apply agree with independent src/dst byte+mode read-back with typed file-copy --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
