// Public supervisor proof for cooperative cancellation of embedded
// agenterm:acu job-wait. The child observes the provider's typed cancellation
// reply; lower-level ACK ordering and the pre-cancel no-state-root property
// remain owned by frozen Rust courts at the runner and provider layers.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.audit-cursor-invalidated-by-compaction",
  "cu.job-wait-cancel.embedded-supervisor-cancel",
  "cu.job-wait-cancel.owner-survives",
  "cu.job-wait-cancel.terminal-truth"
];
const required_env = [
  "AGENTERM_CU_MANAGED_JOB_PATH",
  "AGENTERM_CU_RUNTIME_PATH",
  "AGENTERM_CU_IDEMPOTENCY_PATH",
  "AGENTERM_CU_AUDIT_PATH",
  "HOME",
  "XDG_RUNTIME_DIR",
  "XDG_CONFIG_HOME",
  "XDG_DATA_HOME",
  "XDG_CACHE_HOME"
];
const invocation_deadline_ms = 3000;

function require(condition, message) {
  harness.require(condition, message);
}

function comparable_path(value) {
  return ("" + value).replaceAll("\\", "/");
}

function prepare_private_runtime(path) {
  rh.create_dir_all(path);
  if (harness.host_is_windows()) { return; }
  const chmod = rh.command("chmod", ["0700", path], { timeout_ms: 2000 });
  require(chmod.success, "runtime_chmod_failed:" + chmod.stderr);
}

function data_of(reply, command) {
  require(reply !== null && typeof reply === "object", "acu_reply_shape:" + command);
  if (reply.ok !== true) {
    const code = reply.error !== null && typeof reply.error === "object"
      ? "" + reply.error.code : "unknown";
    throw "acu_reply_failed:" + command + ":" + code;
  }
  require(reply.command === command, "acu_reply_command:" + command);
  require(reply.data !== null && typeof reply.data === "object", "acu_reply_data:" + command);
  return reply.data;
}

function raw_call(args, command) {
  const cli_args = ["cli", "acu"];
  append_all(cli_args, args);
  const output = rh.command(agenterm, cli_args, {
    cwd: context.run_directory,
    env: environment,
    timeout_ms: 10000
  });
  require(output.stdout.trim() !== "", "acu_cli_reply_missing:" + command + ":" + output.stderr);
  return JSON.parse(output.stdout);
}

function call(args, command) {
  return data_of(raw_call(args, command), command);
}

function mutation_prefix(request_id, snapshot) {
  return [
    "--target", "current", "--grant", "actuate",
    "--request-id", request_id,
    "--session", snapshot.session_id,
    "--session-lease", snapshot.session_lease
  ];
}

function append_all(target, values) {
  for (const value of values) { target.push(value); }
}

function now_ms() {
  require(time_now_ms() === 0, "time_now_ms_failed");
  return Number(tool_result());
}

function read_json_lines(path) {
  const values = [];
  const text = rh.read_text(path);
  for (const line of text.split("\n")) {
    if (line.trim() !== "") { values.push(JSON.parse(line)); }
  }
  return values;
}

function wait_cancelled_from_stdout(stdout) {
  for (const line of stdout.split("\n")) {
    if (!line.startsWith("{")) { continue; }
    const value = JSON.parse(line);
    if (value.schema_version === 1 && value.kind === "wait-cancelled"
        && value.code === "cancelled") { return true; }
  }
  return false;
}

function exact_process_absent(pid, start_identity) {
  const reply = raw_call([
    "--target", "current", "--grant", "observe",
    "process-state", "--pid", "" + pid
  ], "process-state");
  if (reply.ok !== true) {
    return reply.error !== null && reply.error.code === "process_not_found";
  }
  const state = reply.data;
  return state.state !== "live" || state.start_identity !== start_identity;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
require(args.length === 3, "expected: REPO AGENTERM_EXE CHILD_QJS");

const repo = rh.absolute(args[0]);
const agenterm = rh.absolute(args[1]);
const child_qjs = rh.absolute(args[2]);
require(rh.exists(agenterm), "agenterm_executable_missing");
require(rh.exists(child_qjs), "cancel_child_missing");

const context = harness.new_context(repo, "acu-provider-job-wait-cancel");
const target_root = rh.parent(rh.parent(rh.parent(context.run_directory)));
const isolated_root = rh.join(target_root, "acu-w5-" + process_id());
const environment = {
  AGENTERM_CU_MANAGED_JOB_PATH: rh.join(isolated_root, "cu-managed-jobs.json"),
  AGENTERM_CU_RUNTIME_PATH: rh.join(isolated_root, "cu-runtime.json"),
  AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(isolated_root, "cu-idempotency.json"),
  AGENTERM_CU_AUDIT_PATH: rh.join(isolated_root, "cu-audit.jsonl"),
  HOME: isolated_root,
  XDG_RUNTIME_DIR: rh.join(isolated_root, "runtime"),
  XDG_CONFIG_HOME: rh.join(isolated_root, "config"),
  XDG_DATA_HOME: rh.join(isolated_root, "data"),
  XDG_CACHE_HOME: rh.join(isolated_root, "cache")
};
rh.create_dir_all(isolated_root);
prepare_private_runtime(environment.XDG_RUNTIME_DIR);
for (const name of ["XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME"]) {
  rh.create_dir_all(environment[name]);
}
const env_paths = [
  environment.AGENTERM_CU_MANAGED_JOB_PATH,
  environment.AGENTERM_CU_RUNTIME_PATH,
  environment.AGENTERM_CU_IDEMPOTENCY_PATH,
  environment.AGENTERM_CU_AUDIT_PATH
];
const comparable_repo = comparable_path(repo);
for (let i = 0; i < env_paths.length; i = i + 1) {
  require(comparable_path(env_paths[i]).startsWith(comparable_repo + "/target/"),
    "cu_path_not_repo_target:" + i);
  for (let j = i + 1; j < env_paths.length; j = j + 1) {
    require(comparable_path(env_paths[i]) !== comparable_path(env_paths[j]),
      "cu_paths_not_distinct:" + i + ":" + j);
  }
}
for (const name of ["HOME", "XDG_RUNTIME_DIR", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME"]) {
  require(comparable_path(environment[name]).startsWith(comparable_repo + "/target/"),
    "home_xdg_not_repo_target:" + name);
}
const comparable_root = comparable_path(isolated_root);
for (const path of env_paths) {
  require(comparable_path(path).startsWith(comparable_root + "/"),
    "cu_path_outside_isolated_home");
  require(!rh.exists(path), "cu_path_not_fresh");
}
for (const name of ["XDG_RUNTIME_DIR", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME"]) {
  require(comparable_path(environment[name]).startsWith(comparable_root + "/"),
    "xdg_outside_isolated_home:" + name);
}

const request_root = "job-wait-cancel-" + context.run_id;
const script_audit = rh.join(context.run_directory, "script-audit.jsonl");
environment.AGENTERM_SCRIPT_AUDIT_PATH = script_audit;
environment.AGENTERM_NO_ACTIVATE = "1";

let snapshot = null;
let session_handoff = null;
let succeeded = false;
let failure = "";
let terminal = null;

try {
  const session = call([
    "--target", "current", "--grant", "actuate",
    // 300, not 60: this suite's subject is the embedded 60-second wait and the
    // cancel that ends it, so a 60-second TTL expires at exactly the moment the
    // thing under test completes. Any overhead at all -- and a loaded Windows
    // runner has plenty -- retires the session first, which cleans up its jobs,
    // kills the resident owner and leaves `job-status` reporting
    // `orphaned_uncertain`: the aftermath of a lease that ran out, reported as
    // if the owner had been lost. The TTL has to outlast what it is holding
    // open, the same ordering every other budget here now follows.
    "session-start", "--label", "job-wait-cancel-smoke", "--ttl-seconds", "300"
  ], "session-start");
  require(typeof session.session_id === "string" && session.session_id !== "", "session_id_missing");
  require(typeof session.lease === "string" && session.lease !== "", "session_lease_missing");
  session_handoff = session;
  const spawn_args = [
    "--target", "current", "--grant", "actuate",
    "--request-id", request_root + "-spawn",
    "--session", session.session_id,
    "--session-lease", session.lease
  ];
  append_all(spawn_args, [
    "job-spawn", "--ttl-seconds", "300", "--",
    // Both budgets, like the sibling invocation below. Without
    // `--max-operations` this nested `script run` takes the engine's default
    // instruction ceiling, and a sleeper that outlives it is killed as
    // `budget exhausted` -- after which the job is no longer running and its
    // owner reads as `orphaned_uncertain`, which describes the aftermath and
    // not the cause.
    agenterm, "cli", "script", "run", child_qjs,
    "--profile", "tool", "--timeout-ms", "60000",
    "--max-operations", "100000000", "--", "--sleeper"
  ]);
  const spawned = call(spawn_args, "job-spawn");
  require(typeof spawned.job_id === "string" && spawned.job_id !== "", "job_id_missing");
  require(typeof spawned.generation === "number" && spawned.generation > 0, "job_generation_missing");
  const correlated = call([
    "--target", "current", "--grant", "observe",
    "audit-query", "--request-id-filter", request_root + "-spawn", "--max", "10"
  ], "audit-query");
  require(correlated.matched === 2, "request_audit_attempt_outcome_pair_missing");
  require(correlated.returned === 2, "request_audit_pair_not_returned");
  require(correlated.filter.request_id === request_root + "-spawn",
    "request_audit_filter_not_echoed");
  for (const record of correlated.records) {
    require(record.request_id === request_root + "-spawn", "request_audit_id_mismatch");
  }
  const correlated_text = JSON.stringify(correlated.records);
  require(!correlated_text.includes(session.session_id), "request_audit_leaked_session_id");
  require(!correlated_text.includes(session.lease), "request_audit_leaked_session_lease");
  const status = call([
    "--target", "current", "--grant", "observe", "job-status", spawned.job_id
  ], "job-status");
  // `orphaned_uncertain` means the store could not prove the job's resident
  // owner is still the process it recorded -- dead, or a reused pid. Which of
  // those it is decides whether this is a host that will not keep a resident
  // process alive or a real lifecycle defect, and the state alone cannot say.
  // Carry the owner's identity and the live view into the message so the next
  // failure arrives with its own evidence instead of costing another round.
  require(status.state === "running",
    "job_not_running:" + status.state + ":" + status.exit_code
      + ":owner_pid=" + status.owner_pid
      + ":live=" + JSON.stringify(status.live)
      + ":detach=" + JSON.stringify(status.detach_liveness));
  require(typeof status.owner_pid === "number" && status.owner_pid > 0, "owner_pid_missing");
  require(typeof status.process_pid === "number" && status.process_pid > 0, "process_pid_missing");
  require(status.live !== null && status.live.state.kind === "running", "job_live_missing");
  const owner = call([
    "--target", "current", "--grant", "observe",
    "process-state", "--pid", "" + status.owner_pid
  ], "process-state");
  const child = call([
    "--target", "current", "--grant", "observe",
    "process-state", "--pid", "" + status.process_pid
  ], "process-state");
  require(owner.state === "live" && typeof owner.start_identity === "string", "owner_identity_missing");
  require(child.state === "live" && typeof child.start_identity === "string", "child_identity_missing");
  snapshot = {
    session_id: session.session_id,
    session_lease: session.lease,
    job_id: spawned.job_id,
    generation: spawned.generation,
    owner_pid: status.owner_pid,
    owner_start_identity: owner.start_identity,
    child_pid: status.process_pid,
    child_start_identity: child.start_identity,
    lease_remaining_ms: status.live.lease_remaining_ms
  };

  print("STEP run the real embedded 60-second wait until the host supervisor requests Cancel");
  const child_args = [
    "cli", "script", "run", child_qjs,
    "--profile", "tool",
    "--timeout-ms", "" + invocation_deadline_ms,
    "--max-operations", "100000000",
    "--max-output-bytes", "262144"
  ];
  for (const name of required_env) {
    child_args.push("--env-allow");
    child_args.push(name);
  }
  child_args.push("--");
  child_args.push(snapshot.job_id);
  child_args.push("" + snapshot.generation);
  const started_at = now_ms();
  const cancelled = rh.command(agenterm, child_args, {
    env: environment,
    timeout_ms: invocation_deadline_ms + 5000
  });
  const external_wall_ms = now_ms() - started_at;
  require(cancelled.success === true, "cancelled_wait_child_failed:" + cancelled.stderr);
  require(wait_cancelled_from_stdout(cancelled.stdout), "cancelled_wait_reply_missing");
  require(cancelled.stderr.indexOf("host_hard_timeout") < 0, "cancelled_wait_hard_timeout");
  require(external_wall_ms < invocation_deadline_ms + 150,
    "cancelled_wait_external_wall:" + external_wall_ms);

  const audits = read_json_lines(script_audit);
  const child_audits = [];
  for (const entry of audits) {
    if (entry.source_kind === "file"
        && entry.requested_budgets.wall_time_ms === invocation_deadline_ms) {
      child_audits.push(entry);
    }
  }
  require(child_audits.length === 1,
    "cancelled_wait_audit_count:" + child_audits.length + ":" + audits.length);
  const audit = child_audits[0];
  require(audit.cancelled === true && audit.crashed === false,
    "cancelled_wait_audit_shape");
  require(audit.failure_code === undefined && audit.result_class === "success",
    "cancelled_wait_audit_terminal");
  require(audit.duration_ms < invocation_deadline_ms + 150,
    "cancelled_wait_audit_wall:" + audit.duration_ms);

  print("STEP prove the same provider state domain still answers quickly with unchanged identity and lease");
  const status_started = now_ms();
  const after = call([
    "--target", "current", "--grant", "observe", "job-status", snapshot.job_id
  ], "job-status");
  const status_wall_ms = now_ms() - status_started;
  require(status_wall_ms < 1000, "post_cancel_status_not_quick:" + status_wall_ms);
  require(after.job_id === snapshot.job_id && after.generation === snapshot.generation,
    "post_cancel_job_identity_changed");
  require(after.session_id === snapshot.session_id && after.state === "running",
    "post_cancel_session_or_state_changed");
  require(after.owner_pid === snapshot.owner_pid && after.process_pid === snapshot.child_pid,
    "post_cancel_process_identity_changed");
  require(after.live !== null && after.live.state.kind === "running",
    "post_cancel_owner_not_live");
  require(after.live.lease_remaining_ms > 0
      && after.live.lease_remaining_ms <= snapshot.lease_remaining_ms,
    "post_cancel_lease_changed");
  const owner_after = call([
    "--target", "current", "--grant", "observe",
    "process-state", "--pid", "" + snapshot.owner_pid
  ], "process-state");
  const child_after = call([
    "--target", "current", "--grant", "observe",
    "process-state", "--pid", "" + snapshot.child_pid
  ], "process-state");
  require(owner_after.state === "live"
      && owner_after.start_identity === snapshot.owner_start_identity,
    "post_cancel_owner_identity_changed");
  require(child_after.state === "live"
      && child_after.start_identity === snapshot.child_start_identity,
    "post_cancel_child_identity_changed");

  print("STEP explicitly stop and prove exact terminal truth plus owner and child absence");
  const stop_args = mutation_prefix(request_root + "-stop", snapshot);
  append_all(stop_args, [
    "job-stop", snapshot.job_id, "" + snapshot.generation,
    "--grace-ms", "100", "--expect-stopped"
  ]);
  const stopped = call(stop_args, "job-stop");
  require(stopped.stopped === true && stopped.job_id === snapshot.job_id
      && stopped.generation === snapshot.generation
      && stopped.status.state.kind !== "running", "job_stop_not_terminal");

  for (let poll = 0; poll < 100; poll = poll + 1) {
    terminal = call([
      "--target", "current", "--grant", "observe", "job-status", snapshot.job_id
    ], "job-status");
    if (terminal.state !== "running"
        && exact_process_absent(snapshot.child_pid, snapshot.child_start_identity)) {
      break;
    }
    time_sleep_ms(20);
  }
  require(terminal !== null && terminal.job_id === snapshot.job_id
      && terminal.generation === snapshot.generation
      && terminal.state !== "running"
      && terminal.terminal !== null
      && terminal.terminal_trigger === "explicit_stop",
    "terminal_truth_not_exact");
  require(terminal.owner_pid === snapshot.owner_pid,
    "terminal_owner_history_not_retained");
  require(exact_process_absent(snapshot.child_pid, snapshot.child_start_identity),
    "terminal_child_still_present");
  const terminal_owner = call([
    "--target", "current", "--grant", "observe",
    "process-state", "--pid", "" + snapshot.owner_pid
  ], "process-state");
  require(terminal_owner.state === "live"
      && terminal_owner.start_identity === snapshot.owner_start_identity,
    "terminal_owner_not_retained_until_session_end");

  let audit_compaction_fixture = "{malformed\n";
  for (let row = 0; row < 24; row = row + 1) {
    audit_compaction_fixture = audit_compaction_fixture + JSON.stringify({
      ts_ms: 1,
      verb: "expired-cursor-padding-" + row,
      outcome: "ok",
      detail: "x".repeat(384)
    }) + "\n";
  }
  require(fs_append_existing_durable(
    environment.AGENTERM_CU_AUDIT_PATH, audit_compaction_fixture
  ) === 0, "audit_compaction_fixture_append_failed:" + tool_result());

  print("STEP follow the opaque audit cursor into an older bounded byte window");
  let cursor = null;
  let cursor_to_invalidate = null;
  let found_spawn_audit = false;
  for (let page = 0; page < 64; page = page + 1) {
    const query_args = [
      "--target", "current", "--grant", "observe",
      "audit-query", "--request-id-filter", request_root + "-spawn",
      "--byte-max", "4096", "--max", "10"
    ];
    if (cursor !== null) {
      query_args.push("--cursor");
      query_args.push(cursor);
    }
    const older = call(query_args, "audit-query");
    if (cursor_to_invalidate === null
        && older.next_cursor !== null && older.next_cursor !== undefined) {
      cursor_to_invalidate = older.next_cursor;
    }
    if (older.returned === 2) {
      found_spawn_audit = true;
      for (const record of older.records) {
        require(record.request_id === request_root + "-spawn",
          "older_cursor_request_id_mismatch");
      }
      break;
    }
    cursor = older.next_cursor;
    if (cursor === null || cursor === undefined) { break; }
  }
  require(found_spawn_audit, "older_cursor_did_not_reach_spawn_audit");
  require(typeof cursor_to_invalidate === "string" && cursor_to_invalidate !== "",
    "older_cursor_missing_compaction_probe");

  print("STEP atomically compact the audit and reject the old opaque cursor");
  const compacted = call([
    "--target", "current", "--grant", "actuate",
    "audit-compact", "--max-age-days", "1", "--max-events", "100",
    "--max-bytes", "65536", "--apply"
  ], "audit-compact");
  require(compacted.status === "applied" && compacted.apply_required === false
      && compacted.destination_durable === true
      && compacted.malformed_dropped >= 1 && compacted.expired_dropped >= 1,
    "audit_compaction_apply_contract");
  const stale_cursor = raw_call([
    "--target", "current", "--grant", "observe",
    "audit-query", "--cursor", cursor_to_invalidate,
    "--byte-max", "4096", "--max", "10"
  ], "audit-query");
  require(stale_cursor.ok === false
      && stale_cursor.error !== null
      && stale_cursor.error.code === "audit_cursor_stale",
    "audit_compaction_reinterpreted_old_cursor");

  const end = call([
    "--target", "current", "--grant", "actuate",
    "session-end", snapshot.session_id, "--lease", snapshot.session_lease, "--confirm"
  ], "session-end");
  require(end.session !== null && end.session.session_id === snapshot.session_id
      && end.session.state === "ended", "session_cleanup_identity");
  // Session release owns the resident owner lifetime. Its cleanup is bounded
  // by five seconds; retain two seconds of observation margin.
  for (let poll = 0; poll < 350; poll = poll + 1) {
    if (exact_process_absent(snapshot.owner_pid, snapshot.owner_start_identity)) { break; }
    time_sleep_ms(20);
  }
  require(exact_process_absent(snapshot.owner_pid, snapshot.owner_start_identity),
    "session_owner_still_present");
  succeeded = true;
} catch (error) {
  failure = "" + error;
}

if (!succeeded && snapshot !== null) {
  try {
    const cleanup_args = mutation_prefix(request_root + "-cleanup-stop", snapshot);
    append_all(cleanup_args, [
      "job-stop", snapshot.job_id, "" + snapshot.generation,
      "--grace-ms", "100", "--expect-stopped"
    ]);
    call(cleanup_args, "job-stop");
  } catch (error) {
    failure = failure + ";cleanup_stop:" + error;
  }
  try {
    call([
      "--target", "current", "--grant", "actuate",
      "session-end", snapshot.session_id, "--lease", snapshot.session_lease, "--confirm"
    ], "session-end");
  } catch (error) {
    failure = failure + ";cleanup_session:" + error;
  }
}
if (!succeeded && snapshot === null && session_handoff !== null) {
  try {
    call([
      "--target", "current", "--grant", "actuate",
      "session-end", session_handoff.session_id,
      "--lease", session_handoff.lease, "--confirm"
    ], "session-end");
  } catch (error) {
    failure = failure + ";cleanup_partial_session:" + error;
  }
}
if (snapshot !== null) {
  for (let poll = 0; poll < 350; poll = poll + 1) {
    if (exact_process_absent(snapshot.owner_pid, snapshot.owner_start_identity)
        && exact_process_absent(snapshot.child_pid, snapshot.child_start_identity)) { break; }
    time_sleep_ms(20);
  }
  if (!exact_process_absent(snapshot.owner_pid, snapshot.owner_start_identity)
      || !exact_process_absent(snapshot.child_pid, snapshot.child_start_identity)) {
    failure = failure + ";cleanup_process_still_present";
    succeeded = false;
  }
}

try {
  if (rh.exists(isolated_root)) { rh.remove_dir_all(isolated_root); }
} catch (error) {
  failure = failure + ";cleanup_isolated_root:" + error;
  succeeded = false;
}
if (succeeded) {
  for (const id of declared_evidence) { harness.emit_evidence(context, declared_evidence, id); }
}
let completion_failure = "";
try { harness.complete(context, [], succeeded, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded && completion_failure === "") {
  harness.remove_run(context);
  print("PASS: embedded job-wait cooperatively cancelled; owner survived; exact terminal cleanup verified");
  return;
}
if (completion_failure !== "") { throw completion_failure; }
throw failure;
