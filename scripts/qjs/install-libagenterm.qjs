// Install Windows libagenterm artifacts into an MSVC-style prefix.
//
// Args: REPO PREFIX ARTIFACTS [LIBDIR INCLUDEDIR BINDIR]
// Ported from scripts/rh/install-libagenterm.rh; runs under `--profile tool`.
import * as rh from "lib/rh_compat";

function require_nonempty_file(path, code) {
  rh.require(rh.exists(path), code + "_missing:" + path);
  const metadata = rh.metadata(path);
  rh.require(metadata.is_file, code + "_not_file:" + path);
  rh.require(metadata.len > 0, code + "_empty:" + path);
}

const args = rh.args();
rh.require(
  args.length === 3 || args.length === 6,
  "expected: REPO PREFIX ARTIFACTS [LIBDIR INCLUDEDIR BINDIR]"
);

const repo = rh.absolute(args[0]);
const prefix = rh.absolute(args[1]);
const artifacts = rh.absolute(args[2]);
let libdir = rh.join(prefix, "lib");
let includedir = rh.join(prefix, "include");
let bindir = rh.join(prefix, "bin");
if (args.length === 6) {
  libdir = rh.absolute(args[3]);
  includedir = rh.absolute(args[4]);
  bindir = rh.absolute(args[5]);
}

const header = rh.join(repo, "include/agenterm.h");
const static_library = rh.join(artifacts, "agenterm.lib");
const dll_import_library = rh.join(artifacts, "agenterm.dll.lib");
const dynamic_library = rh.join(artifacts, "agenterm.dll");

// Validate every source before creating or changing the destination.
require_nonempty_file(header, "libagenterm_install_header");
require_nonempty_file(static_library, "libagenterm_install_static");
require_nonempty_file(dll_import_library, "libagenterm_install_import");
require_nonempty_file(dynamic_library, "libagenterm_install_dynamic");

rh.create_dir_all(includedir);
rh.create_dir_all(libdir);
rh.create_dir_all(bindir);

const installed_header = rh.join(includedir, "agenterm.h");
const installed_static = rh.join(libdir, "agenterm.lib");
const installed_link_library = rh.join(libdir, "agenterm.dll.lib");
const installed_dynamic = rh.join(bindir, "agenterm.dll");

rh.copy(header, installed_header);
rh.copy(static_library, installed_static);
rh.copy(dll_import_library, installed_link_library);
rh.copy(dynamic_library, installed_dynamic);

require_nonempty_file(installed_header, "libagenterm_installed_header");
require_nonempty_file(installed_static, "libagenterm_installed_static");
require_nonempty_file(installed_link_library, "libagenterm_installed_import");
require_nonempty_file(installed_dynamic, "libagenterm_installed_dynamic");

print("install-libagenterm: installed Windows/MSVC layout into " + prefix);
print("install-libagenterm: include=" + installed_header);
print("install-libagenterm: static=" + installed_static);
print("install-libagenterm: import=" + installed_link_library);
print("install-libagenterm: runtime=" + installed_dynamic);
return 0;
