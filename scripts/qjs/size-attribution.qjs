// Per-crate .text size attribution for one bin, via cargo-bloat.
// Moved from rh on 2026-08-29.
//
// Args:
//   REPO [PROFILE] [BIN]     (defaults: release-fast, agenterm)
//
// Writes dist/size-attribution.json and prints a top-15 table. Uses the
// dedicated target/size-report directory so the strip=none override never
// churns the shared build cache.
//
// Companion to dist/size-history.jsonl (per-artifact trend, appended by
// stage-build): history answers "did it grow", this answers "which
// crate grew". See plan/design-binary-size-and-reuse.md §5.1.
//
// Runs under `--profile tool`.
//
// GAP (door): rh also cleared the session shells' NoDefaultCurrentDirectoryInExePath
// (`env_remove`) so LuaJIT's msvcbuild can resolve its freshly linked minilua
// from the CWD on Windows. The door's command spec has `env` but no
// `env_remove`, so on a Windows host that has the variable set this port
// does not clear it. Unix hosts are unaffected.
import * as rh from "lib/rh_compat";

// Integer division without Math.floor: exact for non-negative integers.
function int_div(a, b) {
  return (a - a % b) / b;
}

const args = [];
for (let i = 0; i < arg_count(); i = i + 1) {
  if (arg(i) !== 0) { throw "arg: " + tool_result(); }
  args.push(tool_result());
}
if (args.length < 1 || args.length > 3) {
  throw "expected: REPO [PROFILE] [BIN]";
}
const repo = rh.absolute(args[0]);
let profile = "release-fast";
if (args.length >= 2) {
  profile = args[1];
}
let bin = "agenterm";
if (args.length === 3) {
  bin = args[2];
}
let strip_env = "";
if (profile === "release-fast") {
  strip_env = "CARGO_PROFILE_RELEASE_FAST_STRIP";
} else if (profile === "con-release-fast") {
  strip_env = "CARGO_PROFILE_CON_RELEASE_FAST_STRIP";
} else if (profile === "release") {
  strip_env = "CARGO_PROFILE_RELEASE_STRIP";
} else if (profile === "con-release") {
  strip_env = "CARGO_PROFILE_CON_RELEASE_STRIP";
} else if (profile === "dev") {
  strip_env = "CARGO_PROFILE_DEV_STRIP";
} else {
  throw "size_attribution_profile_invalid:" + profile;
}
const dist = rh.join(repo, "dist");
rh.create_dir_all(dist);
const stdout_path = rh.join(dist, ".size-attribution.stdout.tmp");

// cargo-bloat needs symbols to attribute; strip only for this target
// dir, which exists solely for size analysis.
const child_env = {
  CARGO_TARGET_DIR: rh.join(repo, "target/size-report")
};
child_env[strip_env] = "none";
const options = {
  cwd: repo,
  env: child_env,
  timeout_ms: 1200000
};

const cargo_args = ["bloat", "--profile", profile];
cargo_args.push("--bin");
cargo_args.push(bin);
cargo_args.push("--crates");
cargo_args.push("-n");
cargo_args.push("0");
cargo_args.push("--message-format");
cargo_args.push("json");
const code = rh.command_stdout_file("cargo", cargo_args, stdout_path, options);
rh.require(
  code === 0,
  "size_attribution_cargo_bloat_failed (is cargo-bloat installed? `cargo install cargo-bloat`)"
);
const text = rh.read_text(stdout_path);
rh.try_remove_file(stdout_path);
rh.require(text.startsWith("{"), "size_attribution_output_not_json");
const report = JSON.parse(text);
// Kept as rh computed it: the .text total is the sum of per-crate sizes,
// and the file size is the artifact on disk (rh could not index
// cargo-bloat's hyphenated total keys; this stays byte-identical to it).
let text_size = 0;
for (const entry of report.crates) {
  text_size = text_size + entry.size;
}
rh.require(text_size > 0, "size_attribution_text_size_zero");
const built = rh.join(
  rh.join(rh.join(repo, "target/size-report"), profile),
  bin + ".exe"
);
let file_size = 0;
if (rh.exists(built)) {
  file_size = rh.metadata(built).len;
}

const commit_stdout = rh.join(dist, ".size-attribution.commit.tmp");
let commit = "unknown";
if (rh.command_stdout_file(
  "git",
  ["-C", repo, "rev-parse", "HEAD"],
  commit_stdout,
  { timeout_ms: 10000 }
) === 0) {
  commit = rh.read_text(commit_stdout).trim();
}
rh.try_remove_file(commit_stdout);

let note = "symbols kept (strip=none) for attribution; shipped strip=true " +
  "binaries are smaller than file_size here";
if (profile === "con-release-fast" || profile === "con-release") {
  note = "symbols kept (strip=none) and host std used for attribution; " +
    "official con staging also uses its custom-std path, so crate ranks " +
    "are comparable but file_size is not release evidence";
}
const output = {
  kind: "agenterm-size-attribution",
  schema_version: 1,
  git_commit: commit,
  profile: profile,
  bin: bin,
  note: note,
  file_size: file_size,
  text_section_size: text_size,
  crates: report.crates
};
const output_path = rh.join(dist, "size-attribution.json");
rh.write_text(output_path, JSON.stringify(output));

print("size-attribution: " + bin + " (" + profile + ", strip=none)");
print("  file " + file_size + " B, .text " + text_size + " B");
let shown = 0;
for (const entry of report.crates) {
  if (shown >= 15) {
    break;
  }
  shown = shown + 1;
  let name = "" + entry.name;
  if (name === "") {
    name = "(no-crate C: LuaJIT/QuickJS/SQLite)";
  }
  const size = entry.size;
  const tenths = int_div(size * 1000, text_size);
  print(
    "  " + int_div(tenths, 10) + "." + (tenths % 10) + "%  " +
      size + " B  " + name
  );
}
print("  full list: " + output_path);
return 0;
