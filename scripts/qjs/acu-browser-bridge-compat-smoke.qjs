// Pure public court for legacy browser bridge/status, exact MV3 navigation and
// explicit-CDP compatibility projections. It owns no GUI, browser, process or
// network effects; every native reply below is synthetic.
// Args: REPO | --list-evidence
import * as compat from "skills/acu/lib/compat";
import * as compound from "skills/acu/lib/compound";
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["acu.compat-browser-bridge"];
const CONNECTION_A = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
const CONNECTION_B = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
const PROFILE_A = "11111111111111111111111111111111";
const PROFILE_B = "22222222222222222222222222222222";

function ensure(condition, message) { if (!condition) { throw message; } }

function same_array(actual, expected, label) {
  ensure(Array.isArray(actual) && actual.length === expected.length,
    label + "_length");
  for (let i = 0; i < expected.length; i = i + 1) {
    ensure(actual[i] === expected[i], label + "_item_" + i);
  }
}

function connection(id, pid) {
  return {
    connection_id: id,
    process: { pid: pid, start_identity: "start-" + pid },
    endpoint: { extension_id: "knofdkmmpkbnjhdkcjddbakbpmgpmjpe" }
  };
}

function connections_reply(rows, truncated) {
  return { ok: true, data: {
    visited: rows.length,
    truncated: truncated === true,
    connections: rows
  } };
}

function status_reply(connection_id, profile_id, version) {
  return { ok: true, data: {
    connection_id: connection_id,
    result: {
      protocol: 4,
      extension_id: "knofdkmmpkbnjhdkcjddbakbpmgpmjpe",
      extension_version: version,
      profile_instance_id: profile_id,
      commands: ["status", "tabs", "windows", "window-open", "window-state"]
    }
  } };
}

function targets_reply(rows) {
  return { ok: true, data: {
    backend: "chromium-cdp",
    port: 9333,
    via: "/json",
    targets: rows
  } };
}

function target(id, type, title) {
  return {
    id: id,
    type: type,
    title: title,
    url: "data:text/html," + title,
    description: ""
  };
}

function tabs_reply(rows, profile_selector, tab_id, match_text) {
  return { ok: true, data: {
    mechanism: "mv3-native-messaging",
    connection_id: CONNECTION_A,
    profile_instance_id: PROFILE_A,
    selection: {
      profile_instance_id: profile_selector,
      connection_id: null,
      match: match_text,
      tab_id: tab_id
    },
    returned: rows.length,
    truncated: false,
    tabs: rows,
    focus: false,
    focus_changed: false,
    verified: true
  } };
}

function bridge_tab(tab_id, window_id) {
  return {
    tab_id: tab_id,
    window_id: window_id,
    active: false,
    title: "Guide",
    url: "https://example.test/before"
  };
}

function nav_reply(tab_id, url) {
  return { ok: true, target: "current", command: "browser-bridge-nav", data: {
    connection_id: CONNECTION_A,
    tab: { tab_id: tab_id, window_id: 44, active: false },
    result: {
      tab_id: tab_id,
      requested_url: url,
      committed_url: url,
      observed_url: url,
      observed_title: "Committed title",
      observed_truncated: false,
      navigation_kind: "cross-document",
      frame_id: "frame-1",
      loader_id: "loader-1",
      committed_url_equals_requested: true,
      unreachable_url: null,
      load_event_fired: true,
      load_state: "complete",
      same_document_navigations: 0,
      performed: true,
      verified: true,
      presentation: {
        activation_requested: false,
        tab_active_before: false,
        tab_active_after: false,
        window_focused_before: false,
        window_focused_after: false
      },
      detach: { outcome: "detached" }
    },
    lock: { lock_id: "lock-1", target_redacted: true },
    lock_after: { lock_id: "lock-1", target_redacted: true },
    desktop_focus: { before: 9001, after: 9001, changed: false, verified: true },
    verified: true
  }, receipt: { request_id: "nav-1", state: "completed" } };
}

function window_open_reply(connection_id, state, focused, desktop_after) {
  return { ok: true, data: {
    connection_id: connection_id,
    desktop_focus: {
      before: 9001,
      after_effect: desktop_after,
      after: desktop_after,
      restored: false,
      verified: true
    },
    result: {
      requested_focused: false,
      requested_state: state,
      performed: true,
      verified: true,
      focus_changed: false,
      focused_window_before: 3,
      focused_window_after: 3,
      window: {
        window_id: 44,
        state: state,
        focused: focused,
        bounds: { left: 1, top: 2, width: 800, height: 600 },
        tab_count: 1,
        active_tab_id: 55,
        active_tab_title: "Legacy open"
      }
    }
  } };
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 1, "expected: REPO");
const context = harness.new_context(rh.absolute(args[0]), "acu-browser-bridge-compat");
let succeeded = 0;
let failure = "";

try {
  const status_default = compat.canonicalize(["browser", "bridge", "status"]);
  ensure(status_default.kind === "bridge-status" && status_default.profile === null,
    "acu_browser_bridge_status_default_route");
  const status_profile = compat.canonicalize([
    "browser", "bridge", "status", "--profile", PROFILE_A.substring(0, 8)
  ]);
  ensure(status_profile.kind === "bridge-status"
      && status_profile.profile === PROFILE_A.substring(0, 8),
    "acu_browser_bridge_status_profile_route");
  const human_profile = compat.canonicalize([
    "browser", "bridge", "status", "--profile", "Default"
  ]);
  ensure(human_profile.kind === "todo"
      && human_profile.gap_id === "acu.dynamic.075.profile-name-binding",
    "acu_browser_bridge_human_profile_typed");

  const matched_nav = compat.canonicalize([
    "browser", "nav", "https://example.test/next", "--port", "9333",
    "--match", "Guide"
  ]);
  ensure(matched_nav.kind === "exec", "acu_browser_cdp_nav_match_route");
  same_array(matched_nav.argv,
    ["--target", "current", "--grant", "observe,actuate", "page-nav",
      "--port", "9333", "--match", "Guide", "--url", "https://example.test/next"],
    "acu_browser_cdp_nav_match_argv");
  const port_precedence = compat.canonicalize([
    "browser", "nav", "https://example.test/next", "--port", "9333",
    "--pid", "42", "--match", "Guide", "--profile", "Default",
    "--app", "brave", "--allow-foreground"
  ]);
  ensure(port_precedence.kind === "exec", "acu_browser_cdp_nav_port_precedence_route");
  same_array(port_precedence.argv,
    ["--target", "current", "--grant", "observe,actuate", "page-nav",
      "--port", "9333", "--match", "Guide", "--url", "https://example.test/next"],
    "acu_browser_cdp_nav_port_precedence_argv");
  const unique_nav = compat.canonicalize([
    "browser", "nav", "https://example.test/next", "--pid", "42"
  ]);
  ensure(unique_nav.kind === "cdp-nav" && unique_nav.url === "https://example.test/next",
    "acu_browser_cdp_nav_unique_route");
  same_array(unique_nav.transport, ["--pid", "42"],
    "acu_browser_cdp_nav_unique_transport");
  const bridge_nav = compat.canonicalize([
    "--request-id", "nav-1", "--session", "session-1",
    "--session-lease", "lease-1", "browser", "nav",
    "https://example.test/next", "--tab-id", "55",
    "--profile", PROFILE_A.substring(0, 8)
  ]);
  ensure(bridge_nav.kind === "bridge-nav"
      && bridge_nav.url === "https://example.test/next"
      && bridge_nav.tab_id === 55
      && bridge_nav.profile === PROFILE_A.substring(0, 8),
    "acu_browser_bridge_nav_route");
  same_array(bridge_nav.globals, [
    "--target", "current", "--grant", "observe,actuate",
    "--request-id", "nav-1", "--session", "session-1",
    "--session-lease", "lease-1"
  ], "acu_browser_bridge_nav_globals");
  const bridge_nav_unique = compat.canonicalize([
    "browser", "nav", "https://example.test/only"
  ]);
  ensure(bridge_nav_unique.kind === "bridge-nav"
      && bridge_nav_unique.tab_id === null
      && bridge_nav_unique.profile === null
      && bridge_nav_unique.match === null,
    "acu_browser_bridge_nav_unique_inventory_route");
  const bridge_nav_match = compat.canonicalize([
    "browser", "nav", "https://example.test/matched", "--match", "Guide"
  ]);
  ensure(bridge_nav_match.kind === "bridge-nav"
      && bridge_nav_match.match === "Guide",
    "acu_browser_bridge_nav_match_route");
  ensure(compat.canonicalize([
    "browser", "nav", "file:///tmp/not-allowed", "--tab-id", "55"
  ]).kind === "usage", "acu_browser_bridge_nav_http_only");
  ensure(compat.canonicalize([
    "browser", "nav", "https://example.test/next", "--profile", "Default"
  ]).gap_id === "acu.dynamic.075.profile-name-binding",
  "acu_browser_bridge_nav_human_profile_stays_typed");
  ensure(compat.canonicalize([
    "browser", "nav", "https://example.test/next", "--app", "brave"
  ]).gap_id === "acu.dynamic.075.profile-name-binding",
  "acu_browser_bridge_nav_app_stays_typed");
  const foreground_nav = compat.canonicalize([
    "browser", "nav", "https://example.test/next", "--allow-foreground"
  ]);
  ensure(foreground_nav.kind === "usage"
      && foreground_nav.message.indexOf("page-nav") >= 0,
    "acu_browser_foreground_nav_is_permanent_usage");
  const legacy_open = compat.canonicalize([
    "browser", "open", "https://example.test/background"
  ]);
  ensure(legacy_open.kind === "bridge-open"
      && legacy_open.url === "https://example.test/background"
      && legacy_open.profile === null,
    "acu_browser_open_atomic_bridge_route");
  const selected_open = compat.canonicalize([
    "browser", "open", "https://example.test/background",
    "--profile", PROFILE_A.substring(0, 8), "--timeout", "22000"
  ]);
  ensure(selected_open.kind === "bridge-open"
      && selected_open.profile === PROFILE_A.substring(0, 8)
      && selected_open.legacy_timeout === "22000",
    "acu_browser_open_profile_prefix_and_timeout");
  ensure(compat.canonicalize([
    "browser", "open", "https://example.test/background",
    "--profile", "Default"
  ]).gap_id === "acu.dynamic.075.profile-name-binding",
  "acu_browser_open_human_profile_stays_typed");
  ensure(compat.canonicalize([
    "browser", "open", "https://example.test/background", "--app", "brave"
  ]).gap_id === "acu.dynamic.075.profile-name-binding",
  "acu_browser_open_app_selector_stays_typed");
  ensure(compat.canonicalize([
    "browser", "open", "https://example.test/a", "extra"
  ]).kind === "usage", "acu_browser_open_exact_shape");

  const selected_nav = compound.bridge_nav_tab(tabs_reply(
    [bridge_tab(55, 44)], PROFILE_A.substring(0, 8), 55, null),
    55, PROFILE_A.substring(0, 8), null);
  ensure(selected_nav.ok === true
      && selected_nav.value.connection_id === CONNECTION_A
      && selected_nav.value.profile_instance_id === PROFILE_A
      && selected_nav.value.tab_id === 55
      && selected_nav.value.window_id === 44,
    "acu_browser_bridge_nav_exact_tab_" + selected_nav.code);
  const unique_nav_tab = compound.bridge_nav_tab(tabs_reply(
    [bridge_tab(55, 44)], null, null, null), null, null, null);
  ensure(unique_nav_tab.ok === true && unique_nav_tab.value.tab_id === 55,
    "acu_browser_bridge_nav_unique_inventory_" + unique_nav_tab.code);
  const matched_nav_tab = compound.bridge_nav_tab(tabs_reply(
    [bridge_tab(55, 44)], null, null, "Guide"), null, null, "Guide");
  ensure(matched_nav_tab.ok === true && matched_nav_tab.value.tab_id === 55,
    "acu_browser_bridge_nav_match_inventory_" + matched_nav_tab.code);
  ensure(compound.bridge_nav_tab(tabs_reply([
    bridge_tab(55, 44), bridge_tab(56, 44)
  ], null, null, null), null, null, null).code === "browser_bridge_tab_ambiguous",
  "acu_browser_bridge_nav_ambiguous_typed");
  const truncated_nav = tabs_reply([bridge_tab(55, 44)], null, null, null);
  truncated_nav.data.truncated = true;
  ensure(compound.bridge_nav_tab(truncated_nav, null, null, null).code
      === "browser_bridge_tabs_inventory_truncated",
    "acu_browser_bridge_nav_truncated_typed");
  ensure(compound.bridge_nav_tab(tabs_reply(
    [bridge_tab(56, 44)], null, 55, null), 55, null, null).code
      === "browser_bridge_nav_selection_invalid",
    "acu_browser_bridge_nav_mismatch_typed");

  const nav_native = nav_reply(55, "https://example.test/next");
  const nav_projected = compound.bridge_nav_projection(selected_nav.value, nav_native);
  ensure(nav_projected.ok === true
      && nav_projected.value.transport === "native-bridge"
      && nav_projected.value.background === true
      && nav_projected.value.result.requested_url === "https://example.test/next"
      && nav_projected.value.result.committed_url === "https://example.test/next"
      && nav_projected.value.result.observed_url === "https://example.test/next"
      && nav_projected.value.result.navigation_kind === "cross-document"
      && nav_projected.value.result.loader_id === "loader-1"
      && nav_projected.value.result.detach.outcome === "detached"
      && nav_projected.value.result.presentation.activation_requested === false
      && nav_projected.value.lock.lock_id === "lock-1"
      && nav_native.receipt.request_id === "nav-1",
    "acu_browser_bridge_nav_projection_" + nav_projected.code);
  const native_nav_failure = {
    ok: false,
    target: "current",
    command: "browser-bridge-nav",
    data: null,
    error: {
      code: "browser_bridge_outcome_unknown",
      message: "the bridge effect cannot be proved",
      detail: { effect: "unknown", retry_safe: false }
    }
  };
  const preserved_nav_failure = compound.bridge_nav_projection(
    selected_nav.value, native_nav_failure);
  ensure(preserved_nav_failure.ok === false
      && JSON.stringify(preserved_nav_failure.native_reply)
        === JSON.stringify(native_nav_failure),
    "acu_browser_bridge_nav_native_failure_preserved");
  const incomplete_nav = nav_reply(55, "https://example.test/next");
  incomplete_nav.data.lock_after = null;
  ensure(compound.bridge_nav_projection(selected_nav.value, incomplete_nav).code
      === "browser_bridge_nav_projection_invalid",
    "acu_browser_bridge_nav_incomplete_proof_typed");

  const inventory = connections_reply([
    connection(CONNECTION_A, 101), connection(CONNECTION_B, 202)
  ], false);
  const statuses = {};
  statuses[CONNECTION_A] = status_reply(CONNECTION_A, PROFILE_A, "1.4.0");
  statuses[CONNECTION_B] = status_reply(CONNECTION_B, PROFILE_B, "1.4.0");
  const selected = compound.bridge_select_connection(
    inventory, statuses, PROFILE_A.substring(0, 8));
  ensure(selected.ok === true, "acu_browser_bridge_status_selection_" + selected.code);
  const projected = compound.bridge_status_projection(selected.value, inventory);
  ensure(projected.ok === true, "acu_browser_bridge_status_projection_" + projected.code);
  const view = projected.value;
  ensure(view.connected === true && view.ready === true && view.diagnosis === null
      && view.connection.connection_id === CONNECTION_A
      && view.connection.profile_instance_id === PROFILE_A
      && view.connection.pid === 101,
    "acu_browser_bridge_status_exact_identity");
  ensure(Array.isArray(view.connections) && view.connections.length === 2
      && view.connections[0].connection_id === CONNECTION_A
      && view.connections[1].connection_id === CONNECTION_B,
    "acu_browser_bridge_status_complete_inventory");
  ensure(view.version.protocol === 4 && view.version.extension_version === "1.4.0"
      && view.version.current === true,
    "acu_browser_bridge_status_version");
  ensure(view.installed === undefined && view.manifests === undefined
      && view.facts_withheld.length === 5,
    "acu_browser_bridge_status_withholds_unobserved_installation_facts");
  same_array(view.commands,
    ["status", "tabs", "windows", "window-open", "window-state"],
    "acu_browser_bridge_status_commands");

  const opened = compound.bridge_window_open_projection(selected.value,
    window_open_reply(CONNECTION_A, "minimized", false, 9001), "22000");
  ensure(opened.ok === true && opened.value.connection_id === CONNECTION_A
      && opened.value.profile_instance_id === PROFILE_A
      && opened.value.window_id === 44 && opened.value.tab_id === 55
      && opened.value.state === "minimized" && opened.value.focused === false
      && opened.value.transient_normal_window === false
      && opened.value.legacy_timeout_ignored === true,
    "acu_browser_open_atomic_projection_" + opened.code);
  const normal_open = compound.bridge_window_open_projection(selected.value,
    window_open_reply(CONNECTION_A, "normal", false, 9001), null);
  ensure(normal_open.code === "browser_open_postcondition_failed",
    "acu_browser_open_requires_direct_minimized_state");
  const focus_drift = compound.bridge_window_open_projection(selected.value,
    window_open_reply(CONNECTION_A, "minimized", false, 9002), null);
  ensure(focus_drift.code === "browser_open_postcondition_failed",
    "acu_browser_open_requires_desktop_focus_receipt");
  const native_open_failure = {
    ok: false,
    target: "current",
    command: "browser-bridge-window-open",
    data: null,
    error: {
      code: "browser_bridge_outcome_unknown",
      message: "the bridge effect cannot be proved",
      count: 1,
      detail: {
        effect: "unknown",
        retry_safe: false,
        recovery: { attempted: true, verified: false }
      }
    }
  };
  const preserved_open_failure = compound.bridge_window_open_projection(
    selected.value, native_open_failure, null);
  ensure(preserved_open_failure.ok === false
      && JSON.stringify(preserved_open_failure.native_reply)
        === JSON.stringify(native_open_failure),
    "acu_browser_open_native_effect_failure_preserved");

  const ambiguous_default = compound.bridge_select_connection(inventory, statuses, null);
  ensure(ambiguous_default.code === "browser_bridge_profile_connection_ambiguous",
    "acu_browser_bridge_status_default_ambiguous");
  const absent_profile = compound.bridge_select_connection(inventory, statuses, "33333333");
  ensure(absent_profile.code === "browser_bridge_profile_connection_not_found",
    "acu_browser_bridge_status_profile_not_found");
  const truncated_statuses = {};
  truncated_statuses[CONNECTION_A] = status_reply(CONNECTION_A, PROFILE_A, "1.4.0");
  const truncated = compound.bridge_select_connection(
    connections_reply([connection(CONNECTION_A, 101)], true),
    truncated_statuses, PROFILE_A.substring(0, 8));
  ensure(truncated.code === "browser_bridge_connection_inventory_truncated",
    "acu_browser_bridge_status_truncated_typed");
  const duplicate_statuses = {};
  duplicate_statuses[CONNECTION_A] = status_reply(CONNECTION_A, PROFILE_A, "1.4.0");
  duplicate_statuses[CONNECTION_B] = status_reply(CONNECTION_B, PROFILE_A, "1.4.0");
  const duplicate_profile = compound.bridge_select_connection(
    inventory, duplicate_statuses, PROFILE_A.substring(0, 8));
  ensure(duplicate_profile.code === "browser_bridge_profile_connection_ambiguous",
    "acu_browser_bridge_status_duplicate_profile_typed");
  const native_status_error = compound.bridge_select_connection(
    { ok: false, error: { code: "browser_bridge_registry_unavailable", message: "registry" } },
    {}, null);
  ensure(native_status_error.code === "browser_bridge_registry_unavailable",
    "acu_browser_bridge_status_native_error_passthrough");

  const one_page = compound.cdp_nav_target(targets_reply([
    target("worker-1", "service_worker", "worker"),
    target("page-1", "page", "Guide")
  ]));
  ensure(one_page.ok === true && one_page.value.target_id === "page-1",
    "acu_browser_cdp_nav_unique_page");
  const no_page = compound.cdp_nav_target(targets_reply([
    target("worker-1", "service_worker", "worker")
  ]));
  ensure(no_page.code === "page_target_ambiguous",
    "acu_browser_cdp_nav_no_page_typed");
  const many_pages = compound.cdp_nav_target(targets_reply([
    target("page-1", "page", "One"), target("page-2", "page", "Two")
  ]));
  ensure(many_pages.code === "page_target_ambiguous",
    "acu_browser_cdp_nav_many_pages_typed");
  const malformed_target = compound.cdp_nav_target({ ok: true, data: { targets: null } });
  ensure(malformed_target.code === "page_targets_shape_invalid",
    "acu_browser_cdp_nav_target_inventory_required");
  const native_target_error = compound.cdp_nav_target({
    ok: false, error: { code: "cdp_connection_failed", message: "endpoint" }
  });
  ensure(native_target_error.code === "cdp_connection_failed",
    "acu_browser_cdp_nav_native_error_passthrough");

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "acu.compat-browser-bridge");
  harness.remove_run(context);
  print("PASS: legacy browser status, atomic background open, MV3 navigation and explicit CDP navigation stay exact and typed");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
