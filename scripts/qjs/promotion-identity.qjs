// Build the exact, recoverable GitHub Release draft identity from one sealed
// Candidate manifest. GitHub API calls remain thin workflow adapters.
//
// Args: CANDIDATE_MANIFEST CANDIDATE_RUN_ID SOURCE_SHA OUTPUT_JSON
// Ported from scripts/rh/promotion-identity.rh; runs under `--profile tool`.
import * as rh from "lib/rh_compat";

function assert_ok(condition, message) {
  // rh's `condition == 0`: the 0/1 helpers below and plain booleans both
  // fail on a falsy value.
  if (!condition) { throw message; }
}

function promotion_lowercase_hex(value, length) {
  if (value.length !== length) { return 0; }
  // No character indexing in this engine: strip the allowed alphabet instead.
  return rh.only_chars(value, rh.HEX) ? 1 : 0;
}

function promotion_decimal(value) {
  if (value === "") { return 0; }
  return rh.only_chars(value, rh.DIGITS) ? 1 : 0;
}

function promotion_allowed_mac_channel(channel) {
  if (channel === "release") { return 1; }
  if (channel === "macos-unsigned-preview") { return 1; }
  return 0;
}

const args = rh.args();
if (args.length !== 4) { throw "promotion_identity_arguments"; }
const manifest_path = rh.absolute(args[0]);
const candidate_run_id = args[1];
const source_sha = args[2];
const output = rh.absolute(args[3]);
assert_ok(
  rh.exists(manifest_path) && rh.metadata(manifest_path).is_file,
  "promotion_identity_manifest_missing"
);
assert_ok(promotion_decimal(candidate_run_id), "promotion_identity_run_id");
assert_ok(promotion_lowercase_hex(source_sha, 40), "promotion_identity_source_sha");

const manifest = rh.parse_file(manifest_path);
// rh's `0 + manifest.run.id` coerced to an integer; in JS `0 + "12"` would
// concatenate, so this is `Number`.
const run_id = Number(manifest.run.id);
assert_ok(
  manifest.schema_version === 1
    && manifest.product === "AgenTerm"
    && manifest.source_sha === source_sha
    && ("" + run_id) === candidate_run_id
    && manifest.version !== ""
    && manifest.expected_tag === "v" + manifest.version
    && rh.is_array(manifest.assets),
  "promotion_identity_manifest"
);
const channels = [];
for (const asset of manifest.assets) {
  const asset_os = "" + asset.os;
  const asset_channel = "" + asset.channel;
  if (asset_os === "macos" && !rh.array_has(channels, asset_channel)) {
    channels.push(asset_channel);
  }
}
assert_ok(channels.length === 1, "promotion_identity_macos_channels");
const mac_channel = channels[0];
assert_ok(promotion_allowed_mac_channel(mac_channel), "promotion_identity_macos_channel");

const manifest_sha256 = rh.sha256_file(manifest_path);
const marker =
  "<!-- agenterm-promotion:v1 candidate_run_id=" + candidate_run_id +
  " source_sha=" + source_sha +
  " manifest_sha256=" + manifest_sha256 +
  " mac_channel=" + mac_channel + " -->";
let body =
  marker + "\n\n" +
  "## AgenTerm " + manifest.expected_tag + "\n\n" +
  "Promoted from verified Candidate run `" + candidate_run_id +
  "` for source\n`" + source_sha +
  "`. Downloadable assets are bound to the Candidate\nmanifest `" +
  manifest_sha256 + "`.";
if (mac_channel === "macos-unsigned-preview") {
  body = body +
    "\n\n## macOS unsigned preview — not the stable macOS channel\n\n" +
    "Assets whose names end in `-macos-*-unsigned-preview.zip` are not\n" +
    "signed with an Apple Developer ID and are not notarized by Apple.\n" +
    "Verify the adjacent SHA-256 and provenance files, then read the\n" +
    "downloadable `MACOS_UNSIGNED_PREVIEW_README.md` before opening.\n" +
    "Do not disable Gatekeeper globally or recursively remove quarantine.";
}

const body_digest_path = output + ".body.tmp";
rh.atomic_write(body_digest_path, body);
const body_sha256 = rh.sha256_file(body_digest_path);
rh.try_remove_file(body_digest_path);
const identity = {
  schema_version: 1,
  kind: "agenterm-promotion-identity",
  marker: marker,
  body: body,
  body_sha256: body_sha256,
  candidate_run_id: candidate_run_id,
  source_sha: source_sha,
  version: manifest.version,
  tag: manifest.expected_tag,
  manifest_sha256: manifest_sha256,
  mac_channel: mac_channel
};
rh.atomic_write(output, rh.stringify_pretty(identity) + "\n");
return;
