// Platform-neutral public black-box journey for native `network-interfaces`.
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.network-interfaces"];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function invoke(run_directory, executable, arguments, expect_success) {
  const receipt_path = rh.join(run_directory, "cu-receipts.jsonl");
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: {
      AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
      AGENTERM_CU_RECEIPT_PATH: receipt_path
    },
    timeout_ms: 30000
  });
  ensure(output.success === expect_success, "cu_network_interfaces_exit:" + output.exit_code);
  const reply = JSON.parse(output.stdout.trim());
  ensure(reply.ok === expect_success, "cu_network_interfaces_reply_state");
  ensure(!rh.exists(receipt_path) || rh.read_text(receipt_path).trim() === "", "cu_network_interfaces_effect_receipt_created");
  return reply;
}

function assert_payload(reply, max) {
  ensure(reply.command === "network-interfaces" && reply.target === "current", "cu_network_interfaces_identity");
  const data = reply.data;
  ensure(
    Array.isArray(data.interfaces)
      && data.returned === data.interfaces.length
      && data.returned <= max
      && data.visited >= data.returned
      && data.response_ceiling_bytes === 1048576
      && typeof data.provider === "string"
      && data.provider.length > 0,
    "cu_network_interfaces_counts_or_provider"
  );
  for (const row of data.interfaces) {
    ensure(
      typeof row.name === "string"
        && row.name.length > 0
        && (row.family === "IPv4" || row.family === "IPv6")
        && typeof row.address === "string"
        && row.address.length > 0
        && typeof row.native_id === "string"
        && row.native_id.length > 0
        && (row.native_id_kind === "ifindex" || row.native_id_kind === "adapter-luid")
        && Array.isArray(row.unavailable_fields),
      "cu_network_interfaces_row_schema"
    );
    for (const field of row.unavailable_fields) {
      ensure(row[field] === null, "cu_network_interfaces_unavailable_field:" + field);
    }
  }
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!direct_file(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(direct_file(executable), "cu_network_interfaces_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-network-interfaces");
let succeeded = 0;
let failure = "";
try {
  print("STEP canonical interface inventory is native, bounded and schema-complete");
  const canonical = invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "observe", "network-interfaces", "--max", "2"
  ], true);
  assert_payload(canonical, 2);

  print("STEP grouped alias preserves the same bounded public schema");
  const alias = invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "observe", "network", "interfaces", "--max", "1"
  ], true);
  assert_payload(alias, 1);

  print("STEP invalid max fails before native enumeration");
  const invalid = invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "observe", "network-interfaces", "--max", "0"
  ], false);
  ensure(invalid.error.code === "usage", "cu_network_interfaces_invalid_limit_code");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.network-interfaces");
  harness.remove_run(context);
  print("PASS: agenterm-cu native bounded network interface inventory");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
