// Public CLI black box for legacy compatibility gaps and one repaired
// read-only plan. TODO cases are intercepted before native dispatch; the
// signal-plan case reaches the shared typed planner without consent or effect.
//
// Args: AGENTERM_LAUNCHER
import * as rh from "lib/rh_compat";

function require_ok(condition, message) {
  if (!condition) { throw message; }
}

function invoke(launcher, argv, expected_exit) {
  const command = ["cli", "acu"];
  for (let i = 0; i < argv.length; i = i + 1) { command.push(argv[i]); }
  const result = rh.command(launcher, command, {
    env: { AGENTERM_NO_ACTIVATE: "1" }, timeout_ms: 30000
  });
  require_ok(!result.timed_out && result.exit_code === expected_exit,
    "acu_compat_exit:" + argv[0] + ":" + result.stderr);
  return JSON.parse(result.stdout.trim());
}

function run(launcher, argv) {
  return invoke(launcher, argv, 2);
}

function require_todo(launcher, argv, gap_id) {
  const reply = run(launcher, argv);
  require_ok(reply.ok === false && reply.alert === "ACU_CAPABILITY_TODO",
    "acu_compat_alert:" + gap_id);
  require_ok(reply.error !== null && reply.error.code === "acu_todo"
      && reply.error.gap_id === gap_id,
    "acu_compat_gap:" + gap_id + ":" + JSON.stringify(reply));
  require_ok(reply.error.todo !== null && reply.error.todo.id === gap_id
      && reply.error.todo.status === "open",
    "acu_compat_todo:" + gap_id);
}

const args = rh.args();
require_ok(args.length === 1, "expected: AGENTERM_LAUNCHER");
const launcher = rh.absolute(args[0]);
require_ok(rh.exists(launcher) && rh.metadata(launcher).is_file,
  "acu_compat_launcher_missing");

const cases = [
  [["drag", "10", "20", "30", "40", "--to", "Window#1"], "acu.dynamic.004"]
];
for (let i = 0; i < cases.length; i = i + 1) {
  require_todo(launcher, cases[i][0], cases[i][1]);
}

const bridge_reload_identity = run(launcher, [
  "browser", "bridge", "reload", "--profile", "11111111"
]);
require_ok(bridge_reload_identity.ok === false
    && bridge_reload_identity.alert === undefined
    && bridge_reload_identity.error.code === "request_identity_required",
  "legacy bridge reload must require explicit durable request identity");

const bridge_status = invoke(launcher, ["browser", "bridge", "status"], 1);
require_ok(bridge_status.ok === false && bridge_status.command === "browser"
    && bridge_status.error.code !== "usage"
    && bridge_status.error.code !== "acu_todo",
  "legacy bridge status must reach exact native connection inventory:"
    + JSON.stringify(bridge_status));

const bridge_setup_refused = invoke(launcher, [
  "--grant", "observe", "browser", "bridge", "setup", "--app", "chrome"
], 1);
require_ok(bridge_setup_refused.ok === false
    && bridge_setup_refused.command === "browser-bridge-setup"
    && bridge_setup_refused.error.code === "refused",
  "legacy bridge setup must reach native authorization before filesystem effects:"
    + JSON.stringify(bridge_setup_refused));

const storage_rejections = [
  ["storage", "mount", "disk-1"],
  ["storage", "unmount", "disk-1"],
  ["storage", "eject", "disk-1"]
];
for (let i = 0; i < storage_rejections.length; i = i + 1) {
  const reply = run(launcher, storage_rejections[i]);
  require_ok(reply.ok === false && reply.alert === undefined
      && reply.error.code === "usage"
      && reply.error.message.indexOf("storage devices") >= 0
      && reply.error.message.indexOf("storage-volumes") >= 0,
    "legacy storage rejection must stay local:" + JSON.stringify(reply));
}

const storage_volumes = invoke(launcher, ["storage", "volumes", "--max", "5"], 0);
require_ok(storage_volumes.ok === true && storage_volumes.command === "storage-volumes",
  "native storage volumes alias must remain reachable:" + JSON.stringify(storage_volumes));

const resource_volumes = invoke(launcher, ["resource", "volumes"], 0);
require_ok(resource_volumes.ok === true && resource_volumes.command === "storage-volumes"
    && resource_volumes.data.volumes.length <= 500,
  "legacy resource volumes must reach the bounded native provider:"
    + JSON.stringify(resource_volumes));

const resource_disk = invoke(launcher, ["resource", "disk", "."], 0);
require_ok(resource_disk.ok === true && resource_disk.command === "storage-volume-at"
    && resource_disk.data.path_kind === "directory"
    && resource_disk.data.mutation_performed === false,
  "legacy resource disk must reach the exact path-bound native provider:"
    + JSON.stringify(resource_disk));

const elements_projection = invoke(launcher, ["elements", "Window#1"], 1);
require_ok(elements_projection.ok === false
    && elements_projection.command === "query"
    && elements_projection.error.code !== "usage",
  "legacy elements must reach the native query provider:" + JSON.stringify(elements_projection));

const page_elements = invoke(launcher, [
  "elements", "Window#1", "--page", "--tab-id", "2147483647"
], 1);
require_ok(page_elements.ok === false && page_elements.command === "browser-tabs"
    && page_elements.error.code !== "usage"
    && page_elements.error.code !== "acu_todo",
  "legacy page elements must preserve the exact native provider failure:"
    + JSON.stringify(page_elements));

const observe_projection = invoke(launcher, [
  "observe", "Window#1", "--action", "press"
], 1);
require_ok(observe_projection.ok === false
    && observe_projection.command === "observe"
    && observe_projection.error.code !== "usage"
    && observe_projection.error.code !== "acu_todo",
  "legacy observe filters must reach the native observer:" + JSON.stringify(observe_projection));

const zoom_projection = invoke(launcher, [
  "zoom", "Window#4294967295", "--x1", "1", "--y1", "2",
  "--x2", "3", "--y2", "4", "--out", "acu-compat-zoom-unwritten.png"
], 1);
require_ok(zoom_projection.ok === false && zoom_projection.command === "zoom"
    && zoom_projection.error.code === "window_not_found",
  "legacy zoom must reach the native window provider:" + JSON.stringify(zoom_projection));

const signal_plan = invoke(launcher, [
  "privilege", "plan", "process.signal", "" + rh.pid(), "STOP",
  "--timeout-ms", "5000", "--ttl-seconds", "60"
], 0);
require_ok(signal_plan.ok === true && signal_plan.command === "privilege-plan",
  "acu_compat_signal_plan_reply:" + JSON.stringify(signal_plan));
require_ok(signal_plan.data.operation === "process.signal"
    && signal_plan.data.signal === "SIGSTOP"
    && signal_plan.data.scope === "single"
    && signal_plan.data.members.length === 1
    && signal_plan.data.members[0].pid === rh.pid(),
  "acu_compat_signal_plan_identity:" + JSON.stringify(signal_plan.data));
require_ok(signal_plan.data.consent_requested === false
    && signal_plan.data.mutation_performed === false,
  "acu_compat_signal_plan_must_be_read_only:" + JSON.stringify(signal_plan.data));

const unsafe_kill = run(launcher, [
  "privilege", "plan", "process.signal", "" + rh.pid(), "KILL"
]);
require_ok(unsafe_kill.ok === false && unsafe_kill.alert === undefined
    && unsafe_kill.error.code === "usage"
    && unsafe_kill.error.message.indexOf("--force exactly for KILL") >= 0,
  "acu_compat_signal_plan_native_usage:" + JSON.stringify(unsafe_kill));

const kill_observe_failure = invoke(launcher, [
  "--rdp", "example.invalid:3389", "kill", "2147483647"
], 1);
require_ok(kill_observe_failure.ok === false
    && kill_observe_failure.command === "process-state"
    && kill_observe_failure.error.code === "rdp_unavailable",
  "identity kill must preserve the exact native process-state failure:"
    + JSON.stringify(kill_observe_failure));

for (const operation of ["install", "status", "start", "stop", "uninstall"]) {
  const retired = run(launcher, ["daemon", "service", operation]);
  require_ok(retired.ok === false && retired.command === "daemon"
      && retired.data === null && retired.alert === undefined,
    "daemon service retirement envelope:" + operation);
  require_ok(retired.error.code === "retired"
      && retired.error.message.includes("permanently retired")
      && retired.error.todo === undefined && retired.error.gap_id === undefined,
    "daemon service must remain a typed retirement without fallback:" + operation);
}

const retired_device_shapes = [
  ["device", "claim", "/dev/cu.fixture", "--ttl", "300"],
  ["device", "read", "legacy-lease", "--lease", "legacy-secret"],
  ["device", "write", "legacy-lease", "--lease", "legacy-secret", "--hex", "00"],
  ["device", "renew", "legacy-lease", "--lease", "legacy-secret"],
  ["device", "release", "legacy-lease", "--lease", "legacy-secret"]
];
for (let i = 0; i < retired_device_shapes.length; i = i + 1) {
  const retired = run(launcher, retired_device_shapes[i]);
  require_ok(retired.ok === false && retired.command === "device"
      && retired.data === null && retired.alert === undefined,
    "legacy device retirement envelope:" + retired_device_shapes[i][1]);
  require_ok(retired.error.code === "retired"
      && retired.error.message.includes("permanently retired")
      && retired.error.todo === undefined && retired.error.gap_id === undefined,
    "legacy device lifecycle must remain a typed retirement without fallback:"
      + retired_device_shapes[i][1]);
}
const retired_device_claim = run(launcher, ["device", "claim", "/dev/cu.fixture"]);
require_ok(retired_device_claim.error.message.includes("device list")
    && retired_device_claim.error.message.includes("--session")
    && retired_device_claim.error.message.includes("--request-id"),
  "legacy device retirement must name the opaque-id and explicit-session migration");

const typo = run(launcher, ["unknown-verb"]);
require_ok(typo.error.code === "usage" && typo.alert === undefined
    && typo.error.todo === undefined,
  "unknown spelling must remain usage, not TODO");

print("EVIDENCE acu.compat-todo-boundary");
print("PASS: legacy gaps and retirements stayed typed without native or MCU fallback");
return;
