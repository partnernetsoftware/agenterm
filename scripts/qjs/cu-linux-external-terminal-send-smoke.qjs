// CEO: Linux external-terminal visible send + AgenTerm terminal-control host-limit
// honesty with independent read-back. Typed terminal-send/term-send/terminal-list
// usage must reject AT-SPI --name, --coords, and other unexpected arguments;
// typed get-extents --name usage AND host-limit paths must both hold before the
// AgenTerm sock and external term-read read-back courts. Missing Unix socket
// authority returns typed control_unavailable with
// detail.limit=host/group=terminal/mechanism=agenterm-unix-control-socket plus
// independent absent-socket proof; present authority proves
// terminal-send/wait/read on one live tab. External GTK terminal buffer proves
// term-send --foreground with independent term-read token match (send reply
// alone is not evidence). AT-SPI/--name only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-external-terminal-send",
];

const AT_SPI_PROBE_NAME = "External Terminal Court Anchor";

const EXTERNAL_TERMINAL_FIXTURE = `#!/usr/bin/env python3
import os
import signal
import sys

import gi

gi.require_version("Atk", "1.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Atk, Gtk

pid = os.getpid()
window = Gtk.Window(title="agenterm-linux-external-terminal-%d" % pid)
window.set_default_size(440, 220)
window.set_focus_on_map(False)
window.set_accept_focus(True)

view = Gtk.TextView()
view.set_can_focus(True)
view.set_editable(True)
view.set_cursor_visible(False)
buffer = view.get_buffer()
buffer.set_text("DECOY\\nACU_EXTERNAL_TERMINAL_BASE_%d_TAIL\\n\\n" % pid)
accessible = view.get_accessible()
accessible.set_name("Owned External Terminal Buffer")
accessible.set_role(Atk.Role.TERMINAL)

scroll = Gtk.ScrolledWindow()
scroll.add(view)
window.add(scroll)
window.show_all()

def terminate(_signal, _frame):
    Gtk.main_quit()

signal.signal(signal.SIGTERM, terminate)
signal.signal(signal.SIGINT, terminate)
sys.stdout.write("ready %d\\n" % pid)
sys.stdout.flush()
Gtk.main()
`;

const SOCKET_ABSENT_SCRIPT = [
  "import os, socket, sys",
  "path = sys.argv[1]",
  "if os.path.exists(path):",
  "    try:",
  "        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)",
  "        conn.settimeout(0.2)",
  "        conn.connect(path)",
  "    except OSError:",
  "        raise SystemExit(0)",
  "    raise SystemExit('independent socket still accepts connections: ' + path)",
  "if os.path.exists(path):",
  "    raise SystemExit('independent socket path still present: ' + path)",
].join("\n");

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return at(document, "ok") === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(run_directory, terminal_env, executable) {
  const env = {
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  if (executable !== undefined) {
    env.AGENTERM_ABI_LIB = rh.join(rh.parent(executable), "libagenterm.so");
  }
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  for (const name of Object.keys(terminal_env)) {
    env[name] = terminal_env[name];
  }
  return env;
}

function invoke_actuate_reply(run_directory, executable, terminal_env, arguments) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe,actuate",
  ].concat(arguments), {
    cwd: run_directory,
    env: cu_env(run_directory, terminal_env, executable),
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_external_terminal_send_actuate_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "terminal-send"
      || text_at(reply, "command") === "term-send"
      || text_at(reply, "command") === "usage",
    "cu_linux_external_terminal_send_actuate_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, terminal_env, arguments) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: cu_env(run_directory, terminal_env, executable),
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_external_terminal_send_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable, run_directory, terminal_env) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    cwd: run_directory,
    env: cu_env(run_directory, terminal_env, executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_atspi_name(message) {
  return message.indexOf("--name") >= 0
    || message.indexOf("unexpected") >= 0
    || message.indexOf("exactly one text argument") >= 0;
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0
    || message.indexOf("exactly one text argument") >= 0;
}

function assert_terminal_send_usage_limit(run_directory, executable, terminal_env) {
  const flat_with_name = invoke_actuate_reply(run_directory, executable, terminal_env, [
    "terminal-send", "--tab", "@1", "--name", AT_SPI_PROBE_NAME, "--", "hello",
  ]);
  ensure(!output_success(flat_with_name),
    "cu_linux_external_terminal_send_terminal_send_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_external_terminal_send_terminal_send_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_external_terminal_send_terminal_send_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    usage_rejects_atspi_name(text_at(flat_with_name, "error.message")),
    "cu_linux_external_terminal_send_terminal_send_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_actuate_reply(run_directory, executable, terminal_env, [
    "terminal", "send", "--tab", "@1", "--name", AT_SPI_PROBE_NAME, "--", "hello",
  ]);
  ensure(!output_success(grouped_with_name),
    "cu_linux_external_terminal_send_terminal_send_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_external_terminal_send_terminal_send_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    usage_rejects_atspi_name(text_at(grouped_with_name, "error.message")),
    "cu_linux_external_terminal_send_terminal_send_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = invoke_actuate_reply(run_directory, executable, terminal_env, [
    "terminal-send", "--tab", "@1", "--bogus", "--", "hello",
  ]);
  ensure(!output_success(with_bogus),
    "cu_linux_external_terminal_send_terminal_send_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_external_terminal_send_terminal_send_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_external_terminal_send_terminal_send_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_coords = invoke_actuate_reply(run_directory, executable, terminal_env, [
    "terminal-send", "--tab", "@1", "--coords", "10,10", "--", "hello",
  ]);
  ensure(!output_success(with_coords),
    "cu_linux_external_terminal_send_terminal_send_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_external_terminal_send_terminal_send_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_external_terminal_send_terminal_send_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_external_terminal_send_terminal_send_coords_message:" + JSON.stringify(with_coords.error)
  );
}

