    text_at(with_coords, "error.code") === "usage",
    "cu_linux_external_terminal_send_term_send_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_external_terminal_send_term_send_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_external_terminal_send_term_send_coords_message:" + JSON.stringify(with_coords.error)
  );
