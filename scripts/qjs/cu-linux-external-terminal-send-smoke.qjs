function assert_get_extents_usage_limit(run_directory, executable, terminal_env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, terminal_env, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(!output_success(zero_handle),
    "cu_linux_external_terminal_send_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_external_terminal_send_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_external_terminal_send_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, terminal_env, [
    "get-extents", "--window", "1",
  ]);
  ensure(!output_success(missing_name),
    "cu_linux_external_terminal_send_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_external_terminal_send_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_external_terminal_send_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_external_terminal_send_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable, terminal_env) {
  const env = cu_env(run_directory, terminal_env, executable);
  env.AT_SPI_BUS_ADDRESS = "invalid";
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_external_terminal_send_extents_unavailable_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(!output_success(reply),
    "cu_linux_external_terminal_send_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_external_terminal_send_extents_unavailable_code:" + code
  );
}

function cu_visible_env(run_directory, terminal_env, executable) {
  const env = cu_env(run_directory, terminal_env, executable);
  const visible = {};
  for (const name of Object.keys(env)) {
    if (name !== "AGENTERM_NO_ACTIVATE") { visible[name] = env[name]; }
  }
  return visible;
}

function run_cu_json(run_directory, executable, terminal_env, arguments) {
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: cu_env(run_directory, terminal_env, executable),
    timeout_ms: 60000,
  });
  ensure(output.success === true, "cu_linux_external_terminal_send_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_external_terminal_send_empty");
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_linux_external_terminal_send_reply:" + JSON.stringify(document));
  return document;
}

function run_cu_reply(run_directory, executable, terminal_env, arguments) {
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: cu_env(run_directory, terminal_env, executable),
    timeout_ms: 60000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_external_terminal_send_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu_unix_default_reply(run_directory, executable, terminal_env, arguments) {
  const output = rh.command_spec({
    program: executable,
    args: arguments,
    current_dir: run_directory,
    env: cu_env(run_directory, terminal_env, executable),
    env_remove: ["AGENTERM_IPC_ADDRESS", "AGENTERM_IPC_ENDPOINT"],
    timeout_ms: 60000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_external_terminal_send_unix_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu_visible_reply(run_directory, executable, terminal_env, arguments) {
  const output = rh.command_spec({
    program: executable,
    args: arguments,
    current_dir: run_directory,
    env: cu_visible_env(run_directory, terminal_env, executable),
    env_remove: ["AGENTERM_NO_ACTIVATE"],
    timeout_ms: 60000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_external_terminal_send_visible_empty:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_agenterm(run_directory, agenterm, executable, terminal_env, arguments) {
  const all = ["cli", "--address", terminal_env.AGENTERM_IPC_ADDRESS];
  for (const argument of arguments) { all.push(argument); }
  const output = rh.command(agenterm, all, {
    cwd: run_directory,
    env: cu_env(run_directory, terminal_env, executable),
    timeout_ms: 60000,
  });
  ensure(output.success === true, "cu_linux_external_terminal_send_agenterm:" + output.stdout + output.stderr);
  return output.stdout.trim();
}

function window_row(run_directory, executable, terminal_env, pid, title) {
  const reply = run_cu_json(run_directory, executable, terminal_env, [
    "--target", "current", "--grant", "observe", "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function assert_terminal_list_usage_limit(run_directory, executable, terminal_env) {
  const with_coords = run_cu_reply(run_directory, executable, terminal_env, [
    "--target", "current", "--grant", "observe", "terminal-list", "--coords", "10,10",
  ]);
  ensure(!output_success(with_coords),
    "cu_linux_external_terminal_send_terminal_list_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_external_terminal_send_terminal_list_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_external_terminal_send_terminal_list_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_external_terminal_send_terminal_list_coords_message:" + JSON.stringify(with_coords.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, terminal_env, [
    "--target", "current", "--grant", "observe", "terminal-list", "--bogus",
  ]);
  ensure(!output_success(with_bogus),
    "cu_linux_external_terminal_send_terminal_list_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_external_terminal_send_terminal_list_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_external_terminal_send_terminal_list_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_terminal_host_limit(reply) {
  ensure(
    !flag_at(reply, "ok") && text_at(reply, "error.code") === "control_unavailable",
    "cu_linux_external_terminal_send_missing_sock_code:" + JSON.stringify(reply)
  );
  const detail = at(reply, "error.detail");
  ensure(
    text_at(detail, "control") === "unavailable"
      && text_at(detail, "authority") === "unreachable"
      && text_at(detail, "limit") === "host"
      && text_at(detail, "group") === "terminal"
      && text_at(detail, "mechanism") === "agenterm-unix-control-socket",
    "cu_linux_external_terminal_send_missing_sock_detail:" + JSON.stringify(detail)
  );
  const alternatives = at(detail, "alternatives");
  ensure(
    Array.isArray(alternatives) && alternatives.length >= 2,
    "cu_linux_external_terminal_send_missing_sock_alternatives:" + JSON.stringify(detail)
  );
  const joined = alternatives.join(" ");
  ensure(
    joined.indexOf("agenterm server") >= 0 && joined.indexOf("pty-start") >= 0,
    "cu_linux_external_terminal_send_missing_sock_alternative_text:" + joined
  );
  const transport = text_at(detail, "transport");
  ensure(
    transport.indexOf("IPC transport Io for unix:") === 0
      && transport.indexOf(".sock") >= 0,
    "cu_linux_external_terminal_send_missing_sock_transport:" + transport
  );
}

function socket_path_from_transport(reply) {
  const transport = text_at(at(reply, "error.detail"), "transport");
  const prefix = "IPC transport Io for unix:";
  ensure(transport.indexOf(prefix) === 0,
    "cu_linux_external_terminal_send_sock_transport_prefix:" + transport);
  const rest = transport.slice(prefix.length);
  const sock_end = rest.indexOf(".sock:");
  ensure(sock_end >= 0,
    "cu_linux_external_terminal_send_sock_transport_suffix:" + transport);
  return rest.slice(0, sock_end + 5);
}

function independent_socket_absent(run_directory, executable, terminal_env, socket_path) {
  const output = rh.command("python3", ["-c", SOCKET_ABSENT_SCRIPT, socket_path], {
    cwd: run_directory,
    env: cu_env(run_directory, terminal_env, executable),
    timeout_ms: 10000,
  });
  ensure(output.success === true,
    "cu_linux_external_terminal_send_sock_absent:" + output.stderr + output.stdout);
}

function terminal_tab(rows, tab_id) {
  for (const row of rows) {
    if (text_at(row, "id") === tab_id) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const agenterm = rh.join(rh.parent(executable), "agenterm");
ensure(direct_file(executable), "cu_linux_external_terminal_send_executable_missing:" + executable);
ensure(direct_file(agenterm), "cu_linux_external_terminal_send_agenterm_missing:" + agenterm);

const context = harness.new_context(repo, "cu-linux-external-terminal-send");
const run_directory = rh.join(repo, "target/cu-linux-external-terminal-send-smoke-run");
rh.create_dir_all(run_directory);
const terminal_env = {
  AGENTERM_INSTANCE: "ephemeral:cu-linux-external-terminal-" + context.run_id,
  AGENTERM_IPC_ADDRESS: "" + context.address,
  AGENTERM_INSTANCE_DIR: "" + context.instance_directory,
  AGENTERM_WORKSPACE_PATH: "" + context.workspace_path,
  AGENTERM_SETTINGS_PATH: "" + context.settings_path,
};

let terminal_server = -1;
let external_fixture = -1;
let external_fixture_pid = 0;
const atspi_available = probe_atspi_available(executable, run_directory, terminal_env);
let succeeded = 0;
let failure = "";

try {
  print("STEP terminal-send/term-send/terminal-list typed-fail usage when AT-SPI --name, --coords, or other unexpected arguments are present");
  assert_terminal_send_usage_limit(run_directory, executable, terminal_env);
  assert_term_send_usage_limit(run_directory, executable, terminal_env);
  assert_terminal_list_usage_limit(run_directory, executable, terminal_env);

  print("STEP get-extents typed-fail usage when --window is zero or --name is missing before sock/term-read courts");
  assert_get_extents_usage_limit(run_directory, executable, terminal_env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before sock/term-read courts");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable, terminal_env);

  print("STEP terminal-list typed-fails control_unavailable with Unix-socket host-limit detail and independent absent-socket proof before any AgenTerm authority exists");
  const missing = run_cu_unix_default_reply(run_directory, executable, terminal_env, [
    "--target", "current", "--grant", "observe", "terminal-list",
  ]);
  assert_terminal_host_limit(missing);
  independent_socket_absent(
    run_directory, executable, terminal_env, socket_path_from_transport(missing)
  );

  print("STEP AgenTerm present path: terminal-send / terminal-wait / terminal-read agree on one literal token");
  terminal_server = harness.start({
    program: agenterm,
    args: ["server", "--address", terminal_env.AGENTERM_IPC_ADDRESS],
    current_dir: run_directory,
    env: cu_env(run_directory, terminal_env, executable),
    timeout_ms: 60000,
  });
  let terminal_ready = null;
  for (let attempt = 0; attempt < 400; attempt = attempt + 1) {
    const candidate = run_cu_reply(run_directory, executable, terminal_env, [
      "--target", "current", "--grant", "observe", "terminal-list",
    ]);
    if (flag_at(candidate, "ok")) { terminal_ready = candidate; break; }
    ensure(harness.state(terminal_server) !== "exited", "cu_linux_external_terminal_send_server_early_exit");
    harness.sleep_ms(25);
  }
  ensure(terminal_ready !== null, "cu_linux_external_terminal_send_server_not_ready");
  const terminal_scope = text_at(terminal_ready, "data.server_scope_id");
  const terminal_epoch = text_at(terminal_ready, "data.server_epoch");
  ensure(terminal_scope !== "" && terminal_epoch !== "", "cu_linux_external_terminal_send_authority");

  const tab_id = run_agenterm(run_directory, agenterm, executable, terminal_env, [
    "new-window", "-d", "-P", "-F", "#{window_id}",
    "-n", "cu-external-terminal-" + context.run_id, "--", "sh", "-c", "stty -echo; exec sh",
  ]);
  ensure(tab_id.startsWith("@"), "cu_linux_external_terminal_send_tab_id:" + tab_id);

  let terminal_inventory = null;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    const candidate = run_cu_json(run_directory, executable, terminal_env, [
      "--target", "current", "--grant", "observe", "terminal-list",
    ]);
    if (terminal_tab(candidate.data.tabs, tab_id) !== null) {
      terminal_inventory = candidate;
      break;
    }
    harness.sleep_ms(25);
  }
  ensure(terminal_inventory !== null, "cu_linux_external_terminal_send_tab_missing");

  const marker = "ACU_EXT_TERM_PRESENT_" + context.run_id;
  const terminal_input = "printf '" + marker + "\\n'; exit\r";
  const terminal_send = run_cu_json(run_directory, executable, terminal_env, [
    "--target", "current", "--grant", "observe,actuate", "terminal-send",
    "--tab", tab_id, "--", terminal_input,
  ]);
  ensure(
    text_at(terminal_send, "data.tab_id") === tab_id
      && flag_at(terminal_send, "data.performed")
      && flag_at(terminal_send, "data.verified"),
    "cu_linux_external_terminal_send_terminal_send:" + JSON.stringify(terminal_send.data)
  );
  const terminal_wait = run_cu_json(run_directory, executable, terminal_env, [
    "--target", "current", "--grant", "observe", "terminal-wait",
    "--tab", tab_id, "--contains", marker, "--timeout-ms", "10000",
  ]);
  ensure(
    text_at(terminal_wait, "data.state") === "matched"
      && flag_at(terminal_wait, "data.completed"),
    "cu_linux_external_terminal_send_terminal_wait:" + JSON.stringify(terminal_wait.data)
  );
  const terminal_read = run_cu_json(run_directory, executable, terminal_env, [
    "--target", "current", "--grant", "observe", "terminal-read",
    "--tab", tab_id, "--max-bytes", "16384",
  ]);
  const terminal_text = text_at(terminal_read, "data.text");
  ensure(
    terminal_text.indexOf(marker) >= 0,
    "cu_linux_external_terminal_send_terminal_read:" + JSON.stringify({ marker: marker, text: terminal_text })
  );

  run_agenterm(run_directory, agenterm, executable, terminal_env, ["kill-window", "-t", tab_id]);
  run_agenterm(run_directory, agenterm, executable, terminal_env, ["shutdown"]);
  harness.wait(terminal_server, 10000);
  terminal_server = -1;

  print("STEP external GTK terminal buffer: term-send --foreground injects one token verified by independent term-read");
  const fixture_source = rh.join(run_directory, "external-terminal-fixture.py");
  rh.write_text(fixture_source, EXTERNAL_TERMINAL_FIXTURE);
  external_fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  external_fixture_pid = harness.spawned_pid(external_fixture);
  const external_title = "agenterm-linux-external-terminal-" + external_fixture_pid;
  const window_wait = run_cu_json(run_directory, executable, terminal_env, [
    "--target", "current", "--grant", "observe", "wait",
    "--timeout-ms", "15000", "--window-title-contains", external_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_external_terminal_send_external_window_wait");
  const external_row = window_row(run_directory, executable, terminal_env, external_fixture_pid, external_title);
  ensure(external_row !== null, "cu_linux_external_terminal_send_external_window_identity");
  const external_handle = "" + int_at(external_row, "handle");
  const before_read = run_cu_json(run_directory, executable, terminal_env, [
    "--target", "current", "--grant", "observe", "term-read",
    external_handle, "--max-bytes", "4096",
  ]);
  const before_text = text_at(before_read, "data.text");
  const visible_token = "visiblelinuxterm" + external_fixture_pid;
  ensure(before_text.indexOf(visible_token) < 0, "cu_linux_external_terminal_send_token_preexists");

  let visible_send = null;
  for (let attempt = 0; attempt < 4; attempt = attempt + 1) {
    visible_send = run_cu_visible_reply(run_directory, executable, terminal_env, [
      "--target", "current", "--grant", "observe,actuate", "term-send",
      external_handle, "--foreground", "--enter", "false",
      "--expect", visible_token, "--", visible_token,
    ]);
    if (output_success(visible_send)) { break; }
    if (text_at(visible_send, "error.code") !== "window_activation_failed") { break; }
    if (flag_at(visible_send, "error.detail.input_dispatched")) { break; }
    harness.sleep_ms(250);
  }

  const after_read = run_cu_json(run_directory, executable, terminal_env, [
    "--target", "current", "--grant", "observe", "term-read",
    external_handle, "--max-bytes", "4096",
  ]);
  const after_text = text_at(after_read, "data.text");
  if (output_success(visible_send)) {
    ensure(
      flag_at(visible_send, "data.performed")
        && flag_at(visible_send, "data.verified")
        && flag_at(visible_send, "data.focus_restored")
        && flag_at(visible_send, "data.buffer_changed"),
      "cu_linux_external_terminal_send_visible_send:" + JSON.stringify(visible_send.data)
    );
    ensure(
      after_text.indexOf(visible_token) >= 0,
      "cu_linux_external_terminal_send_independent_readback:"
        + JSON.stringify({ token: visible_token, text: after_text })
    );
  } else {
    ensure(
      text_at(visible_send, "error.code") === "window_activation_failed",
      "cu_linux_external_terminal_send_visible_host_limit:" + JSON.stringify(visible_send)
    );
    ensure(
      after_text.indexOf(visible_token) < 0,
      "cu_linux_external_terminal_send_unattributed_visible_input:"
        + JSON.stringify({ token: visible_token, text: after_text, send: visible_send })
    );
    print("STEP visible GTK term-send typed window_activation_failed; independent term-read has no token (not treated as send success)");
  }

  harness.emit_evidence(context, declared_evidence, "cu.linux-external-terminal-send");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (external_fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + external_fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (external_fixture >= 0) {
  harness.wait(external_fixture, 5000);
}
if (terminal_server >= 0) {
  try { harness.wait(terminal_server, 5000); } catch (_error) {}
}

ensure(succeeded === 1, failure || "cu_linux_external_terminal_send_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux external-terminal visible send with typed terminal-send/term-send/terminal-list/get-extents usage honesty, missing-sock host-limit, independent socket-absent proof, and independent term-read (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux external-terminal visible send with typed terminal-send/term-send/terminal-list/get-extents usage/host-limit honesty, missing-sock host-limit, independent socket-absent proof, and independent term-read (AT-SPI --name, no --coords)");
}
