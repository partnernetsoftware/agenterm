// CEO: Linux ps inventory honesty with independent /proc pid/exe/stat read-back.
// Acceptance is smoke read-back only: CU ps must agree with pid, parent_pid and
// executable_name facts derived outside agenterm-cu from the same /proc scan
// semantics the Linux adapter uses. Typed ps usage must reject AT-SPI --window/--name,
// --coords, --bogus, and other unexpected arguments; native --name remains the
// executable-name selector (not AT-SPI). Typed get-extents --name usage AND
// host-limit paths must both hold before the /proc read-back court. Prefer
// host-limit clarity over fake success. AT-SPI/--name only; no --coords
// or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-ps-readback",
];

const AT_SPI_PROBE_NAME = "Ps Court Anchor";
const MAX_VISITED = 10000;
const MAX_RESULTS = 5000;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_ps_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "ps" || text_at(reply, "command") === "usage",
    "cu_linux_ps_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_ps_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_ps_usage_limit(run_directory, executable, env) {
  const atspi_window_name = invoke_observe_reply(run_directory, executable, [
    "ps", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(atspi_window_name),
    "cu_linux_ps_usage_window_name_ok:" + JSON.stringify(atspi_window_name));
  ensure(
    text_at(atspi_window_name, "error.code") === "usage",
    "cu_linux_ps_usage_window_name_code:" + JSON.stringify(atspi_window_name.error)
  );
  ensure(
    text_at(atspi_window_name, "command") === "usage",
    "cu_linux_ps_usage_window_name_command:" + JSON.stringify(atspi_window_name)
  );
  ensure(
    text_at(atspi_window_name, "error.message").indexOf("--window") >= 0
      || text_at(atspi_window_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_ps_usage_window_name_message:" + JSON.stringify(atspi_window_name.error)
  );

  const detail_with_name = invoke_observe_reply(run_directory, executable, [
    "ps", "--pid", "1", "--depth", "1", "--name", "sleep",
  ], env);
  ensure(!output_success(detail_with_name),
    "cu_linux_ps_usage_detail_name_ok:" + JSON.stringify(detail_with_name));
  ensure(
    text_at(detail_with_name, "error.code") === "usage",
    "cu_linux_ps_usage_detail_name_code:" + JSON.stringify(detail_with_name.error)
  );
  ensure(
    text_at(detail_with_name, "error.message").indexOf("detail") >= 0
      || text_at(detail_with_name, "error.message").indexOf("list") >= 0
      || text_at(detail_with_name, "error.message").indexOf("offset") >= 0,
    "cu_linux_ps_usage_detail_name_message:" + JSON.stringify(detail_with_name.error)
  );

  const with_bogus = invoke_observe_reply(run_directory, executable, [
    "ps", "--pid", "1", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_ps_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_ps_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_ps_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_ps_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const list_with_bogus = invoke_observe_reply(run_directory, executable, [
    "ps", "--bogus",
  ], env);
  ensure(!output_success(list_with_bogus),
    "cu_linux_ps_usage_list_bogus_ok:" + JSON.stringify(list_with_bogus));
  ensure(
    text_at(list_with_bogus, "error.code") === "usage",
    "cu_linux_ps_usage_list_bogus_code:" + JSON.stringify(list_with_bogus.error)
  );
  ensure(
    text_at(list_with_bogus, "command") === "usage",
    "cu_linux_ps_usage_list_bogus_command:" + JSON.stringify(list_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(list_with_bogus, "error.message"), "--bogus"),
    "cu_linux_ps_usage_list_bogus_message:" + JSON.stringify(list_with_bogus.error)
  );

  const with_coords = invoke_observe_reply(run_directory, executable, [
    "ps", "--pid", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords),
    "cu_linux_ps_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_ps_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_ps_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_ps_usage_coords_message:" + JSON.stringify(with_coords.error)
  );

  const list_with_coords = invoke_observe_reply(run_directory, executable, [
    "ps", "--coords", "10,10",
  ], env);
  ensure(!output_success(list_with_coords),
    "cu_linux_ps_usage_list_coords_ok:" + JSON.stringify(list_with_coords));
  ensure(
    text_at(list_with_coords, "error.code") === "usage",
    "cu_linux_ps_usage_list_coords_code:" + JSON.stringify(list_with_coords.error)
  );
  ensure(
    text_at(list_with_coords, "command") === "usage",
    "cu_linux_ps_usage_list_coords_command:" + JSON.stringify(list_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(list_with_coords, "error.message"), "--coords"),
    "cu_linux_ps_usage_list_coords_message:" + JSON.stringify(list_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_ps_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_ps_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_ps_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_ps_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_ps_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_ps_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_ps_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_ps_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_ps_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_ps_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_ps_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_ps_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_ps_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_ps_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_ps_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_ps_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_ps_extents_unavailable_code:" + code
  );
}

function verify_inventory_with_retry(run_directory, executable, env) {
  const script = [
    "import json, os, subprocess, sys",
    "cu = sys.argv[1]",
    "run_dir = sys.argv[2]",
    "max_visited = " + MAX_VISITED,
    "max_results = " + MAX_RESULTS,
    "def proc_scan():",
    "    rows = {}",
    "    for entry in os.scandir('/proc'):",
    "        if not entry.name.isdigit():",
    "            continue",
    "        pid = int(entry.name)",
    "        try:",
    "            exe = os.readlink(f'/proc/{pid}/exe')",
    "        except OSError:",
    "            continue",
    "        executable_name = os.path.basename(exe)",
    "        if not executable_name:",
    "            continue",
    "        try:",
    "            with open(f'/proc/{pid}/stat') as handle:",
    "                stat = handle.read()",
    "        except OSError:",
    "            continue",
    "        close = stat.rfind(')')",
    "        if close < 0:",
    "            continue",
    "        fields = stat[close + 1:].split()",
    "        if len(fields) < 2:",
    "            continue",
    "        rows[pid] = {",
    "            'pid': pid,",
    "            'parent_pid': int(fields[1]),",
    "            'executable_name': executable_name,",
    "        }",
    "    return rows",
    "def intersect_probe(left, right):",
    "    stable = {}",
    "    for pid, left_row in left.items():",
    "        right_row = right.get(pid)",
    "        if right_row is None:",
    "            continue",
    "        if right_row['parent_pid'] != left_row['parent_pid']:",
    "            continue",
    "        if right_row['executable_name'] != left_row['executable_name']:",
    "            continue",
    "        stable[pid] = left_row",
    "    return stable",
    "def invoke_ps(arguments):",
    "    proc = subprocess.run(",
    "        [cu, '--target', 'current', '--grant', 'observe'] + arguments,",
    "        cwd=run_dir, capture_output=True, text=True,",
    "        env={**os.environ, 'AGENTERM_NO_ACTIVATE': '1'},",
    "        timeout=120)",
    "    if proc.returncode != 0:",
    "        raise SystemExit('cu_linux_ps_invoke:' + proc.stderr)",
    "    reply = json.loads(proc.stdout)",
    "    if not reply.get('ok') or reply.get('command') != 'ps':",
    "        raise SystemExit('cu_linux_ps_reply:' + proc.stdout)",
    "    return reply['data']",
    "def fetch_inventory():",
    "    offset = 0",
    "    processes = []",
    "    header = None",
    "    while True:",
    "        data = invoke_ps([",
    "            'ps', '--sort', 'pid',",
    "            '--max-visited', str(max_visited),",
    "            '--max', str(max_results),",
    "            '--offset', str(offset),",
    "        ])",
    "        if header is None:",
    "            header = data",
    "        batch = data.get('processes') or []",
    "        processes.extend(batch)",
    "        if data.get('truncated') is not True:",
    "            break",
    "        if data.get('next_offset') is None:",
    "            raise SystemExit('cu_linux_ps_next_offset')",
    "        offset = int(data['next_offset'])",
    "    header['processes'] = processes",
    "    header['returned'] = len(processes)",
    "    return header",
    "def read_proc_pid(pid):",
    "    try:",
    "        exe = os.path.basename(os.readlink(f'/proc/{pid}/exe'))",
    "        stat = open(f'/proc/{pid}/stat').read()",
    "    except OSError:",
    "        return None",
    "    close = stat.rfind(')')",
    "    fields = stat[close + 1:].split()",
    "    return {",
    "        'pid': pid,",
    "        'parent_pid': int(fields[1]),",
    "        'executable_name': exe,",
    "    }",
    "def compare_inventory(probe, inventory, label):",
    "    if inventory.get('verified') is not True:",
    "        raise RuntimeError(label + ':verified')",
    "    if inventory.get('coverage_complete') is not True:",
    "        raise RuntimeError(label + ':coverage_complete')",
    "    if inventory.get('truncated_scan') is True:",
    "        raise RuntimeError(label + ':truncated_scan')",
    "    rows = inventory.get('processes') or []",
    "    if inventory.get('returned') != len(rows):",
    "        raise RuntimeError(label + ':returned_shape')",
    "    by_pid = {}",
    "    for row in rows:",
    "        pid = int(row['pid'])",
    "        if pid in by_pid:",
    "            raise RuntimeError(label + ':duplicate:' + str(pid))",
    "        by_pid[pid] = row",
    "    matched_live = 0",
    "    for pid, expected in probe.items():",
    "        row = by_pid.get(pid)",
    "        if row is None:",
    "            raise RuntimeError(label + ':missing_live:' + str(pid))",
    "        if int(row['parent_pid']) != expected['parent_pid']:",
    "            raise RuntimeError(label + ':parent_pid:' + str(pid))",
    "        if row['executable_name'] != expected['executable_name']:",
    "            raise RuntimeError(label + ':executable_name:' + str(pid))",
    "        matched_live += 1",
    "    if matched_live != len(probe):",
    "        raise RuntimeError(label + ':live_coverage')",
    "    if inventory.get('matched', 0) < matched_live:",
    "        raise RuntimeError(label + ':matched')",
    "    for pid, row in by_pid.items():",
    "        if pid in probe:",
    "            continue",
    "        live = read_proc_pid(pid)",
    "        if live is None:",
    "            continue",
    "        if int(row['parent_pid']) != live['parent_pid']:",
    "            raise RuntimeError(label + ':stale_parent_pid:' + str(pid))",
    "        if row['executable_name'] != live['executable_name']:",
    "            raise RuntimeError(label + ':stale_executable_name:' + str(pid))",
    "        raise RuntimeError(label + ':unexpected_live_pid:' + str(pid))",
    "last_error = ''",
    "for attempt in range(2):",
    "    before = proc_scan()",
    "    inventory = fetch_inventory()",
    "    after = proc_scan()",
    "    stable = intersect_probe(before, after)",
    "    if len(stable) > max_visited:",
    "        raise SystemExit('cu_linux_ps_probe_too_large:' + str(len(stable)))",
    "    try:",
    "        compare_inventory(stable, inventory, 'cu_linux_ps_inventory')",
    "        print('inventory', len(stable))",
    "        sys.exit(0)",
    "    except RuntimeError as error:",
    "        last_error = str(error)",
    "raise SystemExit(last_error or 'cu_linux_ps_inventory_retry_exhausted')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, executable, run_directory], {
    cwd: run_directory,
    env: env,
    timeout_ms: 120000,
  });
  ensure(output.success === true, "cu_linux_ps_inventory:" + output.stderr + output.stdout);
}

function verify_exact_pid(run_directory, executable, pid, env) {
  const script = [
    "import json, os, subprocess, sys",
    "cu = sys.argv[1]",
    "run_dir = sys.argv[2]",
    "pid = int(sys.argv[3])",
    "exe = os.path.basename(os.readlink(f'/proc/{pid}/exe'))",
    "stat = open(f'/proc/{pid}/stat').read()",
    "close = stat.rfind(')')",
    "fields = stat[close + 1:].split()",
    "expected = {'pid': pid, 'parent_pid': int(fields[1]), 'executable_name': exe}",
    "proc = subprocess.run(",
    "    [cu, '--target', 'current', '--grant', 'observe', 'ps', '--pid', str(pid)],",
    "    cwd=run_dir, capture_output=True, text=True,",
    "    env={**os.environ, 'AGENTERM_NO_ACTIVATE': '1'}, timeout=60)",
    "if proc.returncode != 0:",
    "    raise SystemExit('cu_linux_ps_exact_cli:' + proc.stderr)",
    "reply = json.loads(proc.stdout)",
    "if not reply.get('ok') or reply.get('command') != 'ps':",
    "    raise SystemExit('cu_linux_ps_exact_reply')",
    "data = reply['data']",
    "rows = data.get('processes') or []",
    "if data.get('returned') != 1 or len(rows) != 1:",
    "    raise SystemExit('cu_linux_ps_exact_shape')",
    "row = rows[0]",
    "if int(row['pid']) != pid:",
    "    raise SystemExit('cu_linux_ps_exact_pid')",
    "if int(row['parent_pid']) != expected['parent_pid']:",
    "    raise SystemExit('cu_linux_ps_exact_parent_pid')",
    "if row['executable_name'] != expected['executable_name']:",
    "    raise SystemExit('cu_linux_ps_exact_executable_name')",
    "print('exact', pid)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, executable, run_directory, "" + pid], {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  ensure(output.success === true, "cu_linux_ps_exact:" + output.stderr + output.stdout);
}

function verify_child_filter(run_directory, executable, pid, name_substring, env) {
  const script = [
    "import json, os, subprocess, sys",
    "cu = sys.argv[1]",
    "run_dir = sys.argv[2]",
    "pid = int(sys.argv[3])",
    "name_substring = sys.argv[4]",
    "exe = os.path.basename(os.readlink(f'/proc/{pid}/exe'))",
    "stat = open(f'/proc/{pid}/stat').read()",
    "close = stat.rfind(')')",
    "fields = stat[close + 1:].split()",
    "expected = {'pid': pid, 'parent_pid': int(fields[1]), 'executable_name': exe}",
    "if name_substring.lower() not in expected['executable_name'].lower():",
    "    raise SystemExit('cu_linux_ps_child_name_probe')",
    "proc = subprocess.run(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'ps', '--pid', str(pid), '--name', name_substring],",
    "    cwd=run_dir, capture_output=True, text=True,",
    "    env={**os.environ, 'AGENTERM_NO_ACTIVATE': '1'}, timeout=60)",
    "if proc.returncode != 0:",
    "    raise SystemExit('cu_linux_ps_child_cli:' + proc.stderr)",
    "reply = json.loads(proc.stdout)",
    "if not reply.get('ok') or reply.get('command') != 'ps':",
    "    raise SystemExit('cu_linux_ps_child_reply')",
    "data = reply['data']",
    "rows = data.get('processes') or []",
    "if data.get('returned') != 1 or len(rows) != 1:",
    "    raise SystemExit('cu_linux_ps_child_shape')",
    "row = rows[0]",
    "if int(row['pid']) != pid:",
    "    raise SystemExit('cu_linux_ps_child_pid')",
    "if int(row['parent_pid']) != expected['parent_pid']:",
    "    raise SystemExit('cu_linux_ps_child_parent_pid')",
    "if row['executable_name'] != expected['executable_name']:",
    "    raise SystemExit('cu_linux_ps_child_executable_name')",
    "print('child', pid)",
  ].join("\n");
  const output = rh.command("python3", [
    "-c", script, executable, run_directory, "" + pid, name_substring,
  ], {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  ensure(output.success === true, "cu_linux_ps_child:" + output.stderr + output.stdout);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-ps");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
try {
  print("STEP ps typed-fails usage when AT-SPI --window/--name, --coords, --bogus, or other unexpected arguments are present");
  assert_ps_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before /proc read-back court");
  assert_get_extents_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before /proc read-back court");
  assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; ps read-back still uses /proc exe/stat");
  }

  print("STEP ps inventory matches independent /proc exe/stat read-back");
  verify_inventory_with_retry(context.run_directory, executable, env);

  print("STEP exact --pid read-back matches independent /proc facts for self");
  verify_exact_pid(context.run_directory, executable, rh.pid(), env);

  print("STEP spawned child --pid/--name filter agrees with independent /proc read-back");
  const child = harness.start({
    program: "sleep",
    args: ["300"],
    current_dir: context.run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 60000,
  });
  const child_pid = harness.spawned_pid(child);
  verify_child_filter(context.run_directory, executable, child_pid, "sleep", env);
  harness.kill(child);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-ps-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux ps inventory matches independent /proc pid/parent/executable read-back with typed ps --window/--name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux ps inventory matches independent /proc pid/parent/executable read-back with typed ps --window/--name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
