// CEO: Linux desktop-state bounded snapshot with independent AT-SPI/X11 read-back.
// Acceptance is smoke read-back only: desktop-state window/tree/pointer fields
// must match separate windows inventory, tree, get-text --name, pointer-position,
// and xprop WM_NAME observations. Typed desktop-state usage must reject AT-SPI
// --name, --coords, --bogus, and other unexpected arguments; typed get-extents
// --name usage AND host-limit paths must both hold before the EWMH/X11
// desktop-state read-back court. Named get-extents with --coords/--bogus must
// reject as command=usage or stay accessibility-tree. Prefer host-limit clarity
// over fake success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-desktop-state",
];

const DEPTH = 3;
const MAX_NODES = 64;
const FIXTURE_ENTRY_NAME = "Fixture Entry";
const FIXTURE_ENTRY_SEED = "seed";
const BUTTON_NAME = "Fixture Press";
const MISSING_NODE = "No Such Button";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_desktop_state_empty:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env, env_remove) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env, env_remove);
  ensure(rh.output_success(document), "cu_linux_desktop_state_cli:" + JSON.stringify(document));
  return document;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "0", "--name", BUTTON_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle), "cu_linux_desktop_state_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_desktop_state_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_desktop_state_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name), "cu_linux_desktop_state_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_desktop_state_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_desktop_state_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_desktop_state_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords), "cu_linux_desktop_state_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_desktop_state_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_desktop_state_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_desktop_state_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus), "cu_linux_desktop_state_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_desktop_state_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_desktop_state_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_desktop_state_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_desktop_state_coords_bogus_usage(run_directory, executable, env) {
  const with_coords = run_cu_reply(run_directory, executable, "observe", [
    "desktop-state", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(with_coords), "cu_linux_desktop_state_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_desktop_state_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_desktop_state_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_desktop_state_coords_message:" + JSON.stringify(with_coords.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, "observe", [
    "desktop-state", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(with_bogus), "cu_linux_desktop_state_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_desktop_state_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_desktop_state_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_desktop_state_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_name = run_cu_reply(run_directory, executable, "observe", [
    "desktop-state", "--window", "1", "--name", BUTTON_NAME,
  ], env);
  ensure(!rh.output_success(with_name), "cu_linux_desktop_state_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_desktop_state_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_desktop_state_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_name, "error.message"), "--name"),
    "cu_linux_desktop_state_name_message:" + JSON.stringify(with_name.error)
  );
}

function assert_get_extents_reject_coords_or_stay_named(
  run_directory, executable, handle, node_name, label
) {
  const extents_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "" + handle, "--name", node_name, "--coords", "10,10",
  ]);
  if (!rh.output_success(extents_coords)) {
    ensure(
      text_at(extents_coords, "error.code") === "usage",
      "cu_linux_desktop_state_extents_coords_code_" + label + ":" + JSON.stringify(extents_coords.error)
    );
    ensure(
      text_at(extents_coords, "command") === "usage",
      "cu_linux_desktop_state_extents_coords_command_" + label + ":" + JSON.stringify(extents_coords)
    );
    ensure(
      usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
        || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
      "cu_linux_desktop_state_extents_coords_message_" + label + ":" + JSON.stringify(extents_coords.error)
    );
  } else {
    ensure(
      text_at(extents_coords, "data.addressing") === "accessibility-tree"
        && text_at(extents_coords, "data.matched.name") === node_name,
      "cu_linux_desktop_state_extents_coords_named_" + label + ":" + JSON.stringify(extents_coords.data)
    );
  }

  const extents_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "" + handle, "--name", node_name, "--bogus",
  ]);
  if (!rh.output_success(extents_bogus)) {
    ensure(
      text_at(extents_bogus, "error.code") === "usage",
      "cu_linux_desktop_state_extents_bogus_code_" + label + ":" + JSON.stringify(extents_bogus.error)
    );
    ensure(
      text_at(extents_bogus, "command") === "usage",
      "cu_linux_desktop_state_extents_bogus_command_" + label + ":" + JSON.stringify(extents_bogus)
    );
    ensure(
      usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
        || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
      "cu_linux_desktop_state_extents_bogus_message_" + label + ":" + JSON.stringify(extents_bogus.error)
    );
  } else {
    ensure(
      text_at(extents_bogus, "data.addressing") === "accessibility-tree"
        && text_at(extents_bogus, "data.matched.name") === node_name,
      "cu_linux_desktop_state_extents_bogus_named_" + label + ":" + JSON.stringify(extents_bogus.data)
    );
  }
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--name", BUTTON_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply), "cu_linux_desktop_state_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_desktop_state_extents_unavailable_code:" + code
  );
}

function assert_windows_headless_host_limit(run_directory, executable) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "observe",
    ["windows", "--max", "1"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!rh.output_success(reply), "cu_linux_desktop_state_headless_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_desktop_state_headless_code:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("window enumeration") >= 0
      || message.indexOf("mechanism unavailable") >= 0,
    "cu_linux_desktop_state_headless_message:" + JSON.stringify(reply.error)
  );
}

function assert_get_extents_missing_node(run_directory, executable, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!rh.output_success(reply), "cu_linux_desktop_state_extents_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_desktop_state_extents_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function independent_pyatspi_extents(run_directory, executable, fixture_title, node_name) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "want = sys.argv[2]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and w.name == title:",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    if (node.name or '') == want:",
    "        return node",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_desktop_state_atspi_no_frame')",
    "node = walk(frame)",
    "if node is None:",
    "    raise SystemExit('cu_linux_desktop_state_atspi_miss:' + want)",
    "component = node.queryComponent()",
    "ext = component.getExtents(pyatspi.DESKTOP_COORDS)",
    "x, y, w, h = int(ext.x), int(ext.y), int(ext.width), int(ext.height)",
    "print(json.dumps({",
    "    'name': want,",
    "    'x': x, 'y': y, 'width': w, 'height': h,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, fixture_title, node_name], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_desktop_state_pyatspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function assert_get_extents_agreement(run_directory, executable, handle, fixture_title, node_name) {
  const pyatspi_button = independent_pyatspi_extents(
    run_directory, executable, fixture_title, node_name
  );
  const button_extents = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", node_name,
  ]);
  ensure(
    int_at(button_extents, "data.extents.x") === pyatspi_button.x
      && int_at(button_extents, "data.extents.y") === pyatspi_button.y
      && int_at(button_extents, "data.extents.width") === pyatspi_button.width
      && int_at(button_extents, "data.extents.height") === pyatspi_button.height,
    "cu_linux_desktop_state_extents_agree:" + JSON.stringify({
      cu: button_extents.data.extents,
      pyatspi_button: pyatspi_button,
    })
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function node_named(nodes, name) {
  if (nodes === undefined) { return null; }
  for (const node of nodes) {
    if (text_at(node, "name") === name) { return node; }
  }
  return null;
}

function parse_xprop_wm_name(stdout) {
  const marker = 'WM_NAME(STRING) = "';
  const start = stdout.indexOf(marker);
  if (start < 0) { return ""; }
  const tail = stdout.slice(start + marker.length);
  const end = tail.indexOf('"');
  return end < 0 ? "" : tail.slice(0, end);
}

function independent_wm_name(run_directory, handle, executable) {
  const xprop = rh.command("xprop", ["-id", "" + handle, "WM_NAME"], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (!xprop.success) { return ""; }
  return parse_xprop_wm_name(xprop.stdout);
}

function coords_equal(left, right) {
  if (!Array.isArray(left) || !Array.isArray(right) || left.length !== 2 || right.length !== 2) {
    return false;
  }
  return int_at({ value: left[0] }, "value") === int_at({ value: right[0] }, "value")
    && int_at({ value: left[1] }, "value") === int_at({ value: right[1] }, "value");
}

function assert_desktop_state_schema(data, selection, max_nodes) {
  ensure(
    data.snapshot_version === 1
      && data.selection === selection
      && data.addressing === "window-inventory+accessibility-tree+absolute-screen-coordinates"
      && Array.isArray(data.windows)
      && data.windows.length > 0
      && typeof data.active_window.handle === "number"
      && data.window.handle === data.active_window.handle
      && data.tree.window === data.window.handle
      && data.tree.returned === data.tree.nodes.length
      && data.tree.returned <= max_nodes
      && typeof data.complete.windows === "boolean"
      && typeof data.complete.tree === "boolean"
      && data.pointer.effect === "observed"
      && Array.isArray(data.pointer.coords)
      && data.pointer.coords.length === 2,
    "cu_linux_desktop_state_schema"
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_desktop_state_executable_missing:" + executable);
const context = harness.new_context(repo, "cu-linux-desktop-state");
const run_directory = rh.join(repo, "target/cu-linux-desktop-state-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_desktop_state_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const atspi_available = probe_atspi_available(executable);

const env = cu_env(executable);

try {
  print("STEP desktop-state typed-fails usage when AT-SPI --name/--coords/--bogus is present (usage_rejects_unexpected) before desktop-state observe court");
  assert_desktop_state_coords_bogus_usage(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before desktop-state observe court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before desktop-state observe court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP windows without DISPLAY typed-fail unsupported host-limit");
  assert_windows_headless_host_limit(run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; desktop-state read-back still uses AT-SPI/X11 inventory");
  }

  print("STEP start owned GTK fixture and resolve window by pid and exact title");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_desktop_state_window_wait");

  const inventory_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(inventory_row !== null, "cu_linux_desktop_state_inventory_missing");
  const handle = int_at(inventory_row, "handle");
  ensure(handle > 0, "cu_linux_desktop_state_handle:" + JSON.stringify(inventory_row));
  const handle_text = "" + handle;

  if (atspi_available) {
    print("STEP get-extents typed-fail a11y_node_not_found when the named button is missing");
    assert_get_extents_missing_node(run_directory, executable, handle_text, "before_desktop_state");

    print("STEP independent pyatspi extents and CU get-extents --name agree before desktop-state read-back");
    assert_get_extents_agreement(run_directory, executable, handle_text, fixture_title, BUTTON_NAME);

    print("STEP get-extents --name with --coords/--bogus rejects as command=usage or stays accessibility-tree before desktop-state read-back");
    assert_get_extents_reject_coords_or_stay_named(
      run_directory, executable, handle_text, BUTTON_NAME, "before_desktop_state"
    );
  }

  print("STEP activate fixture so focused desktop-state can resolve one window");
  run_cu(run_directory, executable, "observe,actuate", [
    "activate", "--window", handle_text,
  ]);

  print("STEP desktop-state --window composes bounded inventory, tree and pointer");
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DEPTH, "--max-nodes", "" + MAX_NODES,
  ]);
  ensure(
    state.command === "desktop-state" && state.target === "current",
    "cu_linux_desktop_state_identity"
  );
  const data = state.data;
  assert_desktop_state_schema(data, "explicit", MAX_NODES);

  print("STEP independent xprop WM_NAME matches desktop-state window title");
  const xprop_title = independent_wm_name(run_directory, handle, executable);
  ensure(
    xprop_title !== "" && xprop_title === text_at(data, "window.title"),
    "cu_linux_desktop_state_xprop_title:" + JSON.stringify({
      xprop: xprop_title,
      cu: text_at(data, "window.title"),
    })
  );

  print("STEP independent windows inventory agrees with desktop-state window row");
  const inventory_again = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(inventory_again !== null, "cu_linux_desktop_state_inventory_again_missing");
  ensure(
    int_at(inventory_again, "handle") === int_at(data, "window.handle")
      && text_at(inventory_again, "title") === text_at(data, "window.title")
      && int_at(inventory_again, "process_id") === int_at(data, "window.process_id"),
    "cu_linux_desktop_state_inventory_mismatch:" + JSON.stringify({
      inventory: inventory_again,
      state_window: data.window,
    })
  );
  let found_in_windows = false;
  for (const row of data.windows) {
    if (int_at(row, "handle") === handle) {
      found_in_windows = true;
      ensure(
        text_at(row, "title") === fixture_title,
        "cu_linux_desktop_state_windows_row:" + JSON.stringify(row)
      );
      break;
    }
  }
  ensure(found_in_windows, "cu_linux_desktop_state_windows_missing_handle");

  print("STEP independent tree read-back matches desktop-state tree budget and window");
  const tree = run_cu(run_directory, executable, "observe", [
    "tree", "--window", handle_text,
    "--depth", "" + DEPTH, "--max-nodes", "" + MAX_NODES,
  ]);
  ensure(
    int_at(tree.data, "window") === int_at(data, "tree.window")
      && int_at(tree.data, "returned") === int_at(data, "tree.returned")
      && flag_at(tree.data, "truncated") === flag_at(data, "tree.truncated"),
    "cu_linux_desktop_state_tree_mismatch:" + JSON.stringify({
      independent: tree.data,
      embedded: data.tree,
    })
  );

  print("STEP independent get-text --name reads fixture entry seed through AT-SPI");
  const entry_text = run_cu(run_directory, executable, "observe", [
    "get-text", "--window", handle_text, "--name", FIXTURE_ENTRY_NAME,
  ]);
  let readback = text_at(entry_text, "data.matched.text");
  if (readback === "") { readback = text_at(entry_text, "data.text"); }
  ensure(
    readback === FIXTURE_ENTRY_SEED,
    "cu_linux_desktop_state_entry_readback:" + JSON.stringify({
      expected: FIXTURE_ENTRY_SEED,
      readback: readback,
    })
  );
  print("STEP independent query --text-exact finds the named entry in the accessibility tree");
  const query = run_cu(run_directory, executable, "observe", [
    "query", "--window", handle_text,
    "--depth", "" + DEPTH, "--max-nodes", "" + MAX_NODES,
    "--text-exact", FIXTURE_ENTRY_NAME,
  ]);
  const query_nodes = query.data.nodes === undefined ? [] : query.data.nodes;
  ensure(
    query_nodes.length >= 1
      && text_at(query_nodes[0], "name") === FIXTURE_ENTRY_NAME,
    "cu_linux_desktop_state_query_named_node:" + JSON.stringify(query.data)
  );
  ensure(
    node_named(data.tree.nodes, FIXTURE_ENTRY_NAME) !== null,
    "cu_linux_desktop_state_tree_named_node_missing"
  );

  print("STEP independent pointer-position matches desktop-state pointer coords");
  const pointer = run_cu(run_directory, executable, "observe", [
    "pointer-position",
  ]);
  ensure(
    text_at(pointer, "data.effect") === "observed"
      && coords_equal(pointer.data.coords, data.pointer.coords),
    "cu_linux_desktop_state_pointer_mismatch:" + JSON.stringify({
      independent: pointer.data,
      embedded: data.pointer,
    })
  );

  print("STEP focused desktop-state without --window resolves the activated fixture");
  const focused = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--depth", "" + DEPTH, "--max-nodes", "" + MAX_NODES,
  ]);
  assert_desktop_state_schema(focused.data, "focused", MAX_NODES);
  ensure(
    int_at(focused.data, "window.handle") === handle
      && text_at(focused.data, "window.title") === fixture_title,
    "cu_linux_desktop_state_focused_window:" + JSON.stringify(focused.data.window)
  );

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
}

ensure(succeeded === 1, failure || "cu_linux_desktop_state_failed");
harness.emit_evidence(context, declared_evidence, "cu.linux-desktop-state");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: desktop-state bounded snapshot with typed desktop-state --name/--coords/--bogus usage_rejects_unexpected, get-extents --name pyatspi agreement, typed get-extents usage/host-limit plus --coords/--bogus command=usage honesty, and independent AT-SPI/X11 read-back (AT-SPI --name, no --coords)");
} else {
  print("PASS: desktop-state bounded snapshot with typed desktop-state --name/--coords/--bogus usage_rejects_unexpected, typed get-extents host-limit honesty, and independent AT-SPI/X11 read-back (AT-SPI --name, no --coords)");
}
return;
