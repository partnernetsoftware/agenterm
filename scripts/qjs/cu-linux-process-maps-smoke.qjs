// CEO: Linux process-maps honesty with independent /proc/<pid>/maps read-back.
// Acceptance is smoke read-back only: CU process-maps must agree with address ranges,
// permissions and paths derived outside agenterm-cu for the same live PID.
// No --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-maps-readback",
];

const MAX_VISITED = 4096;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function verify_readback(run_directory, executable, pid) {
  const script = [
    "import json, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "max_visited = int(sys.argv[3])",
    "def take_token(line, cursor):",
    "    while cursor[0] < len(line) and line[cursor[0]:cursor[0] + 1].isspace():",
    "        cursor[0] += 1",
    "    start = cursor[0]",
    "    while cursor[0] < len(line) and not line[cursor[0]:cursor[0] + 1].isspace():",
    "        cursor[0] += 1",
    "    return line[start:cursor[0]]",
    "def parse_hex(raw, label):",
    "    try:",
    "        return int(raw, 16)",
    "    except ValueError as error:",
    "        raise ValueError(f'{label} is malformed') from error",
    "def path_fields(path_bytes):",
    "    if path_bytes is None:",
    "        return {'path_encoding': None}",
    "    try:",
    "        return {'path_encoding': 'utf8', 'path': path_bytes.decode('utf-8')}",
    "    except UnicodeDecodeError:",
    "        return {'path_encoding': 'hex', 'path_hex': path_bytes.hex()}",
    "def parse_map_line(line):",
    "    cursor = [0]",
    "    range_bytes = take_token(line, cursor)",
    "    permissions_bytes = take_token(line, cursor)",
    "    offset_bytes = take_token(line, cursor)",
    "    device_bytes = take_token(line, cursor)",
    "    inode_bytes = take_token(line, cursor)",
    "    while cursor[0] < len(line) and line[cursor[0]:cursor[0] + 1].isspace():",
    "        cursor[0] += 1",
    "    path_bytes = line[cursor[0]:] if cursor[0] < len(line) else None",
    "    separator = range_bytes.find(b'-')",
    "    if separator < 0 or len(permissions_bytes) != 4:",
    "        raise ValueError('process map range or permissions are malformed')",
    "    start = parse_hex(range_bytes[:separator], 'map start')",
    "    end = parse_hex(range_bytes[separator + 1:], 'map end')",
    "    if end <= start:",
    "        raise ValueError('process map range is malformed')",
    "    sharing = 'private' if permissions_bytes[3:4] == b'p' else 'shared'",
    "    row = {",
    "        'start_address': f'0x{start:x}',",
    "        'end_address': f'0x{end:x}',",
    "        'size_bytes': str(end - start),",
    "        'offset_bytes': str(parse_hex(offset_bytes, 'map offset')),",
    "        'permissions': permissions_bytes[:3].decode('ascii'),",
    "        'sharing': sharing,",
    "        'device': device_bytes.decode('ascii'),",
    "        'inode': str(int(inode_bytes)),",
    "    }",
    "    row.update(path_fields(path_bytes))",
    "    return row",
    "def read_inventory():",
    "    regions = []",
    "    truncated_scan = False",
    "    with open(f'/proc/{pid}/maps', 'rb') as handle:",
    "        for line in handle:",
    "            if not line.strip():",
    "                continue",
    "            if len(regions) == max_visited:",
    "                truncated_scan = True",
    "                break",
    "            regions.append(parse_map_line(line.rstrip(b'\\n')))",
    "    return {",
    "        'visited_count': len(regions),",
    "        'read_errors': 0,",
    "        'truncated_scan': truncated_scan,",
    "        'regions': regions,",
    "    }",
    "def compare_row(label, probe, cu):",
    "    for field in ('start_address', 'end_address', 'size_bytes', 'offset_bytes',",
    "                  'permissions', 'sharing', 'device', 'inode'):",
    "        if probe[field] != cu.get(field):",
    "            raise SystemExit(f'{label}:{field}:probe={probe[field]}:cu={cu.get(field)}')",
    "    if probe.get('path_encoding') != cu.get('path_encoding'):",
    "        raise SystemExit(f'{label}:path_encoding:probe={probe.get(\"path_encoding\")}:cu={cu.get(\"path_encoding\")}')",
    "    encoding = probe.get('path_encoding')",
    "    if encoding is None:",
    "        return",
    "    if encoding == 'utf8':",
    "        if probe['path'] != cu.get('path'):",
    "            raise SystemExit(f'{label}:path:probe={probe[\"path\"]}:cu={cu.get(\"path\")}')",
    "    elif probe.get('path_hex') != cu.get('path_hex'):",
    "        raise SystemExit(f'{label}:path_hex:probe={probe.get(\"path_hex\")}:cu={cu.get(\"path_hex\")}')",
    "before = read_inventory()",
    "out = subprocess.check_output(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-maps', '--pid', str(pid), '--limit', str(max_visited),",
    "     '--max-visited', str(max_visited)],",
    "    text=True)",
    "after = read_inventory()",
    "reply = json.loads(out)",
    "if not reply.get('ok') or reply.get('command') != 'process-maps':",
    "    raise SystemExit('cu_linux_process_maps_reply_state')",
    "data = reply['data']",
    "if data.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_maps_verified')",
    "if int(data['pid']) != pid:",
    "    raise SystemExit('cu_linux_process_maps_pid')",
    "if int(data['visited_count']) != before['visited_count']:",
    "    raise SystemExit('cu_linux_process_maps_visited_count')",
    "if int(data['read_errors']) != before['read_errors']:",
    "    raise SystemExit('cu_linux_process_maps_read_errors')",
    "if bool(data['truncated_scan']) != before['truncated_scan']:",
    "    raise SystemExit('cu_linux_process_maps_truncated_scan')",
    "if int(data['matched_count']) != len(before['regions']):",
    "    raise SystemExit('cu_linux_process_maps_matched_count')",
    "if int(data['returned_count']) != len(before['regions']):",
    "    raise SystemExit('cu_linux_process_maps_returned_count')",
    "cu_rows = data.get('regions') or []",
    "if len(cu_rows) != len(before['regions']):",
    "    raise SystemExit('cu_linux_process_maps_region_count')",
    "for index, probe in enumerate(before['regions']):",
    "    compare_row(f'cu_linux_process_maps_row_{index}', probe, cu_rows[index])",
    "if after['visited_count'] != before['visited_count']:",
    "    raise SystemExit('cu_linux_process_maps_inventory_changed')",
    "print('pid', pid)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, executable, "" + MAX_VISITED], {
    cwd: run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_process_maps_readback:" + output.stderr + output.stdout);
}

function verify_pid(run_directory, executable, pid) {
  verify_readback(run_directory, executable, pid);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-maps");
let succeeded = 0;
let failure = "";
try {
  print("STEP process-maps observe matches independent /proc/<pid>/maps read-back for self");
  verify_pid(context.run_directory, executable, rh.pid());

  print("STEP spawn disposable child and verify --pid read-back");
  const child = harness.start({
    program: "sleep",
    args: ["300"],
    current_dir: context.run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 60000,
  });
  verify_pid(context.run_directory, executable, harness.spawned_pid(child));
  harness.kill(child);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-maps-readback");
  harness.remove_run(context);
  print("PASS: Linux process-maps matches independent /proc/<pid>/maps read-back");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
