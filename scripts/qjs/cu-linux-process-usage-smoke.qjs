// CEO: Linux process-usage honesty with independent /proc/<pid>/stat and statm read-back.
// Acceptance is smoke read-back only: CU process-usage must agree with CPU time, RSS and
// page-fault counters derived outside agenterm-cu for the same live PID. Typed
// process-usage usage must reject AT-SPI --name and other unexpected arguments;
// typed get-extents --name usage/host-limit paths must hold before the /proc stat
// and statm read-back court. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-usage-readback",
];

const AT_SPI_PROBE_NAME = "Process Usage Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_usage_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "process-usage" || text_at(reply, "command") === "usage",
    "cu_linux_process_usage_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_usage_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_process_usage_usage_limit(run_directory, executable, env) {
  const flat_with_name = invoke_observe_reply(run_directory, executable, [
    "process-usage", "--pid", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_process_usage_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_process_usage_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_process_usage_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    text_at(flat_with_name, "error.message").indexOf("--name") >= 0
      || text_at(flat_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_process_usage_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_observe_reply(run_directory, executable, [
    "process", "usage", "--pid", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_process_usage_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_process_usage_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "error.message").indexOf("--name") >= 0
      || text_at(grouped_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_process_usage_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = invoke_observe_reply(run_directory, executable, [
    "process-usage", "--pid", "1", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_process_usage_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_process_usage_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("unexpected") >= 0
      || text_at(with_bogus, "error.message").indexOf("--bogus") >= 0,
    "cu_linux_process_usage_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_process_usage_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_process_usage_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_process_usage_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_process_usage_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_process_usage_extents_unavailable_code:" + code
  );
}

function verify_readback(run_directory, executable, pid, env) {
  const script = [
    "import json, os, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "def read_metrics():",
    "    with open(f'/proc/{pid}/stat') as handle:",
    "        stat = handle.read()",
    "    close = stat.rfind(')')",
    "    if close < 0:",
    "        raise ValueError('process stat has no closing command delimiter')",
    "    fields = stat[close + 1:].split()",
    "    if len(fields) < 13:",
    "        raise ValueError('process stat missing cpu and fault fields')",
    "    minor = int(fields[7])",
    "    major = int(fields[9])",
    "    utime = int(fields[11])",
    "    stime = int(fields[12])",
    "    clock_hz = int(os.sysconf('SC_CLK_TCK'))",
    "    page_size = int(os.sysconf('SC_PAGESIZE'))",
    "    ticks = utime + stime",
    "    cpu_time_ns = (ticks // clock_hz) * 1_000_000_000 + (ticks % clock_hz) * 1_000_000_000 // clock_hz",
    "    with open(f'/proc/{pid}/statm') as handle:",
    "        statm = handle.read().split()",
    "    if len(statm) < 2:",
    "        raise ValueError('process statm missing RSS field')",
    "    resident_bytes = int(statm[1]) * page_size",
    "    return {",
    "        'cpu_time_ns': cpu_time_ns,",
    "        'resident_bytes': resident_bytes,",
    "        'page_faults_total': minor + major,",
    "        'page_faults_soft': minor,",
    "        'page_faults_hard': major,",
    "    }",
    "def within(label, value, lo, hi):",
    "    if value < lo or value > hi:",
    "        raise SystemExit(f'{label}:cu={value}:lo={lo}:hi={hi}')",
    "before = read_metrics()",
    "out = subprocess.check_output(",
    "    [cu, '--target', 'current', '--grant', 'observe', 'process-usage', '--pid', str(pid)],",
    "    text=True)",
    "after = read_metrics()",
    "reply = json.loads(out)",
    "if not reply.get('ok') or reply.get('command') != 'process-usage':",
    "    raise SystemExit('cu_linux_process_usage_reply_state')",
    "data = reply['data']",
    "if data.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_usage_verified')",
    "if int(data['pid']) != pid:",
    "    raise SystemExit('cu_linux_process_usage_pid')",
    "cu_cpu = int(data['cpu_time_ns'])",
    "cu_rss = int(data['resident_bytes'])",
    "cu_total = int(data['page_faults']['total'])",
    "cu_soft = int(data['page_faults']['soft'])",
    "cu_hard = int(data['page_faults']['hard'])",
    "within('cu_linux_process_usage_cpu_time_ns', cu_cpu, before['cpu_time_ns'], after['cpu_time_ns'])",
    "within('cu_linux_process_usage_resident_bytes', cu_rss,",
    "       min(before['resident_bytes'], after['resident_bytes']),",
    "       max(before['resident_bytes'], after['resident_bytes']))",
    "within('cu_linux_process_usage_page_faults_total', cu_total,",
    "       before['page_faults_total'], after['page_faults_total'])",
    "within('cu_linux_process_usage_page_faults_soft', cu_soft,",
    "       before['page_faults_soft'], after['page_faults_soft'])",
    "within('cu_linux_process_usage_page_faults_hard', cu_hard,",
    "       before['page_faults_hard'], after['page_faults_hard'])",
    "state = json.loads(subprocess.check_output(",
    "    [cu, '--target', 'current', '--grant', 'observe', 'process-state', '--pid', str(pid)],",
    "    text=True))",
    "if not state.get('ok') or state['data'].get('start_identity') != data.get('start_identity'):",
    "    raise SystemExit('cu_linux_process_usage_start_identity')",
    "print('pid', pid)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, executable], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_process_usage_readback:" + output.stderr + output.stdout);
}

function verify_pid(run_directory, executable, pid, env) {
  verify_readback(run_directory, executable, pid, env);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-usage");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
try {
  print("STEP process-usage typed-fails usage when AT-SPI --name or other unexpected arguments are present");
  assert_process_usage_usage_limit(context.run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before /proc stat and statm read-back");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP process-usage observe matches independent /proc stat and statm read-back for self");
  verify_pid(context.run_directory, executable, rh.pid(), env);

  print("STEP spawn disposable child and verify --pid read-back");
  const child = harness.start({
    program: "sleep",
    args: ["300"],
    current_dir: context.run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 60000,
  });
  verify_pid(context.run_directory, executable, harness.spawned_pid(child), env);
  harness.kill(child);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-usage-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux process-usage matches independent /proc/<pid>/stat and statm read-back with typed process-usage/get-extents usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux process-usage matches independent /proc/<pid>/stat and statm read-back with typed process-usage/get-extents host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
