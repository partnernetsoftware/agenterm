// Linux public black-box journey for FDO desktop notification dispatch.
// Independent read-back uses session-bus dbus-monitor (not CU self-report).
// Action buttons dispatch through FDO Notify pairs; invoke is proved by
// ActionInvoked on the session bus after dunstctl action (not AT-SPI/coords).
// Typed host-notify usage must reject AT-SPI --name and other unexpected
// arguments; typed get-extents --name usage/host-limit paths must hold before
// the dbus-monitor read-back court. Typed usage and host-limit paths must also
// hold when TITLE/--action are missing or the session bus is unavailable; miss
// paths must not publish onto the bus (independent dbus-monitor read-back).
// AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE | --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.host-notify.linux"];

const AT_SPI_PROBE_NAME = "Host Notify Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(run_directory, executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
    HOME: run_directory,
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_actuate_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "actuate",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_host_notify_actuate_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "host-notify" || text_at(reply, "command") === "usage",
    "cu_linux_host_notify_actuate_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_host_notify_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env("/tmp", executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function run_cu_reply(run_directory, executable, grant, command_argv, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const item of command_argv) { argv.push("" + item); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: cu_env(run_directory, executable),
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_host_notify_empty_stdout:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, command_argv, expect_error, env_remove) {
  const reply = run_cu_reply(run_directory, executable, grant, command_argv, env_remove);
  if (expect_error !== undefined) {
    ensure(!output_success(reply) && text_at(reply, "error.code") === expect_error,
      "cu_linux_host_notify_wrong_failure:" + JSON.stringify(reply));
    return reply.error;
  }
  ensure(output_success(reply), "cu_linux_host_notify_failed:" + JSON.stringify(reply));
  return reply.data;
}

function assert_host_notify_atspi_usage_limit(run_directory, executable, env) {
  const flat_with_name = invoke_actuate_reply(run_directory, executable, [
    "host-notify", "AgenTerm", "body", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_host_notify_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_host_notify_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_host_notify_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    text_at(flat_with_name, "error.message").indexOf("--name") >= 0
      || text_at(flat_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_host_notify_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const alias_with_name = invoke_actuate_reply(run_directory, executable, [
    "notify", "AgenTerm", "body", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(alias_with_name),
    "cu_linux_host_notify_usage_alias_name_ok:" + JSON.stringify(alias_with_name));
  ensure(
    text_at(alias_with_name, "error.code") === "usage",
    "cu_linux_host_notify_usage_alias_name_code:" + JSON.stringify(alias_with_name.error)
  );
  ensure(
    text_at(alias_with_name, "error.message").indexOf("--name") >= 0
      || text_at(alias_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_host_notify_usage_alias_name_message:" + JSON.stringify(alias_with_name.error)
  );

  const with_bogus = invoke_actuate_reply(run_directory, executable, [
    "host-notify", "AgenTerm", "body", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_host_notify_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_host_notify_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("unexpected") >= 0
      || text_at(with_bogus, "error.message").indexOf("--bogus") >= 0,
    "cu_linux_host_notify_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_coords = invoke_actuate_reply(run_directory, executable, [
    "host-notify", "AgenTerm", "body", "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords),
    "cu_linux_host_notify_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_host_notify_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "error.message").indexOf("--coords") >= 0,
    "cu_linux_host_notify_usage_coords_message:" + JSON.stringify(with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_host_notify_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_host_notify_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_host_notify_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_host_notify_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_host_notify_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_host_notify_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_host_notify_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );
}

function assert_get_extents_name_miss(run_directory, executable, env) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(reply),
    "cu_linux_host_notify_extents_miss_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_node_not_found" || code === "bad_handle" || code === "a11y_backend_failed",
    "cu_linux_host_notify_extents_miss_code:" + code
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_host_notify_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_host_notify_extents_unavailable_code:" + code
  );
}

function assert_host_notify_usage_limit(run_directory, executable) {
  const missing_title = run_cu_reply(run_directory, executable, "actuate", ["host-notify"]);
  ensure(!output_success(missing_title), "cu_linux_host_notify_usage_title_ok:" + JSON.stringify(missing_title));
  ensure(
    text_at(missing_title, "error.code") === "usage",
    "cu_linux_host_notify_usage_title_code:" + JSON.stringify(missing_title.error)
  );
  ensure(
    text_at(missing_title, "error.message").indexOf("TITLE") >= 0,
    "cu_linux_host_notify_usage_title_message:" + JSON.stringify(missing_title.error)
  );

  const action_missing_label = run_cu_reply(run_directory, executable, "actuate", [
    "host-notify", "AgenTerm", "--action", "ack",
  ]);
  ensure(!output_success(action_missing_label),
    "cu_linux_host_notify_usage_action_ok:" + JSON.stringify(action_missing_label));
  ensure(
    text_at(action_missing_label, "error.code") === "usage",
    "cu_linux_host_notify_usage_action_code:" + JSON.stringify(action_missing_label.error)
  );
  ensure(
    text_at(action_missing_label, "error.message").indexOf("--action") >= 0,
    "cu_linux_host_notify_usage_action_message:" + JSON.stringify(action_missing_label.error)
  );

  const unexpected_arg = run_cu_reply(run_directory, executable, "actuate", [
    "host-notify", "AgenTerm", "body", "unexpected",
  ]);
  ensure(!output_success(unexpected_arg),
    "cu_linux_host_notify_usage_extra_ok:" + JSON.stringify(unexpected_arg));
  ensure(
    text_at(unexpected_arg, "error.code") === "usage",
    "cu_linux_host_notify_usage_extra_code:" + JSON.stringify(unexpected_arg.error)
  );
  ensure(
    text_at(unexpected_arg, "error.message").indexOf("host-notify accepts") >= 0,
    "cu_linux_host_notify_usage_extra_message:" + JSON.stringify(unexpected_arg.error)
  );
}

function assert_miss_does_not_dispatch(
  run_directory, executable, log_path, pid_path, command_argv, expect_error, token, label
) {
  const pid = start_dbus_monitor(run_directory, log_path, pid_path);
  harness.sleep_ms(150);
  const error = run_cu(run_directory, executable, "actuate", command_argv, expect_error);
  harness.sleep_ms(200);
  stop_dbus_monitor(pid);
  ensure(text_at(error, "detail.effect") === "not_performed",
    "cu_linux_host_notify_miss_effect_" + label);
  ensure(direct_file(log_path), "cu_linux_host_notify_miss_log_missing_" + label);
  const monitor_text = rh.read_text(log_path);
  ensure(monitor_text.indexOf(token) < 0,
    "cu_linux_host_notify_miss_token_leaked_" + label + ":" + token);
}

function dbus_send(command_argv) {
  const output = rh.command("dbus-send", command_argv, { timeout_ms: 15000 });
  ensure(output.success === true, "cu_linux_host_notify_dbus_send:" + output.stderr);
  return output.stdout;
}

function start_dbus_monitor(run_directory, log_path, pid_path) {
  rh.command("sh", ["-c",
    "dbus-monitor --session > '" + log_path + "' 2>&1 & echo $! > '" + pid_path + "'"
  ], { timeout_ms: 5000, cwd: run_directory });
  ensure(direct_file(pid_path), "cu_linux_host_notify_monitor_pid_missing");
  const pid = parseInt(rh.read_text(pid_path).trim(), 10);
  ensure(pid > 0, "cu_linux_host_notify_monitor_pid_invalid");
  return pid;
}

function stop_dbus_monitor(pid) {
  if (!(pid > 0)) { return; }
  rh.command("kill", ["" + pid], { timeout_ms: 5000 });
  harness.sleep_ms(250);
}

function run_dunstctl(args) {
  const output = rh.command("dunstctl", args, { timeout_ms: 10000 });
  ensure(output.success === true, "cu_linux_host_notify_dunstctl:" + output.stderr);
  return output.stdout;
}

const script_argv = rh.args();
if (script_argv.length === 1 && script_argv[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(script_argv.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(script_argv[0]);
const executable = rh.absolute(script_argv[1]);
ensure(direct_file(executable), "cu_linux_host_notify_executable_missing");

const context = harness.new_context(repo, "cu-linux-host-notify");
const run_directory = context.run_directory;
const env = cu_env(run_directory, executable);
const atspi_available = probe_atspi_available(executable);
const monitor_log = rh.join(run_directory, "dbus-notify.log");
const monitor_pid_path = rh.join(run_directory, "dbus-notify.pid");
const action_log = rh.join(run_directory, "dbus-action.log");
const action_pid_path = rh.join(run_directory, "dbus-action.pid");
let monitor_pid = 0;
let action_pid = 0;
let succeeded = 0;
let failure = "";

try {
  print("STEP capabilities declare host-notify available with dispatcher-accepted-only verification");
  const capabilities = run_cu(run_directory, executable, "observe", ["capabilities"]);
  const notify_cap = at(capabilities, "verbs.host-notify");
  ensure(text_at(notify_cap, "status") === "available", "cu_linux_host_notify_cap_status");
  ensure(text_at(notify_cap, "verification") === "dispatcher-accepted-only",
    "cu_linux_host_notify_cap_verification");
  ensure(text_at(notify_cap, "actions.status") === "available",
    "cu_linux_host_notify_actions_cap_status");
  ensure(text_at(notify_cap, "actions.invoke") === "session-bus-action-invoked-only",
    "cu_linux_host_notify_actions_invoke_truth");
  ensure(text_at(notify_cap, "actions.mode") === "fdo-notify-action-pairs",
    "cu_linux_host_notify_actions_mode_truth");
  ensure(text_at(notify_cap, "actions.verification") === "dispatcher-accepted-only",
    "cu_linux_host_notify_actions_verification_truth");

  print("STEP host-notify typed-fails usage when TITLE or --action pairs are missing");
  assert_host_notify_usage_limit(run_directory, executable);

  print("STEP host-notify typed-fails usage when AT-SPI --name, --coords, --bogus, or other unexpected arguments are present");
  assert_host_notify_atspi_usage_limit(run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents --name usage/host-limit court before dbus-monitor read-back court");
    print("STEP get-extents typed-fail invalid_input when --window is zero or --name is missing");
    assert_get_extents_usage_limit(run_directory, executable, env);
    print("STEP get-extents typed-fail a11y_node_not_found when the named anchor is absent");
    assert_get_extents_name_miss(run_directory, executable, env);
  } else {
    print("STEP get-extents --name host-limit court before dbus-monitor read-back court");
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
  }

  print("STEP host-notify without session bus returns typed dispatcher-unavailable host-limit detail");
  const no_bus_token = "cu-host-notify-no-bus-" + rh.now_ms();
  const no_bus_log = rh.join(run_directory, "dbus-no-bus.log");
  const no_bus_pid_path = rh.join(run_directory, "dbus-no-bus.pid");
  const no_bus_pid = start_dbus_monitor(run_directory, no_bus_log, no_bus_pid_path);
  harness.sleep_ms(150);
  const no_bus = run_cu(run_directory, executable, "actuate",
    ["host-notify", "AgenTerm", no_bus_token], "host_notification_dispatcher_unavailable",
    ["DBUS_SESSION_BUS_ADDRESS"]);
  harness.sleep_ms(200);
  stop_dbus_monitor(no_bus_pid);
  ensure(text_at(no_bus, "detail.effect") === "not_performed",
    "cu_linux_host_notify_no_bus_effect");
  ensure(
    text_at(no_bus, "message").indexOf("session") >= 0
      || text_at(no_bus, "message").indexOf("dispatcher") >= 0
      || text_at(no_bus, "message").indexOf("bus") >= 0
      || text_at(no_bus, "message").indexOf("DBus") >= 0,
    "cu_linux_host_notify_no_bus_message:" + JSON.stringify(no_bus)
  );
  ensure(direct_file(no_bus_log), "cu_linux_host_notify_no_bus_log_missing");
  ensure(rh.read_text(no_bus_log).indexOf(no_bus_token) < 0,
    "cu_linux_host_notify_no_bus_token_leaked:" + no_bus_token);

  print("STEP FDO GetCapabilities reports the session notification server honestly");
  const capabilities_text = dbus_send([
    "--session", "--print-reply",
    "--dest=org.freedesktop.Notifications",
    "/org/freedesktop/Notifications",
    "org.freedesktop.Notifications.GetCapabilities"
  ]);
  ensure(capabilities_text.indexOf("string \"actions\"") >= 0,
    "cu_linux_host_notify_fdo_actions_capability");
  ensure(capabilities_text.indexOf("string \"body\"") >= 0,
    "cu_linux_host_notify_fdo_body_capability");

  print("STEP oversized body fails typed before native dispatch");
  const oversized = "x".repeat(16385);
  const invalid = run_cu(run_directory, executable, "actuate",
    ["host-notify", "AgenTerm", oversized], "host_notification_invalid_input");
  ensure(text_at(invalid, "detail.effect") === "not_performed",
    "cu_linux_host_notify_invalid_effect");

  print("STEP Linux rejects subtitle and sound with typed unsupported");
  const subtitle_error = run_cu(run_directory, executable, "actuate",
    ["host-notify", "AgenTerm", "body", "--subtitle", "linux-only"], "host_notification_unsupported");
  ensure(text_at(subtitle_error, "detail.effect") === "not_performed",
    "cu_linux_host_notify_subtitle_effect");
  const sound_error = run_cu(run_directory, executable, "actuate",
    ["host-notify", "AgenTerm", "body", "--sound"], "host_notification_unsupported");
  ensure(text_at(sound_error, "detail.effect") === "not_performed",
    "cu_linux_host_notify_sound_effect");

  print("STEP invalid title/action miss paths must not publish onto the session bus");
  const miss_title_token = "cu-host-notify-miss-title-" + rh.now_ms();
  assert_miss_does_not_dispatch(
    run_directory, executable,
    rh.join(run_directory, "dbus-miss-title.log"),
    rh.join(run_directory, "dbus-miss-title.pid"),
    ["host-notify", "", miss_title_token],
    "host_notification_invalid_input",
    miss_title_token,
    "empty_title"
  );
  const miss_action_token = "cu-host-notify-miss-action-" + rh.now_ms();
  assert_miss_does_not_dispatch(
    run_directory, executable,
    rh.join(run_directory, "dbus-miss-action.log"),
    rh.join(run_directory, "dbus-miss-action.pid"),
    ["host-notify", "AgenTerm", miss_action_token, "--action", "", "Acknowledge"],
    "host_notification_invalid_input",
    miss_action_token,
    "empty_action_key"
  );

  print("STEP session-bus monitor proves FDO Notify carries the bounded token");
  monitor_pid = start_dbus_monitor(run_directory, monitor_log, monitor_pid_path);
  harness.sleep_ms(150);
  const token = "cu-host-notify-linux-" + rh.now_ms();
  const sent = run_cu(run_directory, executable, "actuate",
    ["notify", "AgenTerm CU", token]);
  harness.sleep_ms(200);
  stop_dbus_monitor(monitor_pid);
  monitor_pid = 0;
  ensure(direct_file(monitor_log), "cu_linux_host_notify_monitor_log_missing");
  const monitor_text = rh.read_text(monitor_log);
  ensure(monitor_text.indexOf("org.freedesktop.Notifications; member=Notify") >= 0,
    "cu_linux_host_notify_monitor_notify_call");
  ensure(monitor_text.indexOf(token) >= 0,
    "cu_linux_host_notify_monitor_token_missing");
  ensure(sent.performed === true && sent.accepted === true && sent.verified === false,
    "cu_linux_host_notify_receipt_truth:" + JSON.stringify(sent));
  const provider = text_at(sent, "provider");
  ensure(provider === "linux-fdo-notifications" || provider === "linux-notify-send",
    "cu_linux_host_notify_provider_truth:" + provider);
  ensure(text_at(sent, "verification") === "dispatcher-accepted-only",
    "cu_linux_host_notify_verification_truth");
  ensure(text_at(sent, "title_evidence.sha256").length === 64
      && text_at(sent, "body_evidence.sha256").length === 64,
    "cu_linux_host_notify_redacted_evidence");

  print("STEP action buttons dispatch through FDO Notify and invoke via ActionInvoked read-back");
  run_dunstctl(["close-all"]);
  harness.sleep_ms(150);
  const action_key = "ack";
  const action_label = "Acknowledge";
  const action_token = "cu-host-notify-action-" + rh.now_ms();
  action_pid = start_dbus_monitor(run_directory, action_log, action_pid_path);
  harness.sleep_ms(150);
  const action_sent = run_cu(run_directory, executable, "actuate", [
    "host-notify", "AgenTerm Action", action_token,
    "--action", action_key, action_label
  ]);
  harness.sleep_ms(250);
  const action_monitor_text = rh.read_text(action_log);
  ensure(action_monitor_text.indexOf("member=Notify") >= 0,
    "cu_linux_host_notify_action_notify_missing");
  ensure(action_monitor_text.indexOf(action_key) >= 0,
    "cu_linux_host_notify_action_key_missing");
  ensure(action_monitor_text.indexOf(action_label) >= 0,
    "cu_linux_host_notify_action_label_missing");
  ensure(action_monitor_text.indexOf(action_token) >= 0,
    "cu_linux_host_notify_action_token_missing");
  ensure(action_sent.actions_evidence.length === 1,
    "cu_linux_host_notify_action_evidence_count:" + JSON.stringify(action_sent));
  ensure(action_sent.actions_evidence[0].key_evidence.sha256.length === 64,
    "cu_linux_host_notify_action_key_redacted");
  ensure(text_at(action_sent, "verification") === "dispatcher-accepted-only",
    "cu_linux_host_notify_action_receipt_verification");
  run_dunstctl(["action", "0"]);
  harness.sleep_ms(400);
  stop_dbus_monitor(action_pid);
  action_pid = 0;
  const action_invoke_text = rh.read_text(action_log);
  ensure(action_invoke_text.indexOf("member=ActionInvoked") >= 0,
    "cu_linux_host_notify_action_invoked_missing");
  ensure(action_invoke_text.indexOf('string "' + action_key + '"') >= 0,
    "cu_linux_host_notify_action_invoked_key_missing");
  run_dunstctl(["close-all"]);

  harness.emit_evidence(context, declared_evidence, "cu.host-notify.linux");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (monitor_pid > 0) { stop_dbus_monitor(monitor_pid); }
if (action_pid > 0) { stop_dbus_monitor(action_pid); }
ensure(succeeded === 1, failure || "cu_linux_host_notify_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux FDO host-notify dispatch with dbus read-back, typed host-notify/get-extents usage honesty, miss/host-limit honesty, and action-button invoke (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux FDO host-notify dispatch with dbus read-back, typed host-notify/get-extents host-limit honesty, miss/host-limit honesty, and action-button invoke (AT-SPI --name, no --coords)");
}
return;
