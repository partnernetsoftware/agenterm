    "cu_linux_file_xattr_usage_set_grouped_bogus_message:" + JSON.stringify(grouped_set_with_bogus.error)
  );

  const flat_set_with_coords = invoke_reply(run_directory, executable, "observe", [
    "file-xattr-set", fixture, attribute_name, "--value-hex", secret_hex, "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(flat_set_with_coords),
