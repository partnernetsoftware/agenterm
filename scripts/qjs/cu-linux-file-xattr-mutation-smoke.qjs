// CEO: Linux identity-bound extended-attribute set/remove with independent read-back.
// Acceptance is smoke read-back only: CU file-xattr preview/apply/remove must agree
// with independent native xattr and file-attributes probes. Typed file-xattr-set/
// file-xattr-remove usage must reject AT-SPI --name, --coords, --bogus, and other
// unexpected arguments; typed get-extents --name usage AND host-limit paths must both
// hold before the xattr mutate/read-back court. Permission-denied open host-limit
// paths must match an independent os.open probe. Prefer host-limit clarity over fake
// success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE | --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.linux-file-xattr-mutation"];

const AT_SPI_PROBE_NAME = "File Xattr Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function isolated_env(run_directory, executable) {
  const env = {
    HOME: rh.join(run_directory, "home"),
    USERPROFILE: rh.join(run_directory, "home"),
    XDG_CONFIG_HOME: rh.join(run_directory, "config"),
    XDG_DATA_HOME: rh.join(run_directory, "data"),
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
    AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
    AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(run_directory, "cu-requests.json"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  const cu = cu_env(executable);
  env.AGENTERM_ABI_LIB = cu.AGENTERM_ABI_LIB;
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (cu[key] !== undefined) { env[key] = cu[key]; }
  }
  return env;
}

function invoke_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (let i = 0; i < arguments.length; i = i + 1) { argv.push(arguments[i]); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_file_xattr_cli:" + output.stdout + output.stderr);
  let reply = null;
  try { reply = JSON.parse(output.stdout.trim()); }
  catch (error) { throw "cu_linux_file_xattr_invalid_reply"; }
  const command = text_at(reply, "command");
  ensure(
    command === "file-xattr-set" || command === "file-xattr-remove"
      || command === "file-attributes" || command === "usage",
    "cu_linux_file_xattr_wrong_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_file_xattr_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function invoke(run_directory, executable, grant, arguments, expected_command, expected_error, env) {
  const reply = invoke_reply(run_directory, executable, grant, arguments, env);
  ensure(text_at(reply, "command") === expected_command,
    "cu_linux_file_xattr_wrong_command:" + expected_command + ":" + JSON.stringify(reply));
  if (expected_error !== undefined) {
    ensure(!rh.output_success(reply),
      "cu_linux_file_xattr_expected_failure:" + expected_command);
    ensure(reply.error.code === expected_error,
      "cu_linux_file_xattr_wrong_error:" + expected_command + ":" + reply.error.code);
    return reply.error;
  }
  ensure(rh.output_success(reply),
    "cu_linux_file_xattr_failed:" + expected_command + ":" + JSON.stringify(reply));
  return reply.data;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function file_xattr_usage_rejects(message, token) {
  return usage_rejects_unexpected(message, token)
    || message.indexOf("requires PATH NAME") >= 0;
}

function assert_file_xattr_usage_limit(
  run_directory, executable, fixture, attribute_name, secret_hex, env
) {
  const flat_set_with_name = invoke_reply(run_directory, executable, "observe", [
    "file-xattr-set", fixture, attribute_name, "--value-hex", secret_hex,
    "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(flat_set_with_name),
    "cu_linux_file_xattr_usage_set_flat_name_ok:" + JSON.stringify(flat_set_with_name));
  ensure(
    text_at(flat_set_with_name, "error.code") === "usage",
    "cu_linux_file_xattr_usage_set_flat_name_code:" + JSON.stringify(flat_set_with_name.error)
  );
  ensure(
    text_at(flat_set_with_name, "command") === "usage",
    "cu_linux_file_xattr_usage_set_flat_name_command:" + JSON.stringify(flat_set_with_name)
  );
  ensure(
    file_xattr_usage_rejects(text_at(flat_set_with_name, "error.message"), "--name"),
    "cu_linux_file_xattr_usage_set_flat_name_message:" + JSON.stringify(flat_set_with_name.error)
  );

  const grouped_set_with_name = invoke_reply(run_directory, executable, "observe", [
    "file", "xattr-set", fixture, attribute_name, "--value-hex", secret_hex,
    "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(grouped_set_with_name),
    "cu_linux_file_xattr_usage_set_grouped_name_ok:" + JSON.stringify(grouped_set_with_name));
  ensure(
    text_at(grouped_set_with_name, "error.code") === "usage",
    "cu_linux_file_xattr_usage_set_grouped_name_code:" + JSON.stringify(grouped_set_with_name.error)
  );
  ensure(
    file_xattr_usage_rejects(text_at(grouped_set_with_name, "error.message"), "--name"),
    "cu_linux_file_xattr_usage_set_grouped_name_message:" + JSON.stringify(grouped_set_with_name.error)
  );

  const flat_set_with_bogus = invoke_reply(run_directory, executable, "observe", [
    "file-xattr-set", fixture, attribute_name, "--value-hex", secret_hex, "--bogus",
  ], env);
  ensure(!rh.output_success(flat_set_with_bogus),
    "cu_linux_file_xattr_usage_set_flat_bogus_ok:" + JSON.stringify(flat_set_with_bogus));
  ensure(
    text_at(flat_set_with_bogus, "error.code") === "usage",
    "cu_linux_file_xattr_usage_set_flat_bogus_code:" + JSON.stringify(flat_set_with_bogus.error)
