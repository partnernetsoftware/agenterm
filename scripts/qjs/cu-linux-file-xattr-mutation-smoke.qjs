    "cu_linux_file_xattr_usage_set_flat_coords_message:" + JSON.stringify(flat_set_with_coords.error)
  );

  const grouped_set_with_coords = invoke_reply(run_directory, executable, "observe", [
    "file", "xattr-set", fixture, attribute_name, "--value-hex", secret_hex, "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(grouped_set_with_coords),
    "cu_linux_file_xattr_usage_set_grouped_coords_ok:" + JSON.stringify(grouped_set_with_coords));
  ensure(
