  );
  ensure(
    file_xattr_usage_rejects(text_at(flat_set_with_bogus, "error.message"), "--bogus"),
    "cu_linux_file_xattr_usage_set_flat_bogus_message:" + JSON.stringify(flat_set_with_bogus.error)
  );

  const grouped_set_with_bogus = invoke_reply(run_directory, executable, "observe", [
    "file", "xattr-set", fixture, attribute_name, "--value-hex", secret_hex, "--bogus",
  ], env);
  ensure(!rh.output_success(grouped_set_with_bogus),
    "cu_linux_file_xattr_usage_set_grouped_bogus_ok:" + JSON.stringify(grouped_set_with_bogus));
  ensure(
