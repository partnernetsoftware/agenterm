function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_file_xattr_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_file_xattr_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_file_xattr_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_file_xattr_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_file_xattr_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_file_xattr_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_xattr_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_file_xattr_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_file_xattr_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_file_xattr_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_xattr_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_file_xattr_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_file_xattr_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_file_xattr_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_xattr_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_file_xattr_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_file_xattr_extents_unavailable_code:" + code
  );
}

function probe_file_open(path) {
  const script = [
    "import json, os, sys",
    "path = sys.argv[1]",
    "readable = False",
    "error_kind = None",
    "try:",
    "    handle = os.open(path, os.O_RDONLY)",
    "    os.close(handle)",
    "    readable = True",
    "except OSError as error:",
    "    if error.errno == 13:",
    "        error_kind = 'PermissionDenied'",
    "    elif error.errno == 2:",
    "        error_kind = 'NotFound'",
    "    else:",
    "        error_kind = error.__class__.__name__",
    "print(json.dumps({",
    "    'readable': readable,",
    "    'error_kind': error_kind,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, path], {
    timeout_ms: 10000,
  });
  ensure(output.success === true,
    "cu_linux_file_xattr_open_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function assert_file_xattr_open_denied_host_limit(
  run_directory, executable, path, attribute_name, secret_hex, grant, env, apply
) {
  const probe = probe_file_open(path);
  ensure(probe.readable !== true && probe.error_kind === "PermissionDenied",
    "cu_linux_file_xattr_denied_probe_not_denied:" + JSON.stringify(probe));
  const arguments = ["file-xattr-set", path, attribute_name, "--value-hex", secret_hex];
  if (apply === true) { arguments.push("--apply"); }
  const reply = invoke_reply(run_directory, executable, grant, arguments, env);
  ensure(!rh.output_success(reply),
    "cu_linux_file_xattr_denied_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "file_xattr_open_failed",
    "cu_linux_file_xattr_denied_code:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message");
  ensure(
    message.indexOf("Permission denied") >= 0 || message.indexOf("os error 13") >= 0,
    "cu_linux_file_xattr_denied_message:" + message
  );
}

function native_has_xattr(path, name) {
  const script = [
    "import os, sys",
    "path = sys.argv[1]",
    "name = sys.argv[2]",
    "try:",
    "    os.getxattr(path, name)",
    "    sys.exit(0)",
    "except OSError:",
    "    sys.exit(1)"
  ].join("\n");
  const output = rh.command("/usr/bin/python3", ["-c", script, path, name], {
    timeout_ms: 10000
  });
  return output.success === true;
}

function find_attribute(attributes, name) {
  for (let i = 0; i < attributes.length; i = i + 1) {
    if (attributes[i].name === name) { return attributes[i]; }
  }
  return null;
}

function ensure_state(state, present, bytes, message) {
  ensure(state.present === present && state.bytes === bytes, message + ":shape");
  if (present) {
    ensure(typeof state.sha256 === "string" && state.sha256.length === 64,
      message + ":digest");
  } else {
    ensure(state.sha256 === null, message + ":absent_digest");
  }
}

function ensure_action(action, apply_requested, performed, verified, message) {
  ensure(action.apply_requested === apply_requested
    && action.performed === performed
    && action.verified === verified, message);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (let i = 0; i < declared_evidence.length; i = i + 1) { print(declared_evidence[i]); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_file_xattr_executable_missing");

const uname = rh.command("/usr/bin/uname", ["-s"], { timeout_ms: 10000 });
ensure(uname.success === true && uname.stdout.trim() === "Linux",
  "cu_linux_file_xattr_requires_linux");

const context = harness.new_context(repo, "cu-linux-file-xattr-mutation");
const run_directory = context.run_directory;
const env = isolated_env(run_directory, executable);
const atspi_available = probe_atspi_available(executable);
const fixture = rh.join(run_directory, "fixture.bin");
const denied_fixture = rh.join(run_directory, "denied-fixture.bin");
const link = rh.join(run_directory, "fixture-link.bin");
const attribute_name = "user.agenterm.cu.mutation";
const secret_text = "vault-leaf-47";
const secret_hex = "7661756c742d6c6561662d3437";
let succeeded = 0;
let failure = "";

try {
  rh.write_text(fixture, "xattr-mutation-fixture-body");
  ensure(native_has_xattr(fixture, attribute_name) !== true,
    "cu_linux_file_xattr_fixture_not_clean");

  print("STEP file-xattr typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_file_xattr_usage_limit(
    run_directory, executable, fixture, attribute_name, secret_hex, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before xattr mutate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before xattr mutate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; file-xattr mutate/read-back still uses native xattr and file-attributes");
  }

  print("STEP default set is a zero-write preview with performed=false");
  const plan = invoke(run_directory, executable, "observe", [
    "file-xattr-set", fixture, attribute_name, "--value-hex", secret_hex
  ], "file-xattr-set", undefined, env);
  ensure(plan.name === attribute_name && plan.operation === "set"
    && plan.values_redacted === true, "cu_linux_file_xattr_plan_contract");
  ensure_state(plan.before, false, "0", "cu_linux_file_xattr_plan_before");
  ensure_state(plan.requested, true, "13", "cu_linux_file_xattr_plan_requested");
  ensure_state(plan.after, false, "0", "cu_linux_file_xattr_plan_after");
  ensure_action(plan.action, false, false, false, "cu_linux_file_xattr_plan_action");
  ensure(JSON.stringify(plan).indexOf(secret_text) < 0
    && JSON.stringify(plan).indexOf(secret_hex) < 0, "cu_linux_file_xattr_plan_leaked_value");
  ensure(native_has_xattr(fixture, attribute_name) !== true,
    "cu_linux_file_xattr_plan_mutated");

  print("STEP actuate set applies and file-attributes read-back shows the xattr");
  const applied = invoke(run_directory, executable, "actuate", [
    "file-xattr-set", fixture, attribute_name, "--value-hex", secret_hex, "--apply"
  ], "file-xattr-set", undefined, env);
  ensure_state(applied.before, false, "0", "cu_linux_file_xattr_apply_before");
  ensure_state(applied.requested, true, "13", "cu_linux_file_xattr_apply_requested");
  ensure_state(applied.after, true, "13", "cu_linux_file_xattr_apply_after");
  ensure_action(applied.action, true, true, true, "cu_linux_file_xattr_apply_action");
  ensure(JSON.stringify(applied).indexOf(secret_text) < 0
    && JSON.stringify(applied).indexOf(secret_hex) < 0, "cu_linux_file_xattr_apply_leaked_value");
  ensure(native_has_xattr(fixture, attribute_name) === true,
    "cu_linux_file_xattr_native_missing_after_apply");

  const metadata = invoke(run_directory, executable, "observe", [
    "file-attributes", fixture
  ], "file-attributes", undefined, env);
  ensure(metadata.include_values === false, "cu_linux_file_xattr_default_disclosure_flag");
  const redacted = find_attribute(metadata.attributes, attribute_name);
  ensure(redacted !== null && redacted.value_bytes === "13"
    && typeof redacted.value_sha256 === "string" && redacted.value_sha256.length === 64
    && redacted.value_hex === null, "cu_linux_file_xattr_attributes_readback");
  ensure(JSON.stringify(metadata).indexOf(secret_text) < 0
    && JSON.stringify(metadata).indexOf(secret_hex) < 0, "cu_linux_file_xattr_attributes_leaked_value");

  print("STEP remove apply clears the attribute with independent native read-back");
  const removed = invoke(run_directory, executable, "actuate", [
    "file-xattr-remove", fixture, attribute_name, "--apply"
  ], "file-xattr-remove", undefined, env);
  ensure_state(removed.before, true, "13", "cu_linux_file_xattr_remove_before");
  ensure_state(removed.after, false, "0", "cu_linux_file_xattr_remove_after");
  ensure_action(removed.action, true, true, true, "cu_linux_file_xattr_remove_action");
  ensure(native_has_xattr(fixture, attribute_name) !== true,
    "cu_linux_file_xattr_native_still_present");
  const cleared = invoke(run_directory, executable, "observe", [
    "file-attributes", fixture
  ], "file-attributes", undefined, env);
  ensure(find_attribute(cleared.attributes, attribute_name) === null,
    "cu_linux_file_xattr_attributes_still_present");

  rh.write_text(denied_fixture, "xattr-denied-fixture");
  const denied_prep = rh.command("/bin/chmod", ["0000", denied_fixture], {
    cwd: run_directory,
    timeout_ms: 10000,
  });
  ensure(denied_prep.success === true,
    "cu_linux_file_xattr_denied_fixture_setup_failed:" + denied_prep.stderr);
  const denied_probe = probe_file_open(denied_fixture);
  if (denied_probe.readable !== true && denied_probe.error_kind === "PermissionDenied") {
    print("STEP file-xattr-set typed-fails file_xattr_open_failed host-limit when independent os.open probe is denied");
    assert_file_xattr_open_denied_host_limit(
      run_directory, executable, denied_fixture, attribute_name, secret_hex,
      "observe", env, false);
    assert_file_xattr_open_denied_host_limit(
      run_directory, executable, denied_fixture, attribute_name, secret_hex,
      "actuate", env, true);
    ensure(native_has_xattr(fixture, attribute_name) !== true,
      "cu_linux_file_xattr_denied_mutated_fixture");
  } else {
    print("STEP skip permission-denied host-limit: independent os.open probe is readable on this host");
  }

  print("STEP a final symlink is typed refused and leaves its target unchanged");
  const linked = rh.command("/bin/ln", ["-s", fixture, link], {
    cwd: run_directory,
    timeout_ms: 10000
  });
  ensure(linked.success === true, "cu_linux_file_xattr_symlink_setup_failed");
  invoke(run_directory, executable, "actuate", [
    "file-xattr-set", link, attribute_name, "--value-hex", secret_hex, "--apply"
  ], "file-xattr-set", "file_xattr_not_regular", env);
  ensure(native_has_xattr(fixture, attribute_name) !== true,
    "cu_linux_file_xattr_symlink_target_mutated");

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, declared_evidence[0]);
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux file-xattr preview/apply/remove with native and file-attributes read-back plus typed file-xattr --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux file-xattr preview/apply/remove with native and file-attributes read-back plus typed file-xattr --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
