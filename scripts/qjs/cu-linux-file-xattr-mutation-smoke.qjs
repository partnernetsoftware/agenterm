    "cu_linux_file_xattr_usage_set_grouped_coords_message:" + JSON.stringify(grouped_set_with_coords.error)
  );

  const flat_remove_with_name = invoke_reply(run_directory, executable, "observe", [
    "file-xattr-remove", fixture, attribute_name, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(flat_remove_with_name),
    "cu_linux_file_xattr_usage_remove_flat_name_ok:" + JSON.stringify(flat_remove_with_name));
  ensure(
    text_at(flat_remove_with_name, "error.code") === "usage",
    "cu_linux_file_xattr_usage_remove_flat_name_code:" + JSON.stringify(flat_remove_with_name.error)
  );
  ensure(
    text_at(flat_remove_with_name, "command") === "usage",
    "cu_linux_file_xattr_usage_remove_flat_name_command:" + JSON.stringify(flat_remove_with_name)
  );
  ensure(
    file_xattr_usage_rejects(text_at(flat_remove_with_name, "error.message"), "--name"),
    "cu_linux_file_xattr_usage_remove_flat_name_message:" + JSON.stringify(flat_remove_with_name.error)
  );

  const grouped_remove_with_name = invoke_reply(run_directory, executable, "observe", [
    "file", "xattr-remove", fixture, attribute_name, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(grouped_remove_with_name),
    "cu_linux_file_xattr_usage_remove_grouped_name_ok:" + JSON.stringify(grouped_remove_with_name));
  ensure(
    text_at(grouped_remove_with_name, "error.code") === "usage",
    "cu_linux_file_xattr_usage_remove_grouped_name_code:" + JSON.stringify(grouped_remove_with_name.error)
  );
  ensure(
    file_xattr_usage_rejects(text_at(grouped_remove_with_name, "error.message"), "--name"),
    "cu_linux_file_xattr_usage_remove_grouped_name_message:" + JSON.stringify(grouped_remove_with_name.error)
  );

  const flat_remove_with_bogus = invoke_reply(run_directory, executable, "observe", [
    "file-xattr-remove", fixture, attribute_name, "--bogus",
  ], env);
  ensure(!rh.output_success(flat_remove_with_bogus),
    "cu_linux_file_xattr_usage_remove_flat_bogus_ok:" + JSON.stringify(flat_remove_with_bogus));
  ensure(
