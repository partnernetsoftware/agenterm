// CEO#2: GTK entry focus → send-text SEED → get-text. Acceptance is N≥2
// independent send-text→get-text roundtrips with pyatspi Text.GetText == SEED
// through AT-SPI --name only; no --coords or screenshot. Typed
// focus/send-text/get-text usage must reject missing/zero --window,
// --role-without--name, and --coords/--bogus misuse via
// usage_rejects_unexpected + command=usage, or an honest non-usage typed
// failure (never fake command=usage), or stay on accessibility-tree --name.
// Typed get-extents --name usage AND host-limit courts must both hold before
// process-state, desktop-state, and the native actuate/read-back court (no
// if/else gating those courts on atspi_available), including get-extents
// --coords/--bogus command=usage honesty. process-state and desktop-state
// fixture binding courts must hold before actuate/read-back. Miss paths must
// not mutate the entry (independent get-text read-back).
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-gtk-entry-focus",
  "cu.linux-gtk-entry-send-text",
  "cu.linux-gtk-entry-get-text",
];

const ENTRY_NAME = "Fixture Entry";
const MISSING_NODE = "No Such Entry";
const READBACK_COUNT = 2;
const FIXTURE_SEED = "seed";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function honest_actuate_non_usage_code(code) {
  return code === "a11y_backend_failed"
    || code === "unsupported"
    || code === "bad_handle"
    || code === "window_not_found"
    || code === "a11y_window_gone"
    || code === "invalid_input"
    || code === "a11y_focus_unavailable"
    || code === "a11y_node_not_found";
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_entry_text_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(document), "cu_linux_gtk_entry_text_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_entry_text_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function independent_probe_script() {
  return [
    "import json, sys",
    "import pyatspi",
    "",
    "config = json.loads(sys.argv[1])",
    "title = config['title']",
    "name_pattern = config.get('name_pattern', '')",
    "",
    "def gettext_of_node(obj):",
    "    try:",
    "        text_iface = obj.queryText()",
    "        count = text_iface.characterCount",
    "        return text_iface.getText(0, count)",
    "    except Exception:",
    "        return None",
    "",
    "def find_frame():",
    "    desktop = pyatspi.Registry.getDesktop(0)",
    "    for index in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(index)",
    "        if app is None:",
    "            continue",
    "        for child_index in range(app.childCount):",
    "            window = app.getChildAtIndex(child_index)",
    "            if window is not None and (window.name or '') == title:",
    "                return window",
    "    return None",
    "",
    "def named_text(root, pattern):",
    "    hits = []",
    "    def walk(obj):",
    "        name = obj.name or ''",
    "        if pattern in name:",
    "            text = gettext_of_node(obj)",
    "            if text is not None:",
    "                hits.append(text)",
    "        for index in range(obj.childCount):",
    "            child = obj.getChildAtIndex(index)",
    "            if child is not None:",
    "                walk(child)",
    "    walk(root)",
    "    if len(hits) != 1:",
    "        raise SystemExit('cu_linux_gtk_entry_text_probe_named_count:' + str(len(hits)))",
    "    return hits[0]",
    "",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_gtk_entry_text_probe_window_missing')",
    "text = named_text(frame, name_pattern)",
    "print(json.dumps({'text': text}))",
  ].join("\n");
}

function independent_text_probe(run_directory, executable, probe_config_json) {
  const output = rh.command("python3", ["-c", independent_probe_script(), probe_config_json], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_gtk_entry_text_probe:" + output.stderr + output.stdout);
  const document = JSON.parse(output.stdout.trim());
  ensure(typeof document.text === "string", "cu_linux_gtk_entry_text_probe_text");
  return document;
}

function assert_entry_text(run_directory, executable, handle, fixture_title, expected, label) {
  const got = run_cu(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", ENTRY_NAME,
  ]);
  const readback = text_at(got, "data.text");
  ensure(
    readback === expected && text_at(got, "data.via") === "gettext",
    "cu_linux_gtk_entry_text_get_" + label + ":" + JSON.stringify({
      expected: expected,
      readback: readback,
    })
  );
  const probe = independent_text_probe(
    run_directory, executable,
    JSON.stringify({ title: fixture_title, name_pattern: ENTRY_NAME })
  );
  ensure(
    probe.text === expected,
    "cu_linux_gtk_entry_text_probe_mismatch_" + label + ":" + JSON.stringify({
      expected: expected,
      cu: readback,
      probe: probe.text,
    })
  );
  return got;
}

function assert_usage_or_honest_non_usage(reply, label, token) {
  ensure(!output_success(reply),
    "cu_linux_gtk_entry_text_" + label + "_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  const command = text_at(reply, "command");
  if (code === "usage" || command === "usage") {
    ensure(
      code === "usage",
      "cu_linux_gtk_entry_text_" + label + "_code:" + JSON.stringify(reply.error)
    );
    ensure(
      command === "usage",
      "cu_linux_gtk_entry_text_" + label + "_command:" + JSON.stringify(reply)
    );
    ensure(
      usage_rejects_unexpected(text_at(reply, "error.message"), token)
        || text_at(reply, "error.message").indexOf("--name") >= 0,
      "cu_linux_gtk_entry_text_" + label + "_message:" + JSON.stringify(reply.error)
    );
  } else {
    ensure(
      command !== "usage" && honest_actuate_non_usage_code(code),
      "cu_linux_gtk_entry_text_" + label + "_honest:" + JSON.stringify(reply)
    );
    ensure(
      JSON.stringify(reply).indexOf("coordinate") < 0
        && JSON.stringify(reply).indexOf("XTest") < 0,
      "cu_linux_gtk_entry_text_" + label + "_degraded:" + JSON.stringify(reply)
    );
  }
}

function assert_named_stay_or_misuse(reply, label, via, token) {
  if (!output_success(reply)) {
    const code = text_at(reply, "error.code");
    const command = text_at(reply, "command");
    if (code === "usage" || command === "usage") {
      ensure(
        code === "usage",
        "cu_linux_gtk_entry_text_" + label + "_code:" + JSON.stringify(reply.error)
      );
      ensure(
        command === "usage",
        "cu_linux_gtk_entry_text_" + label + "_command:" + JSON.stringify(reply)
      );
      ensure(
        usage_rejects_unexpected(text_at(reply, "error.message"), token)
          || text_at(reply, "error.message").indexOf("--name") >= 0,
        "cu_linux_gtk_entry_text_" + label + "_message:" + JSON.stringify(reply.error)
      );
    } else {
      ensure(
        command !== "usage" && honest_actuate_non_usage_code(code),
        "cu_linux_gtk_entry_text_" + label + "_honest:" + JSON.stringify(reply)
      );
      ensure(
        JSON.stringify(reply).indexOf("coordinate") < 0
          && JSON.stringify(reply).indexOf("XTest") < 0,
        "cu_linux_gtk_entry_text_" + label + "_degraded:" + JSON.stringify(reply)
      );
    }
    return false;
  }
  ensure(
    text_at(reply, "data.addressing") === "accessibility-tree"
      && (via === "" || text_at(reply, "data.via") === via),
    "cu_linux_gtk_entry_text_" + label + "_degraded:" + JSON.stringify(reply.data)
  );
  return true;
}

function assert_entry_text_usage_limit(run_directory, executable) {
  const send_missing_window = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--name", ENTRY_NAME, "--", "probe",
  ]);
  ensure(!output_success(send_missing_window),
    "cu_linux_gtk_entry_text_send_usage_ok:" + JSON.stringify(send_missing_window));
  ensure(
    text_at(send_missing_window, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_text_send_usage_code:" + JSON.stringify(send_missing_window.error)
  );
  ensure(
    text_at(send_missing_window, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_entry_text_send_usage_message:" + JSON.stringify(send_missing_window.error)
  );

  const send_role_without_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "1", "--role", "entry", "--", "probe",
  ]);
  ensure(!output_success(send_role_without_name),
    "cu_linux_gtk_entry_text_send_role_ok:" + JSON.stringify(send_role_without_name));
  ensure(
    text_at(send_role_without_name, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_text_send_role_code:" + JSON.stringify(send_role_without_name.error)
  );
  ensure(
    text_at(send_role_without_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_text_send_role_message:" + JSON.stringify(send_role_without_name.error)
  );

  const send_zero_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "0", "--name", ENTRY_NAME, "--", "probe",
  ]);
  ensure(!output_success(send_zero_handle),
    "cu_linux_gtk_entry_text_send_zero_handle_ok:" + JSON.stringify(send_zero_handle));
  ensure(
    text_at(send_zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_text_send_zero_handle_code:" + JSON.stringify(send_zero_handle.error)
  );
  ensure(
    text_at(send_zero_handle, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_entry_text_send_zero_handle_message:" + JSON.stringify(send_zero_handle.error)
  );

  const get_role_without_name = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--role", "entry",
  ]);
  ensure(!output_success(get_role_without_name),
    "cu_linux_gtk_entry_text_get_role_ok:" + JSON.stringify(get_role_without_name));
  ensure(
    text_at(get_role_without_name, "error.code") === "usage"
      || text_at(get_role_without_name, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_text_get_role_code:" + JSON.stringify(get_role_without_name.error)
  );
  ensure(
    text_at(get_role_without_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_text_get_role_message:" + JSON.stringify(get_role_without_name.error)
  );

  const focus_zero_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "0", "--name", ENTRY_NAME,
  ]);
  ensure(!output_success(focus_zero_handle),
    "cu_linux_gtk_entry_text_focus_zero_handle_ok:" + JSON.stringify(focus_zero_handle));
  ensure(
    text_at(focus_zero_handle, "error.code") === "usage"
      || text_at(focus_zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_text_focus_zero_handle_code:" + JSON.stringify(focus_zero_handle.error)
  );
  ensure(
    text_at(focus_zero_handle, "error.message").indexOf("--window") >= 0
      || text_at(focus_zero_handle, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_gtk_entry_text_focus_zero_handle_message:" + JSON.stringify(focus_zero_handle.error)
  );

  const focus_missing_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "1",
  ]);
  ensure(!output_success(focus_missing_name),
    "cu_linux_gtk_entry_text_focus_missing_name_ok:" + JSON.stringify(focus_missing_name));
  ensure(
    text_at(focus_missing_name, "error.code") === "usage"
      || text_at(focus_missing_name, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_text_focus_missing_name_code:" + JSON.stringify(focus_missing_name.error)
  );
  ensure(
    text_at(focus_missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_text_focus_missing_name_message:" + JSON.stringify(focus_missing_name.error)
  );

  const get_text_zero = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "0", "--name", ENTRY_NAME,
  ]);
  ensure(!output_success(get_text_zero),
    "cu_linux_gtk_entry_text_get_text_zero_ok:" + JSON.stringify(get_text_zero));
  ensure(
    text_at(get_text_zero, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_text_get_text_zero_code:" + JSON.stringify(get_text_zero.error)
  );
  ensure(
    text_at(get_text_zero, "error.message").indexOf("window") >= 0,
    "cu_linux_gtk_entry_text_get_text_zero_message:" + JSON.stringify(get_text_zero.error)
  );

  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "1", "--coords", "10,10",
  ]), "focus_coords", "--coords");

  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "1", "--bogus",
  ]), "focus_bogus", "--bogus");

  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "1", "--coords", "10,10", "--", "probe",
  ]), "send_coords", "--coords");

  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "1", "--bogus", "--", "probe",
  ]), "send_bogus", "--bogus");

  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--coords", "10,10",
  ]), "get_text_coords", "--coords");

  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--bogus",
  ]), "get_text_bogus", "--bogus");
}

function assert_get_text_reject_coords_or_stay_named(
  run_directory, executable, handle, fixture_title, expected_text, label
) {
  const get_text_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", ENTRY_NAME, "--coords", "10,10",
  ]);
  if (assert_named_stay_or_misuse(get_text_coords, "get_text_coords_" + label, "gettext", "--coords")) {
    ensure(
      text_at(get_text_coords, "data.text") === expected_text,
      "cu_linux_gtk_entry_text_get_text_coords_named_" + label + ":" + JSON.stringify(get_text_coords.data)
    );
  }

  const get_text_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", ENTRY_NAME, "--bogus",
  ]);
  if (assert_named_stay_or_misuse(get_text_bogus, "get_text_bogus_" + label, "gettext", "--bogus")) {
    ensure(
      text_at(get_text_bogus, "data.text") === expected_text,
      "cu_linux_gtk_entry_text_get_text_bogus_named_" + label + ":" + JSON.stringify(get_text_bogus.data)
    );
  }
}

function assert_send_text_reject_coords_or_stay_named(run_directory, executable, handle, label) {
  const send_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", handle, "--name", ENTRY_NAME, "--coords", "10,10", "--", "probe",
  ]);
  assert_named_stay_or_misuse(send_coords, "send_coords_" + label, "", "--coords");

  const send_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", handle, "--name", ENTRY_NAME, "--bogus", "--", "probe",
  ]);
  assert_named_stay_or_misuse(send_bogus, "send_bogus_" + label, "", "--bogus");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", ENTRY_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_gtk_entry_text_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_text_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_gtk_entry_text_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_gtk_entry_text_extents_missing_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_gtk_entry_text_extents_missing_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_gtk_entry_text_extents_missing_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_text_extents_missing_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_gtk_entry_text_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_gtk_entry_text_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_gtk_entry_text_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_text_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_gtk_entry_text_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_gtk_entry_text_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_gtk_entry_text_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_text_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", ENTRY_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_gtk_entry_text_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_gtk_entry_text_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_gtk_entry_text_extents_unavailable_code:" + code
  );
}

function assert_entry_text_host_limit_when_atspi_absent(run_directory, executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
  const send_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "1", "--name", ENTRY_NAME, "--", "probe",
  ], env);
  ensure(!output_success(send_reply),
    "cu_linux_gtk_entry_text_send_unavailable_ok:" + JSON.stringify(send_reply));
  ensure(
    text_at(send_reply, "command") !== "usage",
    "cu_linux_gtk_entry_text_send_unavailable_fake_usage:" + JSON.stringify(send_reply)
  );
  const send_code = text_at(send_reply, "error.code");
  ensure(
    send_code === "a11y_backend_failed" || send_code === "unsupported" || send_code === "bad_handle",
    "cu_linux_gtk_entry_text_send_unavailable_code:" + send_code
  );

  const get_reply = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--name", ENTRY_NAME,
  ], env);
  ensure(!output_success(get_reply),
    "cu_linux_gtk_entry_text_get_unavailable_ok:" + JSON.stringify(get_reply));
  ensure(
    text_at(get_reply, "command") !== "usage",
    "cu_linux_gtk_entry_text_get_unavailable_fake_usage:" + JSON.stringify(get_reply)
  );
  const get_code = text_at(get_reply, "error.code");
  ensure(
    get_code === "a11y_backend_failed" || get_code === "unsupported" || get_code === "bad_handle",
    "cu_linux_gtk_entry_text_get_unavailable_code:" + get_code
  );
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_gtk_entry_text_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_gtk_entry_text_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_gtk_entry_text_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_gtk_entry_text_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_gtk_entry_text_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function assert_send_text_missing_node(run_directory, executable, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", handle, "--name", MISSING_NODE, "--", "probe",
  ]);
  ensure(!output_success(reply), "cu_linux_gtk_entry_text_send_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_gtk_entry_text_send_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function assert_get_text_missing_node(run_directory, executable, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!output_success(reply), "cu_linux_gtk_entry_text_get_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_gtk_entry_text_get_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_gtk_entry_text_executable_missing");
const context = harness.new_context(repo, "cu-linux-gtk-entry");
const run_directory = rh.join(repo, "target/cu-linux-gtk-entry-text-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_gtk_entry_text_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP focus/send-text/get-text typed-fail usage for missing/zero --window, --role-without--name, and --coords/--bogus misuse (usage_rejects_unexpected + command=usage, or honest non-usage typed failure; never fake command=usage)");
  assert_entry_text_usage_limit(run_directory, executable);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (command=usage) before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP focus/send-text/get-text typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
  assert_entry_text_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held; gtk-entry read-back requires pyatspi");
    succeeded = 1;
  } else {
    print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_gtk_entry_text_window_wait");
    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_gtk_entry_text_window_identity");
    const handle = "" + at(row, "handle");

    print("STEP process-state binds the owned fixture pid before send-text/get-text actuate/read-back court");
    assert_fixture_process_state(run_directory, executable, fixture_pid);

    print("STEP desktop-state window row agrees with inventory before send-text/get-text actuate/read-back court");
    assert_fixture_desktop_state(
      run_directory, executable, fixture_pid, fixture_title, handle, row
    );

    print("STEP send-text/get-text typed-fail a11y_node_not_found when the named entry is missing");
    assert_send_text_missing_node(run_directory, executable, handle, "before_focus");
    assert_get_text_missing_node(run_directory, executable, handle, "before_focus");
    print("STEP independent get-text proves the entry stayed at the fixture seed after the miss");
    assert_entry_text(run_directory, executable, handle, fixture_title, FIXTURE_SEED, "after_missing");

    print("STEP focus moves AT-SPI focus to the named GTK entry");
    run_cu(run_directory, executable, "observe,actuate", [
      "focus", "--window", handle, "--name", ENTRY_NAME,
    ]);
    const focused = run_cu(run_directory, executable, "observe", [
      "focused", "--window", handle,
    ]);
    ensure(
      text_at(focused, "data.node.name") === ENTRY_NAME,
      "cu_linux_gtk_entry_text_focused:" + JSON.stringify(focused.data)
    );
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-focus");

    print("STEP get-extents --name locates the GTK entry before send-text actuate/read-back court");
    const entry_extents = run_cu(run_directory, executable, "observe", [
      "get-extents", "--window", handle, "--name", ENTRY_NAME,
    ]);
    ensure(
      text_at(entry_extents, "data.matched.name") === ENTRY_NAME
        && int_at(entry_extents, "data.extents.width") > 0
        && int_at(entry_extents, "data.extents.height") > 0,
      "cu_linux_gtk_entry_text_extents_before_actuate:" + JSON.stringify(entry_extents.data)
    );

    const round_seeds = [
      "ceo2-gtk-r1-" + context.run_id + " ≠ 你好",
      "ceo2-gtk-r2-" + context.run_id + " π≈3.14",
    ];
    ensure(round_seeds.length >= READBACK_COUNT, "cu_linux_gtk_entry_text_seed_count");

    for (let round = 1; round <= READBACK_COUNT; round += 1) {
      const seed = round_seeds[round - 1];
      print("STEP round " + round + "/" + READBACK_COUNT + ": send-text --name writes round SEED through AT-SPI EditableText/Text");
      const sent = run_cu(run_directory, executable, "observe,actuate", [
        "send-text", "--window", handle, "--name", ENTRY_NAME, "--", seed,
      ]);
      ensure(
        text_at(sent, "data.typed") === seed
          && text_at(sent, "data.addressing") === "accessibility-tree",
        "cu_linux_gtk_entry_text_send_r" + round + ":" + JSON.stringify(sent.data)
      );
      if (round === 1) {
        harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-send-text");
      }

      print("STEP round " + round + "/" + READBACK_COUNT + ": independent get-text --name reads round SEED back through pyatspi Text.GetText");
      assert_entry_text(run_directory, executable, handle, fixture_title, seed, "after_send_r" + round);
      print("STEP round " + round + "/" + READBACK_COUNT + ": get-text --name with --coords/--bogus rejects or stays gettext");
      assert_get_text_reject_coords_or_stay_named(
        run_directory, executable, handle, fixture_title, seed, "round_" + round
      );
      if (round === READBACK_COUNT) {
        harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-get-text");
        print("STEP send-text --name with --coords/--bogus rejects or stays accessibility-tree");
        assert_send_text_reject_coords_or_stay_named(run_directory, executable, handle, "final");
      }
    }

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_gtk_entry_text_failed");
if (atspi_available) {
  print("PASS: CEO#2 GTK entry focus → " + READBACK_COUNT + " send-text --name → get-text roundtrips with independent pyatspi Text.GetText read-back, typed focus/send-text/get-text --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), and process-state/desktop-state courts before actuate (AT-SPI --name, no --coords)");
} else {
  print("PASS: CEO#2 GTK entry focus/send-text/get-text typed-fails with typed get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
}
