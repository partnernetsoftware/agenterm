// CEO: close --snapshot --expect gone on a disposable GTK fixture window.
// Acceptance is smoke read-back only: independent windows inventory and
// pyatspi frame probes must no longer list the closed title after actuation.
// Typed close usage must reject AT-SPI --name and other unexpected arguments;
// typed get-extents --name usage/host-limit paths must hold before the
// window-close actuate/read-back court. Typed refusals when the destructive
// gate is incomplete; missing-window paths; AT-SPI host-limit when the
// snapshot bus is unavailable. AT-SPI/--name only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-close-expect-gone",
];

const AT_SPI_PROBE_NAME = "Window Close Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) { return text_of(at(value, dotted)); }
function int_at(value, dotted) { return rh.int_of(at(value, dotted)); }
function flag_at(value, dotted) { return at(value, dotted) === true; }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu(run_directory, executable, grant, arguments) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_window_close_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_close_empty");
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_linux_window_close_reply:" + JSON.stringify(document));
  return document;
}

function run_cu_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_close_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function invoke_close_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "actuate",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_close_actuate_cli:" + output.stderr);
  const reply = JSON.parse(trimmed);
  const command = text_at(reply, "command");
  ensure(
    command === "close" || command === "usage",
    "cu_linux_window_close_actuate_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_close_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function output_success(document) { return flag_at(document, "ok"); }

function close_refused(run_directory, executable, grant, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, grant, ["close"].concat(arguments));
  ensure(
    !flag_at(reply, "ok") && text_at(reply, "error.code") === code,
    "cu_linux_window_close_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function probe_atspi_available() {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(""),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_close_usage_limit(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "actuate", [
    "close", "--window", "0", "--snapshot", "--expect", "gone",
  ]);
  ensure(!output_success(reply), "cu_linux_window_close_usage_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_window_close_usage_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_window_close_usage_message:" + JSON.stringify(reply.error)
  );
}

function assert_close_atspi_name_usage_limit(run_directory, executable, env) {
  const with_name = invoke_close_reply(run_directory, executable, [
    "close",
    "--window", "1",
    "--name", AT_SPI_PROBE_NAME,
    "--snapshot", "--expect", "gone",
  ], env);
  ensure(!output_success(with_name), "cu_linux_window_close_usage_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_window_close_usage_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_window_close_usage_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    text_at(with_name, "error.message").indexOf("--name") >= 0
      || text_at(with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_window_close_usage_name_message:" + JSON.stringify(with_name.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_window_close_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_window_close_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_window_close_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_window_close_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_window_close_extents_unavailable_code:" + code
  );
}

function assert_close_missing_window(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "actuate", [
    "close", "--window", "99999999", "--snapshot", "--expect", "gone",
  ]);
  ensure(!output_success(reply), "cu_linux_window_close_missing_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "window_not_found",
    "cu_linux_window_close_missing_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed"
      && text_at(reply, "error.detail.reason") === "target_absent",
    "cu_linux_window_close_missing_detail:" + JSON.stringify(reply.error)
  );
}

function assert_close_host_limit_when_atspi_absent(
  run_directory, executable, handle_text, pid, title
) {
  const reply = run_cu_reply(run_directory, executable, "actuate", [
    "close",
    "--window", handle_text,
    "--pid", "" + pid,
    "--title", title,
    "--snapshot", "--expect", "gone",
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_window_close_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "a11y_backend_failed",
    "cu_linux_window_close_unavailable_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_window_close_unavailable_effect:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("address") >= 0
      || message.indexOf("accessibility") >= 0
      || message.indexOf("bus") >= 0,
    "cu_linux_window_close_unavailable_message:" + JSON.stringify(reply.error)
  );
}

function independent_atspi_frame_present(executable, title) {
  const script = [
    "import json, sys, pyatspi",
    "title = sys.argv[1]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "for index in range(desktop.childCount):",
    "    app = desktop.getChildAtIndex(index)",
    "    if app is None:",
    "        continue",
    "    for child_index in range(app.childCount):",
    "        frame = app.getChildAtIndex(child_index)",
    "        if frame is not None and (frame.name or '') == title:",
    "            print(json.dumps({'present': True}))",
    "            raise SystemExit(0)",
    "print(json.dumps({'present': False}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title], {
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(
    output.success === true,
    "cu_linux_window_close_atspi_probe:" + output.stderr + output.stdout
  );
  return flag_at(JSON.parse(output.stdout.trim()), "present");
}

function window_rows(reply) {
  const data = reply.data;
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function fixture_inventory(run_directory, executable, pid) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  return window_rows(reply);
}

function window_row(run_directory, executable, pid, title) {
  for (const row of fixture_inventory(run_directory, executable, pid)) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function inventory_has_handle(rows, handle) {
  for (const row of rows) {
    if (int_at(row, "handle") === handle) { return true; }
  }
  return false;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-window-close-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);

print("STEP close typed-fails usage when --window handle is zero");
assert_close_usage_limit(run_directory, executable);
print("STEP close typed-fails usage when AT-SPI --name is present");
assert_close_atspi_name_usage_limit(run_directory, executable, env);

const atspi_available = probe_atspi_available();
let atspi_full = atspi_available;

if (atspi_available) {
  print("STEP get-extents typed-fail invalid_input when --window is zero before window-close actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);
} else {
  print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
}

print("STEP close typed-fails window_not_found when handle is absent from inventory");
assert_close_missing_window(run_directory, executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_window_close_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
  const second_title = "agenterm-linux-second-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_window_close_window_wait");

  const main_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(main_row !== null, "cu_linux_window_close_main_missing");
  const main_handle = int_at(main_row, "handle");
  ensure(main_handle > 0, "cu_linux_window_close_main_handle:" + JSON.stringify(main_row));

  const second_row = window_row(run_directory, executable, fixture_pid, second_title);
  ensure(second_row !== null, "cu_linux_window_close_second_missing");
  const second_handle = int_at(second_row, "handle");
  const second_text = "" + second_handle;
  ensure(
    second_handle > 0 && second_handle !== main_handle,
    "cu_linux_window_close_second_handle:" + JSON.stringify(second_row)
  );

  if (atspi_full) {
    print("STEP independent pyatspi baseline: both fixture frames must be present");
    ensure(
      independent_atspi_frame_present(executable, fixture_title),
      "cu_linux_window_close_atspi_main_missing:" + fixture_title
    );
    ensure(
      independent_atspi_frame_present(executable, second_title),
      "cu_linux_window_close_atspi_second_missing:" + second_title
    );
  }

  print("STEP close without snapshot, postcondition or target is refused typed; wrong pid/title too");
  const no_snapshot = close_refused(
    run_directory, executable, "actuate", ["--window", second_text, "--expect", "gone"], "refused"
  );
  ensure(
    text_at(no_snapshot, "error.detail.reason") === "destructive_gate"
      && no_snapshot.error.detail.missing.length === 1
      && text_of(no_snapshot.error.detail.missing[0]) === "snapshot"
      && text_at(no_snapshot, "error.detail.effect") === "not_performed",
    "cu_linux_window_close_no_snapshot:" + JSON.stringify(no_snapshot)
  );
  const no_postcondition = close_refused(
    run_directory, executable, "actuate", ["--window", second_text, "--snapshot"], "refused"
  );
  ensure(
    text_at(no_postcondition, "error.detail.reason") === "destructive_gate"
      && no_postcondition.error.detail.missing.length === 1
      && text_of(no_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_window_close_no_postcondition:" + JSON.stringify(no_postcondition)
  );
  const bare = close_refused(
    run_directory, executable, "actuate", ["--window", second_text], "refused"
  );
  ensure(
    text_at(bare, "error.detail.reason") === "destructive_gate"
      && bare.error.detail.missing.length === 2,
    "cu_linux_window_close_bare:" + JSON.stringify(bare)
  );
  close_refused(
    run_directory, executable, "actuate",
    ["--window", second_text, "--snapshot", "--expect", "vanish"], "invalid_input"
  );
  close_refused(
    run_directory, executable, "actuate",
    ["--window", second_text, "--pid", "1", "--snapshot", "--expect", "gone"], "window_identity_mismatch"
  );
  close_refused(
    run_directory, executable, "actuate",
    ["--window", second_text, "--title", fixture_title, "--snapshot", "--expect", "gone"], "window_identity_mismatch"
  );
  close_refused(
    run_directory, executable, "observe",
    ["--window", second_text, "--snapshot", "--expect", "gone"], "refused"
  );
  ensure(
    window_row(run_directory, executable, fixture_pid, second_title) !== null,
    "cu_linux_window_close_refusal_closed_it"
  );

  print("STEP close typed-fails a11y_backend_failed when AT-SPI bus is unavailable for snapshot");
  assert_close_host_limit_when_atspi_absent(
    run_directory, executable, second_text, fixture_pid, second_title
  );
  ensure(
    window_row(run_directory, executable, fixture_pid, second_title) !== null,
    "cu_linux_window_close_host_limit_closed_it"
  );
  if (atspi_full) {
    ensure(
      independent_atspi_frame_present(executable, second_title),
      "cu_linux_window_close_host_limit_atspi_gone:" + second_title
    );
  }

  if (!atspi_full) {
    print("STEP host-limit only: independent pyatspi desktop probe unavailable for close read-back");
  } else {
    print("STEP close --pid --title --snapshot --expect gone closes the second window; inventory reads it gone");
    const closed = run_cu(run_directory, executable, "actuate", [
      "close",
      "--window", second_text,
      "--pid", "" + fixture_pid,
      "--title", second_title,
      "--snapshot", "--expect", "gone",
    ]);
    ensure(
      flag_at(closed, "data.performed")
        && flag_at(closed, "data.verified")
        && text_at(closed, "data.addressing") === "window-handle"
        && text_at(closed, "data.action") === "close"
        && text_at(closed, "data.postcondition") === "gone"
        && text_at(closed, "data.verification.method") === "window-inventory"
        && int_at(closed, "data.verification.polls") >= 1
        && text_at(closed, "data.target.title") === second_title
        && int_at(closed, "data.target.pid") === fixture_pid
        && at(closed, "data.after.present") === false
        && flag_at(closed, "data.snapshot.in_receipt"),
      "cu_linux_window_close_reply:" + JSON.stringify(closed.data)
    );

    print("STEP independent windows inventory read-back: title and handle must be absent");
    let closed_gone = 0;
    for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
      const rows = fixture_inventory(run_directory, executable, fixture_pid);
      let title_present = false;
      for (const row of rows) {
        if (text_at(row, "title") === second_title) { title_present = true; break; }
      }
      const handle_present = inventory_has_handle(rows, second_handle);
      if (!title_present && !handle_present) {
        closed_gone = 1;
        break;
      }
      harness.sleep_ms(50);
    }
    ensure(closed_gone === 1, "cu_linux_window_close_window_lingers");

    print("STEP independent pyatspi read-back: closed frame must be absent, main frame must remain");
    ensure(
      !independent_atspi_frame_present(executable, second_title),
      "cu_linux_window_close_atspi_second_lingers:" + second_title
    );
    ensure(
      independent_atspi_frame_present(executable, fixture_title),
      "cu_linux_window_close_atspi_main_gone:" + fixture_title
    );

    print("STEP closing one window must not kill the process or remove the main window");
    ensure(harness.process_present(fixture_pid) !== 0, "cu_linux_window_close_killed_process");
    ensure(
      window_row(run_directory, executable, fixture_pid, fixture_title) !== null,
      "cu_linux_window_close_main_gone"
    );

    print("STEP closing the same handle again is window_not_found with nothing performed");
    const closed_again = close_refused(
      run_directory, executable, "actuate",
      ["--window", second_text, "--snapshot", "--expect", "gone"], "window_not_found"
    );
    ensure(
      text_at(closed_again, "error.detail.effect") === "not_performed"
        && text_at(closed_again, "error.detail.reason") === "target_absent",
      "cu_linux_window_close_again:" + JSON.stringify(closed_again)
    );
  }
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-window-close");
harness.emit_evidence(context, declared_evidence, "cu.linux-close-expect-gone");
harness.remove_run(context);
if (atspi_full) {
  print("PASS: CEO Linux close --snapshot --expect gone with independent pyatspi and windows inventory read-back and typed close/get-extents usage honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: CEO Linux close typed-fails usage, missing-window, close/get-extents host-limit, and AT-SPI snapshot host-limit when desktop probe is unavailable (AT-SPI --name, no --coords)");
}
return;
