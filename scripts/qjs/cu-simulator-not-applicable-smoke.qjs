// Public non-macOS court for the CoreSimulator device inventory, device
// lifecycle, app inventory and app lifecycle spellings. Every call must reach
// the typed platform result before any provider effect. macOS owns the native
// courts for these capabilities.
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.simulator-inventory-not-applicable",
  "cu.simulator-lifecycle-not-applicable",
  "cu.simulator-app-lifecycle-not-applicable"
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function host_platform() {
  if (harness.host_is_windows()) { return "windows"; }
  const uname = rh.command("uname", ["-s"], { timeout_ms: 10000 });
  ensure(uname.success === true, "cu_simulator_not_applicable_uname_failed");
  if (uname.stdout.trim() === "Darwin") { return "macos"; }
  ensure(uname.stdout.trim() === "Linux",
         "cu_simulator_not_applicable_host_unsupported");
  return "linux";
}

function isolated_env(run_directory) {
  return {
    HOME: run_directory,
    USERPROFILE: run_directory,
    APPDATA: rh.join(run_directory, "config"),
    LOCALAPPDATA: rh.join(run_directory, "data"),
    XDG_CONFIG_HOME: rh.join(run_directory, "config"),
    XDG_DATA_HOME: rh.join(run_directory, "data"),
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
    AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
    AGENTERM_CU_MANAGED_JOB_PATH: rh.join(run_directory, "cu-managed-jobs.json")
  };
}

function refusal(run_directory, executable, verb_arguments, expected_command) {
  const receipt_directory = rh.join(run_directory, "cu-receipts");
  const receipt_file = rh.join(receipt_directory, "current.jsonl");
  const receipt_directory_existed = rh.exists(receipt_directory);
  const output = rh.command(executable, verb_arguments, {
    cwd: run_directory,
    env: isolated_env(run_directory),
    timeout_ms: 30000
  });
  const stdout = output.stdout.trim();
  ensure(stdout !== "", "cu_simulator_not_applicable_empty:" + output.stderr);
  const reply = JSON.parse(stdout);
  ensure(reply.command === expected_command && reply.target === "current",
         "cu_simulator_not_applicable_identity:" + stdout);
  ensure(output.success !== true && reply.ok !== true,
         "cu_simulator_not_applicable_false_success:" + stdout);
  ensure(reply.data === undefined,
         "cu_simulator_not_applicable_data:" + stdout);
  ensure(reply.error !== undefined && reply.error.code === "simulator_unsupported",
         "cu_simulator_not_applicable_code:" + stdout);
  ensure(rh.exists(receipt_directory) === receipt_directory_existed
         && !rh.exists(receipt_file),
         "cu_simulator_not_applicable_effect_receipt_created");
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
harness.require(host_platform() !== "macos",
                "simulator not-applicable court is registered only for Linux and Windows");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.is_direct_file(executable) && harness.host_is_windows()) {
  executable = executable + ".exe";
}
ensure(rh.is_direct_file(executable),
       "cu_simulator_not_applicable_executable_missing:" + executable);

const udid = "11111111-1111-1111-1111-111111111111";
const bundle_id = "com.partnernetsoftware.agenterm.fixture";
const context = harness.new_context(repo, "cu-simulator-not-applicable");
let succeeded = 0;
let failure = "";
try {
  ensure(!rh.exists(rh.join(context.run_directory, "cu-receipts")),
         "cu_simulator_not_applicable_receipt_dir_preexists");
  print("STEP inventory spelling returns the typed non-macOS result");
  for (let attempt = 0; attempt < 2; attempt = attempt + 1) {
    refusal(context.run_directory, executable, [
      "--target", "current", "--grant", "observe",
      "simulator-devices", "--max", "1"
    ], "simulator-devices");
  }
  print("STEP lifecycle spelling returns the same typed non-macOS result");
  for (let attempt = 0; attempt < 2; attempt = attempt + 1) {
    refusal(context.run_directory, executable, [
      "--target", "current", "--grant", "actuate",
      "simulator-boot", udid, "--expect", "booted", "--timeout-ms", "1"
    ], "simulator-boot");
  }
  print("STEP app inventory spelling returns the typed non-macOS result");
  for (let attempt = 0; attempt < 2; attempt = attempt + 1) {
    refusal(context.run_directory, executable, [
      "--target", "current", "--grant", "observe",
      "simulator-apps", udid, "--max", "1"
    ], "simulator-apps");
  }
  print("STEP app launch and terminate spellings return the typed non-macOS result");
  for (let attempt = 0; attempt < 2; attempt = attempt + 1) {
    refusal(context.run_directory, executable, [
      "--target", "current", "--grant", "actuate",
      "simulator-launch", udid, bundle_id, "--expect", "accepted",
      "--timeout-ms", "1"
    ], "simulator-launch");
    refusal(context.run_directory, executable, [
      "--target", "current", "--grant", "actuate",
      "simulator-terminate", udid, bundle_id, "--expect", "accepted",
      "--timeout-ms", "1"
    ], "simulator-terminate");
  }
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence,
                        "cu.simulator-inventory-not-applicable");
  harness.emit_evidence(context, declared_evidence,
                        "cu.simulator-lifecycle-not-applicable");
  harness.emit_evidence(context, declared_evidence,
                        "cu.simulator-app-lifecycle-not-applicable");
  harness.remove_run(context);
  print("PASS: CoreSimulator spellings return typed non-macOS results without provider effect");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
