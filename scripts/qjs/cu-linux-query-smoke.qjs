// CEO: Linux query honesty with independent pyatspi filtered dump read-back.
// Acceptance is smoke read-back only: CU query filtered flat nodes by --role and
// --text/--text-exact must agree with a separate AT-SPI walk rooted at the same
// application scope on the owned GTK fixture window. Typed query usage must reject
// AT-SPI --name, --coords, --bogus, and other unexpected arguments; typed get-extents
// --name usage AND host-limit paths must both hold before the query read-back court.
// Prefer host-limit clarity over fake success. AT-SPI/--name semantics only;
// no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-query-readback",
];

const AT_SPI_PROBE_NAME = "Query Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }


function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_query_empty:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, cu_args, env) {
  const document = run_cu_reply(run_directory, executable, grant, cu_args, env);
  ensure(rh.output_success(document), "cu_linux_query_reply:" + JSON.stringify(document));
  return document;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_query_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "query" || text_at(reply, "command") === "usage",
    "cu_linux_query_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_query_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_query_usage_limit(run_directory, executable, env) {
  const flat_with_name = invoke_observe_reply(run_directory, executable, [
    "query", "--window", "1", "--role", "button", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(flat_with_name),
    "cu_linux_query_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_query_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_query_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_name, "error.message"), "--name"),
    "cu_linux_query_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_observe_reply(run_directory, executable, [
    "inspect", "--window", "1", "--role", "button", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(grouped_with_name),
    "cu_linux_query_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_query_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_name, "error.message"), "--name"),
    "cu_linux_query_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const flat_with_bogus = invoke_observe_reply(run_directory, executable, [
    "query", "--window", "1", "--role", "button", "--bogus",
  ], env);
  ensure(!rh.output_success(flat_with_bogus),
    "cu_linux_query_usage_flat_bogus_ok:" + JSON.stringify(flat_with_bogus));
  ensure(
    text_at(flat_with_bogus, "error.code") === "usage",
    "cu_linux_query_usage_flat_bogus_code:" + JSON.stringify(flat_with_bogus.error)
  );
  ensure(
    text_at(flat_with_bogus, "command") === "usage",
    "cu_linux_query_usage_flat_bogus_command:" + JSON.stringify(flat_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_bogus, "error.message"), "--bogus"),
    "cu_linux_query_usage_flat_bogus_message:" + JSON.stringify(flat_with_bogus.error)
  );

  const grouped_with_bogus = invoke_observe_reply(run_directory, executable, [
    "inspect", "--window", "1", "--role", "button", "--bogus",
  ], env);
  ensure(!rh.output_success(grouped_with_bogus),
    "cu_linux_query_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_query_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    text_at(grouped_with_bogus, "command") === "usage",
    "cu_linux_query_usage_grouped_bogus_command:" + JSON.stringify(grouped_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_bogus, "error.message"), "--bogus"),
    "cu_linux_query_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const flat_with_coords = invoke_observe_reply(run_directory, executable, [
    "query", "--window", "1", "--role", "button", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(flat_with_coords),
    "cu_linux_query_usage_flat_coords_ok:" + JSON.stringify(flat_with_coords));
  ensure(
    text_at(flat_with_coords, "error.code") === "usage",
    "cu_linux_query_usage_flat_coords_code:" + JSON.stringify(flat_with_coords.error)
  );
  ensure(
    text_at(flat_with_coords, "command") === "usage",
    "cu_linux_query_usage_flat_coords_command:" + JSON.stringify(flat_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_coords, "error.message"), "--coords"),
    "cu_linux_query_usage_flat_coords_message:" + JSON.stringify(flat_with_coords.error)
  );

  const grouped_with_coords = invoke_observe_reply(run_directory, executable, [
    "inspect", "--window", "1", "--role", "button", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(grouped_with_coords),
    "cu_linux_query_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_query_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    text_at(grouped_with_coords, "command") === "usage",
    "cu_linux_query_usage_grouped_coords_command:" + JSON.stringify(grouped_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_coords, "error.message"), "--coords"),
    "cu_linux_query_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_query_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_query_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_query_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_query_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_query_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_query_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_query_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_query_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_query_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_query_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_query_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_query_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_query_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_query_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_query_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_query_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_query_extents_unavailable_code:" + code
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function node_pairs(nodes) {
  const pairs = [];
  for (const node of nodes) {
    pairs.push(text_at(node, "role").toLowerCase() + "\t" + text_at(node, "name"));
  }
  pairs.sort();
  return pairs;
}

function independent_probe_script() {
  return [
    "import json, sys",
    "import pyatspi",
    "",
    "config = json.loads(sys.argv[1])",
    "title = config['title']",
    "roles = [role.lower() for role in config.get('roles', [])]",
    "text_sub = config.get('text')",
    "text_exact = config.get('text_exact')",
    "",
    "def role_name(obj):",
    "    try:",
    "        return obj.getRoleName().lower()",
    "    except Exception:",
    "        return ''",
    "",
    "def node_name(obj):",
    "    try:",
    "        return obj.name or ''",
    "    except Exception:",
    "        return ''",
    "",
    "def node_text(obj):",
    "    try:",
    "        text_iface = obj.queryText()",
    "        return text_iface.getText(0, text_iface.characterCount)",
    "    except Exception:",
    "        return ''",
    "",
    "def matches(obj):",
    "    if roles and role_name(obj) not in roles:",
    "        return False",
    "    if text_exact is not None:",
    "        if node_name(obj) != text_exact and node_text(obj) != text_exact:",
    "            return False",
    "    if text_sub is not None:",
    "        needle = text_sub.lower()",
    "        if needle not in node_name(obj).lower() and needle not in node_text(obj).lower():",
    "            return False",
    "    if not roles and text_exact is None and text_sub is None:",
    "        return False",
    "    return True",
    "",
    "def walk(obj, out=None):",
    "    if out is None:",
    "        out = []",
    "    if matches(obj):",
    "        out.append({'role': role_name(obj), 'name': node_name(obj)})",
    "    try:",
    "        child_count = obj.childCount",
    "    except Exception:",
    "        child_count = 0",
    "    for index in range(child_count):",
    "        try:",
    "            child = obj.getChildAtIndex(index)",
    "        except Exception:",
    "            continue",
    "        if child is not None:",
    "            walk(child, out)",
    "    return out",
    "",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "application = None",
    "for candidate in desktop:",
    "    try:",
    "        for index in range(candidate.childCount):",
    "            window = candidate.getChildAtIndex(index)",
    "            if window is not None and node_name(window) == title:",
    "                application = candidate",
    "                break",
    "        if application is not None:",
    "            break",
    "    except Exception:",
    "        continue",
    "if application is None:",
    "    raise SystemExit('cu_linux_query_probe_window_missing')",
    "",
    "nodes = walk(application)",
    "print(json.dumps({'matched': len(nodes), 'nodes': nodes}))",
  ].join("\n");
}

function invoke_query(run_directory, executable, handle, query_args) {
  const argv = ["query", "--window", "" + handle];
  for (let index = 0; index < query_args.length; index = index + 1) {
    argv.push("" + query_args[index]);
  }
  const reply = run_cu(run_directory, executable, "observe", argv);
  ensure(text_at(reply, "data.addressing") === "accessibility-tree", "cu_linux_query_addressing");
  ensure(text_at(reply, "data.backend") === "at-spi2", "cu_linux_query_backend");
  ensure(flag_at(reply, "data.degraded") === false, "cu_linux_query_degraded");
  return reply.data;
}

function independent_probe(run_directory, title, probe_config_json) {
  const output = rh.command("python3", ["-c", independent_probe_script(), probe_config_json], {
    cwd: run_directory,
    env: cu_env(""),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_query_probe:" + output.stderr + output.stdout);
  const document = JSON.parse(output.stdout.trim());
  ensure(Array.isArray(document.nodes), "cu_linux_query_probe_nodes");
  return document;
}

function assert_query_agreement(run_directory, executable, handle, title, query_args, probe_config_json, label) {
  const cu = invoke_query(run_directory, executable, handle, query_args);
  const probe = independent_probe(run_directory, title, probe_config_json);
  ensure(
    int_at(cu, "matched") === probe.matched,
    "cu_linux_query_matched_" + label + ":" + JSON.stringify({ cu: cu.matched, probe: probe.matched })
  );
  const cu_pairs = node_pairs(cu.nodes);
  const probe_pairs = node_pairs(probe.nodes);
  ensure(
    cu_pairs.length === probe_pairs.length,
    "cu_linux_query_count_" + label + ":" + cu_pairs.length + ":" + probe_pairs.length
  );
  for (let index = 0; index < cu_pairs.length; index = index + 1) {
    ensure(
      cu_pairs[index] === probe_pairs[index],
      "cu_linux_query_pair_" + label + ":" + cu_pairs[index] + ":" + probe_pairs[index]
    );
  }
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-query");
const run_directory = rh.join(repo, "target/cu-linux-query-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_query_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";

try {
  print("STEP query typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_query_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before query read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before query read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; query read-back court skipped");
    harness.emit_evidence(context, declared_evidence, "cu.linux-query-readback");
    succeeded = 1;
  } else {
  print("STEP start owned GTK fixture and resolve window by pid and exact title");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_query_window_wait");

  const inventory_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(inventory_row !== null, "cu_linux_query_window_identity");
  const handle = int_at(inventory_row, "handle");
  ensure(handle > 0, "cu_linux_query_handle:" + JSON.stringify(inventory_row));

  print("STEP query --role button agrees with independent AT-SPI filtered dump");
  assert_query_agreement(
    run_directory, executable, handle, fixture_title,
    ["--role", "button"],
    JSON.stringify({ title: fixture_title, roles: ["button"] }),
    "role_button"
  );

  print("STEP query --text-exact Fixture Entry agrees with independent AT-SPI filtered dump");
  assert_query_agreement(
    run_directory, executable, handle, fixture_title,
    ["--text-exact", "Fixture Entry"],
    JSON.stringify({ title: fixture_title, text_exact: "Fixture Entry" }),
    "text_exact_entry"
  );

  print("STEP query --role text --text Entry agrees with independent AT-SPI filtered dump");
  assert_query_agreement(
    run_directory, executable, handle, fixture_title,
    ["--role", "text", "--text", "Entry"],
    JSON.stringify({ title: fixture_title, roles: ["text"], text: "Entry" }),
    "role_text_entry"
  );

  print("STEP query --text Fixture agrees with independent AT-SPI application-scoped dump");
  assert_query_agreement(
    run_directory, executable, handle, fixture_title,
    ["--text", "Fixture"],
    JSON.stringify({ title: fixture_title, text: "Fixture" }),
    "text_fixture"
  );

  succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  if (atspi_available) {
    harness.emit_evidence(context, declared_evidence, "cu.linux-query-readback");
  }
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux query filtered nodes match independent AT-SPI dump read-back with typed query --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux query typed-fails with typed query --name/--coords/--bogus usage and get-extents --name host-limit honesty when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
