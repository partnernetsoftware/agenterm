// CEO#9: GTK entry set-caret / get-caret roundtrip by --name.
// Plant SEED with send-text, set-caret to a known offset, independent
// get-caret/get-text must return that offset/text and agree with separate
// pyatspi Text.CaretOffset probes. Typed get-caret/set-caret usage must
// reject missing/zero --window, --role-without--name, and --coords/--bogus
// misuse (usage_rejects_unexpected + command=usage) or stay on
// accessibility-tree --name; host-limit paths must hold when --window/--name
// are missing, the named entry is missing, the target has no Text caret
// interface, or the AT-SPI bus is unavailable; typed get-extents --name
// usage AND host-limit courts must both hold before the native
// actuate/read-back court (no if/else gating those courts on
// atspi_available); miss paths must not mutate the entry (independent
// get-text read-back). AT-SPI --name only; no --coords or screenshot
// degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-gtk-entry-set-caret",
  "cu.linux-gtk-entry-get-caret",
  "cu.linux-gtk-entry-set-caret-end",
  "cu.linux-gtk-entry-get-caret-end",
];

const ENTRY_NAME = "Fixture Entry";
const UNAVAILABLE_NODE = "Fixture Check";
const MISSING_NODE = "No Such Entry";
const FIXTURE_SEED = "seed";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function output_success(document) { return flag_at(document, "ok"); }

function assert_entry_text(run_directory, executable, handle, expected, label) {
  const got = run_cu(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", ENTRY_NAME,
  ]);
  const readback = text_at(got, "data.text");
  ensure(
    readback === expected && text_at(got, "data.via") === "gettext",
    "cu_linux_gtk_entry_caret_get_text_" + label + ":" + JSON.stringify({
      expected: expected,
      readback: readback,
    })
  );
  return got;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_entry_caret_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_gtk_entry_caret_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_entry_caret_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function independent_probe_script() {
  return [
    "import json, sys",
    "import pyatspi",
    "",
    "config = json.loads(sys.argv[1])",
    "title = config['title']",
    "mode = config['mode']",
    "name_pattern = config.get('name_pattern', '')",
    "",
    "def caret_of_node(obj):",
    "    try:",
    "        text_iface = obj.queryText()",
    "        return int(text_iface.caretOffset)",
    "    except Exception:",
    "        return None",
    "",
    "def find_frame():",
    "    desktop = pyatspi.Registry.getDesktop(0)",
    "    for index in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(index)",
    "        if app is None:",
    "            continue",
    "        for child_index in range(app.childCount):",
    "            window = app.getChildAtIndex(child_index)",
    "            if window is not None and (window.name or '') == title:",
    "                return window",
    "    return None",
    "",
    "def named_caret(root, pattern):",
    "    hits = []",
    "    def walk(obj):",
    "        name = obj.name or ''",
    "        if pattern in name:",
    "            caret = caret_of_node(obj)",
    "            if caret is not None:",
    "                hits.append(caret)",
    "        for index in range(obj.childCount):",
    "            child = obj.getChildAtIndex(index)",
    "            if child is not None:",
    "                walk(child)",
    "    walk(root)",
    "    if len(hits) != 1:",
    "        raise SystemExit('cu_linux_gtk_entry_caret_probe_named_count:' + str(len(hits)))",
    "    return hits[0]",
    "",
    "def named_caret_unavailable(root, pattern):",
    "    hits = []",
    "    def walk(obj):",
    "        name = obj.name or ''",
    "        if pattern in name:",
    "            try:",
    "                obj.queryText()",
    "                hits.append('has_text')",
    "            except Exception:",
    "                hits.append('no_text')",
    "        for index in range(obj.childCount):",
    "            child = obj.getChildAtIndex(index)",
    "            if child is not None:",
    "                walk(child)",
    "    walk(root)",
    "    if len(hits) != 1:",
    "        raise SystemExit('cu_linux_gtk_entry_caret_probe_unavailable_count:' + str(len(hits)))",
    "    if hits[0] != 'no_text':",
    "        raise SystemExit('cu_linux_gtk_entry_caret_probe_unavailable_should_refuse')",
    "    return False",
    "",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_gtk_entry_caret_probe_window_missing')",
    "",
    "if mode == 'named':",
    "    offset = named_caret(frame, name_pattern)",
    "elif mode == 'unavailable':",
    "    named_caret_unavailable(frame, name_pattern)",
    "    print(json.dumps({'mode': mode, 'available': False}))",
    "    raise SystemExit(0)",
    "else:",
    "    raise SystemExit('cu_linux_gtk_entry_caret_probe_mode:' + mode)",
    "",
    "print(json.dumps({'mode': mode, 'offset': offset}))",
  ].join("\n");
}

function independent_caret_probe(run_directory, executable, probe_config_json) {
  const output = rh.command("python3", ["-c", independent_probe_script(), probe_config_json], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_gtk_entry_caret_probe:" + output.stderr + output.stdout);
  const document = JSON.parse(output.stdout.trim());
  if (document.available === false) {
    return document;
  }
  ensure(typeof document.offset === "number", "cu_linux_gtk_entry_caret_probe_offset");
  return document;
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", ENTRY_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_gtk_entry_caret_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_caret_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_gtk_entry_caret_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_gtk_entry_caret_extents_missing_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_gtk_entry_caret_extents_missing_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_gtk_entry_caret_extents_missing_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_caret_extents_missing_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_gtk_entry_caret_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_gtk_entry_caret_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_gtk_entry_caret_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_caret_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_gtk_entry_caret_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_gtk_entry_caret_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_gtk_entry_caret_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_caret_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", ENTRY_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_gtk_entry_caret_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_gtk_entry_caret_extents_unavailable_code:" + code
  );
}

function assert_caret_agreement(run_directory, executable, handle, fixture_title, target_offset, label) {
  const caret = run_cu(run_directory, executable, "observe", [
    "get-caret", "--window", handle, "--name", ENTRY_NAME,
  ]);
  ensure(
    text_at(caret, "data.via") === "get-caret-offset"
      && int_at(caret, "data.offset") === target_offset,
    "cu_linux_gtk_entry_caret_readback_" + label + ":" + JSON.stringify({
      target: target_offset,
      caret: caret.data,
    })
  );
  const probe = independent_caret_probe(
    run_directory, executable,
    JSON.stringify({ title: fixture_title, mode: "named", name_pattern: ENTRY_NAME })
  );
  ensure(
    probe.offset === target_offset,
    "cu_linux_gtk_entry_caret_probe_mismatch_" + label + ":" + JSON.stringify({
      target: target_offset,
      cu: int_at(caret, "data.offset"),
      probe: probe.offset,
    })
  );
  return caret;
}

function assert_named_stay_or_misuse(reply, label, via, token, require_addressing) {
  if (!output_success(reply)) {
    ensure(
      text_at(reply, "error.code") === "usage",
      "cu_linux_gtk_entry_caret_" + label + "_code:" + JSON.stringify(reply.error)
    );
    ensure(
      text_at(reply, "command") === "usage",
      "cu_linux_gtk_entry_caret_" + label + "_command:" + JSON.stringify(reply)
    );
    ensure(
      usage_rejects_unexpected(text_at(reply, "error.message"), token)
        || text_at(reply, "error.message").indexOf("--name") >= 0,
      "cu_linux_gtk_entry_caret_" + label + "_message:" + JSON.stringify(reply.error)
    );
    return false;
  }
  if (require_addressing) {
    ensure(
      text_at(reply, "data.addressing") === "accessibility-tree"
        && text_at(reply, "data.via") === via,
      "cu_linux_gtk_entry_caret_" + label + "_degraded:" + JSON.stringify(reply.data)
    );
  } else {
    ensure(
      text_at(reply, "data.via") === via,
      "cu_linux_gtk_entry_caret_" + label + "_degraded:" + JSON.stringify(reply.data)
    );
  }
  return true;
}

function assert_get_caret_reject_coords_or_stay_named(
  run_directory, executable, handle, expected_offset, label
) {
  const get_caret_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-caret", "--window", handle, "--name", ENTRY_NAME, "--coords", "10,10",
  ]);
  if (assert_named_stay_or_misuse(get_caret_coords, "get_coords_" + label, "get-caret-offset", "--coords", false)) {
    ensure(
      int_at(get_caret_coords, "data.offset") === expected_offset,
      "cu_linux_gtk_entry_caret_get_coords_named_" + label + ":" + JSON.stringify(get_caret_coords.data)
    );
  }

  const get_caret_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-caret", "--window", handle, "--name", ENTRY_NAME, "--bogus",
  ]);
  if (assert_named_stay_or_misuse(get_caret_bogus, "get_bogus_" + label, "get-caret-offset", "--bogus", false)) {
    ensure(
      int_at(get_caret_bogus, "data.offset") === expected_offset,
      "cu_linux_gtk_entry_caret_get_bogus_named_" + label + ":" + JSON.stringify(get_caret_bogus.data)
    );
  }
}

function assert_set_caret_reject_coords_or_stay_named(
  run_directory, executable, handle, offset, label
) {
  const set_caret_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "set-caret", "--window", handle, "--name", ENTRY_NAME,
    "--coords", "10,10", "--offset", "" + offset,
  ]);
  if (assert_named_stay_or_misuse(set_caret_coords, "set_coords_" + label, "set-caret-offset", "--coords", true)) {
    ensure(
      int_at(set_caret_coords, "data.offset") === offset,
      "cu_linux_gtk_entry_caret_set_coords_named_" + label + ":" + JSON.stringify(set_caret_coords.data)
    );
  }

  const set_caret_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "set-caret", "--window", handle, "--name", ENTRY_NAME,
    "--bogus", "--offset", "" + offset,
  ]);
  if (assert_named_stay_or_misuse(set_caret_bogus, "set_bogus_" + label, "set-caret-offset", "--bogus", true)) {
    ensure(
      int_at(set_caret_bogus, "data.offset") === offset,
      "cu_linux_gtk_entry_caret_set_bogus_named_" + label + ":" + JSON.stringify(set_caret_bogus.data)
    );
  }
}

function assert_caret_usage_limit(run_directory, executable) {
  const missing_name = run_cu_reply(run_directory, executable, "observe", [
    "get-caret", "--window", "1",
  ]);
  ensure(!output_success(missing_name), "cu_linux_gtk_entry_caret_usage_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_gtk_entry_caret_usage_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_caret_usage_message:" + JSON.stringify(missing_name.error)
  );

  const get_role = run_cu_reply(run_directory, executable, "observe", [
    "get-caret", "--window", "1", "--role", "entry",
  ]);
  ensure(!output_success(get_role), "cu_linux_gtk_entry_caret_get_role_ok:" + JSON.stringify(get_role));
  ensure(
    text_at(get_role, "error.code") === "usage"
      || text_at(get_role, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_caret_get_role_code:" + JSON.stringify(get_role.error)
  );
  ensure(
    text_at(get_role, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_caret_get_role_message:" + JSON.stringify(get_role.error)
  );

  const zero_handle = run_cu_reply(run_directory, executable, "observe", [
    "get-caret", "--window", "0", "--name", ENTRY_NAME,
  ]);
  ensure(!output_success(zero_handle), "cu_linux_gtk_entry_caret_zero_handle_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_caret_zero_handle_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_entry_caret_zero_handle_message:" + JSON.stringify(zero_handle.error)
  );

  const set_missing = run_cu_reply(run_directory, executable, "observe,actuate", [
    "set-caret", "--window", "1", "--offset", "0",
  ]);
  ensure(!output_success(set_missing), "cu_linux_gtk_entry_caret_set_usage_ok:" + JSON.stringify(set_missing));
  ensure(
    text_at(set_missing, "error.code") === "usage"
      || text_at(set_missing, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_caret_set_usage_code:" + JSON.stringify(set_missing.error)
  );

  const set_role = run_cu_reply(run_directory, executable, "observe,actuate", [
    "set-caret", "--window", "1", "--role", "entry", "--offset", "0",
  ]);
  ensure(!output_success(set_role), "cu_linux_gtk_entry_caret_set_role_ok:" + JSON.stringify(set_role));
  ensure(
    text_at(set_role, "error.code") === "usage"
      || text_at(set_role, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_caret_set_role_code:" + JSON.stringify(set_role.error)
  );
  ensure(
    text_at(set_role, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_caret_set_role_message:" + JSON.stringify(set_role.error)
  );

  const get_caret_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-caret", "--window", "1", "--coords", "10,10",
  ]);
  ensure(!output_success(get_caret_coords), "cu_linux_gtk_entry_caret_get_coords_ok:" + JSON.stringify(get_caret_coords));
  ensure(
    text_at(get_caret_coords, "error.code") === "usage",
    "cu_linux_gtk_entry_caret_get_coords_code:" + JSON.stringify(get_caret_coords.error)
  );
  ensure(
    text_at(get_caret_coords, "command") === "usage",
    "cu_linux_gtk_entry_caret_get_coords_command:" + JSON.stringify(get_caret_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(get_caret_coords, "error.message"), "--coords")
      || text_at(get_caret_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_caret_get_coords_message:" + JSON.stringify(get_caret_coords.error)
  );

  const get_caret_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-caret", "--window", "1", "--bogus",
  ]);
  ensure(!output_success(get_caret_bogus), "cu_linux_gtk_entry_caret_get_bogus_ok:" + JSON.stringify(get_caret_bogus));
  ensure(
    text_at(get_caret_bogus, "error.code") === "usage",
    "cu_linux_gtk_entry_caret_get_bogus_code:" + JSON.stringify(get_caret_bogus.error)
  );
  ensure(
    text_at(get_caret_bogus, "command") === "usage",
    "cu_linux_gtk_entry_caret_get_bogus_command:" + JSON.stringify(get_caret_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(get_caret_bogus, "error.message"), "--bogus")
      || text_at(get_caret_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_caret_get_bogus_message:" + JSON.stringify(get_caret_bogus.error)
  );

  const set_caret_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "set-caret", "--window", "1", "--coords", "10,10", "--offset", "0",
  ]);
  ensure(!output_success(set_caret_coords), "cu_linux_gtk_entry_caret_set_coords_ok:" + JSON.stringify(set_caret_coords));
  ensure(
    text_at(set_caret_coords, "error.code") === "usage"
      || text_at(set_caret_coords, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_caret_set_coords_code:" + JSON.stringify(set_caret_coords.error)
  );
  ensure(
    text_at(set_caret_coords, "command") === "usage",
    "cu_linux_gtk_entry_caret_set_coords_command:" + JSON.stringify(set_caret_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(set_caret_coords, "error.message"), "--coords")
      || text_at(set_caret_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_caret_set_coords_message:" + JSON.stringify(set_caret_coords.error)
  );

  const set_caret_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "set-caret", "--window", "1", "--bogus", "--offset", "0",
  ]);
  ensure(!output_success(set_caret_bogus), "cu_linux_gtk_entry_caret_set_bogus_ok:" + JSON.stringify(set_caret_bogus));
  ensure(
    text_at(set_caret_bogus, "error.code") === "usage"
      || text_at(set_caret_bogus, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_caret_set_bogus_code:" + JSON.stringify(set_caret_bogus.error)
  );
  ensure(
    text_at(set_caret_bogus, "command") === "usage",
    "cu_linux_gtk_entry_caret_set_bogus_command:" + JSON.stringify(set_caret_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(set_caret_bogus, "error.message"), "--bogus")
      || text_at(set_caret_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_caret_set_bogus_message:" + JSON.stringify(set_caret_bogus.error)
  );
}

function assert_caret_host_limit_when_atspi_absent(run_directory, executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
  const get_reply = run_cu_reply(run_directory, executable, "observe", [
    "get-caret", "--window", "1", "--name", ENTRY_NAME,
  ], env);
  ensure(!output_success(get_reply), "cu_linux_gtk_entry_caret_unavailable_ok:" + JSON.stringify(get_reply));
  const get_code = text_at(get_reply, "error.code");
  ensure(
    get_code === "a11y_backend_failed" || get_code === "unsupported" || get_code === "bad_handle"
      || get_code === "a11y_node_not_found" || get_code === "invalid_input",
    "cu_linux_gtk_entry_caret_unavailable_code:" + get_code
  );

  const set_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "set-caret", "--window", "1", "--name", ENTRY_NAME, "--offset", "0",
  ], env);
  ensure(!output_success(set_reply), "cu_linux_gtk_entry_caret_set_unavailable_ok:" + JSON.stringify(set_reply));
  const set_code = text_at(set_reply, "error.code");
  ensure(
    set_code === "a11y_backend_failed" || set_code === "unsupported" || set_code === "bad_handle"
      || set_code === "a11y_node_not_found" || set_code === "invalid_input",
    "cu_linux_gtk_entry_caret_set_unavailable_code:" + set_code
  );
}

function assert_caret_missing_node(run_directory, executable, handle, label) {
  const get_reply = run_cu_reply(run_directory, executable, "observe", [
    "get-caret", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!output_success(get_reply), "cu_linux_gtk_entry_caret_missing_ok_" + label);
  ensure(
    text_at(get_reply, "error.code") === "a11y_node_not_found",
    "cu_linux_gtk_entry_caret_missing_code_" + label + ":" + JSON.stringify(get_reply.error)
  );

  const set_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "set-caret", "--window", handle, "--name", MISSING_NODE, "--offset", "0",
  ]);
  ensure(!output_success(set_reply), "cu_linux_gtk_entry_caret_set_missing_ok_" + label);
  ensure(
    text_at(set_reply, "error.code") === "a11y_node_not_found",
    "cu_linux_gtk_entry_caret_set_missing_code_" + label + ":" + JSON.stringify(set_reply.error)
  );
}

function caret_unavailable_code_ok(code) {
  return code === "a11y_caret_unavailable" || code === "a11y_backend_failed";
}

function assert_caret_unavailable(run_directory, executable, handle, fixture_title, node_name, label) {
  const get_reply = run_cu_reply(run_directory, executable, "observe", [
    "get-caret", "--window", handle, "--name", node_name,
  ]);
  ensure(!output_success(get_reply), "cu_linux_gtk_entry_caret_unavailable_ok_" + label);
  const get_code = text_at(get_reply, "error.code");
  ensure(
    caret_unavailable_code_ok(get_code),
    "cu_linux_gtk_entry_caret_unavailable_code_" + label + ":" + JSON.stringify(get_reply.error)
  );
  if (get_code === "a11y_backend_failed") {
    const message = text_at(get_reply, "error.message").toLowerCase();
    ensure(
      message.indexOf("caret") >= 0 || message.indexOf("get failed") >= 0
        || message.indexOf("text") >= 0,
      "cu_linux_gtk_entry_caret_unavailable_message_" + label + ":" + JSON.stringify(get_reply.error)
    );
  }

  const set_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "set-caret", "--window", handle, "--name", node_name, "--offset", "0",
  ]);
  ensure(!output_success(set_reply), "cu_linux_gtk_entry_caret_set_unavailable_ok_" + label);
  const set_code = text_at(set_reply, "error.code");
  ensure(
    caret_unavailable_code_ok(set_code),
    "cu_linux_gtk_entry_caret_set_unavailable_code_" + label + ":" + JSON.stringify(set_reply.error)
  );
  const set_message = text_at(set_reply, "error.message").toLowerCase();
  ensure(
    set_code === "a11y_caret_unavailable"
      || set_message.indexOf("a11y_caret_unavailable") >= 0
      || set_message.indexOf("setcaretoffset") >= 0,
    "cu_linux_gtk_entry_caret_set_unavailable_message_" + label + ":" + JSON.stringify(set_reply.error)
  );

  const probe = independent_caret_probe(
    run_directory, executable,
    JSON.stringify({ title: fixture_title, mode: "unavailable", name_pattern: node_name })
  );
  ensure(
    probe.available === false,
    "cu_linux_gtk_entry_caret_probe_should_refuse_" + label + ":" + JSON.stringify(probe)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_gtk_entry_caret_executable_missing");
const context = harness.new_context(repo, "cu-linux-gtk-entry-caret");
const run_directory = rh.join(repo, "target/cu-linux-gtk-entry-caret-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_gtk_entry_caret_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP get-caret / set-caret typed-fail usage for missing/zero --window, --role-without--name, and --coords/--bogus misuse (usage_rejects_unexpected + command=usage)");
  assert_caret_usage_limit(run_directory, executable);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP get-caret / set-caret typed-fail host-limit when AT-SPI bus address is invalid before actuate/read-back court");
  assert_caret_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents and get-caret/set-caret host-limit already held");
    succeeded = 1;
  } else {
    print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_gtk_entry_caret_window_wait");
    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_gtk_entry_caret_window_identity");
    const handle = "" + at(row, "handle");

    print("STEP get-caret / set-caret typed-fail a11y_node_not_found when the named entry is missing");
    assert_caret_missing_node(run_directory, executable, handle, "before_focus");
    print("STEP independent get-text proves the entry stayed at the fixture seed after the miss");
    assert_entry_text(run_directory, executable, handle, FIXTURE_SEED, "after_missing");

    print("STEP get-caret / set-caret typed-fail when independent pyatspi probe has no Text caret interface");
    assert_caret_unavailable(
      run_directory, executable, handle, fixture_title, UNAVAILABLE_NODE, "check_without_text"
    );
    print("STEP independent get-text proves the unavailable set-caret did not mutate the entry");
    assert_entry_text(run_directory, executable, handle, FIXTURE_SEED, "after_unavailable");

    print("STEP focus moves AT-SPI focus to the named GTK entry");
    run_cu(run_directory, executable, "observe,actuate", [
      "focus", "--window", handle, "--name", ENTRY_NAME,
    ]);
    const focused = run_cu(run_directory, executable, "observe", [
      "focused", "--window", handle,
    ]);
    ensure(
      text_at(focused, "data.node.name") === ENTRY_NAME,
      "cu_linux_gtk_entry_caret_focused:" + JSON.stringify(focused.data)
    );

    print("STEP get-extents --name locates the GTK entry before caret actuate/read-back court");
    const entry_extents = run_cu(run_directory, executable, "observe", [
      "get-extents", "--window", handle, "--name", ENTRY_NAME,
    ]);
    ensure(
      text_at(entry_extents, "data.matched.name") === ENTRY_NAME
        && int_at(entry_extents, "data.extents.width") > 0
        && int_at(entry_extents, "data.extents.height") > 0,
      "cu_linux_gtk_entry_caret_extents_before_actuate:" + JSON.stringify(entry_extents.data)
    );

    const seed = "ceo9-caret-" + context.run_id;
    const caret_offset = 7;
    const end_offset = seed.length;
    print("STEP send-text --name plants SEED through AT-SPI EditableText/Text");
    const sent = run_cu(run_directory, executable, "observe,actuate", [
      "send-text", "--window", handle, "--name", ENTRY_NAME, "--", seed,
    ]);
    ensure(
      text_at(sent, "data.typed") === seed
        && text_at(sent, "data.addressing") === "accessibility-tree",
      "cu_linux_gtk_entry_caret_send:" + JSON.stringify(sent.data)
    );
    print("STEP independent get-text --name reads SEED back through AT-SPI Text.GetText");
    assert_entry_text(run_directory, executable, handle, seed, "after_send");

    print("STEP independent get-caret baseline before set-caret (not proof of placement)");
    const before = run_cu(run_directory, executable, "observe", [
      "get-caret", "--window", handle, "--name", ENTRY_NAME,
    ]);
    ensure(
      text_at(before, "data.via") === "get-caret-offset",
      "cu_linux_gtk_entry_caret_before_via:" + JSON.stringify(before.data)
    );

    print("STEP set-caret --name --offset N moves caret through AT-SPI Text.SetCaretOffset");
    const placed = run_cu(run_directory, executable, "observe,actuate", [
      "set-caret", "--window", handle, "--name", ENTRY_NAME,
      "--offset", "" + caret_offset,
    ]);
    ensure(
      text_at(placed, "data.addressing") === "accessibility-tree"
        && text_at(placed, "data.via") === "set-caret-offset"
        && int_at(placed, "data.offset") === caret_offset,
      "cu_linux_gtk_entry_caret_set:" + JSON.stringify(placed.data)
    );
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-set-caret");

    print("STEP independent get-caret --name must return the set offset and agree with pyatspi CaretOffset");
    assert_caret_agreement(
      run_directory, executable, handle, fixture_title, caret_offset, "mid"
    );
    print("STEP independent get-text --name still reads SEED after set-caret");
    assert_entry_text(run_directory, executable, handle, seed, "after_set_mid");
    print("STEP get-caret --name with --coords/--bogus rejects or stays get-caret-offset");
    assert_get_caret_reject_coords_or_stay_named(
      run_directory, executable, handle, caret_offset, "mid"
    );
    print("STEP set-caret --name with --coords/--bogus rejects or stays accessibility-tree");
    assert_set_caret_reject_coords_or_stay_named(
      run_directory, executable, handle, end_offset, "mid"
    );
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-get-caret");

    print("STEP set-caret --name --offset end-of-SEED then independent get-caret read-back");
    const placed_end = run_cu(run_directory, executable, "observe,actuate", [
      "set-caret", "--window", handle, "--name", ENTRY_NAME,
      "--offset", "" + end_offset,
    ]);
    ensure(
      text_at(placed_end, "data.via") === "set-caret-offset"
        && int_at(placed_end, "data.offset") === end_offset,
      "cu_linux_gtk_entry_caret_set_end:" + JSON.stringify(placed_end.data)
    );
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-set-caret-end");
    assert_caret_agreement(
      run_directory, executable, handle, fixture_title, end_offset, "end"
    );
    print("STEP independent get-text --name still reads SEED after set-caret-end");
    assert_entry_text(run_directory, executable, handle, seed, "after_set_end");
    print("STEP get-caret --name with --coords/--bogus rejects or stays get-caret-offset at end");
    assert_get_caret_reject_coords_or_stay_named(
      run_directory, executable, handle, end_offset, "end"
    );
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-get-caret-end");

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_gtk_entry_caret_failed");
if (atspi_available) {
  print("PASS: CEO#9 GTK entry set-caret / get-caret roundtrip by --name with independent get-text/get-caret read-back, pyatspi CaretOffset agreement, typed get-caret/set-caret --coords/--bogus usage_rejects_unexpected, and get-extents --name usage/host-limit plus --coords/--bogus command=usage honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: CEO#9 GTK entry get-caret/set-caret typed-fails with typed get-extents --name usage AND host-limit honesty, get-caret/set-caret host-limit, and --coords/--bogus command=usage when independent pyatspi desktop probe is unavailable");
}
