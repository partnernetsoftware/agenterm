// CEO#9: GTK entry/label copy --name → independent clipboard-read.
// Acceptance is N≥2 copy→clipboard-read roundtrips where clipboard-read text
// == seeded GetText payload; copy reply text does not count. Typed copy and
// clipboard usage must reject --coords/--bogus misuse or stay on
// accessibility-tree --name via usage_rejects_unexpected + command=usage, or an
// honest non-usage typed failure (never fake command=usage). Typed get-extents
// --name usage AND host-limit courts must both hold before process-state,
// desktop-state, and the native actuate/read-back court (no if/else gating
// those courts on atspi_available), including get-extents --coords/--bogus
// command=usage honesty. process-state and desktop-state fixture binding courts
// must hold before actuate/read-back. Miss paths must not publish onto the
// clipboard (independent clipboard-read read-back). AT-SPI --name only; no
// --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-gtk-entry-copy-clipboard",
  "cu.linux-gtk-label-copy-clipboard",
];

const ENTRY_NAME = "Fixture Entry";
const LABEL_NAME = "menu idle";
const MISSING_NODE = "No Such Entry";
const COPY_ROUND_COUNT = 2;
const text_type = "text/plain;charset=utf-8";
const MISS_SENTINEL = "ceo9-copy-miss-sentinel";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return parseInt("" + value_at, 10);
}


function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_copy_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(rh.output_success(document), "cu_linux_gtk_copy_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_copy_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function clipboard_text_matches(run_directory, executable, expected) {
  const read = run_cu(run_directory, executable, "observe", ["clipboard-read"]);
  ensure(
    text_at(read, "data.text") === expected
      && flag_at(read, "data.types_available")
      && text_at(read, "data.format") === text_type,
    "cu_linux_gtk_copy_clipboard_read:" + JSON.stringify({
      expected: expected,
      read: read.data,
    })
  );
  return read;
}

function assert_clipboard_usage_limit(run_directory, executable) {
  const read_bogus = run_cu_reply(run_directory, executable, "observe", [
    "clipboard-read", "--bogus",
  ]);
  ensure(!rh.output_success(read_bogus), "cu_linux_gtk_copy_clipboard_read_bogus_ok:" + JSON.stringify(read_bogus));
  ensure(
    text_at(read_bogus, "error.code") === "usage",
    "cu_linux_gtk_copy_clipboard_read_bogus_code:" + JSON.stringify(read_bogus.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(read_bogus, "error.message"), "--bogus"),
    "cu_linux_gtk_copy_clipboard_read_bogus_message:" + JSON.stringify(read_bogus.error)
  );

  const write_bogus = run_cu_reply(run_directory, executable, "actuate", [
    "clipboard-write", "--type", text_type, "--text", "probe", "--bogus",
  ]);
  ensure(!rh.output_success(write_bogus), "cu_linux_gtk_copy_clipboard_write_bogus_ok:" + JSON.stringify(write_bogus));
  ensure(
    text_at(write_bogus, "error.code") === "usage",
    "cu_linux_gtk_copy_clipboard_write_bogus_code:" + JSON.stringify(write_bogus.error)
  );

  const clear_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "clipboard-clear", "--apply", "--name", ENTRY_NAME,
  ]);
  ensure(!rh.output_success(clear_name), "cu_linux_gtk_copy_clipboard_clear_name_ok:" + JSON.stringify(clear_name));
  ensure(
    text_at(clear_name, "error.code") === "usage",
    "cu_linux_gtk_copy_clipboard_clear_name_code:" + JSON.stringify(clear_name.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(clear_name, "error.message"), "--name"),
    "cu_linux_gtk_copy_clipboard_clear_name_message:" + JSON.stringify(clear_name.error)
  );

  const write_bogus_message = text_at(write_bogus, "error.message");
  ensure(
    usage_rejects_unexpected(write_bogus_message, "--bogus"),
    "cu_linux_gtk_copy_clipboard_write_bogus_message:" + JSON.stringify(write_bogus.error)
  );
}

function assert_copy_unexpected_usage(run_directory, executable) {
  const copy_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "copy", "--bogus",
  ]);
  ensure(!rh.output_success(copy_bogus), "cu_linux_gtk_copy_bogus_ok:" + JSON.stringify(copy_bogus));
  ensure(
    text_at(copy_bogus, "error.code") === "usage",
    "cu_linux_gtk_copy_bogus_code:" + JSON.stringify(copy_bogus.error)
  );
  ensure(
    text_at(copy_bogus, "command") === "usage",
    "cu_linux_gtk_copy_bogus_command:" + JSON.stringify(copy_bogus)
  );
}

function assert_copy_reject_coords_or_stay_named(
  run_directory, executable, handle, label
) {
  const copy_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "copy", "--window", handle, "--name", ENTRY_NAME, "--coords", "10,10",
  ]);
  if (!rh.output_success(copy_coords)) {
    ensure(
      text_at(copy_coords, "error.code") === "usage",
      "cu_linux_gtk_copy_name_coords_code_" + label + ":" + JSON.stringify(copy_coords.error)
    );
    ensure(
      text_at(copy_coords, "command") === "usage",
      "cu_linux_gtk_copy_name_coords_command_" + label + ":" + JSON.stringify(copy_coords)
    );
    ensure(
      usage_rejects_unexpected(text_at(copy_coords, "error.message"), "--coords"),
      "cu_linux_gtk_copy_name_coords_message_" + label + ":" + JSON.stringify(copy_coords.error)
    );
  } else {
    ensure(
      text_at(copy_coords, "data.addressing") === "accessibility-tree",
      "cu_linux_gtk_copy_name_coords_degraded_" + label + ":" + JSON.stringify(copy_coords.data)
    );
  }

  const copy_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "copy", "--window", handle, "--name", ENTRY_NAME, "--bogus",
  ]);
  if (!rh.output_success(copy_bogus)) {
    ensure(
      text_at(copy_bogus, "error.code") === "usage",
      "cu_linux_gtk_copy_name_bogus_code_" + label + ":" + JSON.stringify(copy_bogus.error)
    );
    ensure(
      text_at(copy_bogus, "command") === "usage",
      "cu_linux_gtk_copy_name_bogus_command_" + label + ":" + JSON.stringify(copy_bogus)
    );
    ensure(
      usage_rejects_unexpected(text_at(copy_bogus, "error.message"), "--bogus"),
      "cu_linux_gtk_copy_name_bogus_message_" + label + ":" + JSON.stringify(copy_bogus.error)
    );
  } else {
    ensure(
      text_at(copy_bogus, "data.addressing") === "accessibility-tree",
      "cu_linux_gtk_copy_name_bogus_degraded_" + label + ":" + JSON.stringify(copy_bogus.data)
    );
  }
}

function assert_copy_usage_limit(run_directory, executable) {
  const missing_window = run_cu_reply(run_directory, executable, "observe,actuate", [
    "copy", "--name", ENTRY_NAME,
  ]);
  ensure(!rh.output_success(missing_window), "cu_linux_gtk_copy_usage_ok:" + JSON.stringify(missing_window));
  ensure(
    text_at(missing_window, "error.code") === "usage",
    "cu_linux_gtk_copy_usage_code:" + JSON.stringify(missing_window.error)
  );
  ensure(
    text_at(missing_window, "command") === "usage",
    "cu_linux_gtk_copy_usage_command:" + JSON.stringify(missing_window)
  );
  ensure(
    text_at(missing_window, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_copy_usage_message:" + JSON.stringify(missing_window.error)
  );

  const role_without_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "copy", "--window", "1", "--role", "entry",
  ]);
  ensure(!rh.output_success(role_without_name), "cu_linux_gtk_copy_role_ok:" + JSON.stringify(role_without_name));
  ensure(
    text_at(role_without_name, "error.code") === "usage",
    "cu_linux_gtk_copy_role_code:" + JSON.stringify(role_without_name.error)
  );
  ensure(
    text_at(role_without_name, "command") === "usage",
    "cu_linux_gtk_copy_role_command:" + JSON.stringify(role_without_name)
  );
  ensure(
    text_at(role_without_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_copy_role_message:" + JSON.stringify(role_without_name.error)
  );

  const zero_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "copy", "--window", "0", "--name", ENTRY_NAME,
  ]);
  ensure(!rh.output_success(zero_handle), "cu_linux_gtk_copy_zero_handle_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "usage",
    "cu_linux_gtk_copy_zero_handle_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "command") === "usage",
    "cu_linux_gtk_copy_zero_handle_command:" + JSON.stringify(zero_handle)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_copy_zero_handle_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", ENTRY_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle), "cu_linux_gtk_copy_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_copy_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_gtk_copy_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name), "cu_linux_gtk_copy_extents_missing_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_gtk_copy_extents_missing_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_gtk_copy_extents_missing_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_copy_extents_missing_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_gtk_copy_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_gtk_copy_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_gtk_copy_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_copy_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_gtk_copy_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_gtk_copy_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_gtk_copy_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_copy_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", ENTRY_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply), "cu_linux_gtk_copy_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_gtk_copy_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_gtk_copy_extents_unavailable_code:" + code
  );
}

function assert_copy_host_limit_when_atspi_absent(run_directory, executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "copy", "--window", "1", "--name", ENTRY_NAME,
  ], env);
  ensure(!rh.output_success(reply), "cu_linux_gtk_copy_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_gtk_copy_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle",
    "cu_linux_gtk_copy_unavailable_code:" + code
  );
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_gtk_copy_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_gtk_copy_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_gtk_copy_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_gtk_copy_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_gtk_copy_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function assert_copy_missing_node(run_directory, executable, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "copy", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!rh.output_success(reply), "cu_linux_gtk_copy_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_gtk_copy_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(rh.is_direct_file(executable), "cu_linux_gtk_copy_executable_missing");
const context = harness.new_context(repo, "cu-linux-gtk-copy");
const run_directory = rh.join(repo, "target/cu-linux-gtk-copy-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(rh.is_direct_file(fixture_source), "cu_linux_gtk_copy_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP copy/clipboard typed-fail usage for missing/zero --window, --role-without--name, and --coords/--bogus misuse (usage_rejects_unexpected + command=usage, or honest non-usage typed failure; never fake command=usage)");
  assert_copy_usage_limit(run_directory, executable);
  assert_clipboard_usage_limit(run_directory, executable);
  assert_copy_unexpected_usage(run_directory, executable);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (command=usage) before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP copy typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
  assert_copy_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held; gtk-copy read-back requires pyatspi");
    succeeded = 1;
  } else {
    print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_gtk_copy_window_wait");
    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_gtk_copy_window_identity");
    const handle = "" + at(row, "handle");

    print("STEP process-state binds the owned fixture pid before copy actuate/read-back court");
    assert_fixture_process_state(run_directory, executable, fixture_pid);

    print("STEP desktop-state window row agrees with inventory before copy actuate/read-back court");
    assert_fixture_desktop_state(
      run_directory, executable, fixture_pid, fixture_title, handle, row
    );

    print("STEP clipboard-clear then clipboard-write publishes a miss sentinel");
    run_cu(run_directory, executable, "observe,actuate", [
      "clipboard-clear", "--apply",
    ]);
    run_cu(run_directory, executable, "actuate", [
      "clipboard-write", "--type", text_type, "--text", MISS_SENTINEL,
    ]);
    clipboard_text_matches(run_directory, executable, MISS_SENTINEL);

    print("STEP copy typed-fail a11y_node_not_found when the named entry is missing");
    assert_copy_missing_node(run_directory, executable, handle, "before_entry_copy");
    print("STEP independent clipboard-read proves the miss did not publish onto the clipboard");
    clipboard_text_matches(run_directory, executable, MISS_SENTINEL);

    print("STEP get-extents --name locates the GTK entry before copy actuate/read-back court");
    const entry_extents = run_cu(run_directory, executable, "observe", [
      "get-extents", "--window", handle, "--name", ENTRY_NAME,
    ]);
    ensure(
      text_at(entry_extents, "data.matched.name") === ENTRY_NAME
        && int_at(entry_extents, "data.extents.width") > 0
        && int_at(entry_extents, "data.extents.height") > 0,
      "cu_linux_gtk_copy_entry_extents_before_actuate:" + JSON.stringify(entry_extents.data)
    );

    print("STEP get-extents --name locates the GTK label before label copy court");
    const label_extents = run_cu(run_directory, executable, "observe", [
      "get-extents", "--window", handle, "--name", LABEL_NAME,
    ]);
    ensure(
      text_at(label_extents, "data.matched.name") === LABEL_NAME
        && int_at(label_extents, "data.extents.width") > 0
        && int_at(label_extents, "data.extents.height") > 0,
      "cu_linux_gtk_copy_label_extents_before_actuate:" + JSON.stringify(label_extents.data)
    );

    print("STEP copy --name with --coords/--bogus rejects as command=usage or stays accessibility-tree before copy/read-back court");
    assert_copy_reject_coords_or_stay_named(run_directory, executable, handle, "before_actuate");

    const copy_seeds = [
      "ceo9-gtk-copy-r1-" + context.run_id + " ≠ 你好",
      "ceo9-gtk-copy-r2-" + context.run_id + " π≈3.14",
    ];
    ensure(copy_seeds.length >= COPY_ROUND_COUNT, "cu_linux_gtk_copy_seed_count");

    for (let round = 1; round <= COPY_ROUND_COUNT; round += 1) {
      const seed = copy_seeds[round - 1];
      print("STEP round " + round + "/" + COPY_ROUND_COUNT + ": clear clipboard before entry copy court");
      run_cu(run_directory, executable, "observe,actuate", [
        "clipboard-clear", "--apply",
      ]);

      print("STEP round " + round + "/" + COPY_ROUND_COUNT + ": send-text --name plants SEED in the GTK entry");
      const sent = run_cu(run_directory, executable, "observe,actuate", [
        "send-text", "--window", handle, "--name", ENTRY_NAME, "--", seed,
      ]);
      ensure(
        text_at(sent, "data.typed") === seed
          && text_at(sent, "data.addressing") === "accessibility-tree",
        "cu_linux_gtk_copy_send_r" + round + ":" + JSON.stringify(sent.data)
      );

      print("STEP round " + round + "/" + COPY_ROUND_COUNT + ": copy --name publishes entry GetText onto native clipboard");
      const copied = run_cu(run_directory, executable, "observe,actuate", [
        "copy", "--window", handle, "--name", ENTRY_NAME,
      ]);
      ensure(
        text_at(copied, "data.via") === "gettext"
          && flag_at(copied, "data.clipboard")
          && text_at(copied, "data.addressing") === "accessibility-tree",
        "cu_linux_gtk_copy_entry_copy_r" + round + ":" + JSON.stringify(copied.data)
      );

      print("STEP round " + round + "/" + COPY_ROUND_COUNT + ": independent clipboard-read proves entry payload == SEED");
      clipboard_text_matches(run_directory, executable, seed);
      if (round === 1) {
        harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-copy-clipboard");
      }
    }

    print("STEP copy --name on GTK label publishes label text onto clipboard");
    const label_copy = run_cu(run_directory, executable, "observe,actuate", [
      "copy", "--window", handle, "--name", LABEL_NAME,
    ]);
    ensure(
      text_at(label_copy, "data.via") === "gettext"
        && flag_at(label_copy, "data.clipboard"),
      "cu_linux_gtk_copy_label_copy:" + JSON.stringify(label_copy.data)
    );

    print("STEP independent clipboard-read proves label payload == menu idle");
    clipboard_text_matches(run_directory, executable, LABEL_NAME);
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-label-copy-clipboard");

    run_cu(run_directory, executable, "actuate", ["clipboard-clear", "--apply"]);
    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_gtk_copy_failed");
if (atspi_available) {
  print("PASS: CEO#9 GTK entry/label copy --name → " + COPY_ROUND_COUNT + " copy→clipboard-read roundtrips with independent clipboard-read == SEED, typed copy/clipboard usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), and process-state/desktop-state courts before actuate (AT-SPI --name, no --coords)");
} else {
  print("PASS: CEO#9 GTK entry/label copy typed-fails with typed copy/clipboard/get-extents --name/--coords/--bogus usage and get-extents/copy host-limit honesty when independent pyatspi desktop probe is unavailable");
}
