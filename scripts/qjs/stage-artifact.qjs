// Stage one validated AgenTerm executable, parking an in-use Windows image.
//
// Args:
//   SOURCE_DIRECTORY DESTINATION_DIRECTORY ARTIFACT_NAME
// Runs under `--profile tool`: it copies on disk and reads its own
// arguments through the same door.
import * as artifact_files from "lib/artifact_files";
if (arg_count() !== 3) { throw "expected: SOURCE_DIRECTORY DESTINATION_DIRECTORY ARTIFACT_NAME"; }
// Two-pass argv: `arg(i)` parks the string, `tool_result()` collects it.
const args = [];
for (let i = 0; i < 3; i = i + 1) {
  if (arg(i) !== 0) { throw "arg: " + tool_result(); }
  args.push(tool_result());
}
return artifact_files.stage(args[0], args[1], args[2]);
