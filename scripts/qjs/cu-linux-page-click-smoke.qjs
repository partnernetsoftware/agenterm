// CEO: Linux CDP page-click honesty — click a named page control; prove with
// independent page-js DOM read-back (not page-click performed/verified).
// Typed usage and host-limit paths must hold when the node query or coordinates
// are missing, invalid, or exclusive; a free port must typed-fail before any
// owned Chrome exists. Distinct from AT-SPI hover→click.
// Disposable Chrome+CDP; --port/--target-id/--selector only; no --coords.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-cdp-page-click",
  "cu.linux-cdp-page-click-readback",
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_page_click_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(document), "cu_linux_page_click_reply:" + JSON.stringify(document));
  return document;
}

function assert_page_click_usage_limit(run_directory, executable, env, port) {
  const missing_node = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused",
  ], env);
  ensure(!output_success(missing_node), "cu_linux_page_click_usage_ok:" + JSON.stringify(missing_node));
  ensure(
    text_at(missing_node, "error.code") === "usage",
    "cu_linux_page_click_usage_code:" + JSON.stringify(missing_node.error)
  );
  ensure(
    text_at(missing_node, "error.message").indexOf("--selector") >= 0,
    "cu_linux_page_click_usage_message:" + JSON.stringify(missing_node.error)
  );

  const missing_y = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused", "--x", "10",
  ], env);
  ensure(!output_success(missing_y), "cu_linux_page_click_missing_y_ok:" + JSON.stringify(missing_y));
  ensure(
    text_at(missing_y, "error.code") === "usage",
    "cu_linux_page_click_missing_y_code:" + JSON.stringify(missing_y.error)
  );
  ensure(
    text_at(missing_y, "error.message").indexOf("--y") >= 0,
    "cu_linux_page_click_missing_y_message:" + JSON.stringify(missing_y.error)
  );

  const mixed = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused",
    "--selector", "#go", "--x", "10", "--y", "10",
  ], env);
  ensure(!output_success(mixed), "cu_linux_page_click_mixed_ok:" + JSON.stringify(mixed));
  ensure(
    text_at(mixed, "error.code") === "usage",
    "cu_linux_page_click_mixed_code:" + JSON.stringify(mixed.error)
  );
  ensure(
    text_at(mixed, "error.message").indexOf("not both") >= 0,
    "cu_linux_page_click_mixed_message:" + JSON.stringify(mixed.error)
  );

  const bad_x = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused", "--x", "-1", "--y", "10",
  ], env);
  ensure(!output_success(bad_x), "cu_linux_page_click_bad_x_ok:" + JSON.stringify(bad_x));
  ensure(
    text_at(bad_x, "error.code") === "usage",
    "cu_linux_page_click_bad_x_code:" + JSON.stringify(bad_x.error)
  );
  ensure(
    text_at(bad_x, "error.message").indexOf("viewport CSS coordinate") >= 0,
    "cu_linux_page_click_bad_x_message:" + JSON.stringify(bad_x.error)
  );
}

function assert_no_cdp_listener(run_directory, executable, env, port) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused", "--selector", "#go",
  ], env);
  ensure(reply.ok !== true, "cu_linux_page_click_false_success:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_page_click_host_limit_code:" + JSON.stringify(reply)
  );
  const message = text_at(reply, "error.message");
  ensure(
    message.indexOf("no CDP listener") >= 0 && message.indexOf("" + port) >= 0,
    "cu_linux_page_click_host_limit_message:" + JSON.stringify(reply.error)
  );
}

function assert_page_click_miss_selector(run_directory, executable, env, port, target_id) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", target_id, "--selector", "#missing",
  ], env);
  ensure(!output_success(reply), "cu_linux_page_click_miss_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "cdp_node_not_found",
    "cu_linux_page_click_miss_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("#missing") >= 0,
    "cu_linux_page_click_miss_message:" + JSON.stringify(reply.error)
  );
}

function assert_page_click_miss_target(run_directory, executable, env, port) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "deadbeef", "--selector", "#go",
  ], env);
  ensure(!output_success(reply), "cu_linux_page_click_miss_target_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "cdp_target_not_found",
    "cu_linux_page_click_miss_target_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("--target-id") >= 0,
    "cu_linux_page_click_miss_target_message:" + JSON.stringify(reply.error)
  );
}

function cdp_ready(run_directory, port) {
  const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  return probe.success === true && probe.stdout.indexOf("Browser") >= 0;
}

function page_target(rows) {
  for (const row of rows) {
    if (text_at(row, "type") === "page") { return row; }
  }
  return null;
}

function out_text(run_directory, executable, env, port, target_id) {
  const read = run_cu(run_directory, executable, "observe", [
    "page-js", "--port", "" + port, "--target-id", target_id,
    "--expression", "document.getElementById('out').textContent",
  ], env);
  return text_at(read, "data.value");
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "cu_linux_page_click_executable_missing:" + executable);
ensure(direct_file(abi_library), "cu_linux_page_click_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-page-click");
const run_directory = context.run_directory;
const env = cu_env(executable);

const fixture_title = "CEO CDP Click " + context.run_id;
const fixture = rh.join(run_directory, "cdp-click.html");
const fixture_html = "<!DOCTYPE html><html><head><title>"
  + fixture_title + "</title></head><body>"
  + "<button id='go' type='button'"
  + " onclick=\"document.getElementById('out').textContent='clicked'\">Go</button>"
  + "<p id='out'>idle</p>"
  + "</body></html>";
rh.write_text(fixture, fixture_html);

const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
const port = 9300 + (rh.pid() % 500);
let chrome_child = -1;
let succeeded = 0;
let failure = "";

try {
  const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  ensure(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
    "cu_linux_page_click_port_in_use:" + port);

  print("STEP typed usage limits reject missing node query or invalid coordinates before Chrome starts");
  assert_page_click_usage_limit(run_directory, executable, env, port);

  print("STEP page-click typed-fails no CDP listener on the owned free port before Chrome starts");
  assert_no_cdp_listener(run_directory, executable, env, port);

  print("STEP launch owned Chrome with CDP port and a disposable file:// tab");
  chrome_child = harness.start({
    program: launcher,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--new-window",
      "about:blank",
    ],
    current_dir: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  for (let attempt = 0; attempt < 80 && !cdp_ready(run_directory, port); attempt = attempt + 1) {
    harness.sleep_ms(250);
  }
  ensure(cdp_ready(run_directory, port), "cu_linux_page_click_cdp_not_ready:" + port);

  print("STEP page-click typed-fails cdp_target_not_found for a bogus --target-id");
  assert_page_click_miss_target(run_directory, executable, env, port);

  const targets = run_cu(run_directory, executable, "observe", [
    "page-targets", "--port", "" + port,
  ], env);
  const target = page_target(targets.data.targets);
  ensure(target !== null && text_at(target, "id") !== "", "cu_linux_page_click_target_missing");
  const target_id = text_at(target, "id");

  print("STEP page-nav loads the disposable HTML fixture in this owned tab");
  const nav_url = "file://" + fixture;
  const nav = run_cu(run_directory, executable, "observe,actuate", [
    "page-nav", "--port", "" + port, "--target-id", target_id,
    "--url", nav_url, "--wait-ms", "10000",
  ], env);
  ensure(
    flag_at(nav, "data.verified") && text_at(nav, "data.final_title") === fixture_title,
    "cu_linux_page_click_nav:" + JSON.stringify(nav.data)
  );

  print("STEP independent page-js baseline proves #out starts idle before the click");
  const before_text = out_text(run_directory, executable, env, port, target_id);
  ensure(
    before_text === "idle",
    "cu_linux_page_click_before:" + JSON.stringify({ text: before_text })
  );

  print("STEP page-click --selector #go actuates the named control (receipt not acceptance)");
  const clicked = run_cu(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", target_id, "--selector", "#go",
  ], env);
  ensure(
    clicked.command === "page-click",
    "cu_linux_page_click_shape:" + JSON.stringify(clicked)
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-cdp-page-click");

  print("STEP independent page-js read-back proves the click mutated DOM state");
  let readback_text = "";
  for (let attempt = 0; attempt < 40 && readback_text !== "clicked"; attempt = attempt + 1) {
    readback_text = out_text(run_directory, executable, env, port, target_id);
    if (readback_text !== "clicked") { harness.sleep_ms(250); }
  }
  ensure(
    readback_text === "clicked",
    "cu_linux_page_click_readback:" + JSON.stringify({ expected: "clicked", text: readback_text })
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-cdp-page-click-readback");

  print("STEP typed miss path rejects a --selector that matches no rendered node");
  assert_page_click_miss_selector(run_directory, executable, env, port, target_id);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup: " + error); }
}

ensure(succeeded === 1, failure || "cu_linux_page_click_failed");
harness.remove_run(context);
print("PASS: Linux page-click usage/host-limit/miss honesty + independent page-js DOM read-back (no --coords)");
return;
