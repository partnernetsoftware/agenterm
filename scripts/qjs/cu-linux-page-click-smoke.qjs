// CEO: Linux CDP page-click honesty — click a named page control; prove with
// independent page-js DOM read-back (not page-click performed/verified).
// Typed page-click usage must reject AT-SPI --name, --coords, --bogus, and
// other unexpected arguments via usage_rejects_unexpected or honest non-usage
// typed failure (never fake command=usage); typed get-extents --name usage AND
// host-limit paths must both hold before process-state, desktop-state, and the
// page-click actuate/page-js DOM read-back court (no atspi_available gating).
// process-state and desktop-state fixture binding courts must hold before
// actuate/read-back when the owned Chrome window is discoverable. A free port
// must typed-fail before any owned Chrome exists. Distinct from AT-SPI
// hover→click. Prefer host-limit clarity over fake success.
// Disposable Chrome+CDP; --port/--target-id/--selector only; no --coords.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-cdp-page-click",
  "cu.linux-cdp-page-click-readback",
];

const AT_SPI_PROBE_NAME = "Page Click Court Anchor";
const MISSING_NODE = "agenterm-no-such-page-click-node";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_page_click_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(document), "cu_linux_page_click_reply:" + JSON.stringify(document));
  return document;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function assert_page_click_usage_limit(run_directory, executable, env, port) {
  const missing_node = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused",
  ], env);
  ensure(!output_success(missing_node), "cu_linux_page_click_usage_ok:" + JSON.stringify(missing_node));
  ensure(
    text_at(missing_node, "error.code") === "usage",
    "cu_linux_page_click_usage_code:" + JSON.stringify(missing_node.error)
  );
  ensure(
    text_at(missing_node, "error.message").indexOf("--selector") >= 0,
    "cu_linux_page_click_usage_message:" + JSON.stringify(missing_node.error)
  );

  const missing_y = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused", "--x", "10",
  ], env);
  ensure(!output_success(missing_y), "cu_linux_page_click_missing_y_ok:" + JSON.stringify(missing_y));
  ensure(
    text_at(missing_y, "error.code") === "usage",
    "cu_linux_page_click_missing_y_code:" + JSON.stringify(missing_y.error)
  );
  ensure(
    text_at(missing_y, "error.message").indexOf("--y") >= 0,
    "cu_linux_page_click_missing_y_message:" + JSON.stringify(missing_y.error)
  );

  const mixed = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused",
    "--selector", "#go", "--x", "10", "--y", "10",
  ], env);
  ensure(!output_success(mixed), "cu_linux_page_click_mixed_ok:" + JSON.stringify(mixed));
  ensure(
    text_at(mixed, "error.code") === "usage",
    "cu_linux_page_click_mixed_code:" + JSON.stringify(mixed.error)
  );
  ensure(
    text_at(mixed, "error.message").indexOf("not both") >= 0,
    "cu_linux_page_click_mixed_message:" + JSON.stringify(mixed.error)
  );

  const bad_x = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused", "--x", "-1", "--y", "10",
  ], env);
  ensure(!output_success(bad_x), "cu_linux_page_click_bad_x_ok:" + JSON.stringify(bad_x));
  ensure(
    text_at(bad_x, "error.code") === "usage",
    "cu_linux_page_click_bad_x_code:" + JSON.stringify(bad_x.error)
  );
  ensure(
    text_at(bad_x, "error.message").indexOf("viewport CSS coordinate") >= 0,
    "cu_linux_page_click_bad_x_message:" + JSON.stringify(bad_x.error)
  );
}

function assert_page_click_usage_rejects_name(run_directory, executable, env, port) {
  const flat_with_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused",
    "--selector", "#go", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_page_click_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_page_click_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_page_click_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_name, "error.message"), "--name"),
    "cu_linux_page_click_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page", "click", "--port", "" + port, "--target-id", "unused",
    "--selector", "#go", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_page_click_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_page_click_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "command") === "usage",
    "cu_linux_page_click_usage_grouped_name_command:" + JSON.stringify(grouped_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_name, "error.message"), "--name"),
    "cu_linux_page_click_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const flat_with_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused",
    "--selector", "#go", "--bogus",
  ], env);
  ensure(!output_success(flat_with_bogus),
    "cu_linux_page_click_usage_flat_bogus_ok:" + JSON.stringify(flat_with_bogus));
  ensure(
    text_at(flat_with_bogus, "error.code") === "usage",
    "cu_linux_page_click_usage_flat_bogus_code:" + JSON.stringify(flat_with_bogus.error)
  );
  ensure(
    text_at(flat_with_bogus, "command") === "usage",
    "cu_linux_page_click_usage_flat_bogus_command:" + JSON.stringify(flat_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_bogus, "error.message"), "--bogus"),
    "cu_linux_page_click_usage_flat_bogus_message:" + JSON.stringify(flat_with_bogus.error)
  );

  const grouped_with_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page", "click", "--port", "" + port, "--target-id", "unused",
    "--selector", "#go", "--bogus",
  ], env);
  ensure(!output_success(grouped_with_bogus),
    "cu_linux_page_click_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_page_click_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    text_at(grouped_with_bogus, "command") === "usage",
    "cu_linux_page_click_usage_grouped_bogus_command:" + JSON.stringify(grouped_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_bogus, "error.message"), "--bogus"),
    "cu_linux_page_click_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const flat_with_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused",
    "--selector", "#go", "--coords", "10,10",
  ], env);
  ensure(!output_success(flat_with_coords),
    "cu_linux_page_click_usage_flat_coords_ok:" + JSON.stringify(flat_with_coords));
  ensure(
    text_at(flat_with_coords, "error.code") === "usage",
    "cu_linux_page_click_usage_flat_coords_code:" + JSON.stringify(flat_with_coords.error)
  );
  ensure(
    text_at(flat_with_coords, "command") === "usage",
    "cu_linux_page_click_usage_flat_coords_command:" + JSON.stringify(flat_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_coords, "error.message"), "--coords"),
    "cu_linux_page_click_usage_flat_coords_message:" + JSON.stringify(flat_with_coords.error)
  );

  const grouped_with_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page", "click", "--port", "" + port, "--target-id", "unused",
    "--selector", "#go", "--coords", "10,10",
  ], env);
  ensure(!output_success(grouped_with_coords),
    "cu_linux_page_click_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_page_click_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    text_at(grouped_with_coords, "command") === "usage",
    "cu_linux_page_click_usage_grouped_coords_command:" + JSON.stringify(grouped_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_coords, "error.message"), "--coords"),
    "cu_linux_page_click_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_page_click_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_page_click_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_page_click_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_page_click_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_page_click_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_page_click_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_page_click_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_page_click_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_page_click_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_page_click_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_page_click_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_page_click_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_page_click_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_page_click_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_page_click_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_page_click_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_page_click_extents_unavailable_code:" + code
  );
}

function assert_get_extents_missing_node(run_directory, executable, env, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", MISSING_NODE,
  ], env);
  ensure(!output_success(reply), "cu_linux_page_click_extents_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_page_click_extents_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function independent_pyatspi_extents(run_directory, env, window_title, node_name) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "want = sys.argv[2]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and title in (w.name or ''):",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    if (node.name or '') == want:",
    "        return node",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_page_click_atspi_no_frame')",
    "node = walk(frame)",
    "if node is None:",
    "    raise SystemExit('cu_linux_page_click_atspi_miss:' + want)",
    "component = node.queryComponent()",
    "ext = component.getExtents(pyatspi.DESKTOP_COORDS)",
    "x, y, w, h = int(ext.x), int(ext.y), int(ext.width), int(ext.height)",
    "print(json.dumps({",
    "    'name': want,",
    "    'x': x, 'y': y, 'width': w, 'height': h,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, window_title, node_name], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_page_click_pyatspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function assert_get_extents_agreement(run_directory, executable, env, handle, window_title, node_name) {
  const pyatspi_anchor = independent_pyatspi_extents(
    run_directory, env, window_title, node_name
  );
  const anchor_extents = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", node_name,
  ], env);
  ensure(
    int_at(anchor_extents, "data.extents.x") === pyatspi_anchor.x
      && int_at(anchor_extents, "data.extents.y") === pyatspi_anchor.y
      && int_at(anchor_extents, "data.extents.width") === pyatspi_anchor.width
      && int_at(anchor_extents, "data.extents.height") === pyatspi_anchor.height,
    "cu_linux_page_click_extents_agree:" + JSON.stringify({
      cu: anchor_extents.data.extents,
      pyatspi_anchor: pyatspi_anchor,
    })
  );
}

function windows_rows(reply) {
  const data = at(reply, "data");
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function window_row_for_title(run_directory, executable, env, title_needle) {
  const reply = run_cu(run_directory, executable, "observe", ["windows"], env);
  for (const row of windows_rows(reply)) {
    const title = text_at(row, "title");
    if (title.indexOf(title_needle) < 0) { continue; }
    const handle = int_at(row, "handle");
    if (handle > 0) { return row; }
  }
  return null;
}

function assert_fixture_process_state(run_directory, executable, fixture_pid, env) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ], env);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_page_click_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_page_click_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row, env
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ], env);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_page_click_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_page_click_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_page_click_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function assert_no_cdp_listener(run_directory, executable, env, port) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "unused", "--selector", "#go",
  ], env);
  ensure(reply.ok !== true, "cu_linux_page_click_false_success:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_page_click_host_limit_code:" + JSON.stringify(reply)
  );
  const message = text_at(reply, "error.message");
  ensure(
    message.indexOf("no CDP listener") >= 0 && message.indexOf("" + port) >= 0,
    "cu_linux_page_click_host_limit_message:" + JSON.stringify(reply.error)
  );
}

function assert_page_click_miss_selector(run_directory, executable, env, port, target_id) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", target_id, "--selector", "#missing",
  ], env);
  ensure(!output_success(reply), "cu_linux_page_click_miss_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "cdp_node_not_found",
    "cu_linux_page_click_miss_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("#missing") >= 0,
    "cu_linux_page_click_miss_message:" + JSON.stringify(reply.error)
  );
}

function assert_page_click_miss_target(run_directory, executable, env, port) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", "deadbeef", "--selector", "#go",
  ], env);
  ensure(!output_success(reply), "cu_linux_page_click_miss_target_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "cdp_target_not_found",
    "cu_linux_page_click_miss_target_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("--target-id") >= 0,
    "cu_linux_page_click_miss_target_message:" + JSON.stringify(reply.error)
  );
}

function cdp_ready(run_directory, port) {
  const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  return probe.success === true && probe.stdout.indexOf("Browser") >= 0;
}

function page_target(rows) {
  for (const row of rows) {
    if (text_at(row, "type") === "page") { return row; }
  }
  return null;
}

function out_text(run_directory, executable, env, port, target_id) {
  const read = run_cu(run_directory, executable, "observe", [
    "page-js", "--port", "" + port, "--target-id", target_id,
    "--expression", "document.getElementById('out').textContent",
  ], env);
  return text_at(read, "data.value");
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "cu_linux_page_click_executable_missing:" + executable);
ensure(direct_file(abi_library), "cu_linux_page_click_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-page-click");
const run_directory = context.run_directory;
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_title = "CEO CDP Click " + context.run_id;
const fixture = rh.join(run_directory, "cdp-click.html");
const fixture_html = "<!DOCTYPE html><html><head><title>"
  + fixture_title + "</title></head><body>"
  + "<button id='go' type='button' aria-label='" + AT_SPI_PROBE_NAME + "'"
  + " onclick=\"document.getElementById('out').textContent='clicked'\">Go</button>"
  + "<p id='out'>idle</p>"
  + "</body></html>";
rh.write_text(fixture, fixture_html);

const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
const port = 9300 + (rh.pid() % 500);
let chrome_child = -1;
let succeeded = 0;
let failure = "";

try {
  const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  ensure(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
    "cu_linux_page_click_port_in_use:" + port);

  print("STEP typed usage limits reject missing node query or invalid coordinates before Chrome starts");
  assert_page_click_usage_limit(run_directory, executable, env, port);

  print("STEP page-click typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_page_click_usage_rejects_name(run_directory, executable, env, port);

  print("STEP page-click typed-fails no CDP listener on the owned free port before Chrome starts");
  assert_no_cdp_listener(run_directory, executable, env, port);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (command=usage) before process-state/desktop-state and page-js DOM read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and page-js DOM read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held (no atspi gating); process-state/desktop-state binding may be skipped when the owned Chrome window is not discoverable; page-click read-back still uses independent page-js DOM");
  }

  print("STEP launch owned Chrome with CDP port and a disposable file:// tab");
  chrome_child = harness.start({
    program: launcher,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--new-window",
      "about:blank",
    ],
    current_dir: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  for (let attempt = 0; attempt < 80 && !cdp_ready(run_directory, port); attempt = attempt + 1) {
    harness.sleep_ms(250);
  }
  ensure(cdp_ready(run_directory, port), "cu_linux_page_click_cdp_not_ready:" + port);

  print("STEP page-click typed-fails cdp_target_not_found for a bogus --target-id");
  assert_page_click_miss_target(run_directory, executable, env, port);

  const targets = run_cu(run_directory, executable, "observe", [
    "page-targets", "--port", "" + port,
  ], env);
  const target = page_target(targets.data.targets);
  ensure(target !== null && text_at(target, "id") !== "", "cu_linux_page_click_target_missing");
  const target_id = text_at(target, "id");

  print("STEP page-nav loads the disposable HTML fixture in this owned tab");
  const nav_url = "file://" + fixture;
  const nav = run_cu(run_directory, executable, "observe,actuate", [
    "page-nav", "--port", "" + port, "--target-id", target_id,
    "--url", nav_url, "--wait-ms", "10000",
  ], env);
  ensure(
    flag_at(nav, "data.verified") && text_at(nav, "data.final_title") === fixture_title,
    "cu_linux_page_click_nav:" + JSON.stringify(nav.data)
  );

  print("STEP wait for owned Chrome window before process-state/desktop-state and page-click actuate/read-back court");
  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "20000", "--window-title-contains", fixture_title,
  ], env);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_page_click_window_wait");

  let window_row = null;
  for (let attempt = 0; attempt < 40 && window_row === null; attempt = attempt + 1) {
    window_row = window_row_for_title(run_directory, executable, env, fixture_title);
    if (window_row === null) { harness.sleep_ms(250); }
  }
  ensure(window_row !== null, "cu_linux_page_click_window_missing:" + fixture_title);
  const window_handle = "" + int_at(window_row, "handle");
  const window_title = text_at(window_row, "title");
  const chrome_pid = int_at(window_row, "process_id");
  ensure(window_handle !== "" && window_handle !== "0",
    "cu_linux_page_click_window_handle:" + JSON.stringify(window_row));
  ensure(chrome_pid > 0, "cu_linux_page_click_chrome_pid:" + JSON.stringify(window_row));

  print("STEP process-state binds the owned Chrome pid before page-click actuate/read-back court");
  assert_fixture_process_state(run_directory, executable, chrome_pid, env);

  print("STEP desktop-state window row agrees with inventory before page-click actuate/read-back court");
  assert_fixture_desktop_state(
    run_directory, executable, chrome_pid, window_title, window_handle, window_row, env
  );

  if (atspi_available) {
    print("STEP unlock accessibility tree before named get-extents read-back court");
    const unlocked = run_cu(run_directory, executable, "observe,actuate", [
      "unlock", "--window", window_handle,
    ], env);
    ensure(flag_at(unlocked, "data.poked"), "cu_linux_page_click_unlock:" + JSON.stringify(unlocked.data));

    print("STEP get-extents typed-fail a11y_node_not_found when the named anchor is missing");
    assert_get_extents_missing_node(run_directory, executable, env, window_handle, "before_click");

    print("STEP independent pyatspi extents and CU get-extents --name agree before page-click actuate");
    assert_get_extents_agreement(
      run_directory, executable, env, window_handle, window_title, AT_SPI_PROBE_NAME
    );
  }

  print("STEP independent page-js baseline proves #out starts idle before the click");
  const before_text = out_text(run_directory, executable, env, port, target_id);
  ensure(
    before_text === "idle",
    "cu_linux_page_click_before:" + JSON.stringify({ text: before_text })
  );

  print("STEP page-click --selector #go actuates the named control (receipt not acceptance)");
  const clicked = run_cu(run_directory, executable, "observe,actuate", [
    "page-click", "--port", "" + port, "--target-id", target_id, "--selector", "#go",
  ], env);
  ensure(
    clicked.command === "page-click",
    "cu_linux_page_click_shape:" + JSON.stringify(clicked)
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-cdp-page-click");

  print("STEP independent page-js read-back proves the click mutated DOM state");
  let readback_text = "";
  for (let attempt = 0; attempt < 40 && readback_text !== "clicked"; attempt = attempt + 1) {
    readback_text = out_text(run_directory, executable, env, port, target_id);
    if (readback_text !== "clicked") { harness.sleep_ms(250); }
  }
  ensure(
    readback_text === "clicked",
    "cu_linux_page_click_readback:" + JSON.stringify({ expected: "clicked", text: readback_text })
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-cdp-page-click-readback");

  print("STEP typed miss path rejects a --selector that matches no rendered node");
  assert_page_click_miss_selector(run_directory, executable, env, port, target_id);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup: " + error); }
}

ensure(succeeded === 1, failure || "cu_linux_page_click_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux page-click usage/host-limit/miss honesty + process-state/desktop-state courts + independent page-js DOM read-back with typed page-click --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating) (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux page-click usage/host-limit/miss honesty + process-state/desktop-state courts + independent page-js DOM read-back with typed page-click --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating) when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
}
return;
