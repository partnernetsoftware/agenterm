// CEO: maximize/unmaximize --expect maximized|unmaximized on Linux.
// Acceptance is smoke read-back only: independent xprop _NET_WM_STATE and
// windows inventory maximized field must match --expect after each verb.
// Typed usage, destructive-gate refusals, missing-window and headless
// host-limit paths must hold before any owned fixture window exists.
// Typed maximize/unmaximize usage must reject AT-SPI --name; typed
// get-extents --name usage/host-limit paths must hold before the
// actuate/read-back court. AT-SPI/--name only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-maximize-expect-state",
];

const MISSING_HANDLE = "99999999";
const AT_SPI_PROBE_NAME = "Fixture Press";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_maximize_expect_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_maximize_expect_reply:" + JSON.stringify(document));
  return document;
}

function maximize_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["maximize"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_maximize_expect_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function unmaximize_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["unmaximize"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_maximize_expect_unmaximize_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function assert_maximize_usage_limit(run_directory, executable) {
  const maximize_zero = run_cu_reply(run_directory, executable, "actuate", [
    "maximize", "--window", "0", "--expect", "maximized",
  ]);
  ensure(!output_success(maximize_zero), "cu_linux_maximize_expect_usage_ok:" + JSON.stringify(maximize_zero));
  ensure(
    text_at(maximize_zero, "error.code") === "usage",
    "cu_linux_maximize_expect_usage_code:" + JSON.stringify(maximize_zero.error)
  );
  ensure(
    text_at(maximize_zero, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_maximize_expect_usage_message:" + JSON.stringify(maximize_zero.error)
  );

  const unmaximize_zero = run_cu_reply(run_directory, executable, "actuate", [
    "unmaximize", "--window", "0", "--expect", "unmaximized",
  ]);
  ensure(!output_success(unmaximize_zero), "cu_linux_maximize_expect_unmaximize_usage_ok:" + JSON.stringify(unmaximize_zero));
  ensure(
    text_at(unmaximize_zero, "error.code") === "usage",
    "cu_linux_maximize_expect_unmaximize_usage_code:" + JSON.stringify(unmaximize_zero.error)
  );
}

function assert_maximize_destructive_gate(run_directory, executable) {
  const missing_target = maximize_refused(
    run_directory, executable, ["--expect", "maximized"], "refused"
  );
  ensure(
    text_at(missing_target, "error.detail.reason") === "destructive_gate"
      && text_at(missing_target, "error.detail.effect") === "not_performed"
      && missing_target.error.detail.missing.length === 1
      && text_of(missing_target.error.detail.missing[0]) === "target",
    "cu_linux_maximize_expect_missing_target:" + JSON.stringify(missing_target)
  );

  const missing_postcondition = unmaximize_refused(
    run_directory, executable, ["--window", "1"], "refused"
  );
  ensure(
    text_at(missing_postcondition, "error.detail.reason") === "destructive_gate"
      && missing_postcondition.error.detail.missing.length === 1
      && text_of(missing_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_maximize_expect_missing_postcondition:" + JSON.stringify(missing_postcondition)
  );

  const wrong_postcondition = maximize_refused(
    run_directory, executable, ["--window", "1", "--expect", "unmaximized"], "refused"
  );
  ensure(
    text_at(wrong_postcondition, "error.detail.reason") === "destructive_gate"
      && wrong_postcondition.error.detail.missing.length === 1
      && text_of(wrong_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_maximize_expect_wrong_postcondition:" + JSON.stringify(wrong_postcondition)
  );

  const unmaximize_missing = unmaximize_refused(
    run_directory, executable, ["--expect", "unmaximized"], "refused"
  );
  ensure(
    text_at(unmaximize_missing, "error.detail.reason") === "destructive_gate"
      && unmaximize_missing.error.detail.missing.length === 1
      && text_of(unmaximize_missing.error.detail.missing[0]) === "target",
    "cu_linux_maximize_expect_unmaximize_missing_target:" + JSON.stringify(unmaximize_missing)
  );
}

function assert_maximize_missing_window(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "actuate", [
    "maximize", "--window", MISSING_HANDLE, "--expect", "maximized",
  ]);
  ensure(!output_success(reply), "cu_linux_maximize_expect_missing_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "window_op_failed",
    "cu_linux_maximize_expect_missing_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_maximize_expect_missing_effect:" + JSON.stringify(reply.error)
  );

  const unmaximize_reply = run_cu_reply(run_directory, executable, "actuate", [
    "unmaximize", "--window", MISSING_HANDLE, "--expect", "unmaximized",
  ]);
  ensure(!output_success(unmaximize_reply), "cu_linux_maximize_expect_unmaximize_missing_ok:" + JSON.stringify(unmaximize_reply));
  ensure(
    text_at(unmaximize_reply, "error.code") === "window_op_failed",
    "cu_linux_maximize_expect_unmaximize_missing_code:" + JSON.stringify(unmaximize_reply.error)
  );
  ensure(
    text_at(unmaximize_reply, "error.detail.effect") === "not_performed",
    "cu_linux_maximize_expect_unmaximize_missing_effect:" + JSON.stringify(unmaximize_reply.error)
  );
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_maximize_expect_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_maximize_unmaximize_atspi_name_usage(run_directory, executable) {
  const maximize_with_name = run_cu_reply(run_directory, executable, "actuate", [
    "maximize", "--window", "1", "--expect", "maximized", "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(
    !output_success(maximize_with_name),
    "cu_linux_maximize_expect_name_usage_ok:" + JSON.stringify(maximize_with_name)
  );
  ensure(
    text_at(maximize_with_name, "error.code") === "usage",
    "cu_linux_maximize_expect_name_usage_code:" + JSON.stringify(maximize_with_name.error)
  );
  ensure(
    text_at(maximize_with_name, "error.message").indexOf("--name") >= 0
      || text_at(maximize_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_maximize_expect_name_usage_message:" + JSON.stringify(maximize_with_name.error)
  );

  const unmaximize_with_name = run_cu_reply(run_directory, executable, "actuate", [
    "unmaximize", "--window", "1", "--expect", "unmaximized", "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(
    !output_success(unmaximize_with_name),
    "cu_linux_maximize_expect_unmaximize_name_usage_ok:" + JSON.stringify(unmaximize_with_name)
  );
  ensure(
    text_at(unmaximize_with_name, "error.code") === "usage",
    "cu_linux_maximize_expect_unmaximize_name_usage_code:" + JSON.stringify(unmaximize_with_name.error)
  );
  ensure(
    text_at(unmaximize_with_name, "error.message").indexOf("--name") >= 0
      || text_at(unmaximize_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_maximize_expect_unmaximize_name_usage_message:" + JSON.stringify(unmaximize_with_name.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(
    !output_success(zero_handle),
    "cu_linux_maximize_expect_extents_usage_ok:" + JSON.stringify(zero_handle)
  );
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_maximize_expect_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_maximize_expect_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(
    !output_success(reply),
    "cu_linux_maximize_expect_extents_unavailable_ok:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_maximize_expect_extents_unavailable_code:" + code
  );
}

function assert_headless_host_limit(run_directory, executable, verb, label) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    [verb, "--window", "1", "--expect", verb === "maximize" ? "maximized" : "unmaximized"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_maximize_expect_headless_ok_" + label + ":" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_maximize_expect_headless_code_" + label + ":" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("mechanism unavailable") >= 0
      || message.indexOf("agt_native_window_maximized") >= 0,
    "cu_linux_maximize_expect_headless_message_" + label + ":" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_maximize_expect_headless_effect_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_rows(reply) {
  const data = reply.data;
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  for (const row of window_rows(reply)) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_net_wm_maximized(run_directory, executable, handle) {
  const xprop = rh.command("xprop", ["-id", "" + handle, "_NET_WM_STATE"], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (!xprop.success) { return false; }
  const stdout = xprop.stdout;
  return stdout.indexOf("_NET_WM_STATE_MAXIMIZED_VERT") >= 0
    && stdout.indexOf("_NET_WM_STATE_MAXIMIZED_HORZ") >= 0;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-maximize-expect-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_maximize_expect_fixture_missing:" + fixture_source);

print("STEP maximize/unmaximize typed-fails usage when --window handle is zero");
assert_maximize_usage_limit(run_directory, executable);

print("STEP maximize/unmaximize typed-fails refused destructive_gate when target or postcondition is missing");
assert_maximize_destructive_gate(run_directory, executable);

print("STEP maximize/unmaximize typed-fails window_op_failed when handle is absent from inventory");
assert_maximize_missing_window(run_directory, executable);

print("STEP maximize/unmaximize without DISPLAY typed-fails unsupported host-limit");
assert_headless_host_limit(run_directory, executable, "maximize", "maximize");
assert_headless_host_limit(run_directory, executable, "unmaximize", "unmaximize");

print("STEP maximize/unmaximize typed-fail usage when AT-SPI --name is present");
assert_maximize_unmaximize_atspi_name_usage(run_directory, executable);

if (atspi_available) {
  print("STEP get-extents typed-fail invalid_input when --window is zero before actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);
} else {
  print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
}

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_maximize_expect_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_maximize_expect_window_missing");
  const handle = int_at(row, "handle");
  const handle_text = "" + handle;
  ensure(handle > 0, "cu_linux_maximize_expect_handle:" + JSON.stringify(row));
  ensure(
    flag_at(row, "maximized") === false,
    "cu_linux_maximize_expect_baseline_not_maximized:" + JSON.stringify(row)
  );
  ensure(
    independent_net_wm_maximized(run_directory, executable, handle) === false,
    "cu_linux_maximize_expect_baseline_xprop_not_maximized"
  );

  print("STEP destructive_gate refusals on a live handle must not change xprop or inventory");
  maximize_refused(
    run_directory, executable, ["--window", handle_text, "--expect", "unmaximized"], "refused"
  );
  unmaximize_refused(
    run_directory, executable, ["--window", handle_text, "--expect", "maximized"], "refused"
  );
  ensure(
    independent_net_wm_maximized(run_directory, executable, handle) === false,
    "cu_linux_maximize_expect_refusal_xprop_changed"
  );
  const refusal_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(refusal_row !== null, "cu_linux_maximize_expect_refusal_row_missing");
  ensure(
    flag_at(refusal_row, "maximized") === false,
    "cu_linux_maximize_expect_refusal_inventory_changed:" + JSON.stringify(refusal_row)
  );

  print("STEP maximize --window " + handle_text + " --expect maximized");
  const maximized = run_cu(run_directory, executable, "actuate", [
    "maximize", "--window", handle_text, "--expect", "maximized",
  ]);
  ensure(
    flag_at(maximized, "data.verified")
      && flag_at(maximized, "data.after.maximized") === true,
    "cu_linux_maximize_expect_reply_maximized:" + JSON.stringify(maximized.data)
  );

  print("STEP independent xprop _NET_WM_STATE read-back: maximized must be true");
  ensure(
    independent_net_wm_maximized(run_directory, executable, handle) === true,
    "cu_linux_maximize_expect_xprop_maximized"
  );

  print("STEP independent windows inventory read-back: maximized must be true");
  const maximized_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(maximized_row !== null, "cu_linux_maximize_expect_maximized_row_missing");
  ensure(
    flag_at(maximized_row, "maximized") === true,
    "cu_linux_maximize_expect_inventory_maximized:" + JSON.stringify(maximized_row)
  );

  print("STEP unmaximize --window " + handle_text + " --expect unmaximized");
  const unmaximized = run_cu(run_directory, executable, "actuate", [
    "unmaximize", "--window", handle_text, "--expect", "unmaximized",
  ]);
  ensure(
    flag_at(unmaximized, "data.verified")
      && flag_at(unmaximized, "data.after.maximized") === false,
    "cu_linux_maximize_expect_reply_unmaximized:" + JSON.stringify(unmaximized.data)
  );

  print("STEP independent xprop _NET_WM_STATE read-back: maximized must be false");
  ensure(
    independent_net_wm_maximized(run_directory, executable, handle) === false,
    "cu_linux_maximize_expect_xprop_unmaximized"
  );

  print("STEP independent windows inventory read-back: maximized must be false");
  const restored_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(restored_row !== null, "cu_linux_maximize_expect_unmaximized_row_missing");
  ensure(
    flag_at(restored_row, "maximized") === false,
    "cu_linux_maximize_expect_inventory_unmaximized:" + JSON.stringify(restored_row)
  );
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-maximize-expect");
harness.emit_evidence(context, declared_evidence, "cu.linux-maximize-expect-state");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux maximize/unmaximize usage/host-limit/miss honesty + independent xprop and windows inventory maximized read-back with typed maximize/unmaximize/get-extents usage honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux maximize/unmaximize usage/host-limit/miss honesty + independent xprop and windows inventory maximized read-back with typed maximize/unmaximize/get-extents host-limit honesty (AT-SPI --name, no --coords)");
}
return;
