// Prove theme preview, keyboard rollback, persistence, PTY continuity, and
// visibly distinct native rendering through public AgenTerm interfaces.
//
// Args:
//   --list-evidence
// or:
//   REPO GUI_EXE CLI_EXE [--internal-failure-bundle-probe]
//
// Ported from scripts/rh/theme-smoke.rh; runs under `--profile tool`. The
// GUI is a long-lived door handle (process_spawn) polled through the public
// CLI and reaped by process_wait; rh's `child.state` / `wait_with_output`
// are `harness.state` / `harness.wait` here.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

// A door wall this port cannot route around without changing what is
// proven. The site throws with the rh spelling so the run fails closed.
function gap(what) {
  throw "qjs_gap:" + what;
}

// rh's `"" + json_null` is "" while JS's `"" + null` is "null"; the theme
// assertions compare absent drafts and modal kinds against "".
function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function field_text(object, key) {
  if (object === undefined || object === null) { return ""; }
  return text_of(object[key]);
}

function parent_dir(p) {
  // No `s[i]` in this engine: split on the separator and drop the last piece.
  const parts = p.split("/");
  while (parts.length > 0 && parts[parts.length - 1] === "") { parts.pop(); }
  if (parts.length <= 1) { return p.startsWith("/") ? "/" : ""; }
  parts.pop();
  let joined = "";
  let first = true;
  for (const piece of parts) {
    joined = first ? piece : joined + "/" + piece;
    first = false;
  }
  return joined === "" ? "/" : joined;
}

// No `"" + output.stdout` copies here: in this engine a concat costs steps
// per character, and a 13 KB snapshot copy is as dear as its parse.
function json_cli(context, cli, args) {
  const output = harness.invoke_cli_bounded(context, cli, args, 0, []);
  return JSON.parse(output.stdout);
}

function text_cli(context, cli, args) {
  const output = harness.invoke_cli_bounded(context, cli, args, 0, []);
  return output.stdout;
}

function wait_for_server(context, cli, gui_child) {
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    const probe = harness.run_cli_bounded(context, cli, ["ui-snapshot"], 0, []);
    if (probe.success) { return 0; }
    if (harness.state(gui_child) === "exited") {
      const output = harness.wait(gui_child, 2000);
      harness.require(false, "theme_gui_early_exit:" + output.stderr);
    }
    harness.sleep_ms(50);
  }
  harness.require(false, "theme_server_timeout");
  return 0;
}

function wait_for_server_stop(context, cli) {
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    const probe = harness.run_cli_bounded(context, cli, ["ui-snapshot"], 1, []);
    const output_text = "" + probe.stdout + probe.stderr;
    const stopped = "AgenTerm server is not running";
    if (!probe.success && output_text.includes(stopped)) { return 0; }
    harness.sleep_ms(25);
  }
  harness.require(false, "theme_server_stop_timeout");
  return 0;
}

function wait_for_exit(child, code) {
  for (let attempt = 0; attempt < 100; attempt = attempt + 1) {
    if (harness.state(child) === "exited") {
      return harness.wait(child, 2000);
    }
    harness.sleep_ms(50);
  }
  harness.require(false, code);
  return harness.wait(child, 2000);
}

function start_gui(context, gui, cli) {
  const gui_args = ["--no-activate", "--address", context.address];
  const spec = harness.configured_spec(context, gui, gui_args);
  const child = harness.start(spec);
  wait_for_server(context, cli, child);
  // Window readiness is owned by wait-ui below (rh's note: Child.platform_facts
  // was never native-emitted, and the door has no such fact either).
  const snapshot = json_cli(
    context,
    cli,
    ["wait-ui", "--window-state", "restored", "--timeout-ms", "30000"]
  );
  // rh compared against `child.id`; the door has no pid for a handle, so the
  // witness is the host's own process table (see test_harness).
  const witness_pid = harness.spawned_pid_witness(gui, gui_args);
  harness.require(
    witness_pid > 0 && snapshot.client_pid === witness_pid,
    "theme_ui_lease_wrong_process"
  );
  return child;
}

function only_tab(context, cli) {
  const snapshot = json_cli(context, cli, ["ui-snapshot"]);
  harness.require(snapshot.tabs.length === 1, "theme_expected_one_tab");
  return snapshot.tabs[0];
}

function only_pane(context, cli, target) {
  const snapshot = json_cli(context, cli, ["pane-snapshot", "-t", target]);
  harness.require(snapshot.windows.length === 1, "theme_expected_one_pane");
  return snapshot.windows[0];
}

function derived_color_theme(preset_id) {
  const preset = "" + preset_id;
  let theme = "dark";
  if (preset.endsWith("-day")) { theme = "light"; }
  return theme;
}

function theme_option_accent(snapshot, id) {
  const option_id = "" + id;
  for (const option of snapshot.settings.theme_options) {
    if (option.id === option_id) { return "" + option.accent; }
  }
  throw "theme_option_missing:" + id;
}

function assert_theme_options(snapshot) {
  const expected = ["classic-day", "classic-night", "fancy-day", "fancy-night"];
  harness.require(
    snapshot.settings.theme_options.length === 4,
    "theme_options_count_mismatch"
  );
  for (const id of expected) {
    let found = 0;
    for (const option of snapshot.settings.theme_options) {
      if (option.id === id && option.label !== "" && option.description !== "") {
        found = 1;
      }
    }
    harness.require(found !== 0, "theme_option_missing:" + id);
  }
  harness.require(
    theme_option_accent(snapshot, "classic-day")
      !== theme_option_accent(snapshot, "fancy-day"),
    "fancy_classic_accent_not_distinct"
  );
  let fancy_metrics_ok = 0;
  for (const option of snapshot.settings.theme_options) {
    if (option.id === "fancy-day") {
      if (option.metrics !== undefined && option.metrics !== null
          && option.metrics.corner_radius_control_px > 0) {
        fancy_metrics_ok = 1;
      }
    }
  }
  harness.require(fancy_metrics_ok !== 0, "fancy_metrics_missing");
}

function assert_theme_open(snapshot, saved_preset, draft) {
  const saved = "" + saved_preset;
  const draft_text = "" + draft;
  harness.require(
    snapshot.settings.appearance_preset === saved,
    "appearance_preset_saved_mismatch"
  );
  harness.require(
    snapshot.settings.color_theme === derived_color_theme(saved),
    "color_theme_saved_mismatch"
  );
  assert_theme_options(snapshot);
  const modal_kind = field_text(snapshot.modal, "kind");
  const theme_draft = field_text(snapshot.settings, "theme_draft");
  const appearance_draft = field_text(snapshot.settings, "appearance_preset_draft");
  harness.require(
    modal_kind === "settings"
      && theme_draft === draft_text
      && appearance_draft === draft_text,
    "theme_open_draft_mismatch"
  );
}

function assert_theme_closed(snapshot, saved_preset) {
  const saved = "" + saved_preset;
  harness.require(
    snapshot.settings.appearance_preset === saved,
    "appearance_preset_saved_mismatch"
  );
  harness.require(
    snapshot.settings.color_theme === derived_color_theme(saved),
    "color_theme_saved_mismatch"
  );
  assert_theme_options(snapshot);
  const modal_kind = field_text(snapshot.modal, "kind");
  const theme_draft = field_text(snapshot.settings, "theme_draft");
  const appearance_draft = field_text(snapshot.settings, "appearance_preset_draft");
  harness.require(
    modal_kind === "" && theme_draft === "" && appearance_draft === "",
    "theme_expected_closed"
  );
}

function retain_failure_snapshot(context, cli) {
  rh.create_dir_all(context.failure_directory);
  const output = harness.run_cli_bounded(context, cli, ["ui-snapshot"], 0, []);
  rh.atomic_write(
    rh.join(context.failure_directory, "ui-snapshot.txt"),
    "exit_code=" + output.exit_code + "\n" + output.stdout + output.stderr
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  print("ux.theme-settings");
  return;
}

harness.require(
  args.length === 3
    || (args.length === 4 && args[3] === "--internal-failure-bundle-probe"),
  "expected: REPO GUI_EXE CLI_EXE [--internal-failure-bundle-probe]"
);
const repo = rh.absolute(args[0]);
const gui = rh.absolute(args[1]);
const cli = rh.absolute(args[2]);
harness.require(rh.exists(gui), "theme_gui_missing");
harness.require(rh.exists(cli), "theme_cli_missing");
let internal_failure_probe = 0;
if (args.length === 4) { internal_failure_probe = 1; }

const context = harness.new_context(repo, "theme");
const night_png = rh.join(context.run_directory, "evidence/theme-classic-night.png");
const day_png = rh.join(context.run_directory, "evidence/theme-classic-day.png");
const fancy_day_png = rh.join(context.run_directory, "evidence/theme-fancy-day.png");
let succeeded = 0;
let failure = "";

try {
  print("STEP legacy color_theme migrates to classic-day on restart");
  rh.create_dir_all(parent_dir(context.settings_path));
  rh.atomic_write(
    context.settings_path,
    "{\"color_theme\":\"light\",\"terminal_font_size\":14}\n"
  );
  const migration_gui = start_gui(context, gui, cli);
  assert_theme_closed(json_cli(context, cli, ["ui-snapshot"]), "classic-day");
  text_cli(context, cli, ["ui-action", "close-window"]);
  text_cli(context, cli, ["ui-action", "stop-server-and-exit"]);
  wait_for_exit(migration_gui, "theme_migration_gui_exit_timeout");
  wait_for_server_stop(context, cli);
  const migrated = rh.parse_file(context.settings_path);
  harness.require(
    migrated.appearance_preset === "classic-day",
    "legacy_light_migration_failed"
  );

  print("STEP launch isolated classic-night workspace and keep a PTY active");
  rh.atomic_write(context.settings_path, "{\"appearance_preset\":\"classic-night\"}\n");
  const first_gui = start_gui(context, gui, cli);
  const tab = only_tab(context, cli);
  const tab_id = "" + tab.id;
  json_cli(
    context,
    cli,
    ["wait-ui", "-t", tab_id, "--tab-state", "running", "--timeout-ms", "30000"]
  );
  if (internal_failure_probe !== 0) {
    harness.require(false, "INTERNAL_FAILURE_BUNDLE_PROBE:gui:" + context.run_id);
  }
  const pane_before = only_pane(context, cli, tab_id);
  const token_before = "AGENTERM_THEME_BEFORE_" + rh.pid();
  text_cli(context, cli, ["send-keys", "-t", tab_id, "echo " + token_before, "Enter"]);
  text_cli(
    context,
    cli,
    ["wait-pane", "-t", tab_id, "--contains", token_before,
     "--submit-complete", "--timeout-ms", "30000"]
  );

  print("STEP preview all four presets through public ui-actions");
  text_cli(context, cli, ["ui-action", "open-settings"]);
  assert_theme_open(json_cli(context, cli, ["ui-snapshot"]), "classic-night", "classic-night");
  text_cli(context, cli, ["ui-action", "settings-preset-classic-day"]);
  text_cli(context, cli, ["ui-action", "settings-preset-classic-night"]);
  text_cli(context, cli, ["ui-action", "settings-preset-fancy-day"]);
  text_cli(context, cli, ["ui-action", "settings-preset-fancy-night"]);
  text_cli(context, cli, ["ui-action", "settings-theme-light"]);
  text_cli(context, cli, ["ui-action", "settings-theme-dark"]);
  const fancy_snapshot = json_cli(context, cli, ["ui-snapshot"]);
  assert_theme_open(fancy_snapshot, "classic-night", "classic-night");

  print("STEP native classic-day preview and Cancel rollback");
  text_cli(context, cli, ["ui-action", "open-settings"]);
  assert_theme_open(json_cli(context, cli, ["ui-snapshot"]), "classic-night", "classic-night");
  text_cli(context, cli, ["screenshot", "-o", night_png]);
  const preview_snapshot = json_cli(context, cli, ["ui-action", "settings-preset-classic-day"]);
  assert_theme_open(preview_snapshot, "classic-night", "classic-day");
  text_cli(context, cli, ["screenshot", "-o", day_png]);
  const cancelled_snapshot = json_cli(context, cli, ["ui-action", "cancel"]);
  assert_theme_closed(cancelled_snapshot, "classic-night");

  print("STEP Escape rolls a second classic-day preview back");
  text_cli(context, cli, ["ui-action", "open-settings"]);
  const second_preview = json_cli(context, cli, ["ui-action", "settings-preset-classic-day"]);
  assert_theme_open(second_preview, "classic-night", "classic-day");
  // rh: `first_gui.window_key("Escape")` -- a native key into the GUI window.
  // The door has no window-input operation; sending `ui-action cancel`
  // instead would prove the public action, not the keyboard rollback.
  gap("window_key(Escape): the door has no native window input for a spawned handle");
  const escaped_snapshot = json_cli(
    context,
    cli,
    ["wait-ui", "--window-state", "restored", "--modal-kind", "none", "--timeout-ms", "30000"]
  );
  assert_theme_closed(escaped_snapshot, "classic-night");

  print("STEP native Apply persists classic-day without interrupting the PTY");
  text_cli(context, cli, ["ui-action", "open-settings"]);
  text_cli(context, cli, ["ui-action", "settings-preset-classic-day"]);
  const applied_snapshot = json_cli(context, cli, ["ui-action", "settings-apply"]);
  assert_theme_closed(applied_snapshot, "classic-day");
  const persisted = rh.parse_file(context.settings_path);
  harness.require(
    persisted.appearance_preset === "classic-day",
    "theme_apply_not_persisted"
  );

  print("STEP fancy-day palette differs from classic-day in snapshot and rendering");
  text_cli(context, cli, ["ui-action", "open-settings"]);
  text_cli(context, cli, ["ui-action", "settings-preset-fancy-day"]);
  text_cli(context, cli, ["screenshot", "-o", fancy_day_png]);
  const fancy_preview = json_cli(context, cli, ["ui-snapshot"]);
  assert_theme_open(fancy_preview, "classic-day", "fancy-day");
  harness.require(
    theme_option_accent(fancy_preview, "fancy-day")
      !== theme_option_accent(fancy_preview, "classic-day"),
    "fancy_preview_accent_not_distinct"
  );
  text_cli(context, cli, ["ui-action", "settings-apply"]);
  const fancy_applied = json_cli(context, cli, ["ui-snapshot"]);
  assert_theme_closed(fancy_applied, "fancy-day");
  const fancy_persisted = rh.parse_file(context.settings_path);
  harness.require(
    fancy_persisted.appearance_preset === "fancy-day",
    "fancy_apply_not_persisted"
  );
  // rh: `rh::image::inspect_png(path)` -> {width, height, luminance}. Binary
  // bytes cannot cross the text door and it carries no image operation.
  gap("image_inspect_png: the door has no PNG inspection (" + day_png + ", " + fancy_day_png + ")");
  const token_after = "AGENTERM_THEME_AFTER_" + rh.pid();
  text_cli(context, cli, ["send-keys", "-t", tab_id, "echo " + token_after, "Enter"]);
  text_cli(
    context,
    cli,
    ["wait-pane", "-t", tab_id, "--contains", token_after,
     "--submit-complete", "--timeout-ms", "30000"]
  );
  const pane_after = only_pane(context, cli, tab_id);
  const capture = text_cli(context, cli, ["capture-pane", "-p", "-t", tab_id]);
  harness.require(
    pane_after.pid === pane_before.pid
      && !pane_after.dead
      && pane_after.output_bytes >= pane_before.output_bytes
      && capture.includes(token_before)
      && capture.includes(token_after),
    "theme_pty_interrupted"
  );

  print("STEP classic-day and classic-night previews have distinct rendered pixels");
  harness.require(
    rh.metadata(night_png).len >= 1000 && rh.metadata(day_png).len >= 1000,
    "theme_screenshot_too_small"
  );
  gap("image_inspect_png: the door has no PNG inspection (" + night_png + ", " + day_png + ")");

  print("STEP saved fancy-day survives shutdown and restart");
  text_cli(context, cli, ["ui-action", "close-window"]);
  text_cli(context, cli, ["ui-action", "stop-server-and-exit"]);
  wait_for_exit(first_gui, "theme_first_gui_exit_timeout");
  wait_for_server_stop(context, cli);

  const second_gui = start_gui(context, gui, cli);
  const restored = only_tab(context, cli);
  const restored_id = "" + restored.id;
  json_cli(
    context,
    cli,
    ["wait-ui", "-t", restored_id, "--tab-state", "running", "--timeout-ms", "30000"]
  );
  assert_theme_closed(json_cli(context, cli, ["ui-snapshot"]), "fancy-day");

  text_cli(context, cli, ["ui-action", "close-window"]);
  text_cli(context, cli, ["ui-action", "stop-server-and-exit"]);
  wait_for_exit(second_gui, "theme_second_gui_exit_timeout");
  wait_for_server_stop(context, cli);

  harness.emit_evidence(context, ["ux.theme-settings"], "ux.theme-settings");
  print(
    "PASS: theme preview, rollback, persistence, PTY continuity, "
      + "migration, and rendering"
  );
  succeeded = 1;
} catch (error) {
  failure = "" + error;
  retain_failure_snapshot(context, cli);
}

let completion_failure = "";
try {
  harness.complete(context, [], succeeded !== 0, failure);
} catch (error) {
  completion_failure = "" + error;
}
if (succeeded !== 0 && completion_failure === "") {
  harness.remove_run(context);
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
