// CEO: Linux focused honesty with independent pyatspi STATE_FOCUSED read-back.
// Acceptance is smoke read-back only: after focus --name actuation, CU
// focused --window, the actuation target, and an independent AT-SPI deepest
// STATE_FOCUSED node (name + role) must agree. Typed focused and focus
// usage must reject AT-SPI --name, --coords, --bogus, and other unexpected
// arguments (usage_rejects_unexpected); typed get-extents --name usage AND
// host-limit paths must both hold before the focused observe/read-back
// court, including get-extents --coords/--bogus command=usage honesty.
// Focus --coords/--bogus must reject as command=usage or stay
// accessibility-tree --name. Focused/focus/get-extents host-limit paths
// must hold on an invalid AT-SPI bus (and when the independent pyatspi
// desktop probe is unavailable). Prefer host-limit clarity over fake
// success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-focused-readback",
];

const FOCUS_CASES = [
  { label: "entry", name: "Fixture Entry" },
  { label: "button", name: "Fixture Press" },
];

const AT_SPI_PROBE_NAME = FOCUS_CASES[0].name;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function normalize_role(role) {
  return ("" + role).trim().toLowerCase().split("_").join(" ");
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function last_json_line(text) {
  const lines = text.trim().split("\n");
  for (let index = lines.length - 1; index >= 0; index = index - 1) {
    const line = lines[index].trim();
    if (line !== "") { return JSON.parse(line); }
  }
  throw "cu_linux_focused_honesty_missing_json";
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_focused_honesty_cli:" + output.stdout + output.stderr);
  return last_json_line(output.stdout);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_focused_honesty_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_focused_honesty_extents_cli:" + output.stderr);
  return last_json_line(trimmed);
}

function probe_atspi_available() {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(""),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function invalid_atspi_env(executable) {
  return {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
}

function assert_host_limit_code(code, allow_focus_unavailable, label, reply) {
  const allowed = code === "a11y_backend_failed"
    || code === "unsupported"
    || code === "bad_handle"
    || code === "a11y_node_not_found"
    || (allow_focus_unavailable && code === "a11y_focus_unavailable");
  ensure(allowed, label + ":" + code + ":" + JSON.stringify(reply.error));
  if (code === "a11y_backend_failed") {
    const message = text_at(reply, "error.message").toLowerCase();
    ensure(
      message.indexOf("accessibility") >= 0
        || message.indexOf("address") >= 0
        || message.indexOf("bus") >= 0,
      label + "_message:" + JSON.stringify(reply.error)
    );
  }
}

function assert_focused_usage_limit(run_directory, executable) {
  const missing_window = run_cu_reply(run_directory, executable, "observe", [
    "focused",
  ]);
  ensure(!output_success(missing_window), "cu_linux_focused_honesty_missing_window_ok:" + JSON.stringify(missing_window));
  ensure(
    text_at(missing_window, "error.code") === "usage",
    "cu_linux_focused_honesty_missing_window_code:" + JSON.stringify(missing_window.error)
  );
  ensure(
    text_at(missing_window, "error.message").indexOf("--window") >= 0,
    "cu_linux_focused_honesty_missing_window_message:" + JSON.stringify(missing_window.error)
  );

  const zero_handle = run_cu_reply(run_directory, executable, "observe", [
    "focused", "--window", "0",
  ]);
  ensure(!output_success(zero_handle), "cu_linux_focused_honesty_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "usage",
    "cu_linux_focused_honesty_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_focused_honesty_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const with_name = run_cu_reply(run_directory, executable, "observe", [
    "focused", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(!output_success(with_name), "cu_linux_focused_honesty_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_focused_honesty_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_focused_honesty_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_name, "error.message"), "--name"),
    "cu_linux_focused_honesty_name_message:" + JSON.stringify(with_name.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, "observe", [
    "focused", "--window", "1", "--bogus",
  ]);
  ensure(!output_success(with_bogus), "cu_linux_focused_honesty_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_focused_honesty_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_focused_honesty_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_focused_honesty_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_coords = run_cu_reply(run_directory, executable, "observe", [
    "focused", "--window", "1", "--coords", "10,10",
  ]);
  ensure(!output_success(with_coords), "cu_linux_focused_honesty_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_focused_honesty_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_focused_honesty_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_focused_honesty_coords_message:" + JSON.stringify(with_coords.error)
  );
}

function assert_focus_usage_limit(run_directory, executable) {
  const missing_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "1",
  ]);
  ensure(!output_success(missing_name), "cu_linux_focused_honesty_focus_usage_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_focused_honesty_focus_usage_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_focused_honesty_focus_usage_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0
      || text_at(missing_name, "error.message").indexOf("--node") >= 0,
    "cu_linux_focused_honesty_focus_usage_message:" + JSON.stringify(missing_name.error)
  );

  const zero_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(!output_success(zero_handle), "cu_linux_focused_honesty_focus_zero_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_focused_honesty_focus_zero_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_focused_honesty_focus_zero_message:" + JSON.stringify(zero_handle.error)
  );

  const name_without_window = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(
    !output_success(name_without_window),
    "cu_linux_focused_honesty_focus_name_only_ok:" + JSON.stringify(name_without_window)
  );
  ensure(
    text_at(name_without_window, "error.code") === "invalid_input",
    "cu_linux_focused_honesty_focus_name_only_code:" + JSON.stringify(name_without_window.error)
  );
  ensure(
    text_at(name_without_window, "error.message").indexOf("window") >= 0,
    "cu_linux_focused_honesty_focus_name_only_message:" + JSON.stringify(name_without_window.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_focused_honesty_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_focused_honesty_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_focused_honesty_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_focused_honesty_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_focused_honesty_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_focused_honesty_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_focused_honesty_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords), "cu_linux_focused_honesty_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_focused_honesty_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_focused_honesty_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_focused_honesty_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus), "cu_linux_focused_honesty_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_focused_honesty_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_focused_honesty_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_focused_honesty_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], invalid_atspi_env(executable));
  ensure(!output_success(reply), "cu_linux_focused_honesty_extents_unavailable_ok:" + JSON.stringify(reply));
  assert_host_limit_code(
    text_at(reply, "error.code"),
    false,
    "cu_linux_focused_honesty_extents_unavailable_code",
    reply
  );
}

function assert_focused_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "focused", "--window", "1",
  ], invalid_atspi_env(executable));
  ensure(!output_success(reply), "cu_linux_focused_honesty_unavailable_ok:" + JSON.stringify(reply));
  assert_host_limit_code(
    text_at(reply, "error.code"),
    true,
    "cu_linux_focused_honesty_unavailable_code",
    reply
  );
}

function assert_focus_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], invalid_atspi_env(executable));
  ensure(!output_success(reply), "cu_linux_focused_honesty_focus_unavailable_ok:" + JSON.stringify(reply));
  assert_host_limit_code(
    text_at(reply, "error.code"),
    false,
    "cu_linux_focused_honesty_focus_unavailable_code",
    reply
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_focus_probe_script() {
  return [
    "import json, sys",
    "import pyatspi",
    "",
    "title = json.loads(sys.argv[1])['title']",
    "",
    "def node_role(obj):",
    "    try:",
    "        rn = obj.getRoleName()",
    "        if rn and rn.strip(): return rn",
    "    except Exception: pass",
    "    return pyatspi.role.getName(obj.getRole()).lower()",
    "",
    "def node_name(obj):",
    "    try: return obj.name or ''",
    "    except Exception: return ''",
    "",
    "def find_frame():",
    "    desktop = pyatspi.Registry.getDesktop(0)",
    "    for index in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(index)",
    "        if app is None:",
    "            continue",
    "        for child_index in range(app.childCount):",
    "            window = app.getChildAtIndex(child_index)",
    "            if window is not None and (window.name or '') == title:",
    "                return window",
    "    return None",
    "",
    "def deepest_focused(root):",
    "    candidates = []",
    "    def walk(obj, depth):",
    "        try:",
    "            focused = obj.getState().contains(pyatspi.STATE_FOCUSED)",
    "        except Exception:",
    "            focused = False",
    "        if focused:",
    "            candidates.append((depth, obj))",
    "        for index in range(obj.childCount):",
    "            child = obj.getChildAtIndex(index)",
    "            if child is not None:",
    "                walk(child, depth + 1)",
    "    walk(root, 0)",
    "    if not candidates:",
    "        raise SystemExit('cu_linux_focused_probe_missing')",
    "    candidates.sort(key=lambda item: item[0], reverse=True)",
    "    node = candidates[0][1]",
    "    return {'name': node_name(node), 'role': node_role(node)}",
    "",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_focused_probe_window_missing')",
    "print(json.dumps(deepest_focused(frame)))",
  ].join("\n");
}

function independent_focus_probe(run_directory, executable, fixture_title) {
  const output = rh.command("python3", [
    "-c", independent_focus_probe_script(),
    JSON.stringify({ title: fixture_title }),
  ], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_focused_probe:" + output.stderr + output.stdout);
  const document = JSON.parse(output.stdout.trim());
  ensure(typeof document.name === "string", "cu_linux_focused_probe_name");
  ensure(typeof document.role === "string", "cu_linux_focused_probe_role");
  return document;
}

function assert_get_extents_reject_coords_or_stay_named(
  run_directory, executable, handle, node_name, label
) {
  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "" + handle, "--name", node_name, "--coords", "10,10",
  ]);
  if (!output_success(extents_coords)) {
    ensure(
      text_at(extents_coords, "error.code") === "usage",
      "cu_linux_focused_honesty_extents_coords_code_" + label + ":" + JSON.stringify(extents_coords.error)
    );
    ensure(
      text_at(extents_coords, "command") === "usage",
      "cu_linux_focused_honesty_extents_coords_command_" + label + ":" + JSON.stringify(extents_coords)
    );
    ensure(
      usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
        || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
      "cu_linux_focused_honesty_extents_coords_message_" + label + ":" + JSON.stringify(extents_coords.error)
    );
  } else {
    ensure(
      text_at(extents_coords, "data.addressing") === "accessibility-tree"
        && text_at(extents_coords, "data.matched.name") === node_name,
      "cu_linux_focused_honesty_extents_coords_named_" + label + ":" + JSON.stringify(extents_coords.data)
    );
  }

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "" + handle, "--name", node_name, "--bogus",
  ]);
  if (!output_success(extents_bogus)) {
    ensure(
      text_at(extents_bogus, "error.code") === "usage",
      "cu_linux_focused_honesty_extents_bogus_code_" + label + ":" + JSON.stringify(extents_bogus.error)
    );
    ensure(
      text_at(extents_bogus, "command") === "usage",
      "cu_linux_focused_honesty_extents_bogus_command_" + label + ":" + JSON.stringify(extents_bogus)
    );
    ensure(
      usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
        || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
      "cu_linux_focused_honesty_extents_bogus_message_" + label + ":" + JSON.stringify(extents_bogus.error)
    );
  } else {
    ensure(
      text_at(extents_bogus, "data.addressing") === "accessibility-tree"
        && text_at(extents_bogus, "data.matched.name") === node_name,
      "cu_linux_focused_honesty_extents_bogus_named_" + label + ":" + JSON.stringify(extents_bogus.data)
    );
  }
}

function assert_focus_reject_coords_or_stay_named(
  run_directory, executable, handle, focus_name, label
) {
  const focus_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", handle, "--name", focus_name, "--coords", "10,10",
  ]);
  if (!output_success(focus_coords)) {
    ensure(
      text_at(focus_coords, "error.code") === "usage",
      "cu_linux_focused_honesty_focus_coords_code_" + label + ":" + JSON.stringify(focus_coords.error)
    );
    ensure(
      text_at(focus_coords, "command") === "usage",
      "cu_linux_focused_honesty_focus_coords_command_" + label + ":" + JSON.stringify(focus_coords)
    );
    ensure(
      usage_rejects_unexpected(text_at(focus_coords, "error.message"), "--coords"),
      "cu_linux_focused_honesty_focus_coords_message_" + label + ":" + JSON.stringify(focus_coords.error)
    );
  } else {
    ensure(
      text_at(focus_coords, "data.addressing") === "accessibility-tree"
        && text_at(focus_coords, "data.matched.name") === focus_name,
      "cu_linux_focused_honesty_focus_coords_named_" + label + ":" + JSON.stringify(focus_coords.data)
    );
  }

  const focus_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", handle, "--name", focus_name, "--bogus",
  ]);
  if (!output_success(focus_bogus)) {
    ensure(
      text_at(focus_bogus, "error.code") === "usage",
      "cu_linux_focused_honesty_focus_bogus_code_" + label + ":" + JSON.stringify(focus_bogus.error)
    );
    ensure(
      text_at(focus_bogus, "command") === "usage",
      "cu_linux_focused_honesty_focus_bogus_command_" + label + ":" + JSON.stringify(focus_bogus)
    );
    ensure(
      usage_rejects_unexpected(text_at(focus_bogus, "error.message"), "--bogus"),
      "cu_linux_focused_honesty_focus_bogus_message_" + label + ":" + JSON.stringify(focus_bogus.error)
    );
  } else {
    ensure(
      text_at(focus_bogus, "data.addressing") === "accessibility-tree"
        && text_at(focus_bogus, "data.matched.name") === focus_name,
      "cu_linux_focused_honesty_focus_bogus_named_" + label + ":" + JSON.stringify(focus_bogus.data)
    );
  }
}

function assert_focused_agreement(
  run_directory, executable, handle, fixture_title, focus_name, label
) {
  print("STEP get-extents --name " + focus_name + " with --coords/--bogus rejects as command=usage or stays accessibility-tree before focused read-back");
  assert_get_extents_reject_coords_or_stay_named(run_directory, executable, handle, focus_name, label);

  print("STEP focus --name " + focus_name + " with --coords/--bogus rejects as command=usage or stays accessibility-tree before focused read-back");
  assert_focus_reject_coords_or_stay_named(run_directory, executable, handle, focus_name, label);

  print("STEP focus --name " + focus_name + " then compare CU focused with pyatspi STATE_FOCUSED");
  const focused_act = run_cu(run_directory, executable, "observe,actuate", [
    "focus", "--window", handle, "--name", focus_name,
  ]);
  ensure(
    flag_at(focused_act, "data.verified")
      && text_at(focused_act, "data.addressing") === "accessibility-tree",
    "cu_linux_focused_honesty_focus_verified_" + label + ":" + JSON.stringify(focused_act.data)
  );
  const matched_name = text_at(focused_act, "data.matched.name");
  ensure(
    matched_name === focus_name,
    "cu_linux_focused_honesty_focus_matched_" + label + ":" + JSON.stringify(focused_act.data)
  );

  const cu_focused = run_cu(run_directory, executable, "observe", [
    "focused", "--window", handle,
  ]);
  ensure(
    text_at(cu_focused, "data.addressing") === "focused-control"
      && text_at(cu_focused, "data.backend") === "at-spi2",
    "cu_linux_focused_honesty_shape_" + label + ":" + JSON.stringify(cu_focused.data)
  );

  const cu_name = text_at(cu_focused, "data.node.name");
  const cu_role = normalize_role(text_at(cu_focused, "data.node.role"));
  const probe = independent_focus_probe(run_directory, executable, fixture_title);
  const probe_role = normalize_role(probe.role);

  ensure(
    cu_name === focus_name && probe.name === focus_name && cu_name === probe.name,
    "cu_linux_focused_honesty_name_" + label + ":" + JSON.stringify({
      cu: cu_name, probe: probe.name, focus_name: focus_name,
    })
  );
  ensure(
    cu_role === probe_role,
    "cu_linux_focused_honesty_role_" + label + ":" + JSON.stringify({
      cu: cu_role, probe: probe_role, focus_name: focus_name,
    })
  );

  const role_mismatch = run_cu_reply(run_directory, executable, "observe", [
    "focused", "--window", handle, "--role", "menu bar",
  ]);
  ensure(
    !output_success(role_mismatch),
    "cu_linux_focused_honesty_role_mismatch_ok_" + label + ":" + JSON.stringify(role_mismatch)
  );
  ensure(
    text_at(role_mismatch, "error.code") === "unverified",
    "cu_linux_focused_honesty_role_mismatch_code_" + label + ":" + JSON.stringify(role_mismatch.error)
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_focused_honesty_executable_missing");

const uname = rh.command("/usr/bin/uname", ["-s"], { timeout_ms: 10000 });
ensure(uname.success === true && uname.stdout.trim() === "Linux",
  "cu_linux_focused_honesty_requires_linux");

const context = harness.new_context(repo, "cu-linux-focused-honesty");
const run_directory = rh.join(repo, "target/cu-linux-focused-honesty-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_focused_honesty_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available();

try {
  print("STEP focused typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present (usage_rejects_unexpected)");
  assert_focused_usage_limit(run_directory, executable);

  print("STEP focus typed-fails usage when --name is missing or --window is zero before focused read-back court");
  assert_focus_usage_limit(run_directory, executable);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before focused observe/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before focused observe/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP focused/focus typed-fail host-limit on invalid AT-SPI bus before focused observe/read-back court");
  assert_focused_host_limit_when_atspi_absent(run_directory, executable);
  assert_focus_host_limit_when_atspi_absent(run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held; focused actuate/observe read-back still requires AT-SPI");
    succeeded = 1;
  } else {
    print("STEP start owned GTK fixture and resolve one window handle");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_focused_honesty_window_wait");

    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_focused_honesty_inventory_missing");
    const handle = "" + int_at(row, "handle");
    ensure(int_at(row, "handle") > 0, "cu_linux_focused_honesty_handle:" + JSON.stringify(row));

    for (const focus_case of FOCUS_CASES) {
      assert_focused_agreement(
        run_directory, executable, handle, fixture_title, focus_case.name, focus_case.label
      );
    }

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
}

if (succeeded !== 0) {
  harness.emit_evidence(context, declared_evidence, declared_evidence[0]);
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux CU focused matches independent pyatspi STATE_FOCUSED after focus --name with typed focused/focus --name/--coords/--bogus usage_rejects_unexpected and get-extents --name usage/host-limit plus --coords/--bogus command=usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux focused/focus typed-fail with typed focused --name/--coords/--bogus usage_rejects_unexpected and get-extents --name usage/host-limit plus --coords/--bogus command=usage honesty when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
return;
