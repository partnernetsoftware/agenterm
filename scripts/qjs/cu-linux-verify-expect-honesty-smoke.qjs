// CEO: Linux verify --expect honesty with independent pyatspi read-back.
// Acceptance is smoke read-back only: CU verify against named node expect
// items must agree with an independent AT-SPI read-back of the same value and
// checked facts on those nodes. AT-SPI/--name only; no --coords or screenshot
// degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-verify-expect-readback",
];

const ENTRY_NAME = "Fixture Entry";
const CHECK_NAME = "Fixture Check";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu(run_directory, executable, grant, arguments) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_verify_expect_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_verify_expect_empty");
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_linux_verify_expect_reply:" + JSON.stringify(document));
  return document;
}

function run_cu_reply(run_directory, executable, arguments) {
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_verify_expect_empty:" + output.stderr);
  return JSON.parse(trimmed);
}

function verify_reply(run_directory, executable, handle_text, expect) {
  return run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe", "verify",
    "--window", handle_text, "--expect", JSON.stringify(expect),
  ]);
}

function verify_ok(run_directory, executable, handle_text, expect) {
  const reply = verify_reply(run_directory, executable, handle_text, expect);
  ensure(
    flag_at(reply, "ok") && flag_at(reply, "data.verified"),
    "cu_linux_verify_expect_verify:" + JSON.stringify(expect) + ":" + JSON.stringify(reply)
  );
  return reply;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_verify_readback(run_directory, executable, fixture_pid, cu_verify_path) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "",
    "pid = int(sys.argv[1])",
    "cu_path = sys.argv[2]",
    "",
    "ROLE_CHECKABLE = {'check box', 'radio button', 'check menu item', 'radio menu item', 'toggle button'}",
    "",
    "def role_is_checkable(role): return role in ROLE_CHECKABLE",
    "",
    "def complete_two_way(labels, role):",
    "    has = lambda w: w in labels",
    "    if (has('checkable') or role_is_checkable(role)) and not has('mixed'):",
    "        if has('indeterminate'):",
    "            labels.append('mixed')",
    "        elif not has('checked'):",
    "            labels.append('unchecked')",
    "    return labels",
    "",
    "def normalize_state(word):",
    "    if word == 'multi_line': return 'multiline'",
    "    if word == 'single_line': return 'singleline'",
    "    return word",
    "",
    "def state_labels(obj, role):",
    "    labels = []",
    "    st = obj.getState()",
    "    for attr in dir(pyatspi):",
    "        if not attr.startswith('STATE_') or attr in ('STATE_LAST_DEFINED', 'STATE_VALUE_TO_NAME'):",
    "            continue",
    "        if st.contains(getattr(pyatspi, attr)):",
    "            labels.append(normalize_state(attr[6:].lower()))",
    "    return complete_two_way(labels, role)",
    "",
    "def node_role(obj):",
    "    try:",
    "        rn = obj.getRoleName()",
    "        if rn and rn.strip(): return rn",
    "    except Exception: pass",
    "    return pyatspi.role.getName(obj.getRole()).lower()",
    "",
    "def node_name(obj):",
    "    try: return obj.name or ''",
    "    except Exception: return ''",
    "",
    "def node_text(obj):",
    "    try:",
    "        ti = obj.queryText()",
    "        return ti.getText(0, ti.characterCount)",
    "    except Exception:",
    "        return None",
    "",
    "def node_checked(obj, role):",
    "    labels = state_labels(obj, role)",
    "    if 'checked' in labels: return True",
    "    if 'unchecked' in labels: return False",
    "    if 'mixed' in labels: return None",
    "    return None",
    "",
    "def find_named(root, name):",
    "    if node_name(root) == name:",
    "        return root",
    "    for i in range(root.childCount):",
    "        try:",
    "            hit = find_named(root.getChildAtIndex(i), name)",
    "            if hit is not None: return hit",
    "        except Exception: pass",
    "    return None",
    "",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "app = None",
    "for i in range(desktop.childCount):",
    "    child = desktop.getChildAtIndex(i)",
    "    try:",
    "        if child.get_process_id() == pid:",
    "            app = child",
    "            break",
    "    except Exception: pass",
    "if app is None:",
    "    raise SystemExit('cu_linux_verify_expect_no_app')",
    "",
    "cu = json.load(open(cu_path))",
    "if not cu.get('ok') or cu.get('command') != 'verify':",
    "    raise SystemExit('cu_linux_verify_expect_cu_reply')",
    "results = cu['data']['results']",
    "",
    "mismatches = []",
    "for item in results:",
    "    node = item.get('node') or {}",
    "    name = node.get('name') or ''",
    "    if not name:",
    "        mismatches.append(('missing_name', item))",
    "        continue",
    "    native = find_named(app, name)",
    "    if native is None:",
    "        mismatches.append(('native_missing', name))",
    "        continue",
    "    role = node_role(native)",
    "    for check in item.get('checks') or []:",
    "        field = check.get('field')",
    "        observed_cu = check.get('observed')",
    "        if field == 'value':",
    "            native_value = node_text(native)",
    "            if native_value != observed_cu:",
    "                mismatches.append(('value', name, native_value, observed_cu))",
    "        elif field == 'checked':",
    "            native_checked = node_checked(native, role)",
    "            if native_checked != observed_cu:",
    "                mismatches.append(('checked', name, native_checked, observed_cu))",
    "        else:",
    "            mismatches.append(('unknown_field', field))",
    "if mismatches:",
    "    raise SystemExit('cu_linux_verify_expect_mismatch:' + json.dumps(mismatches[0]))",
    "",
    "print('verified', len(results), 'items')",
  ].join("\n");
  const output = rh.command("/usr/bin/python3", [
    "-c", script,
    "" + fixture_pid,
    cu_verify_path,
  ], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true,
    "cu_linux_verify_expect_readback:" + output.stderr + output.stdout);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_verify_expect_executable_missing");

const uname = rh.command("/usr/bin/uname", ["-s"], { timeout_ms: 10000 });
ensure(uname.success === true && uname.stdout.trim() === "Linux",
  "cu_linux_verify_expect_requires_linux");

const context = harness.new_context(repo, "cu-linux-verify-expect-honesty");
const run_directory = rh.join(repo, "target/cu-linux-verify-expect-honesty-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_verify_expect_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";

try {
  print("STEP start owned GTK fixture and resolve one window handle");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_verify_expect_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_verify_expect_inventory_missing");
  const handle_text = "" + int_at(row, "handle");
  ensure(int_at(row, "handle") > 0, "cu_linux_verify_expect_handle:" + JSON.stringify(row));

  print("STEP baseline verify --expect on named entry value and checkbox checked");
  const baseline_expect = [
    { name: ENTRY_NAME, value: "seed" },
    { name: CHECK_NAME, checked: false },
  ];
  const baseline = verify_ok(run_directory, executable, handle_text, baseline_expect);
  ensure(
    text_at(baseline, "data.backend") === "at-spi2"
      && text_at(baseline, "data.addressing") === "accessibility-tree"
      && baseline.data.results.length === 2,
    "cu_linux_verify_expect_baseline_shape:" + JSON.stringify(baseline.data)
  );
  const baseline_path = rh.join(run_directory, "verify-baseline.json");
  rh.write_text(baseline_path, JSON.stringify(baseline));

  print("STEP independent pyatspi read-back agrees with baseline verify results");
  independent_verify_readback(run_directory, executable, fixture_pid, baseline_path);

  const token = "ceo-verify-" + context.run_id;
  print("STEP invoke set-value writes disposable token on the named entry");
  const set_value = run_cu(run_directory, executable, "observe,actuate", [
    "invoke", "--window", handle_text, "--name", ENTRY_NAME, "set-value", token,
  ]);
  ensure(
    text_at(set_value, "data.action") === "set-value"
      && flag_at(set_value, "data.performed")
      && flag_at(set_value, "data.verified")
      && text_at(set_value, "data.after.text") === token,
    "cu_linux_verify_expect_set_value:" + JSON.stringify(set_value.data)
  );

  print("STEP verify --expect reads the disposable token back on the named entry");
  const after_expect = [{ name: ENTRY_NAME, value: token }];
  const after = verify_ok(run_directory, executable, handle_text, after_expect);
  const after_path = rh.join(run_directory, "verify-after.json");
  rh.write_text(after_path, JSON.stringify(after));

  print("STEP independent pyatspi read-back agrees with post-actuation verify results");
  independent_verify_readback(run_directory, executable, fixture_pid, after_path);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
}

if (succeeded !== 0) {
  harness.emit_evidence(context, declared_evidence, declared_evidence[0]);
  harness.remove_run(context);
  print("PASS: Linux verify --expect value/checked facts match independent AT-SPI read-back");
}
if (failure !== "") { throw failure; }
return;
