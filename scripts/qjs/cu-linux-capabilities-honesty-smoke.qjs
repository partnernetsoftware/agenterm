// CEO: Linux capabilities matrix honesty with independent host probes.
// Acceptance is smoke read-back only: a bounded verb set's declared
// present/absent status must match facts derived outside agenterm-cu.
// Observe-only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-capabilities-honesty-readback",
];

const PROBE_SCRIPT = [
  "import glob, json, os, subprocess, sys",
  "display = os.environ.get('DISPLAY', '')",
  "def probe_atspi():",
  "    try:",
  "        import pyatspi",
  "        _ = pyatspi.Registry.getDesktop(0)",
  "        return True",
  "    except Exception:",
  "        return False",
  "def probe_cgroup():",
  "    return os.path.exists('/sys/fs/cgroup/cgroup.controllers') or os.path.exists('/proc/self/cgroup')",
  "def probe_ip():",
  "    try:",
  "        out = subprocess.check_output(['ip', '-o', 'link', 'show'], text=True, timeout=5)",
  "        return bool(out.strip())",
  "    except Exception:",
  "        return False",
  "def probe_inotify():",
  "    return os.path.exists('/proc/sys/fs/inotify/max_user_instances')",
  "def probe_x11():",
  "    if display == '':",
  "        return False",
  "    try:",
  "        subprocess.check_call(['xdpyinfo', '-display', display], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)",
  "        return True",
  "    except Exception:",
  "        return False",
  "def probe_proc():",
  "    return os.path.exists('/proc/self/stat')",
  "def probe_file_inspect():",
  "    try:",
  "        os.lstat('/proc/self/stat')",
  "        return True",
  "    except Exception:",
  "        return False",
  "def probe_apps_installed():",
  "    globs = ['/usr/share/applications/*.desktop', os.path.expanduser('~/.local/share/applications/*.desktop')]",
  "    for pattern in globs:",
  "        if glob.glob(pattern):",
  "            return True",
  "    return False",
  "def probe_host_notify():",
  "    bus = os.environ.get('DBUS_SESSION_BUS_ADDRESS', '')",
  "    if bus == '':",
  "        return False",
  "    try:",
  "        subprocess.check_call(",
  "            ['dbus-send', '--session', '--print-reply', '--dest=org.freedesktop.Notifications',",
  "             '/org/freedesktop/Notifications', 'org.freedesktop.DBus.Introspectable.Introspect'],",
  "            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)",
  "        return True",
  "    except Exception:",
  "        return False",
  "probes = {",
  "    'tree': probe_atspi(),",
  "    'query': probe_atspi(),",
  "    'process-cgroup': probe_cgroup(),",
  "    'network-interfaces': probe_ip(),",
  "    'file-watch': probe_inotify(),",
  "    'displays': probe_x11(),",
  "    'ps': probe_proc(),",
  "    'file-inspect': probe_file_inspect(),",
  "    'host-notify': probe_host_notify(),",
  "    'simulator-shutdown': False,",
  "    'spaces': False,",
  "    'device-screenshot': False,",
  "    'apps.installed': probe_apps_installed(),",
  "}",
  "print(json.dumps(probes))",
].join("\n");

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function text_at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke(run_directory, executable, arguments) {
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_capabilities_honesty_exit:" + output.exit_code + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(reply.ok === true, "cu_linux_capabilities_honesty_reply:" + JSON.stringify(reply));
  return reply;
}

function independent_probes() {
  const output = rh.command("python3", ["-c", PROBE_SCRIPT], {
    env: cu_env("."),
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_capabilities_honesty_probe:" + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function verb_status(verbs, verb) {
  const declaration = rh.field(verbs, verb);
  ensure(declaration !== undefined && declaration !== null,
         "cu_linux_capabilities_honesty_missing_verb:" + verb);
  return text_at(declaration, "status");
}

function apps_installed_status(verbs) {
  const declaration = rh.field(verbs, "apps");
  ensure(declaration !== undefined && declaration !== null,
         "cu_linux_capabilities_honesty_missing_apps");
  return text_at(declaration, "installed");
}

function expect_status(actual, probe_available, label) {
  if (probe_available) {
    ensure(actual === "available", label + ":expected_available:cu=" + actual);
    return;
  }
  ensure(actual === "unsupported" || actual === "not-applicable" || actual === "failed",
         label + ":expected_absent:cu=" + actual);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!direct_file(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(direct_file(executable), "cu_linux_capabilities_honesty_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-capabilities-honesty");
let succeeded = 0;
let failure = "";
try {
  print("STEP independent host probes bracket one capabilities observation");
  const probes = independent_probes();
  const reply = invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "observe", "capabilities",
  ]);
  ensure(reply.command === "capabilities" && reply.target === "current",
         "cu_linux_capabilities_honesty_command");
  const verbs = rh.field(rh.field(reply, "data"), "verbs");
  ensure(verbs !== undefined && verbs !== null, "cu_linux_capabilities_honesty_verbs");

  const bounded = [
    "tree", "query", "process-cgroup", "network-interfaces", "file-watch",
    "displays", "ps", "file-inspect", "host-notify",
    "simulator-shutdown", "spaces", "device-screenshot",
  ];
  for (const verb of bounded) {
    const actual = verb_status(verbs, verb);
    const label = "cu_linux_capabilities_honesty_" + verb.split("-").join("_");
    expect_status(actual, probes[verb] === true, label);
  }

  const installed_actual = apps_installed_status(verbs);
  if (probes["apps.installed"] === true) {
    ensure(installed_actual === "available",
           "cu_linux_capabilities_honesty_apps_installed:cu=" + installed_actual);
  } else {
    ensure(installed_actual === "unsupported" || installed_actual === "not-applicable",
           "cu_linux_capabilities_honesty_apps_installed_absent:cu=" + installed_actual);
  }

  const tree_cap = text_at(reply, "data.capabilities.tree");
  if (probes.tree === true) {
    ensure(tree_cap === "Available", "cu_linux_capabilities_honesty_caps_tree:" + tree_cap);
  } else {
    ensure(tree_cap !== "Available", "cu_linux_capabilities_honesty_caps_tree_absent:" + tree_cap);
  }

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-capabilities-honesty-readback");
  harness.remove_run(context);
  print("PASS: Linux capabilities matrix matches independent host probes for bounded verbs");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
