// CEO: Linux capabilities matrix honesty with independent host probes.
// Acceptance is smoke read-back only: a bounded verb set's declared
// present/absent status must match facts derived outside agenterm-cu.
// Typed capabilities --name/--coords/--bogus uses usage_rejects_unexpected +
// command=usage or an honest non-usage typed failure (never fake
// command=usage). Typed get-extents --name usage AND host-limit courts must
// both hold before process-state, desktop-state, and the capabilities
// observe/read-back court (no if/else gating those courts on
// atspi_available); get-extents --coords/--bogus must reject as
// command=usage. process-state and desktop-state fixture binding courts must
// hold before the independent capabilities read-back. Prefer honesty over
// fake success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-capabilities-honesty-readback",
];

const AT_SPI_PROBE_NAME = "Capabilities Honesty Court Anchor";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

const PROBE_SCRIPT = [
  "import glob, json, os, shutil, subprocess, sys",
  "display = os.environ.get('DISPLAY', '')",
  "def probe_atspi():",
  "    try:",
  "        import pyatspi",
  "        _ = pyatspi.Registry.getDesktop(0)",
  "        return True",
  "    except Exception:",
  "        return False",
  "def probe_cgroup():",
  "    return os.path.exists('/sys/fs/cgroup/cgroup.controllers') or os.path.exists('/proc/self/cgroup')",
  "def probe_ip():",
  "    try:",
  "        out = subprocess.check_output(['ip', '-o', 'link', 'show'], text=True, timeout=5)",
  "        return bool(out.strip())",
  "    except Exception:",
  "        return False",
  "def probe_inotify():",
  "    return os.path.exists('/proc/sys/fs/inotify/max_user_instances')",
  "def probe_x11():",
  "    if display == '':",
  "        return False",
  "    try:",
  "        subprocess.check_call(['xdpyinfo', '-display', display], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)",
  "        return True",
  "    except Exception:",
  "        return False",
  "def probe_proc():",
  "    return os.path.exists('/proc/self/stat')",
  "def probe_file_inspect():",
  "    try:",
  "        os.lstat('/proc/self/stat')",
  "        return True",
  "    except Exception:",
  "        return False",
  "def probe_apps_installed():",
  "    globs = ['/usr/share/applications/*.desktop', os.path.expanduser('~/.local/share/applications/*.desktop')]",
  "    for pattern in globs:",
  "        if glob.glob(pattern):",
  "            return True",
  "    return False",
  "def probe_host_notify():",
  "    bus = os.environ.get('DBUS_SESSION_BUS_ADDRESS', '')",
  "    if bus == '':",
  "        return False",
  "    try:",
  "        subprocess.check_call(",
  "            ['dbus-send', '--session', '--print-reply', '--dest=org.freedesktop.Notifications',",
  "             '/org/freedesktop/Notifications', 'org.freedesktop.DBus.Introspectable.Introspect'],",
  "            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)",
  "        return True",
  "    except Exception:",
  "        return False",
  "def probe_simulator_shutdown():",
  "    if not sys.platform.startswith('darwin'):",
  "        return False",
  "    simctl = shutil.which('xcrun')",
  "    if simctl is None:",
  "        return False",
  "    try:",
  "        subprocess.check_call([simctl, 'simctl', 'help'], stdout=subprocess.DEVNULL,",
  "                              stderr=subprocess.DEVNULL, timeout=5)",
  "        return True",
  "    except Exception:",
  "        return False",
  "def probe_spaces():",
  "    if not sys.platform.startswith('darwin'):",
  "        return False",
  "    return os.path.exists('/System/Library/PrivateFrameworks/SkyLight.framework')",
  "def probe_device_screenshot():",
  "    if not sys.platform.startswith('darwin'):",
  "        return False",
  "    return os.path.exists('/System/Library/Frameworks/CoreMediaIO.framework')",
  "probes = {",
  "    'tree': probe_atspi(),",
  "    'query': probe_atspi(),",
  "    'process-cgroup': probe_cgroup(),",
  "    'network-interfaces': probe_ip(),",
  "    'file-watch': probe_inotify(),",
  "    'displays': probe_x11(),",
  "    'ps': probe_proc(),",
  "    'file-inspect': probe_file_inspect(),",
  "    'host-notify': probe_host_notify(),",
  "    'simulator-shutdown': probe_simulator_shutdown(),",
  "    'spaces': probe_spaces(),",
  "    'device-screenshot': probe_device_screenshot(),",
  "    'apps.installed': probe_apps_installed(),",
  "}",
  "print(json.dumps(probes))",
].join("\n");

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function text_at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function honest_non_usage_code(code) {
  return code === "a11y_backend_failed"
    || code === "unsupported"
    || code === "bad_handle"
    || code === "window_not_found"
    || code === "a11y_window_gone"
    || code === "invalid_input"
    || code === "a11y_node_not_found";
}

function assert_usage_or_honest_non_usage(reply, label, token) {
  ensure(!rh.output_success(reply),
    "cu_linux_capabilities_honesty_" + label + "_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  const command = text_at(reply, "command");
  if (code === "usage" || command === "usage") {
    ensure(
      code === "usage",
      "cu_linux_capabilities_honesty_" + label + "_code:" + JSON.stringify(reply.error)
    );
    ensure(
      command === "usage",
      "cu_linux_capabilities_honesty_" + label + "_command:" + JSON.stringify(reply)
    );
    ensure(
      usage_rejects_unexpected(text_at(reply, "error.message"), token)
        || text_at(reply, "error.message").indexOf("no arguments") >= 0,
      "cu_linux_capabilities_honesty_" + label + "_message:" + JSON.stringify(reply.error)
    );
  } else {
    ensure(
      command !== "usage" && honest_non_usage_code(code),
      "cu_linux_capabilities_honesty_" + label + "_honest:" + JSON.stringify(reply)
    );
  }
}


function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_reply(run_directory, executable, arguments) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_capabilities_honesty_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "capabilities" || text_at(reply, "command") === "usage",
    "cu_linux_capabilities_honesty_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke(run_directory, executable, arguments) {
  const reply = invoke_reply(run_directory, executable, arguments);
  ensure(rh.output_success(reply), "cu_linux_capabilities_honesty_exit:" + JSON.stringify(reply));
  ensure(text_at(reply, "command") === "capabilities",
         "cu_linux_capabilities_honesty_command:" + JSON.stringify(reply));
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_capabilities_honesty_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function run_cu_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_capabilities_honesty_empty:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(rh.output_success(document),
    "cu_linux_capabilities_honesty_reply:" + JSON.stringify(document));
  return document;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_capabilities_usage_limit(run_directory, executable) {
  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe", [
    "capabilities", "--name", AT_SPI_PROBE_NAME,
  ]), "usage_name", "--name");
  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe", [
    "capabilities", "--bogus",
  ]), "usage_bogus", "--bogus");
  assert_usage_or_honest_non_usage(run_cu_reply(run_directory, executable, "observe", [
    "capabilities", "--coords", "10,10",
  ]), "usage_coords", "--coords");
}

function assert_get_extents_usage_limit(run_directory, executable) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_capabilities_honesty_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_capabilities_honesty_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_capabilities_honesty_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ]);
  ensure(!rh.output_success(missing_name),
    "cu_linux_capabilities_honesty_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_capabilities_honesty_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_capabilities_honesty_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_capabilities_honesty_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ]);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_capabilities_honesty_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_capabilities_honesty_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_capabilities_honesty_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_capabilities_honesty_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ]);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_capabilities_honesty_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_capabilities_honesty_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_capabilities_honesty_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_capabilities_honesty_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_capabilities_honesty_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_capabilities_honesty_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_capabilities_honesty_extents_unavailable_code:" + code
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_capabilities_honesty_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_capabilities_honesty_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_capabilities_honesty_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_capabilities_honesty_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_capabilities_honesty_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function independent_probes() {
  const output = rh.command("python3", ["-c", PROBE_SCRIPT], {
    env: cu_env("."),
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_capabilities_honesty_probe:" + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function verb_status(verbs, verb) {
  const declaration = rh.field(verbs, verb);
  ensure(declaration !== undefined && declaration !== null,
         "cu_linux_capabilities_honesty_missing_verb:" + verb);
  return text_at(declaration, "status");
}

function apps_installed_status(verbs) {
  const declaration = rh.field(verbs, "apps");
  ensure(declaration !== undefined && declaration !== null,
         "cu_linux_capabilities_honesty_missing_apps");
  return text_at(declaration, "installed");
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function verb_declaration(verbs, verb) {
  const declaration = rh.field(verbs, verb);
  ensure(declaration !== undefined && declaration !== null,
         "cu_linux_capabilities_honesty_missing_declaration:" + verb);
  return declaration;
}

function expect_status(actual, probe_available, label) {
  if (probe_available) {
    ensure(actual === "available", label + ":expected_available:cu=" + actual);
    return;
  }
  ensure(actual === "unsupported" || actual === "not-applicable" || actual === "failed",
         label + ":expected_absent:cu=" + actual);
}

function expect_host_limit_clarity(declaration, probe_available, label) {
  if (probe_available) { return; }
  const reason = text_at(declaration, "reason");
  const platforms = at(declaration, "platforms");
  const has_reason = reason.length > 0;
  const has_platforms = Array.isArray(platforms) && platforms.length > 0;
  ensure(has_reason || has_platforms,
         label + ":missing_host_limit_metadata:" + JSON.stringify(declaration));
  if (has_reason) {
    const lower = reason.toLowerCase();
    ensure(lower.indexOf("macos") >= 0 || lower.indexOf("skylight") >= 0,
           label + ":reason_not_macos_specific:" + reason);
  }
  if (has_platforms && !has_reason) {
    ensure(platforms.indexOf("macos") >= 0,
           label + ":platforms_missing_macos:" + JSON.stringify(platforms));
  }
}

function expect_spaces_host_limit(declaration, probe_available, label) {
  expect_host_limit_clarity(declaration, probe_available, label);
  if (probe_available) { return; }
  ensure(text_at(declaration, "os") === "linux", label + ":spaces_os:" + text_at(declaration, "os"));
  ensure(text_at(declaration, "provider") === "none",
         label + ":spaces_provider:" + text_at(declaration, "provider"));
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.is_direct_file(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(rh.is_direct_file(executable), "cu_linux_capabilities_honesty_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-capabilities-honesty");
const run_directory = context.run_directory;
const atspi_available = probe_atspi_available(executable);
const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(rh.is_direct_file(fixture_source), "cu_linux_capabilities_honesty_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
try {
  print("STEP capabilities typed-fails usage when AT-SPI --name/--coords/--bogus is present (usage_rejects_unexpected + command=usage, or honest non-usage typed failure; never fake command=usage)");
  assert_capabilities_usage_limit(run_directory, executable);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before process-state/desktop-state and capabilities observe/read-back court");
  assert_get_extents_usage_limit(run_directory, executable);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and capabilities observe/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held; capabilities read-back still uses independent host probes");
  }

  print("STEP start owned GTK fixture and resolve window by pid and exact title");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_capabilities_honesty_window_wait");

  const inventory_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(inventory_row !== null, "cu_linux_capabilities_honesty_window_identity");
  const handle = "" + int_at(inventory_row, "handle");
  ensure(int_at(inventory_row, "handle") > 0,
    "cu_linux_capabilities_honesty_handle:" + JSON.stringify(inventory_row));

  print("STEP process-state binds the owned fixture pid before capabilities observe/read-back court");
  assert_fixture_process_state(run_directory, executable, fixture_pid);

  print("STEP desktop-state window row agrees with inventory before capabilities observe/read-back court");
  assert_fixture_desktop_state(
    run_directory, executable, fixture_pid, fixture_title, handle, inventory_row
  );

  print("STEP independent host probes bracket one capabilities observation");
  const probes = independent_probes();
  const reply = invoke(run_directory, executable, ["capabilities"]);
  ensure(reply.command === "capabilities" && reply.target === "current",
         "cu_linux_capabilities_honesty_command");
  const verbs = rh.field(rh.field(reply, "data"), "verbs");
  ensure(verbs !== undefined && verbs !== null, "cu_linux_capabilities_honesty_verbs");

  const bounded = [
    "tree", "query", "process-cgroup", "network-interfaces", "file-watch",
    "displays", "ps", "file-inspect", "host-notify",
    "simulator-shutdown", "spaces", "device-screenshot",
  ];
  print("STEP unsupported verbs declare macOS host-limit metadata matching independent probes");
  for (const verb of bounded) {
    const declaration = verb_declaration(verbs, verb);
    const actual = verb_status(verbs, verb);
    const label = "cu_linux_capabilities_honesty_" + verb.split("-").join("_");
    const probe_available = probes[verb] === true;
    expect_status(actual, probe_available, label);
    if (verb === "spaces") {
      expect_spaces_host_limit(declaration, probe_available, label);
    } else {
      expect_host_limit_clarity(declaration, probe_available, label);
    }
  }

  const installed_actual = apps_installed_status(verbs);
  if (probes["apps.installed"] === true) {
    ensure(installed_actual === "available",
           "cu_linux_capabilities_honesty_apps_installed:cu=" + installed_actual);
  } else {
    ensure(installed_actual === "unsupported" || installed_actual === "not-applicable",
           "cu_linux_capabilities_honesty_apps_installed_absent:cu=" + installed_actual);
  }

  const tree_cap = text_at(reply, "data.capabilities.tree");
  if (probes.tree === true) {
    ensure(tree_cap === "Available", "cu_linux_capabilities_honesty_caps_tree:" + tree_cap);
  } else {
    ensure(tree_cap !== "Available", "cu_linux_capabilities_honesty_caps_tree_absent:" + tree_cap);
  }

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-capabilities-honesty-readback");
  harness.remove_run(context);
  print("PASS: Linux capabilities matrix matches independent host probes for bounded verbs with typed capabilities --name/--coords/--bogus usage_rejects_unexpected or honest non-usage (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), and process-state/desktop-state courts before observe/read-back (AT-SPI --name, no --coords)");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
