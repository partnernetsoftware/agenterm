// Prove coalesced server wake delivery under concurrent IPC and PTY output.
//
// Args:
//   --list-evidence
// or:
//   REPO SERVER_EXE CLI_EXE
//
// Ported from scripts/rh/wake-smoke.rh; runs under `--profile tool`. The
// server and the 24 concurrent `ui-snapshot` clients are door handles;
// every client is drained through `process_wait` (its stdout is the
// snapshot), and `complete_unwaited` covers whatever the server leg left.
// Windows-shaped like the original (`cmd.exe` in the PTY, `powershell` for
// the raw newline-delimited IPC leg).
//
// Gap: a door handle carries no child pid, so the original's
// `protocol.pid == server_child.id` identity check is not made here.
//
// Changed on purpose: the original sent rh's `fnv1a64` as a signed decimal,
// which is not the product's `fnv1a64:<16 hex>` fingerprint spelling
// (`PayloadFingerprint::from_bytes`), so the expired-mutation receipt could
// never be `request_deadline_expired` (it was `control_request_mismatch`).
// The fingerprint here is the product's.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

function catch_text(error) {
  return "" + error;
}

function output_combined_text(output) {
  return "" + output.stdout + output.stderr;
}

function command(context, cli, arguments, expected_failure) {
  return harness.invoke_cli_bounded(context, cli, arguments, expected_failure, []);
}

function command_text(context, cli, arguments) {
  const output = command(context, cli, arguments, 0);
  return ("" + output.stdout + output.stderr).trim();
}

function command_json(context, cli, arguments, expected_failure) {
  const output = command(context, cli, arguments, expected_failure);
  const text = ("" + output.stdout + output.stderr).trim();
  harness.require(text !== "", "wake_smoke_cli_empty_json");
  return JSON.parse(text);
}

function wait_for_server(context, cli, server_child, waited) {
  for (let attempt = 0; attempt < 400; attempt = attempt + 1) {
    const probe = harness.run_cli_bounded(context, cli, ["protocol-info", "--running"], 0, []);
    if (probe.success) { return 0; }
    if (harness.state(server_child) === "exited") {
      const output = harness.drain(server_child, 2000, waited);
      throw "wake_smoke_server_early_exit:" + output.stderr;
    }
    harness.sleep_ms(25);
  }
  throw "wake_smoke_server_ready_timeout";
}

function wait_for_exit(child, code, waited) {
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    if (harness.state(child) === "exited") {
      return harness.drain(child, 2000, waited);
    }
    harness.sleep_ms(25);
  }
  throw code;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  print("fleet.wake-coalescing");
  print("ux-parity.wake-coalescing");
  return 0;
}

harness.require(args.length === 3, "expected: REPO SERVER_EXE CLI_EXE");
const repo = rh.absolute(args[0]);
const server_exe = rh.absolute(args[1]);
const cli = rh.absolute(args[2]);
harness.require(rh.exists(server_exe), "wake_smoke_server_missing");
harness.require(rh.exists(cli), "wake_smoke_cli_missing");

const context = harness.new_context(repo, "wake");
const ctx_address = "" + context.address;
const owned_children = [];
const waited = [];
const clients = [];
const client_waited = [];
let succeeded = false;
let failure = "";

try {
  print("STEP start isolated headless server and terminal");
  const server_child = harness.start(harness.configured_spec(
    context, server_exe, ["server", "--address", ctx_address]
  ));
  owned_children.push(server_child);
  wait_for_server(context, cli, server_child, waited);
  const protocol = command_json(context, cli, ["protocol-info", "--running"], 0);
  // gap: `protocol.pid == server_child.id` needs the child's pid, which a
  // door handle does not carry; the server answered, which is what the
  // readiness poll proved.
  harness.require(typeof protocol.pid === "number" && protocol.pid > 0, "wake_smoke_server_identity");

  const name = "wake-" + context.run_id;
  const tab_id = command_text(
    context, cli,
    [
      "new-window", "-d", "-P", "-F", "#{window_id}",
      "-n", name,
      "--", "cmd.exe", "/d", "/q"
    ]
  );
  command_text(
    context, cli,
    ["wait-ui", "-t", tab_id, "--tab-state", "running", "--timeout-ms", "30000"]
  );

  print("STEP concurrent IPC replies and PTY output both make progress");
  for (let index = 0; index < 24; index = index + 1) {
    const client_spec = harness.configured_cli_spec(
      context, cli, ["--address", ctx_address, "ui-snapshot"]
    );
    client_spec.timeout_ms = 20000;
    clients.push(harness.start(client_spec));
  }

  const token = "WAKE_COMPLETE_" + context.run_id;
  command_text(
    context, cli,
    [
      "send-keys", "-t", tab_id, "-l",
      "for /L %i in (1,1,80) do @echo WAKE_" + context.run_id + "_%i"
    ]
  );
  command_text(context, cli, ["send-keys", "-t", tab_id, "Enter"]);
  command_text(context, cli, ["send-keys", "-t", tab_id, "-l", "echo " + token]);
  command_text(context, cli, ["send-keys", "-t", tab_id, "Enter"]);

  for (const client of clients) {
    const output = harness.drain(client, 20000, client_waited);
    harness.append_command_record_bounded(context, ["ui-snapshot"], output, 0, []);
    harness.require(output.success, "wake_smoke_concurrent_client");
    const snapshot_text = output_combined_text(output).trim();
    const snapshot = JSON.parse(snapshot_text);
    harness.require(
      snapshot.schema_version >= 1
        && (snapshot.projection === "replaceable_ui_client"
          || snapshot.projection === "headless_server")
        && snapshot.event_position !== undefined
        && snapshot.event_position.epoch !== "",
      "wake_smoke_concurrent_projection"
    );
  }
  command_text(
    context, cli,
    ["wait-pane", "-t", tab_id, "--contains", token, "--timeout-ms", "30000"]
  );

  print("STEP expired mutation is a typed no-op through raw newline-delimited IPC");
  const baseline = "wake-baseline-" + context.run_id;
  command_text(context, cli, ["set-tab-note", "-t", tab_id, baseline]);
  const args_json_text =
    "[\"set-tab-note\",\"-t\",\"" + tab_id + "\",\"expired-mutation-must-not-commit\"]";
  const fingerprint = "fnv1a64:" + rh.fnv1a64_hex(args_json_text);
  const request_id = "wake-expired-" + context.run_id;
  const request_text =
    "{\"args\":" + args_json_text
    + ",\"control\":{\"schema_version\":1,\"request_id\":\"" + request_id
    + "\",\"operation_id\":\"tabs.set-note\",\"payload_fingerprint\":\""
    + fingerprint + "\",\"intent\":\"mutation\",\"deadline_unix_ms\":0}}\n";
  const response_path = rh.join(context.run_directory, "wake-expired-response.jsonl");
  // Host and port must be separate `TcpClient` arguments (the one-string
  // form binds the AddressFamily overload). Still a shell-out: the door has
  // no TCP surface, exactly as rh had none.
  const address_parts = ctx_address.split(":");
  harness.require(address_parts.length === 2, "wake_smoke_expired_address_shape:" + ctx_address);
  const ps =
    "$req='" + request_text + "'; "
    + "$c=New-Object Net.Sockets.TcpClient('" + address_parts[0]
    + "'," + address_parts[1] + "); "
    + "$s=$c.GetStream(); "
    + "$b=[Text.Encoding]::UTF8.GetBytes($req); "
    + "$s.Write($b,0,$b.Length); $s.Flush(); "
    + "$r=New-Object IO.StreamReader($s); "
    + "$r.ReadLine(); "
    + "$c.Close()";
  const tcp_code = rh.command_stdout_file(
    "powershell", ["-NoProfile", "-Command", ps], response_path, { timeout_ms: 30000 }
  );
  harness.require(tcp_code === 0, "wake_smoke_expired_tcp_failed");
  const response_text = rh.read_text(response_path).trim();
  harness.require(response_text !== "", "wake_smoke_expired_empty_response:" + response_path);
  const expired = JSON.parse(response_text);
  harness.require(
    !expired.ok
      && expired.receipt !== undefined
      && expired.receipt.outcome === "no_op"
      && expired.receipt.error !== undefined
      && expired.receipt.error.code === "request_deadline_expired"
      && expired.receipt.error.category === "timeout"
      && expired.receipt.request_id === request_id,
    "wake_smoke_expired_receipt:" + response_text
  );
  const after_note = command_text(context, cli, ["show-tab-note", "-t", tab_id]);
  harness.require(after_note === baseline, "wake_smoke_expired_mutated_state");

  harness.emit_evidence(
    context,
    ["fleet.wake-coalescing", "ux-parity.wake-coalescing"],
    "fleet.wake-coalescing"
  );
  command_text(context, cli, ["shutdown"]);
  const server_output = wait_for_exit(server_child, "wake_smoke_server_shutdown_timeout", waited);
  harness.require(server_output.success, "wake_smoke_server_exit_failure");
  harness.emit_evidence(
    context,
    ["fleet.wake-coalescing", "ux-parity.wake-coalescing"],
    "ux-parity.wake-coalescing"
  );
  print("PASS: coalesced wake delivery preserved IPC, PTY, and mutation correctness");
  succeeded = true;
} catch (error) {
  failure = catch_text(error);
}

for (const client of clients) {
  if (rh.array_has(client_waited, client)) { continue; }
  if (harness.state(client) === "running") {
    process_kill(client);
  }
  harness.drain(client, 2000, client_waited);
}

let completion_failure = "";
try {
  harness.complete_unwaited(context, owned_children, waited, succeeded, failure);
} catch (error) {
  completion_failure = catch_text(error);
}
if (succeeded && completion_failure === "") {
  harness.remove_run(context);
}
if (failure !== "") {
  throw failure;
}
if (completion_failure !== "") {
  throw completion_failure;
}
return;
