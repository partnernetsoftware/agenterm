// CEO: Linux hit --window point→node honesty with independent AT-SPI name/role
// read-back. Probe points come from get-extents --name only; acceptance is
// smoke read-back: CU hit name/role must agree with a separate pyatspi walk
// of the same named node, the winner must not be a structural filler/label,
// and typed host-limit paths must hold when usage or the point misses.
// Typed hit usage must reject AT-SPI --name, --coords, --bogus, and other
// unexpected arguments; typed get-extents --name usage AND host-limit paths
// must both hold before the hit observe/read-back court. Prefer host-limit
// clarity over fake success. AT-SPI/--name only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-hit-readback",
];

const HIT_DEPTH = 8;
const HIT_MAX_NODES = 500;
const AT_SPI_PROBE_NAME = "Hit Honesty Court Anchor";
const NAMED_NODES = [
  "Fixture Press",
  "Fixture Entry",
  "Fixture Check",
  "Fixture Drag Source",
];
const STRUCTURAL_ROLES = [
  "filler", "generic", "group", "panel", "section", "paragraph", "label", "statictext",
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function normalize_role(role) {
  return ("" + role).toLowerCase().replaceAll(" ", "");
}

function is_structural_role(role) {
  const normalized = normalize_role(role);
  for (let index = 0; index < STRUCTURAL_ROLES.length; index = index + 1) {
    if (normalized === STRUCTURAL_ROLES[index]) { return true; }
  }
  return false;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_hit_honesty_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function run_cu(run_directory, executable, grant, cu_args) {
  const document = run_cu_reply(run_directory, executable, grant, cu_args);
  ensure(flag_at(document, "ok"), "cu_linux_hit_honesty_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_hit_honesty_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function containing_includes_winner(containing, winner) {
  const winner_id = text_at(winner, "id");
  const winner_name = text_at(winner, "name");
  const winner_role = text_at(winner, "role");
  for (let index = 0; index < containing.length; index = index + 1) {
    const row = containing[index];
    if (text_at(row, "id") === winner_id) { return true; }
    if (text_at(row, "name") === winner_name && text_at(row, "role") === winner_role) {
      return true;
    }
  }
  return false;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_probe_script() {
  return [
    "import json, sys",
    "import pyatspi",
    "",
    "config = json.loads(sys.argv[1])",
    "title = config['title']",
    "name = config['name']",
    "",
    "def node_name(obj):",
    "    try: return obj.name or ''",
    "    except Exception: return ''",
    "",
    "def node_role(obj):",
    "    try:",
    "        rn = obj.getRoleName()",
    "        if rn and rn.strip(): return rn",
    "    except Exception: pass",
    "    return pyatspi.role.getName(obj.getRole()).lower()",
    "",
    "def find_named(root, needle):",
    "    if node_name(root) == needle:",
    "        return root",
    "    try: child_count = root.childCount",
    "    except Exception: child_count = 0",
    "    for index in range(child_count):",
    "        try: child = root.getChildAtIndex(index)",
    "        except Exception: child = None",
    "        if child is None: continue",
    "        found = find_named(child, needle)",
    "        if found is not None: return found",
    "    return None",
    "",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "application = None",
    "for candidate in desktop:",
    "    try:",
    "        for index in range(candidate.childCount):",
    "            window = candidate.getChildAtIndex(index)",
    "            if window is not None and node_name(window) == title:",
    "                application = candidate",
    "                break",
    "        if application is not None: break",
    "    except Exception: continue",
    "if application is None:",
    "    raise SystemExit('cu_linux_hit_honesty_probe_window_missing')",
    "",
    "node = find_named(application, name)",
    "if node is None:",
    "    raise SystemExit('cu_linux_hit_honesty_probe_node_missing:' + name)",
    "",
    "print(json.dumps({'name': node_name(node), 'role': node_role(node)}))",
  ].join("\n");
}

function independent_named_node(run_directory, title, node_name) {
  const output = rh.command(
    "python3",
    ["-c", independent_probe_script(), JSON.stringify({ title: title, name: node_name })],
    { cwd: run_directory, env: cu_env(""), timeout_ms: 45000 },
  );
  ensure(output.success === true, "cu_linux_hit_honesty_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function probe_point_from_extents(extents) {
  const x = int_at(extents, "data.extents.x") + 1;
  const y = int_at(extents, "data.extents.y") + 1;
  return { x: x, y: y };
}

function assert_hit_usage_limit(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "hit", "--window", "0", "--x", "1", "--y", "1",
  ]);
  ensure(!output_success(reply), "cu_linux_hit_honesty_usage_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_hit_honesty_usage_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_hit_honesty_usage_message:" + JSON.stringify(reply.error)
  );
}

function assert_hit_atspi_name_usage_limit(run_directory, executable, env) {
  const with_name = run_cu_reply(run_directory, executable, "observe", [
    "hit", "--window", "1", "--x", "1", "--y", "1",
    "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(with_name), "cu_linux_hit_honesty_usage_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_hit_honesty_usage_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_hit_honesty_usage_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_name, "error.message"), "--name"),
    "cu_linux_hit_honesty_usage_name_message:" + JSON.stringify(with_name.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, "observe", [
    "hit", "--window", "1", "--x", "1", "--y", "1", "--bogus",
  ], env);
  ensure(!output_success(with_bogus), "cu_linux_hit_honesty_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_hit_honesty_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_hit_honesty_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_hit_honesty_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_coords = run_cu_reply(run_directory, executable, "observe", [
    "hit", "--window", "1", "--x", "1", "--y", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords), "cu_linux_hit_honesty_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_hit_honesty_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_hit_honesty_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_hit_honesty_usage_coords_message:" + JSON.stringify(with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_hit_honesty_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_hit_honesty_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_hit_honesty_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_hit_honesty_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_hit_honesty_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_hit_honesty_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_hit_honesty_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords), "cu_linux_hit_honesty_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_hit_honesty_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_hit_honesty_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_hit_honesty_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus), "cu_linux_hit_honesty_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_hit_honesty_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_hit_honesty_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_hit_honesty_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_hit_honesty_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_hit_honesty_extents_unavailable_code:" + code
  );
}

function assert_hit_miss(run_directory, executable, handle) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "hit", "--window", "" + handle, "--x", "-99999", "--y", "-99999",
    "--depth", "" + HIT_DEPTH, "--max-nodes", "" + HIT_MAX_NODES,
  ]);
  ensure(!flag_at(reply, "ok"), "cu_linux_hit_honesty_miss_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_hit_honesty_miss_code:" + JSON.stringify(reply.error)
  );
  const detail = at(reply, "error.detail");
  ensure(int_at(detail, "window") === handle, "cu_linux_hit_honesty_miss_window:" + JSON.stringify(detail));
  ensure(
    int_at(detail, "visited") > 0 && !flag_at(detail, "truncated"),
    "cu_linux_hit_honesty_miss_walk:" + JSON.stringify(detail)
  );
}

function assert_hit_unavailable_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "hit", "--window", "1", "--x", "1", "--y", "1",
    "--depth", "" + HIT_DEPTH, "--max-nodes", "" + HIT_MAX_NODES,
  ], { AGENTERM_NO_ACTIVATE: "1" });
  ensure(!flag_at(reply, "ok"), "cu_linux_hit_honesty_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_node_not_found" || code === "unsupported" || code === "bad_handle",
    "cu_linux_hit_honesty_unavailable_code:" + code
  );
}

function assert_hit_honesty(run_directory, executable, handle, title, node_name, label) {
  const extents = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", "" + handle, "--name", node_name,
  ]);
  const point = probe_point_from_extents(extents);
  const hit = run_cu(run_directory, executable, "observe", [
    "hit", "--window", "" + handle,
    "--x", "" + point.x, "--y", "" + point.y,
    "--depth", "" + HIT_DEPTH, "--max-nodes", "" + HIT_MAX_NODES,
  ]);
  ensure(
    text_at(hit, "data.resolution") === "bounded-walk-hit-test",
    "cu_linux_hit_honesty_resolution_" + label + ":" + JSON.stringify(hit.data)
  );
  ensure(
    !flag_at(hit, "data.truncated"),
    "cu_linux_hit_honesty_truncated_" + label + ":" + JSON.stringify(hit.data)
  );
  const winner = at(hit, "data.node");
  const containing = at(hit, "data.containing");
  ensure(Array.isArray(containing) && containing.length > 0,
    "cu_linux_hit_honesty_containing_" + label + ":" + JSON.stringify(hit.data));
  ensure(
    containing_includes_winner(containing, winner),
    "cu_linux_hit_honesty_containing_winner_" + label + ":" + JSON.stringify({
      winner: winner,
      containing: containing,
    })
  );
  const probe = independent_named_node(run_directory, title, node_name);
  ensure(
    text_at(winner, "name") === probe.name,
    "cu_linux_hit_honesty_name_" + label + ":" + JSON.stringify({
      hit: winner,
      probe: probe,
    })
  );
  ensure(
    text_at(winner, "role") === probe.role,
    "cu_linux_hit_honesty_role_" + label + ":" + JSON.stringify({
      hit: winner,
      probe: probe,
    })
  );
  ensure(
    !is_structural_role(text_at(winner, "role")),
    "cu_linux_hit_honesty_ranking_" + label + ":" + JSON.stringify({
      winner: winner,
      containing: containing,
    })
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-hit-honesty");
const run_directory = rh.join(repo, "target/cu-linux-hit-honesty-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_hit_honesty_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP hit typed-fails usage when --window handle is zero");
  assert_hit_usage_limit(run_directory, executable);

  print("STEP hit typed-fails usage when AT-SPI --name/--coords/--bogus is present");
  assert_hit_atspi_name_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected) before hit observe/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before hit observe/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP typed host-limit when independent pyatspi desktop probe is unavailable");
    assert_hit_unavailable_when_atspi_absent(run_directory, executable);
    succeeded = 1;
  } else {
    print("STEP start owned GTK fixture and resolve window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "ok") && flag_at(window_wait, "data.met"), "cu_linux_hit_honesty_window_wait");

    const inventory_row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(inventory_row !== null, "cu_linux_hit_honesty_window_identity");
    const handle = int_at(inventory_row, "handle");
    ensure(handle > 0, "cu_linux_hit_honesty_handle:" + JSON.stringify(inventory_row));

    print("STEP hit typed-fails a11y_node_not_found when the point is outside every node bounds");
    assert_hit_miss(run_directory, executable, handle);

    for (let index = 0; index < NAMED_NODES.length; index = index + 1) {
      const node_name = NAMED_NODES[index];
      print("STEP hit --window point from get-extents --name " + node_name
        + " ranks the named control and agrees with independent AT-SPI name/role");
      assert_hit_honesty(
        run_directory, executable, handle, fixture_title, node_name, "node_" + index
      );
    }

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-hit-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux hit --window with typed hit/get-extents --name/--coords/--bogus usage_rejects_unexpected and get-extents --name host-limit honesty plus independent AT-SPI name/role read-back (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux hit typed hit/get-extents --name/--coords/--bogus usage_rejects_unexpected with get-extents --name host-limit when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
