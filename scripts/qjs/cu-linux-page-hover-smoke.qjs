// CEO: Linux CDP page-hover honesty — hover a page control; prove CSS :hover,
// title, and computed style change via independent page-js read-back.
// Typed page-hover usage must reject AT-SPI --name, --coords, --bogus, and other
// unexpected arguments (usage_rejects_unexpected); typed get-extents --name
// usage AND host-limit paths must both hold before the page-hover
// actuate/read-back court, including get-extents --coords/--bogus command=usage
// honesty. Typed usage and host-limit paths must hold when coordinates are
// missing, invalid, or the viewport point misses rendered content; a free port
// must typed-fail before any owned Chrome exists. Prefer host-limit clarity
// over fake success. Distinct from AT-SPI hover→click. Disposable Chrome
// profile; AT-SPI/--name only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-cdp-page-hover-readback",
];

const AT_SPI_PROBE_NAME = "Page Hover Court Anchor";

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  const trimmed = output.stdout.trim();
  harness.require(trimmed !== "", "cu_linux_page_hover_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  harness.require(output_success(document), "cu_linux_page_hover_reply:" + JSON.stringify(document));
  return document;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function assert_page_hover_unexpected_flag(
  run_directory, executable, env, arguments, label, token
) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", arguments, env);
  harness.require(
    !output_success(reply),
    "cu_linux_page_hover_usage_" + label + "_ok:" + JSON.stringify(reply)
  );
  harness.require(
    text_at(reply, "error.code") === "usage",
    "cu_linux_page_hover_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  harness.require(
    text_at(reply, "command") === "usage",
    "cu_linux_page_hover_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  harness.require(
    usage_rejects_unexpected(text_at(reply, "error.message"), token),
    "cu_linux_page_hover_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_page_hover_unexpected_usage(run_directory, executable, env, port) {
  const base = [
    "page-hover", "--port", "" + port, "--target-id", "unused",
    "--x", "10", "--y", "10",
  ];
  assert_page_hover_unexpected_flag(
    run_directory, executable, env,
    base.concat(["--name", AT_SPI_PROBE_NAME]),
    "flat_name", "--name"
  );
  assert_page_hover_unexpected_flag(
    run_directory, executable, env,
    ["page", "hover", "--port", "" + port, "--target-id", "unused",
      "--x", "10", "--y", "10", "--name", AT_SPI_PROBE_NAME],
    "grouped_name", "--name"
  );
  assert_page_hover_unexpected_flag(
    run_directory, executable, env,
    base.concat(["--bogus"]),
    "flat_bogus", "--bogus"
  );
  assert_page_hover_unexpected_flag(
    run_directory, executable, env,
    ["page", "hover", "--port", "" + port, "--target-id", "unused",
      "--x", "10", "--y", "10", "--bogus"],
    "grouped_bogus", "--bogus"
  );
  assert_page_hover_unexpected_flag(
    run_directory, executable, env,
    base.concat(["--coords", "10,10"]),
    "flat_coords", "--coords"
  );
  assert_page_hover_unexpected_flag(
    run_directory, executable, env,
    ["page", "hover", "--port", "" + port, "--target-id", "unused",
      "--x", "10", "--y", "10", "--coords", "10,10"],
    "grouped_coords", "--coords"
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  harness.require(!output_success(zero_handle),
    "cu_linux_page_hover_extents_usage_ok:" + JSON.stringify(zero_handle));
  harness.require(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_page_hover_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  harness.require(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_page_hover_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1",
  ], env);
  harness.require(!output_success(missing_name),
    "cu_linux_page_hover_extents_usage_name_ok:" + JSON.stringify(missing_name));
  harness.require(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_page_hover_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  harness.require(
    text_at(missing_name, "command") === "usage",
    "cu_linux_page_hover_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  harness.require(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_page_hover_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  harness.require(!output_success(extents_coords),
    "cu_linux_page_hover_extents_coords_ok:" + JSON.stringify(extents_coords));
  harness.require(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_page_hover_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  harness.require(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_page_hover_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  harness.require(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_page_hover_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  harness.require(!output_success(extents_bogus),
    "cu_linux_page_hover_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  harness.require(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_page_hover_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  harness.require(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_page_hover_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  harness.require(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_page_hover_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  harness.require(!output_success(reply),
    "cu_linux_page_hover_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  harness.require(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_page_hover_extents_unavailable_code:" + code
  );
}

function assert_page_hover_usage_limit(run_directory, executable, env, port) {
  const missing_xy = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-hover", "--port", "" + port, "--target-id", "unused",
  ], env);
  harness.require(!output_success(missing_xy), "cu_linux_page_hover_usage_ok:" + JSON.stringify(missing_xy));
  harness.require(
    text_at(missing_xy, "error.code") === "usage",
    "cu_linux_page_hover_usage_code:" + JSON.stringify(missing_xy.error)
  );
  harness.require(
    text_at(missing_xy, "error.message").indexOf("--x") >= 0,
    "cu_linux_page_hover_usage_message:" + JSON.stringify(missing_xy.error)
  );

  const missing_y = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-hover", "--port", "" + port, "--target-id", "unused", "--x", "10",
  ], env);
  harness.require(!output_success(missing_y), "cu_linux_page_hover_missing_y_ok:" + JSON.stringify(missing_y));
  harness.require(
    text_at(missing_y, "error.code") === "usage",
    "cu_linux_page_hover_missing_y_code:" + JSON.stringify(missing_y.error)
  );
  harness.require(
    text_at(missing_y, "error.message").indexOf("--y") >= 0,
    "cu_linux_page_hover_missing_y_message:" + JSON.stringify(missing_y.error)
  );

  const bad_x = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-hover", "--port", "" + port, "--target-id", "unused", "--x", "-1", "--y", "10",
  ], env);
  harness.require(!output_success(bad_x), "cu_linux_page_hover_bad_x_ok:" + JSON.stringify(bad_x));
  harness.require(
    text_at(bad_x, "error.code") === "usage",
    "cu_linux_page_hover_bad_x_code:" + JSON.stringify(bad_x.error)
  );
  harness.require(
    text_at(bad_x, "error.message").indexOf("viewport CSS coordinate") >= 0,
    "cu_linux_page_hover_bad_x_message:" + JSON.stringify(bad_x.error)
  );
}

function assert_no_cdp_listener(run_directory, executable, env, port) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-hover", "--port", "" + port, "--target-id", "unused",
    "--x", "10", "--y", "10",
  ], env);
  harness.require(reply.ok !== true, "cu_linux_page_hover_false_success:" + JSON.stringify(reply));
  harness.require(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_page_hover_host_limit_code:" + JSON.stringify(reply)
  );
  const message = text_at(reply, "error.message");
  harness.require(
    message.indexOf("no CDP listener") >= 0 && message.indexOf("" + port) >= 0,
    "cu_linux_page_hover_host_limit_message:" + JSON.stringify(reply.error)
  );
}

function assert_page_hover_miss(run_directory, executable, env, port, target_id) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-hover", "--port", "" + port, "--target-id", target_id,
    "--x", "99999", "--y", "99999",
  ], env);
  harness.require(!output_success(reply), "cu_linux_page_hover_miss_ok:" + JSON.stringify(reply));
  harness.require(
    text_at(reply, "error.code") === "cdp_point_not_found",
    "cu_linux_page_hover_miss_code:" + JSON.stringify(reply.error)
  );
  harness.require(
    text_at(reply, "error.message").indexOf("viewport point") >= 0,
    "cu_linux_page_hover_miss_message:" + JSON.stringify(reply.error)
  );
}

function cdp_ready(run_directory, port) {
  const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  return probe.success === true && probe.stdout.indexOf("Browser") >= 0;
}

function page_target(rows) {
  for (const row of rows) {
    if (text_at(row, "type") === "page") { return row; }
  }
  return null;
}

function center(box) {
  return {
    x: box.x + box.width / 2,
    y: box.y + box.height / 2,
  };
}

const hover_readback_expr = "(function(){"
  + "const btn=document.getElementById('hover-btn');"
  + "if(!btn){return{missing:true};}"
  + "const hovered=Array.from(document.querySelectorAll(':hover'));"
  + "const is_hovered=hovered.some(function(el){return el===btn;});"
  + "const style=getComputedStyle(btn);"
  + "const bg=style.backgroundColor;"
  + "return{"
  + "is_hovered:is_hovered,"
  + "hover_count:hovered.length,"
  + "background:bg,"
  + "title:btn.getAttribute('title'),"
  + "hover_green:bg==='rgb(0, 128, 0)',"
  + "baseline_gray:bg==='rgb(200, 200, 200)'"
  + "};"
  + "})()";

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
harness.require(direct_file(executable), "cu_linux_page_hover_executable_missing:" + executable);
harness.require(direct_file(abi_library), "cu_linux_page_hover_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-page-hover");
const run_directory = context.run_directory;
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_title = "CEO CDP Hover " + context.run_id;
const tooltip = "CEO hover tooltip " + context.run_id;
const fixture = rh.join(run_directory, "cdp-hover.html");
const fixture_html = "<!DOCTYPE html><html><head><title>"
  + fixture_title + "</title><style>"
  + "#hover-btn{display:block;width:200px;height:60px;margin:40px;background-color:rgb(200,200,200);}"
  + "#hover-btn:hover{background-color:rgb(0,128,0);}"
  + "</style></head><body>"
  + "<button id='hover-btn' title='" + tooltip + "'>Hover me</button>"
  + "</body></html>";
rh.write_text(fixture, fixture_html);

const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
const port = 9600 + (rh.pid() % 500);
let chrome_child = -1;
let succeeded = 0;
let failure = "";

try {
  const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  harness.require(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
    "cu_linux_page_hover_port_in_use:" + port);

  print("STEP typed usage limits reject missing or invalid --x/--y before Chrome starts");
  assert_page_hover_usage_limit(run_directory, executable, env, port);

  print("STEP page-hover typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_page_hover_unexpected_usage(run_directory, executable, env, port);

  print("STEP page-hover typed-fails no CDP listener on the owned free port before Chrome starts");
  assert_no_cdp_listener(run_directory, executable, env, port);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before page-hover actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before page-hover actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; page-hover read-back still uses independent page-js");
  }

  print("STEP launch owned Chrome with CDP port and a disposable file:// tab");
  chrome_child = harness.start({
    program: launcher,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--new-window",
      "about:blank",
    ],
    current_dir: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  for (let attempt = 0; attempt < 80 && !cdp_ready(run_directory, port); attempt = attempt + 1) {
    harness.sleep_ms(250);
  }
  harness.require(cdp_ready(run_directory, port), "cu_linux_page_hover_cdp_not_ready:" + port);

  const targets = run_cu(run_directory, executable, "observe", [
    "page-targets", "--port", "" + port,
  ], env);
  const target = page_target(targets.data.targets);
  harness.require(target !== null && text_at(target, "id") !== "", "cu_linux_page_hover_target_missing");
  const target_id = text_at(target, "id");

  print("STEP page-nav loads the disposable hover fixture");
  const nav = run_cu(run_directory, executable, "observe,actuate", [
    "page-nav", "--port", "" + port, "--target-id", target_id,
    "--url", "file://" + fixture, "--wait-ms", "10000",
  ], env);
  harness.require(
    flag_at(nav, "data.verified") && text_at(nav, "data.final_title") === fixture_title,
    "cu_linux_page_hover_nav:" + JSON.stringify(nav.data)
  );

  print("STEP page-find locates the hover button and its viewport box");
  const found = run_cu(run_directory, executable, "observe", [
    "page-find", "--port", "" + port, "--target-id", target_id, "--selector", "#hover-btn",
  ], env);
  const found_nodes = at(found, "data.nodes");
  harness.require(
    at(found, "data.returned") === 1
      && found_nodes !== undefined
      && found_nodes.length === 1
      && at(found_nodes[0], "box.width") > 0
      && at(found_nodes[0], "box.height") > 0,
    "cu_linux_page_hover_find_button:" + JSON.stringify(found.data)
  );
  const button_xy = center(found_nodes[0].box);

  print("STEP independent page-js baseline proves the button is not hovered yet");
  const baseline = run_cu(run_directory, executable, "observe", [
    "page-js", "--port", "" + port, "--target-id", target_id,
    "--expression", hover_readback_expr,
  ], env);
  const baseline_value = at(baseline, "data.value");
  harness.require(
    flag_at(baseline_value, "is_hovered") === false
      && flag_at(baseline_value, "hover_green") === false
      && flag_at(baseline_value, "baseline_gray") === true
      && text_at(baseline_value, "title") === tooltip,
    "cu_linux_page_hover_baseline:" + JSON.stringify(baseline_value)
  );

  print("STEP page-hover dispatches mouseMoved at the button center");
  const hovered = run_cu(run_directory, executable, "observe,actuate", [
    "page-hover", "--port", "" + port, "--target-id", target_id,
    "--x", "" + button_xy.x, "--y", "" + button_xy.y,
  ], env);
  harness.require(
    flag_at(hovered, "data.performed"),
    "cu_linux_page_hover_actuate:" + JSON.stringify(hovered.data)
  );

  print("STEP independent page-js read-back proves :hover CSS and computed style change");
  const readback = run_cu(run_directory, executable, "observe", [
    "page-js", "--port", "" + port, "--target-id", target_id,
    "--expression", hover_readback_expr,
  ], env);
  const readback_value = at(readback, "data.value");
  harness.require(
    flag_at(readback_value, "is_hovered") === true
      && flag_at(readback_value, "hover_green") === true
      && flag_at(readback_value, "baseline_gray") === false
      && at(readback_value, "hover_count") > 0
      && text_at(readback_value, "title") === tooltip,
    "cu_linux_page_hover_readback:" + JSON.stringify(readback_value)
  );

  print("STEP typed miss path rejects a viewport point outside rendered content");
  assert_page_hover_miss(run_directory, executable, env, port, target_id);

  harness.emit_evidence(context, declared_evidence, "cu.linux-cdp-page-hover-readback");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup: " + error); }
}

harness.require(succeeded === 1, failure || "cu_linux_page_hover_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux page-hover usage/host-limit/miss honesty + independent :hover page-js read-back with typed page-hover --name/--coords/--bogus and get-extents --name usage/host-limit plus --coords/--bogus command=usage honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux page-hover usage/host-limit/miss honesty + independent :hover page-js read-back with typed page-hover --name/--coords/--bogus usage and get-extents --name usage/host-limit plus --coords/--bogus command=usage honesty (AT-SPI --name, no --coords)");
}
return;
