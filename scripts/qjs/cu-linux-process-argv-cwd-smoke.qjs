// CEO: Linux process argv/cwd honesty with independent /proc/<pid>/cmdline and cwd read-back.
// Acceptance is smoke read-back only: CU process-argv and process-cwd must agree with argv
// boundaries and working-directory facts derived outside agenterm-cu for the same live PID.
// Typed process-argv and process-cwd usage must reject AT-SPI --name, --coords, --bogus,
// and other unexpected arguments; typed get-extents --name usage AND host-limit paths
// must both hold before the /proc cmdline+cwd read-back court. Prefer host-limit
// clarity over fake success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-argv-readback",
  "cu.linux-process-cwd-readback",
];

const AT_SPI_PROBE_NAME = "Process Argv Cwd Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_argv_cwd_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  const command = text_at(reply, "command");
  ensure(
    command === "process-argv" || command === "process-cwd" || command === "usage",
    "cu_linux_process_argv_cwd_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_argv_cwd_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_unexpected_usage(run_directory, executable, env, arguments, label, token) {
  const reply = invoke_observe_reply(run_directory, executable, arguments, env);
  ensure(!output_success(reply),
    "cu_linux_process_argv_cwd_usage_" + label + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_process_argv_cwd_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_process_argv_cwd_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  ensure(
    usage_rejects_unexpected(text_at(reply, "error.message"), token),
    "cu_linux_process_argv_cwd_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_process_argv_usage_limit(run_directory, executable, env) {
  assert_unexpected_usage(run_directory, executable, env, [
    "process-argv", "--pid", "1", "--name", AT_SPI_PROBE_NAME,
  ], "argv_flat_name", "--name");
  assert_unexpected_usage(run_directory, executable, env, [
    "process", "argv", "--pid", "1", "--name", AT_SPI_PROBE_NAME,
  ], "argv_grouped_name", "--name");
  assert_unexpected_usage(run_directory, executable, env, [
    "process-argv", "--pid", "1", "--coords", "10,10",
  ], "argv_flat_coords", "--coords");
  assert_unexpected_usage(run_directory, executable, env, [
    "process", "argv", "--pid", "1", "--coords", "10,10",
  ], "argv_grouped_coords", "--coords");
  assert_unexpected_usage(run_directory, executable, env, [
    "process-argv", "--pid", "1", "--bogus",
  ], "argv_flat_bogus", "--bogus");
  assert_unexpected_usage(run_directory, executable, env, [
    "process", "argv", "--pid", "1", "--bogus",
  ], "argv_grouped_bogus", "--bogus");
}

function assert_process_cwd_usage_limit(run_directory, executable, env) {
  assert_unexpected_usage(run_directory, executable, env, [
    "process-cwd", "--pid", "1", "--name", AT_SPI_PROBE_NAME,
  ], "cwd_flat_name", "--name");
  assert_unexpected_usage(run_directory, executable, env, [
    "process", "cwd", "--pid", "1", "--name", AT_SPI_PROBE_NAME,
  ], "cwd_grouped_name", "--name");
  assert_unexpected_usage(run_directory, executable, env, [
    "process-cwd", "--pid", "1", "--coords", "10,10",
  ], "cwd_flat_coords", "--coords");
  assert_unexpected_usage(run_directory, executable, env, [
    "process", "cwd", "--pid", "1", "--coords", "10,10",
  ], "cwd_grouped_coords", "--coords");
  assert_unexpected_usage(run_directory, executable, env, [
    "process-cwd", "--pid", "1", "--bogus",
  ], "cwd_flat_bogus", "--bogus");
  assert_unexpected_usage(run_directory, executable, env, [
    "process", "cwd", "--pid", "1", "--bogus",
  ], "cwd_grouped_bogus", "--bogus");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_process_argv_cwd_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_process_argv_cwd_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_process_argv_cwd_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_process_argv_cwd_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_process_argv_cwd_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_process_argv_cwd_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_argv_cwd_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_process_argv_cwd_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_process_argv_cwd_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_process_argv_cwd_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_argv_cwd_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_process_argv_cwd_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_process_argv_cwd_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_process_argv_cwd_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_argv_cwd_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_process_argv_cwd_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_process_argv_cwd_extents_unavailable_code:" + code
  );
}

function verify_readback(run_directory, executable, pid, env) {
  const script = [
    "import json, os, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "def read_cmdline():",
    "    with open(f'/proc/{pid}/cmdline', 'rb') as handle:",
    "        data = handle.read(1024 * 1024 + 1)",
    "    if len(data) > 1024 * 1024:",
    "        raise ValueError('process command line exceeds 1 MiB')",
    "    if data.endswith(b'\\0'):",
    "        data = data[:-1]",
    "    if not data:",
    "        raise ValueError('process arguments are unavailable')",
    "    return [part.decode('utf-8', 'surrogateescape') for part in data.split(b'\\0')]",
    "def read_exe():",
    "    return os.readlink(f'/proc/{pid}/exe')",
    "def read_cwd():",
    "    return os.readlink(f'/proc/{pid}/cwd')",
    "def invoke_argv():",
    "    out = subprocess.check_output(",
    "        [cu, '--target', 'current', '--grant', 'observe',",
    "         'process-argv', '--pid', str(pid), '--values'],",
    "        text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok') or reply.get('command') != 'process-argv':",
    "        raise SystemExit('cu_linux_process_argv_reply_state')",
    "    return reply['data']",
    "def invoke_cwd():",
    "    out = subprocess.check_output(",
    "        [cu, '--target', 'current', '--grant', 'observe',",
    "         'process-cwd', '--pid', str(pid)],",
    "        text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok') or reply.get('command') != 'process-cwd':",
    "        raise SystemExit('cu_linux_process_cwd_reply_state')",
    "    return reply['data']",
    "cmdline = read_cmdline()",
    "proc_exe = read_exe()",
    "proc_cwd = read_cwd()",
    "argv = invoke_argv()",
    "cwd = invoke_cwd()",
    "if argv.get('verified') is not True or cwd.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_argv_cwd_verified')",
    "if int(argv['pid']) != pid or int(cwd['pid']) != pid:",
    "    raise SystemExit('cu_linux_process_argv_cwd_pid')",
    "if argv.get('start_identity') != cwd.get('start_identity'):",
    "    raise SystemExit('cu_linux_process_argv_cwd_start_identity')",
    "if argv.get('executable') != proc_exe:",
    "    raise SystemExit(f'cu_linux_process_argv_executable:{argv.get(\"executable\")}:{proc_exe}')",
    "if int(argv.get('total', -1)) != len(cmdline):",
    "    raise SystemExit(f'cu_linux_process_argv_total:{argv.get(\"total\")}:{len(cmdline)}')",
    "arguments = argv.get('arguments') or []",
    "if len(arguments) != len(cmdline):",
    "    raise SystemExit(f'cu_linux_process_argv_returned:{len(arguments)}:{len(cmdline)}')",
    "for index, row in enumerate(arguments):",
    "    if int(row.get('index', -1)) != index:",
    "        raise SystemExit(f'cu_linux_process_argv_index:{index}:{row.get(\"index\")}')",
    "    if row.get('value') != cmdline[index]:",
    "        raise SystemExit(f'cu_linux_process_argv_value:{index}:{row.get(\"value\")}:{cmdline[index]}')",
    "if cwd.get('provider') != 'linux-proc-cwd':",
    "    raise SystemExit('cu_linux_process_cwd_provider')",
    "if cwd.get('path') != proc_cwd:",
    "    raise SystemExit(f'cu_linux_process_cwd_path:{cwd.get(\"path\")}:{proc_cwd}')",
    "print('pid', pid)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, executable], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_process_argv_cwd_readback:" + output.stderr + output.stdout);
}

function verify_pid(run_directory, executable, pid, env) {
  verify_readback(run_directory, executable, pid, env);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-argv-cwd");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
const self_pid = rh.pid();
let succeeded = 0;
let failure = "";
try {
  print("STEP process-argv/process-cwd typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_process_argv_usage_limit(context.run_directory, executable, env);
  assert_process_cwd_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before /proc cmdline+cwd read-back court");
  assert_get_extents_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before /proc cmdline+cwd read-back court");
  assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; process argv/cwd read-back still uses /proc cmdline, exe and cwd");
  }

  print("STEP process argv/cwd observe matches independent /proc cmdline, exe and cwd read-back for self");
  verify_pid(context.run_directory, executable, self_pid, env);

  print("STEP spawn disposable child in an owned directory and verify --pid read-back");
  const child = harness.start({
    program: "sleep",
    args: ["300"],
    current_dir: context.run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 60000,
  });
  verify_pid(context.run_directory, executable, harness.spawned_pid(child), env);
  harness.kill(child);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-argv-readback");
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-cwd-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux process argv/cwd match independent /proc/<pid>/cmdline and cwd read-back with typed process-argv/process-cwd --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux process argv/cwd match independent /proc/<pid>/cmdline and cwd read-back with typed process-argv/process-cwd --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
