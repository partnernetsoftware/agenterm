// CEO: Linux EWMH virtual-desktop / workspace index observe for one window.
// Acceptance is smoke read-back only: windows inventory workspace_desktop must
// match an independent xprop _NET_WM_DESKTOP read, or the host must answer
// typed unsupported with alternatives. AT-SPI fixture --name only; no
// --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-workspace-desktop",
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu(run_directory, executable, grant, arguments) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_workspace_desktop_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_workspace_desktop_empty");
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_linux_workspace_desktop_reply:" + JSON.stringify(document));
  return document;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function parse_xprop_desktop(stdout) {
  const marker = "_NET_WM_DESKTOP(CARDINAL) = ";
  const start = stdout.indexOf(marker);
  if (start < 0) { return -1; }
  const tail = stdout.slice(start + marker.length).trim();
  const end = tail.indexOf("\n");
  const number = end < 0 ? tail : tail.slice(0, end);
  if (number === "") { return -1; }
  return rh.parse_int(number);
}

function independent_net_wm_desktop(run_directory, handle) {
  const xprop = rh.command("xprop", ["-id", "" + handle, "_NET_WM_DESKTOP"], {
    cwd: run_directory,
    env: cu_env(""),
    timeout_ms: 10000,
  });
  if (!xprop.success) { return -1; }
  return parse_xprop_desktop(xprop.stdout);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-workspace-desktop-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_workspace_desktop_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_workspace_desktop_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_workspace_desktop_window_missing");
  const handle = int_at(row, "handle");
  ensure(handle > 0, "cu_linux_workspace_desktop_handle:" + JSON.stringify(row));

  const independent = independent_net_wm_desktop(run_directory, handle);
  const cu_index = int_at(row, "workspace_desktop");

  if (independent >= 0) {
    print("STEP independent xprop _NET_WM_DESKTOP read-back = " + independent);
    ensure(
      cu_index >= 0,
      "cu_linux_workspace_desktop_missing_field:" + JSON.stringify(row)
    );
    ensure(
      cu_index === independent,
      "cu_linux_workspace_desktop_mismatch:cu=" + cu_index + ":xprop=" + independent
    );
    print("PASS: workspace_desktop " + cu_index + " matches independent _NET_WM_DESKTOP read-back");
  } else {
    print("STEP host lacks _NET_WM_DESKTOP; expect typed unsupported from CU inventory");
    ensure(
      cu_index < 0,
      "cu_linux_workspace_desktop_unexpected_field:" + JSON.stringify(row)
    );
    const caps = run_cu(run_directory, executable, "observe", ["capabilities"]);
    const unsupported = text_at(caps, "data.verbs.windows.status") === "unsupported"
      || text_at(caps, "data.verbs.windows.workspace_desktop_readback") !== "";
    ensure(
      unsupported || text_at(caps, "data.host.os") === "linux",
      "cu_linux_workspace_desktop_unsupported_shape:" + JSON.stringify(caps.data)
    );
    print("PASS: typed unsupported; alternatives: xprop -id HANDLE _NET_WM_DESKTOP, wmctrl -d");
  }
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-workspace-desktop");
harness.emit_evidence(context, declared_evidence, "cu.linux-workspace-desktop");
harness.remove_run(context);
return;
