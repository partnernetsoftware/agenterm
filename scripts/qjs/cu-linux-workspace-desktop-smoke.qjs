// CEO: Linux EWMH virtual-desktop / workspace index observe for one window.
// Acceptance is smoke read-back only: windows inventory workspace_desktop must
// match an independent xprop _NET_WM_DESKTOP read, or the host must answer
// typed unsupported with alternatives. Typed windows/spaces --coords/--bogus
// usage honesty and typed get-extents --name usage/miss/host-limit paths plus
// independent pyatspi extents agreement must hold before the workspace/desktop
// observe court. Named get-extents with --coords/--bogus must reject or stay
// accessibility-tree. spaces answers typed host-limit unsupported on Linux
// (SkyLight; alternatives include windows). Prefer host-limit clarity over
// fake success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-workspace-desktop",
];

const BUTTON_NAME = "Fixture Press";
const MISSING_NODE = "No Such Button";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function usage_message_mentions_unexpected(message) {
  return message.indexOf("--name") >= 0
    || message.indexOf("--coords") >= 0
    || message.indexOf("unexpected") >= 0
    || message.indexOf("--bogus") >= 0;
}

function misuse_code_ok(code) {
  return code === "usage" || code === "invalid_input";
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function output_success(document) { return flag_at(document, "ok"); }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_workspace_desktop_empty:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env, env_remove) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env, env_remove);
  ensure(output_success(document), "cu_linux_workspace_desktop_reply:" + JSON.stringify(document));
  return document;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "0", "--name", BUTTON_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_workspace_desktop_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_workspace_desktop_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_workspace_desktop_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_workspace_desktop_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_workspace_desktop_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_workspace_desktop_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_workspace_desktop_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords), "cu_linux_workspace_desktop_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_workspace_desktop_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_workspace_desktop_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_message_mentions_unexpected(text_at(extents_coords, "error.message")),
    "cu_linux_workspace_desktop_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus), "cu_linux_workspace_desktop_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_workspace_desktop_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_workspace_desktop_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_message_mentions_unexpected(text_at(extents_bogus, "error.message")),
    "cu_linux_workspace_desktop_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_windows_usage_limit(run_directory, executable, env) {
  const with_name = run_cu_reply(run_directory, executable, "observe", [
    "windows", "--name", BUTTON_NAME,
  ], env);
  ensure(!output_success(with_name), "cu_linux_workspace_desktop_windows_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_workspace_desktop_windows_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_workspace_desktop_windows_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_name, "error.message"), "--name"),
    "cu_linux_workspace_desktop_windows_name_message:" + JSON.stringify(with_name.error)
  );

  const with_coords = run_cu_reply(run_directory, executable, "observe", [
    "windows", "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords), "cu_linux_workspace_desktop_windows_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_workspace_desktop_windows_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_workspace_desktop_windows_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_workspace_desktop_windows_coords_message:" + JSON.stringify(with_coords.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, "observe", [
    "windows", "--bogus",
  ], env);
  ensure(!output_success(with_bogus), "cu_linux_workspace_desktop_windows_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_workspace_desktop_windows_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_workspace_desktop_windows_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_workspace_desktop_windows_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_spaces_usage_reject(run_directory, executable, env, extra_args, token, label) {
  const argv = ["spaces"];
  for (const argument of extra_args) { argv.push("" + argument); }
  const reply = run_cu_reply(run_directory, executable, "observe", argv, env);
  ensure(!output_success(reply), "cu_linux_workspace_desktop_spaces_usage_" + label + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_workspace_desktop_spaces_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_workspace_desktop_spaces_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  ensure(
    usage_rejects_unexpected(text_at(reply, "error.message"), token)
      || text_at(reply, "error.message").indexOf("no arguments") >= 0,
    "cu_linux_workspace_desktop_spaces_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_spaces_usage_limit(run_directory, executable, env) {
  assert_spaces_usage_reject(
    run_directory, executable, env, ["--name", BUTTON_NAME], "--name", "name"
  );
  assert_spaces_usage_reject(
    run_directory, executable, env, ["--coords", "0,0"], "--coords", "coords"
  );
  assert_spaces_usage_reject(
    run_directory, executable, env, ["--bogus"], "--bogus", "bogus"
  );
}

function assert_spaces_host_limit(run_directory, executable, env) {
  const reply = run_cu_reply(run_directory, executable, "observe", ["spaces"], env);
  ensure(!output_success(reply), "cu_linux_workspace_desktop_spaces_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_workspace_desktop_spaces_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "spaces",
    "cu_linux_workspace_desktop_spaces_command:" + JSON.stringify(reply)
  );
  ensure(
    text_at(reply, "error.detail.os") === "linux",
    "cu_linux_workspace_desktop_spaces_os:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.limit") === "host",
    "cu_linux_workspace_desktop_spaces_limit:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.required_os") === "macos",
    "cu_linux_workspace_desktop_spaces_required_os:" + JSON.stringify(reply.error)
  );
  const alternatives = at(reply, "error.detail.alternatives");
  ensure(
    alternatives !== undefined && alternatives !== null,
    "cu_linux_workspace_desktop_spaces_alternatives:" + JSON.stringify(reply.error)
  );
  const joined = JSON.stringify(alternatives).toLowerCase();
  ensure(
    joined.indexOf("windows") >= 0,
    "cu_linux_workspace_desktop_spaces_alternatives_windows:" + joined
  );
  print("PASS: spaces typed host-limit unsupported; alternatives include windows inventory workspace_desktop");
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--name", BUTTON_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_workspace_desktop_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_workspace_desktop_extents_unavailable_code:" + code
  );
}

function assert_windows_headless_host_limit(run_directory, executable) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "observe",
    ["windows", "--max", "1"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_workspace_desktop_headless_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_workspace_desktop_headless_code:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("window enumeration") >= 0
      || message.indexOf("mechanism unavailable") >= 0,
    "cu_linux_workspace_desktop_headless_message:" + JSON.stringify(reply.error)
  );
}

function assert_get_extents_missing_node(run_directory, executable, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!output_success(reply), "cu_linux_workspace_desktop_extents_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_workspace_desktop_extents_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_pyatspi_extents(run_directory, executable, fixture_title, node_name) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "want = sys.argv[2]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and w.name == title:",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    if (node.name or '') == want:",
    "        return node",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_workspace_desktop_atspi_no_frame')",
    "node = walk(frame)",
    "if node is None:",
    "    raise SystemExit('cu_linux_workspace_desktop_atspi_miss:' + want)",
    "component = node.queryComponent()",
    "ext = component.getExtents(pyatspi.DESKTOP_COORDS)",
    "x, y, w, h = int(ext.x), int(ext.y), int(ext.width), int(ext.height)",
    "print(json.dumps({",
    "    'name': want,",
    "    'x': x, 'y': y, 'width': w, 'height': h,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, fixture_title, node_name], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_workspace_desktop_pyatspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function assert_get_extents_reject_coords_or_stay_named(
  run_directory, executable, handle, node_name, label
) {
  const extents_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "" + handle, "--name", node_name, "--coords", "10,10",
  ]);
  if (!output_success(extents_coords)) {
    ensure(
      misuse_code_ok(text_at(extents_coords, "error.code"))
        || text_at(extents_coords, "error.code") === "a11y_extents_unavailable",
      "cu_linux_workspace_desktop_extents_coords_code_" + label + ":" + JSON.stringify(extents_coords.error)
    );
  } else {
    ensure(
      text_at(extents_coords, "data.addressing") === "accessibility-tree"
        && text_at(extents_coords, "data.matched.name") === node_name,
      "cu_linux_workspace_desktop_extents_coords_named_" + label + ":" + JSON.stringify(extents_coords.data)
    );
  }

  const extents_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "" + handle, "--name", node_name, "--bogus",
  ]);
  if (!output_success(extents_bogus)) {
    ensure(
      misuse_code_ok(text_at(extents_bogus, "error.code"))
        || text_at(extents_bogus, "error.code") === "a11y_extents_unavailable",
      "cu_linux_workspace_desktop_extents_bogus_code_" + label + ":" + JSON.stringify(extents_bogus.error)
    );
  } else {
    ensure(
      text_at(extents_bogus, "data.addressing") === "accessibility-tree"
        && text_at(extents_bogus, "data.matched.name") === node_name,
      "cu_linux_workspace_desktop_extents_bogus_named_" + label + ":" + JSON.stringify(extents_bogus.data)
    );
  }
}

function assert_get_extents_agreement(run_directory, executable, handle, fixture_title, node_name) {
  const pyatspi_button = independent_pyatspi_extents(
    run_directory, executable, fixture_title, node_name
  );
  const button_extents = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", node_name,
  ]);
  ensure(
    int_at(button_extents, "data.extents.x") === pyatspi_button.x
      && int_at(button_extents, "data.extents.y") === pyatspi_button.y
      && int_at(button_extents, "data.extents.width") === pyatspi_button.width
      && int_at(button_extents, "data.extents.height") === pyatspi_button.height,
    "cu_linux_workspace_desktop_extents_agree:" + JSON.stringify({
      cu: button_extents.data.extents,
      pyatspi_button: pyatspi_button,
    })
  );
}

function parse_xprop_desktop(stdout) {
  const marker = "_NET_WM_DESKTOP(CARDINAL) = ";
  const start = stdout.indexOf(marker);
  if (start < 0) { return -1; }
  const tail = stdout.slice(start + marker.length).trim();
  const end = tail.indexOf("\n");
  const number = end < 0 ? tail : tail.slice(0, end);
  if (number === "") { return -1; }
  return rh.parse_int(number);
}

function independent_net_wm_desktop(run_directory, executable, handle) {
  const xprop = rh.command("xprop", ["-id", "" + handle, "_NET_WM_DESKTOP"], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (!xprop.success) { return -1; }
  return parse_xprop_desktop(xprop.stdout);
}

function assert_workspace_desktop_readback(run_directory, executable, row, handle) {
  const independent = independent_net_wm_desktop(run_directory, executable, handle);
  const cu_index = int_at(row, "workspace_desktop");

  if (independent >= 0) {
    print("STEP independent xprop _NET_WM_DESKTOP read-back = " + independent);
    ensure(
      cu_index >= 0,
      "cu_linux_workspace_desktop_missing_field:" + JSON.stringify(row)
    );
    ensure(
      cu_index === independent,
      "cu_linux_workspace_desktop_mismatch:cu=" + cu_index + ":xprop=" + independent
    );
    print("PASS: workspace_desktop " + cu_index + " matches independent _NET_WM_DESKTOP read-back");
  } else {
    print("STEP host lacks _NET_WM_DESKTOP; expect typed unsupported from CU inventory");
    ensure(
      cu_index < 0,
      "cu_linux_workspace_desktop_unexpected_field:" + JSON.stringify(row)
    );
    const caps = run_cu(run_directory, executable, "observe", ["capabilities"]);
    const unsupported = text_at(caps, "data.verbs.windows.status") === "unsupported"
      || text_at(caps, "data.verbs.windows.workspace_desktop_readback") !== "";
    ensure(
      unsupported || text_at(caps, "data.host.os") === "linux",
      "cu_linux_workspace_desktop_unsupported_shape:" + JSON.stringify(caps.data)
    );
    print("PASS: typed unsupported; alternatives: xprop -id HANDLE _NET_WM_DESKTOP, wmctrl -d");
  }
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_workspace_desktop_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-workspace-desktop");
const run_directory = rh.join(repo, "target/cu-linux-workspace-desktop-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_workspace_desktop_fixture_missing:" + fixture_source);

print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before workspace/desktop observe court");
assert_get_extents_usage_limit(run_directory, executable, env);

print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before workspace/desktop observe court");
assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

print("STEP windows typed-fail usage when AT-SPI --name/--coords/--bogus is present before workspace/desktop observe court");
assert_windows_usage_limit(run_directory, executable, env);

print("STEP windows without DISPLAY typed-fail unsupported host-limit");
assert_windows_headless_host_limit(run_directory, executable);

print("STEP spaces typed-fail usage when AT-SPI --name/--coords/--bogus is present before workspace/desktop observe court");
assert_spaces_usage_limit(run_directory, executable, env);

print("STEP spaces typed-fail unsupported host-limit on Linux (SkyLight) before workspace/desktop observe court");
assert_spaces_host_limit(run_directory, executable, env);

if (!atspi_available) {
  print("STEP independent pyatspi desktop probe unavailable; get-extents host-limit already asserted");
}

let fixture = -1;
let fixture_pid = 0;
let failure = "";

try {
  print("STEP start owned GTK fixture and resolve window by pid and exact title");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_workspace_desktop_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_workspace_desktop_window_missing");
  const handle = int_at(row, "handle");
  ensure(handle > 0, "cu_linux_workspace_desktop_handle:" + JSON.stringify(row));
  const handle_text = "" + handle;

  if (atspi_available) {
    print("STEP get-extents typed-fail a11y_node_not_found when the named button is missing");
    assert_get_extents_missing_node(run_directory, executable, handle_text, "before_workspace");

    print("STEP get-extents --name with --coords/--bogus rejects or stays accessibility-tree before workspace read-back");
    assert_get_extents_reject_coords_or_stay_named(
      run_directory, executable, handle_text, BUTTON_NAME, "before_workspace"
    );

    print("STEP independent pyatspi extents and CU get-extents --name agree before workspace read-back");
    assert_get_extents_agreement(run_directory, executable, handle_text, fixture_title, BUTTON_NAME);
  }

  print("STEP windows inventory workspace_desktop must match independent xprop read-back");
  assert_workspace_desktop_readback(run_directory, executable, row, handle);
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
}

ensure(failure === "", failure);
harness.emit_evidence(context, declared_evidence, "cu.linux-workspace-desktop");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: workspace_desktop xprop read-back with get-extents --name pyatspi agreement, typed windows/spaces --coords/--bogus usage, spaces host-limit, and get-extents --name usage/miss/host-limit honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: workspace_desktop xprop read-back with typed windows/spaces --coords/--bogus usage, spaces host-limit, and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
}
return;
