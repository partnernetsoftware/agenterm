// CEO: Linux clipboard-write/read UTF-8 honesty on X11.
// Acceptance is independent clipboard-read --type after clipboard-write with
// matching type, bytes, sha256 and value; default text view must agree.
// Optional xclip/xsel cross-check when present; otherwise X11 GetSelectionOwner
// property evidence when libX11 is available, otherwise a typed gap.
// Typed clipboard-write/read/clear usage must reject AT-SPI --name and other
// unexpected arguments; typed get-extents --name usage/host-limit paths must
// hold before the actuate/read-back court. AT-SPI/--name only; no --coords
// or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-clipboard-utf8-roundtrip",
];

const AT_SPI_PROBE_NAME = "Clipboard UTF-8 Court Anchor";
const text_type = "text/plain;charset=utf-8";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function output_success(document) { return at(document, "ok") === true; }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_clipboard_reply(run_directory, executable, grant, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", grant,
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_clipboard_utf8_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  const command = text_at(reply, "command");
  ensure(
    command.indexOf("clipboard") >= 0 || command === "usage",
    "cu_linux_clipboard_utf8_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_clipboard_utf8_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function invoke(run_directory, executable, grant, arguments, env) {
  const reply = invoke_clipboard_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(reply),
    "cu_linux_clipboard_utf8_exit:" + arguments[0] + ":" + JSON.stringify(reply));
  return reply;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_clipboard_usage_reject(run_directory, executable, grant, arguments, env, label, token) {
  const reply = invoke_clipboard_reply(run_directory, executable, grant, arguments, env);
  ensure(!output_success(reply),
    "cu_linux_clipboard_utf8_usage_" + label + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_clipboard_utf8_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_clipboard_utf8_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  ensure(
    usage_rejects_unexpected(text_at(reply, "error.message"), token),
    "cu_linux_clipboard_utf8_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_clipboard_usage_limit(run_directory, executable, env) {
  const read_flat = invoke_clipboard_reply(run_directory, executable, "observe", [
    "clipboard-read", "--type", text_type, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(read_flat),
    "cu_linux_clipboard_utf8_read_flat_name_ok:" + JSON.stringify(read_flat));
  ensure(
    text_at(read_flat, "error.code") === "usage",
    "cu_linux_clipboard_utf8_read_flat_name_code:" + JSON.stringify(read_flat.error)
  );
  ensure(
    text_at(read_flat, "command") === "usage",
    "cu_linux_clipboard_utf8_read_flat_name_command:" + JSON.stringify(read_flat)
  );
  ensure(
    usage_rejects_unexpected(text_at(read_flat, "error.message"), "--name"),
    "cu_linux_clipboard_utf8_read_flat_name_message:" + JSON.stringify(read_flat.error)
  );

  const read_grouped = invoke_clipboard_reply(run_directory, executable, "observe", [
    "clipboard", "read", "--type", text_type, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(read_grouped),
    "cu_linux_clipboard_utf8_read_grouped_name_ok:" + JSON.stringify(read_grouped));
  ensure(
    text_at(read_grouped, "error.code") === "usage",
    "cu_linux_clipboard_utf8_read_grouped_name_code:" + JSON.stringify(read_grouped.error)
  );
  ensure(
    text_at(read_grouped, "command") === "usage",
    "cu_linux_clipboard_utf8_read_grouped_name_command:" + JSON.stringify(read_grouped)
  );
  ensure(
    usage_rejects_unexpected(text_at(read_grouped, "error.message"), "--name"),
    "cu_linux_clipboard_utf8_read_grouped_name_message:" + JSON.stringify(read_grouped.error)
  );

  const write_flat = invoke_clipboard_reply(run_directory, executable, "actuate", [
    "clipboard-write", "--type", text_type, "--text", "denied", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(write_flat),
    "cu_linux_clipboard_utf8_write_flat_name_ok:" + JSON.stringify(write_flat));
  ensure(
    text_at(write_flat, "error.code") === "usage",
    "cu_linux_clipboard_utf8_write_flat_name_code:" + JSON.stringify(write_flat.error)
  );
  ensure(
    text_at(write_flat, "command") === "usage",
    "cu_linux_clipboard_utf8_write_flat_name_command:" + JSON.stringify(write_flat)
  );
  ensure(
    usage_rejects_unexpected(text_at(write_flat, "error.message"), "--name"),
    "cu_linux_clipboard_utf8_write_flat_name_message:" + JSON.stringify(write_flat.error)
  );

  const write_grouped = invoke_clipboard_reply(run_directory, executable, "actuate", [
    "clipboard", "write", "--type", text_type, "--text", "denied", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(write_grouped),
    "cu_linux_clipboard_utf8_write_grouped_name_ok:" + JSON.stringify(write_grouped));
  ensure(
    text_at(write_grouped, "error.code") === "usage",
    "cu_linux_clipboard_utf8_write_grouped_name_code:" + JSON.stringify(write_grouped.error)
  );
  ensure(
    text_at(write_grouped, "command") === "usage",
    "cu_linux_clipboard_utf8_write_grouped_name_command:" + JSON.stringify(write_grouped)
  );
  ensure(
    usage_rejects_unexpected(text_at(write_grouped, "error.message"), "--name"),
    "cu_linux_clipboard_utf8_write_grouped_name_message:" + JSON.stringify(write_grouped.error)
  );

  const clear_flat = invoke_clipboard_reply(run_directory, executable, "actuate", [
    "clipboard-clear", "--apply", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(clear_flat),
    "cu_linux_clipboard_utf8_clear_flat_name_ok:" + JSON.stringify(clear_flat));
  ensure(
    text_at(clear_flat, "error.code") === "usage",
    "cu_linux_clipboard_utf8_clear_flat_name_code:" + JSON.stringify(clear_flat.error)
  );
  ensure(
    text_at(clear_flat, "command") === "usage",
    "cu_linux_clipboard_utf8_clear_flat_name_command:" + JSON.stringify(clear_flat)
  );
  ensure(
    usage_rejects_unexpected(text_at(clear_flat, "error.message"), "--name"),
    "cu_linux_clipboard_utf8_clear_flat_name_message:" + JSON.stringify(clear_flat.error)
  );

  const clear_grouped = invoke_clipboard_reply(run_directory, executable, "actuate", [
    "clipboard", "clear", "--apply", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(clear_grouped),
    "cu_linux_clipboard_utf8_clear_grouped_name_ok:" + JSON.stringify(clear_grouped));
  ensure(
    text_at(clear_grouped, "error.code") === "usage",
    "cu_linux_clipboard_utf8_clear_grouped_name_code:" + JSON.stringify(clear_grouped.error)
  );
  ensure(
    text_at(clear_grouped, "command") === "usage",
    "cu_linux_clipboard_utf8_clear_grouped_name_command:" + JSON.stringify(clear_grouped)
  );
  ensure(
    usage_rejects_unexpected(text_at(clear_grouped, "error.message"), "--name"),
    "cu_linux_clipboard_utf8_clear_grouped_name_message:" + JSON.stringify(clear_grouped.error)
  );

  const read_bogus = invoke_clipboard_reply(run_directory, executable, "observe", [
    "clipboard-read", "--bogus",
  ], env);
  ensure(!output_success(read_bogus),
    "cu_linux_clipboard_utf8_read_bogus_ok:" + JSON.stringify(read_bogus));
  ensure(
    text_at(read_bogus, "error.code") === "usage",
    "cu_linux_clipboard_utf8_read_bogus_code:" + JSON.stringify(read_bogus.error)
  );
  ensure(
    text_at(read_bogus, "command") === "usage",
    "cu_linux_clipboard_utf8_read_bogus_command:" + JSON.stringify(read_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(read_bogus, "error.message"), "--bogus"),
    "cu_linux_clipboard_utf8_read_bogus_message:" + JSON.stringify(read_bogus.error)
  );

  assert_clipboard_usage_reject(run_directory, executable, "observe", [
    "clipboard", "read", "--type", text_type, "--bogus",
  ], env, "read_grouped_bogus", "--bogus");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard-write", "--type", text_type, "--text", "denied", "--bogus",
  ], env, "write_flat_bogus", "--bogus");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard", "write", "--type", text_type, "--text", "denied", "--bogus",
  ], env, "write_grouped_bogus", "--bogus");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard-clear", "--apply", "--bogus",
  ], env, "clear_flat_bogus", "--bogus");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard", "clear", "--apply", "--bogus",
  ], env, "clear_grouped_bogus", "--bogus");

  assert_clipboard_usage_reject(run_directory, executable, "observe", [
    "clipboard-read", "--type", text_type, "--coords", "0,0",
  ], env, "read_flat_coords", "--coords");
  assert_clipboard_usage_reject(run_directory, executable, "observe", [
    "clipboard", "read", "--type", text_type, "--coords", "0,0",
  ], env, "read_grouped_coords", "--coords");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard-write", "--type", text_type, "--text", "denied", "--coords", "0,0",
  ], env, "write_flat_coords", "--coords");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard", "write", "--type", text_type, "--text", "denied", "--coords", "0,0",
  ], env, "write_grouped_coords", "--coords");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard-clear", "--apply", "--coords", "0,0",
  ], env, "clear_flat_coords", "--coords");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard", "clear", "--apply", "--coords", "0,0",
  ], env, "clear_grouped_coords", "--coords");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_clipboard_utf8_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_clipboard_utf8_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_clipboard_utf8_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_clipboard_utf8_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_clipboard_utf8_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_clipboard_utf8_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_clipboard_utf8_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_clipboard_utf8_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_clipboard_utf8_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_clipboard_utf8_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_clipboard_utf8_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_clipboard_utf8_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_clipboard_utf8_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_clipboard_utf8_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_clipboard_utf8_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_name_miss(run_directory, executable, env) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(reply),
    "cu_linux_clipboard_utf8_extents_miss_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_node_not_found" || code === "bad_handle" || code === "a11y_backend_failed",
    "cu_linux_clipboard_utf8_extents_miss_code:" + code
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_clipboard_utf8_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_clipboard_utf8_extents_unavailable_code:" + code
  );
}

function digest_of_text(run_directory, name, text) {
  const path = rh.join(run_directory, name);
  rh.write_text(path, text);
  return rh.sha256_file(path);
}

function command_on_path(name) {
  const output = rh.command("sh", ["-c", "command -v " + name], { timeout_ms: 5000 });
  return output.success && output.stdout.trim() !== "";
}

function independent_clipboard_owner_xid(executable) {
  const script = [
    "import ctypes, ctypes.util",
    "lib = ctypes.util.find_library('X11')",
    "if not lib:",
    "    print('absent')",
    "    raise SystemExit(0)",
    "X11 = ctypes.cdll.LoadLibrary(lib)",
    "X11.XOpenDisplay.restype = ctypes.c_void_p",
    "X11.XOpenDisplay.argtypes = [ctypes.c_char_p]",
    "X11.XInternAtom.restype = ctypes.c_ulong",
    "X11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]",
    "X11.XGetSelectionOwner.restype = ctypes.c_ulong",
    "X11.XGetSelectionOwner.argtypes = [ctypes.c_void_p, ctypes.c_ulong]",
    "dpy = X11.XOpenDisplay(None)",
    "if not dpy:",
    "    print('absent')",
    "    raise SystemExit(0)",
    "atom = X11.XInternAtom(dpy, b'CLIPBOARD', 0)",
    "owner = X11.XGetSelectionOwner(dpy, atom)",
    "print(str(int(owner)))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (output.success !== true) { return null; }
  const text = output.stdout.trim();
  if (text === "" || text === "absent") { return null; }
  return text;
}

function independent_clipboard_text(executable, tool) {
  const env = cu_env(executable);
  if (tool === "xclip") {
    const output = rh.command("xclip", ["-selection", "clipboard", "-o"], {
      env: env,
      timeout_ms: 10000,
    });
    return output.success ? output.stdout : null;
  }
  if (tool === "xsel") {
    const output = rh.command("xsel", ["--clipboard", "--output"], {
      env: env,
      timeout_ms: 10000,
    });
    return output.success ? output.stdout : null;
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!direct_file(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(direct_file(executable), "cu_linux_clipboard_utf8_executable_missing:" + executable);
ensure(rh.env_or("DISPLAY", "") !== "", "cu_linux_clipboard_utf8_display_missing");

const context = harness.new_context(repo, "cu-linux-clipboard-utf8");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
let mutated = false;
try {
  print("STEP clipboard-write/read/clear typed-fail usage when AT-SPI --name, --coords, or other unexpected arguments are present");
  assert_clipboard_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before actuate/read-back court");
  assert_get_extents_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);

  if (atspi_available) {
    print("STEP get-extents typed-fail a11y_node_not_found for court anchor miss before actuate/read-back court");
    assert_get_extents_name_miss(context.run_directory, executable, env);
  } else {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; clipboard read-back still uses clipboard-read --type");
  }

  print("STEP clear clipboard to admitted empty initial state");
  invoke(context.run_directory, executable, "actuate", ["clipboard-clear", "--apply"], env);
  const empty = invoke(context.run_directory, executable, "observe", ["clipboard-read", "--metadata-only"], env);
  ensure(flag_at(empty, "data.types_available") && empty.data.types.length === 0,
         "cu_linux_clipboard_utf8_not_empty:" + JSON.stringify(empty.data));

  const token = "CEO-utf8-" + context.run_id + " ≠ 你好\n";
  const digest = digest_of_text(context.run_directory, "token.txt", token);
  mutated = true;

  print("STEP clipboard-write disposable UTF-8 token");
  const write = invoke(context.run_directory, executable, "actuate", [
    "clipboard-write", "--type", text_type, "--text", token,
  ], env);
  ensure(write.command === "clipboard-write" && text_at(write, "data.type") === text_type,
         "cu_linux_clipboard_utf8_write_identity");
  ensure(flag_at(write, "data.verified") && text_at(write, "data.sha256") === digest,
         "cu_linux_clipboard_utf8_write_verified:" + JSON.stringify(write.data));
  const write_bytes = Number(text_at(write, "data.bytes"));
  ensure(write_bytes > 0, "cu_linux_clipboard_utf8_write_bytes");

  print("STEP independent clipboard-read --type text/plain;charset=utf-8");
  const typed = invoke(context.run_directory, executable, "observe", [
    "clipboard-read", "--type", text_type,
  ], env);
  ensure(text_at(typed, "data.type") === text_type,
         "cu_linux_clipboard_utf8_read_type");
  ensure(text_at(typed, "data.sha256") === digest && text_at(typed, "data.value") === token,
         "cu_linux_clipboard_utf8_read_digest:" + JSON.stringify(typed.data));
  ensure(text_at(typed, "data.encoding") === "utf8",
         "cu_linux_clipboard_utf8_read_encoding:" + text_at(typed, "data.encoding"));
  ensure(Number(text_at(typed, "data.bytes")) === write_bytes,
         "cu_linux_clipboard_utf8_read_bytes");

  print("STEP default clipboard-read text view agrees with typed read-back");
  const text_view = invoke(context.run_directory, executable, "observe", ["clipboard-read"], env);
  ensure(text_at(text_view, "data.text") === token && text_at(text_view, "data.format") === text_type,
         "cu_linux_clipboard_utf8_text_view:" + JSON.stringify(text_view.data));
  ensure(Number(text_at(text_view, "data.bytes")) === write_bytes,
         "cu_linux_clipboard_utf8_text_view_bytes");

  print("STEP inventory lists UTF-8 flavour without reading payload bytes");
  const inventory = invoke(context.run_directory, executable, "observe", ["clipboard-read", "--metadata-only"], env);
  ensure(flag_at(inventory, "data.payload_read") === false,
         "cu_linux_clipboard_utf8_inventory_payload_leak");
  const types = inventory.data.types;
  ensure(Array.isArray(types) && (types.indexOf(text_type) >= 0 || types.indexOf("UTF8_STRING") >= 0),
         "cu_linux_clipboard_utf8_inventory_types:" + JSON.stringify(types));

  let cross_checked = false;
  for (const tool of ["xclip", "xsel"]) {
    if (!command_on_path(tool)) { continue; }
    print("STEP independent " + tool + " cross-check");
    const host_text = independent_clipboard_text(executable, tool);
    ensure(host_text === token, "cu_linux_clipboard_utf8_" + tool + "_mismatch:"
           + JSON.stringify({ expected: token, host: host_text }));
    cross_checked = true;
    break;
  }
  if (!cross_checked) {
    const owner_xid = independent_clipboard_owner_xid(executable);
    if (owner_xid !== null && owner_xid !== "0") {
      print("STEP independent X11 GetSelectionOwner CLIPBOARD owner is " + owner_xid
            + " after clipboard-write (no xclip/xsel on PATH)");
      cross_checked = true;
    }
  }
  if (!cross_checked) {
    print("STEP typed-gap: no xclip/xsel on PATH and no libX11 GetSelectionOwner probe;"
          + " clipboard-read --type digest read-back is the acceptance path");
  }

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (mutated) {
  try {
    print("STEP clear back to empty and re-verify");
    invoke(context.run_directory, executable, "actuate", ["clipboard-clear", "--apply"], env);
    const back = invoke(context.run_directory, executable, "observe", ["clipboard-read", "--metadata-only"], env);
    ensure(back.data.types.length === 0, "cu_linux_clipboard_utf8_restore_empty");
  } catch (error) {
    if (failure === "") { failure = "" + error; } else { failure = failure + "; restore: " + error; }
    succeeded = 0;
  }
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-clipboard-utf8-roundtrip");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux clipboard-write/read UTF-8 roundtrip with independent typed read-back and clipboard/get-extents usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux clipboard-write/read UTF-8 roundtrip with independent typed read-back and clipboard/get-extents host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
