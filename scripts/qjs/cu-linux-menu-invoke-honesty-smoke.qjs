// CEO: Linux menu-invoke honesty with independent pyatspi action/state read-back.
// Acceptance is smoke read-back only: CU menu invoke on a disposable GTK menubar
// must change observable fixture state that an independent AT-SPI probe agrees
// with, refuse disabled items typed without side effects, and round-trip a
// checkable item's mark. Typed menu-invoke usage must reject AT-SPI --name,
// --coords, --bogus, and other unexpected arguments via usage_rejects_unexpected
// (or an honest non-usage typed failure; never fake command=usage). Typed
// get-extents --name usage AND host-limit courts must both hold before
// process-state, desktop-state, and the native actuate/read-back court (no
// if/else gating those courts on atspi_available), including get-extents
// --coords/--bogus command=usage. process-state and desktop-state fixture
// binding courts must hold before actuate/read-back. Prefer host-limit clarity
// over fake success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-menu-invoke-readback",
];

const MENU_DEPTH = 1;
const MAX_NODES = 1000;
const AT_SPI_PROBE_NAME = "Menu Invoke Court Anchor";
const FIXTURE_ANCHOR_NAME = "Fixture Press";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}


function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_menu_invoke_honesty_empty:" + output.stderr);
  return JSON.parse(trimmed);
}


function run_cu(run_directory, executable, grant, cu_args) {
  const document = run_cu_reply(run_directory, executable, grant, cu_args);
  ensure(rh.output_success(document), "cu_linux_menu_invoke_honesty_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_menu_invoke_honesty_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function assert_menu_invoke_usage_limit(run_directory, executable, env) {
  const flat_with_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu-invoke", "--window", "1", "--path", "File/Do Thing", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(flat_with_name),
    "cu_linux_menu_invoke_honesty_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_menu_invoke_honesty_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_menu_invoke_honesty_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_name, "error.message"), "--name"),
    "cu_linux_menu_invoke_honesty_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", "1", "--path", "File/Do Thing", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(grouped_with_name),
    "cu_linux_menu_invoke_honesty_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_menu_invoke_honesty_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "command") === "usage",
    "cu_linux_menu_invoke_honesty_usage_grouped_name_command:" + JSON.stringify(grouped_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_name, "error.message"), "--name"),
    "cu_linux_menu_invoke_honesty_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const zero_window = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", "0", "--path", "File/Do Thing",
  ], env);
  ensure(!rh.output_success(zero_window),
    "cu_linux_menu_invoke_honesty_usage_zero_window_ok:" + JSON.stringify(zero_window));
  ensure(
    text_at(zero_window, "error.code") === "usage",
    "cu_linux_menu_invoke_honesty_usage_zero_window_code:" + JSON.stringify(zero_window.error)
  );
  ensure(
    text_at(zero_window, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_menu_invoke_honesty_usage_zero_window_message:" + JSON.stringify(zero_window.error)
  );

  const flat_with_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu-invoke", "--window", "1", "--path", "File/Do Thing", "--bogus",
  ], env);
  ensure(!rh.output_success(flat_with_bogus),
    "cu_linux_menu_invoke_honesty_usage_flat_bogus_ok:" + JSON.stringify(flat_with_bogus));
  ensure(
    text_at(flat_with_bogus, "error.code") === "usage",
    "cu_linux_menu_invoke_honesty_usage_flat_bogus_code:" + JSON.stringify(flat_with_bogus.error)
  );
  ensure(
    text_at(flat_with_bogus, "command") === "usage",
    "cu_linux_menu_invoke_honesty_usage_flat_bogus_command:" + JSON.stringify(flat_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_bogus, "error.message"), "--bogus"),
    "cu_linux_menu_invoke_honesty_usage_flat_bogus_message:" + JSON.stringify(flat_with_bogus.error)
  );

  const grouped_with_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", "1", "--path", "File/Do Thing", "--bogus",
  ], env);
  ensure(!rh.output_success(grouped_with_bogus),
    "cu_linux_menu_invoke_honesty_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_menu_invoke_honesty_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    text_at(grouped_with_bogus, "command") === "usage",
    "cu_linux_menu_invoke_honesty_usage_grouped_bogus_command:" + JSON.stringify(grouped_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_bogus, "error.message"), "--bogus"),
    "cu_linux_menu_invoke_honesty_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const flat_with_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu-invoke", "--window", "1", "--path", "File/Do Thing", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(flat_with_coords),
    "cu_linux_menu_invoke_honesty_usage_flat_coords_ok:" + JSON.stringify(flat_with_coords));
  ensure(
    text_at(flat_with_coords, "error.code") === "usage",
    "cu_linux_menu_invoke_honesty_usage_flat_coords_code:" + JSON.stringify(flat_with_coords.error)
  );
  ensure(
    text_at(flat_with_coords, "command") === "usage",
    "cu_linux_menu_invoke_honesty_usage_flat_coords_command:" + JSON.stringify(flat_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_coords, "error.message"), "--coords"),
    "cu_linux_menu_invoke_honesty_usage_flat_coords_message:" + JSON.stringify(flat_with_coords.error)
  );

  const grouped_with_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", "1", "--path", "File/Do Thing", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(grouped_with_coords),
    "cu_linux_menu_invoke_honesty_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_menu_invoke_honesty_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    text_at(grouped_with_coords, "command") === "usage",
    "cu_linux_menu_invoke_honesty_usage_grouped_coords_command:" + JSON.stringify(grouped_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_coords, "error.message"), "--coords"),
    "cu_linux_menu_invoke_honesty_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_menu_invoke_honesty_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_menu_invoke_honesty_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_menu_invoke_honesty_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_menu_invoke_honesty_extents_missing_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_menu_invoke_honesty_extents_missing_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_menu_invoke_honesty_extents_missing_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_menu_invoke_honesty_extents_missing_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_menu_invoke_honesty_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_menu_invoke_honesty_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_menu_invoke_honesty_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_menu_invoke_honesty_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_menu_invoke_honesty_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_menu_invoke_honesty_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_menu_invoke_honesty_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_menu_invoke_honesty_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_menu_invoke_honesty_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_menu_invoke_honesty_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_menu_invoke_honesty_extents_unavailable_code:" + code
  );
}

function assert_menu_invoke_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", "1", "--path", "File/Do Thing",
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply), "cu_linux_menu_invoke_honesty_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_menu_invoke_honesty_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle",
    "cu_linux_menu_invoke_honesty_unavailable_code:" + code
  );
  if (code === "a11y_backend_failed") {
    const message = text_at(reply, "error.message").toLowerCase();
    ensure(
      message.indexOf("accessibility") >= 0
        || message.indexOf("address") >= 0
        || message.indexOf("bus") >= 0,
      "cu_linux_menu_invoke_honesty_unavailable_message:" + JSON.stringify(reply.error)
    );
  }
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_menu_invoke_honesty_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_menu_invoke_honesty_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_menu_invoke_honesty_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_menu_invoke_honesty_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_menu_invoke_honesty_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_probe_script() {
  return [
    "import json, sys",
    "import pyatspi",
    "",
    "config = json.loads(sys.argv[1])",
    "title = config['title']",
    "mode = config['mode']",
    "expected = config.get('expected')",
    "menu_depth = int(config.get('menu_depth', 1))",
    "max_nodes = int(config.get('max_nodes', 1000))",
    "",
    "def normalize_role(raw):",
    "    stripped = raw.strip()",
    "    if stripped.startswith('AX'):",
    "        stripped = stripped[2:]",
    "    compact = ''.join(ch.lower() for ch in stripped if ch.isalnum())",
    "    return 'button' if compact == 'pushbutton' else compact",
    "",
    "def node_name(obj):",
    "    try: return obj.name or ''",
    "    except Exception: return ''",
    "",
    "def node_role(obj):",
    "    try:",
    "        rn = obj.getRoleName()",
    "        if rn and rn.strip(): return normalize_role(rn)",
    "    except Exception: pass",
    "    return normalize_role(pyatspi.role.getName(obj.getRole()))",
    "",
    "def state_labels(obj):",
    "    labels = []",
    "    st = obj.getState()",
    "    for attr in dir(pyatspi):",
    "        if not attr.startswith('STATE_') or attr in ('STATE_LAST_DEFINED', 'STATE_VALUE_TO_NAME'):",
    "            continue",
    "        if st.contains(getattr(pyatspi, attr)):",
    "            labels.append(attr[6:].lower())",
    "    return labels",
    "",
    "def has_state(labels, word): return word in labels",
    "",
    "def find_frame():",
    "    desktop = pyatspi.Registry.getDesktop(0)",
    "    for index in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(index)",
    "        if app is None:",
    "            continue",
    "        for child_index in range(app.childCount):",
    "            window = app.getChildAtIndex(child_index)",
    "            if window is not None and (window.name or '') == title:",
    "                return window",
    "    return None",
    "",
    "def walk_subtree(root, max_depth, budget):",
    "    nodes = []",
    "    queue = [(root, '0', None, 0)]",
    "    while queue and len(nodes) < budget:",
    "        obj, node_id, parent_id, depth = queue.pop(0)",
    "        role = node_role(obj)",
    "        name = node_name(obj)",
    "        states = state_labels(obj)",
    "        nodes.append({",
    "            'id': node_id,",
    "            'parent_id': parent_id,",
    "            'role': role,",
    "            'name': name,",
    "            'states': states,",
    "            'obj': obj,",
    "        })",
    "        if depth >= max_depth: continue",
    "        try: child_count = obj.childCount",
    "        except Exception: continue",
    "        for index in range(child_count):",
    "            try: child = obj.getChildAtIndex(index)",
    "            except Exception: child = None",
    "            if child is None: continue",
    "            queue.append((child, f'{node_id}/{index}', node_id, depth + 1))",
    "    return nodes",
    "",
    "def find_menu_bar(root, budget):",
    "    queue = [(root, 0)]",
    "    visited = 0",
    "    while queue and visited < budget:",
    "        obj, depth = queue.pop(0)",
    "        visited += 1",
    "        if node_role(obj) == 'menubar':",
    "            return obj",
    "        if depth >= 12: continue",
    "        try: child_count = obj.childCount",
    "        except Exception: continue",
    "        for index in range(child_count):",
    "            try: child = obj.getChildAtIndex(index)",
    "            except Exception: child = None",
    "            if child is not None: queue.append((child, depth + 1))",
    "    return None",
    "",
    "def open_file_menu(bar):",
    "    for index in range(bar.childCount):",
    "        try: child = bar.getChildAtIndex(index)",
    "        except Exception: child = None",
    "        if child is None: continue",
    "        if node_name(child) == 'File':",
    "            try:",
    "                if child.doAction(0):",
    "                    return True",
    "            except Exception: pass",
    "    return False",
    "",
    "def menu_label_value(frame, prefix):",
    "    hits = []",
    "    def walk(obj):",
    "        name = node_name(obj)",
    "        if node_role(obj) == 'label' and name.startswith(prefix):",
    "            hits.append(name)",
    "        try: child_count = obj.childCount",
    "        except Exception: child_count = 0",
    "        for index in range(child_count):",
    "            try: child = obj.getChildAtIndex(index)",
    "            except Exception: child = None",
    "            if child is not None: walk(child)",
    "    walk(frame)",
    "    if len(hits) != 1:",
    "        raise SystemExit('cu_linux_menu_invoke_probe_label_count:' + str(len(hits)))",
    "    return hits[0]",
    "",
    "def marked_thing_checked(frame, bar):",
    "    open_file_menu(bar)",
    "    node_depth = 1 + 2 * menu_depth",
    "    nodes = walk_subtree(bar, node_depth, max_nodes)",
    "    for node in nodes:",
    "        if node['name'] == 'Marked Thing' and node['role'] in ('menuitem', 'checkmenuitem'):",
    "            return has_state(node['states'], 'checked')",
    "    raise SystemExit('cu_linux_menu_invoke_probe_marked_missing')",
    "",
    "def menu_item_state(frame, bar, item_name):",
    "    open_file_menu(bar)",
    "    node_depth = 1 + 2 * menu_depth",
    "    nodes = walk_subtree(bar, node_depth, max_nodes)",
    "    for node in nodes:",
    "        if node['name'] == item_name and node['role'] in ('menuitem', 'checkmenuitem'):",
    "            actions = []",
    "            try:",
    "                ai = node['obj'].queryAction()",
    "                for index in range(ai.nActions):",
    "                    actions.append(ai.getName(index))",
    "            except Exception: pass",
    "            return {",
    "                'enabled': has_state(node['states'], 'enabled'),",
    "                'sensitive': has_state(node['states'], 'sensitive'),",
    "                'actions': actions,",
    "            }",
    "    raise SystemExit('cu_linux_menu_invoke_probe_item_missing:' + item_name)",
    "",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_menu_invoke_probe_window_missing')",
    "",
    "if mode == 'menu_label':",
    "    value = menu_label_value(frame, config['prefix'])",
    "elif mode == 'marked_checked':",
    "    bar = find_menu_bar(frame, max_nodes)",
    "    if bar is None:",
    "        raise SystemExit('cu_linux_menu_invoke_probe_menubar_missing')",
    "    value = 'checked' if marked_thing_checked(frame, bar) else 'unchecked'",
    "elif mode == 'menu_item_state':",
    "    bar = find_menu_bar(frame, max_nodes)",
    "    if bar is None:",
    "        raise SystemExit('cu_linux_menu_invoke_probe_menubar_missing')",
    "    value = menu_item_state(frame, bar, config['item_name'])",
    "else:",
    "    raise SystemExit('cu_linux_menu_invoke_probe_mode:' + mode)",
    "",
    "if expected is not None and value != expected:",
    "    raise SystemExit('cu_linux_menu_invoke_probe_mismatch:' + mode + ':' + str(value) + ':' + str(expected))",
    "",
    "print(json.dumps({'mode': mode, 'value': value}))",
  ].join("\n");
}

function independent_probe(run_directory, executable, probe_config) {
  const output = rh.command("python3", [
    "-c", independent_probe_script(), JSON.stringify(probe_config),
  ], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true,
    "cu_linux_menu_invoke_honesty_probe:" + output.stderr + output.stdout);
  const document = JSON.parse(output.stdout.trim());
  ensure(
    typeof document.value === "string"
      || typeof document.value === "boolean"
      || typeof document.value === "object",
    "cu_linux_menu_invoke_honesty_probe_shape:" + JSON.stringify(document)
  );
  return document;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(rh.is_direct_file(executable), "cu_linux_menu_invoke_honesty_executable_missing");

const uname = rh.command("/usr/bin/uname", ["-s"], { timeout_ms: 10000 });
ensure(uname.success === true && uname.stdout.trim() === "Linux",
  "cu_linux_menu_invoke_honesty_requires_linux");

const context = harness.new_context(repo, "cu-linux-menu-invoke-honesty");
const run_directory = rh.join(repo, "target/cu-linux-menu-invoke-honesty-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(rh.is_direct_file(fixture_source), "cu_linux_menu_invoke_honesty_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP menu invoke typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present (usage_rejects_unexpected or honest non-usage typed failure; never fake command=usage)");
  assert_menu_invoke_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before process-state/desktop-state and menu invoke actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and menu invoke actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP menu invoke typed-fail host-limit on invalid AT-SPI bus before process-state/desktop-state and menu invoke actuate/read-back court");
  assert_menu_invoke_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held; process-state/desktop-state courts still run before actuate/read-back when fixture starts");
  }

  print("STEP start owned GTK fixture and resolve one window handle");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_menu_invoke_honesty_window_wait");

  const inventory_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(inventory_row !== null, "cu_linux_menu_invoke_honesty_inventory_missing");
  const handle = int_at(inventory_row, "handle");
  ensure(handle > 0, "cu_linux_menu_invoke_honesty_handle:" + JSON.stringify(inventory_row));
  const handle_text = "" + handle;

  print("STEP get-extents --name locates the fixture anchor before process-state/desktop-state and menu invoke actuate/read-back court");
  const anchor_extents = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", handle_text, "--name", FIXTURE_ANCHOR_NAME,
  ]);
  ensure(
    text_at(anchor_extents, "data.matched.name") === FIXTURE_ANCHOR_NAME
      && int_at(anchor_extents, "data.extents.width") > 0
      && int_at(anchor_extents, "data.extents.height") > 0,
    "cu_linux_menu_invoke_honesty_extents_before_invoke:" + JSON.stringify(anchor_extents.data)
  );

  print("STEP process-state binds the owned fixture pid before menu invoke actuate/read-back court");
  assert_fixture_process_state(run_directory, executable, fixture_pid);

  print("STEP desktop-state window row agrees with inventory before menu invoke actuate/read-back court");
  assert_fixture_desktop_state(
    run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
  );

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable; process-state/desktop-state binding courts held; actuate/read-back court skipped");
    succeeded = 1;
  } else {
  print("STEP independent AT-SPI read-back reports menu label before invoke");
  const menu_before = independent_probe(run_directory, executable, {
    title: fixture_title,
    mode: "menu_label",
    prefix: "menu idle",
    expected: "menu idle",
    menu_depth: MENU_DEPTH,
    max_nodes: MAX_NODES,
  });
  ensure(menu_before.value === "menu idle", "cu_linux_menu_invoke_honesty_menu_before");

  print("STEP independent AT-SPI read-back reports enabled and disabled menu item action/state");
  const do_thing_state = independent_probe(run_directory, executable, {
    title: fixture_title,
    mode: "menu_item_state",
    item_name: "Do Thing",
    menu_depth: MENU_DEPTH,
    max_nodes: MAX_NODES,
  });
  ensure(
    do_thing_state.value.enabled === true && do_thing_state.value.sensitive === true,
    "cu_linux_menu_invoke_honesty_do_thing_state:" + JSON.stringify(do_thing_state.value)
  );
  ensure(
    do_thing_state.value.actions.indexOf("click") >= 0,
    "cu_linux_menu_invoke_honesty_do_thing_action:" + JSON.stringify(do_thing_state.value)
  );
  const disabled_state = independent_probe(run_directory, executable, {
    title: fixture_title,
    mode: "menu_item_state",
    item_name: "Disabled Thing",
    menu_depth: MENU_DEPTH,
    max_nodes: MAX_NODES,
  });
  ensure(
    disabled_state.value.enabled === false && disabled_state.value.sensitive === false,
    "cu_linux_menu_invoke_honesty_disabled_state:" + JSON.stringify(disabled_state.value)
  );

  print("STEP CU menu invoke File/Do Thing and independent label read-back agrees");
  const invoked = run_cu(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", handle_text, "--path", "File/Do Thing",
  ]);
  ensure(
    flag_at(invoked, "data.performed")
      && text_at(invoked, "data.addressing") === "menu-path",
    "cu_linux_menu_invoke_honesty_invoke:" + JSON.stringify(invoked.data)
  );
  const menu_after = independent_probe(run_directory, executable, {
    title: fixture_title,
    mode: "menu_label",
    prefix: "did thing ",
    expected: "did thing 1",
    menu_depth: MENU_DEPTH,
    max_nodes: MAX_NODES,
  });
  ensure(menu_after.value === "did thing 1", "cu_linux_menu_invoke_honesty_menu_after");

  print("STEP disabled menu item is refused typed and independent label stays unchanged");
  const menu_refused = run_cu_reply(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", handle_text, "--path", "File/Disabled Thing",
  ]);
  ensure(
    !flag_at(menu_refused, "ok") && text_at(menu_refused, "error.code") === "a11y_menu_item_disabled",
    "cu_linux_menu_invoke_honesty_disabled:" + JSON.stringify(menu_refused)
  );
  const menu_unchanged = independent_probe(run_directory, executable, {
    title: fixture_title,
    mode: "menu_label",
    prefix: "did thing ",
    expected: "did thing 1",
    menu_depth: MENU_DEPTH,
    max_nodes: MAX_NODES,
  });
  ensure(menu_unchanged.value === "did thing 1", "cu_linux_menu_invoke_honesty_disabled_side_effect");

  print("STEP checkable menu item round-trips mark through invoke with independent AT-SPI checked state");
  const marked_before = independent_probe(run_directory, executable, {
    title: fixture_title,
    mode: "marked_checked",
    menu_depth: MENU_DEPTH,
    max_nodes: MAX_NODES,
    expected: "unchecked",
  });
  ensure(marked_before.value === "unchecked", "cu_linux_menu_invoke_honesty_mark_before");
  const marked_on = run_cu(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", handle_text, "--path", "File/Marked Thing",
  ]);
  ensure(flag_at(marked_on, "data.performed"), "cu_linux_menu_invoke_honesty_mark_on:" + JSON.stringify(marked_on.data));
  const marked_checked = independent_probe(run_directory, executable, {
    title: fixture_title,
    mode: "marked_checked",
    menu_depth: MENU_DEPTH,
    max_nodes: MAX_NODES,
    expected: "checked",
  });
  ensure(marked_checked.value === "checked", "cu_linux_menu_invoke_honesty_mark_checked");
  const marked_off = run_cu(run_directory, executable, "observe,actuate", [
    "menu", "invoke", "--window", handle_text, "--path", "File/Marked Thing",
  ]);
  ensure(flag_at(marked_off, "data.performed"), "cu_linux_menu_invoke_honesty_mark_off:" + JSON.stringify(marked_off.data));
  const marked_unchecked = independent_probe(run_directory, executable, {
    title: fixture_title,
    mode: "marked_checked",
    menu_depth: MENU_DEPTH,
    max_nodes: MAX_NODES,
    expected: "unchecked",
  });
  ensure(marked_unchecked.value === "unchecked", "cu_linux_menu_invoke_honesty_mark_unchecked");

  succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
}

if (succeeded !== 0) {
  harness.emit_evidence(context, declared_evidence, declared_evidence[0]);
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux menu invoke honesty (CU menu path agrees with independent AT-SPI read-back with typed menu-invoke --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), and process-state/desktop-state courts before actuate (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux menu invoke typed-fails with typed menu-invoke --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), and process-state/desktop-state binding courts before actuate/read-back when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
return;
