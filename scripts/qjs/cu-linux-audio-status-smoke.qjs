// CEO: Linux audio status observe with independent pactl/wpctl/amixer read-back.
// Acceptance is smoke read-back only: CU default-output volume/mute must match
// facts derived outside agenterm-cu, or return typed audio_unsupported with
// linux-default-output alternatives (never macOS CoreAudio, never fake sinks).
// Typed audio usage must reject AT-SPI --name, --coords, --bogus, and other
// unexpected arguments; typed get-extents --name usage AND host-limit paths
// must both hold before the pactl/wpctl/amixer inventory/read-back court.
// Host-limit clarity when the audio bus is absent. Prefer honesty over fake
// success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-audio-status-readback",
];

const AT_SPI_PROBE_NAME = "Audio Status Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function output_success(document) { return flag_at(document, "ok"); }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "PULSE_SERVER",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe", "audio",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_audio_status_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "audio" || text_at(reply, "command") === "usage",
    "cu_linux_audio_status_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_audio_status_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_audio_unexpected(run_directory, executable, env, arguments, label, token) {
  const reply = invoke_reply(run_directory, executable, arguments, env);
  ensure(!output_success(reply),
    "cu_linux_audio_status_usage_" + label + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_audio_status_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_audio_status_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  ensure(
    usage_rejects_unexpected(text_at(reply, "error.message"), token),
    "cu_linux_audio_status_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_audio_usage_limit(run_directory, executable, env) {
  assert_audio_unexpected(run_directory, executable, env,
    ["status", "--name", AT_SPI_PROBE_NAME], "status_name", "--name");
  assert_audio_unexpected(run_directory, executable, env,
    ["plan", "volume", "60", "--name", AT_SPI_PROBE_NAME], "plan_volume_name", "--name");
  assert_audio_unexpected(run_directory, executable, env,
    ["plan", "muted", "true", "--name", AT_SPI_PROBE_NAME], "plan_muted_name", "--name");
  assert_audio_unexpected(run_directory, executable, env,
    ["plan", "volume", "60", "--ttl-seconds", "60", "--name", AT_SPI_PROBE_NAME],
    "plan_ttl_name", "--name");

  assert_audio_unexpected(run_directory, executable, env,
    ["status", "--bogus"], "status_bogus", "--bogus");
  assert_audio_unexpected(run_directory, executable, env,
    ["plan", "volume", "60", "--bogus"], "plan_volume_bogus", "--bogus");
  assert_audio_unexpected(run_directory, executable, env,
    ["plan", "muted", "true", "--bogus"], "plan_muted_bogus", "--bogus");
  assert_audio_unexpected(run_directory, executable, env,
    ["plan", "volume", "60", "--ttl-seconds", "60", "--bogus"],
    "plan_ttl_bogus", "--bogus");

  assert_audio_unexpected(run_directory, executable, env,
    ["status", "--coords", "10,10"], "status_coords", "--coords");
  assert_audio_unexpected(run_directory, executable, env,
    ["plan", "volume", "60", "--coords", "10,10"], "plan_volume_coords", "--coords");
  assert_audio_unexpected(run_directory, executable, env,
    ["plan", "muted", "true", "--coords", "10,10"], "plan_muted_coords", "--coords");
  assert_audio_unexpected(run_directory, executable, env,
    ["plan", "volume", "60", "--ttl-seconds", "60", "--coords", "10,10"],
    "plan_ttl_coords", "--coords");

  const missing_subcommand = invoke_reply(run_directory, executable, [], env);
  ensure(!output_success(missing_subcommand),
    "cu_linux_audio_status_usage_missing_subcommand_ok:" + JSON.stringify(missing_subcommand));
  ensure(
    text_at(missing_subcommand, "error.code") === "usage",
    "cu_linux_audio_status_usage_missing_subcommand_code:" + JSON.stringify(missing_subcommand.error)
  );
  ensure(
    text_at(missing_subcommand, "command") === "usage",
    "cu_linux_audio_status_usage_missing_subcommand_command:" + JSON.stringify(missing_subcommand)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_audio_status_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_audio_status_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_audio_status_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_audio_status_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_audio_status_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_audio_status_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_audio_status_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_audio_status_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_audio_status_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_audio_status_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_audio_status_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_audio_status_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_audio_status_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_audio_status_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_audio_status_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_audio_status_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_audio_status_extents_unavailable_code:" + code
  );
}

function safe_command(program, args, options) {
  try {
    return rh.command(program, args, options);
  } catch (error) {
    return null;
  }
}

function session_bus_connected(env) {
  const output = safe_command("dbus-send", [
    "--session",
    "--dest=org.freedesktop.DBus",
    "--type=method_call",
    "--print-reply",
    "/org/freedesktop/DBus",
    "org.freedesktop.DBus.GetId",
  ], {
    env: env,
    timeout_ms: 10000,
  });
  return output !== null && output.success === true;
}

function split_whitespace(text) {
  const parts = [];
  let current = "";
  for (let index = 0; index < text.length; index = index + 1) {
    const code = text.charCodeAt(index);
    if (code === 9 || code === 10 || code === 13 || code === 32) {
      if (current.length > 0) {
        parts.push(current);
        current = "";
      }
    } else {
      current = current + text.charAt(index);
    }
  }
  if (current.length > 0) { parts.push(current); }
  return parts;
}

function parse_pactl_volume_percent(stdout) {
  const parts = split_whitespace(stdout);
  for (let index = 0; index < parts.length; index = index + 1) {
    const token = parts[index];
    if (token.length > 1 && token.charAt(token.length - 1) === "%") {
      const value = Number(token.slice(0, token.length - 1));
      if (value === value) { return Math.max(0, Math.min(100, Math.round(value))); }
    }
  }
  return -1;
}

function parse_pactl_mute(stdout) {
  const trimmed = stdout.trim();
  if (trimmed.length >= 3 && trimmed.slice(trimmed.length - 3) === "yes") { return true; }
  if (trimmed.length >= 2 && trimmed.slice(trimmed.length - 2) === "no") { return false; }
  return null;
}

function independent_pactl(env) {
  const sink = safe_command("pactl", ["get-default-sink"], { env: env, timeout_ms: 10000 });
  if (sink === null || !sink.success) { return null; }
  const uid = sink.stdout.trim();
  if (uid === "") { return null; }
  const volume = safe_command("pactl", ["get-sink-volume", "@DEFAULT_SINK@"], { env: env, timeout_ms: 10000 });
  const mute = safe_command("pactl", ["get-sink-mute", "@DEFAULT_SINK@"], { env: env, timeout_ms: 10000 });
  if (volume === null || mute === null || !volume.success || !mute.success) { return null; }
  const volume_percent = parse_pactl_volume_percent(volume.stdout);
  const muted = parse_pactl_mute(mute.stdout);
  if (volume_percent < 0 || muted === null) { return null; }
  return {
    mechanism: "pactl",
    provider: "linux-pulse-pactl",
    uid: uid,
    volume: volume_percent,
    muted: muted,
  };
}

function independent_wpctl(env) {
  const volume = safe_command("wpctl", ["get-volume", "@DEFAULT_AUDIO_SINK@"], { env: env, timeout_ms: 10000 });
  const inspect = safe_command("wpctl", ["inspect", "@DEFAULT_AUDIO_SINK@"], { env: env, timeout_ms: 10000 });
  if (volume === null || inspect === null || !volume.success || !inspect.success) { return null; }
  const scalar = Number(split_whitespace(volume.stdout.trim())[0]);
  if (scalar !== scalar) { return null; }
  let muted = false;
  for (const line of inspect.stdout.split("\n")) {
    const trimmed = line.trim();
    if (trimmed.indexOf("mute:") === 0) {
      const value = trimmed.slice("mute:".length).trim();
      muted = value === "true" || value === "yes";
    }
  }
  return {
    mechanism: "wpctl",
    provider: "linux-pipewire-wpctl",
    uid: "default-audio-sink",
    volume: Math.max(0, Math.min(100, Math.round(scalar * 100))),
    muted: muted,
  };
}

function parse_amixer_master(stdout) {
  let volume = -1;
  let muted = false;
  for (const line of stdout.split("\n")) {
    const trimmed = line.trim();
    if (trimmed.indexOf("Front Left:") === 0 || trimmed.indexOf("Mono:") === 0) {
      const start = trimmed.indexOf("[");
      const end = trimmed.indexOf("]", start + 1);
      if (start >= 0 && end > start) {
        const bracket = trimmed.slice(start + 1, end);
        if (bracket.charAt(bracket.length - 1) === "%") {
          const value = Number(bracket.slice(0, bracket.length - 1));
          if (value === value) { volume = Math.max(0, Math.min(100, Math.round(value))); }
        }
      }
    }
    if (trimmed.indexOf("[off]") >= 0) { muted = true; }
    if (trimmed.indexOf("[on]") >= 0) { muted = false; }
  }
  if (volume < 0) { return null; }
  return { volume: volume, muted: muted };
}

function independent_amixer_pulse(env) {
  const output = safe_command("amixer", ["-D", "pulse", "sget", "Master"], { env: env, timeout_ms: 10000 });
  if (output === null || !output.success) { return null; }
  const parsed = parse_amixer_master(output.stdout);
  if (parsed === null) { return null; }
  return {
    mechanism: "amixer-pulse",
    provider: "linux-alsa-amixer-pulse",
    uid: "alsa-master-pulse",
    volume: parsed.volume,
    muted: parsed.muted,
  };
}

function independent_amixer_default(env) {
  const output = safe_command("amixer", ["sget", "Master"], { env: env, timeout_ms: 10000 });
  if (output === null || !output.success) { return null; }
  const parsed = parse_amixer_master(output.stdout);
  if (parsed === null) { return null; }
  return {
    mechanism: "amixer-default",
    provider: "linux-alsa-amixer",
    uid: "alsa-master-default",
    volume: parsed.volume,
    muted: parsed.muted,
  };
}

function independent_audio_probe(env) {
  const probes = [
    independent_pactl(env),
    independent_wpctl(env),
    independent_amixer_pulse(env),
    independent_amixer_default(env),
  ];
  for (let index = 0; index < probes.length; index = index + 1) {
    if (probes[index] !== null) { return probes[index]; }
  }
  return null;
}

function assert_ok_readback(reply, independent) {
  ensure(flag_at(reply, "ok"), "cu_linux_audio_status_ok:" + JSON.stringify(reply));
  const data = rh.field(reply, "data");
  const provider = text_at(data, "provider");
  const state = rh.field(data, "state");
  const settings = rh.field(state, "settings");
  const volume = Number(text_at(settings, "volume"));
  const muted = flag_at(settings, "muted");
  ensure(provider === independent.provider, "cu_linux_audio_status_provider:" + provider + "!=" + independent.provider);
  ensure(provider.indexOf("macos") < 0, "cu_linux_audio_status_no_macos:" + provider);
  ensure(volume === independent.volume, "cu_linux_audio_status_volume:" + volume + "!=" + independent.volume);
  ensure(muted === independent.muted, "cu_linux_audio_status_muted:" + muted + "!=" + independent.muted);
  ensure(text_at(rh.field(state, "device"), "uid") !== "", "cu_linux_audio_status_uid");
}

function at_array(value, key) {
  const current = rh.field(value, key);
  return Array.isArray(current) ? current : [];
}

function assert_unsupported_readback(reply, env) {
  ensure(!flag_at(reply, "ok"), "cu_linux_audio_status_unexpected_ok:" + JSON.stringify(reply));
  ensure(text_at(reply, "error.code") === "audio_unsupported", "cu_linux_audio_status_code:" + JSON.stringify(reply.error));
  const detail = at(reply, "error.detail");
  ensure(text_at(detail, "effect") === "not_performed", "cu_linux_audio_status_effect:" + JSON.stringify(detail));
  ensure(text_at(detail, "required_mechanism") === "linux-default-output", "cu_linux_audio_status_mechanism:" + JSON.stringify(detail));
  ensure(at_array(detail, "alternatives").length > 0, "cu_linux_audio_status_alternatives:" + JSON.stringify(detail));
  ensure(at_array(detail, "probed_mechanisms").length > 0, "cu_linux_audio_status_probed:" + JSON.stringify(detail));
  ensure(typeof at(detail, "session_bus_available") === "boolean", "cu_linux_audio_status_bus:" + JSON.stringify(detail));
  const bus_connected = session_bus_connected(env);
  ensure(flag_at(detail, "session_bus_available") === bus_connected, "cu_linux_audio_status_bus_mismatch:" + bus_connected + ":" + JSON.stringify(detail));
  ensure(JSON.stringify(reply).indexOf("macos-coreaudio") < 0, "cu_linux_audio_status_no_coreaudio_claim");
  ensure(independent_audio_probe(env) === null, "cu_linux_audio_status_independent_should_be_absent");
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "missing_agenterm_cu:" + executable);

const context = harness.new_context(repo, "cu-linux-audio-status");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

print("STEP audio typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
assert_audio_usage_limit(context.run_directory, executable, env);

print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before audio inventory/read-back court");
assert_get_extents_usage_limit(context.run_directory, executable, env);

print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before audio inventory/read-back court");
assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);

print("STEP audio status observe matches independent pactl/wpctl/amixer read-back or typed unsupported");
const independent = independent_audio_probe(env);
const reply = invoke_reply(context.run_directory, executable, ["status"], env);
if (independent !== null) {
  assert_ok_readback(reply, independent);
  harness.emit_evidence(context, declared_evidence, "cu.linux-audio-status-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: CEO Linux audio status with independent " + independent.mechanism
      + " read-back and typed audio/get-extents --name/--coords/--bogus usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: CEO Linux audio status with independent " + independent.mechanism
      + " read-back and typed audio --name/--coords/--bogus usage plus get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
  return;
}
assert_unsupported_readback(reply, env);
harness.emit_evidence(context, declared_evidence, "cu.linux-audio-status-readback");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: CEO Linux audio status typed unsupported with independent probe absence read-back and typed audio/get-extents --name/--coords/--bogus usage/host-limit honesty (AT-SPI --name, no --coords; never fake sinks)");
} else {
  print("PASS: CEO Linux audio status typed unsupported with independent probe absence read-back and typed audio --name/--coords/--bogus usage plus get-extents --name host-limit honesty (AT-SPI --name, no --coords; never fake sinks)");
}
