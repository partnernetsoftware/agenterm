// CEO: prove Linux wait --window-title-contains with Unicode case folding.
// Acceptance: met wait on known GTK title; unmet title exits nonzero;
// independent windows inventory title read-back. Typed wait usage must reject
// AT-SPI --name, --coords, --bogus, and other unexpected arguments; typed
// get-extents --name usage AND host-limit paths must both hold before the
// actuate/read-back court. Prefer host-limit clarity over fake success.
// AT-SPI observe only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE | --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-window-title-contains",
];

const TITLE_TOKEN = "agenterm-title-wait-";
const WAIT_PATTERN = "caf\u00e9 " + TITLE_TOKEN;
const AT_SPI_PROBE_NAME = "Window Title Contains Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    GTK_MODULES: "gail:atk-bridge",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_wait_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_title_contains_wait_cli:" + output.stderr);
  const reply = JSON.parse(trimmed);
  const command = text_at(reply, "command");
  ensure(
    command === "wait" || command === "usage",
    "cu_linux_window_title_contains_wait_command:" + JSON.stringify(reply)
  );
  return reply;
}

function run_cu(run_directory, executable, grant, command_argv, expect_failure, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const item of command_argv) { argv.push("" + item); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_title_contains_empty_stdout:" + output.stderr);
  const reply = JSON.parse(trimmed);
  if (expect_failure === true) {
    ensure(output.success !== true, "cu_linux_window_title_contains_unmet_exit");
    ensure(reply.ok === true && flag_at(reply, "data.met") === false,
      "cu_linux_window_title_contains_unmet_shape:" + JSON.stringify(reply));
    return reply;
  }
  ensure(output.success === true && reply.ok === true,
    "cu_linux_window_title_contains_failed:" + JSON.stringify(reply));
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_window_title_contains_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_wait_unexpected_usage(run_directory, executable, env) {
  const with_name = invoke_wait_reply(run_directory, executable, [
    "wait", "--timeout-ms", "1000",
    "--window", "1",
    "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(with_name),
    "cu_linux_window_title_contains_usage_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_window_title_contains_usage_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_window_title_contains_usage_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_name, "error.message"), "--name")
      || text_at(with_name, "error.message").indexOf("requires one of") >= 0,
    "cu_linux_window_title_contains_usage_name_message:" + JSON.stringify(with_name.error)
  );

  const with_bogus = invoke_wait_reply(run_directory, executable, [
    "wait", "--timeout-ms", "1000", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_window_title_contains_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_window_title_contains_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_window_title_contains_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus")
      || text_at(with_bogus, "error.message").indexOf("requires one of") >= 0,
    "cu_linux_window_title_contains_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_coords = invoke_wait_reply(run_directory, executable, [
    "wait", "--timeout-ms", "1000", "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords),
    "cu_linux_window_title_contains_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_window_title_contains_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_window_title_contains_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords")
      || text_at(with_coords, "error.message").indexOf("requires one of") >= 0,
    "cu_linux_window_title_contains_usage_coords_message:" + JSON.stringify(with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_window_title_contains_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_window_title_contains_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_window_title_contains_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_window_title_contains_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_window_title_contains_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_window_title_contains_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_window_title_contains_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_window_title_contains_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_window_title_contains_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_window_title_contains_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_window_title_contains_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_window_title_contains_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_window_title_contains_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_window_title_contains_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_window_title_contains_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_window_title_contains_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_window_title_contains_extents_unavailable_code:" + code
  );
}

function windows_rows(reply) {
  const data = reply.data;
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function inventory_title_contains(run_directory, executable, pid, needle) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  for (const row of windows_rows(reply)) {
    const title = text_at(row, "title");
    if (title.toLowerCase().indexOf(needle.toLowerCase()) >= 0) {
      return { row: row, title: title };
    }
  }
  return null;
}

const script_argv = rh.args();
if (script_argv.length === 1 && script_argv[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(script_argv.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(script_argv[0]);
const executable = rh.absolute(script_argv[1]);
const context = harness.new_context(repo, "cu-linux-window-title-contains");
const run_directory = rh.join(repo, "target/cu-linux-window-title-contains-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_title_wait_fixture.py");
ensure(direct_file(fixture_source),
  "cu_linux_window_title_contains_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";

try {
  print("STEP wait typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_wait_unexpected_usage(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; window-title-contains read-back still uses windows inventory");
  }

  print("STEP start owned GTK fixture with Unicode café title");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const exact_title = "Caf\u00e9 " + TITLE_TOKEN + fixture_pid;

  print("STEP wait --window-title-contains with lowercase Unicode pattern");
  const waited = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", WAIT_PATTERN + fixture_pid,
  ]);
  ensure(flag_at(waited, "data.met"),
    "cu_linux_window_title_contains_wait_met:" + JSON.stringify(waited.data));

  print("STEP independent windows inventory title read-back");
  const inventory = inventory_title_contains(
    run_directory, executable, fixture_pid, WAIT_PATTERN + fixture_pid
  );
  ensure(inventory !== null, "cu_linux_window_title_contains_inventory_missing");
  ensure(inventory.title === exact_title,
    "cu_linux_window_title_contains_inventory_title:" + inventory.title);
  ensure(parseInt(text_at(inventory.row, "process_id"), 10) === fixture_pid,
    "cu_linux_window_title_contains_inventory_pid");

  print("STEP unmet title must exit nonzero with met=false");
  run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "500", "--window-title-contains",
    "NOPE-UNMET-TITLE-" + fixture_pid,
  ], true);

  harness.emit_evidence(context, declared_evidence, "cu.linux-window-title-contains");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_window_title_contains_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux wait --window-title-contains Unicode title matching with inventory read-back and typed wait --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux wait --window-title-contains Unicode title matching with inventory read-back and typed wait --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
}
