// CEO: Linux page-targets honesty — CU CDP /json inventory matches independent curl read.
// Acceptance is smoke read-back only: page-targets --port and identity-bound --pid
// must agree with curl /json on the same debugging port; a free port must typed-fail
// before any owned Chrome exists. Typed page-targets usage must reject AT-SPI --name,
// --coords, --bogus, and other unexpected arguments (usage_rejects_unexpected).
// Typed get-extents --name usage AND host-limit paths must both hold before the
// CDP read-back court, including get-extents --coords/--bogus command=usage honesty.
// Named get-extents miss/agreement courts use AT-SPI/--name only. Prefer
// honesty/host-limit clarity over fake success. AT-SPI/--name only; no --coords
// or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-cdp-page-targets-readback",
];

const ANCHOR_NAME = "Fixture Anchor";
const MISSING_NODE = "No Such Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function output_success(document) { return flag_at(document, "ok"); }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_page_targets_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(document), "cu_linux_page_targets_reply:" + JSON.stringify(document));
  return document;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_page_targets_usage_limit(run_directory, executable, env, port) {
  const with_name = run_cu_reply(run_directory, executable, "observe", [
    "page-targets", "--port", "" + port, "--name", ANCHOR_NAME,
  ], env);
  ensure(!output_success(with_name), "cu_linux_page_targets_usage_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_page_targets_usage_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_page_targets_usage_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_name, "error.message"), "--name"),
    "cu_linux_page_targets_usage_name_message:" + JSON.stringify(with_name.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, "observe", [
    "page-targets", "--port", "" + port, "--bogus",
  ], env);
  ensure(!output_success(with_bogus), "cu_linux_page_targets_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_page_targets_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_page_targets_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_page_targets_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_coords = run_cu_reply(run_directory, executable, "observe", [
    "page-targets", "--port", "" + port, "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords), "cu_linux_page_targets_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_page_targets_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_page_targets_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_page_targets_usage_coords_message:" + JSON.stringify(with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "0", "--name", ANCHOR_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_page_targets_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_page_targets_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_page_targets_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_page_targets_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_page_targets_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_page_targets_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_page_targets_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords), "cu_linux_page_targets_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_page_targets_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_page_targets_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_page_targets_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus), "cu_linux_page_targets_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_page_targets_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_page_targets_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_page_targets_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--name", ANCHOR_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_page_targets_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_page_targets_extents_unavailable_code:" + code
  );
}

function assert_get_extents_missing_node(run_directory, executable, env, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", MISSING_NODE,
  ], env);
  ensure(!output_success(reply), "cu_linux_page_targets_extents_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_page_targets_extents_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function independent_pyatspi_extents(run_directory, executable, env, window_title, node_name) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "want = sys.argv[2]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and title in (w.name or ''):",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    if (node.name or '') == want:",
    "        return node",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_page_targets_atspi_no_frame')",
    "node = walk(frame)",
    "if node is None:",
    "    raise SystemExit('cu_linux_page_targets_atspi_miss:' + want)",
    "component = node.queryComponent()",
    "ext = component.getExtents(pyatspi.DESKTOP_COORDS)",
    "x, y, w, h = int(ext.x), int(ext.y), int(ext.width), int(ext.height)",
    "print(json.dumps({",
    "    'name': want,",
    "    'x': x, 'y': y, 'width': w, 'height': h,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, window_title, node_name], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_page_targets_pyatspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function assert_get_extents_agreement(run_directory, executable, env, handle, window_title, node_name) {
  const pyatspi_anchor = independent_pyatspi_extents(
    run_directory, executable, env, window_title, node_name
  );
  const anchor_extents = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", node_name,
  ], env);
  ensure(
    int_at(anchor_extents, "data.extents.x") === pyatspi_anchor.x
      && int_at(anchor_extents, "data.extents.y") === pyatspi_anchor.y
      && int_at(anchor_extents, "data.extents.width") === pyatspi_anchor.width
      && int_at(anchor_extents, "data.extents.height") === pyatspi_anchor.height,
    "cu_linux_page_targets_extents_agree:" + JSON.stringify({
      cu: anchor_extents.data.extents,
      pyatspi_anchor: pyatspi_anchor,
    })
  );
}

function window_row_for_title(run_directory, executable, env, title_needle) {
  const reply = run_cu(run_directory, executable, "observe", ["windows"], env);
  for (const row of windows_rows(reply)) {
    const title = text_at(row, "title");
    if (title.indexOf(title_needle) < 0) { continue; }
    const handle = int_at(row, "handle");
    if (handle > 0) { return row; }
  }
  return null;
}

function windows_rows(reply) {
  const data = at(reply, "data");
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function browser_pid_for_title(run_directory, executable, env, title_needle) {
  const reply = run_cu(run_directory, executable, "observe", ["windows"], env);
  for (const row of windows_rows(reply)) {
    const title = text_at(row, "title");
    if (title.indexOf(title_needle) < 0) { continue; }
    const pid = parseInt(text_at(row, "process_id"), 10);
    if (pid > 0) { return pid; }
  }
  return 0;
}

function assert_no_cdp_listener(run_directory, executable, env, port) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "page-targets", "--port", "" + port,
  ], env);
  ensure(reply.ok !== true, "cu_linux_page_targets_false_success:" + JSON.stringify(reply));
  ensure(text_at(reply, "error.code") === "unsupported",
    "cu_linux_page_targets_host_limit_code:" + JSON.stringify(reply));
  const message = text_at(reply, "error.message");
  ensure(
    message.indexOf("no CDP listener") >= 0 && message.indexOf("" + port) >= 0,
    "cu_linux_page_targets_host_limit_message:" + JSON.stringify(reply.error)
  );
}

function curl_json(run_directory, port, path) {
  const output = rh.command("curl", ["-s", "--max-time", "5", "http://127.0.0.1:" + port + path], {
    cwd: run_directory,
    timeout_ms: 10000,
  });
  ensure(output.success === true && output.stdout.trim() !== "",
    "cu_linux_page_targets_curl:" + path + ":" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function normalize_curl_target(raw) {
  return {
    id: raw.id === undefined || raw.id === null ? "" : "" + raw.id,
    url: raw.url === undefined || raw.url === null ? "" : "" + raw.url,
    title: raw.title === undefined || raw.title === null ? "" : "" + raw.title,
    description: raw.description === undefined || raw.description === null ? "" : "" + raw.description,
    type: raw.type === undefined || raw.type === null ? "" : "" + raw.type,
    attached: raw.attached === undefined ? null : raw.attached,
    websocket: raw.webSocketDebuggerUrl !== undefined
      && raw.webSocketDebuggerUrl !== null
      && ("" + raw.webSocketDebuggerUrl) !== "",
  };
}

function normalize_cu_target(row) {
  const attached = at(row, "attached");
  return {
    id: text_at(row, "id"),
    url: text_at(row, "url"),
    title: text_at(row, "title"),
    description: text_at(row, "description"),
    type: text_at(row, "type"),
    attached: attached === undefined ? null : attached,
    websocket: flag_at(row, "websocket"),
  };
}

function targets_agree(cu_rows, curl_rows) {
  const curl_by_id = {};
  for (const raw of curl_rows) {
    const normalized = normalize_curl_target(raw);
    if (normalized.id !== "") { curl_by_id[normalized.id] = normalized; }
  }
  ensure(cu_rows.length === curl_rows.length,
    "cu_linux_page_targets_count:" + JSON.stringify({
      cu: cu_rows.length,
      curl: curl_rows.length,
    }));
  for (const row of cu_rows) {
    const cu = normalize_cu_target(row);
    const curl = curl_by_id[cu.id];
    ensure(curl !== undefined, "cu_linux_page_targets_missing_id:" + cu.id);
    ensure(JSON.stringify(cu) === JSON.stringify(curl),
      "cu_linux_page_targets_mismatch:" + JSON.stringify({ cu: cu, curl: curl }));
  }
}

function curl_has_title(raw, title_needle) {
  if (!Array.isArray(raw)) { return false; }
  for (let index = 0; index < raw.length; index = index + 1) {
    if (normalize_curl_target(raw[index]).title.indexOf(title_needle) >= 0) { return true; }
  }
  return false;
}

function agree_page_targets_with_curl(run_directory, executable, env, port, arguments, title_needle) {
  let last_error = "cu_linux_page_targets_agreement_missing";
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    const raw = curl_json(run_directory, port, "/json");
    if (!curl_has_title(raw, title_needle)) {
      harness.sleep_ms(250);
      continue;
    }
    const reply = run_cu(run_directory, executable, "observe", arguments, env);
    if (reply.command !== "page-targets"
        || text_at(reply, "data.via") !== "/json"
        || at(reply, "data.returned") < 1
        || at(reply, "data.port") !== port) {
      harness.sleep_ms(250);
      continue;
    }
    try {
      targets_agree(at(reply, "data.targets"), raw);
      return reply;
    } catch (error) {
      last_error = "" + error;
      harness.sleep_ms(250);
    }
  }
  throw last_error;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "cu_linux_page_targets_executable_missing:" + executable);
ensure(direct_file(abi_library), "cu_linux_page_targets_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-page-targets");
const run_directory = context.run_directory;
const env = cu_env(executable);

const fixture_title = "CEO Page Targets " + context.run_id;
const fixture = rh.join(run_directory, "page-targets.html");
rh.write_text(fixture, "<!DOCTYPE html><html><head><title>"
  + fixture_title + "</title></head><body>"
  + "<button type=\"button\" aria-label=\"" + ANCHOR_NAME + "\">anchor</button>"
  + "</body></html>");

const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
const port = 9500 + (rh.pid() % 500);
let chrome_child = -1;
let succeeded = 0;
let failure = "";
const atspi_available = probe_atspi_available(executable);

try {
  const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  ensure(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
    "cu_linux_page_targets_port_in_use:" + port);

  print("STEP page-targets typed-fails usage when AT-SPI --name/--coords/--bogus is present");
  assert_page_targets_usage_limit(run_directory, executable, env, port);

  print("STEP page-targets --port typed-fails no CDP listener on the owned free port before Chrome starts");
  assert_no_cdp_listener(run_directory, executable, env, port);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before CDP read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before CDP read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; page-targets read-back still uses CDP /json");
  }

  print("STEP launch owned Chrome with CDP port and a disposable file:// tab");
  chrome_child = harness.start({
    program: launcher,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--new-window",
      "file://" + fixture,
    ],
    current_dir: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  for (let attempt = 0; attempt < 80; attempt = attempt + 1) {
    const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
      cwd: run_directory,
      timeout_ms: 3000,
    });
    if (probe.success === true && probe.stdout.indexOf("Browser") >= 0) { break; }
    harness.sleep_ms(250);
  }

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "20000", "--window-title-contains", fixture_title,
  ], env);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_page_targets_window_wait");

  let window_row = null;
  for (let attempt = 0; attempt < 40 && window_row === null; attempt = attempt + 1) {
    window_row = window_row_for_title(run_directory, executable, env, fixture_title);
    if (window_row === null) { harness.sleep_ms(250); }
  }
  ensure(window_row !== null, "cu_linux_page_targets_window_missing:" + fixture_title);
  const window_handle = "" + int_at(window_row, "handle");
  const window_title = text_at(window_row, "title");
  ensure(window_handle !== "" && window_handle !== "0",
    "cu_linux_page_targets_window_handle:" + JSON.stringify(window_row));

  print("STEP unlock enables the Chrome renderer accessibility tree before named read-back");
  const unlocked = run_cu(run_directory, executable, "observe,actuate", [
    "unlock", "--window", window_handle,
  ], env);
  ensure(flag_at(unlocked, "data.poked"), "cu_linux_page_targets_unlock:" + JSON.stringify(unlocked.data));

  if (atspi_available) {
    print("STEP get-extents typed-fail a11y_node_not_found when the named anchor is missing");
    assert_get_extents_missing_node(run_directory, executable, env, window_handle, "before_cdp");

    print("STEP independent pyatspi extents and CU get-extents --name agree before CDP read-back");
    assert_get_extents_agreement(
      run_directory, executable, env, window_handle, window_title, ANCHOR_NAME
    );
  }

  print("STEP page-targets --port agrees with an independent curl /json inventory read-back");
  const targets = agree_page_targets_with_curl(
    run_directory, executable, env, port,
    ["page-targets", "--port", "" + port],
    fixture_title
  );
  ensure(at(targets, "data.port") === port,
    "cu_linux_page_targets_port:" + JSON.stringify(targets.data));
  ensure(text_at(targets, "data.via") === "/json",
    "cu_linux_page_targets_via:" + JSON.stringify(targets.data));

  const cu_rows = at(targets, "data.targets");
  ensure(Array.isArray(cu_rows), "cu_linux_page_targets_rows:" + JSON.stringify(cu_rows));

  const page_rows = [];
  for (const row of cu_rows) {
    if (text_at(row, "type") === "page") { page_rows.push(row); }
  }
  let fixture_seen = false;
  for (let index = 0; index < page_rows.length && !fixture_seen; index = index + 1) {
    if (text_at(page_rows[index], "title").indexOf(fixture_title) >= 0) { fixture_seen = true; }
  }
  ensure(fixture_seen,
    "cu_linux_page_targets_fixture_title:" + JSON.stringify(page_rows));
  ensure(at(targets, "data.pages") === page_rows.length,
    "cu_linux_page_targets_pages:" + JSON.stringify(targets.data));

  print("STEP page-targets --pid resolves the owned browser process and agrees with curl /json");
  const browser_pid = browser_pid_for_title(run_directory, executable, env, fixture_title);
  ensure(browser_pid > 0, "cu_linux_page_targets_browser_pid:" + fixture_title);
  agree_page_targets_with_curl(
    run_directory, executable, env, port,
    ["page-targets", "--pid", "" + browser_pid],
    fixture_title
  );

  harness.emit_evidence(context, declared_evidence, "cu.linux-cdp-page-targets-readback");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup: " + error); }
}

ensure(succeeded === 1, failure || "cu_linux_page_targets_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: page-targets CDP /json read-back with typed page-targets --name/--coords/--bogus usage_rejects_unexpected, get-extents --name pyatspi agreement, and get-extents --name usage/host-limit plus --coords/--bogus command=usage honesty before CDP read-back (AT-SPI --name, no --coords)");
} else {
  print("PASS: page-targets CDP /json read-back with typed page-targets --name/--coords/--bogus usage_rejects_unexpected and get-extents --name usage/host-limit plus --coords/--bogus command=usage honesty before CDP read-back (AT-SPI --name, no --coords)");
}
return;
