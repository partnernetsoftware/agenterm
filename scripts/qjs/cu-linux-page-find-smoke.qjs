// CEO: Linux page-find honesty — CU CDP page-find matches independent DOM probe.
// Acceptance is smoke read-back only: page-find --selector text/count must agree
// with a separate CDP Runtime.evaluate querySelectorAll probe on the same target.
// Disposable Chrome profile; --port/--target-id only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-page-find-honesty",
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  ensure(output.success === true, "cu_linux_page_find_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_page_find_empty");
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_linux_page_find_reply:" + JSON.stringify(document));
  return document;
}

function page_target(rows) {
  for (const row of rows) {
    if (text_at(row, "type") === "page") { return row; }
  }
  return null;
}

function independent_probe_script() {
  return [
    "import json, sys, urllib.request",
    "import websocket",
    "",
    "config = json.loads(sys.argv[1])",
    "port = config['port']",
    "target_id = config['target_id']",
    "selector = config['selector']",
    "",
    "targets = json.loads(urllib.request.urlopen(",
    "    'http://127.0.0.1:%d/json' % port, timeout=5).read().decode())",
    "ws_url = None",
    "for row in targets:",
    "    if row.get('id') == target_id:",
    "        ws_url = row.get('webSocketDebuggerUrl')",
    "        break",
    "if not ws_url:",
    "    raise SystemExit('cu_linux_page_find_probe_target_missing')",
    "",
    "counter = [0]",
    "def send(ws, method, params=None):",
    "    counter[0] += 1",
    "    msg_id = counter[0]",
    "    ws.send(json.dumps({'id': msg_id, 'method': method, 'params': params or {}}))",
    "    while True:",
    "        raw = ws.recv()",
    "        data = json.loads(raw)",
    "        if data.get('id') != msg_id:",
    "            continue",
    "        if 'error' in data:",
    "            raise SystemExit('cu_linux_page_find_probe_cdp:' + json.dumps(data['error']))",
    "        return data.get('result', {})",
    "",
    "ws = websocket.create_connection(ws_url, timeout=30)",
    "try:",
    "    send(ws, 'Runtime.enable')",
    "    send(ws, 'DOM.enable')",
    "    expr = (",
    "        '(function() {'",
    "        '  const els = Array.from(document.querySelectorAll(' + json.dumps(selector) + '));'",
    "        '  return {'",
    "        '    total: els.length,'",
    "        '    nodes: els.map(function(el) {'",
    "        '      const text = (el.innerText || el.textContent || \"\").trim().slice(0, 500);'",
    "        '      return {'",
    "        '        tag: el.tagName.toLowerCase(),'",
    "        '        text: text,'",
    "        '        value: (el.value !== undefined ? String(el.value) : null),'",
    "        '        editable: !!(el.isContentEditable || ((el.tagName === \"INPUT\" || el.tagName === \"TEXTAREA\") && !el.disabled && !el.readOnly)),'",
    "        '      };'",
    "        '    }),'",
    "        '  };'",
    "        '})()'",
    "    )",
    "    result = send(ws, 'Runtime.evaluate', {'expression': expr, 'returnByValue': True})",
    "    if result.get('exceptionDetails'):",
    "        raise SystemExit('cu_linux_page_find_probe_eval:' + json.dumps(result['exceptionDetails']))",
    "    value = result['result']['value']",
    "    print(json.dumps(value))",
    "finally:",
    "    ws.close()",
  ].join("\n");
}

function independent_probe(run_directory, executable, probe_config_json) {
  const output = rh.command("python3", ["-c", independent_probe_script(), probe_config_json], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_page_find_probe:" + output.stderr + output.stdout);
  const document = JSON.parse(output.stdout.trim());
  ensure(typeof document.total === "number", "cu_linux_page_find_probe_total");
  ensure(Array.isArray(document.nodes), "cu_linux_page_find_probe_nodes");
  return document;
}

function normalize_cu_node(row) {
  const value = at(row, "value");
  return {
    tag: text_at(row, "tag"),
    text: text_at(row, "text"),
    value: value === undefined || value === null ? null : "" + value,
    editable: flag_at(row, "editable"),
  };
}

function nodes_agree(cu_reply, probe, label) {
  ensure(text_at(cu_reply, "data.via") === "DOM.querySelectorAll",
    "cu_linux_page_find_via_" + label + ":" + JSON.stringify(cu_reply.data));
  ensure(at(cu_reply, "data.total") === probe.total,
    "cu_linux_page_find_total_" + label + ":" + JSON.stringify({
      cu: at(cu_reply, "data.total"),
      probe: probe.total,
    }));
  ensure(at(cu_reply, "data.returned") === probe.nodes.length,
    "cu_linux_page_find_returned_" + label + ":" + JSON.stringify({
      cu: at(cu_reply, "data.returned"),
      probe: probe.nodes.length,
    }));
  const cu_nodes = at(cu_reply, "data.nodes");
  ensure(Array.isArray(cu_nodes), "cu_linux_page_find_rows_" + label);
  ensure(cu_nodes.length === probe.nodes.length,
    "cu_linux_page_find_count_" + label + ":" + JSON.stringify({
      cu: cu_nodes.length,
      probe: probe.nodes.length,
    }));
  for (let index = 0; index < cu_nodes.length; index = index + 1) {
    const cu = normalize_cu_node(cu_nodes[index]);
    const dom = probe.nodes[index];
    ensure(JSON.stringify(cu) === JSON.stringify(dom),
      "cu_linux_page_find_mismatch_" + label + "_" + index + ":" + JSON.stringify({ cu: cu, dom: dom }));
  }
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "cu_linux_page_find_executable_missing:" + executable);
ensure(direct_file(abi_library), "cu_linux_page_find_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-page-find");
const run_directory = context.run_directory;
const env = cu_env(executable);

const fixture_title = "CEO Page Find " + context.run_id;
const fixture = rh.join(run_directory, "page-find.html");
const seed_value = "ceo-find-" + context.run_id;
rh.write_text(fixture, "<!DOCTYPE html><html><head><title>"
  + fixture_title + "</title></head><body>"
  + "<h1 id=\"hero\">Hello CEO</h1>"
  + "<p class=\"item\">Alpha</p>"
  + "<p class=\"item\">Beta</p>"
  + "<input id=\"q\" name=\"q\" value=\"" + seed_value + "\">"
  + "</body></html>");

const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
const port = 9600 + (rh.pid() % 500);
let chrome_child = -1;
let succeeded = 0;
let failure = "";

try {
  const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  ensure(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
    "cu_linux_page_find_port_in_use:" + port);

  print("STEP launch owned Chrome with CDP port and a disposable file:// tab");
  chrome_child = harness.start({
    program: launcher,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--remote-allow-origins=*",
      "--new-window",
      "file://" + fixture,
    ],
    current_dir: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  for (let attempt = 0; attempt < 80; attempt = attempt + 1) {
    const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
      cwd: run_directory,
      timeout_ms: 3000,
    });
    if (probe.success === true && probe.stdout.indexOf("Browser") >= 0) { break; }
    harness.sleep_ms(250);
  }

  let target_id = "";
  for (let attempt = 0; attempt < 40 && target_id === ""; attempt = attempt + 1) {
    const targets = run_cu(run_directory, executable, "observe", [
      "page-targets", "--port", "" + port,
    ], env);
    const target = page_target(at(targets, "data.targets"));
    if (target !== null && text_at(target, "title").indexOf(fixture_title) >= 0) {
      target_id = text_at(target, "id");
    }
    if (target_id === "") { harness.sleep_ms(250); }
  }
  ensure(target_id !== "", "cu_linux_page_find_target_missing");

  const cases = [
    { selector: "#hero", label: "hero" },
    { selector: ".item", label: "items" },
    { selector: "#q", label: "input" },
  ];

  for (let index = 0; index < cases.length; index = index + 1) {
    const test_case = cases[index];
    print("STEP page-find --selector " + test_case.selector + " agrees with independent CDP DOM probe");
    const probe_config = JSON.stringify({
      port: port,
      target_id: target_id,
      selector: test_case.selector,
    });
    const probe = independent_probe(run_directory, executable, probe_config);
    const found = run_cu(run_directory, executable, "observe", [
      "page-find", "--port", "" + port, "--target-id", target_id,
      "--selector", test_case.selector,
    ], env);
    nodes_agree(found, probe, test_case.label);
  }

  harness.emit_evidence(context, declared_evidence, "cu.linux-page-find-honesty");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup: " + error); }
}

ensure(succeeded === 1, failure || "cu_linux_page_find_failed");
harness.remove_run(context);
print("PASS: Linux page-find CDP selector text/count matches independent DOM probe (no --coords)");
return;
