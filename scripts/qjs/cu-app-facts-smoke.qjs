// Linux public black-box court for exact bounded application facts.
// Args: REPO AGENTERM_CU_EXE | --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.app-facts.linux"];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function invoke(run_directory, executable, environment, arguments, expect_success) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe"
  ].concat(arguments), {
    cwd: run_directory,
    env: environment,
    timeout_ms: 30000
  });
  ensure(output.success === expect_success, "cu_app_facts_exit:" + output.exit_code);
  const reply = JSON.parse(output.stdout.trim());
  ensure(reply.ok === expect_success, "cu_app_facts_reply_state");
  ensure(reply.command === "app-facts", "cu_app_facts_command");
  return reply;
}

function assert_reasoned(fact, status, message) {
  ensure(fact.status === status, message + ":status");
  ensure(typeof fact.reason === "string" && fact.reason.length > 0, message + ":reason");
  ensure(fact.value === undefined, message + ":value");
}

function assert_identity(data, entry_path, selector) {
  ensure(data.schema_version === 1 && data.platform === "linux", "cu_app_facts_schema");
  ensure(data.selector === selector, "cu_app_facts_selector_echo");
  ensure(data.desktop_entry_id.status === "present"
    && data.desktop_entry_id.value === "org.example.Facts.desktop", "cu_app_facts_id");
  ensure(data.name.status === "present" && data.name.value === "Facts Fixture", "cu_app_facts_name");
  ensure(data.path.status === "present" && data.path.value === entry_path, "cu_app_facts_path");
  ensure(data.executable.status === "present", "cu_app_facts_executable");
  ensure(data.running.status === "present" && data.running.value === true, "cu_app_facts_running");
  assert_reasoned(data.bundle, "not-applicable", "cu_app_facts_bundle");
  assert_reasoned(data.version, "absent", "cu_app_facts_version");
  ensure(data.version.reason.includes("Version-is-file-format-version"), "cu_app_facts_desktop_version");
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(rh.exists(executable), "cu_app_facts_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-app-facts");
const run_directory = context.run_directory;
const data_home = rh.join(run_directory, "data");
const applications = rh.join(data_home, "applications");
const system_data = rh.join(run_directory, "system-data");
const system_applications = rh.join(system_data, "applications");
rh.create_dir_all(applications);
rh.create_dir_all(system_applications);
const entry_path = rh.join(applications, "org.example.Facts.desktop");
const quoted_executable = "\"" + executable + "\"";
rh.write_text(entry_path,
  "[Desktop Entry]\nType=Application\nName=Facts Fixture\nVersion=9999\nExec="
  + quoted_executable + "\n");
// Same id at lower precedence must not replace the user entry.
rh.write_text(rh.join(system_applications, "org.example.Facts.desktop"),
  "[Desktop Entry]\nType=Application\nName=Shadow Fixture\nExec=/bin/false\n");
rh.write_text(rh.join(applications, "org.example.Wrapped.desktop"),
  "[Desktop Entry]\nType=Application\nName=Wrapped Fixture\nExec="
  + quoted_executable + " %U\n");
rh.write_text(rh.join(applications, "org.example.AmbiguousOne.desktop"),
  "[Desktop Entry]\nType=Application\nName=Ambiguous Fixture\nExec=/bin/false\n");
rh.write_text(rh.join(applications, "org.example.AmbiguousTwo.desktop"),
  "[Desktop Entry]\nType=Application\nName=Ambiguous Fixture\nExec=/bin/false\n");

const environment = {
  HOME: run_directory,
  XDG_DATA_HOME: data_home,
  XDG_DATA_DIRS: system_data,
  XDG_CONFIG_HOME: rh.join(run_directory, "config"),
  AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
  AGENTERM_CU_RECEIPT_PATH: rh.join(run_directory, "cu-receipts.jsonl")
};

let succeeded = 0;
let failure = "";
try {
  print("STEP path, desktop id and unique Name resolve the same canonical application");
  for (const selector of [entry_path, "org.example.Facts.desktop", "Facts Fixture"]) {
    const reply = invoke(run_directory, executable, environment,
      ["app-facts", "--selector", selector], true);
    assert_identity(reply.data, entry_path, selector);
    assert_reasoned(reply.data.signature, "not-requested", "cu_app_facts_signing_default");
    assert_reasoned(reply.data.signature_verified, "not-requested", "cu_app_facts_verify_default");
    assert_reasoned(reply.data.entitlements, "not-requested", "cu_app_facts_entitlements_default");
  }

  print("STEP requested Linux security facts preserve unsupported and not-applicable truth");
  const security = invoke(run_directory, executable, environment, [
    "app-facts", "--selector", "org.example.Facts.desktop",
    "--signing", "--verify", "--entitlements"
  ], true).data;
  assert_reasoned(security.signature, "unsupported", "cu_app_facts_signature");
  assert_reasoned(security.signature_verified, "unsupported", "cu_app_facts_verification");
  assert_reasoned(security.entitlements, "not-applicable", "cu_app_facts_entitlements");

  print("STEP Exec field codes never become guessed executable or running identity");
  const wrapped = invoke(run_directory, executable, environment,
    ["app-facts", "--selector", "org.example.Wrapped.desktop"], true).data;
  assert_reasoned(wrapped.executable, "unavailable", "cu_app_facts_wrapped_executable");
  assert_reasoned(wrapped.running, "unavailable", "cu_app_facts_wrapped_running");

  print("STEP zero and ambiguous selectors fail typed");
  const missing = invoke(run_directory, executable, environment,
    ["app-facts", "--selector", "Missing Fixture"], false);
  ensure(missing.error.code === "app_facts_not_found", "cu_app_facts_missing_code");
  const ambiguous = invoke(run_directory, executable, environment,
    ["app-facts", "--selector", "Ambiguous Fixture"], false);
  ensure(ambiguous.error.code === "app_facts_ambiguous", "cu_app_facts_ambiguous_code");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, declared_evidence[0]);
  harness.remove_run(context);
  print("PASS: Linux application facts are exact, bounded, identity-bracketed and reasoned");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
