// Verify staged executable roles, budgets, provenance, and offline catalogs.
//
// Args:
//   REPO [release|development]
// Runs under `--profile tool`: it reads dist/ and scripts/artifacts.json,
// hashes files, runs git and the staged executables, and reads its own
// arguments through the same door.
//
// Native note (kept from rh): PE subsystem byte inspection stays in the
// archived Rhai task until the runtime gains native emit for std::fs::read.
//
// Differences from the rh original, each deliberate:
//   - the door's command spec has no `env_remove`; AGENTERM_IPC_ADDRESS is set
//     to "" instead, which the runtime reads through `nonempty_env` and so
//     treats exactly as unset (src/platform/contract/ipc.rs).
//   - rh compared booleans to 0/1 (`git_dirty == 0`, `read_only == 1`); the
//     fields are JSON booleans (build_metadata.rh, control_center.rs,
//     mcp_catalog.rs), so here they are `=== false` / `=== true`.
//   - rh's `type_of(x) == "()"` for a JSON null is `x === null`.
import * as rh from "lib/rh_compat";
import * as artifact_manifest from "lib/artifact_manifest";

// No `.includes` on arrays here (engine wall): a loop answers the same.
function array_has(values, wanted) {
  for (const v of values) { if ("" + v === wanted) { return true; } }
  return false;
}

if (arg_count() !== 1 && arg_count() !== 2) { throw "expected: REPO [release|development]"; }
// Two-pass argv: `arg(i)` parks the string, `tool_result()` collects it.
const args = [];
for (let i = 0; i < arg_count(); i = i + 1) {
  if (arg(i) !== 0) { throw "arg: " + tool_result(); }
  args.push(tool_result());
}

const repo = rh.absolute(args[0]);
let release = 0;
if (args.length === 2) {
  rh.require(args[1] === "release" || args[1] === "development", "artifact_verification_mode");
  if (args[1] === "release") { release = 1; }
}

const dist = rh.join(repo, "dist");
const manifest_path = rh.join(repo, "scripts/artifacts.json");
artifact_manifest.validate(manifest_path);
const manifest = rh.parse_file(manifest_path);

const metadata_path = rh.join(dist, "agenterm.json");
const metadata = rh.parse_file(metadata_path);
rh.require(metadata.schema_version === 2, "artifact_metadata_schema");

const offline_endpoint = "pipe:\\\\.\\pipe\\agenterm-artifact-verification";
const stdout_path = rh.join(repo, ".artifact-verification.stdout.tmp");
const instance_dir = rh.join(repo, "target/agenterm-artifact-verification/instances");
const workspace_path = rh.join(repo, "target/agenterm-artifact-verification/workspace.json");
const probe_options = {
  cwd: repo,
  env: {
    AGENTERM_IPC_ENDPOINT: offline_endpoint,
    AGENTERM_INSTANCE_DIR: instance_dir,
    AGENTERM_WORKSPACE_PATH: workspace_path,
    AGENTERM_NO_ACTIVATE: "1",
    // rh had `env_remove: ["AGENTERM_IPC_ADDRESS"]`; the runtime reads this
    // through nonempty_env, so "" is unset.
    AGENTERM_IPC_ADDRESS: ""
  },
  timeout_ms: 30000
};

function probe(program, probe_args) {
  return rh.command_stdout_file(program, probe_args, stdout_path, probe_options);
}

const expected_names = {};
let expected_count = 0;
for (const artifact of manifest.executables) {
  const artifact_name = "" + artifact.name;
  rh.require(expected_names[artifact_name] === undefined, "artifact_manifest_name_duplicate:" + artifact_name);
  expected_names[artifact_name] = true;
  expected_count = expected_count + 1;
  const path = rh.join(dist, artifact_name);
  rh.require(rh.exists(path), "artifact_missing:" + artifact_name);
  if (release === 1) {
    const actual_bytes = rh.metadata(path).len;
    const budget_bytes = Number(artifact.release_budget_bytes);
    rh.require(
      actual_bytes <= budget_bytes,
      "artifact_release_budget:" + artifact_name + ":actual=" + actual_bytes + ":budget=" + budget_bytes
    );
  }
  let metadata_matches = 0;
  for (const meta_entry of metadata.executables) {
    if (("" + meta_entry.name) === artifact_name) {
      rh.require(metadata_matches === 0, "artifact_metadata_duplicate:" + artifact_name);
      metadata_matches = 1;
      rh.require(("" + meta_entry.sha256) === rh.sha256_file(path), "artifact_metadata_hash:" + artifact_name);
    }
  }
  rh.require(metadata_matches === 1, "artifact_metadata_hash:" + artifact_name);
}
const expected_library_names = {};
let expected_library_count = 0;
for (const library of manifest.libraries) {
  const library_name = "" + library.name;
  rh.require(
    expected_names[library_name] === undefined && expected_library_names[library_name] === undefined,
    "artifact_manifest_name_duplicate:" + library_name
  );
  expected_library_names[library_name] = true;
  expected_library_count = expected_library_count + 1;
  const path = rh.join(dist, library_name);
  rh.require(rh.exists(path), "artifact_library_missing:" + library_name);
  if (release === 1) {
    const actual_bytes = rh.metadata(path).len;
    const budget_bytes = Number(library.release_budget_bytes);
    rh.require(
      actual_bytes <= budget_bytes,
      "artifact_library_release_budget:" + library_name + ":actual=" + actual_bytes + ":budget=" + budget_bytes
    );
  }
  let metadata_matches = 0;
  for (const meta_entry of metadata.libraries) {
    if (("" + meta_entry.name) === library_name) {
      rh.require(metadata_matches === 0, "artifact_library_metadata_duplicate:" + library_name);
      metadata_matches = 1;
      rh.require(
        ("" + meta_entry.kind) === "dynamic-library" && ("" + meta_entry.sha256) === rh.sha256_file(path),
        "artifact_library_metadata_hash:" + library_name
      );
    }
  }
  rh.require(metadata_matches === 1, "artifact_library_metadata_hash:" + library_name);
}

for (const dir_entry of rh.read_dir(dist)) {
  const file_name = ("" + dir_entry.name).toLowerCase();
  rh.require(
    !(dir_entry.is_file && file_name.startsWith("agentermctl") && file_name.endsWith(".exe")),
    "artifact_obsolete_cli:" + dir_entry.name
  );
}

rh.require(metadata.executables.length === expected_count, "artifact_metadata_count");
rh.require(metadata.libraries.length === expected_library_count, "artifact_library_metadata_count");
for (const meta_entry of metadata.executables) {
  const entry_name = "" + meta_entry.name;
  rh.require(expected_names[entry_name] !== undefined, "artifact_metadata_unexpected:" + entry_name);
}
for (const meta_entry of metadata.libraries) {
  const entry_name = "" + meta_entry.name;
  rh.require(expected_library_names[entry_name] !== undefined, "artifact_library_metadata_unexpected:" + entry_name);
}
rh.require(array_has(metadata.features, "codex-launcher"), "artifact_metadata_feature:codex-launcher");
rh.require(array_has(metadata.features, "tab-environment"), "artifact_metadata_feature:tab-environment");
rh.require(array_has(metadata.features, "mux-frontend"), "artifact_metadata_feature:mux-frontend");

const head_code = rh.command_stdout_file("git", ["rev-parse", "HEAD"], stdout_path, { cwd: repo, timeout_ms: 30000 });
rh.require(head_code === 0, "artifact_git_head");
const head = rh.read_text(stdout_path).trim();
rh.require(("" + metadata.git_commit) === head, "artifact_metadata_commit");

const cargo_lock_path = rh.join(repo, "Cargo.lock");
rh.require(("" + metadata.cargo_lock_sha256) === rh.sha256_file(cargo_lock_path), "artifact_metadata_cargo_lock");
rh.require(("" + metadata.artifact_manifest_sha256) === rh.sha256_file(manifest_path), "artifact_metadata_manifest");
rh.require(("" + metadata.rust_version) !== "", "artifact_metadata_rust_version");
rh.require(release === 0 || metadata.git_dirty === false, "artifact_release_dirty");

// The standalone agenterm-cli.exe retired with the CLI merge; every CLI
// probe goes through the shipped GUI PE's `cli` forwarder (the probe
// argv below already carried the `cli` prefix for exactly this shape).
const cli = rh.join(dist, "agenterm.exe");
const control_center = rh.join(dist, "agenterm-cc.exe");
const computer_use = rh.join(dist, "agenterm-cu.exe");
const metadata_version = "" + metadata.version;

rh.require(probe(cli, ["cli", "--version"]) === 0, "artifact_cli_version");
const cli_version = rh.read_text(stdout_path).trim();
rh.require(cli_version === "agenterm cli " + metadata_version, "artifact_cli_version_mismatch");

// mux/mcp are CLI subcommands only (standalone PEs removed).
rh.require(probe(cli, ["cli", "mux", "--version"]) === 0, "artifact_mux_version");
const mux_version = rh.read_text(stdout_path).trim();
rh.require(
  mux_version === "agenterm-mux " + metadata_version + " (AgenTerm compatibility frontend)",
  "artifact_mux_version_mismatch"
);

rh.require(probe(cli, ["cli", "mcp", "--version"]) === 0, "artifact_mcp_version");
const mcp_version = rh.read_text(stdout_path).trim();
rh.require(mcp_version === "agenterm-mcp " + metadata_version, "artifact_mcp_version_mismatch");

rh.require(probe(control_center, ["--version"]) === 0, "artifact_control_center_version");
const cc_version = rh.read_text(stdout_path).trim();
rh.require(cc_version === "agenterm-cc " + metadata_version, "artifact_control_center_version_mismatch");

rh.require(probe(computer_use, ["--version"]) === 0, "artifact_computer_use_version");
const cu_version = rh.read_text(stdout_path).trim();
rh.require(cu_version === "agenterm-cu " + metadata_version, "artifact_computer_use_version_mismatch");

rh.require(probe(control_center, ["capabilities", "--json"]) === 0, "artifact_control_center_capabilities");
const control_center_capabilities = rh.parse_file(stdout_path);
rh.require(
  control_center_capabilities.schema_version === 1
    && ("" + control_center_capabilities.executable) === "agenterm-cc"
    && ("" + control_center_capabilities.role) === "isolated_projection"
    && control_center_capabilities.owns_terminal_authority === false
    && control_center_capabilities.process_reuse === true
    && control_center_capabilities.no_activate === true
    && control_center_capabilities.views.length === 4,
  "artifact_control_center_capabilities_invalid"
);

rh.require(
  probe(control_center, ["snapshot", "--json", "--endpoint", offline_endpoint]) === 0,
  "artifact_control_center_snapshot"
);
const control_center_snapshot = rh.parse_file(stdout_path);
rh.require(
  control_center_snapshot.schema_version === 1
    && ("" + control_center_snapshot.executable) === "agenterm-cc"
    && control_center_snapshot.connected_server === null
    && control_center_snapshot.views.length === 4,
  "artifact_control_center_snapshot_invalid"
);

rh.require(probe(cli, ["cli", "mcp", "capabilities", "--json"]) === 0, "artifact_mcp_capabilities");
const mcp_capabilities = rh.parse_file(stdout_path);
const mcp_tools = mcp_capabilities.tools;
const mcp_tool0 = mcp_tools[0];
const mcp_tool_name = "" + mcp_tool0.name;
rh.require(
  ("" + mcp_capabilities.protocol_revision) === "2025-11-25"
    && mcp_capabilities.transports.length === 1
    && ("" + mcp_capabilities.transports[0]) === "stdio"
    && mcp_capabilities.resources.length === 4
    && mcp_capabilities.tools.length === 1
    && mcp_tool_name === "agenterm_wait"
    && mcp_tool0.read_only === true,
  "artifact_mcp_capabilities_invalid"
);

rh.try_remove_file(stdout_path);

print(
  "PASS: verified " + expected_count + " staged executables and " + expected_library_count
    + " typed libraries, hashes, budgets, and offline catalogs"
);
return;
