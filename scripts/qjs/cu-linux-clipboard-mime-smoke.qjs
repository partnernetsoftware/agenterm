// CEO: Linux clipboard text/plain, text/html and image/png honesty on X11.
// Acceptance is independent clipboard-read --type after clipboard-write with digest,
// type inventory, denied/host-limit paths and empty restore; shell court owns CU
// read-back. Independent xclip TARGETS/payload or X11 GetSelectionOwner evidence
// when those host tools are present; otherwise a typed gap, never a fake roundtrip.
// Typed clipboard-write/read/clear --name/--coords/--bogus uses
// usage_rejects_unexpected + command=usage or an honest non-usage typed failure
// (never fake command=usage). Typed get-extents --name usage AND host-limit
// courts must both hold before process-state, desktop-state, and the clipboard
// actuate/read-back court (no if/else gating those courts on atspi_available);
// get-extents --coords/--bogus must reject as command=usage.
// process-state and desktop-state fixture binding courts must hold before
// actuate/read-back when AT-SPI is available. AT-SPI/--name only; no --coords
// or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-clipboard-mime-roundtrip",
];

const AT_SPI_PROBE_NAME = "Clipboard Mime Court Anchor";
const TEXT_TYPE = "text/plain;charset=utf-8";
const PNG_HEX = "89504e470d0a1a0a0000000d4948445200000001000000010802000000907753de0000000c49444154789c6360606000000004000127000b0000000049454e44ae426082";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}


function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_clipboard_reply(run_directory, executable, grant, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", grant,
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_clipboard_mime_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  const command = text_at(reply, "command");
  ensure(
    command.indexOf("clipboard") >= 0 || command === "usage",
    "cu_linux_clipboard_mime_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke(run_directory, executable, grant, arguments, env) {
  const reply = invoke_clipboard_reply(run_directory, executable, grant, arguments, env);
  ensure(rh.output_success(reply),
    "cu_linux_clipboard_mime_exit:" + arguments[0] + ":" + JSON.stringify(reply));
  return reply;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_clipboard_mime_cu_empty_reply:" + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(rh.output_success(document),
    "cu_linux_clipboard_mime_cu_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_clipboard_mime_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_clipboard_usage_reject(run_directory, executable, grant, arguments, env, label, token) {
  const reply = invoke_clipboard_reply(run_directory, executable, grant, arguments, env);
  ensure(!rh.output_success(reply),
    "cu_linux_clipboard_mime_usage_" + label + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_clipboard_mime_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_clipboard_mime_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  const message = text_at(reply, "error.message");
  ensure(
    usage_rejects_unexpected(message, token),
    "cu_linux_clipboard_mime_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
  if (token === "--coords") {
    ensure(
      message.indexOf("--coords") >= 0,
      "cu_linux_clipboard_mime_usage_coords_token:" + JSON.stringify(reply.error)
    );
  }
}

function assert_clipboard_usage_limit(run_directory, executable, env) {
  const read_flat = invoke_clipboard_reply(run_directory, executable, "observe", [
    "clipboard-read", "--type", TEXT_TYPE, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(read_flat),
    "cu_linux_clipboard_mime_read_flat_name_ok:" + JSON.stringify(read_flat));
  ensure(
    text_at(read_flat, "error.code") === "usage",
    "cu_linux_clipboard_mime_read_flat_name_code:" + JSON.stringify(read_flat.error)
  );
  ensure(
    text_at(read_flat, "command") === "usage",
    "cu_linux_clipboard_mime_read_flat_name_command:" + JSON.stringify(read_flat)
  );
  ensure(
    usage_rejects_unexpected(text_at(read_flat, "error.message"), "--name"),
    "cu_linux_clipboard_mime_read_flat_name_message:" + JSON.stringify(read_flat.error)
  );

  const read_grouped = invoke_clipboard_reply(run_directory, executable, "observe", [
    "clipboard", "read", "--type", TEXT_TYPE, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(read_grouped),
    "cu_linux_clipboard_mime_read_grouped_name_ok:" + JSON.stringify(read_grouped));
  ensure(
    text_at(read_grouped, "error.code") === "usage",
    "cu_linux_clipboard_mime_read_grouped_name_code:" + JSON.stringify(read_grouped.error)
  );
  ensure(
    text_at(read_grouped, "command") === "usage",
    "cu_linux_clipboard_mime_read_grouped_name_command:" + JSON.stringify(read_grouped)
  );
  ensure(
    usage_rejects_unexpected(text_at(read_grouped, "error.message"), "--name"),
    "cu_linux_clipboard_mime_read_grouped_name_message:" + JSON.stringify(read_grouped.error)
  );

  const write_flat = invoke_clipboard_reply(run_directory, executable, "actuate", [
    "clipboard-write", "--type", TEXT_TYPE, "--text", "denied", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(write_flat),
    "cu_linux_clipboard_mime_write_flat_name_ok:" + JSON.stringify(write_flat));
  ensure(
    text_at(write_flat, "error.code") === "usage",
    "cu_linux_clipboard_mime_write_flat_name_code:" + JSON.stringify(write_flat.error)
  );
  ensure(
    text_at(write_flat, "command") === "usage",
    "cu_linux_clipboard_mime_write_flat_name_command:" + JSON.stringify(write_flat)
  );
  ensure(
    usage_rejects_unexpected(text_at(write_flat, "error.message"), "--name"),
    "cu_linux_clipboard_mime_write_flat_name_message:" + JSON.stringify(write_flat.error)
  );

  const write_grouped = invoke_clipboard_reply(run_directory, executable, "actuate", [
    "clipboard", "write", "--type", TEXT_TYPE, "--text", "denied", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(write_grouped),
    "cu_linux_clipboard_mime_write_grouped_name_ok:" + JSON.stringify(write_grouped));
  ensure(
    text_at(write_grouped, "error.code") === "usage",
    "cu_linux_clipboard_mime_write_grouped_name_code:" + JSON.stringify(write_grouped.error)
  );
  ensure(
    text_at(write_grouped, "command") === "usage",
    "cu_linux_clipboard_mime_write_grouped_name_command:" + JSON.stringify(write_grouped)
  );
  ensure(
    usage_rejects_unexpected(text_at(write_grouped, "error.message"), "--name"),
    "cu_linux_clipboard_mime_write_grouped_name_message:" + JSON.stringify(write_grouped.error)
  );

  const clear_flat = invoke_clipboard_reply(run_directory, executable, "actuate", [
    "clipboard-clear", "--apply", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(clear_flat),
    "cu_linux_clipboard_mime_clear_flat_name_ok:" + JSON.stringify(clear_flat));
  ensure(
    text_at(clear_flat, "error.code") === "usage",
    "cu_linux_clipboard_mime_clear_flat_name_code:" + JSON.stringify(clear_flat.error)
  );
  ensure(
    text_at(clear_flat, "command") === "usage",
    "cu_linux_clipboard_mime_clear_flat_name_command:" + JSON.stringify(clear_flat)
  );
  ensure(
    usage_rejects_unexpected(text_at(clear_flat, "error.message"), "--name"),
    "cu_linux_clipboard_mime_clear_flat_name_message:" + JSON.stringify(clear_flat.error)
  );

  const clear_grouped = invoke_clipboard_reply(run_directory, executable, "actuate", [
    "clipboard", "clear", "--apply", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(clear_grouped),
    "cu_linux_clipboard_mime_clear_grouped_name_ok:" + JSON.stringify(clear_grouped));
  ensure(
    text_at(clear_grouped, "error.code") === "usage",
    "cu_linux_clipboard_mime_clear_grouped_name_code:" + JSON.stringify(clear_grouped.error)
  );
  ensure(
    text_at(clear_grouped, "command") === "usage",
    "cu_linux_clipboard_mime_clear_grouped_name_command:" + JSON.stringify(clear_grouped)
  );
  ensure(
    usage_rejects_unexpected(text_at(clear_grouped, "error.message"), "--name"),
    "cu_linux_clipboard_mime_clear_grouped_name_message:" + JSON.stringify(clear_grouped.error)
  );

  assert_clipboard_usage_reject(run_directory, executable, "observe", [
    "clipboard-read", "--bogus",
  ], env, "read_bogus", "--bogus");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard-write", "--type", TEXT_TYPE, "--text", "denied", "--bogus",
  ], env, "write_bogus", "--bogus");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard-clear", "--apply", "--bogus",
  ], env, "clear_bogus", "--bogus");

  assert_clipboard_usage_reject(run_directory, executable, "observe", [
    "clipboard-read", "--type", TEXT_TYPE, "--coords", "10,10",
  ], env, "read_coords", "--coords");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard-write", "--type", TEXT_TYPE, "--text", "denied", "--coords", "10,10",
  ], env, "write_coords", "--coords");
  assert_clipboard_usage_reject(run_directory, executable, "actuate", [
    "clipboard-clear", "--apply", "--coords", "10,10",
  ], env, "clear_coords", "--coords");
}

function assert_clipboard_empty_host_limit(run_directory, executable, env) {
  const cleared = invoke_clipboard_reply(run_directory, executable, "actuate", [
    "clipboard-clear", "--apply",
  ], env);
  ensure(rh.output_success(cleared),
    "cu_linux_clipboard_mime_clear_before_empty:" + JSON.stringify(cleared));

  const inventory = invoke_clipboard_reply(run_directory, executable, "observe", [
    "clipboard-read", "--metadata-only",
  ], env);
  ensure(rh.output_success(inventory),
    "cu_linux_clipboard_mime_empty_inventory:" + JSON.stringify(inventory));
  ensure(
    at(inventory, "data.types_available") === true
      && at(inventory, "data.types").length === 0,
    "cu_linux_clipboard_mime_empty_targets:" + JSON.stringify(inventory.data)
  );

  for (const mime of ["text/html", "image/png", TEXT_TYPE]) {
    const missing = invoke_clipboard_reply(run_directory, executable, "observe", [
      "clipboard-read", "--type", mime,
    ], env);
    ensure(!rh.output_success(missing),
      "cu_linux_clipboard_mime_missing_" + mime + "_ok:" + JSON.stringify(missing));
    ensure(
      text_at(missing, "error.code") === "clipboard_failed",
      "cu_linux_clipboard_mime_missing_" + mime + "_code:" + JSON.stringify(missing.error)
    );
  }
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_clipboard_mime_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_clipboard_mime_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_clipboard_mime_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_clipboard_mime_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_clipboard_mime_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_clipboard_mime_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_clipboard_mime_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_clipboard_mime_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_clipboard_mime_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_clipboard_mime_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_clipboard_mime_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_clipboard_mime_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_clipboard_mime_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_clipboard_mime_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_clipboard_mime_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_clipboard_mime_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_clipboard_mime_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_clipboard_mime_extents_unavailable_code:" + code
  );
}

function safe_command(program, args, options) {
  try {
    return rh.command(program, args, options);
  } catch (error) {
    return null;
  }
}

function command_on_path(name) {
  const output = safe_command("sh", ["-c", "command -v " + name], { timeout_ms: 5000 });
  return output !== null && output.success && output.stdout.trim() !== "";
}

function independent_xclip_targets(executable) {
  const output = safe_command("xclip", ["-selection", "clipboard", "-o", "-t", "TARGETS"], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (output === null || !output.success) { return null; }
  return output.stdout;
}

function independent_xclip_payload(executable, mime) {
  const args = mime === ""
    ? ["-selection", "clipboard", "-o"]
    : ["-selection", "clipboard", "-o", "-t", mime];
  const output = safe_command("xclip", args, {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (output === null || !output.success) { return null; }
  return output.stdout;
}

function independent_clipboard_owner_xid(executable) {
  const script = [
    "import ctypes, ctypes.util",
    "lib = ctypes.util.find_library('X11')",
    "if not lib:",
    "    print('absent')",
    "    raise SystemExit(0)",
    "X11 = ctypes.cdll.LoadLibrary(lib)",
    "X11.XOpenDisplay.restype = ctypes.c_void_p",
    "X11.XOpenDisplay.argtypes = [ctypes.c_char_p]",
    "X11.XInternAtom.restype = ctypes.c_ulong",
    "X11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]",
    "X11.XGetSelectionOwner.restype = ctypes.c_ulong",
    "X11.XGetSelectionOwner.argtypes = [ctypes.c_void_p, ctypes.c_ulong]",
    "dpy = X11.XOpenDisplay(None)",
    "if not dpy:",
    "    print('absent')",
    "    raise SystemExit(0)",
    "atom = X11.XInternAtom(dpy, b'CLIPBOARD', 0)",
    "owner = X11.XGetSelectionOwner(dpy, atom)",
    "print(str(int(owner)))",
  ].join("\n");
  const output = safe_command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (output === null || output.success !== true) { return null; }
  const text = output.stdout.trim();
  if (text === "" || text === "absent") { return null; }
  return text;
}

function targets_list_type(targets, mime) {
  if (targets === null) { return false; }
  return targets.indexOf(mime) >= 0;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_clipboard_mime_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_clipboard_mime_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_clipboard_mime_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_clipboard_mime_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_clipboard_mime_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function assert_court_anchor_binding(run_directory, executable, env, fixture_source) {
  let fixture = null;
  let fixture_pid = 0;
  try {
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ], env);
    ensure(flag_at(window_wait, "data.met"),
      "cu_linux_clipboard_mime_court_anchor_wait:" + JSON.stringify(window_wait.data));
    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_clipboard_mime_court_anchor_row");
    const handle_text = "" + int_at(row, "handle");
    ensure(int_at(row, "handle") > 0,
      "cu_linux_clipboard_mime_court_anchor_handle:" + JSON.stringify(row));
    assert_fixture_process_state(run_directory, executable, fixture_pid);
    assert_fixture_desktop_state(
      run_directory, executable, fixture_pid, fixture_title, handle_text, row
    );
  } finally {
    if (fixture_pid !== 0) {
      rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
    }
    if (fixture !== null) {
      try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
    }
  }
}

function write_png_fixture(path) {
  const output = rh.command("python3", [
    "-c",
    "import sys; open(sys.argv[1], 'wb').write(bytes.fromhex(sys.argv[2]))",
    path,
    PNG_HEX,
  ], { timeout_ms: 10000 });
  ensure(output.success === true, "cu_linux_clipboard_mime_png_fixture:" + output.stderr);
}

function assert_independent_xclip_x11_evidence(run_directory, executable, env) {
  const has_xclip = command_on_path("xclip");
  const token = "CEO-mime-host-" + rh.now_ms() + " ≠ 你好";
  const html = "<p>CEO clipboard html host court</p>";
  const png_path = rh.join(run_directory, "host-1x1.png");
  const png_out = rh.join(run_directory, "host-1x1.xclip.png");
  write_png_fixture(png_path);
  const png_digest = rh.sha256_file(png_path);

  print("STEP clipboard-write " + TEXT_TYPE + " for independent xclip/x11 evidence");
  const write_text = invoke(run_directory, executable, "actuate", [
    "clipboard-write", "--type", TEXT_TYPE, "--text", token,
  ], env);
  ensure(
    flag_at(write_text, "data.verified") && text_at(write_text, "data.type") === TEXT_TYPE,
    "cu_linux_clipboard_mime_host_text_write:" + JSON.stringify(write_text.data)
  );
  const typed_text = invoke(run_directory, executable, "observe", [
    "clipboard-read", "--type", TEXT_TYPE,
  ], env);
  ensure(
    text_at(typed_text, "data.value") === token,
    "cu_linux_clipboard_mime_host_text_cu_read:" + JSON.stringify(typed_text.data)
  );

  if (has_xclip) {
    print("STEP independent xclip TARGETS lists UTF-8 flavour after text/plain write");
    const text_targets = independent_xclip_targets(executable);
    ensure(text_targets !== null, "cu_linux_clipboard_mime_xclip_text_targets_failed");
    ensure(
      targets_list_type(text_targets, TEXT_TYPE)
        || targets_list_type(text_targets, "UTF8_STRING")
        || targets_list_type(text_targets, "text/plain"),
      "cu_linux_clipboard_mime_xclip_text_targets_missing:" + JSON.stringify(text_targets)
    );
    print("STEP independent xclip text/plain payload matches CU digest read-back");
    const host_text = independent_xclip_payload(executable, "");
    ensure(
      host_text === token,
      "cu_linux_clipboard_mime_xclip_text_mismatch:"
        + JSON.stringify({ expected: token, host: host_text })
    );
  } else {
    const owner_xid = independent_clipboard_owner_xid(executable);
    if (owner_xid !== null && owner_xid !== "0") {
      print("STEP independent X11 GetSelectionOwner CLIPBOARD owner is " + owner_xid
        + " after text/plain write (no xclip on PATH)");
    } else if (owner_xid === "0") {
      print("STEP typed-gap: X11 GetSelectionOwner is NONE after text/plain write (no xclip on PATH);"
        + " clipboard-read --type digest read-back is the acceptance path");
    } else {
      print("STEP typed-gap: no xclip on PATH and no libX11 GetSelectionOwner probe;"
        + " clipboard-read --type digest read-back is the acceptance path");
    }
  }

  print("STEP clipboard-write text/html for independent xclip/x11 evidence");
  const html_path = rh.join(run_directory, "host-court.html");
  rh.write_text(html_path, html);
  const write_html = invoke(run_directory, executable, "actuate", [
    "clipboard-write", "--type", "text/html", "--path", html_path,
  ], env);
  ensure(
    flag_at(write_html, "data.verified") && text_at(write_html, "data.type") === "text/html",
    "cu_linux_clipboard_mime_host_html_write:" + JSON.stringify(write_html.data)
  );
  if (has_xclip) {
    print("STEP independent xclip TARGETS lists text/html after html write");
    const html_targets = independent_xclip_targets(executable);
    ensure(html_targets !== null, "cu_linux_clipboard_mime_xclip_html_targets_failed");
    ensure(
      targets_list_type(html_targets, "text/html"),
      "cu_linux_clipboard_mime_xclip_html_targets_missing:" + JSON.stringify(html_targets)
    );
    print("STEP independent xclip text/html payload matches CU write");
    const host_html = independent_xclip_payload(executable, "text/html");
    ensure(
      host_html === html,
      "cu_linux_clipboard_mime_xclip_html_mismatch:"
        + JSON.stringify({ expected: html, host: host_html })
    );
  }

  print("STEP clipboard-write image/png for independent xclip/x11 evidence");
  const write_png = invoke(run_directory, executable, "actuate", [
    "clipboard-write", "--type", "image/png", "--path", png_path,
  ], env);
  ensure(
    flag_at(write_png, "data.verified")
      && text_at(write_png, "data.type") === "image/png"
      && text_at(write_png, "data.sha256") === png_digest,
    "cu_linux_clipboard_mime_host_png_write:" + JSON.stringify(write_png.data)
  );
  if (has_xclip) {
    print("STEP independent xclip TARGETS lists image/png after png write");
    const png_targets = independent_xclip_targets(executable);
    ensure(png_targets !== null, "cu_linux_clipboard_mime_xclip_png_targets_failed");
    ensure(
      targets_list_type(png_targets, "image/png"),
      "cu_linux_clipboard_mime_xclip_png_targets_missing:" + JSON.stringify(png_targets)
    );
    print("STEP independent xclip image/png bytes match CU sha256");
    const xclip_code = rh.command_stdout_file(
      "xclip",
      ["-selection", "clipboard", "-o", "-t", "image/png"],
      png_out,
      { env: cu_env(executable), timeout_ms: 10000 }
    );
    ensure(xclip_code === 0 && rh.is_direct_file(png_out),
      "cu_linux_clipboard_mime_xclip_png_dump:" + xclip_code);
    ensure(
      rh.sha256_file(png_out) === png_digest,
      "cu_linux_clipboard_mime_xclip_png_digest:"
        + rh.sha256_file(png_out) + "!=" + png_digest
    );
  } else {
    const owner_xid = independent_clipboard_owner_xid(executable);
    if (owner_xid !== null && owner_xid !== "0") {
      print("STEP independent X11 GetSelectionOwner CLIPBOARD owner is " + owner_xid
        + " after image/png write (no xclip on PATH)");
    } else if (owner_xid === "0") {
      print("STEP typed-gap: X11 GetSelectionOwner is NONE after image/png write (no xclip on PATH);"
        + " clipboard-read --type digest read-back is the acceptance path");
    }
  }

  print("STEP clear clipboard after independent xclip/x11 evidence");
  invoke(run_directory, executable, "actuate", ["clipboard-clear", "--apply"], env);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const smoke = rh.join(repo, "scripts/cu-linux-clipboard-mime-smoke.sh");
ensure(rh.is_direct_file(executable), "cu_linux_clipboard_mime_executable_missing:" + executable);
ensure(rh.is_direct_file(smoke), "cu_linux_clipboard_mime_smoke_missing:" + smoke);
ensure(rh.env_or("DISPLAY", "") !== "", "cu_linux_clipboard_mime_display_missing");

const context = harness.new_context(repo, "cu-linux-clipboard-mime");
const env = cu_env(executable);
env.AGENTERM_CU_EXE = executable;
const atspi_available = probe_atspi_available(executable);
const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(rh.is_direct_file(fixture_source),
  "cu_linux_clipboard_mime_fixture_missing:" + fixture_source);
let succeeded = 0;
let failure = "";

try {
  print("STEP clipboard-write/read/clear typed-fail usage when AT-SPI --name/--coords/--bogus is present (usage_rejects_unexpected + command=usage; never fake command=usage)");
  assert_clipboard_usage_limit(context.run_directory, executable, env);

  print("STEP clipboard-read typed-fail clipboard_failed for empty TARGETS and unsupported MIME types before process-state/desktop-state and actuate/read-back court");
  assert_clipboard_empty_host_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);

  if (atspi_available) {
    print("STEP process-state and desktop-state bind the court anchor before clipboard actuate/read-back court");
    assert_court_anchor_binding(context.run_directory, executable, env, fixture_source);
  } else {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held (no atspi gating); process-state/desktop-state binding skipped; clipboard read-back still uses CU clipboard-read plus xclip/x11 when present");
  }

  print("STEP independent xclip TARGETS/payload or X11 GetSelectionOwner evidence when present");
  assert_independent_xclip_x11_evidence(context.run_directory, executable, env);

  print("STEP host-native court runs cu-linux-clipboard-mime-smoke.sh with independent typed read-back");
  const output = rh.command("bash", [smoke], {
    cwd: repo,
    env: env,
    timeout_ms: 120000,
  });
  ensure(
    output.success === true,
    "cu_linux_clipboard_mime_smoke_child:" + output.stdout + output.stderr
  );
  ensure(
    output.stdout.indexOf("PASS:") >= 0,
    "cu_linux_clipboard_mime_smoke_pass_missing:" + output.stdout
  );

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-clipboard-mime-roundtrip");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: CEO Linux clipboard text/plain, text/html and image/png roundtrip with independent typed read-back, xclip/x11 evidence when present, typed clipboard/get-extents --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), and process-state/desktop-state binding before actuate (AT-SPI --name, no --coords)");
  } else {
    print("PASS: CEO Linux clipboard text/plain, text/html and image/png roundtrip with independent typed read-back, xclip/x11 evidence when present, typed clipboard --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), and get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating) when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
