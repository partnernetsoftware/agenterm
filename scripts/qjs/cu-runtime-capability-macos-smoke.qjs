// Aggregate the three public macOS components that own the archived MCU caps
// replacement. This script adds no capability logic: it issues evidence only
// after core, owned-process, and owned-desktop tasks all pass in one run.
//
// Args: REPO AGENTERM_EXE | --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.runtime-capability.aggregate.macos"];
const components = [
  {
    task: "cu-runtime-capability-core-smoke",
    receipt: "COMPONENT runtime-capability-core macos PASS"
  },
  {
    task: "cu-runtime-capability-process-smoke",
    receipt: "COMPONENT runtime-capability-process PASS"
  },
  {
    task: "cu-runtime-capability-desktop-macos-smoke",
    receipt: "COMPONENT runtime-capability-desktop-macos PASS"
  }
];

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  print(declared_evidence[0]);
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_EXE");
const repo = rh.absolute(args[0]);
const agenterm = rh.absolute(args[1]);
harness.require(rh.is_direct_file(agenterm), "agenterm_executable_missing");
const manifest = rh.join(repo, "agenterm.tasks.json");
const context = harness.new_context(repo, "cu-runtime-capability-macos");

let succeeded = 0;
let failure = "";
try {
  for (const component of components) {
    print("STEP " + component.task);
    const output = rh.command(agenterm, [
      "cli", "script", "task", "run", component.task,
      "--manifest", manifest
    ], {
      cwd: repo,
      env: { AGENTERM_NO_ACTIVATE: "1" },
      timeout_ms: 120000
    });
    harness.require(output.success === true,
      "runtime_capability_component_failed:" + component.task + ":" + output.stderr);
    harness.require(output.stdout.indexOf(component.receipt) >= 0,
      "runtime_capability_component_receipt_missing:" + component.task);
  }
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, declared_evidence[0]);
  harness.remove_run(context);
  print("PASS: macOS runtime capability aggregate");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
