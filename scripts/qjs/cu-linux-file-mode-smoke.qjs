// CEO: Linux file-mode honesty with independent os.lstat permission read-back.
// Acceptance is smoke read-back only: CU file-mode before_mode must agree with
// stat.S_IMODE(os.lstat) on a temp regular file; optional actuate apply and
// restoration must match independent lstat after each step. Typed file-mode
// usage must reject AT-SPI --name, --coords, --bogus, and other unexpected
// arguments; typed get-extents --name usage AND host-limit paths must both hold
// before the chmod/mode
// read-back court. Permission-denied open host-limit paths must match an
// independent os.open probe. AT-SPI/--name only; no --coords or screenshot
// degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-file-mode-readback",
];

const AT_SPI_PROBE_NAME = "File Mode Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function isolated_env(run_directory, executable) {
  const env = {
    HOME: rh.join(run_directory, "home"),
    USERPROFILE: rh.join(run_directory, "home"),
    XDG_CONFIG_HOME: rh.join(run_directory, "config"),
    XDG_DATA_HOME: rh.join(run_directory, "data"),
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
    AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
    AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(run_directory, "cu-requests.json"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  const cu = cu_env(executable);
  env.AGENTERM_ABI_LIB = cu.AGENTERM_ABI_LIB;
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (cu[key] !== undefined) { env[key] = cu[key]; }
  }
  return env;
}

function invoke_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (let i = 0; i < arguments.length; i = i + 1) { argv.push(arguments[i]); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_file_mode_cli:" + output.stdout + output.stderr);
  let reply = null;
  try { reply = JSON.parse(output.stdout.trim()); }
  catch (error) { throw "cu_linux_file_mode_invalid_reply"; }
  ensure(
    text_at(reply, "command") === "file-mode" || text_at(reply, "command") === "usage",
    "cu_linux_file_mode_wrong_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_file_mode_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function invoke(run_directory, executable, grant, arguments, expected_error, env) {
  const reply = invoke_reply(run_directory, executable, grant, arguments, env);
  if (expected_error !== undefined) {
    ensure(!rh.output_success(reply), "cu_linux_file_mode_expected_failure");
    ensure(text_at(reply, "error.code") === expected_error,
      "cu_linux_file_mode_wrong_error:" + JSON.stringify(reply.error));
    return reply.error;
  }
  ensure(rh.output_success(reply), "cu_linux_file_mode_failed:" + JSON.stringify(reply));
  return reply.data;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function file_mode_usage_rejects(message, token) {
  return usage_rejects_unexpected(message, token)
    || message.indexOf("requires PATH OCTAL") >= 0;
}

function assert_file_mode_usage_limit(run_directory, executable, fixture, env) {
  const flat_with_name = invoke_reply(run_directory, executable, "observe", [
    "file-mode", fixture, "0600", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(flat_with_name),
    "cu_linux_file_mode_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_file_mode_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_file_mode_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    file_mode_usage_rejects(text_at(flat_with_name, "error.message"), "--name"),
    "cu_linux_file_mode_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_reply(run_directory, executable, "observe", [
    "file", "chmod", fixture, "0600", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(grouped_with_name),
    "cu_linux_file_mode_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_file_mode_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    file_mode_usage_rejects(text_at(grouped_with_name, "error.message"), "--name"),
    "cu_linux_file_mode_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const flat_with_bogus = invoke_reply(run_directory, executable, "observe", [
    "file-mode", fixture, "0600", "--bogus",
  ], env);
  ensure(!rh.output_success(flat_with_bogus),
    "cu_linux_file_mode_usage_flat_bogus_ok:" + JSON.stringify(flat_with_bogus));
  ensure(
    text_at(flat_with_bogus, "error.code") === "usage",
    "cu_linux_file_mode_usage_flat_bogus_code:" + JSON.stringify(flat_with_bogus.error)
  );
  ensure(
    text_at(flat_with_bogus, "command") === "usage",
    "cu_linux_file_mode_usage_flat_bogus_command:" + JSON.stringify(flat_with_bogus)
  );
  ensure(
    file_mode_usage_rejects(text_at(flat_with_bogus, "error.message"), "--bogus"),
    "cu_linux_file_mode_usage_flat_bogus_message:" + JSON.stringify(flat_with_bogus.error)
  );

  const grouped_with_bogus = invoke_reply(run_directory, executable, "observe", [
    "file", "chmod", fixture, "0600", "--bogus",
  ], env);
  ensure(!rh.output_success(grouped_with_bogus),
    "cu_linux_file_mode_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_file_mode_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    text_at(grouped_with_bogus, "command") === "usage",
    "cu_linux_file_mode_usage_grouped_bogus_command:" + JSON.stringify(grouped_with_bogus)
  );
  ensure(
    file_mode_usage_rejects(text_at(grouped_with_bogus, "error.message"), "--bogus"),
    "cu_linux_file_mode_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const flat_with_coords = invoke_reply(run_directory, executable, "observe", [
    "file-mode", fixture, "0600", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(flat_with_coords),
    "cu_linux_file_mode_usage_flat_coords_ok:" + JSON.stringify(flat_with_coords));
  ensure(
    text_at(flat_with_coords, "error.code") === "usage",
    "cu_linux_file_mode_usage_flat_coords_code:" + JSON.stringify(flat_with_coords.error)
  );
  ensure(
    text_at(flat_with_coords, "command") === "usage",
    "cu_linux_file_mode_usage_flat_coords_command:" + JSON.stringify(flat_with_coords)
  );
  ensure(
    file_mode_usage_rejects(text_at(flat_with_coords, "error.message"), "--coords"),
    "cu_linux_file_mode_usage_flat_coords_message:" + JSON.stringify(flat_with_coords.error)
  );

  const grouped_with_coords = invoke_reply(run_directory, executable, "observe", [
    "file", "chmod", fixture, "0600", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(grouped_with_coords),
    "cu_linux_file_mode_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_file_mode_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    text_at(grouped_with_coords, "command") === "usage",
    "cu_linux_file_mode_usage_grouped_coords_command:" + JSON.stringify(grouped_with_coords)
  );
  ensure(
    file_mode_usage_rejects(text_at(grouped_with_coords, "error.message"), "--coords"),
    "cu_linux_file_mode_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_file_mode_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_file_mode_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_file_mode_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_file_mode_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_file_mode_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_file_mode_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_mode_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_file_mode_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_file_mode_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_file_mode_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_mode_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_file_mode_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_file_mode_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_file_mode_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_mode_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_file_mode_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_file_mode_extents_unavailable_code:" + code
  );
}

function probe_file_open(path) {
  const script = [
    "import json, os, sys",
    "path = sys.argv[1]",
    "readable = False",
    "error_kind = None",
    "try:",
    "    handle = os.open(path, os.O_RDONLY)",
    "    os.close(handle)",
    "    readable = True",
    "except OSError as error:",
    "    if error.errno == 13:",
    "        error_kind = 'PermissionDenied'",
    "    elif error.errno == 2:",
    "        error_kind = 'NotFound'",
    "    else:",
    "        error_kind = error.__class__.__name__",
    "print(json.dumps({",
    "    'readable': readable,",
    "    'error_kind': error_kind,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, path], {
    timeout_ms: 10000,
  });
  ensure(output.success === true,
    "cu_linux_file_mode_open_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function assert_file_mode_open_denied_host_limit(
  run_directory, executable, path, grant, env, apply
) {
  const probe = probe_file_open(path);
  ensure(probe.readable !== true && probe.error_kind === "PermissionDenied",
    "cu_linux_file_mode_denied_probe_not_denied:" + JSON.stringify(probe));
  const arguments = ["file-mode", path, "0600"];
  if (apply === true) { arguments.push("--apply"); }
  const reply = invoke_reply(run_directory, executable, grant, arguments, env);
  ensure(!rh.output_success(reply),
    "cu_linux_file_mode_denied_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "file_mode_open_failed",
    "cu_linux_file_mode_denied_code:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message");
  ensure(
    message.indexOf("Permission denied") >= 0 || message.indexOf("os error 13") >= 0,
    "cu_linux_file_mode_denied_message:" + message
  );
}

function native_perm_mode(path) {
  const script = [
    "import os, stat, sys",
    "st = os.lstat(sys.argv[1])",
    "print(f'{stat.S_IMODE(st.st_mode):04o}')",
  ].join("\n");
  const output = rh.command("/usr/bin/python3", ["-c", script, path], {
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_file_mode_lstat_failed:" + output.stderr);
  return output.stdout.trim();
}

function ensure_identity(identity, message) {
  ensure(identity !== null && typeof identity === "object", message + ":object");
  ensure(typeof identity.filesystem_id === "string" && identity.filesystem_id.length > 0,
    message + ":filesystem_id");
  ensure(typeof identity.object_id === "string" && identity.object_id.length > 0,
    message + ":object_id");
  ensure(typeof identity.hard_link_count === "string" && identity.hard_link_count.length > 0,
    message + ":hard_link_count");
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_file_mode_executable_missing");

const uname = rh.command("/usr/bin/uname", ["-s"], { timeout_ms: 10000 });
ensure(uname.success === true && uname.stdout.trim() === "Linux",
  "cu_linux_file_mode_requires_linux");

const context = harness.new_context(repo, "cu-linux-file-mode");
const run_directory = context.run_directory;
const env = isolated_env(run_directory, executable);
const atspi_available = probe_atspi_available(executable);
const fixture = rh.join(run_directory, "fixture.bin");
const denied_fixture = rh.join(run_directory, "denied-fixture.bin");
const link = rh.join(run_directory, "fixture-link.bin");
let succeeded = 0;
let failure = "";

try {
  rh.write_text(fixture, "file-mode-readback-fixture");
  const prepared = rh.command("/bin/chmod", ["0640", fixture], {
    cwd: run_directory,
    timeout_ms: 10000,
  });
  ensure(prepared.success === true, "cu_linux_file_mode_fixture_setup_failed:" + prepared.stderr);
  ensure(native_perm_mode(fixture) === "0640", "cu_linux_file_mode_fixture_initial_mode");

  print("STEP file-mode typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_file_mode_usage_limit(run_directory, executable, fixture, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before chmod/mode read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before chmod/mode read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; file-mode read-back still uses os.lstat");
  }

  print("STEP observe before_mode matches independent os.lstat permission bits");
  const plan = invoke(run_directory, executable, "observe", [
    "file-mode", fixture, "0600",
  ], undefined, env);
  ensure_identity(plan.identity, "cu_linux_file_mode_plan_identity");
  ensure(plan.before_mode === native_perm_mode(fixture),
    "cu_linux_file_mode_plan_before_mismatch:" + JSON.stringify(plan));
  ensure(plan.before_mode === "0640" && plan.requested_mode === "0600"
    && plan.after_mode === "0640" && plan.previous_mode === null,
    "cu_linux_file_mode_plan_modes:" + JSON.stringify(plan));
  ensure(plan.action.apply_requested === false && plan.action.performed === false
    && plan.action.verified === false,
    "cu_linux_file_mode_plan_action:" + JSON.stringify(plan.action));
  ensure(native_perm_mode(fixture) === "0640", "cu_linux_file_mode_plan_mutated");

  print("STEP observe plus --apply is denied before mutation");
  invoke(run_directory, executable, "observe", [
    "file-mode", fixture, "0600", "--apply",
  ], "refused", env);
  ensure(native_perm_mode(fixture) === "0640", "cu_linux_file_mode_refusal_mutated");

  print("STEP actuate apply changes mode and matches independent lstat read-back");
  const applied = invoke(run_directory, executable, "actuate", [
    "file-mode", fixture, "0600", "--apply",
  ], undefined, env);
  ensure_identity(applied.identity, "cu_linux_file_mode_apply_identity");
  ensure(applied.before_mode === "0640" && applied.requested_mode === "0600"
    && applied.after_mode === "0600" && applied.previous_mode === "0640",
    "cu_linux_file_mode_apply_modes:" + JSON.stringify(applied));
  ensure(applied.action.apply_requested === true && applied.action.performed === true
    && applied.action.verified === true,
    "cu_linux_file_mode_apply_action:" + JSON.stringify(applied.action));
  ensure(native_perm_mode(fixture) === "0600", "cu_linux_file_mode_apply_lstat_mismatch");
  ensure(applied.after_mode === native_perm_mode(fixture),
    "cu_linux_file_mode_apply_after_mismatch:" + JSON.stringify(applied));

  print("STEP same-mode apply is a verified no-op with stable lstat read-back");
  const unchanged = invoke(run_directory, executable, "actuate", [
    "file", "chmod", fixture, "0600", "--apply",
  ], undefined, env);
  ensure(unchanged.before_mode === "0600" && unchanged.after_mode === "0600"
    && unchanged.previous_mode === "0600",
    "cu_linux_file_mode_noop_modes:" + JSON.stringify(unchanged));
  ensure(unchanged.action.apply_requested === true && unchanged.action.performed === false
    && unchanged.action.verified === true,
    "cu_linux_file_mode_noop_action:" + JSON.stringify(unchanged.action));
  ensure(native_perm_mode(fixture) === "0600", "cu_linux_file_mode_noop_lstat_mutated");

  print("STEP restoration returns the temp fixture to its original mode");
  const restored = invoke(run_directory, executable, "actuate", [
    "file-mode", fixture, applied.previous_mode, "--apply",
  ], undefined, env);
  ensure(restored.before_mode === "0600" && restored.requested_mode === "0640"
    && restored.after_mode === "0640" && restored.previous_mode === "0600",
    "cu_linux_file_mode_restore_modes:" + JSON.stringify(restored));
  ensure(restored.action.performed === true && restored.action.verified === true,
    "cu_linux_file_mode_restore_action:" + JSON.stringify(restored.action));
  ensure(native_perm_mode(fixture) === "0640", "cu_linux_file_mode_restore_lstat_mismatch");
  ensure(restored.after_mode === native_perm_mode(fixture),
    "cu_linux_file_mode_restore_after_mismatch:" + JSON.stringify(restored));

  rh.write_text(denied_fixture, "file-mode-denied-fixture");
  const denied_prep = rh.command("/bin/chmod", ["0000", denied_fixture], {
    cwd: run_directory,
    timeout_ms: 10000,
  });
  ensure(denied_prep.success === true,
    "cu_linux_file_mode_denied_fixture_setup_failed:" + denied_prep.stderr);
  const denied_probe = probe_file_open(denied_fixture);
  if (denied_probe.readable !== true && denied_probe.error_kind === "PermissionDenied") {
    print("STEP file-mode typed-fails file_mode_open_failed host-limit when independent os.open probe is denied");
    assert_file_mode_open_denied_host_limit(
      run_directory, executable, denied_fixture, "observe", env, false);
    assert_file_mode_open_denied_host_limit(
      run_directory, executable, denied_fixture, "actuate", env, true);
    ensure(native_perm_mode(fixture) === "0640",
      "cu_linux_file_mode_denied_mutated_fixture");
  } else {
    print("STEP skip permission-denied host-limit: independent os.open probe is readable on this host");
  }

  print("STEP final symlink apply is refused and the target mode stays restored");
  const linked = rh.command("/bin/ln", ["-s", fixture, link], {
    cwd: run_directory,
    timeout_ms: 10000,
  });
  ensure(linked.success === true, "cu_linux_file_mode_symlink_setup_failed:" + linked.stderr);
  invoke(run_directory, executable, "actuate", [
    "file-mode", link, "0600", "--apply",
  ], "file_mode_not_regular", env);
  ensure(native_perm_mode(fixture) === "0640", "cu_linux_file_mode_symlink_target_mutated");

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-file-mode-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux file-mode matches independent os.lstat permission read-back with typed file-mode --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux file-mode matches independent os.lstat permission read-back with typed file-mode --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
