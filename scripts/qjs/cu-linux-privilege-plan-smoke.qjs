// CEO: Linux privilege-plan observe honesty with independent before/after read-back.
// Acceptance is smoke read-back only: process.set-priority and system.power-action
// plans must be expiring, identity-bound, mutation_performed=false, and must not
// change independent nice, boot_id or CLOCK_BOOTTIME probes. Typed privilege-plan
// usage must reject AT-SPI --name, --coords, --bogus, and other unexpected
// arguments; typed get-extents --name usage AND host-limit paths must both hold
// before the process/boot read-back court. Typed usage, observe grant escalation
// refusal, and missing installed provider helper refusal must fail before any
// scheduler, boot or provider transport effect. Never perform privilege-apply.
// Prefer host-limit clarity over fake success. No --coords or screenshot
// degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-privilege-plan-readback",
];

const BOOT_ID_PATH = "/proc/sys/kernel/random/boot_id";
const UPTIME_SLACK_MS = 15000;
const AT_SPI_PROBE_NAME = "Privilege Plan Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function isolated_env(run_directory, executable, prefix) {
  const env = {
    HOME: run_directory,
    USERPROFILE: run_directory,
    APPDATA: rh.join(run_directory, "config"),
    LOCALAPPDATA: rh.join(run_directory, "data"),
    XDG_CONFIG_HOME: rh.join(run_directory, "config"),
    XDG_DATA_HOME: rh.join(run_directory, "data"),
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, prefix + "-audit.jsonl"),
    AGENTERM_CU_RECEIPT_PATH: rh.join(run_directory, prefix + "-receipts.jsonl"),
    AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
    AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(run_directory, "cu-requests.json"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  const cu = cu_env(executable);
  env.AGENTERM_ABI_LIB = cu.AGENTERM_ABI_LIB;
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (cu[key] !== undefined) { env[key] = cu[key]; }
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_privilege_plan_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "privilege-plan" || text_at(reply, "command") === "usage",
    "cu_linux_privilege_plan_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_privilege_plan_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function privilege_priority_usage_message_ok(message, token) {
  return usage_rejects_unexpected(message, token)
    || message.indexOf("requires PID NICE") >= 0;
}

function privilege_power_usage_message_ok(message, token) {
  return usage_rejects_unexpected(message, token)
    || message.indexOf("requires exactly sleep, restart or shutdown") >= 0;
}

function get_extents_misuse_message_ok(message, token) {
  return usage_rejects_unexpected(message, token)
    || message.indexOf("--name") >= 0
    || message.indexOf("requires --window") >= 0;
}

function assert_privilege_unexpected(
  run_directory, executable, env, arguments, label, token, message_ok
) {
  const reply = invoke_observe_reply(run_directory, executable, arguments, env);
  ensure(!output_success(reply),
    "cu_linux_privilege_plan_usage_" + label + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_privilege_plan_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_privilege_plan_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  ensure(
    message_ok(text_at(reply, "error.message"), token),
    "cu_linux_privilege_plan_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_privilege_plan_usage_limit(run_directory, executable, env) {
  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege-plan", "process.set-priority", "1", "0",
    "--name", AT_SPI_PROBE_NAME, "--ttl-seconds", "60",
  ], "flat_priority_name", "--name", privilege_priority_usage_message_ok);
  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege", "plan", "process.set-priority", "1", "0",
    "--name", AT_SPI_PROBE_NAME, "--ttl-seconds", "60",
  ], "grouped_priority_name", "--name", privilege_priority_usage_message_ok);
  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege-plan", "process.set-priority", "1", "0",
    "--coords", "10,10", "--ttl-seconds", "60",
  ], "flat_priority_coords", "--coords", privilege_priority_usage_message_ok);
  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege", "plan", "process.set-priority", "1", "0",
    "--coords", "10,10", "--ttl-seconds", "60",
  ], "grouped_priority_coords", "--coords", privilege_priority_usage_message_ok);
  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege-plan", "process.set-priority", "1", "0", "--bogus", "--ttl-seconds", "60",
  ], "flat_priority_bogus", "--bogus", privilege_priority_usage_message_ok);
  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege", "plan", "process.set-priority", "1", "0", "--bogus", "--ttl-seconds", "60",
  ], "grouped_priority_bogus", "--bogus", privilege_priority_usage_message_ok);

  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege-plan", "system.power-action", "sleep",
    "--name", AT_SPI_PROBE_NAME, "--ttl-seconds", "60",
  ], "flat_power_name", "--name", privilege_power_usage_message_ok);
  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege", "plan", "system.power-action", "sleep",
    "--name", AT_SPI_PROBE_NAME, "--ttl-seconds", "60",
  ], "grouped_power_name", "--name", privilege_power_usage_message_ok);
  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege-plan", "system.power-action", "sleep",
    "--coords", "10,10", "--ttl-seconds", "60",
  ], "flat_power_coords", "--coords", privilege_power_usage_message_ok);
  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege", "plan", "system.power-action", "sleep",
    "--coords", "10,10", "--ttl-seconds", "60",
  ], "grouped_power_coords", "--coords", privilege_power_usage_message_ok);
  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege-plan", "system.power-action", "sleep", "--bogus", "--ttl-seconds", "60",
  ], "flat_power_bogus", "--bogus", privilege_power_usage_message_ok);
  assert_privilege_unexpected(run_directory, executable, env, [
    "privilege", "plan", "system.power-action", "sleep", "--bogus", "--ttl-seconds", "60",
  ], "grouped_power_bogus", "--bogus", privilege_power_usage_message_ok);
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_privilege_plan_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_privilege_plan_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_privilege_plan_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_privilege_plan_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_privilege_plan_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_privilege_plan_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_privilege_plan_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_privilege_plan_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_privilege_plan_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_privilege_plan_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    get_extents_misuse_message_ok(text_at(extents_coords, "error.message"), "--coords"),
    "cu_linux_privilege_plan_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_privilege_plan_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_privilege_plan_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_privilege_plan_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    get_extents_misuse_message_ok(text_at(extents_bogus, "error.message"), "--bogus"),
    "cu_linux_privilege_plan_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_privilege_plan_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_privilege_plan_extents_unavailable_code:" + code
  );
}

function invoke(run_directory, executable, arguments, expect_success, prefix) {
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: isolated_env(run_directory, executable, prefix),
    timeout_ms: 30000,
  });
  ensure(output.success === expect_success, "cu_linux_privilege_plan_exit:" + output.exit_code);
  const reply = JSON.parse(output.stdout.trim());
  ensure(reply.ok === expect_success, "cu_linux_privilege_plan_reply_state");
  return reply;
}

function boot_id_shape(value) {
  if (value.length !== 36) { return false; }
  for (let index = 0; index < value.length; index = index + 1) {
    const code = value.charCodeAt(index);
    if (index === 8 || index === 13 || index === 18 || index === 23) {
      if (code !== 45) { return false; }
    } else if (code < 48 || (code > 57 && code < 65) || (code > 70 && code < 97) || code > 102) {
      return false;
    }
  }
  return true;
}

function independent_boot_id() {
  ensure(rh.exists(BOOT_ID_PATH), "cu_linux_privilege_plan_boot_id_missing");
  const boot_id = rh.read_text(BOOT_ID_PATH).trim();
  ensure(boot_id_shape(boot_id), "cu_linux_privilege_plan_boot_id_shape:" + boot_id);
  return boot_id;
}

function independent_uptime_milliseconds() {
  const script = [
    "import time",
    "print(int(time.clock_gettime(time.CLOCK_BOOTTIME) * 1000))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], { timeout_ms: 10000 });
  ensure(output.success === true, "cu_linux_privilege_plan_uptime_probe:" + output.stderr);
  const value = Number(output.stdout.trim());
  ensure(value === value && value >= 0, "cu_linux_privilege_plan_uptime_shape:" + output.stdout);
  return value;
}

function independent_boot_identity(host_identity, boot_id) {
  const script = [
    "import hashlib, struct, sys",
    "host = sys.argv[1]",
    "material = sys.argv[2].strip().encode('ascii')",
    "anchor = hashlib.sha256()",
    "anchor.update(b'agenterm-platform/host-boot-identity/v1\\0')",
    "anchor.update(struct.pack('<Q', len(material)))",
    "anchor.update(material)",
    "anchor = anchor.digest()",
    "digest = hashlib.sha256()",
    "digest.update(b'agenterm-cu/power-status/boot/v1\\0')",
    "digest.update(struct.pack('<Q', len(host)))",
    "digest.update(host.encode('ascii'))",
    "digest.update(struct.pack('<Q', len(anchor)))",
    "digest.update(anchor)",
    "print('agt-cu-boot-v1-' + digest.hexdigest())",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, host_identity, boot_id], {
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_privilege_plan_boot_identity_probe:" + output.stderr);
  const identity = output.stdout.trim();
  ensure(identity.startsWith("agt-cu-boot-v1-") && identity.length === "agt-cu-boot-v1-".length + 64,
         "cu_linux_privilege_plan_boot_identity_shape:" + identity);
  return identity;
}

function independent_process_probe(pid) {
  const script = [
    "import os, sys",
    "pid = int(sys.argv[1])",
    "stat = open(f'/proc/{pid}/stat').read()",
    "parts = stat.rsplit(') ', 1)[1].split()",
    "start_ticks = parts[19]",
    "nice = int(parts[16])",
    "print(f'proc-start-ticks:{start_ticks}\\n{nice}')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid], { timeout_ms: 10000 });
  ensure(output.success === true, "cu_linux_privilege_plan_process_probe:" + output.stderr);
  const lines = output.stdout.trim().split("\n");
  ensure(lines.length === 2, "cu_linux_privilege_plan_process_probe_shape:" + output.stdout);
  const nice = Number(lines[1]);
  ensure(nice === nice && nice >= -20 && nice <= 20,
         "cu_linux_privilege_plan_process_probe_nice:" + output.stdout);
  return { start_identity: lines[0], nice: nice };
}

function plan_priority(run_directory, executable, pid, nice, ttl_seconds) {
  return invoke(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "privilege", "plan", "process.set-priority", "" + pid, "" + nice,
    "--ttl-seconds", "" + ttl_seconds,
  ], true, "priority");
}

function plan_power(run_directory, executable, action, ttl_seconds) {
  return invoke(run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "privilege", "plan", "system.power-action", action,
    "--ttl-seconds", "" + ttl_seconds,
  ], true, "power-" + action);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(rh.exists(executable), "cu_linux_privilege_plan_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-privilege-plan");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
try {
  print("STEP privilege-plan typed-fails usage when AT-SPI --name/--coords/--bogus is present");
  const pid = rh.pid();
  const court_probe_before = independent_process_probe(pid);
  const court_boot_before = independent_boot_id();
  const court_uptime_before = independent_uptime_milliseconds();
  assert_privilege_plan_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before process/boot read-back");
  assert_get_extents_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process/boot read-back");
  assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);

  const court_probe_after = independent_process_probe(pid);
  const court_boot_after = independent_boot_id();
  const court_uptime_after = independent_uptime_milliseconds();
  ensure(court_probe_before.nice === court_probe_after.nice,
         "cu_linux_privilege_plan_usage_court_mutated_nice:before=" + court_probe_before.nice
         + ":after=" + court_probe_after.nice);
  ensure(court_probe_before.start_identity === court_probe_after.start_identity,
         "cu_linux_privilege_plan_usage_court_mutated_identity");
  ensure(court_boot_before === court_boot_after,
         "cu_linux_privilege_plan_usage_court_mutated_boot:" + court_boot_before
         + "!=" + court_boot_after);
  ensure(court_uptime_after >= court_uptime_before,
         "cu_linux_privilege_plan_usage_court_uptime_regressed:before=" + court_uptime_before
         + ":after=" + court_uptime_after);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; privilege-plan court remains observe-only");
  }

  print("STEP setup enrolls the private installation identity");
  const setup = invoke(context.run_directory, executable,
    ["--target", "current", "--grant", "actuate", "setup", "--bin-dir",
     rh.join(context.run_directory, "bin")], true, "setup");
  ensure(setup.command === "setup" && setup.data.installation_identity.status === "ready",
         "cu_linux_privilege_plan_setup_identity");

  print("STEP process.set-priority plan is identity-bound and does not mutate nice");
  const before_probe = independent_process_probe(pid);
  const desired_nice = before_probe.nice === 0 ? 5 : 0;
  const priority_reply = plan_priority(context.run_directory, executable, pid, desired_nice, 60);
  const after_probe = independent_process_probe(pid);
  ensure(before_probe.nice === after_probe.nice,
         "cu_linux_privilege_plan_nice_mutated:before=" + before_probe.nice
         + ":after=" + after_probe.nice);
  ensure(before_probe.start_identity === after_probe.start_identity,
         "cu_linux_privilege_plan_identity_mutated");
  ensure(priority_reply.command === "privilege-plan", "cu_linux_privilege_plan_priority_command");
  ensure(text_at(priority_reply, "data.operation") === "process.set-priority",
         "cu_linux_privilege_plan_priority_operation");
  ensure(text_at(priority_reply, "data.mutation_performed") === "false",
         "cu_linux_privilege_plan_priority_mutation");
  ensure(Number(text_at(priority_reply, "data.before.nice")) === before_probe.nice,
         "cu_linux_privilege_plan_priority_before");
  ensure(Number(text_at(priority_reply, "data.after.nice")) === desired_nice,
         "cu_linux_privilege_plan_priority_after");
  ensure(text_at(priority_reply, "data.target.start_identity") === before_probe.start_identity,
         "cu_linux_privilege_plan_priority_identity");
  ensure(text_at(priority_reply, "data.contract_digest").length === 64,
         "cu_linux_privilege_plan_priority_contract");
  ensure(text_at(priority_reply, "data.approval_digest").length === 64,
         "cu_linux_privilege_plan_priority_approval");
  ensure(
    Number(text_at(priority_reply, "data.expires_at_utc_ms"))
      - Number(text_at(priority_reply, "data.issued_at_utc_ms")) === 60000,
    "cu_linux_privilege_plan_priority_expiry"
  );

  print("STEP every closed power intent is host/boot-bound and does not mutate boot state");
  const boot_id_before = independent_boot_id();
  const uptime_before = independent_uptime_milliseconds();
  let first_power = null;
  for (const action of ["sleep", "restart", "shutdown"]) {
    const reply = plan_power(context.run_directory, executable, action, 60);
    ensure(reply.command === "privilege-plan", "cu_linux_privilege_plan_power_command");
    ensure(text_at(reply, "data.operation") === "system.power-action",
           "cu_linux_privilege_plan_power_operation");
    ensure(text_at(reply, "data.action") === action, "cu_linux_privilege_plan_power_action");
    ensure(text_at(reply, "data.host_identity").startsWith("agt-cu-host-v1-"),
           "cu_linux_privilege_plan_host_identity");
    ensure(text_at(reply, "data.boot_identity").startsWith("agt-cu-boot-v1-"),
           "cu_linux_privilege_plan_boot_identity");
    ensure(text_at(reply, "data.consent_requested") === "false",
           "cu_linux_privilege_plan_consent");
    ensure(text_at(reply, "data.mutation_performed") === "false",
           "cu_linux_privilege_plan_power_mutation");
    ensure(text_at(reply, "data.contract_digest").length === 64,
           "cu_linux_privilege_plan_power_contract");
    ensure(
      Number(text_at(reply, "data.expires_at_utc_ms"))
        - Number(text_at(reply, "data.issued_at_utc_ms")) === 60000,
      "cu_linux_privilege_plan_power_expiry"
    );
    const expected_boot = independent_boot_identity(
      text_at(reply, "data.host_identity"),
      boot_id_before
    );
    ensure(text_at(reply, "data.boot_identity") === expected_boot,
           "cu_linux_privilege_plan_boot_identity_mismatch:" + action);
    if (first_power === null) { first_power = reply; }
    else {
      ensure(text_at(reply, "data.host_identity") === text_at(first_power, "data.host_identity"),
             "cu_linux_privilege_plan_host_stability");
      ensure(text_at(reply, "data.boot_identity") === text_at(first_power, "data.boot_identity"),
             "cu_linux_privilege_plan_boot_stability");
      ensure(text_at(reply, "data.contract_digest") !== text_at(first_power, "data.contract_digest"),
             "cu_linux_privilege_plan_intent_digest");
    }
  }
  const boot_id_after = independent_boot_id();
  const uptime_after = independent_uptime_milliseconds();
  ensure(boot_id_before === boot_id_after,
         "cu_linux_privilege_plan_boot_id_mutated:" + boot_id_before + "!=" + boot_id_after);
  ensure(uptime_after >= uptime_before,
         "cu_linux_privilege_plan_uptime_regressed:before=" + uptime_before
         + ":after=" + uptime_after);

  print("STEP invalid privilege-plan usage fails typed before scheduler or boot mutation");
  const usage_probe_before = independent_process_probe(pid);
  const usage_boot_before = independent_boot_id();
  for (const invalid of [
    ["privilege", "plan", "system.power-action", "hibernate", "--ttl-seconds", "60"],
    ["privilege", "plan", "system.power-action", "sleep", "--ttl-seconds", "0"],
    ["privilege", "plan", "process.set-priority", "" + pid, "99", "--ttl-seconds", "60"],
    ["privilege", "plan", "bogus", "op", "--ttl-seconds", "60"],
  ]) {
    const reply = invoke(context.run_directory, executable, [
      "--target", "current", "--grant", "observe",
    ].concat(invalid), false, "usage-" + invalid[3]);
    ensure(text_at(reply, "error.code") === "usage",
           "cu_linux_privilege_plan_invalid_error:" + invalid.join(" "));
  }
  const usage_probe_after = independent_process_probe(pid);
  const usage_boot_after = independent_boot_id();
  ensure(usage_probe_before.nice === usage_probe_after.nice,
         "cu_linux_privilege_plan_usage_mutated_nice:before=" + usage_probe_before.nice
         + ":after=" + usage_probe_after.nice);
  ensure(usage_probe_before.start_identity === usage_probe_after.start_identity,
         "cu_linux_privilege_plan_usage_mutated_identity");
  ensure(usage_boot_before === usage_boot_after,
         "cu_linux_privilege_plan_usage_mutated_boot:" + usage_boot_before
         + "!=" + usage_boot_after);

  print("STEP observe grant refuses privilege apply before any escalation attempt");
  const plan_request = text_at(priority_reply, "data.request");
  const plan_approval = text_at(priority_reply, "data.approval_digest");
  ensure(plan_request.length > 0 && plan_approval.length === 64,
         "cu_linux_privilege_plan_apply_projection");
  const escalate_probe_before = independent_process_probe(pid);
  const denied_apply = invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "observe",
    "privilege", "apply", "--request", plan_request, "--approve", plan_approval,
  ], false, "apply-observe");
  ensure(text_at(denied_apply, "error.code") === "refused",
         "cu_linux_privilege_plan_apply_observe_code:" + JSON.stringify(denied_apply.error));
  ensure(text_at(denied_apply, "error.message").indexOf("Actuate") >= 0,
         "cu_linux_privilege_plan_apply_observe_message:" + text_at(denied_apply, "error.message"));
  const escalate_probe_after = independent_process_probe(pid);
  ensure(escalate_probe_before.nice === escalate_probe_after.nice,
         "cu_linux_privilege_plan_apply_observe_mutated_nice");
  ensure(escalate_probe_before.start_identity === escalate_probe_after.start_identity,
         "cu_linux_privilege_plan_apply_observe_mutated_identity");

  print("STEP missing installed privilege helper typed-fails connect before any effect");
  const session = invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "actuate",
    "session-start", "--label", "privilege-plan-honesty", "--ttl-seconds", "120",
  ], true, "session");
  ensure(session.command === "session-start", "cu_linux_privilege_plan_session_command");
  ensure(text_at(session, "data.session_id").length > 0,
         "cu_linux_privilege_plan_session_id");
  ensure(text_at(session, "data.lease").length > 0,
         "cu_linux_privilege_plan_session_lease");
  const helper_probe_before = independent_process_probe(pid);
  const missing_helper = invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "actuate",
    "--request-id", context.run_id + "-apply",
    "--session", text_at(session, "data.session_id"),
    "--session-lease", text_at(session, "data.lease"),
    "privilege", "apply", "--request", plan_request, "--approve", plan_approval,
    "--provider-timeout-ms", "1000",
  ], false, "apply-missing-helper");
  ensure(text_at(missing_helper, "error.code") === "privilege_provider_unavailable",
         "cu_linux_privilege_plan_missing_helper_code:" + JSON.stringify(missing_helper.error));
  ensure(text_at(missing_helper, "error.detail.effect") === "not_performed",
         "cu_linux_privilege_plan_missing_helper_effect:" + JSON.stringify(missing_helper.error));
  ensure(text_at(missing_helper, "error.detail.stage") === "connect",
         "cu_linux_privilege_plan_missing_helper_stage:" + JSON.stringify(missing_helper.error));
  const helper_probe_after = independent_process_probe(pid);
  ensure(helper_probe_before.nice === helper_probe_after.nice,
         "cu_linux_privilege_plan_missing_helper_mutated_nice");
  ensure(helper_probe_before.start_identity === helper_probe_after.start_identity,
         "cu_linux_privilege_plan_missing_helper_mutated_identity");

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-privilege-plan-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux privilege-plan observe honesty with typed privilege-plan --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords), escalation refusal, missing-helper host-limit, and independent process/boot read-back");
  } else {
    print("PASS: Linux privilege-plan observe honesty with typed privilege-plan --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords), escalation refusal, missing-helper host-limit, and independent process/boot read-back");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
