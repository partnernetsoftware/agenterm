// Public black-box contract for bounded console-session observation and a
// mutation-free, exact-session lock plan. The visible lock effect has a
// separate explicit court; this routine never locks the host.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.login-session-plan"];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function hex64(value) {
  if (typeof value !== "string" || value.length !== 64) { return false; }
  for (let i = 0; i < value.length; i += 1) {
    const code = value.charCodeAt(i);
    const digit = code >= 48 && code <= 57;
    const lower = code >= 97 && code <= 102;
    if (!digit && !lower) { return false; }
  }
  return true;
}

function invoke(executable, directory, audit_path, args) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe", "login-session"
  ].concat(args), {
    cwd: directory,
    env: {
      AGENTERM_CU_AUDIT_PATH: audit_path,
      AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(directory, "requests.json")
    },
    timeout_ms: 30000
  });
  const stdout = output.stdout.trim();
  ensure(stdout !== "", "cu_login_session_empty:" + output.stderr);
  return { output: output, stdout: stdout, reply: JSON.parse(stdout) };
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!direct_file(executable) && harness.host_is_windows()) {
  executable = executable + ".exe";
}
ensure(direct_file(executable), "cu_login_session_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-login-session");
let succeeded = 0;
let failure = "";
try {
  const audit_path = rh.join(context.run_directory, "audit.jsonl");
  print("STEP login-session status is bounded or truthfully platform-limited");
  const status = invoke(executable, context.run_directory, audit_path, ["status"]);
  if (status.reply.ok !== true) {
    ensure(status.output.success !== true, "cu_login_session_unsupported_false_success");
    ensure(
      status.reply.error.code === "login_session_unsupported",
      "cu_login_session_unsupported_code:" + status.stdout
    );
    const plan = invoke(executable, context.run_directory, audit_path, ["plan", "lock"]);
    ensure(plan.output.success !== true && plan.reply.ok === false, "cu_login_session_plan_false_success");
    ensure(plan.reply.error.code === "login_session_unsupported", "cu_login_session_plan_code");
    ensure(!rh.exists(rh.join(context.run_directory, "requests.json")), "cu_login_session_unsupported_receipt");
  } else {
    const before = status.reply.data;
    ensure(status.output.success === true, "cu_login_session_status_exit");
    ensure(before.provider === "macos-io-registry", "cu_login_session_provider");
    ensure(before.sessions.length >= 1 && before.sessions.length <= 64, "cu_login_session_bound");
    ensure(before.console_session !== null, "cu_login_session_console_missing");
    ensure(before.console_session.on_console === true, "cu_login_session_console_flag");
    ensure(before.console_session.login_complete === true, "cu_login_session_login_incomplete");
    ensure(hex64(before.console_session.identity), "cu_login_session_identity");

    print("STEP plan binds exact console identity and performs no mutation");
    const planned = invoke(executable, context.run_directory, audit_path, [
      "plan", "lock", "--ttl-seconds", "60"
    ]);
    const plan = planned.reply.data;
    ensure(planned.output.success === true && planned.reply.ok === true, "cu_login_session_plan:" + planned.stdout);
    ensure(plan.operation === "session.lock" && plan.schema_version === 1, "cu_login_session_plan_shape");
    ensure(plan.target.identity === before.console_session.identity, "cu_login_session_plan_identity");
    ensure(plan.before.locked === before.locked && plan.after.locked === true, "cu_login_session_plan_state");
    ensure(plan.mutation_performed === false, "cu_login_session_plan_mutated");
    ensure(plan.expires_at_utc_ms - plan.issued_at_utc_ms === 60000, "cu_login_session_plan_expiry");
    ensure(hex64(plan.contract_digest) && hex64(plan.approval_digest), "cu_login_session_plan_digest");
    ensure(plan.approval === plan.approval_digest, "cu_login_session_approval_handoff");
    ensure(typeof plan.request === "string" && plan.request.length > 0 && plan.request.length <= 32768, "cu_login_session_request");
    ensure(!rh.exists(rh.join(context.run_directory, "requests.json")), "cu_login_session_plan_reserved");

    const after = invoke(executable, context.run_directory, audit_path, ["status"]);
    ensure(after.output.success === true && after.reply.ok === true, "cu_login_session_after_status");
    ensure(after.reply.data.locked === before.locked, "cu_login_session_plan_changed_lock");
    ensure(after.reply.data.console_session.identity === before.console_session.identity, "cu_login_session_plan_changed_target");
  }
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (succeeded !== 0) {
  harness.emit_evidence(context, declared_evidence, "cu.login-session-plan");
  harness.remove_run(context);
  print("PASS: login-session observation and exact-session lock planning are bounded, mutation-free and platform-honest");
}
if (failure !== "") { throw failure; }
return;
