// CEO: Linux screen-reader observe with independent org.a11y.Status read-back.
// Acceptance is smoke read-back only: ok JSON must match dbus-send flag facts;
// unsupported must carry typed alternatives and match bus probes; headless-display
// must carry typed x11-display host-limit detail. Typed screen-reader --name/
// --coords/--bogus uses usage_rejects_unexpected + command=usage or an honest
// non-usage typed failure (never fake command=usage). Typed get-extents --name
// usage AND host-limit courts must both hold before process-state, desktop-state,
// and the dbus-send read-back court (no if/else gating those courts on
// atspi_available); get-extents --coords/--bogus must reject as command=usage.
// process-state and desktop-state fixture binding courts must hold before
// observe/read-back. Invalid AT_SPI_BUS_ADDRESS must report disconnected
// a11y_bus while org.a11y.Status flags still agree with independent dbus-send
// read-back when the session bus is present. Prefer host-limit clarity over
// fake success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-screen-reader-status",
];

const AT_SPI_PROBE_NAME = "Screen Reader Court Anchor";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function honest_non_usage_code(code) {
  return code === "a11y_backend_failed"
    || code === "unsupported"
    || code === "bad_handle"
    || code === "window_not_found"
    || code === "a11y_window_gone"
    || code === "invalid_input"
    || code === "a11y_node_not_found";
}

function assert_usage_or_honest_non_usage(reply, label, token) {
  ensure(!rh.output_success(reply),
    "cu_linux_screen_reader_" + label + "_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  const command = text_at(reply, "command");
  if (code === "usage" || command === "usage") {
    ensure(
      code === "usage",
      "cu_linux_screen_reader_" + label + "_code:" + JSON.stringify(reply.error)
    );
    ensure(
      command === "usage",
      "cu_linux_screen_reader_" + label + "_command:" + JSON.stringify(reply)
    );
    ensure(
      usage_rejects_unexpected(text_at(reply, "error.message"), token),
      "cu_linux_screen_reader_" + label + "_message:" + JSON.stringify(reply.error)
    );
  } else {
    ensure(
      command !== "usage" && honest_non_usage_code(code),
      "cu_linux_screen_reader_" + label + "_honest:" + JSON.stringify(reply)
    );
    ensure(
      JSON.stringify(reply).indexOf("coordinate") < 0
        && JSON.stringify(reply).indexOf("XTest") < 0,
      "cu_linux_screen_reader_" + label + "_degraded:" + JSON.stringify(reply)
    );
  }
}


function last_json_line(text) {
  const lines = text.trim().split("\n");
  for (let index = lines.length - 1; index >= 0; index = index - 1) {
    const line = lines[index].trim();
    if (line !== "") { return JSON.parse(line); }
  }
  throw "cu_linux_screen_reader_missing_json";
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function headless_cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of ["XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS"]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  return env;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_screen_reader_extents_cli:" + output.stdout + output.stderr);
  return last_json_line(output.stdout);
}

function invoke_cu_reply(run_directory, executable, arguments, env) {
  const argv = ["--target", "current", "--grant", "observe"];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 120000,
  });
  ensure(
    output.stdout.trim() !== "",
    "cu_linux_screen_reader_cli:" + output.stdout + output.stderr
  );
  return last_json_line(output.stdout);
}

function run_cu(run_directory, executable, arguments, env) {
  const document = invoke_cu_reply(run_directory, executable, arguments, env);
  ensure(rh.output_success(document), "cu_linux_screen_reader_reply:" + JSON.stringify(document));
  return document;
}

function run_cu_reply(run_directory, executable, arguments, env) {
  const document = invoke_cu_reply(run_directory, executable, arguments, env);
  ensure(
    text_at(document, "command") === "screen-reader"
      || text_at(document, "command") === "usage",
    "cu_linux_screen_reader_command:" + JSON.stringify(document)
  );
  return document;
}

function safe_command(program, args, options) {
  try {
    return rh.command(program, args, options);
  } catch (error) {
    return null;
  }
}

function probe_atspi_available(executable, env) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function session_bus_connected(env) {
  const output = safe_command("dbus-send", [
    "--session",
    "--dest=org.freedesktop.DBus",
    "--type=method_call",
    "--print-reply",
    "/org/freedesktop/DBus",
    "org.freedesktop.DBus.GetId",
  ], {
    env: env,
    timeout_ms: 10000,
  });
  return output !== null && output.success === true;
}

function dbus_name_has_owner(service, env) {
  const output = safe_command("dbus-send", [
    "--session",
    "--dest=org.freedesktop.DBus",
    "--type=method_call",
    "--print-reply",
    "/org/freedesktop/DBus",
    "org.freedesktop.DBus.NameHasOwner",
    "string:" + service,
  ], {
    env: env,
    timeout_ms: 10000,
  });
  return output !== null && output.success === true && output.stdout.indexOf("boolean true") >= 0;
}

function independent_a11y_status_flag(flag, env) {
  const output = safe_command("dbus-send", [
    "--session",
    "--dest=org.a11y.Bus",
    "--type=method_call",
    "--print-reply",
    "/org/a11y/bus",
    "org.freedesktop.DBus.Properties.Get",
    "string:org.a11y.Status",
    "string:" + flag,
  ], {
    env: env,
    timeout_ms: 10000,
  });
  if (output === null || !output.success) { return null; }
  if (output.stdout.indexOf("boolean true") >= 0) { return true; }
  if (output.stdout.indexOf("boolean false") >= 0) { return false; }
  return null;
}

function independent_a11y_status_flags(env) {
  if (!dbus_name_has_owner("org.a11y.Bus", env)) { return null; }
  const flags = {};
  for (const flag of ["IsEnabled", "ScreenReaderEnabled"]) {
    const value = independent_a11y_status_flag(flag, env);
    if (value === null) { return null; }
    flags[flag] = value;
  }
  return flags;
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_screen_reader_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_screen_reader_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_screen_reader_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_screen_reader_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_screen_reader_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_screen_reader_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_screen_reader_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_screen_reader_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_screen_reader_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_screen_reader_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_screen_reader_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_screen_reader_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_screen_reader_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_screen_reader_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_screen_reader_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_screen_reader_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_screen_reader_extents_unavailable_code:" + code
  );
}

function assert_screen_reader_usage_limit(run_directory, executable) {
  const with_name = run_cu_reply(run_directory, executable, [
    "screen-reader", "--name", "Fixture Status",
  ]);
  assert_usage_or_honest_non_usage(with_name, "usage_name", "--name");

  const with_bogus = run_cu_reply(run_directory, executable, [
    "screen-reader", "--bogus",
  ]);
  assert_usage_or_honest_non_usage(with_bogus, "usage_bogus", "--bogus");

  const with_coords = run_cu_reply(run_directory, executable, [
    "screen-reader", "--coords", "10,10",
  ]);
  assert_usage_or_honest_non_usage(with_coords, "usage_coords", "--coords");
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_screen_reader_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_screen_reader_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_screen_reader_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_screen_reader_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_screen_reader_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function assert_atspi_host_limit_readback(run_directory, executable) {
  const env = cu_env(executable);
  env.AT_SPI_BUS_ADDRESS = "invalid";
  const reply = run_cu_reply(run_directory, executable, ["screen-reader"], env);
  ensure(rh.output_success(reply), "cu_linux_screen_reader_atspi_host_ok:" + JSON.stringify(reply));
  const data = at(reply, "data");
  ensure(
    flag_at(data, "a11y_bus.connected") === false,
    "cu_linux_screen_reader_atspi_disconnected:" + JSON.stringify(data.a11y_bus)
  );
  ensure(
    text_at(data, "a11y_bus.address") === "invalid",
    "cu_linux_screen_reader_atspi_address:" + JSON.stringify(data.a11y_bus)
  );
  ensure(
    text_at(data, "a11y_bus.address_source") === "explicit_env",
    "cu_linux_screen_reader_atspi_address_source:" + JSON.stringify(data.a11y_bus)
  );
  ensure(
    probe_atspi_available(executable, env) === false,
    "cu_linux_screen_reader_atspi_pyatspi_still_broken"
  );
  assert_ok_readback(run_directory, executable, reply, env);
}

function assert_unavailable_readback(reply) {
  ensure(!flag_at(reply, "ok"), "cu_linux_screen_reader_unexpected_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "screen_reader_unavailable",
    "cu_linux_screen_reader_unavailable_code:" + JSON.stringify(reply.error)
  );
  const detail = at(reply, "error.detail");
  ensure(text_at(detail, "effect") === "not_performed", "cu_linux_screen_reader_unavailable_effect:" + JSON.stringify(detail));
  ensure(
    text_at(detail, "required_mechanism") === "linux-atspi-session-bus",
    "cu_linux_screen_reader_unavailable_mechanism:" + JSON.stringify(detail)
  );
  ensure(at(detail, "alternatives").length > 0, "cu_linux_screen_reader_unavailable_alternatives:" + JSON.stringify(detail));
  const readiness = at(detail, "readiness");
  ensure(
    flag_at(readiness, "session_bus.connected") === false,
    "cu_linux_screen_reader_unavailable_session_bus:" + JSON.stringify(readiness)
  );
  ensure(
    flag_at(readiness, "a11y_bus.connected") === false,
    "cu_linux_screen_reader_unavailable_a11y_bus:" + JSON.stringify(readiness)
  );
}

function assert_ok_readback(run_directory, executable, reply, env) {
  ensure(flag_at(reply, "ok"), "cu_linux_screen_reader_ok:" + JSON.stringify(reply));
  const data = at(reply, "data");
  const status = text_at(data, "status");
  ensure(status === "ok" || status === "partial", "cu_linux_screen_reader_status:" + JSON.stringify(data));
  ensure(text_at(data, "platform") === "linux", "cu_linux_screen_reader_platform:" + JSON.stringify(data));
  ensure(flag_at(data, "session_bus.connected"), "cu_linux_screen_reader_session_bus:" + JSON.stringify(data.session_bus));
  ensure(
    flag_at(data, "session_bus.connected") === session_bus_connected(env),
    "cu_linux_screen_reader_session_bus_mismatch:" + JSON.stringify(data.session_bus)
  );
  ensure(text_at(data, "a11y_bus.address") !== "", "cu_linux_screen_reader_bus_address:" + JSON.stringify(data.a11y_bus));
  const atspi_probe = probe_atspi_available(executable, env);
  if (atspi_probe) {
    ensure(flag_at(data, "a11y_bus.connected"), "cu_linux_screen_reader_a11y_bus:" + JSON.stringify(data.a11y_bus));
  }
  ensure(text_at(data, "org_a11y_status.destination") === "org.a11y.Bus", "cu_linux_screen_reader_destination:" + JSON.stringify(data.org_a11y_status));
  ensure(text_at(data, "org_a11y_status.path") === "/org/a11y/bus", "cu_linux_screen_reader_path:" + JSON.stringify(data.org_a11y_status));
  ensure(text_at(data, "org_a11y_status.interface") === "org.a11y.Status", "cu_linux_screen_reader_interface:" + JSON.stringify(data.org_a11y_status));
  ensure(dbus_name_has_owner("org.a11y.Bus", env), "cu_linux_screen_reader_owner_missing");
  for (const flag of ["IsEnabled", "ScreenReaderEnabled"]) {
    ensure(text_at(data, "org_a11y_status.flags." + flag + ".read") === "ok", "cu_linux_screen_reader_flag_read:" + flag + ":" + JSON.stringify(data.org_a11y_status));
    const value = at(data, "org_a11y_status.flags." + flag + ".value");
    ensure(value === true || value === false, "cu_linux_screen_reader_flag_value:" + flag + ":" + JSON.stringify(value));
  }

  const independent = independent_a11y_status_flags(env);
  ensure(independent !== null, "cu_linux_screen_reader_independent_missing");
  for (const flag of ["IsEnabled", "ScreenReaderEnabled"]) {
    ensure(at(independent, flag) === at(data, "org_a11y_status.flags." + flag + ".value"), "cu_linux_screen_reader_flag_mismatch:" + flag + ":" + JSON.stringify(data.org_a11y_status.flags[flag]) + ":" + JSON.stringify(independent));
  }
}

function assert_unsupported_readback(reply, env) {
  ensure(!flag_at(reply, "ok"), "cu_linux_screen_reader_unexpected_ok:" + JSON.stringify(reply));
  ensure(text_at(reply, "error.code") === "screen_reader_unsupported", "cu_linux_screen_reader_code:" + JSON.stringify(reply.error));
  const detail = at(reply, "error.detail");
  ensure(text_at(detail, "effect") === "not_performed", "cu_linux_screen_reader_effect:" + JSON.stringify(detail));
  ensure(text_at(detail, "required_mechanism") === "linux-atspi-session-bus", "cu_linux_screen_reader_mechanism:" + JSON.stringify(detail));
  ensure(at(detail, "alternatives").length > 0, "cu_linux_screen_reader_alternatives:" + JSON.stringify(detail));
  ensure(text_at(detail, "reason").indexOf("org.a11y.Status") >= 0 || text_at(detail, "reason").indexOf("AT-SPI") >= 0, "cu_linux_screen_reader_reason:" + JSON.stringify(detail));

  const owner = dbus_name_has_owner("org.a11y.Bus", env);
  const independent = independent_a11y_status_flags(env);
  ensure(!owner || independent === null, "cu_linux_screen_reader_framework_should_be_absent:" + owner + ":" + JSON.stringify(independent));
}

function assert_headless_readback(reply) {
  ensure(!flag_at(reply, "ok"), "cu_linux_screen_reader_headless_unexpected_ok:" + JSON.stringify(reply));
  ensure(text_at(reply, "error.code") === "headless-display", "cu_linux_screen_reader_headless_code:" + JSON.stringify(reply.error));
  ensure(text_at(reply, "error.message") !== "", "cu_linux_screen_reader_headless_message:" + JSON.stringify(reply.error));
  const detail = at(reply, "error.detail");
  ensure(text_at(detail, "effect") === "not_performed", "cu_linux_screen_reader_headless_effect:" + JSON.stringify(detail));
  ensure(text_at(detail, "required_mechanism") === "x11-display", "cu_linux_screen_reader_headless_mechanism:" + JSON.stringify(detail));
  ensure(at(detail, "alternatives").length > 0, "cu_linux_screen_reader_headless_alternatives:" + JSON.stringify(detail));
}

function run_cu_headless(run_directory, executable, arguments) {
  const argv = ["--target", "current", "--grant", "observe"];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.run_spec({
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: headless_cu_env(executable),
    env_remove: ["DISPLAY"],
    timeout_ms: 120000,
  });
  ensure(
    output.stdout.trim() !== "",
    "cu_linux_screen_reader_headless_cli:" + output.stdout + output.stderr
  );
  const document = last_json_line(output.stdout);
  ensure(text_at(document, "command") === "screen-reader", "cu_linux_screen_reader_headless_command:" + JSON.stringify(document));
  return document;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(rh.is_direct_file(executable), "missing_agenterm_cu:" + executable);

const context = harness.new_context(repo, "cu-linux-a11y-status");
const run_directory = rh.join(repo, "target/cu-linux-a11y-status-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(rh.is_direct_file(fixture_source), "cu_linux_screen_reader_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable, env);

try {
  print("STEP screen-reader typed-fails usage when AT-SPI --name/--coords/--bogus is present (usage_rejects_unexpected + command=usage, or honest non-usage typed failure; never fake command=usage)");
  assert_screen_reader_usage_limit(run_directory, executable);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (command=usage) before process-state/desktop-state and dbus-send read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and dbus-send read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (atspi_available) {
    print("STEP start owned GTK fixture and resolve one window handle before screen-reader observe/read-back court");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

    const window_wait = run_cu(run_directory, executable, [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_screen_reader_window_wait");

    const inventory_row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(inventory_row !== null, "cu_linux_screen_reader_inventory_missing");
    const handle = int_at(inventory_row, "handle");
    ensure(handle > 0, "cu_linux_screen_reader_handle:" + JSON.stringify(inventory_row));
    const handle_text = "" + handle;

    print("STEP process-state binds the owned fixture pid before screen-reader observe/read-back court");
    assert_fixture_process_state(run_directory, executable, fixture_pid);

    print("STEP desktop-state window row agrees with inventory before screen-reader observe/read-back court");
    assert_fixture_desktop_state(
      run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
    );
  } else {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held; process-state/desktop-state fixture courts require pyatspi; screen-reader dbus-send read-back still runs");
  }

  print("STEP screen-reader observe returns ok JSON or typed unsupported with session-bus read-back");
  const reply = run_cu_reply(run_directory, executable, ["screen-reader"]);
  if (flag_at(reply, "ok")) {
    assert_ok_readback(run_directory, executable, reply, env);
    print("PASS screen-reader ok with independent org.a11y.Status read-back");
  } else {
    assert_unsupported_readback(reply, env);
    print("PASS screen-reader typed unsupported with independent bus read-back");
  }

  print("STEP screen-reader status alias agrees with the bare screen-reader observe");
  const alias_reply = run_cu_reply(run_directory, executable, ["screen-reader", "status"]);
  if (flag_at(reply, "ok")) {
    ensure(flag_at(alias_reply, "ok"), "cu_linux_screen_reader_alias_ok:" + JSON.stringify(alias_reply));
    for (const flag of ["IsEnabled", "ScreenReaderEnabled"]) {
      ensure(
        at(alias_reply, "data.org_a11y_status.flags." + flag + ".value")
          === at(reply, "data.org_a11y_status.flags." + flag + ".value"),
        "cu_linux_screen_reader_alias_flag_mismatch:" + flag
      );
    }
  } else {
    ensure(
      text_at(alias_reply, "error.code") === text_at(reply, "error.code"),
      "cu_linux_screen_reader_alias_code:" + JSON.stringify(alias_reply.error)
    );
  }
  print("PASS screen-reader status alias read-back");

  if (session_bus_connected(env)) {
    print("STEP invalid AT_SPI_BUS_ADDRESS reports disconnected a11y_bus with org.a11y.Status dbus read-back");
    assert_atspi_host_limit_readback(run_directory, executable);
    print("PASS screen-reader AT-SPI host-limit with independent dbus-send read-back");
  } else {
    print("STEP session bus absent; screen-reader returns typed unavailable with readiness detail");
    const unavailable = run_cu_reply(run_directory, executable, ["screen-reader"], {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
      DISPLAY: rh.has_env("DISPLAY") ? rh.env_or("DISPLAY", "") : "",
      DBUS_SESSION_BUS_ADDRESS: "invalid",
    });
    assert_unavailable_readback(unavailable);
    print("PASS screen-reader dbus host-limit unavailable read-back");
  }

  print("STEP screen-reader without DISPLAY returns typed headless-display host-limit detail");
  const headless_reply = run_cu_headless(run_directory, executable, ["screen-reader"]);
  assert_headless_readback(headless_reply);
  print("PASS screen-reader headless-display with typed x11-display host-limit detail");

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
}

if (succeeded !== 0) {
  harness.emit_evidence(context, declared_evidence, "cu.linux-screen-reader-status");
  harness.remove_run(context);
  print("PASS: cu-linux-a11y-status-smoke with independent dbus-send read-back, typed screen-reader --name/--coords/--bogus usage_rejects_unexpected or honest non-usage (never fake command=usage), always-run get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), and process-state/desktop-state courts before observe (AT-SPI --name, no --coords)");
}
if (failure !== "") { throw failure; }
return;
