// Public black-box contract for operation-bound persisted authority.
// Args: REPO AGENTERM_CU_EXE
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.persisted-grant-operation-binding.macos"];

function ensure(condition, message) {
  if (!condition) { throw message; }
}


function run(executable, directory, args) {
  return rh.command(executable, args, {
    cwd: directory,
    env: {
      AGENTERM_CU_AUDIT_PATH: rh.join(directory, "cu-audit.jsonl"),
      AGENTERM_NO_ACTIVATE: "1"
    },
    timeout_ms: 30000
  });
}

function reply(output, label) {
  ensure(output.stdout.trim() !== "", label + "_empty_reply");
  return JSON.parse(output.stdout.trim());
}

function wait_until_utc_ms(deadline_utc_ms, label) {
  const wait_deadline = rh.now_ms() + 2000;
  while (rh.now_ms() < deadline_utc_ms) {
    ensure(rh.now_ms() < wait_deadline, label + "_timeout");
    rh.sleep_ms(5);
  }
}

function assert_audit_has_no_authority_material(path) {
  const text = rh.read_text(path).toLowerCase();
  ensure(text !== "", "cu_persisted_grant_audit_empty");
  const forbidden = [
    "\"credential\"", "\"install_key\"", "\"install-key\"",
    "\"lease\"", "\"secret\"", "\"session\"", "\"token\""
  ];
  for (let i = 0; i < forbidden.length; i = i + 1) {
    ensure(text.indexOf(forbidden[i]) < 0, "cu_persisted_grant_audit_authority_material:" + forbidden[i]);
  }
}

function audit_records(path) {
  const lines = rh.read_text(path).split("\n");
  const records = [];
  for (let i = 0; i < lines.length; i = i + 1) {
    if (lines[i].trim() !== "") { records.push(JSON.parse(lines[i])); }
  }
  return records;
}

function assert_one_denied(records, grant_id, outcome) {
  let matched = 0;
  for (let i = 0; i < records.length; i = i + 1) {
    const record = records[i];
    if (record.grant_id === grant_id && record.decision === "denied" && record.outcome === outcome) {
      ensure(typeof record.decision_id === "string" && record.decision_id.length > 0,
        "cu_persisted_grant_denied_decision_id:" + outcome);
      matched = matched + 1;
    }
  }
  ensure(matched === 1, "cu_persisted_grant_denied_record_count:" + outcome + ":" + matched);
}

function assert_authorized_pair(records, grant_id) {
  let attempt_id = "";
  let outcome_id = "";
  for (let i = 0; i < records.length; i = i + 1) {
    const record = records[i];
    if (record.grant_id === grant_id && record.decision === "authorized") {
      if (record.outcome === "attempt") { attempt_id = record.decision_id; }
      if (record.outcome === "ok") { outcome_id = record.decision_id; }
    }
  }
  ensure(typeof attempt_id === "string" && attempt_id.length > 0,
    "cu_persisted_grant_authorized_attempt_missing");
  ensure(outcome_id === attempt_id, "cu_persisted_grant_authorized_decision_drift");
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  print(declared_evidence[0]);
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.is_direct_file(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(rh.is_direct_file(executable), "cu_persisted_grant_executable_missing");

const context = harness.new_context(repo, "cu-persisted-grant");
const store = rh.join(context.run_directory, "grants.json");
let succeeded = 0;
let failure = "";
try {
  print("STEP create one bounded grant for one canonical operation");
  const created_output = run(executable, context.run_directory, [
    "grant", "create", "--target", "current", "--scopes", "observe",
    "--operations", "capabilities", "--ttl-ms", "60000", "--max-uses", "2",
    "--grant-store", store
  ]);
  const created = reply(created_output, "cu_persisted_grant_create");
  ensure(created_output.success === true && created.ok === true, "cu_persisted_grant_create_failed");
  const grant = created.data.grant;
  ensure(grant.legacy_operation_unbound === false, "cu_persisted_grant_legacy_marker");
  ensure(grant.operations.length === 1 && grant.operations[0] === "capabilities", "cu_persisted_grant_operation");
  ensure(grant.consumed_uses === 0 && grant.remaining_uses === 2, "cu_persisted_grant_initial_budget");

  print("STEP same-scope wrong operation fails without consuming authority");
  const wrong_output = run(executable, context.run_directory, [
    "--target", "current", "--grant-id", grant.grant_id, "--grant-store", store,
    "doctor"
  ]);
  const wrong = reply(wrong_output, "cu_persisted_grant_wrong_operation");
  ensure(wrong_output.success !== true && wrong.ok === false, "cu_persisted_grant_wrong_false_success");
  ensure(wrong.error.code === "refused", "cu_persisted_grant_wrong_error_kind");
  ensure(wrong.error.message.indexOf("operation_mismatch") >= 0, "cu_persisted_grant_wrong_error_reason");

  const unchanged_output = run(executable, context.run_directory, [
    "grant", "list", "--grant-store", store
  ]);
  const unchanged = reply(unchanged_output, "cu_persisted_grant_list_before");
  ensure(unchanged_output.success === true && unchanged.ok === true, "cu_persisted_grant_list_before_failed");
  ensure(unchanged.data.grants.length === 1, "cu_persisted_grant_list_before_count");
  ensure(unchanged.data.grants[0].consumed_uses === 0, "cu_persisted_grant_wrong_consumed");

  print("STEP intended operation consumes exactly once");
  const intended_output = run(executable, context.run_directory, [
    "--target", "current", "--grant-id", grant.grant_id, "--grant-store", store,
    "capabilities"
  ]);
  const intended = reply(intended_output, "cu_persisted_grant_intended");
  ensure(intended_output.success === true && intended.ok === true, "cu_persisted_grant_intended_failed");
  ensure(intended.command === "capabilities", "cu_persisted_grant_intended_command");

  const consumed_output = run(executable, context.run_directory, [
    "grant", "list", "--grant-store", store
  ]);
  const consumed = reply(consumed_output, "cu_persisted_grant_list_after");
  ensure(consumed.data.grants[0].consumed_uses === 1, "cu_persisted_grant_intended_consumption");
  ensure(consumed.data.grants[0].remaining_uses === 1, "cu_persisted_grant_remaining_budget");

  print("STEP revocation is durable and does not spend the remaining use");
  const revoked_output = run(executable, context.run_directory, [
    "grant", "revoke", "--grant-id", grant.grant_id, "--grant-store", store
  ]);
  const revoked = reply(revoked_output, "cu_persisted_grant_revoke");
  ensure(revoked_output.success === true && revoked.ok === true, "cu_persisted_grant_revoke_failed");
  ensure(revoked.data.grant.revoked === true, "cu_persisted_grant_revoke_state");

  const after_output = run(executable, context.run_directory, [
    "--target", "current", "--grant-id", grant.grant_id, "--grant-store", store,
    "capabilities"
  ]);
  const after = reply(after_output, "cu_persisted_grant_after_revoke");
  ensure(after_output.success !== true && after.ok === false, "cu_persisted_grant_revoked_false_success");
  ensure(after.error.message.indexOf("revoked") >= 0, "cu_persisted_grant_revoked_reason");

  const final_output = run(executable, context.run_directory, [
    "grant", "list", "--grant-store", store
  ]);
  const final_reply = reply(final_output, "cu_persisted_grant_final_list");
  ensure(final_reply.data.grants[0].consumed_uses === 1, "cu_persisted_grant_revoked_consumed");

  print("STEP bounded expiry is refused through the public gate");
  const expiry_store = rh.join(context.run_directory, "expiry-grants.json");
  const expiry_created_output = run(executable, context.run_directory, [
    "grant", "create", "--target", "current", "--scopes", "observe",
    "--operations", "capabilities", "--ttl-ms", "50", "--max-uses", "1",
    "--grant-store", expiry_store
  ]);
  const expiry_created = reply(expiry_created_output, "cu_persisted_grant_expiry_create");
  ensure(expiry_created_output.success === true && expiry_created.ok === true,
    "cu_persisted_grant_expiry_create_failed");
  const expiry_grant = expiry_created.data.grant;
  wait_until_utc_ms(expiry_grant.expires_at_utc_ms, "cu_persisted_grant_expiry_wait");
  const expired_output = run(executable, context.run_directory, [
    "--target", "current", "--grant-id", expiry_grant.grant_id,
    "--grant-store", expiry_store, "capabilities"
  ]);
  const expired = reply(expired_output, "cu_persisted_grant_expired");
  ensure(expired_output.success !== true && expired.ok === false,
    "cu_persisted_grant_expired_false_success");
  ensure(expired.error.code === "refused", "cu_persisted_grant_expired_error_kind");
  ensure(expired.error.message.indexOf("expired") >= 0,
    "cu_persisted_grant_expired_reason");

  print("STEP observe-only authority refuses actuation before effect");
  const actuation_store = rh.join(context.run_directory, "actuation-grants.json");
  const actuation_created_output = run(executable, context.run_directory, [
    "grant", "create", "--target", "current", "--scopes", "observe",
    "--operations", "window-place.center", "--ttl-ms", "60000", "--max-uses", "1",
    "--grant-store", actuation_store
  ]);
  const actuation_created = reply(actuation_created_output, "cu_persisted_grant_actuation_create");
  ensure(actuation_created_output.success === true && actuation_created.ok === true,
    "cu_persisted_grant_actuation_create_failed");
  const actuation_grant = actuation_created.data.grant;
  const actuation_output = run(executable, context.run_directory, [
    "--target", "current", "--grant-id", actuation_grant.grant_id,
    "--grant-store", actuation_store, "window-place", "--action", "center",
    "--window", "1"
  ]);
  const actuation = reply(actuation_output, "cu_persisted_grant_actuation");
  ensure(actuation_output.success !== true && actuation.ok === false,
    "cu_persisted_grant_actuation_false_success");
  ensure(actuation.error.code === "refused", "cu_persisted_grant_actuation_error_kind");
  ensure(actuation.error.message.indexOf("scope_missing") >= 0,
    "cu_persisted_grant_actuation_error_reason");

  const audit_path = rh.join(context.run_directory, "cu-audit.jsonl");
  const records = audit_records(audit_path);
  assert_authorized_pair(records, grant.grant_id);
  assert_one_denied(records, grant.grant_id, "operation_mismatch");
  assert_one_denied(records, grant.grant_id, "revoked");
  assert_one_denied(records, expiry_grant.grant_id, "expired");
  assert_one_denied(records, actuation_grant.grant_id, "scope_missing");
  assert_audit_has_no_authority_material(audit_path);
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, declared_evidence[0]);
  harness.remove_run(context);
  print("PASS: persisted grants bind operations, expire and revoke durably, refuse actuation without scope, and keep authority material out of audit records");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
