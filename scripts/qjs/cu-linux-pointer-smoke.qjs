// CEO: Linux pointer-position observe plus pointer-grab/ungrab with
// independent xdotool position and X11 grab-probe read-back on DISPLAY=:2,
// plus hover --name AT-SPI pointer delivery with typed usage (zero-handle),
// --coords/--bogus usage_rejects_unexpected or stay on accessibility-tree,
// miss, and host-limit paths and independent pyatspi extents plus xdotool
// read-back on the session display. Typed get-extents --name usage AND
// host-limit paths (including --coords/--bogus command=usage honesty) must
// both hold before process-state, desktop-state, and the hover actuate/read-back
// court (no if/else gating those courts on atspi_available). Fixture
// process-state + desktop-state bind before actuate. Acceptance is smoke
// read-back only: CU coords must match xdotool and grab status fields must
// match an independent XGrabPointer probe bracketing each verb; hover must
// land pointer-position on the pyatspi extents center. Prefer host-limit
// clarity over fake success. AT-SPI/--name only; no --coords or screenshot
// degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-pointer-position",
  "cu.linux-pointer-grab",
  "cu.linux-pointer-ungrab",
];

const BUTTON_NAME = "Fixture Press";
const MISSING_NODE = "No Such Button";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

const GRAB_PROBE_SCRIPT = [
  "import ctypes, ctypes.util, json, os",
  "if not os.environ.get('DISPLAY'):",
  "    raise SystemExit('missing DISPLAY')",
  "x11 = ctypes.CDLL(ctypes.util.find_library('X11'))",
  "x11.XOpenDisplay.restype = ctypes.c_void_p",
  "x11.XOpenDisplay.argtypes = [ctypes.c_char_p]",
  "x11.XDefaultScreen.restype = ctypes.c_int",
  "x11.XDefaultScreen.argtypes = [ctypes.c_void_p]",
  "x11.XRootWindow.restype = ctypes.c_ulong",
  "x11.XRootWindow.argtypes = [ctypes.c_void_p, ctypes.c_int]",
  "x11.XGrabPointer.restype = ctypes.c_int",
  "x11.XGrabPointer.argtypes = [",
  "    ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_uint,",
  "    ctypes.c_int, ctypes.c_int, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong,",
  "]",
  "x11.XUngrabPointer.restype = ctypes.c_int",
  "x11.XUngrabPointer.argtypes = [ctypes.c_void_p, ctypes.c_ulong]",
  "x11.XCloseDisplay.restype = ctypes.c_int",
  "x11.XCloseDisplay.argtypes = [ctypes.c_void_p]",
  "display = x11.XOpenDisplay(None)",
  "if not display:",
  "    raise SystemExit('XOpenDisplay failed')",
  "screen = x11.XDefaultScreen(display)",
  "root = x11.XRootWindow(display, screen)",
  "status = x11.XGrabPointer(display, root, 0, 0, 1, 1, 0, 0, 0)",
  "if status == 0:",
  "    x11.XUngrabPointer(display, 0)",
  "x11.XCloseDisplay(display)",
  "print(json.dumps({'grab_status': int(status)}))",
].join("\n");

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function flag_at(value, dotted) {
  return at(value, dotted) === true;
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function output_success(document) { return flag_at(document, "ok"); }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function remove_directory_bounded(path) {
  if (!rh.exists(path)) { return true; }
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    rh.try_remove_dir_all(path);
    if (!rh.exists(path)) { return true; }
    harness.sleep_ms(50);
  }
  return false;
}

function cu_env_x11(run_directory) {
  return {
    AGENTERM_WORKSPACE_PATH: run_directory,
    AGENTERM_IPC_ADDRESS: "cu-linux-pointer-smoke",
    DISPLAY: ":2",
    XDG_RUNTIME_DIR: "/tmp/xdg-runtime-box-2",
    DBUS_SESSION_BUS_ADDRESS: "unix:path=/tmp/dbus-sHZ4cfPDF4,guid=a3377782fc9878e89e5808586a8e3b0d",
  };
}

function cu_env_atspi(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply_x11(run_directory, executable, arguments) {
  const output = rh.command(
    executable, arguments,
    { cwd: run_directory, env: cu_env_x11(run_directory), timeout_ms: 30000 }
  );
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_pointer_cli_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu_json_x11(run_directory, executable, arguments) {
  const reply = run_cu_reply_x11(run_directory, executable, arguments);
  ensure(flag_at(reply, "ok"), "cu_linux_pointer_failed:" + JSON.stringify(reply));
  return reply;
}

function run_cu_reply_atspi(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env_atspi(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_pointer_atspi_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu_atspi(run_directory, executable, grant, cu_args) {
  const document = run_cu_reply_atspi(run_directory, executable, grant, cu_args);
  ensure(output_success(document), "cu_linux_pointer_atspi_reply:" + JSON.stringify(document));
  return document;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env_atspi(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function invoke_get_extents_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env_atspi(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_pointer_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function assert_hover_usage_limit(run_directory, executable, env) {
  const hover_missing_name = run_cu_reply_atspi(run_directory, executable, "observe,actuate", [
    "hover", "--window", "1",
  ], env);
  ensure(!output_success(hover_missing_name), "cu_linux_pointer_hover_usage_ok:" + JSON.stringify(hover_missing_name));
  ensure(
    text_at(hover_missing_name, "error.code") === "usage",
    "cu_linux_pointer_hover_usage_code:" + JSON.stringify(hover_missing_name.error)
  );
  ensure(
    text_at(hover_missing_name, "command") === "usage",
    "cu_linux_pointer_hover_usage_command:" + JSON.stringify(hover_missing_name)
  );
  ensure(
    text_at(hover_missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_pointer_hover_usage_message:" + JSON.stringify(hover_missing_name.error)
  );

  const hover_missing_window = run_cu_reply_atspi(run_directory, executable, "observe,actuate", [
    "hover", "--name", BUTTON_NAME,
  ], env);
  ensure(!output_success(hover_missing_window), "cu_linux_pointer_hover_usage_window_ok:" + JSON.stringify(hover_missing_window));
  ensure(
    text_at(hover_missing_window, "error.code") === "invalid_input",
    "cu_linux_pointer_hover_usage_window_code:" + JSON.stringify(hover_missing_window.error)
  );
  ensure(
    text_at(hover_missing_window, "error.message").indexOf("--window") >= 0,
    "cu_linux_pointer_hover_usage_window_message:" + JSON.stringify(hover_missing_window.error)
  );

  const zero_handle = run_cu_reply_atspi(run_directory, executable, "observe,actuate", [
    "hover", "--window", "0", "--name", BUTTON_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_pointer_hover_zero_handle_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_pointer_hover_zero_handle_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("--window") >= 0,
    "cu_linux_pointer_hover_zero_handle_message:" + JSON.stringify(zero_handle.error)
  );

  const hover_coords = run_cu_reply_atspi(run_directory, executable, "observe,actuate", [
    "hover", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(hover_coords), "cu_linux_pointer_hover_coords_ok:" + JSON.stringify(hover_coords));
  ensure(
    text_at(hover_coords, "error.code") === "usage",
    "cu_linux_pointer_hover_coords_code:" + JSON.stringify(hover_coords.error)
  );
  ensure(
    text_at(hover_coords, "command") === "usage",
    "cu_linux_pointer_hover_coords_command:" + JSON.stringify(hover_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(hover_coords, "error.message"), "--coords")
      || text_at(hover_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_pointer_hover_coords_message:" + JSON.stringify(hover_coords.error)
  );

  const hover_bogus = run_cu_reply_atspi(run_directory, executable, "observe,actuate", [
    "hover", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(hover_bogus), "cu_linux_pointer_hover_bogus_ok:" + JSON.stringify(hover_bogus));
  ensure(
    text_at(hover_bogus, "error.code") === "usage",
    "cu_linux_pointer_hover_bogus_code:" + JSON.stringify(hover_bogus.error)
  );
  ensure(
    text_at(hover_bogus, "command") === "usage",
    "cu_linux_pointer_hover_bogus_command:" + JSON.stringify(hover_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(hover_bogus, "error.message"), "--bogus")
      || text_at(hover_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_pointer_hover_bogus_message:" + JSON.stringify(hover_bogus.error)
  );
}

function assert_hover_reject_coords_or_stay_named(run_directory, executable, handle, label) {
  const coords = run_cu_reply_atspi(run_directory, executable, "observe,actuate", [
    "hover", "--window", handle, "--name", BUTTON_NAME, "--coords", "10,10",
  ]);
  if (!output_success(coords)) {
    ensure(
      text_at(coords, "error.code") === "usage",
      "cu_linux_pointer_hover_coords_code_" + label + ":" + JSON.stringify(coords.error)
    );
    ensure(
      text_at(coords, "command") === "usage",
      "cu_linux_pointer_hover_coords_command_" + label + ":" + JSON.stringify(coords)
    );
    ensure(
      usage_rejects_unexpected(text_at(coords, "error.message"), "--coords")
        || text_at(coords, "error.message").indexOf("--name") >= 0,
      "cu_linux_pointer_hover_coords_message_" + label + ":" + JSON.stringify(coords.error)
    );
  } else {
    ensure(
      text_at(coords, "data.addressing") === "accessibility-tree"
        && text_at(coords, "data.matched.name") === BUTTON_NAME,
      "cu_linux_pointer_hover_coords_named_" + label + ":" + JSON.stringify(coords.data)
    );
  }

  const bogus = run_cu_reply_atspi(run_directory, executable, "observe,actuate", [
    "hover", "--window", handle, "--name", BUTTON_NAME, "--bogus",
  ]);
  if (!output_success(bogus)) {
    ensure(
      text_at(bogus, "error.code") === "usage",
      "cu_linux_pointer_hover_bogus_code_" + label + ":" + JSON.stringify(bogus.error)
    );
    ensure(
      text_at(bogus, "command") === "usage",
      "cu_linux_pointer_hover_bogus_command_" + label + ":" + JSON.stringify(bogus)
    );
    ensure(
      usage_rejects_unexpected(text_at(bogus, "error.message"), "--bogus")
        || text_at(bogus, "error.message").indexOf("--name") >= 0,
      "cu_linux_pointer_hover_bogus_message_" + label + ":" + JSON.stringify(bogus.error)
    );
  } else {
    ensure(
      text_at(bogus, "data.addressing") === "accessibility-tree"
        && text_at(bogus, "data.matched.name") === BUTTON_NAME,
      "cu_linux_pointer_hover_bogus_named_" + label + ":" + JSON.stringify(bogus.data)
    );
  }
}

function assert_get_extents_reject_coords_or_stay_named(
  run_directory, executable, handle, node_name, label
) {
  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "" + handle, "--name", node_name, "--coords", "10,10",
  ]);
  if (!output_success(extents_coords)) {
    ensure(
      text_at(extents_coords, "error.code") === "usage",
      "cu_linux_pointer_extents_coords_code_" + label + ":" + JSON.stringify(extents_coords.error)
    );
    ensure(
      text_at(extents_coords, "command") === "usage",
      "cu_linux_pointer_extents_coords_command_" + label + ":" + JSON.stringify(extents_coords)
    );
    ensure(
      usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
        || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
      "cu_linux_pointer_extents_coords_message_" + label + ":" + JSON.stringify(extents_coords.error)
    );
  } else {
    ensure(
      text_at(extents_coords, "data.addressing") === "accessibility-tree"
        && text_at(extents_coords, "data.matched.name") === node_name,
      "cu_linux_pointer_extents_coords_named_" + label + ":" + JSON.stringify(extents_coords.data)
    );
  }

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "" + handle, "--name", node_name, "--bogus",
  ]);
  if (!output_success(extents_bogus)) {
    ensure(
      text_at(extents_bogus, "error.code") === "usage",
      "cu_linux_pointer_extents_bogus_code_" + label + ":" + JSON.stringify(extents_bogus.error)
    );
    ensure(
      text_at(extents_bogus, "command") === "usage",
      "cu_linux_pointer_extents_bogus_command_" + label + ":" + JSON.stringify(extents_bogus)
    );
    ensure(
      usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
        || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
      "cu_linux_pointer_extents_bogus_message_" + label + ":" + JSON.stringify(extents_bogus.error)
    );
  } else {
    ensure(
      text_at(extents_bogus, "data.addressing") === "accessibility-tree"
        && text_at(extents_bogus, "data.matched.name") === node_name,
      "cu_linux_pointer_extents_bogus_named_" + label + ":" + JSON.stringify(extents_bogus.data)
    );
  }
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", BUTTON_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_pointer_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_pointer_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_pointer_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_pointer_extents_missing_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_pointer_extents_missing_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_pointer_extents_missing_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_pointer_extents_missing_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_pointer_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_pointer_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_pointer_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_pointer_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_pointer_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_pointer_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_pointer_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_pointer_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", BUTTON_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_pointer_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_pointer_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_pointer_extents_unavailable_code:" + code
  );
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu_atspi(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_pointer_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_pointer_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu_atspi(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_pointer_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_pointer_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_pointer_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function assert_hover_missing_node(run_directory, executable, handle, label) {
  const hover_missing = run_cu_reply_atspi(run_directory, executable, "observe,actuate", [
    "hover", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!output_success(hover_missing), "cu_linux_pointer_hover_missing_ok_" + label);
  ensure(
    text_at(hover_missing, "error.code") === "a11y_node_not_found",
    "cu_linux_pointer_hover_missing_code_" + label + ":" + JSON.stringify(hover_missing.error)
  );
}

function assert_hover_host_limit_when_atspi_absent(run_directory, executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
  const hover_reply = run_cu_reply_atspi(run_directory, executable, "observe,actuate", [
    "hover", "--window", "1", "--name", BUTTON_NAME,
  ], env);
  ensure(!output_success(hover_reply), "cu_linux_pointer_hover_unavailable_ok:" + JSON.stringify(hover_reply));
  const hover_code = text_at(hover_reply, "error.code");
  ensure(
    hover_code === "a11y_backend_failed" || hover_code === "unsupported" || hover_code === "bad_handle",
    "cu_linux_pointer_hover_unavailable_code:" + hover_code
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu_atspi(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function extents_center(x, y, width, height) {
  return {
    x: x + rh.int_of(width / 2),
    y: y + rh.int_of(height / 2),
  };
}

function independent_pyatspi_extents(run_directory, executable, fixture_title, node_name) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "want = sys.argv[2]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and w.name == title:",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    if (node.name or '') == want:",
    "        return node",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_pointer_atspi_no_frame')",
    "node = walk(frame)",
    "if node is None:",
    "    raise SystemExit('cu_linux_pointer_atspi_miss:' + want)",
    "component = node.queryComponent()",
    "ext = component.getExtents(pyatspi.DESKTOP_COORDS)",
    "x, y, w, h = int(ext.x), int(ext.y), int(ext.width), int(ext.height)",
    "print(json.dumps({",
    "    'name': want,",
    "    'x': x, 'y': y, 'width': w, 'height': h,",
    "    'center_x': x + w // 2,",
    "    'center_y': y + h // 2,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, fixture_title, node_name], {
    cwd: run_directory,
    env: cu_env_atspi(executable),
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_pointer_pyatspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function pointer_xy_x11(run_directory, executable) {
  const reply = run_cu_json_x11(run_directory, executable, [
    "--target", "current", "--grant", "observe", "pointer-position"
  ]);
  const coords = reply.data.coords;
  ensure(coords.length === 2, "cu_linux_pointer_coords:" + JSON.stringify(reply.data));
  return [rh.int_of(coords[0]), rh.int_of(coords[1])];
}

function pointer_pair_from_data(data, field_name) {
  const coords = rh.field(data, field_name);
  ensure(coords !== undefined && coords !== null && coords.length === 2,
         "cu_linux_pointer_pair:" + field_name + ":" + JSON.stringify(data));
  return [rh.int_of(coords[0]), rh.int_of(coords[1])];
}

function coords_equal(left, right) {
  return left[0] === right[0] && left[1] === right[1];
}

function independent_pointer_xy_x11(run_directory) {
  const output = rh.command("xdotool", ["getmouselocation", "--shell"], {
    cwd: run_directory,
    env: cu_env_x11(run_directory),
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_pointer_xdotool_failed:" + output.stderr);
  let x = null;
  let y = null;
  for (const line of output.stdout.split("\n")) {
    if (line.startsWith("X=")) { x = rh.parse_int(line.slice(2)); }
    if (line.startsWith("Y=")) { y = rh.parse_int(line.slice(2)); }
  }
  ensure(x !== null && y !== null, "cu_linux_pointer_xdotool_parse:" + output.stdout);
  return [x, y];
}

function independent_pointer_xy_atspi(run_directory, executable) {
  const output = rh.command("xdotool", ["getmouselocation", "--shell"], {
    cwd: run_directory,
    env: cu_env_atspi(executable),
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_pointer_atspi_xdotool:" + output.stderr);
  let x = null;
  let y = null;
  for (const line of output.stdout.split("\n")) {
    if (line.startsWith("X=")) { x = rh.parse_int(line.slice(2)); }
    if (line.startsWith("Y=")) { y = rh.parse_int(line.slice(2)); }
  }
  ensure(x !== null && y !== null, "cu_linux_pointer_atspi_xdotool_parse:" + output.stdout);
  return [x, y];
}

function independent_grab_status(run_directory) {
  const output = rh.command("python3", ["-c", GRAB_PROBE_SCRIPT], {
    cwd: run_directory,
    env: cu_env_x11(run_directory),
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_pointer_grab_probe_failed:" + output.stderr);
  const probe = JSON.parse(output.stdout.trim());
  return int_at(probe, "grab_status");
}

function assert_pointer_matches_independent_x11(run_directory, executable, label) {
  const cu = pointer_xy_x11(run_directory, executable);
  const independent = independent_pointer_xy_x11(run_directory);
  ensure(
    coords_equal(cu, independent),
    "cu_linux_pointer_position_independent_mismatch:" + label + ":" + JSON.stringify({ cu, independent })
  );
  return cu;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_pointer_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-pointer");
const run_directory = rh.join(repo, "target/cu-linux-pointer-smoke-run");
ensure(remove_directory_bounded(run_directory), "cu_linux_pointer_stale_directory_locked");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_pointer_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env_atspi(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP hover typed-fail usage when --window/--name is missing and when --coords/--bogus is present (usage_rejects_unexpected + command=usage) before hover actuate/read-back court");
  assert_hover_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before process-state/desktop-state and hover actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and hover actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP hover typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and hover actuate/read-back court");
  assert_hover_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents/hover host-limit already held; pointer-position/grab read-back still uses xdotool/X11");
  }

  print("STEP independent xdotool read-back agrees with pointer-position on :2");
  const before = assert_pointer_matches_independent_x11(run_directory, executable, "baseline");
  ensure(
    before[0] === rh.parse_int("" + before[0]) && before[1] === rh.parse_int("" + before[1]),
    "cu_linux_pointer_position_not_integers:" + JSON.stringify(before)
  );
  const second = assert_pointer_matches_independent_x11(run_directory, executable, "stable");
  ensure(
    coords_equal(second, before),
    "cu_linux_pointer_position_stable:" + JSON.stringify({ before, second })
  );
  succeeded += 1;

  print("STEP pointer-grab verifies with independent X11 grab-probe read-back");
  ensure(
    independent_grab_status(run_directory) === 0,
    "cu_linux_pointer_grab_before_not_available"
  );
  const grab = run_cu_json_x11(run_directory, executable, [
    "--target", "current", "--grant", "actuate", "pointer-grab"
  ]);
  ensure(
    text_at(grab, "data.effect") === "verified"
      && int_at(grab, "data.grab_status") === 0
      && int_at(grab, "data.verify_status") === 1
      && flag_at(grab, "data.verification.verified"),
    "cu_linux_pointer_grab:" + JSON.stringify(grab.data)
  );
  ensure(
    coords_equal(pointer_pair_from_data(grab.data, "pointer"), before),
    "cu_linux_pointer_grab_pointer_mismatch:" + JSON.stringify(grab.data)
  );
  ensure(
    independent_grab_status(run_directory) === 0,
    "cu_linux_pointer_grab_after_not_released"
  );
  const after_grab = assert_pointer_matches_independent_x11(run_directory, executable, "after_grab");
  ensure(
    coords_equal(after_grab, before),
    "cu_linux_pointer_grab_moved_pointer:" + JSON.stringify({ before, after_grab })
  );
  succeeded += 1;

  print("STEP pointer-ungrab proves grab is available again with independent probe");
  const ungrab = run_cu_json_x11(run_directory, executable, [
    "--target", "current", "--grant", "actuate", "pointer-ungrab"
  ]);
  ensure(
    text_at(ungrab, "data.effect") === "verified"
      && int_at(ungrab, "data.verify_status") === 0
      && flag_at(ungrab, "data.verification.verified"),
    "cu_linux_pointer_ungrab:" + JSON.stringify(ungrab.data)
  );
  ensure(
    int_at(ungrab, "data.verify_status") === independent_grab_status(run_directory),
    "cu_linux_pointer_ungrab_probe_mismatch:" + JSON.stringify(ungrab.data)
  );
  const after_ungrab = assert_pointer_matches_independent_x11(run_directory, executable, "after_ungrab");
  ensure(
    coords_equal(after_ungrab, before),
    "cu_linux_pointer_ungrab_moved_pointer:" + JSON.stringify({ before, after_ungrab })
  );
  succeeded += 1;

  if (atspi_available) {
    print("STEP start owned GTK fixture and resolve window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

    const window_wait = run_cu_atspi(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_pointer_window_wait");

    const inventory_row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(inventory_row !== null, "cu_linux_pointer_window_identity");
    const handle_text = "" + int_at(inventory_row, "handle");
    ensure(int_at(inventory_row, "handle") > 0, "cu_linux_pointer_handle:" + JSON.stringify(inventory_row));

    print("STEP process-state binds the owned fixture pid before hover actuate/read-back court");
    assert_fixture_process_state(run_directory, executable, fixture_pid);

    print("STEP desktop-state window row agrees with inventory before hover actuate/read-back court");
    assert_fixture_desktop_state(
      run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
    );

    print("STEP hover typed-fail a11y_node_not_found when the named button is missing");
    assert_hover_missing_node(run_directory, executable, handle_text, "before_actuate");

    print("STEP independent pyatspi extents and CU get-extents agree before hover");
    const pyatspi_button = independent_pyatspi_extents(
      run_directory, executable, fixture_title, BUTTON_NAME
    );
    const button_extents = run_cu_atspi(run_directory, executable, "observe", [
      "get-extents", "--window", handle_text, "--name", BUTTON_NAME,
    ]);
    const cu_center = extents_center(
      int_at(button_extents, "data.extents.x"),
      int_at(button_extents, "data.extents.y"),
      int_at(button_extents, "data.extents.width"),
      int_at(button_extents, "data.extents.height")
    );
    ensure(
      cu_center.x === pyatspi_button.center_x && cu_center.y === pyatspi_button.center_y,
      "cu_linux_pointer_extents_agree:" + JSON.stringify({ cu_center, pyatspi_button })
    );

    print("STEP hover --name " + BUTTON_NAME + " moves pointer through AT-SPI GenerateMouseEvent(abs)");
    const hovered = run_cu_atspi(run_directory, executable, "observe,actuate", [
      "hover", "--window", handle_text, "--name", BUTTON_NAME,
    ]);
    ensure(
      flag_at(hovered, "data.performed")
        && text_at(hovered, "data.addressing") === "accessibility-tree",
      "cu_linux_pointer_hover:" + JSON.stringify(hovered.data)
    );

    print("STEP independent xdotool pointer lands on pyatspi extents center after hover");
    const xdotool_pointer = independent_pointer_xy_atspi(run_directory, executable);
    ensure(
      xdotool_pointer[0] === pyatspi_button.center_x
        && xdotool_pointer[1] === pyatspi_button.center_y,
      "cu_linux_pointer_hover_xdotool:" + JSON.stringify({
        xdotool_pointer,
        pyatspi_button,
      })
    );

    print("STEP CU pointer-position agrees with independent xdotool read-back after hover");
    const pointer_after = run_cu_atspi(run_directory, executable, "observe", [
      "pointer-position",
    ]);
    const pointer_coords = at(pointer_after, "data.coords");
    const pointer_x = rh.int_of(pointer_coords[0]);
    const pointer_y = rh.int_of(pointer_coords[1]);
    ensure(
      pointer_x === xdotool_pointer[0] && pointer_y === xdotool_pointer[1],
      "cu_linux_pointer_hover_pointer:" + JSON.stringify({
        pointer_x,
        pointer_y,
        xdotool_pointer,
      })
    );

    print("STEP get-extents --name with --coords/--bogus rejects as command=usage or stays accessibility-tree before hover read-back court");
    assert_get_extents_reject_coords_or_stay_named(
      run_directory, executable, handle_text, BUTTON_NAME, "before_hover_actuate"
    );

    print("STEP hover --name with --coords/--bogus rejects as command=usage or stays accessibility-tree after read-back court");
    assert_hover_reject_coords_or_stay_named(run_directory, executable, handle_text, "after_hover");
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

if (succeeded === 0) {
  if (!remove_directory_bounded(run_directory)) {
    failure = failure + ":cu_linux_pointer_cleanup_locked";
  }
  harness.remove_run(context);
  throw failure;
}

ensure(remove_directory_bounded(run_directory), "cu_linux_pointer_cleanup_failed");
harness.emit_evidence(context, declared_evidence, "cu.linux-pointer-position");
harness.emit_evidence(context, declared_evidence, "cu.linux-pointer-grab");
harness.emit_evidence(context, declared_evidence, "cu.linux-pointer-ungrab");
harness.remove_run(context);
ensure(failure === "", failure);
ensure(succeeded === declared_evidence.length, "cu_linux_pointer_incomplete:" + succeeded);
if (atspi_available) {
  print("PASS: cu-linux-pointer-smoke with typed hover --coords/--bogus usage_rejects_unexpected, get-extents --name pyatspi agreement, typed get-extents usage/host-limit plus --coords/--bogus command=usage honesty, process-state/desktop-state binding before actuate, xdotool/X11 grab-probe read-back, and hover --name pyatspi pointer read-back (AT-SPI --name, no --coords; " + succeeded + " evidence ids)");
} else {
  print("PASS: cu-linux-pointer-smoke with typed hover --coords/--bogus usage_rejects_unexpected, typed get-extents host-limit honesty, and xdotool/X11 grab-probe read-back (AT-SPI --name, no --coords; " + succeeded + " evidence ids)");
}
