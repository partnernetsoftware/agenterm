// Run one ordered cold-to-warm Windows Quick experiment. The workflow owns
// runner selection and sccache setup; this native script owns sample semantics.
//
// Args: CACHE_STRATEGY EVIDENCE_DIRECTORY
// Ported from scripts/rh/performance-samples.rh; runs under `--profile tool`.
// Windows-only by construction (it drives `check.cmd` through `cmd.exe`).
import * as rh from "lib/rh_compat";

const args = rh.args();
if (args.length !== 2) { throw "performance_samples_arguments"; }

const cache = args[0];
rh.require(
  cache === "target" || cache === "sccache" || cache === "none",
  "performance_samples_cache"
);
const evidence = rh.absolute(args[1]);
rh.create_dir_all(evidence);
const run_id = "perf-" + rh.pid() + "-" + rh.now_ms();

for (let sample = 1; sample < 4; sample = sample + 1) {
  const sample_tag = "" + sample;

  if (sample === 1 || cache !== "target") {
    const clean_code = rh.command("cargo", ["clean"], { timeout_ms: 300000 }).exit_code;
    rh.require(clean_code === 0, "performance_samples_clean:" + sample_tag);
  }
  if (cache === "sccache") {
    const reset_code = rh.command("sccache", ["--zero-stats"], { timeout_ms: 30000 }).exit_code;
    rh.require(reset_code === 0, "performance_samples_sccache_reset:" + sample_tag);
  }

  const timing = rh.join(evidence, "performance-" + sample_tag + ".json");
  // This script clears Cargo output, while the bootstrap worker cache lives
  // outside it. Give every sample a fresh cache root so a host-level cache hit
  // cannot skip the rebuild that restores Quick's target/debug CLI probe.
  const bootstrap_cache = rh.absolute(
    "target/qualification/performance-bootstrap-cache-" + sample_tag
  );
  const quick_cmdline = "check.cmd --quick --timing \"" + timing + "\"";
  const quick_code = rh.command(
    "cmd.exe",
    ["/d", "/s", "/c", quick_cmdline],
    {
      timeout_ms: 900000,
      env: { AGENTERM_BOOTSTRAP_CACHE_ROOT: bootstrap_cache }
    }
  ).exit_code;
  rh.require(quick_code === 0, "performance_samples_quick:" + sample_tag);
  rh.require(
    rh.exists(timing) && rh.symlink_metadata(timing).is_file,
    "performance_samples_timing_missing:" + sample_tag
  );
  const timing_record = JSON.parse(rh.read_text(timing));
  timing_record.experiment_run_id = run_id;
  rh.atomic_write(timing, rh.stringify_pretty(timing_record) + "\n");

  if (cache === "sccache") {
    const stats_path = rh.absolute("sccache-" + sample_tag + ".json");
    const stats = rh.command(
      "sccache",
      ["--show-stats", "--stats-format", "json"],
      { timeout_ms: 30000 }
    );
    if (stats.success === true && stats.stdout !== "") {
      rh.atomic_write(stats_path, stats.stdout);
    }
    if (stats.success !== true && stats.stderr !== "") {
      print(stats.stderr);
    }
    rh.require(
      stats.success === true && rh.exists(stats_path),
      "performance_samples_sccache_stats:" + sample_tag + ":" + stats.stderr.trim()
    );
  }
}

const report = {
  cache_strategy: cache,
  samples: 3,
  evidence_directory: evidence
};
print(rh.stringify_pretty(report));
return;
