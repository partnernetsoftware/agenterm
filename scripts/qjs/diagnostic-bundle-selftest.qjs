// Prove retained CLI, GUI, and Script failure bundles are bounded, private,
// identity-checked, and orphan-free through public executable journeys.
//
// Args: REPO CLI_EXE SCRIPT_EXE GUI_EXE
// Ported from scripts/rh/diagnostic-bundle-selftest.rh; runs under
// `--profile tool`. The two probe children are long-lived handles
// (harness.start / state / wait / kill): the .qjs ports of theme-smoke and
// script-smoke, run as `SCRIPT_EXE cli script run --profile tool ...` where
// rh ran `SCRIPT_EXE rh run ENTRY --profile local ...`. The step budget is
// the qjs engine's (100M, the ceiling), not rh's 10M: a smoke that drives a
// GUI measures past 16M here.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";
import * as path from "lib/path";

function assert_ok(condition, message) {
  if (!condition) { throw message; }
}

function trimmed(value) {
  return ("" + value).trim();
}

// Compare absolute host paths lexically after normalizing Windows separators,
// case, and dot segments. This is stricter than prefix matching: deletion
// still requires the candidate's exact parent to equal the owned root.
function comparable_path(p) {
  const parts = ("" + p).replaceAll("\\", "/").toLowerCase().split("/");
  const normalized = [];
  for (const part of parts) {
    if (part === "" || part === ".") { continue; }
    if (part === "..") {
      assert_ok(
        normalized.length > 0 && !normalized[normalized.length - 1].endsWith(":"),
        "diagnostic_path_parent_escape"
      );
      normalized.pop();
    } else {
      normalized.push(part);
    }
  }
  return normalized.join("/");
}

function file_name(p) {
  const parts = comparable_path(p).split("/");
  return parts[parts.length - 1];
}

function array_has_path(values, candidate) {
  const wanted = comparable_path(candidate);
  for (const value of values) {
    if (comparable_path(value) === wanted) { return true; }
  }
  return false;
}

function retained_bundles(bundle_root) {
  const paths = [];
  if (!rh.exists(bundle_root)) { return paths; }
  for (const entry of rh.read_dir(bundle_root)) {
    if (entry.is_dir && !entry.is_symlink) {
      paths.push(rh.absolute(entry.path));
    }
  }
  return paths;
}

function only_new_bundle(bundle_root, before, suite) {
  const matches = [];
  for (const p of retained_bundles(bundle_root)) {
    const name = file_name(p);
    if (!array_has_path(before, p) && name.startsWith(suite + "-")) {
      matches.push(p);
    }
  }
  if (matches.length !== 1) {
    return {
      error: "diagnostic_new_bundle_count:" + suite + ":" + matches.length,
      path: ""
    };
  }
  return { error: "", path: matches[0] };
}

function remove_bundle(bundle_root, p) {
  const root = rh.absolute(bundle_root);
  const resolved = rh.absolute(p);
  assert_ok(
    comparable_path(path.parent(comparable_path(resolved))) === comparable_path(root),
    "diagnostic_bundle_outside_owned_root:" + resolved
  );
  if (rh.exists(resolved)) { rh.remove_dir_all(resolved); }
  assert_ok(!rh.exists(resolved), "diagnostic_bundle_cleanup_failed:" + resolved);
}

function assert_bounded_bundle(bundle, suite, marker_kind) {
  const manifest_path = path.join(bundle, "manifest.json");
  const cleanup_path = path.join(bundle, "cleanup.json");
  if (!rh.exists(manifest_path) || !rh.exists(cleanup_path)) {
    return "diagnostic_bundle_required_file:" + suite;
  }
  const manifest = rh.parse_file(manifest_path);
  const cleanup = rh.parse_file(cleanup_path);
  const marker = "INTERNAL_FAILURE_BUNDLE_PROBE:" + marker_kind + ":" + manifest.run_id;
  const marker_count = ("" + manifest.failure).split(marker).length - 1;
  if (manifest.schema_version !== 1 || manifest.suite !== suite || marker_count !== 1) {
    return "diagnostic_bundle_identity:" + suite + ":" + manifest.failure;
  }
  if (manifest.privacy.command_arguments !== "known content-bearing arguments redacted"
      || manifest.privacy.output_limit_bytes !== 65536
      || manifest.privacy.pane_capture !== "disabled for this suite"
      || rh.array_has(manifest.diagnostics, "capture-pane.txt")) {
    return "diagnostic_bundle_privacy:" + suite;
  }

  const failure_directory = path.join(bundle, "failure");
  const names = [];
  for (const name of manifest.diagnostics) {
    if (file_name(name) !== name || rh.array_has(names, name)) {
      return "diagnostic_bundle_local_unique_name:" + suite;
    }
    names.push(name);
    const diagnostic = path.join(failure_directory, name);
    if (!rh.exists(diagnostic)
        || comparable_path(path.parent(comparable_path(rh.absolute(diagnostic))))
            !== comparable_path(rh.absolute(failure_directory))
        || rh.metadata(diagnostic).len > 65792) {
      return "diagnostic_bundle_diagnostic_bound:" + suite + ":" + name;
    }
  }
  const command_log = path.join(bundle, "" + manifest.command_log);
  if (!rh.exists(command_log) || rh.metadata(command_log).len > 524544) {
    return "diagnostic_bundle_command_log_bound:" + suite;
  }
  if (!cleanup.orphan_free
      || cleanup.remaining_pids.length !== 0
      || cleanup.remaining_windows.length !== 0
      || cleanup.remaining_registrations.length !== 0) {
    return "diagnostic_bundle_cleanup_not_orphan_free:" + suite;
  }

  if (suite === "theme") {
    const snapshot = rh.read_text(path.join(failure_directory, "ui-snapshot.txt"));
    if (!snapshot.startsWith("exit_code=0")
        || !snapshot.includes("\"protocol_version\": 1")
        || !snapshot.includes("\"window\"")) {
      return "diagnostic_theme_snapshot_invalid";
    }
  }
  if (suite === "script") {
    const commands_text = rh.read_text(command_log);
    const commands = JSON.parse(commands_text);
    let successful_worker = false;
    const observed_evals = [];
    for (const command of commands) {
      const output = trimmed(command.output);
      if (rh.array_has(command.arguments, "script") && rh.array_has(command.arguments, "eval")) {
        observed_evals.push({ exit_code: command.exit_code, output: output });
        if (command.exit_code === 0 && output === "42") { successful_worker = true; }
      }
    }
    if (!successful_worker) {
      return "diagnostic_script_success_not_retained:" + JSON.stringify(observed_evals);
    }
    let retained = manifest.failure + "\n" + commands_text;
    for (const name of manifest.diagnostics) {
      retained = retained + "\n" + rh.read_text(path.join(failure_directory, name));
    }
    if (retained.includes("AUDIT_ENV_SECRET") || retained.includes("40 + 2")) {
      return "diagnostic_script_private_input_retained";
    }
  }
  return "";
}

// One probe child, started and handed back as a door handle. rh's
// `rh run ENTRY --profile local --project-root REPO ...`; the qjs worker is
// `cli script run --profile tool ...` (no `--project-root`: it disables
// `lib/...` resolution for the entry, measured on 2026-08-29).
function start_task_probe(context, script, repo, entry, probe_arguments, timeout, extra_limits) {
  const arguments = [
    "cli", "script", "run",
    "--profile", "tool",
    "--timeout-ms", "" + timeout,
    "--max-operations", "100000000"
  ];
  for (const limit of extra_limits) { arguments.push("" + limit); }
  arguments.push("" + entry);
  arguments.push("--");
  for (const probe_argument of probe_arguments) { arguments.push("" + probe_argument); }
  arguments.push("--internal-failure-bundle-probe");
  const spec = harness.configured_spec(context, "" + script, arguments);
  spec.current_dir = "" + repo;
  spec.timeout_ms = 45000;
  return harness.start(spec);
}

function complete_task_probe(handle, suite) {
  const output = harness.wait(handle, 45000);
  if (output.success) { return "diagnostic_probe_unexpected_success:" + suite; }
  return "";
}

// Kill and reap a probe that is still running. A waited handle answers
// "exited", so this is a no-op after `complete_task_probe`.
function reap_probe(handle) {
  if (harness.state(handle) === "running") {
    process_kill(handle);
    harness.wait(handle, 2000);
  }
}

const args = rh.args();
if (args.length !== 4) { throw "expected: REPO CLI_EXE SCRIPT_EXE GUI_EXE"; }

const repo = rh.absolute(args[0]);
const cli = rh.absolute(args[1]);
const script = rh.absolute(args[2]);
const gui = rh.absolute(args[3]);
if (!rh.exists(cli) || !rh.exists(script) || !rh.exists(gui)) {
  throw "diagnostic_executable_missing";
}
const bundle_root = path.join(repo, "target/smoke/test-runs");
const initial = retained_bundles(bundle_root);
const outer_context = harness.new_context(repo, "diagnostic-orchestrator");
let failure = "";

if (failure === "") {
  print("STEP CLI failure bundle");
  const before = retained_bundles(bundle_root);
  const cli_context = harness.new_context(repo, "diagnostic-cli-probe");
  const marker = "INTERNAL_FAILURE_BUNDLE_PROBE:cli:" + cli_context.run_id;
  const result = harness.run_cli(cli_context, cli, ["__diagnostic_bundle_probe_invalid__"], 1, []);
  if (result.success) {
    failure = "diagnostic_cli_probe_succeeded";
  } else {
    harness.complete(cli_context, [], false, marker + "\n" + result.stdout + result.stderr);
    const cli_match = only_new_bundle(bundle_root, before, "diagnostic-cli-probe");
    if (cli_match.error !== "") {
      failure = "" + cli_match.error;
    } else {
      failure = assert_bounded_bundle(cli_match.path, "diagnostic-cli-probe", "cli");
      if (failure === "") { remove_bundle(bundle_root, cli_match.path); }
    }
  }
}

if (failure === "") {
  print("STEP GUI and script-worker failure bundles in parallel");
  const gui_before = retained_bundles(bundle_root);
  const gui_probe = start_task_probe(
    outer_context, script, repo,
    path.join(repo, "scripts/qjs/theme-smoke.qjs"),
    [repo, gui, cli], "60000", []
  );
  const script_before = retained_bundles(bundle_root);
  const script_probe = start_task_probe(
    outer_context, script, repo,
    path.join(repo, "scripts/qjs/script-qjswasm-smoke.qjs"),
    [repo, cli, script, gui], "120000",
    ["--max-string-bytes", "8388608", "--max-output-bytes", "1048576"]
  );
  failure = complete_task_probe(gui_probe, "theme");
  if (failure === "") {
    const gui_match = only_new_bundle(bundle_root, gui_before, "theme");
    if (gui_match.error !== "") {
      failure = "" + gui_match.error;
    } else {
      failure = assert_bounded_bundle(gui_match.path, "theme", "gui");
      if (failure === "") { remove_bundle(bundle_root, gui_match.path); }
    }
  }
  if (failure === "") { failure = complete_task_probe(script_probe, "script"); }
  if (failure === "") {
    const script_match = only_new_bundle(bundle_root, script_before, "script");
    if (script_match.error !== "") {
      failure = "" + script_match.error;
    } else {
      failure = assert_bounded_bundle(script_match.path, "script", "script");
      if (failure === "") { remove_bundle(bundle_root, script_match.path); }
    }
  }
  if (failure === "") {
    print("PASS: CLI, GUI, and script failure bundles are bounded and orphan-free");
  }
  reap_probe(gui_probe);
  reap_probe(script_probe);
}
for (const p of retained_bundles(bundle_root)) {
  if (!array_has_path(initial, p)
      && comparable_path(p) !== comparable_path(outer_context.run_directory)) {
    remove_bundle(bundle_root, p);
  }
}
harness.remove_run(outer_context);
if (failure !== "") { throw failure; }
return;
