// CEO: Linux process-threads honesty with independent /proc/<pid>/task read-back.
// Acceptance is smoke read-back only: CU process-threads must agree with thread
// ids, counts and stat-derived fields outside agenterm-cu for the same live PID.
// Typed process-threads usage must reject AT-SPI-shaped --name (with --window/--role),
// --coords, --bogus, and other unexpected arguments; native --name remains a
// thread-name filter proven against /proc/<pid>/task/*/comm. Typed get-extents
// --name usage AND host-limit paths must both hold before any /proc/<pid>/task
// count or field court. An independent /proc/<pid>/task directory count must
// match API visited/returned/tid set. Prefer host-limit clarity over fake success.
// AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-threads-readback",
];

const MAX_VISITED = 256;
const AT_SPI_PROBE_NAME = "Process Threads Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_threads_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "process-threads" || text_at(reply, "command") === "usage",
    "cu_linux_process_threads_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_threads_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_process_threads_usage_honesty(run_directory, executable, env) {
  // AT-SPI --name addressing (--window/--role) is not a process-threads form.
  // Bare --name is a native thread-name filter; do not fake a usage reject.
  const flat_atspi_name = invoke_observe_reply(run_directory, executable, [
    "process-threads", "--pid", "1", "--name", AT_SPI_PROBE_NAME, "--window", "1",
  ], env);
  ensure(!output_success(flat_atspi_name),
    "cu_linux_process_threads_usage_flat_atspi_name_ok:" + JSON.stringify(flat_atspi_name));
  ensure(
    text_at(flat_atspi_name, "error.code") === "usage",
    "cu_linux_process_threads_usage_flat_atspi_name_code:" + JSON.stringify(flat_atspi_name.error)
  );
  ensure(
    text_at(flat_atspi_name, "command") === "usage",
    "cu_linux_process_threads_usage_flat_atspi_name_command:" + JSON.stringify(flat_atspi_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_atspi_name, "error.message"), "--window")
      || usage_rejects_unexpected(text_at(flat_atspi_name, "error.message"), "--name"),
    "cu_linux_process_threads_usage_flat_atspi_name_message:" + JSON.stringify(flat_atspi_name.error)
  );

  const grouped_atspi_name = invoke_observe_reply(run_directory, executable, [
    "process", "threads", "--pid", "1", "--name", AT_SPI_PROBE_NAME, "--role", "button",
  ], env);
  ensure(!output_success(grouped_atspi_name),
    "cu_linux_process_threads_usage_grouped_atspi_name_ok:" + JSON.stringify(grouped_atspi_name));
  ensure(
    text_at(grouped_atspi_name, "error.code") === "usage",
    "cu_linux_process_threads_usage_grouped_atspi_name_code:" + JSON.stringify(grouped_atspi_name.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_atspi_name, "error.message"), "--role")
      || usage_rejects_unexpected(text_at(grouped_atspi_name, "error.message"), "--name"),
    "cu_linux_process_threads_usage_grouped_atspi_name_message:" + JSON.stringify(grouped_atspi_name.error)
  );

  const flat_coords = invoke_observe_reply(run_directory, executable, [
    "process-threads", "--pid", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(flat_coords),
    "cu_linux_process_threads_usage_flat_coords_ok:" + JSON.stringify(flat_coords));
  ensure(
    text_at(flat_coords, "error.code") === "usage",
    "cu_linux_process_threads_usage_flat_coords_code:" + JSON.stringify(flat_coords.error)
  );
  ensure(
    text_at(flat_coords, "command") === "usage",
    "cu_linux_process_threads_usage_flat_coords_command:" + JSON.stringify(flat_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_coords, "error.message"), "--coords"),
    "cu_linux_process_threads_usage_flat_coords_message:" + JSON.stringify(flat_coords.error)
  );

  const grouped_coords = invoke_observe_reply(run_directory, executable, [
    "process", "threads", "--pid", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(grouped_coords),
    "cu_linux_process_threads_usage_grouped_coords_ok:" + JSON.stringify(grouped_coords));
  ensure(
    text_at(grouped_coords, "error.code") === "usage",
    "cu_linux_process_threads_usage_grouped_coords_code:" + JSON.stringify(grouped_coords.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_coords, "error.message"), "--coords"),
    "cu_linux_process_threads_usage_grouped_coords_message:" + JSON.stringify(grouped_coords.error)
  );

  const flat_bogus = invoke_observe_reply(run_directory, executable, [
    "process-threads", "--pid", "1", "--bogus",
  ], env);
  ensure(!output_success(flat_bogus),
    "cu_linux_process_threads_usage_flat_bogus_ok:" + JSON.stringify(flat_bogus));
  ensure(
    text_at(flat_bogus, "error.code") === "usage",
    "cu_linux_process_threads_usage_flat_bogus_code:" + JSON.stringify(flat_bogus.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_bogus, "error.message"), "--bogus"),
    "cu_linux_process_threads_usage_flat_bogus_message:" + JSON.stringify(flat_bogus.error)
  );

  const grouped_bogus = invoke_observe_reply(run_directory, executable, [
    "process", "threads", "--pid", "1", "--bogus",
  ], env);
  ensure(!output_success(grouped_bogus),
    "cu_linux_process_threads_usage_grouped_bogus_ok:" + JSON.stringify(grouped_bogus));
  ensure(
    text_at(grouped_bogus, "error.code") === "usage",
    "cu_linux_process_threads_usage_grouped_bogus_code:" + JSON.stringify(grouped_bogus.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_bogus, "error.message"), "--bogus"),
    "cu_linux_process_threads_usage_grouped_bogus_message:" + JSON.stringify(grouped_bogus.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_process_threads_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_process_threads_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_process_threads_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_process_threads_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_process_threads_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_process_threads_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_threads_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_process_threads_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_process_threads_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_process_threads_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_threads_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_process_threads_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_process_threads_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_process_threads_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_threads_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_process_threads_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_process_threads_extents_unavailable_code:" + code
  );
}

function verify_readback(run_directory, executable, pid, env) {
  const script = [
    "import json, os, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "max_visited = int(sys.argv[3])",
    "STATE_MAP = {",
    "    'R': 'running',",
    "    'S': 'sleeping',",
    "    'D': 'uninterruptible',",
    "    'T': 'stopped',",
    "    't': 'tracing-stop',",
    "    'Z': 'zombie',",
    "    'X': 'dead',",
    "    'x': 'dead',",
    "    'I': 'idle',",
    "    'W': 'paging',",
    "    'P': 'parked',",
    "}",
    "def map_state(raw):",
    "    return STATE_MAP.get(raw, 'unknown')",
    "def name_fields(name_bytes):",
    "    try:",
    "        return {'name_encoding': 'utf8', 'name': name_bytes.decode('utf-8')}",
    "    except UnicodeDecodeError:",
    "        return {'name_encoding': 'hex', 'name_hex': name_bytes.hex()}",
    "def parse_thread_stat(tid, stat_bytes):",
    "    open_paren = stat_bytes.find(b'(')",
    "    close_paren = stat_bytes.rfind(b')')",
    "    if open_paren < 0 or close_paren <= open_paren or close_paren + 2 >= len(stat_bytes):",
    "        raise ValueError('thread stat name is malformed')",
    "    name_bytes = stat_bytes[open_paren + 1:close_paren]",
    "    fields = stat_bytes[close_paren + 2:].split()",
    "    if len(fields) < 37:",
    "        raise ValueError('thread stat has too few fields')",
    "    state_raw = fields[0].decode('ascii')",
    "    row = {",
    "        'id': str(tid),",
    "        'state': map_state(state_raw),",
    "        'state_raw': state_raw,",
    "        'user_time_raw': fields[11].decode('ascii'),",
    "        'system_time_raw': fields[12].decode('ascii'),",
    "        'time_unit': 'linux-clock-ticks',",
    "        'priority': int(fields[15]),",
    "        'nice': int(fields[16]),",
    "        'processor': int(fields[36]),",
    "    }",
    "    row.update(name_fields(name_bytes))",
    "    return row",
    "def read_inventory():",
    "    directory = f'/proc/{pid}/task'",
    "    ids = []",
    "    for entry in os.scandir(directory):",
    "        try:",
    "            ids.append(int(entry.name))",
    "        except ValueError:",
    "            continue",
    "    ids.sort()",
    "    truncated_scan = len(ids) > max_visited",
    "    ids = ids[:max_visited]",
    "    visited_count = len(ids)",
    "    items = []",
    "    read_errors = 0",
    "    for tid in ids:",
    "        try:",
    "            with open(f'{directory}/{tid}/stat', 'rb') as handle:",
    "                stat_bytes = handle.read()",
    "            items.append(parse_thread_stat(tid, stat_bytes))",
    "        except (OSError, ValueError):",
    "            read_errors += 1",
    "    return {",
    "        'visited_count': visited_count,",
    "        'read_errors': read_errors,",
    "        'truncated_scan': truncated_scan,",
    "        'threads': items,",
    "    }",
    "def compare_row(label, probe, cu):",
    "    if probe['id'] != cu['id']:",
    "        raise SystemExit(f'{label}:id:probe={probe[\"id\"]}:cu={cu[\"id\"]}')",
    "    if probe['state'] != cu['state']:",
    "        raise SystemExit(f'{label}:state:probe={probe[\"state\"]}:cu={cu[\"state\"]}')",
    "    if probe['state_raw'] != cu['state_raw']:",
    "        raise SystemExit(f'{label}:state_raw:probe={probe[\"state_raw\"]}:cu={cu[\"state_raw\"]}')",
    "    if probe['user_time_raw'] != cu['user_time_raw']:",
    "        raise SystemExit(f'{label}:user_time_raw:probe={probe[\"user_time_raw\"]}:cu={cu[\"user_time_raw\"]}')",
    "    if probe['system_time_raw'] != cu['system_time_raw']:",
    "        raise SystemExit(f'{label}:system_time_raw:probe={probe[\"system_time_raw\"]}:cu={cu[\"system_time_raw\"]}')",
    "    if probe['time_unit'] != cu['time_unit']:",
    "        raise SystemExit(f'{label}:time_unit:probe={probe[\"time_unit\"]}:cu={cu[\"time_unit\"]}')",
    "    if probe['priority'] != cu.get('priority'):",
    "        raise SystemExit(f'{label}:priority:probe={probe[\"priority\"]}:cu={cu.get(\"priority\")}')",
    "    if probe['nice'] != cu.get('nice'):",
    "        raise SystemExit(f'{label}:nice:probe={probe[\"nice\"]}:cu={cu.get(\"nice\")}')",
    "    if probe['processor'] != cu.get('processor'):",
    "        raise SystemExit(f'{label}:processor:probe={probe[\"processor\"]}:cu={cu.get(\"processor\")}')",
    "    if probe['name_encoding'] != cu.get('name_encoding'):",
    "        raise SystemExit(f'{label}:name_encoding:probe={probe[\"name_encoding\"]}:cu={cu.get(\"name_encoding\")}')",
    "    if probe['name_encoding'] == 'utf8':",
    "        if probe['name'] != cu.get('name'):",
    "            raise SystemExit(f'{label}:name:probe={probe[\"name\"]}:cu={cu.get(\"name\")}')",
    "    else:",
    "        if probe['name_hex'] != cu.get('name_hex'):",
    "            raise SystemExit(f'{label}:name_hex:probe={probe[\"name_hex\"]}:cu={cu.get(\"name_hex\")}')",
    "before = read_inventory()",
    "out = subprocess.check_output(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-threads', '--pid', str(pid), '--limit', str(max_visited),",
    "     '--max-visited', str(max_visited)],",
    "    text=True)",
    "after = read_inventory()",
    "reply = json.loads(out)",
    "if not reply.get('ok') or reply.get('command') != 'process-threads':",
    "    raise SystemExit('cu_linux_process_threads_reply_state')",
    "data = reply['data']",
    "if data.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_threads_verified')",
    "if int(data['pid']) != pid:",
    "    raise SystemExit('cu_linux_process_threads_pid')",
    "if int(data['visited_count']) != before['visited_count']:",
    "    raise SystemExit('cu_linux_process_threads_visited_count')",
    "if int(data['read_errors']) != before['read_errors']:",
    "    raise SystemExit('cu_linux_process_threads_read_errors')",
    "if bool(data['truncated_scan']) != before['truncated_scan']:",
    "    raise SystemExit('cu_linux_process_threads_truncated_scan')",
    "if int(data['matched_count']) != len(before['threads']):",
    "    raise SystemExit('cu_linux_process_threads_matched_count')",
    "if int(data['returned_count']) != len(before['threads']):",
    "    raise SystemExit('cu_linux_process_threads_returned_count')",
    "cu_rows = data.get('threads') or []",
    "if len(cu_rows) != len(before['threads']):",
    "    raise SystemExit('cu_linux_process_threads_thread_count')",
    "for index, probe in enumerate(before['threads']):",
    "    compare_row(f'cu_linux_process_threads_row_{index}', probe, cu_rows[index])",
    "state = json.loads(subprocess.check_output(",
    "    [cu, '--target', 'current', '--grant', 'observe', 'process-state', '--pid', str(pid)],",
    "    text=True))",
    "if not state.get('ok') or state['data'].get('start_identity') != data.get('start_identity'):",
    "    raise SystemExit('cu_linux_process_threads_start_identity')",
    "if after['visited_count'] != before['visited_count']:",
    "    raise SystemExit('cu_linux_process_threads_inventory_changed')",
    "print('pid', pid)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, executable, "" + MAX_VISITED], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_process_threads_readback:" + output.stderr + output.stdout);
}

function verify_pid(run_directory, executable, pid, env) {
  verify_independent_task_count(run_directory, executable, pid, env);
  verify_native_name_filter(run_directory, executable, pid, env);
  verify_readback(run_directory, executable, pid, env);
}

function verify_independent_task_count(run_directory, executable, pid, env) {
  const script = [
    "import json, os, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "max_visited = int(sys.argv[3])",
    "directory = f'/proc/{pid}/task'",
    "ids = []",
    "for entry in os.scandir(directory):",
    "    try:",
    "        ids.append(int(entry.name))",
    "    except ValueError:",
    "        continue",
    "ids.sort()",
    "truncated_scan = len(ids) > max_visited",
    "visited_ids = ids[:max_visited]",
    "parsed_ids = []",
    "for tid in visited_ids:",
    "    try:",
    "        with open(f'{directory}/{tid}/stat', 'rb') as handle:",
    "            stat_bytes = handle.read()",
    "        if b'(' in stat_bytes and b')' in stat_bytes:",
    "            parsed_ids.append(str(tid))",
    "    except OSError:",
    "        continue",
    "out = subprocess.check_output(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-threads', '--pid', str(pid), '--limit', str(max_visited),",
    "     '--max-visited', str(max_visited)],",
    "    text=True)",
    "reply = json.loads(out)",
    "if not reply.get('ok') or reply.get('command') != 'process-threads':",
    "    raise SystemExit('cu_linux_process_threads_count_reply_state')",
    "data = reply['data']",
    "if data.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_threads_count_verified')",
    "if int(data['pid']) != pid:",
    "    raise SystemExit('cu_linux_process_threads_count_pid')",
    "if int(data['visited_count']) != len(visited_ids):",
    "    raise SystemExit(",
    "        f'cu_linux_process_threads_count_visited:probe={len(visited_ids)}:cu={data[\"visited_count\"]}')",
    "if bool(data['truncated_scan']) != truncated_scan:",
    "    raise SystemExit('cu_linux_process_threads_count_truncated_scan')",
    "cu_ids = [str(row.get('id')) for row in (data.get('threads') or [])]",
    "if int(data['returned_count']) != len(cu_ids):",
    "    raise SystemExit('cu_linux_process_threads_count_returned')",
    "if int(data['matched_count']) != len(parsed_ids):",
    "    raise SystemExit(",
    "        f'cu_linux_process_threads_count_matched:probe={len(parsed_ids)}:cu={data[\"matched_count\"]}')",
    "if cu_ids != parsed_ids:",
    "    raise SystemExit(",
    "        f'cu_linux_process_threads_count_tids:probe={parsed_ids}:cu={cu_ids}')",
    "print(json.dumps({",
    "    'pid': pid,",
    "    'probe_visited': len(visited_ids),",
    "    'probe_parsed': len(parsed_ids),",
    "    'visited_count': int(data['visited_count']),",
    "    'returned_count': int(data['returned_count']),",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, executable, "" + MAX_VISITED], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true,
    "cu_linux_process_threads_independent_count:" + output.stderr + output.stdout);
}

function verify_native_name_filter(run_directory, executable, pid, env) {
  const script = [
    "import json, os, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "max_visited = int(sys.argv[3])",
    "atspi_probe = sys.argv[4]",
    "directory = f'/proc/{pid}/task'",
    "def thread_name(stat_bytes):",
    "    open_paren = stat_bytes.find(b'(')",
    "    close_paren = stat_bytes.rfind(b')')",
    "    if open_paren < 0 or close_paren <= open_paren:",
    "        return None",
    "    raw = stat_bytes[open_paren + 1:close_paren]",
    "    try:",
    "        return raw.decode('utf-8')",
    "    except UnicodeDecodeError:",
    "        return None",
    "def ascii_contains(haystack, needle):",
    "    return needle.lower() in haystack.lower()",
    "ids = []",
    "for entry in os.scandir(directory):",
    "    try:",
    "        ids.append(int(entry.name))",
    "    except ValueError:",
    "        continue",
    "ids.sort()",
    "names = []",
    "for tid in ids[:max_visited]:",
    "    try:",
    "        with open(f'{directory}/{tid}/stat', 'rb') as handle:",
    "            name = thread_name(handle.read())",
    "        if name is not None:",
    "            names.append((str(tid), name))",
    "    except OSError:",
    "        continue",
    "if not names:",
    "    raise SystemExit('cu_linux_process_threads_name_filter_no_name')",
    "needle = next((name for _tid, name in names if name != ''), names[0][1])",
    "def invoke(name):",
    "    out = subprocess.check_output(",
    "        [cu, '--target', 'current', '--grant', 'observe',",
    "         'process-threads', '--pid', str(pid), '--name', name,",
    "         '--limit', str(max_visited), '--max-visited', str(max_visited)],",
    "        text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok') or reply.get('command') != 'process-threads':",
    "        raise SystemExit('cu_linux_process_threads_name_filter_reply:' + name)",
    "    return reply['data']",
    "expected_match = [tid for tid, name in names if ascii_contains(name, needle)]",
    "data = invoke(needle)",
    "if int(data['matched_count']) != len(expected_match):",
    "    raise SystemExit(",
    "        f'cu_linux_process_threads_name_filter_matched:probe={len(expected_match)}:cu={data[\"matched_count\"]}')",
    "cu_ids = [str(row.get('id')) for row in (data.get('threads') or [])]",
    "if cu_ids != expected_match:",
    "    raise SystemExit(",
    "        f'cu_linux_process_threads_name_filter_tids:probe={expected_match}:cu={cu_ids}')",
    "expected_atspi = [tid for tid, name in names if ascii_contains(name, atspi_probe)]",
    "atspi = invoke(atspi_probe)",
    "if int(atspi['matched_count']) != len(expected_atspi):",
    "    raise SystemExit(",
    "        f'cu_linux_process_threads_name_filter_atspi:probe={len(expected_atspi)}:cu={atspi[\"matched_count\"]}')",
    "print(json.dumps({",
    "    'pid': pid,",
    "    'needle': needle,",
    "    'matched_count': int(data['matched_count']),",
    "    'atspi_probe_matched': int(atspi['matched_count']),",
    "}))",
  ].join("\n");
  const output = rh.command("python3", [
    "-c", script, "" + pid, executable, "" + MAX_VISITED, AT_SPI_PROBE_NAME,
  ], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true,
    "cu_linux_process_threads_native_name_filter:" + output.stderr + output.stdout);
}

function probe_task_directory(pid) {
  const script = [
    "import json, os, sys",
    "pid = int(sys.argv[1])",
    "proc_path = f'/proc/{pid}'",
    "task_path = f'{proc_path}/task'",
    "exists = os.path.exists(proc_path)",
    "readable = False",
    "error_kind = None",
    "if exists:",
    "    try:",
    "        with os.scandir(task_path):",
    "            readable = True",
    "    except OSError as error:",
    "        if error.errno == 13:",
    "            error_kind = 'PermissionDenied'",
    "        elif error.errno == 2:",
    "            error_kind = 'NotFound'",
    "        else:",
    "            error_kind = error.__class__.__name__",
    "print(json.dumps({",
    "    'pid': pid,",
    "    'exists': exists,",
    "    'readable': readable,",
    "    'error_kind': error_kind,",
    "    'task_path': task_path,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid], {
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_process_threads_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function find_denied_probe_pid() {
  const script = [
    "import json, os",
    "for entry in os.scandir('/proc'):",
    "    if not entry.name.isdigit():",
    "        continue",
    "    candidate = int(entry.name)",
    "    task_path = f'/proc/{candidate}/task'",
    "    if not os.path.exists(task_path):",
    "        continue",
    "    try:",
    "        with os.scandir(task_path):",
    "            pass",
    "    except OSError as error:",
    "        if error.errno == 13:",
    "            print(json.dumps({'pid': candidate, 'denied': True}))",
    "            raise SystemExit",
    "print(json.dumps({'denied': False}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 10000,
  });
  ensure(output.success === true,
         "cu_linux_process_threads_denied_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function assert_permission_denied_host_limit(run_directory, executable, pid, env) {
  const script = [
    "import json, os, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "task_path = f'/proc/{pid}/task'",
    "try:",
    "    with os.scandir(task_path):",
    "        raise SystemExit('cu_linux_process_threads_denied_probe_readable')",
    "except OSError as probe_error:",
    "    if probe_error.errno != 13:",
    "        raise SystemExit(f'cu_linux_process_threads_denied_probe_errno:{probe_error.errno}')",
    "proc = subprocess.run(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-threads', '--pid', str(pid), '--limit', '16', '--max-visited', '256'],",
    "    capture_output=True, text=True, timeout=30)",
    "if proc.returncode == 0:",
    "    raise SystemExit('cu_linux_process_threads_denied_ok:' + proc.stdout)",
    "reply = json.loads(proc.stdout)",
    "if reply.get('ok') is not False:",
    "    raise SystemExit('cu_linux_process_threads_denied_ok_state:' + proc.stdout)",
    "error = reply.get('error') or {}",
    "code = error.get('code') or ''",
    "if code != 'process_inspection_permission_denied':",
    "    raise SystemExit('cu_linux_process_threads_denied_code:' + code)",
    "detail = error.get('detail') or {}",
    "if detail.get('kind') != 'PermissionDenied':",
    "    raise SystemExit('cu_linux_process_threads_denied_kind:' + json.dumps(detail))",
    "if detail.get('subject') != 'threads':",
    "    raise SystemExit('cu_linux_process_threads_denied_subject:' + json.dumps(detail))",
    "message = error.get('message') or ''",
    "if 'Permission denied' not in message and '/proc/' not in message:",
    "    raise SystemExit('cu_linux_process_threads_denied_message:' + message)",
    "print(json.dumps({'code': code, 'pid': pid, 'task_path': task_path}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, executable], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true,
         "cu_linux_process_threads_permission_denied:" + output.stderr + output.stdout);
}

function verify_unavailable_when_probe_denied(run_directory, executable, probe, env) {
  const script = [
    "import json, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "proc = subprocess.run(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-threads', '--pid', str(pid), '--limit', '16', '--max-visited', '256'],",
    "    capture_output=True, text=True, timeout=30)",
    "if proc.returncode == 0:",
    "    raise SystemExit('cu_linux_process_threads_unavailable_ok:' + proc.stdout)",
    "reply = json.loads(proc.stdout)",
    "if reply.get('ok') is not False:",
    "    raise SystemExit('cu_linux_process_threads_unavailable_ok_state:' + proc.stdout)",
    "error = reply.get('error') or {}",
    "code = error.get('code') or ''",
    "if code != 'process_inspection_permission_denied':",
    "    raise SystemExit('cu_linux_process_threads_unavailable_code:' + code)",
    "detail = error.get('detail') or {}",
    "if detail.get('kind') != 'PermissionDenied':",
    "    raise SystemExit('cu_linux_process_threads_unavailable_kind:' + json.dumps(detail))",
    "message = error.get('message') or ''",
    "if 'Permission denied' not in message and '/proc/' not in message:",
    "    raise SystemExit('cu_linux_process_threads_unavailable_message:' + message)",
    "print(json.dumps({'code': code, 'pid': pid}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + probe.pid, executable], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true,
         "cu_linux_process_threads_unavailable:" + output.stderr + output.stdout);
  ensure(probe.error_kind === "PermissionDenied",
         "cu_linux_process_threads_probe_not_denied:" + JSON.stringify(probe));
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-threads");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
const self_probe = probe_task_directory(rh.pid());
const denied_probe = find_denied_probe_pid();
let succeeded = 0;
let failure = "";
try {
  if (atspi_available) {
    print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before /proc/<pid>/task read-back court");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP process-threads typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present (native --name is a thread-name filter, not AT-SPI)");
  assert_process_threads_usage_honesty(context.run_directory, executable, env);

  if (!self_probe.readable) {
    print("STEP typed host-limit when independent /proc/<pid>/task probe is unreadable or denied"
      + " (readable=" + self_probe.readable
      + " error_kind=" + self_probe.error_kind + ")");
    verify_unavailable_when_probe_denied(context.run_directory, executable, self_probe, env);
    succeeded = 1;
  } else {
    print("STEP process-threads observe matches independent /proc/<pid>/task count, native --name filter, and field read-back for self");
    verify_pid(context.run_directory, executable, rh.pid(), env);

    print("STEP spawn disposable child and verify --pid read-back");
    const child = harness.start({
      program: "sleep",
      args: ["300"],
      current_dir: context.run_directory,
      env: { AGENTERM_NO_ACTIVATE: "1" },
      timeout_ms: 60000,
    });
    verify_pid(context.run_directory, executable, harness.spawned_pid(child), env);
    harness.kill(child);

    if (denied_probe.denied === true) {
      print("STEP process-threads typed-fails permission-denied host-limit when independent"
        + " /proc/" + denied_probe.pid + "/task probe is denied");
      assert_permission_denied_host_limit(
        context.run_directory, executable, denied_probe.pid, env);
    } else {
      print("STEP skip permission-denied host-limit: no independent denied /proc/<pid>/task probe on this host");
    }

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-threads-readback");
  harness.remove_run(context);
  if (!self_probe.readable) {
    print("PASS: Linux process-threads typed-fails when independent /proc/<pid>/task is unreadable or denied");
  } else if (atspi_available) {
    print("PASS: Linux process-threads matches independent /proc/<pid>/task count and field read-back"
      + " with typed process-threads --name/--coords/--bogus and get-extents --name usage/host-limit honesty"
      + " (AT-SPI --name, no --coords), native --name filter, and permission-denied host-limit honesty");
  } else {
    print("PASS: Linux process-threads matches independent /proc/<pid>/task count and field read-back"
      + " with typed process-threads --name/--coords/--bogus usage and get-extents --name host-limit honesty"
      + " (AT-SPI --name, no --coords), native --name filter, and permission-denied host-limit honesty");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
