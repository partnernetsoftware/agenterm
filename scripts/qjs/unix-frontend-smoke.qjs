// Prove the matching-host Unix AgenTerm workbench through public CLI actions,
// renderer-owned state/screenshots, native focus observation, and the real
// platform clipboard helper.
//
// Args:
//   --list-evidence
// or:
//   REPO GUI_EXE CLI_EXE --platform linux|macos
//
// Ported from scripts/rh/unix-frontend-smoke.rh; runs under `--profile tool`.
// The GUI, the X11 witness and the xclip owner are long-lived door handles
// (process_spawn) polled with process_state and reaped with process_wait.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "ux.unix-frontend-linux-no-activate",
  "ux.unix-frontend-linux-workbench",
  "ux.unix-frontend-linux-native-clipboard",
  "ux.unix-frontend-linux-stale-paste",
  "ux.unix-frontend-macos-no-activate",
  "ux.unix-frontend-macos-workbench",
  "ux.unix-frontend-macos-native-clipboard",
  "ux.unix-frontend-macos-stale-paste"
];

// A door wall this port cannot route around without changing what is
// proven. The site throws with the rh spelling so the run fails closed.
function gap(what) {
  throw "qjs_gap:" + what;
}

// rh's `child.platform_facts`: the host's own view of the child's top-level
// window (supported / present / id / is_foreground). The door has no such
// fact for a spawned handle; `wait-ui --window-state restored` is the
// server's claim, not the compositor's, and this journey is about the
// difference.
function platform_facts(handle) {
  gap("platform_facts: the door has no native window facts for spawned handle " + handle);
  return null;
}

// rh's `rh::image::inspect_png(path)` -> {width, height, samples, luminance}.
// Binary bytes cannot cross the text door and it carries no image operation.
function inspect_png(path) {
  gap("image_inspect_png: the door has no PNG inspection (" + path + ")");
  return null;
}

function trimmed(value) {
  return ("" + value).trim();
}

function text_contains(text, needle) {
  return ("" + text).includes(needle);
}

function text_starts_with(text, prefix) {
  return ("" + text).startsWith(prefix);
}

function environment_or_empty(name) {
  return rh.env_or(name, "");
}

function unsupported(platform, code, message) {
  const skip_payload = {
    schema_version: 1,
    suite: "unix-frontend-smoke",
    platform: platform,
    result_class: "skipped",
    failure: { kind: "Unsupported", code: code, message: message },
    evidence_emitted: []
  };
  print("SKIP " + JSON.stringify(skip_payload));
}

function normalized_text(value) {
  return ("" + value).trim();
}

function resolve_tool(name) {
  const output = rh.command("/bin/sh", ["-c", "command -v -- " + name], { timeout_ms: 2000 });
  if (output.success) { return output.stdout.trim(); }
  return "";
}

function clipboard_payload_path(context) {
  return rh.join(context.run_directory, "clipboard-payload.txt");
}

function osascript_eval(context, script, record_summary) {
  const output = rh.command("/usr/bin/osascript", ["-e", script], { timeout_ms: 5000 });
  harness.append_command_record_bounded(
    context, ["osascript", "-e", record_summary], output, output.success ? 0 : 1, []
  );
  harness.require(
    output.success,
    "unix_frontend_osascript_failed:" + record_summary + ":" + output.stderr
  );
  return output;
}

function chmod_executable(context, path) {
  const output = rh.command("/bin/chmod", ["0700", path], { timeout_ms: 5000 });
  harness.append_command_record_bounded(
    context, ["chmod", "0700", path], output, output.success ? 0 : 1, []
  );
  harness.require(output.success, "unix_frontend_chmod_failed:" + output.stderr);
  return output;
}

// No `"" + output.stdout` copies: a concat costs steps per character here.
function json_cli(context, cli, args) {
  const response = harness.invoke_cli_bounded(context, cli, args, 0, []);
  return JSON.parse(response.stdout);
}

function text_cli(context, cli, args) {
  const response = harness.invoke_cli_bounded(context, cli, args, 0, []);
  return response.stdout.trim();
}

function wait_for_server(context, cli, gui) {
  for (let attempt = 0; attempt < 240; attempt = attempt + 1) {
    const probe = harness.run_cli_bounded(context, cli, ["ui-snapshot"], 0, []);
    if (probe.success) { return JSON.parse(probe.stdout); }
    if (harness.state(gui) === "exited") {
      const output = harness.wait(gui, 2000);
      throw "unix_frontend_gui_early_exit:" + output.stderr;
    }
    harness.sleep_ms(25);
  }
  throw "unix_frontend_server_timeout";
}

function wait_for_window(gui) {
  for (let attempt = 0; attempt < 240; attempt = attempt + 1) {
    const facts = platform_facts(gui);
    if (facts.top_level_window_supported
        && facts.top_level_window_present
        && facts.top_level_window_id !== 0) {
      return 0;
    }
    if (harness.state(gui) === "exited") { throw "unix_frontend_window_early_exit"; }
    harness.sleep_ms(20);
  }
  throw "unix_frontend_window_timeout";
}

function xdotool_record(context, record_args, output, expected_failure) {
  harness.append_command_record_bounded(context, record_args, output, expected_failure, []);
  if (expected_failure === 0) {
    harness.require(output.success, "unix_frontend_xdotool_failed:" + output.stderr);
  }
  return 0;
}

function xdotool_search_name(context, title) {
  const record_args = ["search", "--onlyvisible", "--name", title];
  const output = rh.command("xdotool", record_args, { timeout_ms: 3000 });
  xdotool_record(context, record_args, output, 1);
  return output;
}

function xdotool_getactivewindow(context) {
  const output = rh.command("xdotool", ["getactivewindow"], { timeout_ms: 3000 });
  xdotool_record(context, ["getactivewindow"], output, 0);
  return output;
}

function wait_x11_window(context, title, child) {
  for (let attempt = 0; attempt < 160; attempt = attempt + 1) {
    const output = xdotool_search_name(context, title);
    if (output.success) {
      for (const raw of output.stdout.split("\n")) {
        const id = ("" + raw).trim();
        if (id !== "") {
          const name = rh.command("xdotool", ["getwindowname", id], { timeout_ms: 3000 });
          xdotool_record(context, ["getwindowname", id], name, 1);
          const actual = name.stdout.trim();
          if (name.success && actual === title) { return normalized_text(id); }
        }
      }
    }
    if (harness.state(child) === "exited") { throw "unix_frontend_x11_window_owner_exited"; }
    harness.sleep_ms(25);
  }
  throw "unix_frontend_x11_window_timeout:" + title;
}

function active_x11_window(context) {
  const output = xdotool_getactivewindow(context);
  const out = output.stdout.trim();
  harness.require(out !== "", "unix_frontend_x11_active_window_empty");
  return out;
}

function wait_x11_active(context, id, code) {
  for (let attempt = 0; attempt < 160; attempt = attempt + 1) {
    if (active_x11_window(context) === id) { return 0; }
    harness.sleep_ms(20);
  }
  throw code;
}

function start_x11_witness(title) {
  const spec = {
    program: "xmessage",
    args: ["-name", "agenterm-unix-frontend-witness", "-title", title, "-center", "-buttons", "OK:0", title],
    timeout_ms: 120000
  };
  return harness.start(spec);
}

function frontmost_macos(context) {
  const output = osascript_eval(
    context,
    "tell application \"System Events\" to get name of first application process whose frontmost is true",
    "frontmost application query"
  );
  const out = output.stdout.trim();
  harness.require(out !== "", "unix_frontend_macos_frontmost_empty");
  return out;
}

function activate_finder_witness(context) {
  const out = "Finder";
  osascript_eval(context, "tell application \"Finder\" to activate", "activate Finder witness");
  for (let attempt = 0; attempt < 100; attempt = attempt + 1) {
    if (frontmost_macos(context) === out) { return out; }
    harness.sleep_ms(20);
  }
  throw "unix_frontend_macos_witness_focus_timeout";
}

function macos_frontmost_contains(context, needle) {
  const output = osascript_eval(
    context,
    "tell application \"System Events\" to get name of first application process whose frontmost is true",
    "frontmost contains query"
  );
  const lowered = output.stdout.trim().toLowerCase();
  if (text_contains(lowered, needle)) { return 1; }
  return 0;
}

function linux_window_focused(context, native_window_id) {
  if (active_x11_window(context) === native_window_id) { return 1; }
  return 0;
}

function os_focused_for_platform(context, platform, native_window_id) {
  if (platform === "linux") { return linux_window_focused(context, native_window_id); }
  return macos_frontmost_contains(context, "agenterm");
}

function wait_macos_agenterm_active(context) {
  for (let attempt = 0; attempt < 160; attempt = attempt + 1) {
    if (macos_frontmost_contains(context, "agenterm") !== 0) { return frontmost_macos(context); }
    harness.sleep_ms(20);
  }
  throw "unix_frontend_macos_activation_timeout";
}

function wait_native_focus(context, cli, platform, native_window_id) {
  for (let attempt = 0; attempt < 160; attempt = attempt + 1) {
    const snapshot = json_cli(context, cli, ["ui-snapshot"]);
    const os_focused = os_focused_for_platform(context, platform, native_window_id);
    const focus_surface = "" + snapshot.focus.surface;
    if (snapshot.focus.window_focused && focus_surface === "terminal" && os_focused !== 0) {
      return snapshot;
    }
    harness.sleep_ms(20);
  }
  throw "unix_frontend_native_focus_event_timeout";
}

function set_native_clipboard(context, platform, text) {
  const payload_path = clipboard_payload_path(context);
  rh.atomic_write(payload_path, text);
  if (platform === "linux") {
    // rh started xclip and let it go: it daemonizes. The handle stays in the
    // door's slot and is reaped when the slot drops.
    harness.start({
      program: "xclip",
      args: ["-selection", "clipboard", "-target", "UTF8_STRING", "-loops", "2", "-silent"],
      stdin_text: text,
      timeout_ms: 30000
    });
    return 0;
  }
  const output = rh.command(
    "/bin/sh", ["-c", "cat \"$1\" | pbcopy", "sh", payload_path], { timeout_ms: 5000 }
  );
  harness.append_command_record_bounded(
    context, ["sh", "-c", "pbcopy from payload file"], output, output.success ? 0 : 1, []
  );
  harness.require(output.success, "unix_frontend_pbcopy_failed:" + output.stderr);
  return 0;
}

// `xclip` DAEMONIZES: it forks a background process that owns the X
// selection and the process we spawned exits immediately, cleanly. The
// selection becoming readable is the only real readiness signal, so record
// the exit and keep polling; report it only if readiness never arrives.
// Answers 1 when the owner handle was reaped here (the caller must then drop
// it from the owned list: the door refuses a second wait), else 0.
function wait_linux_clipboard_owner(context, expected, owner) {
  let owner_exited = 0;
  for (let attempt = 0; attempt < 250; attempt = attempt + 1) {
    if (owner_exited === 0 && harness.state(owner) === "exited") {
      harness.wait(owner, 2000);
      owner_exited = 1;
    }
    const record_args = ["xclip", "-selection", "clipboard", "-target", "UTF8_STRING", "-o"];
    const output = rh.command(
      "xclip", ["-selection", "clipboard", "-target", "UTF8_STRING", "-o"], { timeout_ms: 2000 }
    );
    harness.append_command_record_bounded(context, record_args, output, output.success ? 0 : 1, []);
    const observed = output.stdout.trim();
    if (output.success && observed === expected) { return owner_exited; }
    harness.sleep_ms(20);
  }
  if (owner_exited !== 0) {
    throw "unix_frontend_xclip_owner_readiness_timeout: the spawned "
      + "xclip exited (expected: it daemonizes) and no background owner "
      + "ever published the selection";
  }
  throw "unix_frontend_xclip_owner_readiness_timeout";
}

function wait_file(path, gui, code) {
  for (let attempt = 0; attempt < 240; attempt = attempt + 1) {
    if (rh.exists(path)) { return 0; }
    if (harness.state(gui) === "exited") { throw code + "_gui_exited"; }
    harness.sleep_ms(20);
  }
  throw code;
}

function wait_stale_failure(context, cli) {
  for (let attempt = 0; attempt < 240; attempt = attempt + 1) {
    const snapshot = json_cli(context, cli, ["ui-snapshot"]);
    const paste_state = "" + snapshot.terminal_paste.state;
    const error = snapshot.feedback.error;
    if (paste_state === "idle"
        && error !== null && error !== undefined
        && "" + error.code === "terminal_paste_failed"
        && "" + error.category === "precondition"
        && error.retryable) {
      return snapshot;
    }
    harness.sleep_ms(20);
  }
  throw "unix_frontend_stale_paste_failure_timeout";
}

function wait_terminal_paste_success(context, cli) {
  for (let attempt = 0; attempt < 240; attempt = attempt + 1) {
    const snapshot = json_cli(context, cli, ["ui-snapshot"]);
    const paste_state = "" + snapshot.terminal_paste.state;
    if (paste_state === "idle") {
      const paste_error = snapshot.feedback.error;
      if (paste_error !== null && paste_error !== undefined) {
        throw "unix_frontend_native_paste_failed:" + JSON.stringify(paste_error);
      }
      const message = snapshot.feedback.message;
      if (message !== null && message !== undefined && text_starts_with(message, "Pasted ")) {
        return snapshot;
      }
    }
    harness.sleep_ms(20);
  }
  throw "unix_frontend_native_paste_timeout";
}

function wait_exit(child, code) {
  for (let attempt = 0; attempt < 240; attempt = attempt + 1) {
    if (harness.state(child) === "exited") { return harness.wait(child, 2000); }
    harness.sleep_ms(20);
  }
  throw code;
}

function record_phase(context, phase) {
  const phase_text = "" + phase;
  rh.atomic_write(rh.join(context.run_directory, "phase.txt"), phase_text + "\n");
  print("STEP " + phase_text);
  return 0;
}

function retain_failure_snapshot(context, cli) {
  rh.create_dir_all(context.failure_directory);
  const output = harness.run_cli_bounded(context, cli, ["ui-snapshot"], 1, []);
  rh.atomic_write(
    rh.join(context.failure_directory, "ui-snapshot.txt"),
    output.stdout + output.stderr
  );
}

function evidence_directory_of(context) {
  // rh: `std::path::parent(context.evidence_path)`. No `s[i]` here: split on
  // the separator and drop the last piece.
  const parts = context.evidence_path.split("/");
  parts.pop();
  let joined = "";
  let first = true;
  for (const piece of parts) {
    joined = first ? piece : joined + "/" + piece;
    first = false;
  }
  return joined === "" ? "/" : joined;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}

harness.require(
  args.length === 5 && args[3] === "--platform",
  "expected: REPO GUI_EXE CLI_EXE --platform linux|macos"
);
const platform = args[4];
harness.require(
  platform === "linux" || platform === "macos",
  "unix_frontend_platform_invalid:" + platform
);

let skipped = false;
if (platform === "linux") {
  if (environment_or_empty("WAYLAND_DISPLAY") !== "") {
    unsupported(
      platform,
      "unix_frontend_wayland_focus_witness_unsupported",
      "the Linux native-focus journey currently requires an X11 compositor witness"
    );
    skipped = true;
  } else if (environment_or_empty("DISPLAY") === "") {
    unsupported(
      platform,
      "unix_frontend_x11_display_unavailable",
      "the Linux native workbench journey requires DISPLAY"
    );
    skipped = true;
  } else if (resolve_tool("xdotool") === "" || resolve_tool("xmessage") === "") {
    unsupported(
      platform,
      "unix_frontend_x11_witness_unavailable",
      "the Linux journey requires xdotool and xmessage"
    );
    skipped = true;
  }
} else if (resolve_tool("osascript") === "") {
  unsupported(
    platform,
    "unix_frontend_macos_witness_unavailable",
    "the macOS journey requires osascript"
  );
  skipped = true;
}
if (skipped) { return 0; }

let clipboard_reader = "";
let clipboard_writer = "";
let clipboard_message = "";
if (platform === "linux") {
  clipboard_reader = resolve_tool("xclip");
  clipboard_writer = resolve_tool("xclip");
  clipboard_message = "the Linux journey requires the real xclip helper";
} else {
  clipboard_reader = resolve_tool("pbpaste");
  clipboard_writer = resolve_tool("pbcopy");
  clipboard_message = "the macOS journey requires pbpaste and pbcopy";
}
if (clipboard_reader === "" || clipboard_writer === "") {
  unsupported(platform, "unix_frontend_native_clipboard_unavailable", clipboard_message);
  return 0;
}

const repo = rh.absolute(args[0]);
const gui_exe = rh.absolute(args[1]);
const cli_exe = rh.absolute(args[2]);
harness.require(rh.exists(gui_exe), "unix_frontend_gui_missing");
harness.require(rh.exists(cli_exe), "unix_frontend_cli_missing");

const context = harness.new_context(repo, "unix-frontend-" + platform);
let owned_children = [];
const wrapper_directory = rh.join(context.run_directory, "clipboard-wrapper");
rh.create_dir_all(wrapper_directory);
const entered_path = rh.join(context.run_directory, "clipboard-entered");
const release_path = rh.join(context.run_directory, "clipboard-release");
const mode_path = rh.join(context.run_directory, "clipboard-barrier-enabled");
let wrapper_name = "pbpaste";
if (platform === "linux") { wrapper_name = "xclip"; }
const wrapper_path = rh.join(wrapper_directory, wrapper_name);
const wrapper_source =
  "#!/bin/sh\n"
  + "if [ -f \"$AGENTERM_SMOKE_CLIPBOARD_MODE\" ]; then\n"
  + "  : > \"$AGENTERM_SMOKE_CLIPBOARD_ENTERED\"\n"
  + "  while [ ! -f \"$AGENTERM_SMOKE_CLIPBOARD_RELEASE\" ]; do sleep 0.02; done\n"
  + "  printf '%s' \"$AGENTERM_SMOKE_STALE_MARKER\"\n"
  + "  exit 0\n"
  + "fi\n"
  + "exec \"" + clipboard_reader + "\" \"$@\"\n";
rh.atomic_write(wrapper_path, wrapper_source);
chmod_executable(context, wrapper_path);

const stale_marker = "AGENTERM_STALE_PASTE_" + context.run_id;
const witness_title = "AgenTerm foreground witness " + context.run_id;
let witness_id = "";
let foreground_before = "";
if (platform === "linux") {
  const witness = start_x11_witness(witness_title);
  owned_children.push(witness);
  witness_id = wait_x11_window(context, witness_title, witness);
  const activate_output = rh.command(
    "xdotool", ["windowactivate", "--sync", witness_id], { timeout_ms: 3000 }
  );
  xdotool_record(context, ["windowactivate", "--sync", witness_id], activate_output, 0);
  wait_x11_active(context, witness_id, "unix_frontend_witness_activation_timeout");
  foreground_before = witness_id;
} else {
  foreground_before = activate_finder_witness(context);
}

let succeeded = 0;
let failure = "";
try {
  record_phase(context, "no-activate launch preserves an independent native foreground witness");
  const gui_spec = harness.configured_spec(context, gui_exe, ["--no-activate"]);
  gui_spec.env.PATH = wrapper_directory + ":" + environment_or_empty("PATH");
  gui_spec.env.AGENTERM_SMOKE_CLIPBOARD_MODE = mode_path;
  gui_spec.env.AGENTERM_SMOKE_CLIPBOARD_ENTERED = entered_path;
  gui_spec.env.AGENTERM_SMOKE_CLIPBOARD_RELEASE = release_path;
  gui_spec.env.AGENTERM_SMOKE_STALE_MARKER = stale_marker;
  const gui = harness.start(gui_spec);
  owned_children.push(gui);
  wait_for_window(gui);
  const native_window = platform_facts(gui);
  const initial = wait_for_server(context, cli_exe, gui);
  const initial_projection = "" + initial.projection;
  const initial_surface = "" + initial.focus.surface;
  harness.require(
    initial_projection === "embedded_gui"
      && initial_surface === "terminal"
      && !initial.focus.window_focused,
    "unix_frontend_initial_snapshot_contract:" + JSON.stringify(initial)
  );
  if (platform === "linux") {
    harness.require(
      active_x11_window(context) === foreground_before,
      "unix_frontend_linux_no_activate_stole_focus"
    );
  } else {
    harness.require(
      frontmost_macos(context) === foreground_before,
      "unix_frontend_macos_no_activate_stole_focus"
    );
  }
  harness.emit_evidence(context, declared_evidence, "ux.unix-frontend-" + platform + "-no-activate");

  record_phase(context, "semantic activation waits for native focus and compositor truth");
  json_cli(context, cli_exe, ["ui-action", "window-activate"]);
  let native_window_id = "";
  if (platform === "linux") { native_window_id = "" + native_window.top_level_window_id; }
  let focused = null;
  for (let attempt = 0; attempt < 160; attempt = attempt + 1) {
    const snapshot = json_cli(context, cli_exe, ["ui-snapshot"]);
    const os_focused = os_focused_for_platform(context, platform, native_window_id);
    const gui_facts = platform_facts(gui);
    const focus_surface = "" + snapshot.focus.surface;
    if (snapshot.focus.window_focused
        && focus_surface === "terminal"
        && gui_facts.top_level_window_is_foreground
        && os_focused !== 0) {
      focused = snapshot;
      break;
    }
    harness.sleep_ms(20);
  }
  harness.require(focused !== null, "unix_frontend_native_focus_event_timeout");
  if (platform === "linux") {
    wait_x11_active(context, native_window_id, "unix_frontend_linux_compositor_focus_timeout");
  } else {
    wait_macos_agenterm_active(context);
  }

  record_phase(context, "renderer-owned snapshot and PNG describe one event position");
  const before_capture = json_cli(context, cli_exe, ["ui-snapshot"]);
  const screenshot_path = rh.join(evidence_directory_of(context), "unix-workbench-" + platform + ".png");
  const returned_path = text_cli(context, cli_exe, ["screenshot", "-o", screenshot_path]);
  const after_capture = json_cli(context, cli_exe, ["ui-snapshot"]);
  const rendered = inspect_png(screenshot_path);
  const screenshot_bytes = rh.metadata(screenshot_path).len;
  const renderer_evidence = {
    before: before_capture.event_position,
    after: after_capture.event_position,
    focus: focused.focus,
    png: screenshot_path,
    width: rendered.width,
    height: rendered.height,
    bytes: screenshot_bytes
  };
  const after_surface = "" + after_capture.focus.surface;
  const after_title = "" + after_capture.window.title;
  harness.require(
    returned_path === screenshot_path
      && before_capture.event_position.epoch === after_capture.event_position.epoch
      && before_capture.event_position.sequence === after_capture.event_position.sequence
      && after_capture.focus.window_focused
      && after_surface === "terminal"
      && after_title !== ""
      && after_capture.layout.terminal.rows > 0
      && after_capture.layout.terminal.cols > 0
      && screenshot_bytes > 1000
      && rendered.width > 0
      && rendered.height > 0
      && rendered.samples > 0
      && rendered.luminance > 1
      && rendered.luminance < 255,
    "unix_frontend_renderer_evidence:" + JSON.stringify(renderer_evidence)
  );
  harness.emit_evidence(context, declared_evidence, "ux.unix-frontend-" + platform + "-workbench");

  record_phase(context, "real native clipboard text is asynchronously pasted into the PTY");
  const active_tab = focused.active_window_id;
  const paste_marker = "AGENTERM_NATIVE_PASTE_" + context.run_id;
  const clipboard_text = "echo " + paste_marker;
  if (platform === "linux") {
    const clipboard_owner = harness.start({
      program: "xclip",
      args: ["-selection", "clipboard", "-target", "UTF8_STRING", "-loops", "2", "-silent"],
      stdin_text: clipboard_text,
      timeout_ms: 30000
    });
    owned_children.push(clipboard_owner);
    const owner_reaped = wait_linux_clipboard_owner(context, clipboard_text, clipboard_owner);
    if (owner_reaped !== 0) { owned_children = harness.forget_child(owned_children, clipboard_owner); }
  } else {
    set_native_clipboard(context, platform, clipboard_text);
  }
  const paste_baseline = json_cli(context, cli_exe, ["ui-snapshot"]);
  json_cli(context, cli_exe, ["ui-action", "terminal-paste"]);
  const paste_complete = wait_terminal_paste_success(context, cli_exe);
  harness.require(
    paste_complete.active_window_id === active_tab,
    "unix_frontend_native_paste_target_changed"
  );
  json_cli(
    context, cli_exe,
    [
      "wait-events",
      "--epoch", "" + paste_baseline.event_position.epoch,
      "--after", "" + paste_baseline.event_position.sequence,
      "--kind", "terminal.pasted",
      "--tab", active_tab,
      "--timeout-ms", "5000"
    ]
  );
  text_cli(context, cli_exe, ["send-keys", "-t", active_tab, "Enter"]);
  text_cli(
    context, cli_exe,
    ["wait-pane", "-t", active_tab, "--contains", paste_marker, "--timeout-ms", "5000"]
  );
  const pasted = text_cli(
    context, cli_exe, ["capture-pane", "-p", "-t", active_tab, "--max-bytes", "16384"]
  );
  harness.require(text_contains(pasted, paste_marker), "unix_frontend_native_clipboard_marker_missing");
  harness.emit_evidence(context, declared_evidence, "ux.unix-frontend-" + platform + "-native-clipboard");

  record_phase(context, "a delayed clipboard result cannot cross an active-tab boundary");
  const peer = text_cli(
    context, cli_exe,
    ["new-window", "-d", "-P", "-F", "#{window_id}", "-n", "stale-target-" + context.run_id, "--", "/bin/sh"]
  );
  harness.require(text_starts_with(peer, "@"), "unix_frontend_peer_id_invalid:" + peer);
  json_cli(context, cli_exe, ["ui-action", "select-tab", "-t", active_tab]);
  rh.atomic_write(mode_path, "enabled\n");
  json_cli(context, cli_exe, ["ui-action", "terminal-paste"]);
  wait_file(entered_path, gui, "unix_frontend_clipboard_barrier_timeout");
  json_cli(context, cli_exe, ["ui-action", "select-tab", "-t", peer]);
  rh.atomic_write(release_path, "released\n");
  const stale = wait_stale_failure(context, cli_exe);
  const stale_error = stale.feedback.error;
  harness.require(
    stale.active_window_id === peer
      && "" + stale_error.code === "terminal_paste_failed"
      && "" + stale_error.category === "precondition"
      && stale_error.retryable,
    "unix_frontend_stale_failure_contract:" + JSON.stringify(stale_error)
  );
  const tab_a = active_tab;
  const capture_a = text_cli(
    context, cli_exe, ["capture-pane", "-p", "-t", tab_a, "--max-bytes", "16384"]
  );
  harness.require(!text_contains(capture_a, stale_marker), "unix_frontend_stale_marker_delivered:" + tab_a);
  const tab_b = peer;
  const capture_b = text_cli(
    context, cli_exe, ["capture-pane", "-p", "-t", tab_b, "--max-bytes", "16384"]
  );
  harness.require(!text_contains(capture_b, stale_marker), "unix_frontend_stale_marker_delivered:" + tab_b);
  harness.emit_evidence(context, declared_evidence, "ux.unix-frontend-" + platform + "-stale-paste");

  record_phase(context, "public close choice terminates the owned GUI/server cleanly");
  json_cli(context, cli_exe, ["ui-action", "close-window"]);
  json_cli(context, cli_exe, ["ui-action", "stop-server-and-exit"]);
  const exit = wait_exit(gui, "unix_frontend_shutdown_timeout");
  owned_children = harness.forget_child(owned_children, gui);
  harness.require(exit.success, "unix_frontend_shutdown_failed:" + exit.stderr);
  print("PASS: " + platform + " native workbench and clipboard journey");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
  try {
    retain_failure_snapshot(context, cli_exe);
  } catch (diagnostic_error) {
    rh.atomic_write(
      rh.join(context.failure_directory, "snapshot-error.txt"),
      "" + diagnostic_error
    );
  }
}

let completion_failure = "";
try {
  harness.complete(context, owned_children, succeeded !== 0, failure);
} catch (error) {
  completion_failure = "" + error;
}
if (succeeded !== 0 && completion_failure === "") {
  harness.remove_run(context);
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
