// One entry point for the whole six-cell matrix: build all six, then run each
// cell's runtime smoke wherever that cell can actually execute.
// Moved from rh on 2026-08-29.
//
// Args: REPO [release-fast|release|dev] [--runners PATH] [--build|--no-build]
//
// Building is host-only; running is not. `scripts/six-cell-runners.json` is the
// seam: it says, per cell, whether the artifact runs here, over ssh in a VM, or
// nowhere yet. A cell with no runner is reported BLOCKED with its reason
// reproduced verbatim -- never skipped. A skipped cell reads as a passing cell
// to anyone scanning a receipt, which is the specific failure this task exists
// to prevent (goal §3).
//
// The task succeeds when nothing FAILED. BLOCKED is not failure: it is the
// honest state of a cell whose runner a person still has to provide, and the
// receipt carries the count so it can never be mistaken for coverage.
//
// Runs under `--profile tool`. Every child here runs to completion
// (`rh.command`); nothing is spawned and left running.
import * as rh from "lib/rh_compat";

function artifact_dir(repo, target, profile) {
  let leaf = profile;
  if (profile === "dev") { leaf = "debug"; }
  return rh.join(rh.join(rh.join(repo, "target"), target), leaf);
}

function binary_name(target) {
  if (target.includes("windows")) {
    return "agenterm.exe";
  }
  return "agenterm";
}

function cu_binary_name(target) {
  if (target.includes("windows")) {
    return "agenterm-cu.exe";
  }
  return "agenterm-cu";
}

// The identity is named relative to the home directory rather than with a `~/`
// prefix that would need stripping, so no absolute host path lands in the
// repository.
function identity_path(cell) {
  rh.require(env_has("HOME") === 1, "qualify_home_missing");
  return rh.join(rh.env_or("HOME", ""), "" + cell.identity_from_home);
}

// rh's `stdout_file` / `stderr_file` redirected the child's streams straight
// to disk; the door captures both (bounded by the slot's result cap) and this
// writes them out after the child exits. Same files, same contents, and the
// caller still reads `.success` off the output.
// Resolve the product-neutral court CLI the same way the Defender court
// caller does, so both find one installation.
function court_command() {
  const explicit = rh.env_or("UTM_COURT_CLI", "");
  if (explicit !== "") { return explicit; }
  const home = rh.env_or("UTM_COURT_HOME", "");
  if (home !== "") { return rh.join(rh.join(home, "bin"), "utm-court"); }
  return rh.join(rh.join(rh.env_or("HOME", ""), "repos/utm-court/bin"), "utm-court");
}

// One guest command, with its output redirected to a guest file the caller
// pulls back. Windows and the Unix guests need different shells for that.
function court_exec(court, cell, command, guest_out) {
  const args = ["exec", court, "--"];
  if (("" + cell.shell) === "cmd") {
    args.push("cmd.exe");
    args.push("/c");
    args.push(redirected(command, guest_out));
  } else {
    args.push("/bin/sh");
    args.push("-c");
    args.push(redirected(command, guest_out));
  }
  return args;
}

// A step with nowhere to write its output yet -- the directory-creating one --
// passes an empty `guest_out` and simply runs.
function redirected(command, guest_out) {
  if (guest_out === "") { return command; }
  return command + " > " + guest_out + " 2>&1";
}

function mkdir_command(cell, guest_dir) {
  if (("" + cell.shell) === "cmd") {
    return "if not exist \"" + guest_dir + "\" mkdir \"" + guest_dir + "\"";
  }
  return "mkdir -p '" + guest_dir + "'";
}

// `exec` returns once the court has handed the command to the guest agent, not
// once the guest's shell has closed its redirect. Pulling immediately therefore
// loses the race and reports "the file is being used by another process" --
// which reads exactly like a failed smoke. Retry until the writer lets go, and
// only then decide; a guest-side sleep between attempts is the barrier.
function court_pull(court_cli, court, cell, guest_path, work_root, target) {
  const local = rh.join(work_root, target + ".court-out.txt");
  let attempt = 0;
  while (attempt < 12) {
    attempt = attempt + 1;
    const pulled = run(court_cli, ["pull", court, guest_path, local], 300000,
      rh.join(work_root, target + ".pull.stdout"),
      rh.join(work_root, target + ".pull.stderr"));
    if (pulled.success && rh.exists(local)) { return rh.read_text(local); }
    run(court_cli, court_exec(court, cell, guest_sleep(cell), ""), 120000,
      rh.join(work_root, target + ".settle.stdout"),
      rh.join(work_root, target + ".settle.stderr"));
  }
  return "";
}

function guest_sleep(cell) {
  if (("" + cell.shell) === "cmd") { return "ping -n 3 127.0.0.1"; }
  return "sleep 2";
}

function run(program, arguments, timeout_ms, stdout_path, stderr_path) {
  const output = rh.command(program, arguments, { timeout_ms: timeout_ms });
  rh.atomic_write(stdout_path, output.stdout);
  rh.atomic_write(stderr_path, output.stderr);
  return output;
}

// Describe one binary through the `file` oracle and keep its text as
// evidence. The oracle's stdout is the description and the caller decides
// the verdict from it, so neither a `tee` nor a `grep` has to be spawned
// alongside it; the evidence file is still written, atomically.
function describe_binary(path, path_out) {
  const probe = rh.command("file", ["-b", path], { timeout_ms: 60000 });
  const text = typeof probe.stdout === "string" ? probe.stdout : "";
  rh.atomic_write(path_out, text);
  return { success: probe.success === true, text: text };
}

function ssh_base(cell) {
  return [
    "-o", "StrictHostKeyChecking=no",
    "-o", "UserKnownHostsFile=/dev/null",
    "-o", "ConnectTimeout=15",
    "-i", identity_path(cell)
  ];
}

const args = [];
for (let i = 0; i < arg_count(); i = i + 1) {
  if (arg(i) !== 0) { throw "arg: " + tool_result(); }
  args.push(tool_result());
}
rh.require(args.length >= 1, "expected: REPO [PROFILE] [--runners PATH] [--build|--no-build]");
const repo = rh.absolute(args[0]);

let profile = "dev";
let profile_set = 0;
let runners_path = rh.join(repo, "scripts/six-cell-runners.json");
let runners_set = 0;
let do_build = 1;
let build_selector = "";
let index = 1;
while (index < args.length) {
  const value = "" + args[index];
  if (value === "release" || value === "release-fast" || value === "dev") {
    rh.require(profile_set === 0, "qualify_profile_duplicate");
    profile = value;
    profile_set = 1;
  } else if (value === "--runners") {
    rh.require(index + 1 < args.length, "qualify_option_value_missing:" + value);
    rh.require(runners_set === 0, "qualify_runners_duplicate");
    runners_path = rh.absolute(args[index + 1]);
    runners_set = 1;
    index = index + 1;
  } else if (value === "--build") {
    rh.require(build_selector !== "no-build", "qualify_build_flag_conflict");
    build_selector = "build";
    do_build = 1;
  } else if (value === "--no-build") {
    rh.require(build_selector !== "build", "qualify_build_flag_conflict");
    build_selector = "no-build";
    do_build = 0;
  } else {
    throw "qualify_unknown_argument:" + value;
  }
  index = index + 1;
}

rh.require(
  env_has("AGENTERM_BOOTSTRAP_WORKER") === 1,
  "qualify_bootstrap_worker_missing"
);
const worker = rh.absolute(rh.env_or("AGENTERM_BOOTSTRAP_WORKER", ""));
const task_manifest = rh.join(repo, "agenterm.tasks.json");

const work_root = rh.join(repo, "target/qualification/six-cell");
rh.create_dir_all(work_root);

// Build first. Its own receipt already carries the per-artifact hashes, so
// this task reads that file rather than re-hashing anything.
let build_state = "SKIPPED";
if (do_build !== 0) {
  print("qualify: building six cells [" + profile + "]");
  const build_out = rh.join(work_root, "qualify-build.stdout");
  const build_err = rh.join(work_root, "qualify-build.stderr");
  const built = run(
    worker,
    [
      "cli", "script", "task", "run", "client-build-all",
      "--manifest", task_manifest,
      "--", profile
    ],
    3540000,
    build_out,
    build_err
  );
  if (!built.success) {
    build_state = "FAIL";
    print("qualify: BUILD FAILED -- see " + build_err);
  } else {
    build_state = "PASS";
  }
  rh.require(build_state !== "FAIL", "qualify_build_failed");
}

const runners = rh.parse_file(runners_path);
const results = [];
let counted = 0;
let failed = 0;
let blocked = 0;

for (const cell of runners.cells) {
  counted = counted + 1;
  const target = "" + cell.target;
  const kind = "" + cell.kind;
  const level = "" + cell.level;
  const binary = binary_name(target);
  const cu_binary = cu_binary_name(target);
  const local_dir = artifact_dir(repo, target, profile);
  const local_binary = rh.join(local_dir, binary);
  const local_cu_binary = rh.join(local_dir, cu_binary);

  if (!rh.exists(local_binary) || !rh.exists(local_cu_binary)) {
    failed = failed + 1;
    print("qualify: FAIL " + target + " -- product or ACU artifact missing");
    results.push({
      target: target,
      level: level,
      static_check: "MISSING",
      state: "FAIL",
      detail: "agenterm and agenterm-cu artifacts are both required"
    });
    continue;
  }

  // Static verification: what the artifact *is*, independent of whether
  // anything can execute it. It runs for every cell, blocked ones
  // included -- a cell with no runner still has an artifact that can be
  // built wrong, and "we could not run it" is a poor reason to check
  // nothing at all. A cross build silently emitting the host's
  // architecture is exactly the failure this catches.
  //
  // Both the description and the verdict come out of the `file` oracle
  // itself: its stdout is the description, and the verdict is a substring
  // test against the expected architecture. Wrapping that in `sh | tee |
  // grep` bought nothing -- `tee` only re-materialized a file the script
  // already writes, and `grep -qF` is a plain substring test. The evidence
  // file is still produced, through the same atomic write the rest of this
  // script uses.
  const described_path = rh.join(work_root, target + ".file.txt");
  const cu_described_path = rh.join(work_root, target + ".cu.file.txt");
  const expected = "" + cell.expect_file;
  let cu_expected = expected;
  if (typeof cell.expect_cu_file === "string") {
    cu_expected = "" + cell.expect_cu_file;
  }
  const matched = describe_binary(local_binary, described_path);
  let described = "";
  if (rh.exists(described_path)) {
    described = rh.read_text(described_path).replaceAll("\n", " ");
  }
  let cu_described = "";
  let static_check = "FAIL";
  const cu_matched = describe_binary(local_cu_binary, cu_described_path);
  if (rh.exists(cu_described_path)) {
    cu_described = rh.read_text(cu_described_path).replaceAll("\n", " ");
  }
  if (matched.success && matched.text.includes(expected)
      && cu_matched.success && cu_matched.text.includes(cu_expected)) {
    static_check = "PASS";
  }
  if (static_check === "FAIL") {
    failed = failed + 1;
    print("qualify: FAIL " + target + " -- static: agenterm expected \"" + expected
      + "\", got \"" + described + "\"; agenterm-cu expected \"" + cu_expected
      + "\", got \"" + cu_described + "\"");
    results.push({
      target: target,
      level: level,
      static_check: static_check,
      state: "FAIL",
      detail: "agenterm or agenterm-cu architecture mismatch; agenterm says \"" + described
        + "\", expected \"" + expected + "\"; agenterm-cu says \"" + cu_described
        + "\", expected \"" + cu_expected + "\""
    });
    continue;
  }

  if (kind === "blocked") {
    blocked = blocked + 1;
    print("qualify: BLOCKED " + target + " (static PASS) -- " + cell.reason);
    results.push({
      target: target,
      level: level,
      static_check: static_check,
      state: "BLOCKED",
      detail: "" + cell.reason
    });
    continue;
  }

  const stdout_path = rh.join(work_root, target + ".smoke.stdout");
  const stderr_path = rh.join(work_root, target + ".smoke.stderr");
  const cu_stdout_path = rh.join(work_root, target + ".cu.smoke.stdout");
  const cu_stderr_path = rh.join(work_root, target + ".cu.smoke.stderr");
  let smoke_ok = false;

  if (kind === "host") {
    const hosted = run(local_binary, ["cli", "--help"], 120000, stdout_path, stderr_path);
    const cu_hosted = run(
      local_cu_binary,
      ["--target", "current", "--grant", "observe", "storage-devices", "--max", "1"],
      120000,
      cu_stdout_path,
      cu_stderr_path
    );
    smoke_ok = hosted.success && cu_hosted.success && cu_hosted.stdout.includes('"ok":true');
  } else if (kind === "court") {
    // A UTM court is the same contract as `host`, reached through the
    // product-neutral `utm-court` CLI instead of a shell on this machine:
    // lease, push the exact bytes, run the same two smokes the host cell
    // runs, and read the verdict back. The court is the only runner we own
    // for the Windows and Linux cells, and it is a real machine of that
    // architecture rather than an emulation of one -- which is the whole
    // reason this file distinguishes `level`.
    const court = "" + cell.court;
    const guest_dir = "" + cell.guest_dir;
    const guest_binary = guest_dir + cell.separator + binary;
    const guest_cu = guest_dir + cell.separator + cu_binary;
    const court_cli = court_command();

    const leased = run(court_cli, ["lease", court], 900000,
      rh.join(work_root, target + ".lease.stdout"),
      rh.join(work_root, target + ".lease.stderr"));
    if (!leased.success) {
      failed = failed + 1;
      print("qualify: FAIL " + target + " -- " + "court lease failed: " + leased.stderr);
      results.push({
        target: target,
        level: level,
        static_check: static_check,
        state: "FAIL",
        detail: "court lease failed: " + leased.stderr
      });
      continue;
    }
    run(court_cli, ["wait-ready", court, "240"], 300000,
      rh.join(work_root, target + ".ready.stdout"),
      rh.join(work_root, target + ".ready.stderr"));

    // The push lands a file, not a directory, so the destination directory
    // has to exist first; on the Unix guests the pushed bytes also arrive
    // without an executable bit.
    run(court_cli, court_exec(court, cell, mkdir_command(cell, guest_dir), ""), 300000,
      rh.join(work_root, target + ".prepare.stdout"),
      rh.join(work_root, target + ".prepare.stderr"));

    const pushed = run(court_cli, ["push", court, local_binary, guest_binary], 900000,
      rh.join(work_root, target + ".push.stdout"),
      rh.join(work_root, target + ".push.stderr"));
    const pushed_cu = run(court_cli, ["push", court, local_cu_binary, guest_cu], 900000,
      rh.join(work_root, target + ".push-cu.stdout"),
      rh.join(work_root, target + ".push-cu.stderr"));
    if (!pushed.success || !pushed_cu.success) {
      failed = failed + 1;
      print("qualify: FAIL " + target + " -- " + "court push to " + court + " failed");
      results.push({
        target: target,
        level: level,
        static_check: static_check,
        state: "FAIL",
        detail: "court push to " + court + " failed"
      });
      continue;
    }

    if (("" + cell.shell) !== "cmd") {
      run(court_cli, court_exec(court, cell,
        "chmod +x " + guest_binary + " " + guest_cu, ""), 300000,
        rh.join(work_root, target + ".chmod.stdout"),
        rh.join(work_root, target + ".chmod.stderr"));
    }

    // The guest agent does not stream stdout, so each smoke writes a file in
    // the guest and the verdict is pulled back.
    const guest_out = guest_dir + cell.separator + "smoke.txt";
    const guest_cu_out = guest_dir + cell.separator + "cu-smoke.txt";
    const smoke = run(court_cli, court_exec(court, cell, guest_binary + " cli --help", guest_out),
      600000, stdout_path, stderr_path);
    const cu_smoke = run(court_cli,
      court_exec(court, cell,
        guest_cu + " --target current --grant observe storage-devices --max 1", guest_cu_out),
      600000, cu_stdout_path, cu_stderr_path);
    const cu_text = court_pull(court_cli, court, cell, guest_cu_out, work_root, target);
    smoke_ok = smoke.success && cu_smoke.success && cu_text.includes('"ok":true');
  } else if (kind === "ssh") {
    const destination = "" + cell.user + "@" + cell.host;
    const remote_dir = "" + cell.remote_dir;
    const port = "" + cell.port;

    const push_args = ssh_base(cell);
    push_args.push("-P");
    push_args.push(port);
    // Land on a side name, then rename into place below. Overwriting a
    // binary that is currently executing fails with ETXTBSY on Linux --
    // which is exactly the state a VM is in after a GUI smoke -- while
    // rename(2) over it succeeds and leaves the running process on the
    // old inode.
    push_args.push(local_binary);
    push_args.push(destination + ":" + remote_dir + "/" + binary + ".new");
    const pushed = run(
      "scp", push_args, 900000,
      rh.join(work_root, target + ".scp.stdout"),
      rh.join(work_root, target + ".scp.stderr")
    );
    if (!pushed.success) {
      failed = failed + 1;
      print("qualify: FAIL " + target + " -- artifact transfer failed");
      results.push({
        target: target,
        level: level,
        static_check: static_check,
        state: "FAIL",
        detail: "scp to " + destination + ":" + port + " failed"
      });
      continue;
    }

    const cu_push_args = ssh_base(cell);
    cu_push_args.push("-P");
    cu_push_args.push(port);
    cu_push_args.push(local_cu_binary);
    cu_push_args.push(destination + ":" + remote_dir + "/" + cu_binary + ".new");
    const cu_pushed = run(
      "scp", cu_push_args, 900000,
      rh.join(work_root, target + ".cu.scp.stdout"),
      rh.join(work_root, target + ".cu.scp.stderr")
    );
    if (!cu_pushed.success) {
      failed = failed + 1;
      print("qualify: FAIL " + target + " -- ACU artifact transfer failed");
      results.push({
        target: target,
        level: level,
        static_check: static_check,
        state: "FAIL",
        detail: "agenterm-cu scp to " + destination + ":" + port + " failed"
      });
      continue;
    }

    const smoke_args = ssh_base(cell);
    smoke_args.push("-p");
    smoke_args.push(port);
    smoke_args.push(destination);
    smoke_args.push(
      "cd " + remote_dir
        + " && mv -f " + binary + ".new " + binary
        + " && mv -f " + cu_binary + ".new " + cu_binary
        + " && chmod +x " + binary + " " + cu_binary
        + " && ./" + binary + " cli --help"
        + " && ./" + cu_binary + " --target current --grant observe storage-devices --max 1"
    );
    const remote = run("ssh", smoke_args, 600000, stdout_path, stderr_path);
    smoke_ok = remote.success;
  } else {
    throw "qualify_runner_kind:" + kind;
  }

  if (!smoke_ok) {
    failed = failed + 1;
    print("qualify: FAIL " + target);
    results.push({
      target: target,
      level: level,
      static_check: static_check,
      state: "FAIL",
      detail: "agenterm cli --help or agenterm-cu storage-devices failed; see smoke logs"
    });
  } else {
    print("qualify: PASS " + target + "  [" + level + "]");
    results.push({
      target: target,
      level: level,
      static_check: static_check,
      state: "PASS",
      detail: "agenterm cli --help and agenterm-cu storage-devices exit 0"
    });
  }
}

// No timestamp field, as in rh: the receipt file's own mtime is what dates a
// run, same as `build-all`.
const receipt = {
  kind: "agenterm-six-cell-qualify",
  schema_version: 1,
  profile: profile,
  build: build_state,
  runners: runners_path,
  cells: results,
  totals: {
    cells: counted,
    failed: failed,
    blocked: blocked
  }
};
const receipt_path = rh.join(work_root, "qualify.json");
rh.atomic_write(receipt_path, rh.stringify_pretty(receipt));

print("");
print("Six-cell qualification [" + profile + "] build=" + build_state);
for (const result of results) {
  print("  " + result.state + "  " + result.target + "  [" + result.level
    + "]  static=" + result.static_check);
}
print("  " + counted + " cells, " + failed + " failed, " + blocked + " blocked");
print("  receipt: " + receipt_path);

rh.require(failed === 0, "qualify_failed_cells:" + failed);
return;
