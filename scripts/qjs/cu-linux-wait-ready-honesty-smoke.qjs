// CEO: Linux wait --node-name-contains and wait --ready-path honesty with
// independent AT-SPI / on-disk marker read-back. Acceptance is smoke
// read-back only: CU wait met and returned node/marker must agree with
// pyatspi named-node probes or a direct JSON read of the ready-path file,
// never worker self-report alone. Typed wait usage must reject AT-SPI --name,
// --coords, --bogus, and other unexpected arguments (usage_rejects_unexpected,
// never fake command=usage); typed get-extents --name usage AND host-limit
// paths must both hold before process-state, desktop-state, and the wait-ready
// read-back court (no atspi_available gating). process-state and desktop-state
// fixture binding courts must hold before actuate/read-back. Timeout exit-code
// honesty and AT-SPI host-limit paths must hold when conditions miss or the
// independent pyatspi desktop probe is unavailable. AT-SPI/--name only;
// no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-wait-node-name-readback",
  "cu.linux-wait-ready-path-readback",
  "cu.linux-wait-chrome-node-name-readback",
];

const PRESS_BUTTON = "Fixture Press";
const ENTRY_NAME = "Fixture Entry";
const CHROME_FIELD = "GetTextField";
const AT_SPI_PROBE_NAME = "Wait Ready Court Anchor";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}


function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_wait_ready_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}


function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(rh.output_success(document), "cu_linux_wait_ready_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_wait_ready_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_wait_usage_limit(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "1000",
  ]);
  ensure(!rh.output_success(reply), "cu_linux_wait_ready_usage_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_wait_ready_usage_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("requires one of") >= 0,
    "cu_linux_wait_ready_usage_message:" + JSON.stringify(reply.error)
  );
}

function assert_wait_atspi_name_usage_limit(run_directory, executable) {
  const bare_name = run_cu_reply(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "1000",
    "--window", "1",
    "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(!rh.output_success(bare_name), "cu_linux_wait_ready_usage_name_ok:" + JSON.stringify(bare_name));
  ensure(
    text_at(bare_name, "error.code") === "usage",
    "cu_linux_wait_ready_usage_name_code:" + JSON.stringify(bare_name.error)
  );
  ensure(
    text_at(bare_name, "command") === "usage",
    "cu_linux_wait_ready_usage_name_command:" + JSON.stringify(bare_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(bare_name, "error.message"), "--name")
      || text_at(bare_name, "error.message").indexOf("requires one of") >= 0,
    "cu_linux_wait_ready_usage_name_message:" + JSON.stringify(bare_name.error)
  );

  const ready_path_with_name = run_cu_reply(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "1000",
    "--ready-path", rh.join(run_directory, "usage-probe-ready.json"),
    "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(
    !rh.output_success(ready_path_with_name),
    "cu_linux_wait_ready_usage_ready_name_ok:" + JSON.stringify(ready_path_with_name)
  );
  ensure(
    text_at(ready_path_with_name, "error.code") === "usage",
    "cu_linux_wait_ready_usage_ready_name_code:" + JSON.stringify(ready_path_with_name.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(ready_path_with_name, "error.message"), "--name"),
    "cu_linux_wait_ready_usage_ready_name_message:" + JSON.stringify(ready_path_with_name.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "1000", "--bogus",
  ]);
  ensure(!rh.output_success(with_bogus), "cu_linux_wait_ready_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_wait_ready_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_wait_ready_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus")
      || text_at(with_bogus, "error.message").indexOf("requires one of") >= 0,
    "cu_linux_wait_ready_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_coords = run_cu_reply(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "1000", "--coords", "10,10",
  ]);
  ensure(!rh.output_success(with_coords), "cu_linux_wait_ready_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_wait_ready_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_wait_ready_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords")
      || text_at(with_coords, "error.message").indexOf("requires one of") >= 0,
    "cu_linux_wait_ready_usage_coords_message:" + JSON.stringify(with_coords.error)
  );

  const ready_path_with_coords = run_cu_reply(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "1000",
    "--ready-path", rh.join(run_directory, "usage-probe-ready-coords.json"),
    "--coords", "10,10",
  ]);
  ensure(
    !rh.output_success(ready_path_with_coords),
    "cu_linux_wait_ready_usage_ready_coords_ok:" + JSON.stringify(ready_path_with_coords)
  );
  ensure(
    text_at(ready_path_with_coords, "error.code") === "usage",
    "cu_linux_wait_ready_usage_ready_coords_code:" + JSON.stringify(ready_path_with_coords.error)
  );
  ensure(
    text_at(ready_path_with_coords, "command") === "usage",
    "cu_linux_wait_ready_usage_ready_coords_command:" + JSON.stringify(ready_path_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(ready_path_with_coords, "error.message"), "--coords"),
    "cu_linux_wait_ready_usage_ready_coords_message:" + JSON.stringify(ready_path_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle), "cu_linux_wait_ready_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_wait_ready_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_wait_ready_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name), "cu_linux_wait_ready_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_wait_ready_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_wait_ready_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_wait_ready_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords), "cu_linux_wait_ready_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_wait_ready_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_wait_ready_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_wait_ready_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus), "cu_linux_wait_ready_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_wait_ready_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_wait_ready_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_wait_ready_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply), "cu_linux_wait_ready_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_wait_ready_extents_unavailable_code:" + code
  );
}

function assert_wait_node_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "1000",
    "--node-name-contains", PRESS_BUTTON,
    "--window", "1",
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply), "cu_linux_wait_ready_node_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "timeout" || code === "unsupported"
      || code === "bad_handle",
    "cu_linux_wait_ready_node_unavailable_code:" + code
  );
  if (code === "a11y_backend_failed") {
    const message = text_at(reply, "error.message").toLowerCase();
    ensure(
      message.indexOf("accessibility") >= 0
        || message.indexOf("address") >= 0
        || message.indexOf("bus") >= 0,
      "cu_linux_wait_ready_node_unavailable_message:" + JSON.stringify(reply.error)
    );
  }
}

function assert_wait_ready_path_timeout_honesty(run_directory, executable, ready_path) {
  rh.try_remove_file(ready_path);
  const argv = ["--target", "current", "--grant", "observe", "wait",
    "--timeout-ms", "200", "--ready-path", ready_path];
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(
    output.success === false,
    "cu_linux_wait_ready_path_timeout_exit:" + output.stdout + output.stderr
  );
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    !rh.output_success(reply) && text_at(reply, "error.code") === "timeout",
    "cu_linux_wait_ready_path_timeout:" + JSON.stringify(reply)
  );
  ensure(
    text_at(reply, "error.message").indexOf("ready") >= 0,
    "cu_linux_wait_ready_path_timeout_message:" + JSON.stringify(reply.error)
  );
}

function assert_wait_node_timeout_honesty(run_directory, executable, handle_text) {
  const argv = ["--target", "current", "--grant", "observe", "wait",
    "--timeout-ms", "200", "--window", handle_text,
    "--node-name-contains", "agenterm-no-such-node-xyz"];
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(
    output.success === false,
    "cu_linux_wait_ready_node_timeout_exit:" + output.stdout + output.stderr
  );
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    !rh.output_success(reply) && text_at(reply, "error.code") === "timeout",
    "cu_linux_wait_ready_node_timeout:" + JSON.stringify(reply)
  );
  ensure(
    text_at(reply, "error.message").indexOf("agenterm-no-such-node-xyz") >= 0,
    "cu_linux_wait_ready_node_timeout_message:" + JSON.stringify(reply.error)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function chrome_window(run_directory, executable, title_prefix) {
  const inventory = run_cu(run_directory, executable, "observe", ["windows"]);
  const rows = inventory.data.windows === undefined ? inventory.data : inventory.data.windows;
  for (const row of rows) {
    if (text_at(row, "app_name") === "chrome"
      && text_at(row, "title").startsWith(title_prefix)) {
      return {
        handle: "" + at(row, "handle"),
        pid: int_at(row, "process_id"),
        title: text_at(row, "title"),
        row: row,
      };
    }
  }
  return null;
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_wait_ready_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_wait_ready_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_wait_ready_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_wait_ready_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_wait_ready_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function independent_named_node_probe(title, node_name) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "node_name = sys.argv[2]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and w.name == title:",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    if (node.name or '') == node_name:",
    "        states = node.getState()",
    "        return {",
    "            'name': node.name,",
    "            'role': node.getRoleName(),",
    "            'showing': states.contains(pyatspi.STATE_SHOWING),",
    "        }",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_wait_ready_atspi_no_frame')",
    "hit = walk(frame)",
    "if hit is None:",
    "    raise SystemExit('cu_linux_wait_ready_atspi_miss:' + node_name)",
    "print(json.dumps(hit))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title, node_name], {
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_wait_ready_atspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function independent_named_node_probe_pid(pid, node_name) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "pid = int(sys.argv[1])",
    "node_name = sys.argv[2]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "app = None",
    "for i in range(desktop.childCount):",
    "    candidate = desktop.getChildAtIndex(i)",
    "    try:",
    "        if candidate.get_process_id() == pid:",
    "            app = candidate",
    "            break",
    "    except Exception:",
    "        pass",
    "if app is None:",
    "    raise SystemExit('cu_linux_wait_ready_atspi_no_app')",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    if (node.name or '') == node_name:",
    "        states = node.getState()",
    "        return {",
    "            'name': node.name,",
    "            'role': node.getRoleName(),",
    "            'showing': states.contains(pyatspi.STATE_SHOWING),",
    "        }",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "hit = walk(app)",
    "if hit is None:",
    "    raise SystemExit('cu_linux_wait_ready_atspi_miss:' + node_name)",
    "print(json.dumps(hit))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, node_name], {
    timeout_ms: 30000,
    env: cu_env(executable),
  });
  ensure(output.success === true, "cu_linux_wait_ready_atspi_pid:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function independent_ready_marker_read(path, expected_window) {
  ensure(rh.is_direct_file(path), "cu_linux_wait_ready_marker_missing:" + path);
  const raw = rh.read_text(path).trim();
  ensure(raw !== "", "cu_linux_wait_ready_marker_empty:" + path);
  const marker = JSON.parse(raw);
  ensure(
    int_at(marker, "schema") === 1
      && text_at(marker, "state") === "ready"
      && text_at(marker, "mode") === "poll-diff"
      && text_at(marker, "window") === expected_window,
    "cu_linux_wait_ready_marker_shape:" + raw
  );
  return marker;
}

function independent_chrome_dom_value(fixture_path, field_id, expected) {
  const script = [
    "import json, re, sys",
    "path = sys.argv[1]",
    "field_id = sys.argv[2]",
    "expected = sys.argv[3]",
    "html = open(path, encoding='utf-8').read()",
    "match = re.search(r'id=\"' + field_id + '\"[^>]*value=\"([^\"]*)\"', html)",
    "if match is None:",
    "    raise SystemExit('cu_linux_wait_ready_dom_field_missing:' + field_id)",
    "value = match.group(1)",
    "if value != expected:",
    "    raise SystemExit('cu_linux_wait_ready_dom_mismatch:' + value + ':' + expected)",
    "print(json.dumps({'value': value}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, fixture_path, field_id, expected], {
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_wait_ready_dom:" + output.stderr + output.stdout);
  const document = JSON.parse(output.stdout.trim());
  return text_at(document, "value");
}

function start_observer(run_directory, executable, handle_text, duration) {
  const ready_path = rh.join(run_directory, "wait-ready-marker.json");
  rh.try_remove_file(ready_path);
  const handle = harness.start({
    program: executable,
    args: [
      "--target", "current", "--grant", "observe", "observe",
      "--window", handle_text, "--duration", duration,
      "--ready-path", ready_path,
    ],
    current_dir: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  return { handle: handle, ready_path: ready_path };
}

function observer_result(observer) {
  const output = harness.wait(observer.handle, 20000);
  rh.try_remove_file(observer.ready_path);
  ensure(output.success === true, "cu_linux_wait_ready_observer:" + JSON.stringify(output));
  const document = JSON.parse(output.stdout.trim());
  ensure(flag_at(document, "ok"), "cu_linux_wait_ready_observer_reply:" + JSON.stringify(document));
  return document.data;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(rh.is_direct_file(executable), "cu_linux_wait_ready_executable_missing:" + executable);
ensure(rh.is_direct_file(abi_library), "cu_linux_wait_ready_library_missing:" + abi_library);

const uname = rh.command("/usr/bin/uname", ["-s"], { timeout_ms: 10000 });
ensure(uname.success === true && uname.stdout.trim() === "Linux",
  "cu_linux_wait_ready_requires_linux");

const context = harness.new_context(repo, "cu-linux-wait-ready");
const run_directory = rh.join(repo, "target/cu-linux-wait-ready-honesty-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(rh.is_direct_file(fixture_source), "cu_linux_wait_ready_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let chrome_child = -1;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP wait typed-fails usage when no condition flag is present");
  assert_wait_usage_limit(run_directory, executable);

  print("STEP wait typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_wait_atspi_name_usage_limit(run_directory, executable);

  print("STEP wait --ready-path timeout exits non-zero with honest timeout code when marker never appears");
  const absent_ready_path = rh.join(run_directory, "absent-ready-marker.json");
  assert_wait_ready_path_timeout_honesty(run_directory, executable, absent_ready_path);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before process-state/desktop-state and wait-ready read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and wait-ready read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP typed host-limit when independent pyatspi desktop probe is unavailable");
    assert_wait_node_host_limit_when_atspi_absent(run_directory, executable);
    succeeded = 1;
  } else {
  print("STEP GTK: start owned fixture and resolve window by pid and exact title");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_wait_ready_gtk_window_wait");
  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_wait_ready_gtk_window_identity");
  const handle_text = "" + int_at(row, "handle");
  ensure(int_at(row, "handle") > 0, "cu_linux_wait_ready_gtk_handle:" + JSON.stringify(row));

  print("STEP wait --node-name-contains timeout exits non-zero with honest timeout code when node never appears");
  assert_wait_node_timeout_honesty(run_directory, executable, handle_text);

  print("STEP process-state binds the owned fixture pid before wait-ready actuate/read-back court");
  assert_fixture_process_state(run_directory, executable, fixture_pid);

  print("STEP desktop-state window row agrees with inventory before wait-ready actuate/read-back court");
  assert_fixture_desktop_state(
    run_directory, executable, fixture_pid, fixture_title, handle_text, row
  );

  print("STEP GTK: wait --node-name-contains must met with accessibility-tree node");
  const node_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000",
    "--node-name-contains", PRESS_BUTTON,
    "--window", handle_text,
  ]);
  ensure(
    flag_at(node_wait, "data.met")
      && text_at(node_wait, "data.addressing") === "accessibility-tree"
      && text_at(node_wait, "data.node.name") === PRESS_BUTTON,
    "cu_linux_wait_ready_node_wait:" + JSON.stringify(node_wait.data)
  );
  const press_probe = independent_named_node_probe(fixture_title, PRESS_BUTTON);
  ensure(
    press_probe.name === PRESS_BUTTON && press_probe.showing === true,
    "cu_linux_wait_ready_node_probe:" + JSON.stringify(press_probe)
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-wait-node-name-readback");

  print("STEP GTK: wait --ready-path must met only after independent marker + AT-SPI agree");
  const observer = start_observer(run_directory, executable, handle_text, "6");
  const ready_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--ready-path", observer.ready_path,
  ]);
  ensure(
    flag_at(ready_wait, "data.met")
      && text_at(ready_wait, "data.addressing") === "ready-path"
      && text_at(ready_wait, "data.marker.state") === "ready"
      && text_at(ready_wait, "data.marker.mode") === "poll-diff"
      && text_at(ready_wait, "data.marker.window") === handle_text,
    "cu_linux_wait_ready_path_wait:" + JSON.stringify(ready_wait.data)
  );
  const marker = independent_ready_marker_read(observer.ready_path, handle_text);
  ensure(text_at(marker, "backend") !== "", "cu_linux_wait_ready_marker_backend");
  const entry_probe = independent_named_node_probe(fixture_title, ENTRY_NAME);
  ensure(
    entry_probe.name === ENTRY_NAME && entry_probe.showing === true,
    "cu_linux_wait_ready_path_entry_probe:" + JSON.stringify(entry_probe)
  );
  observer_result(observer);
  harness.emit_evidence(context, declared_evidence, "cu.linux-wait-ready-path-readback");

  print("STEP Chrome: disposable page, unlock, wait --node-name-contains GetTextField");
  const chrome_title = "CEO Wait Ready " + context.run_id;
  const chrome_source = rh.join(repo, "fixtures/cu/311b-chrome-gettext.html");
  const chrome_fixture = rh.join(run_directory, "wait-ready-chrome.html");
  let chrome_html = rh.read_text(chrome_source);
  chrome_html = chrome_html.replace("311b Chrome GetText Fixture", chrome_title);
  chrome_html = chrome_html.replace(
    "Prefill HELLO. Independent get-text --name GetTextField must equal HELLO.",
    "Prefill HELLO for wait --node-name-contains read-back."
  );
  rh.write_text(chrome_fixture, chrome_html);
  independent_chrome_dom_value(chrome_fixture, "field", "HELLO");

  const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
  const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
  const port = 9900 + (rh.pid() % 500);
  const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  ensure(!(stale.success === true && stale.stdout.includes("Browser")), "cu_linux_wait_ready_chrome_port_in_use:" + port);

  chrome_child = harness.start({
    program: launcher,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--new-window",
      "file://" + chrome_fixture,
    ],
    current_dir: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  for (let attempt = 0; attempt < 80; attempt = attempt + 1) {
    const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
      cwd: run_directory,
      timeout_ms: 3000,
    });
    if (probe.success === true && probe.stdout.includes("Browser")) { break; }
    harness.sleep_ms(250);
  }
  const chrome_window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "20000", "--window-title-contains", chrome_title,
  ]);
  ensure(flag_at(chrome_window_wait, "data.met"), "cu_linux_wait_ready_chrome_window_wait");
  let chrome_row = null;
  for (let attempt = 0; attempt < 40 && chrome_row === null; attempt = attempt + 1) {
    chrome_row = chrome_window(run_directory, executable, chrome_title);
    if (chrome_row === null) { harness.sleep_ms(250); }
  }
  ensure(chrome_row !== null, "cu_linux_wait_ready_chrome_window_missing");
  const chrome_handle = chrome_row.handle;
  const chrome_pid = chrome_row.pid;
  const chrome_inventory_row = chrome_row.row;
  const chrome_window_title = chrome_row.title;

  print("STEP process-state binds the owned Chrome pid before wait-ready actuate/read-back court");
  assert_fixture_process_state(run_directory, executable, chrome_pid);

  print("STEP desktop-state window row agrees with inventory before wait-ready actuate/read-back court");
  assert_fixture_desktop_state(
    run_directory, executable, chrome_pid, chrome_window_title, chrome_handle, chrome_inventory_row
  );

  const unlocked = run_cu(run_directory, executable, "observe,actuate", [
    "unlock", "--window", chrome_handle,
  ]);
  ensure(flag_at(unlocked, "data.poked"), "cu_linux_wait_ready_chrome_unlock:" + JSON.stringify(unlocked.data));

  const chrome_node_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "20000",
    "--node-name-contains", CHROME_FIELD,
    "--window", chrome_handle,
  ]);
  ensure(
    flag_at(chrome_node_wait, "data.met")
      && text_at(chrome_node_wait, "data.addressing") === "accessibility-tree"
      && text_at(chrome_node_wait, "data.node.name") === CHROME_FIELD,
    "cu_linux_wait_ready_chrome_node_wait:" + JSON.stringify(chrome_node_wait.data)
  );
  const chrome_probe = independent_named_node_probe_pid(chrome_pid, CHROME_FIELD);
  ensure(
    chrome_probe.name === CHROME_FIELD && chrome_probe.showing === true,
    "cu_linux_wait_ready_chrome_probe:" + JSON.stringify(chrome_probe)
  );
  independent_chrome_dom_value(chrome_fixture, "field", "HELLO");
  harness.emit_evidence(context, declared_evidence, "cu.linux-wait-chrome-node-name-readback");

  succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}
if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup chrome: " + error); }
  harness.wait(chrome_child, 10000);
}

ensure(succeeded === 1, failure || "cu_linux_wait_ready_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux wait node-name + ready-path honesty with typed wait --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), process-state/desktop-state courts before actuate/read-back, timeout exit-code honesty, and independent read-back (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux wait node-name + ready-path honesty with typed wait --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), timeout exit-code honesty, and independent read-back (AT-SPI --name, no --coords)");
}
