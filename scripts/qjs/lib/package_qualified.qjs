// package_qualified.qjs -- byte-qualified offline Windows package
// construction (INT-only native pack). Moved from rh on 2026-08-29; four rh
// entries import it (package-qualified, package-release-qualified,
// package-qualified-selftest, release).
//
// A tool library: every file, hash, and child process goes through the
// `tool.*` door via rh_compat, so importers run under `--profile tool`.
//
// Kept exactly from rh: the receipt/metadata/manifest cross-checks and their
// order, the failure codes, the payload list, the staging layout, the archive
// name, the result files, and the `.latest-package-run` sidecar.
//
// Changed, each on purpose:
//   - git's stdout comes back from `rh.command` directly; rh wrote it to a
//     sibling temp file and read it back, which was the same bytes.
//   - the archiver: rh named `tar.exe` (Windows bsdtar). That spelling is
//     tried first; when the door cannot spawn it, plain `tar` is tried, which
//     is the same bsdtar on macOS and Linux and honours the same `-a` (zip by
//     archive suffix). Windows behaviour is unchanged.
//   - `unique.contains(name)` is `unique[name] === undefined`: no `Object.*`
//     in this engine, and a plain object still answers a key lookup.

import * as rh from "lib/rh_compat";

export function exact_values(expected, actual) {
  if (expected.length !== actual.length) { return false; }
  for (let idx = 0; idx < expected.length; idx = idx + 1) {
    const value = expected[idx];
    let found = 0;
    for (let j = 0; j < actual.length; j = j + 1) {
      if (actual[j] === value) { found = 1; }
    }
    if (found === 0) { return false; }
  }
  for (let idx = 0; idx < actual.length; idx = idx + 1) {
    const value = actual[idx];
    let found = 0;
    for (let j = 0; j < expected.length; j = j + 1) {
      if (expected[j] === value) { found = 1; }
    }
    if (found === 0) { return false; }
  }
  return true;
}

function valid_version(value) {
  if (value === "" || value.includes("/") || value.includes("\\")) { return false; }
  const build_parts = value.split("+");
  if (build_parts.length > 2) { return false; }
  const public_version = build_parts[0];
  const prerelease_parts = public_version.split("-");
  if (prerelease_parts.length > 2) { return false; }
  const core = prerelease_parts[0];
  const parts = core.split(".");
  if (parts.length !== 3) { return false; }
  if (parts[0] === "" || parts[1] === "" || parts[2] === "") { return false; }
  return true;
}

function is_file(p) {
  return rh.exists(p) && rh.metadata(p).is_file;
}

// The archiver, run to completion in `cwd`: `tar.exe` as rh spelled it, then
// `tar` when the door cannot spawn that name (a non-Windows host). Returns
// the door's {exit_code, success, stdout, stderr, timed_out}.
export function archive_command(args, cwd) {
  try {
    return rh.command("tar.exe", args, { cwd: cwd, timeout_ms: 30000 });
  } catch (spawn_error) {
    return rh.command("tar", args, { cwd: cwd, timeout_ms: 30000 });
  }
}

function build_package_mode(repo_value, receipt_value, output_value, dry_run) {
  const repo = rh.absolute(repo_value);
  const receipt_path = rh.join(repo, receipt_value);
  const output_root = rh.join(repo, output_value);
  const receipt = rh.parse_file(receipt_path);
  rh.require(
    receipt.schema_version === 1
      && receipt.product === "AgenTerm"
      && receipt.release
      && receipt.stress_included,
    "package_receipt_not_release_stress"
  );
  rh.require(!receipt.provenance.source_dirty, "package_receipt_source_dirty");
  for (const gate of receipt.gates) {
    const gate_id = "" + gate.id;
    const gate_status = "" + gate.status;
    rh.require(gate_status === "passed", "package_receipt_gate_not_passed:" + gate_id);
  }

  const git = rh.command("git", ["rev-parse", "HEAD"], { cwd: repo, timeout_ms: 30000 });
  rh.require(git.exit_code === 0, "package_git_head");
  const head = git.stdout.trim().toLowerCase();
  rh.require(
    head.length === 40 && receipt.provenance.git_head === head,
    "package_receipt_head_mismatch"
  );

  const cargo_lock_path = rh.join(repo, "Cargo.lock");
  rh.require(is_file(cargo_lock_path), "package_input_missing:" + cargo_lock_path);
  const cargo_hash = rh.sha256_file(cargo_lock_path);
  rh.require(receipt.provenance.cargo_lock_sha256 === cargo_hash, "package_receipt_cargo_lock_hash");
  const artifact_manifest_path = rh.join(repo, "scripts/artifacts.json");
  rh.require(is_file(artifact_manifest_path), "package_input_missing:" + artifact_manifest_path);
  const artifact_hash = rh.sha256_file(artifact_manifest_path);
  rh.require(
    receipt.provenance.artifact_manifest_sha256 === artifact_hash,
    "package_receipt_artifact_manifest_hash"
  );
  const sbom_path = rh.join(repo, "dist/agenterm-sbom.spdx.json");
  rh.require(is_file(sbom_path), "package_input_missing:" + sbom_path);
  const sbom_hash = rh.sha256_file(sbom_path);
  rh.require(receipt.provenance.sbom_sha256 === sbom_hash, "package_receipt_sbom_hash");
  const gate_manifest_path = rh.join(repo, "scripts/qualification-gates.json");
  rh.require(is_file(gate_manifest_path), "package_input_missing:" + gate_manifest_path);
  const gate_hash = rh.sha256_file(gate_manifest_path);
  rh.require(receipt.gate_manifest.sha256 === gate_hash, "package_receipt_gate_manifest_hash");
  const gate_manifest = rh.parse_file(gate_manifest_path);
  const required_gate_names = [];
  for (const gate of gate_manifest.required_gates) {
    required_gate_names.push("" + gate.id);
  }
  const receipt_gate_names = [];
  for (const gate of receipt.gates) {
    receipt_gate_names.push("" + gate.id);
  }
  rh.require(exact_values(required_gate_names, receipt_gate_names), "package_receipt_gate_set");

  const artifact_spec = rh.parse_file(artifact_manifest_path);
  const artifact_names = [];
  for (const executable of artifact_spec.executables) {
    artifact_names.push("" + executable.name);
  }
  const library_names = [];
  for (const library of artifact_spec.libraries) {
    library_names.push("" + library.name);
  }
  rh.require(artifact_names.length > 0, "package_artifact_manifest_empty");
  const unique = {};
  for (const executable of artifact_spec.executables) {
    const executable_name = "" + executable.name;
    rh.require(unique[executable_name] === undefined, "package_artifact_duplicate:" + executable_name);
    unique[executable_name] = true;
  }
  for (const library of artifact_spec.libraries) {
    const library_name = "" + library.name;
    rh.require(unique[library_name] === undefined, "package_artifact_duplicate:" + library_name);
    unique[library_name] = true;
  }
  const receipt_artifact_names = [];
  for (const executable of receipt.provenance.executables) {
    receipt_artifact_names.push("" + executable.name);
  }
  rh.require(exact_values(artifact_names, receipt_artifact_names), "package_receipt_artifact_set");
  const receipt_library_names = [];
  for (const library of receipt.provenance.libraries) {
    receipt_library_names.push("" + library.name);
  }
  rh.require(exact_values(library_names, receipt_library_names), "package_receipt_library_set");

  const metadata_path = rh.join(repo, "dist/agenterm.json");
  const metadata = rh.parse_file(metadata_path);
  rh.require(
    metadata.schema_version === 2
      && metadata.git_commit === head
      && !metadata.git_dirty
      && metadata.cargo_lock_sha256 === cargo_hash
      && metadata.artifact_manifest_sha256 === artifact_hash,
    "package_metadata_source_mismatch"
  );
  const metadata_artifact_names = [];
  for (const executable of metadata.executables) {
    metadata_artifact_names.push("" + executable.name);
  }
  rh.require(exact_values(artifact_names, metadata_artifact_names), "package_metadata_artifact_set");
  const metadata_library_names = [];
  for (const library of metadata.libraries) {
    metadata_library_names.push("" + library.name);
  }
  rh.require(exact_values(library_names, metadata_library_names), "package_metadata_library_set");

  const dist_root = rh.join(repo, "dist");
  const payload = [];
  for (const executable of artifact_spec.executables) {
    const name = "" + executable.name;
    const source = rh.join(dist_root, name);
    rh.require(is_file(source), "package_input_missing:" + source);
    const hash = rh.sha256_file(source);
    let receipt_hash = "";
    let receipt_count = 0;
    for (const receipt_executable of receipt.provenance.executables) {
      if (("" + receipt_executable.name) === name) {
        receipt_count = receipt_count + 1;
        receipt_hash = "" + receipt_executable.sha256;
      }
    }
    rh.require(receipt_count === 1, "package_receipt_artifact_duplicate:" + name);
    let metadata_hash = "";
    let metadata_count = 0;
    for (const metadata_executable of metadata.executables) {
      if (("" + metadata_executable.name) === name) {
        metadata_count = metadata_count + 1;
        metadata_hash = "" + metadata_executable.sha256;
      }
    }
    rh.require(metadata_count === 1, "package_metadata_artifact_duplicate:" + name);
    rh.require(receipt_hash === hash && metadata_hash === hash, "package_executable_hash:" + name);
    payload.push({ name: name, sha256: hash, path: source });
  }
  for (const library of artifact_spec.libraries) {
    const name = "" + library.name;
    const source = rh.join(dist_root, name);
    rh.require(is_file(source), "package_input_missing:" + source);
    const hash = rh.sha256_file(source);
    let receipt_hash = "";
    let receipt_count = 0;
    for (const receipt_library of receipt.provenance.libraries) {
      if (("" + receipt_library.name) === name) {
        receipt_count = receipt_count + 1;
        receipt_hash = "" + receipt_library.sha256;
      }
    }
    rh.require(receipt_count === 1, "package_receipt_library_duplicate:" + name);
    let metadata_hash = "";
    let metadata_count = 0;
    for (const metadata_library of metadata.libraries) {
      if (("" + metadata_library.name) === name) {
        metadata_count = metadata_count + 1;
        metadata_hash = "" + metadata_library.sha256;
      }
    }
    rh.require(metadata_count === 1, "package_metadata_library_duplicate:" + name);
    rh.require(receipt_hash === hash && metadata_hash === hash, "package_library_hash:" + name);
    payload.push({ name: name, sha256: hash, path: source });
  }

  const license_apache_path = rh.join(repo, "LICENSE-APACHE");
  const license_mit_path = rh.join(repo, "LICENSE-MIT");
  const notices_path = rh.join(repo, "THIRD_PARTY_NOTICES.md");
  rh.require(is_file(license_apache_path), "package_input_missing:" + license_apache_path);
  rh.require(is_file(license_mit_path), "package_input_missing:" + license_mit_path);
  rh.require(is_file(notices_path), "package_input_missing:" + notices_path);
  payload.push({ name: "agenterm.json", sha256: rh.sha256_file(metadata_path), path: metadata_path });
  payload.push({ name: "artifacts.json", sha256: rh.sha256_file(artifact_manifest_path), path: artifact_manifest_path });
  payload.push({ name: "qualification-receipt.json", sha256: rh.sha256_file(receipt_path), path: receipt_path });
  payload.push({ name: "agenterm-sbom.spdx.json", sha256: rh.sha256_file(sbom_path), path: sbom_path });
  payload.push({ name: "LICENSE-APACHE", sha256: rh.sha256_file(license_apache_path), path: license_apache_path });
  payload.push({ name: "LICENSE-MIT", sha256: rh.sha256_file(license_mit_path), path: license_mit_path });
  payload.push({ name: "THIRD_PARTY_NOTICES.md", sha256: rh.sha256_file(notices_path), path: notices_path });

  const version = "" + metadata.version;
  rh.require(valid_version(version), "package_version_invalid:" + version);
  const run_token = "" + rh.now_ms();
  const run_directory = rh.join(output_root, run_token);
  const staging = rh.join(run_directory, "staging");
  rh.create_dir_all(staging);

  const members = [];
  for (const entry of payload) {
    const entry_name = "" + entry.name;
    const entry_path = "" + entry.path;
    const entry_hash = "" + entry.sha256;
    const destination = rh.join(staging, entry_name);
    rh.copy(entry_path, destination);
    const destination_hash = rh.sha256_file(destination);
    rh.require(destination_hash === entry_hash, "package_payload_changed:" + entry_name);
    members.push(entry_name);
  }
  const receipt_file_hash = rh.sha256_file(receipt_path);
  const package_manifest = {
    schema_version: 1,
    dry_run: dry_run,
    product: "AgenTerm",
    version: version,
    qualified_head: head,
    qualification_receipt_sha256: receipt_file_hash,
    cargo_lock_sha256: cargo_hash,
    artifact_manifest_sha256: artifact_hash,
    sbom_sha256: sbom_hash,
    payload: payload
  };
  const staged_manifest = rh.join(staging, "package-manifest.json");
  rh.atomic_write(staged_manifest, rh.stringify_pretty(package_manifest) + "\n");
  members.push("package-manifest.json");
  let payload_uncompressed_bytes = rh.metadata(staged_manifest).len;
  for (const entry of payload) {
    payload_uncompressed_bytes = payload_uncompressed_bytes + rh.metadata("" + entry.path).len;
  }

  let archive_suffix = "";
  if (dry_run) { archive_suffix = "-dry-run"; }
  const archive_name = "agenterm-" + version + "-windows-x86_64" + archive_suffix + ".zip";
  const archive = rh.join(run_directory, archive_name);
  const zip = archive_command(["-a", "-c", "-f", archive, "-C", staging, "."], staging);
  if (zip.exit_code !== 0) { throw "package_zip_create"; }
  const external_manifest = rh.join(run_directory, "package-manifest.json");
  rh.copy(staged_manifest, external_manifest);
  const archive_hash = rh.sha256_file(archive);
  const archive_bytes = rh.metadata(archive).len;
  const result = {
    schema_version: 1,
    dry_run: dry_run,
    archive: archive_name,
    archive_sha256: archive_hash,
    payload_uncompressed_bytes: payload_uncompressed_bytes,
    archive_bytes: archive_bytes,
    package_manifest: "package-manifest.json",
    qualified_head: head
  };
  let result_name = "";
  if (dry_run) {
    result_name = "dry-run-result.json";
  } else {
    result_name = "release-result.json";
  }
  const result_path = run_directory + "/" + result_name;
  rh.atomic_write(result_path, rh.stringify_pretty(result) + "\n");
  if (rh.exists(staging)) {
    rh.try_remove_dir_all(staging);
    rh.require(!rh.exists(staging), "package_staging_cleanup:" + staging);
  }
  const latest_run_path = output_root + "/.latest-package-run";
  rh.atomic_write(latest_run_path, run_directory + "\n");
  return 0;
}

export function build_package(repo_value, receipt_value, output_value) {
  return build_package_mode(repo_value, receipt_value, output_value, true);
}

export function build_release_package(repo_value, receipt_value, output_value) {
  return build_package_mode(repo_value, receipt_value, output_value, false);
}
