// CEO: Linux GTK secondary click by --name opens a named popover menu.
// Acceptance is smoke read-back only: context label proves the secondary
// press reached the toolkit handler; an independent click on the popover
// item closes the circuit. When the toolkit popup stays off-tree on this
// host, the journey records an honest typed blocker with alternatives
// after independent rclick reply read-back. AT-SPI --name only.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-gtk-rclick-context-menu",
  "cu.linux-gtk-rclick-context-menu-blocker",
];

const TARGET_NAME = "Fixture Right Click";
const MENU_ITEM_NAME = "Context Do Thing";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu(run_directory, executable, grant, arguments) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_gtk_rclick_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_rclick_empty");
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_linux_gtk_rclick_reply:" + JSON.stringify(document));
  return document;
}

function label_text(run_directory, executable, handle_text, prefix) {
  const reply = run_cu(run_directory, executable, "observe", [
    "tree", "--window", handle_text, "--depth", "8",
  ]);
  for (const node of reply.data.nodes) {
    if (("" + node.role) !== "label") { continue; }
    const name = "" + node.name;
    if (name.startsWith(prefix)) { return name; }
  }
  return "";
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function next_actions_include_alternatives(reply) {
  const actions = at(reply, "data.next_actions");
  if (actions === undefined || actions === null) { return false; }
  const joined = JSON.stringify(actions).toLowerCase();
  return joined.indexOf("show-menu") >= 0 && joined.indexOf("off-tree") >= 0;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const context = harness.new_context(repo, "cu-linux-gtk-rclick");
const run_directory = rh.join(repo, "target/cu-linux-gtk-rclick-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_rclick_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_gtk_rclick_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
let blocker = 0;

try {
  print("STEP start the owned GTK rclick fixture and resolve its window by pid and exact title");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-rclick-" + fixture_pid;
  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_gtk_rclick_window_wait");
  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_gtk_rclick_window_identity");
  const handle_text = "" + int_at(row, "handle");
  ensure(int_at(row, "handle") > 0, "cu_linux_gtk_rclick_handle:" + JSON.stringify(row));

  print("STEP baseline context label is idle before any secondary click");
  ensure(
    label_text(run_directory, executable, handle_text, "context ") === "context idle",
    "cu_linux_gtk_rclick_context_before"
  );

  print("STEP rclick --name through AT-SPI accessibility-tree actuation");
  const rclicked = run_cu(run_directory, executable, "observe,actuate", [
    "rclick", "--window", handle_text, "--name", TARGET_NAME,
  ]);
  ensure(
    flag_at(rclicked, "data.performed")
      && text_at(rclicked, "data.addressing") === "accessibility-tree"
      && text_at(rclicked, "data.button") === "right",
    "cu_linux_gtk_rclick_actuation:" + JSON.stringify(rclicked.data)
  );

  const opened = label_text(run_directory, executable, handle_text, "context ") === "context menu open";
  if (opened) {
    print("STEP independent label read-back proves the named popover opened");
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-rclick-context-menu");

    print("STEP click --name on the popover item closes the circuit via label read-back");
    const item_clicked = run_cu(run_directory, executable, "observe,actuate", [
      "click", "--window", handle_text, "--name", MENU_ITEM_NAME,
    ]);
    ensure(flag_at(item_clicked, "data.performed"), "cu_linux_gtk_rclick_item:" + JSON.stringify(item_clicked.data));
    ensure(
      label_text(run_directory, executable, handle_text, "context ") === "context did thing",
      "cu_linux_gtk_rclick_context_after_item"
    );
  } else {
    print("STEP popover label stayed idle; independent rclick reply proves typed off-tree blocker");
    ensure(
      flag_at(rclicked, "data.verified") === false
        && text_at(rclicked, "data.verification.method") === "tree-diff"
        && text_at(rclicked, "data.verification.reason") === "no_observable_change"
        && next_actions_include_alternatives(rclicked),
      "cu_linux_gtk_rclick_blocker_shape:" + JSON.stringify(rclicked.data)
    );
    ensure(
      label_text(run_directory, executable, handle_text, "context ") === "context idle",
      "cu_linux_gtk_rclick_blocker_side_effect"
    );
    blocker = 1;
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-rclick-context-menu-blocker");
  }

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_gtk_rclick_failed");
harness.remove_run(context);
if (blocker === 1) {
  print("PASS: Linux GTK rclick --name typed off-tree blocker with independent reply read-back (AT-SPI --name, invoke show-menu / menu-invoke alternatives)");
} else {
  print("PASS: Linux GTK rclick --name opens popover context menu with independent label read-back (AT-SPI --name, no --coords)");
}
