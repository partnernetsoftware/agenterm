// CEO: Linux GTK secondary click by --name opens a named popover menu.
// Acceptance is smoke read-back only: independent pyatspi context-label and
// desktop menu-item probes prove the secondary press reached the toolkit
// handler and that the named popover item is observable; an independent
// click on that item closes the circuit via pyatspi label read-back. When
// the toolkit popup stays off-tree on this host, the journey records an
// honest typed blocker with alternatives after independent rclick reply
// read-back and pyatspi context-label honesty. Typed rclick/click usage and
// host-limit paths must hold when --window/--name are missing or the AT-SPI
// bus is unavailable; typed get-extents --name usage/host-limit paths must
// hold before the native actuate/read-back court. AT-SPI --name only.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-gtk-rclick-context-menu",
  "cu.linux-gtk-rclick-context-menu-blocker",
];

const TARGET_NAME = "Fixture Right Click";
const MENU_ITEM_NAME = "Context Do Thing";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_rclick_empty_reply:" + output.stderr + output.stdout);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(document), "cu_linux_gtk_rclick_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_rclick_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_rclick_usage_limit(run_directory, executable) {
  const rclick_missing = run_cu_reply(run_directory, executable, "observe,actuate", [
    "rclick", "--window", "1",
  ]);
  ensure(!output_success(rclick_missing), "cu_linux_gtk_rclick_usage_ok:" + JSON.stringify(rclick_missing));
  ensure(
    text_at(rclick_missing, "error.code") === "invalid_input",
    "cu_linux_gtk_rclick_usage_code:" + JSON.stringify(rclick_missing.error)
  );
  ensure(
    text_at(rclick_missing, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_rclick_usage_message:" + JSON.stringify(rclick_missing.error)
  );

  const rclick_zero = run_cu_reply(run_directory, executable, "observe,actuate", [
    "rclick", "--window", "0", "--name", TARGET_NAME,
  ]);
  ensure(!output_success(rclick_zero), "cu_linux_gtk_rclick_zero_ok:" + JSON.stringify(rclick_zero));
  ensure(
    text_at(rclick_zero, "error.code") === "invalid_input",
    "cu_linux_gtk_rclick_zero_code:" + JSON.stringify(rclick_zero.error)
  );
  ensure(
    text_at(rclick_zero, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_rclick_zero_message:" + JSON.stringify(rclick_zero.error)
  );

  const click_missing = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", "1",
  ]);
  ensure(!output_success(click_missing), "cu_linux_gtk_rclick_click_usage_ok:" + JSON.stringify(click_missing));
  ensure(
    text_at(click_missing, "error.code") === "invalid_input",
    "cu_linux_gtk_rclick_click_usage_code:" + JSON.stringify(click_missing.error)
  );
  ensure(
    text_at(click_missing, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_rclick_click_usage_message:" + JSON.stringify(click_missing.error)
  );

  const click_zero = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", "0", "--name", MENU_ITEM_NAME,
  ]);
  ensure(!output_success(click_zero), "cu_linux_gtk_rclick_click_zero_ok:" + JSON.stringify(click_zero));
  ensure(
    text_at(click_zero, "error.code") === "invalid_input",
    "cu_linux_gtk_rclick_click_zero_code:" + JSON.stringify(click_zero.error)
  );
  ensure(
    text_at(click_zero, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_rclick_click_zero_message:" + JSON.stringify(click_zero.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", TARGET_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_gtk_rclick_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_rclick_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_gtk_rclick_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", TARGET_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_gtk_rclick_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_gtk_rclick_extents_unavailable_code:" + code
  );
}

function assert_rclick_host_limit_when_atspi_absent(run_directory, executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
  const rclick_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "rclick", "--window", "1", "--name", TARGET_NAME,
  ], env);
  ensure(!output_success(rclick_reply), "cu_linux_gtk_rclick_unavailable_ok:" + JSON.stringify(rclick_reply));
  const rclick_code = text_at(rclick_reply, "error.code");
  ensure(
    rclick_code === "a11y_backend_failed" || rclick_code === "unsupported" || rclick_code === "bad_handle",
    "cu_linux_gtk_rclick_unavailable_code:" + rclick_code
  );

  const click_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", "1", "--name", MENU_ITEM_NAME,
  ], env);
  ensure(!output_success(click_reply), "cu_linux_gtk_rclick_click_unavailable_ok:" + JSON.stringify(click_reply));
  const click_code = text_at(click_reply, "error.code");
  ensure(
    click_code === "a11y_backend_failed" || click_code === "unsupported" || click_code === "bad_handle",
    "cu_linux_gtk_rclick_click_unavailable_code:" + click_code
  );
}

function label_text(run_directory, executable, handle_text, prefix) {
  const reply = run_cu(run_directory, executable, "observe", [
    "tree", "--window", handle_text, "--depth", "8",
  ]);
  for (const node of reply.data.nodes) {
    if (("" + node.role) !== "label") { continue; }
    const name = "" + node.name;
    if (name.startsWith(prefix)) { return name; }
  }
  return "";
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function next_actions_include_alternatives(reply) {
  const actions = at(reply, "data.next_actions");
  if (actions === undefined || actions === null) { return false; }
  const joined = JSON.stringify(actions).toLowerCase();
  return joined.indexOf("show-menu") >= 0 && joined.indexOf("off-tree") >= 0;
}

function independent_pyatspi_probe(run_directory, executable, fixture_title, mode, expected) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "mode = sys.argv[2]",
    "expected = sys.argv[3] if len(sys.argv) > 3 else ''",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and w.name == title:",
    "                return w",
    "    return None",
    "def walk_context(node):",
    "    if node is None:",
    "        return None",
    "    name = node.name or ''",
    "    if name.startswith('context '):",
    "        return name",
    "    for k in range(node.childCount):",
    "        hit = walk_context(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "def walk_named(node, want):",
    "    if node is None:",
    "        return None",
    "    if (node.name or '') == want:",
    "        try:",
    "            role = pyatspi.role.getLocalizedRoleName(node).lower()",
    "        except Exception:",
    "            role = str(node.getRole()).lower()",
    "        return role",
    "    for k in range(node.childCount):",
    "        hit = walk_named(node.getChildAtIndex(k), want)",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "def named_on_desktop(want):",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        hit = walk_named(app, want)",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "if mode == 'context_label':",
    "    frame = find_frame()",
    "    if frame is None:",
    "        raise SystemExit('cu_linux_gtk_rclick_atspi_no_frame')",
    "    value = walk_context(frame)",
    "    if value is None:",
    "        raise SystemExit('cu_linux_gtk_rclick_atspi_context_miss')",
    "    if expected and value != expected:",
    "        raise SystemExit('cu_linux_gtk_rclick_atspi_context_mismatch:' + value + ':' + expected)",
    "    print(json.dumps({'mode': mode, 'value': value}))",
    "elif mode == 'named_desktop':",
    "    role = named_on_desktop(expected)",
    "    print(json.dumps({'mode': mode, 'present': role is not None, 'role': role or ''}))",
    "else:",
    "    raise SystemExit('cu_linux_gtk_rclick_atspi_mode:' + mode)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, fixture_title, mode, expected], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_gtk_rclick_pyatspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function wait_pyatspi_context_label(run_directory, executable, fixture_title, expected) {
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    const probe = independent_pyatspi_probe(run_directory, executable, fixture_title, "context_label", "");
    if (probe.value === expected) { return probe; }
    harness.sleep_ms(100);
  }
  const last = independent_pyatspi_probe(run_directory, executable, fixture_title, "context_label", "");
  ensure(last.value === expected, "cu_linux_gtk_rclick_pyatspi_label:" + last.value + ":" + expected);
  return last;
}

function wait_pyatspi_menu_item(run_directory, executable, want) {
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    const probe = independent_pyatspi_probe(run_directory, executable, "", "named_desktop", want);
    if (probe.present === true) { return probe; }
    harness.sleep_ms(100);
  }
  const last = independent_pyatspi_probe(run_directory, executable, "", "named_desktop", want);
  ensure(last.present === true, "cu_linux_gtk_rclick_pyatspi_menu:" + JSON.stringify(last));
  return last;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_gtk_rclick_executable_missing");
const context = harness.new_context(repo, "cu-linux-gtk-rclick");
const run_directory = rh.join(repo, "target/cu-linux-gtk-rclick-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_rclick_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_gtk_rclick_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
let blocker = 0;

try {
  print("STEP rclick/click typed-fail usage when --window or --name is missing");
  assert_rclick_usage_limit(run_directory, executable);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before actuate/read-back court");
    assert_get_extents_usage_limit(run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
  }

  if (!atspi_available) {
    print("STEP rclick/click typed-fail host-limit when independent pyatspi desktop probe is unavailable");
    assert_rclick_host_limit_when_atspi_absent(run_directory, executable);
    succeeded = 1;
  } else {
    print("STEP start the owned GTK rclick fixture and resolve its window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-rclick-" + fixture_pid;
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_gtk_rclick_window_wait");
    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_gtk_rclick_window_identity");
    const handle_text = "" + int_at(row, "handle");
    ensure(int_at(row, "handle") > 0, "cu_linux_gtk_rclick_handle:" + JSON.stringify(row));

    print("STEP baseline context label is idle before any secondary click");
    ensure(
      label_text(run_directory, executable, handle_text, "context ") === "context idle",
      "cu_linux_gtk_rclick_context_before"
    );
    ensure(
      independent_pyatspi_probe(run_directory, executable, fixture_title, "context_label", "context idle").value
        === "context idle",
      "cu_linux_gtk_rclick_pyatspi_before"
    );

    print("STEP rclick --name through AT-SPI accessibility-tree actuation");
    const rclicked = run_cu(run_directory, executable, "observe,actuate", [
      "rclick", "--window", handle_text, "--name", TARGET_NAME,
    ]);
    ensure(
      flag_at(rclicked, "data.performed")
        && text_at(rclicked, "data.addressing") === "accessibility-tree"
        && text_at(rclicked, "data.button") === "right",
      "cu_linux_gtk_rclick_actuation:" + JSON.stringify(rclicked.data)
    );

    const opened = label_text(run_directory, executable, handle_text, "context ") === "context menu open";
    if (opened) {
      print("STEP independent pyatspi context-label and menu-item read-back prove the popover opened");
      const pyatspi_open_label = wait_pyatspi_context_label(
        run_directory, executable, fixture_title, "context menu open"
      );
      ensure(
        pyatspi_open_label.value === "context menu open",
        "cu_linux_gtk_rclick_pyatspi_open:" + JSON.stringify(pyatspi_open_label)
      );
      const pyatspi_menu = wait_pyatspi_menu_item(run_directory, executable, MENU_ITEM_NAME);
      ensure(
        pyatspi_menu.present === true && ("" + pyatspi_menu.role).indexOf("menu") >= 0,
        "cu_linux_gtk_rclick_pyatspi_menu_role:" + JSON.stringify(pyatspi_menu)
      );
      harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-rclick-context-menu");

      print("STEP click --name on the popover item closes the circuit via pyatspi label read-back");
      const item_clicked = run_cu(run_directory, executable, "observe,actuate", [
        "click", "--window", handle_text, "--name", MENU_ITEM_NAME,
      ]);
      ensure(flag_at(item_clicked, "data.performed"), "cu_linux_gtk_rclick_item:" + JSON.stringify(item_clicked.data));
      const pyatspi_after_item = wait_pyatspi_context_label(
        run_directory, executable, fixture_title, "context did thing"
      );
      ensure(
        pyatspi_after_item.value === "context did thing",
        "cu_linux_gtk_rclick_pyatspi_after_item:" + JSON.stringify(pyatspi_after_item)
      );
      ensure(
        label_text(run_directory, executable, handle_text, "context ") === "context did thing",
        "cu_linux_gtk_rclick_context_after_item"
      );
    } else {
      print("STEP popover label stayed idle; independent rclick reply proves typed off-tree blocker");
      ensure(
        flag_at(rclicked, "data.verified") === false
          && text_at(rclicked, "data.verification.method") === "tree-diff"
          && text_at(rclicked, "data.verification.reason") === "no_observable_change"
          && next_actions_include_alternatives(rclicked),
        "cu_linux_gtk_rclick_blocker_shape:" + JSON.stringify(rclicked.data)
      );
      ensure(
        label_text(run_directory, executable, handle_text, "context ") === "context idle",
        "cu_linux_gtk_rclick_blocker_side_effect"
      );
      ensure(
        independent_pyatspi_probe(run_directory, executable, fixture_title, "context_label", "context idle").value
          === "context idle",
        "cu_linux_gtk_rclick_pyatspi_blocker_label"
      );
      blocker = 1;
      harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-rclick-context-menu-blocker");
    }

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_gtk_rclick_failed");
harness.remove_run(context);
if (blocker === 1) {
  print("PASS: Linux GTK rclick --name typed off-tree blocker with independent reply and pyatspi label read-back and typed rclick/click/get-extents usage honesty (AT-SPI --name, invoke show-menu / menu-invoke alternatives)");
} else if (atspi_available) {
  print("PASS: Linux GTK rclick --name opens popover context menu with independent pyatspi menu and label read-back and typed rclick/click/get-extents usage honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux GTK rclick/click typed-fails with typed get-extents host-limit honesty when independent pyatspi desktop probe is unavailable");
}
