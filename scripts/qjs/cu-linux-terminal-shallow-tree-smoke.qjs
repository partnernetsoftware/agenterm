// CEO: Linux terminal_a11y_shallow_tree host-limit honesty with independent read-back.
// When xfce4-terminal is available, launch it without AT-SPI registration
// (GTK_A11Y=none, NO_AT_BRIDGE=1) so tree --window reports visited=1 frame
// fallback and term-read/term-send/term-wait typed-fail terminal_buffer_not_found
// on the same handle. terminal-list must typed-fail control_unavailable with
// AgenTerm sock host-limit and independent absent-socket proof before any shallow
// terminal fixture exists; terminal-list/term-read/term-send/term-wait/tree/query
// usage must reject AT-SPI --name and other unexpected arguments; typed
// get-extents --name usage/host-limit paths must hold before the native read-back
// court. query --role terminal must honestly return zero matches; get-text
// --name on the frame title must typed-fail a11y_text_unavailable. Capabilities
// and doctor must document the shallow frame plus pty-* / terminal-* alternatives.
// Independent pyatspi must find zero application roots for the terminal pid;
// independent xprop _NET_WM_NAME
// and xwininfo Map State must agree with the frame-only tree name on the same
// handle. AT-SPI/--name only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-terminal-shallow-tree-readback",
];

const AT_SPI_PROBE_NAME = "Terminal Shallow Tree Court Anchor";

const SHALLOW_PROBE_SCRIPT = [
  "import json, os, pyatspi, sys",
  "pid = int(sys.argv[1])",
  "desktop = pyatspi.Registry.getDesktop(0)",
  "registered = 0",
  "for i in range(desktop.childCount):",
  "    child = desktop.getChildAtIndex(i)",
  "    try:",
  "        if child.get_process_id() == pid:",
  "            registered += 1",
  "    except Exception:",
  "        pass",
  "alive = os.path.exists(f'/proc/{pid}')",
  "print(json.dumps({'registered_apps': registered, 'proc_alive': alive}))",
].join("\n");

const FRAME_READBACK_SCRIPT = [
  "import json, subprocess, sys",
  "handle = sys.argv[1]",
  "title = sys.argv[2]",
  "xprop = subprocess.run(['xprop', '-id', handle, '_NET_WM_NAME'], capture_output=True, text=True)",
  "name = ''",
  "if xprop.returncode == 0:",
  "    marker = ' = \"'",
  "    idx = xprop.stdout.find(marker)",
  "    if idx >= 0:",
  "        start = idx + len(marker)",
  "        end = xprop.stdout.find('\"', start)",
  "        if end >= 0:",
  "            name = xprop.stdout[start:end]",
  "xwin = subprocess.run(['xwininfo', '-id', handle], capture_output=True, text=True)",
  "viewable = False",
  "if xwin.returncode == 0:",
  "    for line in xwin.stdout.splitlines():",
  "        if 'Map State:' in line and 'IsViewable' in line:",
  "            viewable = True",
  "if name != title:",
  "    raise SystemExit(f'cu_linux_terminal_shallow_tree_frame_name:{name}:{title}')",
  "if not viewable:",
  "    raise SystemExit('cu_linux_terminal_shallow_tree_frame_viewable')",
  "print(json.dumps({'name': name, 'viewable': viewable}))",
].join("\n");

const SOCKET_ABSENT_SCRIPT = [
  "import os, socket, sys",
  "path = sys.argv[1]",
  "if os.path.exists(path):",
  "    try:",
  "        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)",
  "        conn.settimeout(0.2)",
  "        conn.connect(path)",
  "    except OSError:",
  "        raise SystemExit(0)",
  "    raise SystemExit(f'independent socket still accepts connections: {path}')",
  "if os.path.exists(path):",
  "    raise SystemExit(f'independent socket path still present: {path}')",
].join("\n");

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable, context, shallow) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_INSTANCE_DIR: context.instance_directory,
    AGENTERM_WORKSPACE_PATH: context.workspace_path,
    AGENTERM_SETTINGS_PATH: context.settings_path,
    AGENTERM_INSTANCE: "ephemeral:cu-linux-terminal-shallow-" + context.run_id,
  };
  if (shallow === true) {
    env.GTK_A11Y = "none";
    env.NO_AT_BRIDGE = "1";
  }
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, context, shallow, arguments, grant, env) {
  const argv = ["--target", "current", "--grant", grant === undefined ? "observe" : grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable, context, shallow) : env,
    timeout_ms: 120000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_terminal_shallow_tree_empty:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, context, shallow, arguments, grant) {
  const document = run_cu_reply(run_directory, executable, context, shallow, arguments, grant);
  ensure(flag_at(document, "ok"),
    "cu_linux_terminal_shallow_tree_reply:" + JSON.stringify(document));
  return document;
}

function cu_env_allow_foreground(executable, context, shallow) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_INSTANCE_DIR: context.instance_directory,
    AGENTERM_WORKSPACE_PATH: context.workspace_path,
    AGENTERM_SETTINGS_PATH: context.settings_path,
    AGENTERM_INSTANCE: "ephemeral:cu-linux-terminal-shallow-" + context.run_id,
  };
  if (shallow === true) {
    env.GTK_A11Y = "none";
    env.NO_AT_BRIDGE = "1";
  }
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_expect_error(run_directory, executable, context, shallow, arguments, expected_code, grant, env) {
  const document = run_cu_reply(run_directory, executable, context, shallow, arguments, grant, env);
  ensure(
    flag_at(document, "ok") !== true
      && text_at(document, "error.code") === expected_code,
    "cu_linux_terminal_shallow_tree_error_reply:" + JSON.stringify(document)
  );
  return document;
}

function windows_rows(reply) {
  const data = at(reply, "data");
  return data.windows === undefined ? data : data.windows;
}

function window_row_for_pid(run_directory, executable, context, pid, title) {
  const reply = run_cu(run_directory, executable, context, true, [
    "windows", "--pid", "" + pid,
  ]);
  const rows = windows_rows(reply);
  ensure(Array.isArray(rows) && rows.length >= 1,
    "cu_linux_terminal_shallow_tree_pid_rows:" + JSON.stringify(rows));
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  throw "cu_linux_terminal_shallow_tree_pid_title:" + JSON.stringify(rows);
}

function run_cu_or_doctor(run_directory, executable, context, arguments) {
  const document = run_cu_reply(run_directory, executable, context, false, arguments);
  ensure(
    document.ok === true
      || (document.error !== undefined && document.error.code === "doctor_not_ready"),
    "cu_linux_terminal_shallow_tree_doctor_reply:" + JSON.stringify(document)
  );
  const report = doctor_report(document);
  ensure(
    (text_at(report, "status") === "ready") === (flag_at(document, "ok") === true),
    "cu_linux_terminal_shallow_tree_doctor_exit:" + text_at(report, "status")
      + ":" + JSON.stringify(document)
  );
  return document;
}

function doctor_report(reply) {
  if (reply.ok === true) { return reply.data; }
  return at(reply, "error.detail.report");
}

function assert_hint(hint, label) {
  ensure(text_at(hint, "limit") === "host", label + "_limit:" + JSON.stringify(hint));
  ensure(
    text_at(hint, "signal").indexOf("visited=1") >= 0,
    label + "_signal:" + JSON.stringify(hint)
  );
  const alternatives = at(hint, "alternatives");
  ensure(Array.isArray(alternatives) && alternatives.length >= 2,
    label + "_alternatives:" + JSON.stringify(hint));
  const joined = alternatives.join(" ");
  ensure(joined.indexOf("pty-") >= 0 && joined.indexOf("terminal-") >= 0,
    label + "_pty_terminal:" + joined);
}

function invoke_get_extents_reply(run_directory, executable, context, shallow, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable, context, shallow) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_terminal_shallow_tree_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable, context) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable, context, false),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_atspi_name(message) {
  return message.indexOf("--name") >= 0
    || message.indexOf("unexpected") >= 0
    || message.indexOf("exactly one text argument") >= 0;
}

function assert_get_extents_usage_limit(run_directory, executable, context) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, context, false, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(!output_success(zero_handle),
    "cu_linux_terminal_shallow_tree_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_terminal_shallow_tree_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_terminal_shallow_tree_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, null, false, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_terminal_shallow_tree_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_terminal_shallow_tree_extents_unavailable_code:" + code
  );
}

function assert_tree_usage_limit(run_directory, executable, context) {
  const reply = run_cu_reply(run_directory, executable, context, false, [
    "tree", "--window", "1",
    "--depth", "8",
    "--max-nodes", "300",
    "--flat",
    "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === "usage",
    "cu_linux_terminal_shallow_tree_tree_usage:" + JSON.stringify(reply)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_terminal_shallow_tree_tree_usage_command:" + JSON.stringify(reply)
  );
  ensure(
    usage_rejects_atspi_name(text_at(reply, "error.message")),
    "cu_linux_terminal_shallow_tree_tree_usage_message:" + JSON.stringify(reply.error)
  );
}

function assert_query_usage_limit(run_directory, executable, context) {
  const reply = run_cu_reply(run_directory, executable, context, false, [
    "query", "--window", "1", "--role", "terminal",
    "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === "usage",
    "cu_linux_terminal_shallow_tree_query_usage:" + JSON.stringify(reply)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_terminal_shallow_tree_query_usage_command:" + JSON.stringify(reply)
  );
  ensure(
    usage_rejects_atspi_name(text_at(reply, "error.message")),
    "cu_linux_terminal_shallow_tree_query_usage_message:" + JSON.stringify(reply.error)
  );
}

function assert_term_send_usage_limit(run_directory, executable, context) {
  const flat_with_name = run_cu_reply(run_directory, executable, context, false, [
    "term-send", "1", "--foreground", "--name", AT_SPI_PROBE_NAME, "--", "hello",
  ], "observe,actuate");
  ensure(!output_success(flat_with_name),
    "cu_linux_terminal_shallow_tree_term_send_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_terminal_shallow_tree_term_send_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_terminal_shallow_tree_term_send_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    usage_rejects_atspi_name(text_at(flat_with_name, "error.message")),
    "cu_linux_terminal_shallow_tree_term_send_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = run_cu_reply(run_directory, executable, context, false, [
    "term", "send", "1", "--foreground", "--name", AT_SPI_PROBE_NAME, "--", "hello",
  ], "observe,actuate");
  ensure(!output_success(grouped_with_name),
    "cu_linux_terminal_shallow_tree_term_send_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_terminal_shallow_tree_term_send_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    usage_rejects_atspi_name(text_at(grouped_with_name, "error.message")),
    "cu_linux_terminal_shallow_tree_term_send_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, context, false, [
    "term-send", "1", "--foreground", "--bogus", "--", "hello",
  ], "observe,actuate");
  ensure(!output_success(with_bogus),
    "cu_linux_terminal_shallow_tree_term_send_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_terminal_shallow_tree_term_send_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("unexpected") >= 0
      || text_at(with_bogus, "error.message").indexOf("--bogus") >= 0
      || usage_rejects_atspi_name(text_at(with_bogus, "error.message")),
    "cu_linux_terminal_shallow_tree_term_send_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_term_wait_usage_limit(run_directory, executable, context) {
  const flat_with_name = run_cu_reply(run_directory, executable, context, false, [
    "term-wait", "1", "decoy", "--timeout-ms", "1000",
    "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(!output_success(flat_with_name),
    "cu_linux_terminal_shallow_tree_term_wait_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_terminal_shallow_tree_term_wait_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_terminal_shallow_tree_term_wait_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    usage_rejects_atspi_name(text_at(flat_with_name, "error.message")),
    "cu_linux_terminal_shallow_tree_term_wait_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = run_cu_reply(run_directory, executable, context, false, [
    "term", "wait", "1", "decoy", "--timeout-ms", "1000",
    "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(!output_success(grouped_with_name),
    "cu_linux_terminal_shallow_tree_term_wait_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_terminal_shallow_tree_term_wait_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    usage_rejects_atspi_name(text_at(grouped_with_name, "error.message")),
    "cu_linux_terminal_shallow_tree_term_wait_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, context, false, [
    "term-wait", "1", "decoy", "--timeout-ms", "1000", "--bogus",
  ]);
  ensure(!output_success(with_bogus),
    "cu_linux_terminal_shallow_tree_term_wait_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_terminal_shallow_tree_term_wait_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("unexpected") >= 0
      || text_at(with_bogus, "error.message").indexOf("--bogus") >= 0
      || usage_rejects_atspi_name(text_at(with_bogus, "error.message")),
    "cu_linux_terminal_shallow_tree_term_wait_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_term_read_usage_limit_early(run_directory, executable, context) {
  const flat_with_name = run_cu_reply(run_directory, executable, context, false, [
    "term-read", "1", "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(
    !output_success(flat_with_name) && text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_terminal_shallow_tree_term_read_flat_name:" + JSON.stringify(flat_with_name)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_terminal_shallow_tree_term_read_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    usage_rejects_atspi_name(text_at(flat_with_name, "error.message")),
    "cu_linux_terminal_shallow_tree_term_read_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = run_cu_reply(run_directory, executable, context, false, [
    "term", "read", "1", "--name", AT_SPI_PROBE_NAME,
  ]);
  ensure(
    !output_success(grouped_with_name) && text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_terminal_shallow_tree_term_read_grouped_name:" + JSON.stringify(grouped_with_name)
  );
  ensure(
    usage_rejects_atspi_name(text_at(grouped_with_name, "error.message")),
    "cu_linux_terminal_shallow_tree_term_read_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );
}

function assert_terminal_list_usage_limit(run_directory, executable, context) {
  for (const arguments of [
    ["terminal-list", "--bogus"],
    ["terminal-list", "--name", "decoy"],
  ]) {
    const reply = run_cu_reply(run_directory, executable, context, false, arguments);
    ensure(
      flag_at(reply, "ok") !== true && text_at(reply, "error.code") === "usage",
      "cu_linux_terminal_shallow_tree_terminal_list_usage:" + JSON.stringify(reply)
    );
    ensure(
      text_at(reply, "command") === "usage",
      "cu_linux_terminal_shallow_tree_terminal_list_usage_command:" + JSON.stringify(reply)
    );
    const message = text_at(reply, "error.message");
    ensure(
      message.indexOf("unexpected") >= 0,
      "cu_linux_terminal_shallow_tree_terminal_list_usage_message:" + message
    );
  }
}

function assert_term_read_usage_limit(run_directory, executable, context, shallow, handle) {
  const reply = run_cu_reply(run_directory, executable, context, shallow, [
    "term-read", "" + handle, "--name", "decoy",
  ]);
  ensure(
    flag_at(reply, "ok") !== true && text_at(reply, "error.code") === "usage",
    "cu_linux_terminal_shallow_tree_term_read_usage:" + JSON.stringify(reply)
  );
  ensure(
    text_at(reply, "error.message").indexOf("--name") >= 0
      || text_at(reply, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_terminal_shallow_tree_term_read_usage_message:" + JSON.stringify(reply.error)
  );
}

function assert_terminal_buffer_host_limit(detail, label) {
  ensure(text_at(detail, "limit") === "host",
    label + "_limit:" + JSON.stringify(detail));
  ensure(text_at(detail, "group") === "terminal",
    label + "_group:" + JSON.stringify(detail));
  ensure(text_at(detail, "mechanism") === "at-spi2-window-frame-fallback",
    label + "_mechanism:" + JSON.stringify(detail));
  ensure(
    text_at(detail, "signal").indexOf("visited=1") >= 0,
    label + "_signal:" + JSON.stringify(detail)
  );
  ensure(int_at(detail, "tree.visited") === 1,
    label + "_tree:" + JSON.stringify(detail));
  const alternatives = at(detail, "alternatives");
  ensure(Array.isArray(alternatives) && alternatives.length >= 2,
    label + "_alternatives:" + JSON.stringify(detail));
  const joined = alternatives.join(" ");
  ensure(joined.indexOf("pty-") >= 0 && joined.indexOf("terminal-") >= 0,
    label + "_pty_terminal:" + joined);
}

function assert_terminal_sock_host_limit(reply) {
  ensure(
    flag_at(reply, "ok") !== true && text_at(reply, "error.code") === "control_unavailable",
    "cu_linux_terminal_shallow_tree_sock_code:" + JSON.stringify(reply)
  );
  const detail = at(reply, "error.detail");
  ensure(
    text_at(detail, "control") === "unavailable"
      && text_at(detail, "authority") === "unreachable"
      && text_at(detail, "limit") === "host"
      && text_at(detail, "group") === "terminal"
      && text_at(detail, "mechanism") === "agenterm-unix-control-socket",
    "cu_linux_terminal_shallow_tree_sock_detail:" + JSON.stringify(detail)
  );
  const alternatives = at(detail, "alternatives");
  ensure(
    Array.isArray(alternatives) && alternatives.length >= 2,
    "cu_linux_terminal_shallow_tree_sock_alternatives:" + JSON.stringify(detail)
  );
  const joined = alternatives.join(" ");
  ensure(
    joined.indexOf("agenterm server") >= 0 && joined.indexOf("pty-start") >= 0,
    "cu_linux_terminal_shallow_tree_sock_alternative_text:" + joined
  );
  const transport = text_at(detail, "transport");
  ensure(
    transport.indexOf("IPC transport Io for unix:") === 0
      && transport.indexOf(".sock") >= 0,
    "cu_linux_terminal_shallow_tree_sock_transport:" + transport
  );
}

function socket_path_from_transport(reply) {
  const transport = text_at(at(reply, "error.detail"), "transport");
  const prefix = "IPC transport Io for unix:";
  ensure(transport.indexOf(prefix) === 0,
    "cu_linux_terminal_shallow_tree_sock_transport_prefix:" + transport);
  const rest = transport.slice(prefix.length);
  const sock_end = rest.indexOf(".sock:");
  ensure(sock_end >= 0,
    "cu_linux_terminal_shallow_tree_sock_transport_suffix:" + transport);
  return rest.slice(0, sock_end + 5);
}

function independent_socket_absent(run_directory, executable, context, socket_path) {
  const output = rh.command("python3", ["-c", SOCKET_ABSENT_SCRIPT, socket_path], {
    cwd: run_directory,
    env: cu_env(executable, context, false),
    timeout_ms: 10000,
  });
  ensure(output.success === true,
    "cu_linux_terminal_shallow_tree_sock_absent:" + output.stderr + output.stdout);
}

function independent_frame_readback(run_directory, executable, context, handle, title) {
  const output = rh.command("python3", [
    "-c", FRAME_READBACK_SCRIPT, "" + handle, title,
  ], {
    cwd: run_directory,
    env: cu_env(executable, context, true),
    timeout_ms: 15000,
  });
  ensure(output.success === true,
    "cu_linux_terminal_shallow_tree_frame_readback:" + output.stderr + output.stdout);
  const document = JSON.parse(output.stdout.trim());
  ensure(document.name === title && document.viewable === true,
    "cu_linux_terminal_shallow_tree_frame_readback_shape:" + JSON.stringify(document));
  return document;
}

function independent_shallow_probe(executable, context, pid) {
  const output = rh.command("python3", ["-c", SHALLOW_PROBE_SCRIPT, "" + pid], {
    env: cu_env(executable, context, true),
    timeout_ms: 30000,
  });
  ensure(output.success === true,
    "cu_linux_terminal_shallow_tree_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function xfce4_terminal_available() {
  const output = rh.command("sh", ["-c", "command -v xfce4-terminal"], {
    timeout_ms: 5000,
  });
  return output.success === true && output.stdout.trim() !== "";
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "missing_agenterm_cu:" + executable);
ensure(direct_file(abi_library), "missing_agenterm_abi:" + abi_library);
ensure(xfce4_terminal_available(), "cu_linux_terminal_shallow_tree_missing_xfce4_terminal");

const context = harness.new_context(repo, "cu-linux-terminal-shallow-tree");
const atspi_available = probe_atspi_available(executable, context);
let terminal_pid = 0;
let terminal = -1;
let succeeded = 0;
let failure = "";
try {
  print("STEP terminal-list typed-fails usage on unexpected arguments before shallow terminal fixture");
  assert_terminal_list_usage_limit(context.run_directory, executable, context);

  print("STEP term-read/term-send/term-wait/tree/query typed-fail usage when AT-SPI --name or other unexpected arguments are present");
  assert_term_read_usage_limit_early(context.run_directory, executable, context);
  assert_term_send_usage_limit(context.run_directory, executable, context);
  assert_term_wait_usage_limit(context.run_directory, executable, context);
  assert_tree_usage_limit(context.run_directory, executable, context);
  assert_query_usage_limit(context.run_directory, executable, context);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before native read-back court");
    assert_get_extents_usage_limit(context.run_directory, executable, context);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP terminal-list typed-fails control_unavailable with AgenTerm sock host-limit before shallow terminal fixture");
  const missing_terminal = run_cu_reply(
    context.run_directory, executable, context, false, ["terminal-list"]
  );
  assert_terminal_sock_host_limit(missing_terminal);
  const absent_socket = socket_path_from_transport(missing_terminal);
  independent_socket_absent(context.run_directory, executable, context, absent_socket);

  print("STEP capabilities and doctor document terminal_a11y_shallow_tree host limit and alternatives");
  const capabilities = run_cu(context.run_directory, executable, context, false, ["capabilities"]);
  const gap = text_at(capabilities, "data.gaps.terminal_a11y_shallow_tree");
  ensure(gap.indexOf("visited=1") >= 0 && gap.indexOf("pty-") >= 0 && gap.indexOf("terminal-") >= 0,
    "cu_linux_terminal_shallow_tree_gap:" + gap);
  assert_hint(at(capabilities, "data.verbs.tree.host_shallow_terminal_tree"),
    "cu_linux_terminal_shallow_tree_tree_hint");
  assert_hint(at(capabilities, "data.verbs.term-read.host_shallow_terminal_tree"),
    "cu_linux_terminal_shallow_tree_term_read_hint");

  const doctor_reply = run_cu_or_doctor(context.run_directory, executable, context, ["doctor"]);
  const doctor = doctor_report(doctor_reply);
  ensure(doctor !== undefined && doctor !== null, "cu_linux_terminal_shallow_tree_doctor");
  assert_hint(at(doctor, "capabilities.verbs.tree.host_shallow_terminal_tree"),
    "cu_linux_terminal_shallow_tree_doctor_tree_hint");
  assert_hint(at(doctor, "capabilities.verbs.term-read.host_shallow_terminal_tree"),
    "cu_linux_terminal_shallow_tree_doctor_term_read_hint");
  ensure(
    text_at(doctor, "capabilities.gaps.terminal_a11y_shallow_tree").indexOf("pty-") >= 0,
    "cu_linux_terminal_shallow_tree_doctor_gap"
  );

  print("STEP xfce4-terminal without AT-SPI registration yields visited=1 frame tree read-back");
  const title = "agenterm-terminal-shallow-" + context.run_id;
  terminal = harness.start({
    program: "xfce4-terminal",
    args: ["--title", title, "--disable-server", "-e", "sleep 180"],
    current_dir: context.run_directory,
    env: cu_env(executable, context, true),
    timeout_ms: 30000,
  });

  const window_wait = run_cu(context.run_directory, executable, context, true, [
    "wait", "--timeout-ms", "15000", "--window-title-contains", title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_terminal_shallow_tree_window_wait");

  const windows = run_cu(context.run_directory, executable, context, true, [
    "windows", "--title", title,
  ]);
  const rows = windows_rows(windows);
  ensure(Array.isArray(rows) && rows.length === 1,
    "cu_linux_terminal_shallow_tree_window_row:" + JSON.stringify(rows));
  const handle = int_at(rows[0], "handle");
  terminal_pid = int_at(rows[0], "process_id");
  ensure(handle > 0 && terminal_pid > 0,
    "cu_linux_terminal_shallow_tree_window_identity:" + JSON.stringify(rows[0]));

  print("STEP windows --pid resolves the shallow terminal and agrees with --title read-back");
  const pid_row = window_row_for_pid(context.run_directory, executable, context, terminal_pid, title);
  ensure(int_at(pid_row, "handle") === handle,
    "cu_linux_terminal_shallow_tree_pid_handle:" + JSON.stringify(pid_row));

  const tree = run_cu(context.run_directory, executable, context, true, [
    "tree", "--window", "" + handle,
    "--depth", "8",
    "--max-nodes", "300",
    "--flat",
  ]);
  ensure(
    text_at(tree, "data.backend") === "at-spi2"
      && int_at(tree, "data.visited") === 1
      && !flag_at(tree, "data.truncated")
      && int_at(tree, "data.returned") === 1
      && tree.data.nodes.length === 1
      && text_at(tree.data.nodes[0], "role") === "frame"
      && text_at(tree.data.nodes[0], "name") === title,
    "cu_linux_terminal_shallow_tree_shape:" + JSON.stringify(tree.data)
  );

  print("STEP independent xprop _NET_WM_NAME and xwininfo Map State agree with frame-only tree name");
  independent_frame_readback(context.run_directory, executable, context, handle, title);

  print("STEP term-read typed-fails usage when --name is supplied on the shallow frame handle");
  assert_term_read_usage_limit(context.run_directory, executable, context, true, handle);

  print("STEP term-read typed-fails terminal_buffer_not_found with host-limit detail on the shallow frame handle");
  const term_read_error = run_cu_expect_error(
    context.run_directory, executable, context, true,
    ["term-read", "" + handle],
    "terminal_buffer_not_found"
  );
  assert_terminal_buffer_host_limit(
    at(term_read_error, "error.detail"),
    "cu_linux_terminal_shallow_tree_term_read"
  );

  print("STEP term-send --foreground typed-fails terminal_buffer_not_found with the same host-limit detail");
  const term_send_error = run_cu_expect_error(
    context.run_directory, executable, context, true,
    ["term-send", "" + handle, "--foreground", "echo"],
    "terminal_buffer_not_found",
    "observe,actuate",
    cu_env_allow_foreground(executable, context, true)
  );
  assert_terminal_buffer_host_limit(
    at(term_send_error, "error.detail"),
    "cu_linux_terminal_shallow_tree_term_send"
  );

  print("STEP term-wait typed-fails terminal_buffer_not_found with the same host-limit detail");
  const term_wait_error = run_cu_expect_error(
    context.run_directory, executable, context, true,
    ["term-wait", "" + handle, "decoy", "--timeout-ms", "1000"],
    "terminal_buffer_not_found"
  );
  assert_terminal_buffer_host_limit(
    at(term_wait_error, "error.detail"),
    "cu_linux_terminal_shallow_tree_term_wait"
  );

  print("STEP query --role terminal honestly returns zero matches on the shallow frame tree");
  const query = run_cu(context.run_directory, executable, context, true, [
    "query", "--window", "" + handle, "--role", "terminal",
  ]);
  const query_nodes = at(query, "data.nodes");
  ensure(
    int_at(query, "data.matched") === 0
      && int_at(query, "data.returned") === 0
      && Array.isArray(query_nodes) && query_nodes.length === 0
      && int_at(query, "data.visited") === 1,
    "cu_linux_terminal_shallow_tree_query_matches:" + JSON.stringify(query.data)
  );
  print("STEP get-text --name typed-fails a11y_text_unavailable because the frame has no text interface");
  const get_text_error = run_cu_expect_error(
    context.run_directory, executable, context, true,
    ["get-text", "--window", "" + handle, "--name", title],
    "a11y_text_unavailable"
  );
  ensure(
    text_at(get_text_error, "error.message").indexOf("text interface") >= 0,
    "cu_linux_terminal_shallow_tree_get_text_message:" + JSON.stringify(get_text_error.error)
  );

  print("STEP independent pyatspi finds zero registered application roots for the terminal pid");
  const probe = independent_shallow_probe(executable, context, terminal_pid);
  ensure(probe.registered_apps === 0 && probe.proc_alive === true,
    "cu_linux_terminal_shallow_tree_independent:" + JSON.stringify(probe));

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (terminal_pid > 0) {
  rh.command("kill", ["-TERM", "" + terminal_pid], {
    cwd: context.run_directory,
    timeout_ms: 5000,
  });
}
if (terminal >= 0) {
  try { harness.kill(terminal); } catch (error) { /* terminal may already exit */ }
  try { harness.wait(terminal, 5000); } catch (error) { print("cleanup: " + error); }
}

if (succeeded !== 0) {
  harness.emit_evidence(context, declared_evidence, declared_evidence[0]);
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux terminal shallow-tree host-limit honesty with independent read-back and typed terminal/get-extents usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux terminal shallow-tree host-limit honesty with independent read-back and typed terminal/get-extents host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
return;
