// CEO: Linux file-attributes honesty with independent os.listxattr read-back.
// Acceptance is smoke read-back only: CU file-attributes xattr inventory for one
// regular file must agree with names, byte lengths, SHA-256 digests and optional
// value_hex derived outside agenterm-cu via os.listxattr/getxattr. When getfattr
// is installed, its name inventory must agree as well. Typed file-attributes
// usage must reject AT-SPI --name, --coords, --bogus, and other unexpected
// arguments; typed get-extents --name usage AND host-limit paths must both hold
// before the xattr read-back court. Prefer host-limit clarity over fake success.
// AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-file-attributes-readback",
];

const AT_SPI_PROBE_NAME = "File Attributes Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function isolated_env(run_directory, executable) {
  const env = {
    HOME: rh.join(run_directory, "home"),
    USERPROFILE: rh.join(run_directory, "home"),
    XDG_CONFIG_HOME: rh.join(run_directory, "config"),
    XDG_DATA_HOME: rh.join(run_directory, "data"),
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
    AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
    AGENTERM_CU_IDEMPOTENCY_PATH: rh.join(run_directory, "cu-requests.json"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  const cu = cu_env(executable);
  env.AGENTERM_ABI_LIB = cu.AGENTERM_ABI_LIB;
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (cu[key] !== undefined) { env[key] = cu[key]; }
  }
  return env;
}

function invoke_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_file_attributes_cli:" + output.stdout + output.stderr);
  let reply = null;
  try { reply = JSON.parse(output.stdout.trim()); }
  catch (error) { throw "cu_linux_file_attributes_invalid_reply"; }
  ensure(
    text_at(reply, "command") === "file-attributes" || text_at(reply, "command") === "usage",
    "cu_linux_file_attributes_wrong_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_file_attributes_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function invoke(run_directory, executable, arguments, expected_error, env) {
  const reply = invoke_reply(run_directory, executable, arguments, env);
  if (expected_error !== undefined) {
    ensure(!output_success(reply), "cu_linux_file_attributes_expected_failure");
    ensure(text_at(reply, "error.code") === expected_error,
      "cu_linux_file_attributes_wrong_error:" + JSON.stringify(reply.error));
    return reply.error;
  }
  ensure(output_success(reply), "cu_linux_file_attributes_failed:" + JSON.stringify(reply));
  return reply.data;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function file_attributes_usage_rejects(message, token) {
  return usage_rejects_unexpected(message, token)
    || message.indexOf("requires PATH") >= 0;
}

function assert_file_attributes_usage_limit(run_directory, executable, fixture, env) {
  const flat_with_name = invoke_reply(run_directory, executable, [
    "file-attributes", fixture, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_file_attributes_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_file_attributes_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_file_attributes_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    file_attributes_usage_rejects(text_at(flat_with_name, "error.message"), "--name"),
    "cu_linux_file_attributes_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_reply(run_directory, executable, [
    "file", "attributes", fixture, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_file_attributes_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_file_attributes_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "command") === "usage",
    "cu_linux_file_attributes_usage_grouped_name_command:" + JSON.stringify(grouped_with_name)
  );
  ensure(
    file_attributes_usage_rejects(text_at(grouped_with_name, "error.message"), "--name"),
    "cu_linux_file_attributes_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const flat_with_bogus = invoke_reply(run_directory, executable, [
    "file-attributes", fixture, "--bogus",
  ], env);
  ensure(!output_success(flat_with_bogus),
    "cu_linux_file_attributes_usage_flat_bogus_ok:" + JSON.stringify(flat_with_bogus));
  ensure(
    text_at(flat_with_bogus, "error.code") === "usage",
    "cu_linux_file_attributes_usage_flat_bogus_code:" + JSON.stringify(flat_with_bogus.error)
  );
  ensure(
    text_at(flat_with_bogus, "command") === "usage",
    "cu_linux_file_attributes_usage_flat_bogus_command:" + JSON.stringify(flat_with_bogus)
  );
  ensure(
    file_attributes_usage_rejects(text_at(flat_with_bogus, "error.message"), "--bogus"),
    "cu_linux_file_attributes_usage_flat_bogus_message:" + JSON.stringify(flat_with_bogus.error)
  );

  const grouped_with_bogus = invoke_reply(run_directory, executable, [
    "file", "attributes", fixture, "--bogus",
  ], env);
  ensure(!output_success(grouped_with_bogus),
    "cu_linux_file_attributes_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_file_attributes_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    text_at(grouped_with_bogus, "command") === "usage",
    "cu_linux_file_attributes_usage_grouped_bogus_command:" + JSON.stringify(grouped_with_bogus)
  );
  ensure(
    file_attributes_usage_rejects(text_at(grouped_with_bogus, "error.message"), "--bogus"),
    "cu_linux_file_attributes_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const flat_with_coords = invoke_reply(run_directory, executable, [
    "file-attributes", fixture, "--coords", "10,10",
  ], env);
  ensure(!output_success(flat_with_coords),
    "cu_linux_file_attributes_usage_flat_coords_ok:" + JSON.stringify(flat_with_coords));
  ensure(
    text_at(flat_with_coords, "error.code") === "usage",
    "cu_linux_file_attributes_usage_flat_coords_code:" + JSON.stringify(flat_with_coords.error)
  );
  ensure(
    text_at(flat_with_coords, "command") === "usage",
    "cu_linux_file_attributes_usage_flat_coords_command:" + JSON.stringify(flat_with_coords)
  );
  ensure(
    file_attributes_usage_rejects(text_at(flat_with_coords, "error.message"), "--coords"),
    "cu_linux_file_attributes_usage_flat_coords_message:" + JSON.stringify(flat_with_coords.error)
  );

  const grouped_with_coords = invoke_reply(run_directory, executable, [
    "file", "attributes", fixture, "--coords", "10,10",
  ], env);
  ensure(!output_success(grouped_with_coords),
    "cu_linux_file_attributes_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_file_attributes_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    text_at(grouped_with_coords, "command") === "usage",
    "cu_linux_file_attributes_usage_grouped_coords_command:" + JSON.stringify(grouped_with_coords)
  );
  ensure(
    file_attributes_usage_rejects(text_at(grouped_with_coords, "error.message"), "--coords"),
    "cu_linux_file_attributes_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_file_attributes_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_file_attributes_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_file_attributes_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_file_attributes_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_file_attributes_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_file_attributes_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_attributes_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_file_attributes_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_file_attributes_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_file_attributes_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_attributes_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_file_attributes_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_file_attributes_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_file_attributes_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_file_attributes_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_file_attributes_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_file_attributes_extents_unavailable_code:" + code
  );
}

function verify_readback(run_directory, executable, fixture, env) {
  const script = [
    "import hashlib, json, os, shutil, subprocess, sys",
    "path = sys.argv[1]",
    "cu = sys.argv[2]",
    "def namespace(name):",
    "    if '.' in name:",
    "        return name.split('.', 1)[0]",
    "    return 'unqualified'",
    "def sha256_hex(value):",
    "    return hashlib.sha256(value).hexdigest()",
    "def native_inventory():",
    "    rows = []",
    "    for name in sorted(os.listxattr(path)):",
    "        value = os.getxattr(path, name)",
    "        rows.append({",
    "            'name': name,",
    "            'namespace': namespace(name),",
    "            'value_bytes': str(len(value)),",
    "            'value_sha256': sha256_hex(value),",
    "            'value_hex': value.hex(),",
    "        })",
    "    return rows",
    "def getfattr_names():",
    "    getfattr = shutil.which('getfattr')",
    "    if getfattr is None:",
    "        return None",
    "    out = subprocess.check_output(",
    "        [getfattr, '-d', '-m', '-', path],",
    "        stderr=subprocess.STDOUT,",
    "        text=True)",
    "    names = []",
    "    for line in out.splitlines():",
    "        if '=' not in line or line.startswith('#'):",
    "            continue",
    "        names.append(line.split('=', 1)[0])",
    "    return sorted(names)",
    "def cu_inventory(include_values):",
    "    args = [cu, '--target', 'current', '--grant', 'observe', 'file-attributes', path]",
    "    if include_values:",
    "        args.append('--include-values')",
    "    out = subprocess.check_output(args, text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok') or reply.get('command') != 'file-attributes':",
    "        raise SystemExit('cu_linux_file_attributes_reply_state')",
    "    return reply['data']",
    "native = native_inventory()",
    "getfattr = getfattr_names()",
    "if getfattr is not None and sorted(row['name'] for row in native) != getfattr:",
    "    raise SystemExit(f'cu_linux_file_attributes_getfattr_mismatch:native={[r[\"name\"] for r in native]}:getfattr={getfattr}')",
    "redacted = cu_inventory(False)",
    "if redacted.get('include_values') is not False:",
    "    raise SystemExit('cu_linux_file_attributes_default_disclosure')",
    "cu_rows = sorted(redacted.get('attributes') or [], key=lambda row: row['name'])",
    "if len(cu_rows) != len(native):",
    "    raise SystemExit(f'cu_linux_file_attributes_count:{len(cu_rows)}:{len(native)}')",
    "for expected, actual in zip(native, cu_rows):",
    "    if actual.get('name') != expected['name']:",
    "        raise SystemExit(f'cu_linux_file_attributes_name:{actual.get(\"name\")}:{expected[\"name\"]}')",
    "    if actual.get('namespace') != expected['namespace']:",
    "        raise SystemExit(f'cu_linux_file_attributes_namespace:{actual.get(\"namespace\")}:{expected[\"namespace\"]}')",
    "    if actual.get('value_bytes') != expected['value_bytes']:",
    "        raise SystemExit(f'cu_linux_file_attributes_bytes:{actual.get(\"value_bytes\")}:{expected[\"value_bytes\"]}')",
    "    if actual.get('value_sha256') != expected['value_sha256']:",
    "        raise SystemExit(f'cu_linux_file_attributes_digest:{actual.get(\"value_sha256\")}:{expected[\"value_sha256\"]}')",
    "    if actual.get('value_hex') is not None:",
    "        raise SystemExit('cu_linux_file_attributes_value_leaked')",
    "disclosed = cu_inventory(True)",
    "if disclosed.get('include_values') is not True:",
    "    raise SystemExit('cu_linux_file_attributes_explicit_disclosure')",
    "cu_disclosed = sorted(disclosed.get('attributes') or [], key=lambda row: row['name'])",
    "for expected, actual in zip(native, cu_disclosed):",
    "    if actual.get('value_hex') != expected['value_hex']:",
    "        raise SystemExit(f'cu_linux_file_attributes_value_hex:{actual.get(\"value_hex\")}:{expected[\"value_hex\"]}')",
    "identity = redacted.get('identity') or {}",
    "st = os.stat(path)",
    "if identity.get('filesystem_id') != str(st.st_dev) or identity.get('object_id') != str(st.st_ino):",
    "    raise SystemExit(f'cu_linux_file_attributes_identity:{identity}:dev={st.st_dev}:ino={st.st_ino}')",
    "print('native', len(native), 'getfattr', 'yes' if getfattr is not None else 'skip', 'cu', len(cu_rows))",
  ].join("\n");
  const output = rh.command("/usr/bin/python3", ["-c", script, fixture, executable], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true,
    "cu_linux_file_attributes_readback:" + output.stderr + output.stdout);
}

function prepare_fixture(fixture, attr_alpha, attr_beta) {
  const script = [
    "import os, sys",
    "path, alpha_name, alpha_value, beta_name, beta_value = sys.argv[1:6]",
    "open(path, 'w', encoding='utf-8').write('file-attributes-readback-fixture')",
    "os.setxattr(path, alpha_name, alpha_value.encode('utf-8'))",
    "os.setxattr(path, beta_name, beta_value.encode('utf-8'))",
    "print(len(os.listxattr(path)))",
  ].join("\n");
  const output = rh.command("/usr/bin/python3", [
    "-c", script, fixture, attr_alpha, "alpha-value", attr_beta, "beta-leaf-22"
  ], { timeout_ms: 10000 });
  ensure(output.success === true && output.stdout.trim() === "2",
    "cu_linux_file_attributes_fixture_setup:" + output.stderr + output.stdout);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_file_attributes_executable_missing");

const uname = rh.command("/usr/bin/uname", ["-s"], { timeout_ms: 10000 });
ensure(uname.success === true && uname.stdout.trim() === "Linux",
  "cu_linux_file_attributes_requires_linux");

const context = harness.new_context(repo, "cu-linux-file-attributes");
const run_directory = context.run_directory;
const env = isolated_env(run_directory, executable);
const atspi_available = probe_atspi_available(executable);
const fixture = rh.join(run_directory, "fixture.bin");
const link = rh.join(run_directory, "fixture-link.bin");
const attr_alpha = "user.agenterm.cu.alpha";
const attr_beta = "user.agenterm.cu.beta";
let succeeded = 0;
let failure = "";

try {
  prepare_fixture(fixture, attr_alpha, attr_beta);

  print("STEP file-attributes typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_file_attributes_usage_limit(run_directory, executable, fixture, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before xattr read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before xattr read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; file-attributes read-back still uses os.listxattr/getxattr");
  }

  print("STEP file-attributes inventory matches independent os.listxattr/getxattr read-back");
  verify_readback(run_directory, executable, fixture, env);

  print("STEP final symlink is refused rather than followed");
  const linked = rh.command("/bin/ln", ["-s", fixture, link], {
    cwd: run_directory,
    timeout_ms: 10000,
  });
  ensure(linked.success === true, "cu_linux_file_attributes_link_setup_failed");
  invoke(run_directory, executable, ["file-attributes", link], "file_attributes_not_regular", env);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-file-attributes-readback");
  harness.remove_run(context);
  if (atspi_available) {
