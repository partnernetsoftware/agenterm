// CEO: Linux process-wait honesty with independent waitpid read-back.
// Acceptance is smoke read-back only: CU process-wait must agree with an
// independent reap on the same disposable child for exit observation,
// start identity and exit code. Typed process-wait usage must reject AT-SPI
// --name, --coords, --bogus, and other unexpected arguments; typed get-extents
// --name usage AND host-limit paths must both hold before the waitpid read-back
// court. Prefer host-limit clarity over fake success. AT-SPI/--name only; no
// --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-wait-readback",
];

const AT_SPI_PROBE_NAME = "Process Wait Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_wait_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "process-wait" || text_at(reply, "command") === "usage",
    "cu_linux_process_wait_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_wait_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_process_wait_usage_limit(run_directory, executable, env) {
  const flat_with_name = invoke_observe_reply(run_directory, executable, [
    "process-wait", "--pid", "1", "--start-identity", "proc-start-ticks:0",
    "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_process_wait_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_process_wait_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_process_wait_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_name, "error.message"), "--name"),
    "cu_linux_process_wait_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_observe_reply(run_directory, executable, [
    "process", "wait", "--pid", "1", "--start-identity", "proc-start-ticks:0",
    "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_process_wait_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_process_wait_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_name, "error.message"), "--name"),
    "cu_linux_process_wait_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = invoke_observe_reply(run_directory, executable, [
    "process-wait", "--pid", "1", "--start-identity", "proc-start-ticks:0",
    "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_process_wait_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_process_wait_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_process_wait_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_process_wait_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const grouped_with_bogus = invoke_observe_reply(run_directory, executable, [
    "process", "wait", "--pid", "1", "--start-identity", "proc-start-ticks:0",
    "--bogus",
  ], env);
  ensure(!output_success(grouped_with_bogus),
    "cu_linux_process_wait_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_process_wait_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_bogus, "error.message"), "--bogus"),
    "cu_linux_process_wait_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const with_coords = invoke_observe_reply(run_directory, executable, [
    "process-wait", "--pid", "1", "--start-identity", "proc-start-ticks:0",
    "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords),
    "cu_linux_process_wait_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_process_wait_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_process_wait_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_process_wait_usage_coords_message:" + JSON.stringify(with_coords.error)
  );

  const grouped_with_coords = invoke_observe_reply(run_directory, executable, [
    "process", "wait", "--pid", "1", "--start-identity", "proc-start-ticks:0",
    "--coords", "10,10",
  ], env);
  ensure(!output_success(grouped_with_coords),
    "cu_linux_process_wait_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_process_wait_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_coords, "error.message"), "--coords"),
    "cu_linux_process_wait_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_process_wait_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_process_wait_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_process_wait_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_process_wait_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_process_wait_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_process_wait_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_wait_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_process_wait_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_process_wait_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_process_wait_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_wait_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_process_wait_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_process_wait_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_process_wait_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_wait_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_process_wait_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_process_wait_extents_unavailable_code:" + code
  );
}

function verify_exit_readback(run_directory, executable, exit_code, env) {
  const script = [
    "import json, os, subprocess, sys",
    "cu = sys.argv[1]",
    "expected_exit = int(sys.argv[2])",
    "proc = subprocess.Popen(",
    "    ['sh', '-c', f'sleep 0.3; exit {expected_exit}'],",
    "    stdout=subprocess.DEVNULL,",
    "    stderr=subprocess.DEVNULL,",
    ")",
    "pid = proc.pid",
    "def invoke_state():",
    "    out = subprocess.check_output(",
    "        [cu, '--target', 'current', '--grant', 'observe',",
    "         'process-state', '--pid', str(pid)],",
    "        text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok') or reply.get('command') != 'process-state':",
    "        raise SystemExit('cu_linux_process_wait_reply_state')",
    "    return reply['data']",
    "def invoke_wait(identity, timeout_ms):",
    "    out = subprocess.check_output(",
    "        [cu, '--target', 'current', '--grant', 'observe',",
    "         'process-wait', '--pid', str(pid),",
    "         '--start-identity', identity,",
    "         '--timeout-ms', str(timeout_ms)],",
    "        text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok') or reply.get('command') != 'process-wait':",
    "        raise SystemExit('cu_linux_process_wait_reply_wait')",
    "    return reply['data']",
    "state = invoke_state()",
    "if int(state.get('pid', -1)) != pid:",
    "    raise SystemExit('cu_linux_process_wait_pid')",
    "if state.get('state') != 'live':",
    "    raise SystemExit(f'cu_linux_process_wait_not_live:{state.get(\"state\")}')",
    "identity = state.get('start_identity')",
    "if not identity:",
    "    raise SystemExit('cu_linux_process_wait_missing_identity')",
    "if state.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_wait_state_not_verified')",
    "wait = invoke_wait(identity, 30000)",
    "if wait.get('state') != 'exited':",
    "    raise SystemExit(f'cu_linux_process_wait_not_exited:{wait.get(\"state\")}')",
    "if wait.get('completed') is not True:",
    "    raise SystemExit('cu_linux_process_wait_not_completed')",
    "if wait.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_wait_not_verified')",
    "if wait.get('start_identity') != identity:",
    "    raise SystemExit('cu_linux_process_wait_identity_changed')",
    "if wait.get('mechanism') != 'native-process-reference':",
    "    raise SystemExit('cu_linux_process_wait_mechanism')",
    "actual_exit = proc.wait()",
    "if actual_exit != expected_exit:",
    "    raise SystemExit(f'cu_linux_process_wait_exit_code:{actual_exit}:{expected_exit}')",
    "print('pid', pid, 'exit', actual_exit)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, executable, "" + exit_code], {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  ensure(output.success === true, "cu_linux_process_wait_exit_readback:" + output.stderr + output.stdout);
}

function verify_timeout_readback(run_directory, executable, env) {
  const script = [
    "import json, subprocess, sys",
    "cu = sys.argv[1]",
    "proc = subprocess.Popen(",
    "    ['sleep', '300'],",
    "    stdout=subprocess.DEVNULL,",
    "    stderr=subprocess.DEVNULL,",
    ")",
    "pid = proc.pid",
    "out = subprocess.check_output(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-state', '--pid', str(pid)],",
    "    text=True)",
    "state = json.loads(out)",
    "if not state.get('ok'):",
    "    raise SystemExit('cu_linux_process_wait_timeout_state')",
    "identity = state['data']['start_identity']",
    "out = subprocess.check_output(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-wait', '--pid', str(pid),",
    "     '--start-identity', identity,",
    "     '--timeout-ms', '50'],",
    "    text=True)",
    "wait = json.loads(out)",
    "if not wait.get('ok'):",
    "    raise SystemExit('cu_linux_process_wait_timeout_reply')",
    "data = wait['data']",
    "if data.get('state') != 'timeout':",
    "    raise SystemExit(f'cu_linux_process_wait_timeout_state:{data.get(\"state\")}')",
    "if data.get('completed') is not False:",
    "    raise SystemExit('cu_linux_process_wait_timeout_completed')",
    "if data.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_wait_timeout_verified')",
    "if data.get('start_identity') != identity:",
    "    raise SystemExit('cu_linux_process_wait_timeout_identity')",
    "proc.terminate()",
    "proc.wait(timeout=5)",
    "print('pid', pid, 'timeout')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, executable], {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  ensure(output.success === true, "cu_linux_process_wait_timeout_readback:" + output.stderr + output.stdout);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-wait");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
try {
  print("STEP process-wait typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_process_wait_usage_limit(context.run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before waitpid read-back court");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP process-wait observes disposable child exit and matches independent waitpid read-back");
  verify_exit_readback(context.run_directory, executable, 42, env);

  print("STEP process-wait times out on a live disposable child without claiming exit");
  verify_timeout_readback(context.run_directory, executable, env);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-wait-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux process-wait matches independent waitpid exit read-back with typed process-wait --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux process-wait matches independent waitpid exit read-back with typed process-wait --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
