// Platform-neutral public black-box court for bounded native storage inventory.
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.storage-devices"];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function invoke(run_directory, executable, arguments, expect_success) {
  const receipt_path = rh.join(run_directory, "cu-receipts.jsonl");
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: {
      AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
      AGENTERM_CU_RECEIPT_PATH: receipt_path
    },
    timeout_ms: 30000
  });
  ensure(output.success === expect_success, "cu_storage_devices_exit:" + output.exit_code);
  const reply = JSON.parse(output.stdout.trim());
  ensure(reply.ok === expect_success, "cu_storage_devices_reply_state");
  ensure(!rh.exists(receipt_path) || rh.read_text(receipt_path).trim() === "", "cu_storage_devices_effect_receipt_created");
  return reply;
}

function assert_inventory(reply, max) {
  ensure(reply.command === "storage-devices" && reply.target === "current", "cu_storage_devices_identity");
  const data = reply.data;
  ensure(Array.isArray(data.devices), "cu_storage_devices_rows");
  ensure(data.returned === data.devices.length && data.returned <= max, "cu_storage_devices_count");
  ensure(typeof data.visited === "number" && data.visited >= data.returned, "cu_storage_devices_visited");
  ensure(typeof data.read_errors === "number" && data.read_errors >= 0, "cu_storage_devices_errors");
  ensure(typeof data.truncated === "boolean" && typeof data.truncated_scan === "boolean", "cu_storage_devices_bounds");
  ensure(typeof data.complete === "boolean", "cu_storage_devices_complete");
  ensure(typeof data.provider === "string" && data.provider.length > 0, "cu_storage_devices_provider");
  ensure(data.response_ceiling_bytes === 1048576, "cu_storage_devices_response_ceiling");
  for (const row of data.devices) {
    ensure(typeof row.id === "string" && row.id.length > 0, "cu_storage_devices_id");
    ensure(typeof row.name === "string" && row.name.length > 0, "cu_storage_devices_name");
    ensure(row.size_bytes === null || (typeof row.size_bytes === "string" && row.size_bytes.length > 0), "cu_storage_devices_capacity");
    ensure(Array.isArray(row.operational), "cu_storage_devices_operational");
    ensure(Array.isArray(row.unavailable_fields), "cu_storage_devices_unavailable");
    ensure(row.serial === undefined && row.wwn === undefined && row.unique_id === undefined, "cu_storage_devices_private_identity");
  }
  return data;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!direct_file(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(direct_file(executable), "cu_storage_devices_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-storage-devices");
let succeeded = 0;
let failure = "";
try {
  print("STEP flat storage inventory is bounded, private and read-only");
  const flat = assert_inventory(invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "observe", "storage-devices", "--max", "1"
  ], true), 1);
  ensure(flat.returned >= 1, "cu_storage_devices_empty_host_inventory");

  print("STEP grouped alias preserves provider identity");
  const grouped = assert_inventory(invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "observe", "storage", "devices", "--max", "1"
  ], true), 1);
  ensure(flat.provider === grouped.provider, "cu_storage_devices_alias_provider");

  print("STEP invalid bounds fail before native observation");
  const invalid = invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "observe", "storage-devices", "--max", "0"
  ], false);
  ensure(invalid.error.code === "usage", "cu_storage_devices_invalid_code");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.storage-devices");
  harness.remove_run(context);
  print("PASS: native storage inventory is bounded, privacy-minimized and read-only");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
