// CEO: Linux processor-affinity honesty with independent /proc/status read-back.
// Acceptance is smoke read-back only: CU processor-affinity-status must agree with
// Cpus_allowed_list from /proc/<pid>/status or taskset -p outside agenterm-cu.
// Typed processor-affinity-status usage must reject AT-SPI --name and other unexpected
// arguments; typed get-extents --name usage/host-limit paths must hold before the
// /proc status Cpus_allowed_list / sched_getaffinity read-back court.
// AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-processor-affinity-readback",
];

const AT_SPI_PROBE_NAME = "Processor Affinity Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_processor_affinity_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "processor-affinity-status"
      || text_at(reply, "command") === "usage",
    "cu_linux_processor_affinity_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_processor_affinity_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_processor_affinity_usage_limit(run_directory, executable, env) {
  const flat_with_name = invoke_observe_reply(run_directory, executable, [
    "processor-affinity-status", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_processor_affinity_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_processor_affinity_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_processor_affinity_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    text_at(flat_with_name, "error.message").indexOf("--name") >= 0
      || text_at(flat_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_processor_affinity_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_observe_reply(run_directory, executable, [
    "processor", "affinity", "status", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_processor_affinity_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_processor_affinity_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "error.message").indexOf("--name") >= 0
      || text_at(grouped_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_processor_affinity_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = invoke_observe_reply(run_directory, executable, [
    "processor-affinity-status", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_processor_affinity_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_processor_affinity_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("unexpected") >= 0
      || text_at(with_bogus, "error.message").indexOf("--bogus") >= 0,
    "cu_linux_processor_affinity_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_processor_affinity_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_processor_affinity_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_processor_affinity_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_processor_affinity_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_processor_affinity_extents_unavailable_code:" + code
  );
}

function invoke(run_directory, executable, arguments, expect_success) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(
    output.success === expect_success || (expect_success !== true && output.exit_code === 1),
    "cu_linux_processor_affinity_exit:" + output.exit_code + ":" + output.stdout + output.stderr
  );
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_processor_affinity_empty:" + output.stderr);
  const reply = JSON.parse(trimmed);
  ensure(reply.ok === expect_success, "cu_linux_processor_affinity_reply_state:" + JSON.stringify(reply));
  return reply;
}

function independent_affinity(pid) {
  const script = [
    "import json, os, re, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cpus = None",
    "path = f'/proc/{pid}/status'",
    "if os.path.exists(path):",
    "    for line in open(path):",
    "        if line.startswith('Cpus_allowed_list:'):",
    "            raw = line.split(':', 1)[1].strip()",
    "            if raw == '':",
    "                cpus = []",
    "            else:",
    "                out = set()",
    "                for part in raw.split(','):",
    "                    part = part.strip()",
    "                    if '-' in part:",
    "                        start, end = part.split('-', 1)",
    "                        out.update(range(int(start), int(end) + 1))",
    "                    else:",
    "                        out.add(int(part))",
    "                cpus = sorted(out)",
    "            break",
    "if cpus is None:",
    "    out = subprocess.run(['taskset', '-p', str(pid)], capture_output=True, text=True)",
    "    if out.returncode != 0:",
    "        print(json.dumps({'available': False, 'stderr': out.stderr.strip()}))",
    "        sys.exit(0)",
    "    match = re.search(r'affinity mask:\\s*([0-9a-fA-F]+)', out.stdout)",
    "    if match is None:",
    "        print(json.dumps({'available': False, 'stderr': out.stdout.strip()}))",
    "        sys.exit(0)",
    "    mask = int(match.group(1), 16)",
    "    cpus = [bit for bit in range(1024) if mask & (1 << bit)]",
    "print(json.dumps({'available': True, 'pid': pid, 'cpus': cpus}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid], { timeout_ms: 15000 });
  ensure(output.success === true, "cu_linux_processor_affinity_probe:" + output.stderr);
  const probe = JSON.parse(output.stdout.trim());
  ensure(probe.available === true, "cu_linux_processor_affinity_probe_unavailable:" + output.stdout);
  return probe;
}

function cu_cpus(reply) {
  const rows = rh.field(rh.field(reply, "data"), "processors");
  ensure(Array.isArray(rows), "cu_linux_processor_affinity_processors_shape");
  const cpus = [];
  for (let index = 0; index < rows.length; index = index + 1) {
    const row = rows[index];
    ensure(text_at(row, "group") === "0", "cu_linux_processor_affinity_group");
    cpus.push(Number(text_at(row, "index")));
  }
  cpus.sort(function (left, right) { return left - right; });
  return cpus;
}

function compare_sets(label, observed, expected) {
  ensure(observed.length === expected.length,
         label + "_length:cu=" + observed.length + ":probe=" + expected.length);
  for (let index = 0; index < observed.length; index = index + 1) {
    ensure(observed[index] === expected[index],
           label + "_cpu_" + index + ":cu=" + observed[index] + ":probe=" + expected[index]);
  }
}

function verify_reply(reply, probe) {
  ensure(reply.command === "processor-affinity-status" && reply.target === "current",
         "cu_linux_processor_affinity_identity");
  ensure(text_at(reply, "data.atomic_snapshot") === "false",
         "cu_linux_processor_affinity_atomic_snapshot");
  ensure(text_at(reply, "data.semantics") === "scheduler-allowed",
         "cu_linux_processor_affinity_semantics");
  ensure(Number(text_at(reply, "data.pid")) === probe.pid,
         "cu_linux_processor_affinity_pid");
  compare_sets("cu_linux_processor_affinity_cpus", cu_cpus(reply), probe.cpus);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-processor-affinity");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
try {
  print("STEP processor-affinity-status typed-fails usage when AT-SPI --name or other unexpected arguments are present");
  assert_processor_affinity_usage_limit(context.run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before /proc status Cpus_allowed read-back");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP processor-affinity-status observe matches independent read-back");
  const self_pid = rh.pid();
  const self_probe = independent_affinity(self_pid);
  const self_reply = invoke(context.run_directory, executable,
    ["processor-affinity-status", "--pid", "" + self_pid], true);
  verify_reply(self_reply, self_probe);

  print("STEP spawn disposable child and verify --pid read-back");
  const child = harness.start({
    program: "sleep",
    args: ["300"],
    current_dir: context.run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 60000,
  });
  const hold_pid = harness.spawned_pid(child);
  const child_reply = invoke(context.run_directory, executable,
    ["processor-affinity-status", "--pid", "" + hold_pid], true);
  const child_probe = independent_affinity(hold_pid);
  verify_reply(child_reply, child_probe);
  harness.kill(child);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-processor-affinity-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux processor-affinity-status matches independent /proc/status Cpus_allowed_list read-back with typed processor-affinity-status/get-extents usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux processor-affinity-status matches independent /proc/status Cpus_allowed_list read-back with typed processor-affinity-status/get-extents host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
