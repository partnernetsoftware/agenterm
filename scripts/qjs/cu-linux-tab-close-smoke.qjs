// CEO: Linux tab-close --expect gone on a disposable Chrome tab with independent read-back.
// Typed tab-close usage must reject AT-SPI --name, --coords, --bogus, and other
// unexpected arguments; typed get-extents --name usage AND host-limit paths must
// both hold before the tab-close actuate/read-back court. Typed destructive_gate
// refusals must hold before Chrome starts; miss must typed-fail a11y_tab_not_found
// with tab-list/browser-tabs read-back unchanged; a free --port with no CDP listener
// must typed-fail before Chrome starts. CDP closeTarget via the owned listener is the
// primary actuation path. Prefer host-limit clarity over fake success. AT-SPI/--name
// court only; no --coords.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-browser-tab-close",
];

const TAB_KEEP_PREFIX = "CEO Tab Close Keep";
const TAB_CLOSE_PREFIX = "CEO Tab Close Disposable";
const AT_SPI_PROBE_NAME = "Tab Close Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_tab_close_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(document), "cu_linux_tab_close_reply:" + JSON.stringify(document));
  return document;
}

function invoke_tab_close_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "actuate",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_tab_close_actuate_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "tab-close" || text_at(reply, "command") === "usage",
    "cu_linux_tab_close_actuate_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_tab_close_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(env) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: env,
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_tab_close_unexpected_flag(run_directory, executable, arguments, env, label, token) {
  const reply = invoke_tab_close_reply(run_directory, executable, arguments, env);
  ensure(
    !output_success(reply),
    "cu_linux_tab_close_usage_" + label + "_ok:" + JSON.stringify(reply)
  );
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_tab_close_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_tab_close_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  ensure(
    usage_rejects_unexpected(text_at(reply, "error.message"), token),
    "cu_linux_tab_close_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_tab_close_unexpected_usage(run_directory, executable, env) {
  const base = [
    "--window", "1", "--title", "CEO Tab", "--exact", "--expect", "gone",
  ];
  assert_tab_close_unexpected_flag(run_directory, executable, [
    "tab-close",
  ].concat(base).concat(["--name", AT_SPI_PROBE_NAME]), env, "flat_name", "--name");
  assert_tab_close_unexpected_flag(run_directory, executable, [
    "tab", "close",
  ].concat(base).concat(["--name", AT_SPI_PROBE_NAME]), env, "grouped_name", "--name");
  assert_tab_close_unexpected_flag(run_directory, executable, [
    "tab-close",
  ].concat(base).concat(["--bogus"]), env, "flat_bogus", "--bogus");
  assert_tab_close_unexpected_flag(run_directory, executable, [
    "tab", "close",
  ].concat(base).concat(["--bogus"]), env, "grouped_bogus", "--bogus");
  assert_tab_close_unexpected_flag(run_directory, executable, [
    "tab-close",
  ].concat(base).concat(["--coords", "10,10"]), env, "flat_coords", "--coords");
  assert_tab_close_unexpected_flag(run_directory, executable, [
    "tab", "close",
  ].concat(base).concat(["--coords", "10,10"]), env, "grouped_coords", "--coords");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_tab_close_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_tab_close_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_tab_close_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_tab_close_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_tab_close_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_tab_close_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_tab_close_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_tab_close_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_tab_close_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_tab_close_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_tab_close_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_tab_close_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_tab_close_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_tab_close_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_tab_close_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_tab_close_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_tab_close_extents_unavailable_code:" + code
  );
}

function tab_rows(reply) {
  const rows = at(reply, "data.tabs");
  return rows === undefined || rows === null ? [] : rows;
}

function any_contains(rows, field, wanted) {
  for (const row of rows) {
    const value = text_at(row, field);
    if (value.indexOf(wanted) >= 0) { return true; }
  }
  return false;
}

function count_contains(rows, field, wanted) {
  let count = 0;
  for (const row of rows) {
    const value = text_at(row, field);
    if (value.indexOf(wanted) >= 0) { count = count + 1; }
  }
  return count;
}

function assert_tab_close_usage_limits(run_directory, executable, env) {
  const bare = run_cu_reply(run_directory, executable, "actuate", [
    "tab-close", "--window", "1",
  ], env);
  ensure(!output_success(bare), "cu_linux_tab_close_usage_bare_ok:" + JSON.stringify(bare));
  ensure(
    text_at(bare, "error.code") === "refused",
    "cu_linux_tab_close_usage_bare_code:" + JSON.stringify(bare.error)
  );
  ensure(
    text_at(bare, "error.detail.reason") === "destructive_gate",
    "cu_linux_tab_close_usage_bare_reason:" + JSON.stringify(bare.error)
  );
  ensure(
    text_at(bare, "error.detail.effect") === "not_performed",
    "cu_linux_tab_close_usage_bare_effect:" + JSON.stringify(bare.error)
  );

  const no_exact = run_cu_reply(run_directory, executable, "actuate", [
    "tab-close", "--window", "1", "--title", "CEO Tab", "--expect", "gone",
  ], env);
  ensure(!output_success(no_exact), "cu_linux_tab_close_usage_no_exact_ok:" + JSON.stringify(no_exact));
  ensure(
    text_at(no_exact, "error.code") === "refused",
    "cu_linux_tab_close_usage_no_exact_code:" + JSON.stringify(no_exact.error)
  );
  ensure(
    text_at(no_exact, "error.detail.reason") === "destructive_gate",
    "cu_linux_tab_close_usage_no_exact_reason:" + JSON.stringify(no_exact.error)
  );

  const both_selectors = run_cu_reply(run_directory, executable, "actuate", [
    "tab-close", "--window", "1", "--title", "CEO Tab", "--exact",
    "--index", "0", "--expect", "gone",
  ], env);
  ensure(!output_success(both_selectors),
    "cu_linux_tab_close_usage_both_ok:" + JSON.stringify(both_selectors));
  ensure(
    text_at(both_selectors, "error.code") === "usage",
    "cu_linux_tab_close_usage_both_code:" + JSON.stringify(both_selectors.error)
  );
  ensure(
    text_at(both_selectors, "error.message").indexOf("not both") >= 0,
    "cu_linux_tab_close_usage_both_message:" + JSON.stringify(both_selectors.error)
  );
}

function assert_no_cdp_listener(run_directory, executable, env, port) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "page-targets", "--port", "" + port,
  ], env);
  ensure(reply.ok !== true, "cu_linux_tab_close_false_success:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_tab_close_host_limit_code:" + JSON.stringify(reply)
  );
  const message = text_at(reply, "error.message");
  ensure(
    message.indexOf("no CDP listener") >= 0 && message.indexOf("" + port) >= 0,
    "cu_linux_tab_close_host_limit_message:" + JSON.stringify(reply.error)
  );
}

function assert_tab_close_miss(
  run_directory, executable, env, window_handle, miss_title, keep_title, close_title
) {
  const miss = run_cu_reply(run_directory, executable, "actuate", [
    "tab-close", "--window", window_handle,
    "--title", miss_title, "--exact", "--expect", "gone",
  ], env);
  ensure(!output_success(miss), "cu_linux_tab_close_miss_ok:" + JSON.stringify(miss));
  ensure(
    text_at(miss, "error.code") === "a11y_tab_not_found",
    "cu_linux_tab_close_miss_code:" + JSON.stringify(miss.error)
  );
  ensure(
    text_at(miss, "error.detail.effect") === "not_performed",
    "cu_linux_tab_close_miss_effect:" + JSON.stringify(miss.error)
  );

  const tabs_after_miss = tab_rows(run_cu(run_directory, executable, "observe", [
    "tab-list", "--window", window_handle,
  ], env));
  ensure(any_contains(tabs_after_miss, "title", keep_title),
    "cu_linux_tab_close_miss_keep_tab:" + JSON.stringify(tabs_after_miss));
  ensure(any_contains(tabs_after_miss, "title", close_title),
    "cu_linux_tab_close_miss_close_tab:" + JSON.stringify(tabs_after_miss));

  const keep_tabs = browser_tabs_with_retry(run_directory, executable, env, keep_title);
  ensure(at(keep_tabs, "data.returned") >= 1,
    "cu_linux_tab_close_miss_browser_tabs_keep:" + JSON.stringify(keep_tabs.data));
  const close_tabs = browser_tabs_with_retry(run_directory, executable, env, close_title);
  ensure(at(close_tabs, "data.returned") >= 1,
    "cu_linux_tab_close_miss_browser_tabs_close:" + JSON.stringify(close_tabs.data));
}

function cdp_ready(run_directory, port) {
  const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  return probe.success === true && probe.stdout.indexOf("Browser") >= 0;
}

function browser_tabs_with_retry(run_directory, executable, env, match_title) {
  let last_reply = null;
  for (let attempt = 0; attempt < 20; attempt = attempt + 1) {
    const reply = run_cu_reply(run_directory, executable, "observe", [
      "browser-tabs", "--match", match_title,
    ], env);
    last_reply = reply;
    if (output_success(reply)) { return reply; }
    if (text_at(reply, "error.code") !== "browser_bridge_presentation_changed") {
      ensure(false, "cu_linux_tab_close_browser_tabs:" + JSON.stringify(reply));
    }
    harness.sleep_ms(250);
  }
  ensure(false, "cu_linux_tab_close_browser_tabs_retry:" + JSON.stringify(last_reply));
  return last_reply;
}

function assert_browser_tabs_gone(run_directory, executable, env, match_title) {
  let gone = false;
  for (let attempt = 0; attempt < 20 && !gone; attempt = attempt + 1) {
    const reply = run_cu_reply(run_directory, executable, "observe", [
      "browser-tabs", "--match", match_title,
    ], env);
    if (!output_success(reply)) {
      if (text_at(reply, "error.code") === "browser_bridge_presentation_changed") {
        harness.sleep_ms(250);
        continue;
      }
      ensure(false, "cu_linux_tab_close_browser_tabs_gone:" + JSON.stringify(reply));
    }
    const returned = at(reply, "data.returned");
    if (returned === 0 || returned === "0") {
      gone = true;
      break;
    }
    harness.sleep_ms(250);
  }
  ensure(gone, "cu_linux_tab_close_browser_tabs_still_listed:" + match_title);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
harness.require(!harness.host_is_windows(),
  "cu.linux-browser-tab-close requires Linux browser-open + tab-strip read-back");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "cu_linux_tab_close_executable_missing:" + executable);
ensure(direct_file(abi_library), "cu_linux_tab_close_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-tab-close");
const run_directory = context.run_directory;
const TAB_KEEP = TAB_KEEP_PREFIX + " " + context.run_id;
const TAB_CLOSE = TAB_CLOSE_PREFIX + " " + context.run_id;
const TAB_MISS = "CEO Tab Close Missing " + context.run_id;
const html_dir = rh.join(run_directory, "html");
const fixture_keep = rh.join(html_dir, "tab-keep.html");
const fixture_close = rh.join(html_dir, "tab-close.html");
const env = cu_env(executable);
const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
const port = 9400 + (rh.pid() % 500);
const bad_port = port + 1;
const atspi_available = probe_atspi_available(env);
let chrome_child = -1;
let succeeded = 0;
let failure = "";

try {
  print("STEP tab-close typed-fails usage when AT-SPI --name/--coords/--bogus is present");
  assert_tab_close_unexpected_usage(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before tab-close actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before tab-close actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; tab-close read-back still uses CDP tab-list/browser-tabs");
  }

  print("STEP typed usage limits reject incomplete destructive gate before Chrome starts");
  assert_tab_close_usage_limits(run_directory, executable, env);

  print("STEP tab-close court typed-fails no CDP listener on owned free port before Chrome starts");
  ensure(!cdp_ready(run_directory, bad_port),
    "cu_linux_tab_close_bad_port_in_use:" + bad_port);
  assert_no_cdp_listener(run_directory, executable, env, bad_port);

  print("STEP clear stale box-chrome singletons on this display before browser-open");
  rh.command_status("pkill", ["-9", "-f", "/usr/local/bin/box-chrome"], { timeout_ms: 5000 });
  harness.sleep_ms(1000);

  print("STEP write fixture pages and reserve an owned CDP port " + port);
  rh.create_dir_all(html_dir);
  rh.write_text(fixture_keep, "<!DOCTYPE html><html><head><title>"
    + TAB_KEEP + "</title></head><body>keep</body></html>");
  rh.write_text(fixture_close, "<!DOCTYPE html><html><head><title>"
    + TAB_CLOSE + "</title></head><body>close</body></html>");
  const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  ensure(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
    "cu_linux_tab_close_port_in_use:" + port);

  print("STEP record chrome window handles before launching owned Chrome");
  const before_inventory = run_cu(run_directory, executable, "observe", ["windows"], env);
  const before_set = {};
  const before_rows = before_inventory.data.windows === undefined
    ? before_inventory.data : before_inventory.data.windows;
  for (const row of before_rows) {
    before_set["" + at(row, "handle")] = true;
  }

  print("STEP launch owned Chrome with keeper tab on explicit CDP port");
  chrome_child = harness.start({
    program: launcher,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--new-window",
      "file://" + fixture_keep,
    ],
    current_dir: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  for (let attempt = 0; attempt < 80 && !cdp_ready(run_directory, port); attempt = attempt + 1) {
    harness.sleep_ms(250);
  }
  ensure(cdp_ready(run_directory, port), "cu_linux_tab_close_cdp_not_ready:" + port);

  print("STEP capture the chrome window by unique keeper title");
  let window_handle = null;
  for (let attempt = 0; attempt < 40 && window_handle === null; attempt = attempt + 1) {
    const inventory = run_cu(run_directory, executable, "observe", ["windows"], env);
    const rows = inventory.data.windows === undefined ? inventory.data : inventory.data.windows;
    for (const row of rows) {
      const title = text_at(row, "title");
      const app = text_at(row, "app_name").toLowerCase();
      const handle = "" + at(row, "handle");
      if ((app.indexOf("chrome") >= 0 || app === "google-chrome" || app === "google-chrome-stable")
          && title.indexOf(TAB_KEEP) >= 0
          && before_set[handle] !== true) {
        window_handle = handle;
        break;
      }
    }
    if (window_handle === null) { harness.sleep_ms(250); }
  }
  ensure(window_handle !== null, "cu_linux_tab_close_window_missing");

  function open_tab_in_profile(fixture_path) {
    const launch_shell = launcher
      + " --user-data-dir=" + profile
      + " --remote-debugging-port=" + port
      + " --remote-debugging-address=127.0.0.1"
      + " file://" + fixture_path
      + " >/dev/null 2>&1 &";
    rh.command_status("sh", ["-c", launch_shell], {
      cwd: run_directory,
      env: env,
      timeout_ms: 5000,
    });
    harness.sleep_ms(5000);
  }

  print("STEP open disposable CDP-close tab in the same owned profile");
  open_tab_in_profile(fixture_close);

  print("STEP tab-list shows keeper plus disposable tab before any destructive close");
  let tabs_before = [];
  for (let attempt = 0; attempt < 80 && tabs_before.length < 2; attempt = attempt + 1) {
    const reply = run_cu(run_directory, executable, "observe", [
      "tab-list", "--window", window_handle,
    ], env);
    if (reply.command === "tab-list") { tabs_before = tab_rows(reply); }
    if (tabs_before.length >= 2) { break; }
    harness.sleep_ms(500);
  }
  ensure(tabs_before.length >= 2,
    "cu_linux_tab_close_tab_list_before:" + JSON.stringify(tabs_before));
  ensure(any_contains(tabs_before, "title", TAB_KEEP),
    "cu_linux_tab_close_keep_tab_missing:" + JSON.stringify(tabs_before));
  ensure(any_contains(tabs_before, "title", TAB_CLOSE),
    "cu_linux_tab_close_disposable_tab_missing:" + JSON.stringify(tabs_before));

  print("STEP tab-close miss on a nonexistent title leaves all tabs via independent read-back");
  assert_tab_close_miss(
    run_directory, executable, env, window_handle, TAB_MISS, TAB_KEEP, TAB_CLOSE
  );

  print("STEP tab-close disposable tab by exact title with --expect gone via CDP port " + port);
  const closed = run_cu(run_directory, executable, "actuate", [
    "tab-close", "--window", window_handle,
    "--title", TAB_CLOSE, "--exact", "--expect", "gone",
    "--port", "" + port,
  ], env);
  ensure(closed.command === "tab-close", "cu_linux_tab_close_identity");
  ensure(flag_at(closed, "data.verified") === true,
    "cu_linux_tab_close_verified:" + JSON.stringify(closed.data));
  ensure(text_at(closed, "data.via") === "cdp-close-target",
    "cu_linux_tab_close_via:" + JSON.stringify(closed.data));
  ensure(flag_at(closed, "data.focus_changed") === false,
    "cu_linux_tab_close_focus:" + JSON.stringify(closed.data));

  print("STEP independent tab-list/browser-tabs read-back shows disposable tab gone and keeper tab remains");
  const tabs_after = tab_rows(run_cu(run_directory, executable, "observe", [
    "tab-list", "--window", window_handle,
  ], env));
  ensure(!any_contains(tabs_after, "title", TAB_CLOSE),
    "cu_linux_tab_close_tab_list_disposable_still_present:" + JSON.stringify(tabs_after));
  ensure(any_contains(tabs_after, "title", TAB_KEEP),
    "cu_linux_tab_close_tab_list_keep_missing:" + JSON.stringify(tabs_after));
  ensure(count_contains(tabs_after, "title", TAB_KEEP) === 1,
    "cu_linux_tab_close_tab_list_keep_count:" + JSON.stringify(tabs_after));
  assert_browser_tabs_gone(run_directory, executable, env, TAB_CLOSE);

  const keep_tabs = browser_tabs_with_retry(run_directory, executable, env, TAB_KEEP);
  ensure(keep_tabs.command === "browser-tabs",
    "cu_linux_tab_close_browser_tabs_keep_identity");
  ensure(at(keep_tabs, "data.returned") >= 1,
    "cu_linux_tab_close_browser_tabs_keep_missing:" + JSON.stringify(keep_tabs.data));

  harness.emit_evidence(context, declared_evidence, "cu.linux-browser-tab-close");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup: " + error); }
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux tab-close usage/miss/no-CDP host-limit honesty + independent tab-list/browser-tabs read-back with typed tab-close --name/--coords/--bogus and get-extents --name usage/host-limit plus --coords/--bogus command=usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux tab-close usage/miss/no-CDP host-limit honesty + independent tab-list/browser-tabs read-back with typed tab-close --name/--coords/--bogus usage and get-extents --name usage/host-limit plus --coords/--bogus command=usage honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
