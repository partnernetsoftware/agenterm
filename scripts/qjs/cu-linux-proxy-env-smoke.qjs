// CEO: Linux proxy env facts via capabilities with independent printenv read-back.
// Acceptance is smoke read-back only: http_proxy, HTTPS_PROXY and no_proxy must
// match process env (or empty honesty). Typed capabilities usage must reject
// AT-SPI --name, --coords, --bogus, and other unexpected arguments; typed
// get-extents --name usage AND host-limit paths must both hold before the
// proxy-env read-back court. Prefer host-limit clarity over fake success.
// AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-proxy-env-readback",
];

const AT_SPI_PROBE_NAME = "Proxy Env Court Anchor";
const TEST_HTTP_PROXY = "http://ceo-proxy-env-smoke.example:8080";
const TEST_NO_PROXY = "localhost,127.0.0.1,.example";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}


function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function merge_env(base, extra) {
  const env = {};
  for (const key of Object.keys(base)) {
    env[key] = base[key];
  }
  if (extra !== undefined) {
    for (const key of Object.keys(extra)) {
      env[key] = extra[key];
    }
  }
  return env;
}

function invoke_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_proxy_env_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "capabilities" || text_at(reply, "command") === "usage",
    "cu_linux_proxy_env_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke(run_directory, executable, arguments, env) {
  const reply = invoke_reply(run_directory, executable, arguments, env);
  ensure(rh.output_success(reply), "cu_linux_proxy_env_exit:" + JSON.stringify(reply));
  ensure(text_at(reply, "command") === "capabilities", "cu_linux_proxy_env_command:" + JSON.stringify(reply));
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_proxy_env_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_capabilities_unexpected(run_directory, executable, env, arguments, label, token) {
  const reply = invoke_reply(run_directory, executable, arguments, env);
  ensure(!rh.output_success(reply),
    "cu_linux_proxy_env_usage_" + label + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_proxy_env_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_proxy_env_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  ensure(
    usage_rejects_unexpected(text_at(reply, "error.message"), token)
      || text_at(reply, "error.message").indexOf("no arguments") >= 0,
    "cu_linux_proxy_env_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_capabilities_usage_limit(run_directory, executable, env) {
  assert_capabilities_unexpected(run_directory, executable, env, [
    "capabilities", "--name", AT_SPI_PROBE_NAME,
  ], "name", "--name");
  assert_capabilities_unexpected(run_directory, executable, env, [
    "capabilities", "--bogus",
  ], "bogus", "--bogus");
  assert_capabilities_unexpected(run_directory, executable, env, [
    "capabilities", "--coords", "10,10",
  ], "coords", "--coords");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_proxy_env_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_proxy_env_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_proxy_env_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_proxy_env_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_proxy_env_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_proxy_env_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_proxy_env_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_proxy_env_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_proxy_env_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_proxy_env_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_proxy_env_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_proxy_env_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_proxy_env_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_proxy_env_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_proxy_env_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply), "cu_linux_proxy_env_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_proxy_env_extents_unavailable_code:" + code
  );
}

function independent_env_value(name, env) {
  const output = rh.command("printenv", [name], {
    env: env,
    timeout_ms: 10000,
  });
  if (!output.success) { return ""; }
  return output.stdout.trim();
}

function proxy_env(reply) {
  const data = rh.field(reply, "data");
  const facts = rh.field(data, "proxy_env");
  ensure(facts !== undefined && facts !== null, "cu_linux_proxy_env_missing");
  return facts;
}

function expect_proxy_field(facts, field, expected, label) {
  const actual = text_at(facts, field);
  if (expected === "") {
    ensure(actual === "" || facts[field] === null || facts[field] === undefined,
           label + ":expected_empty:cu=" + JSON.stringify(facts[field]));
    return;
  }
  ensure(actual === expected,
         label + ":mismatch:cu=" + actual + ":host=" + expected);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(rh.exists(executable), "cu_linux_proxy_env_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-proxy-env");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
try {
  print("STEP capabilities typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_capabilities_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before proxy-env read-back court");
  assert_get_extents_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before proxy-env read-back court");
  assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; proxy-env read-back still uses printenv");
  }

  print("STEP explicit proxy env matches independent printenv and capabilities proxy_env");
  const bracket_env = merge_env(env, {
    http_proxy: TEST_HTTP_PROXY,
    HTTPS_PROXY: TEST_HTTP_PROXY,
    no_proxy: TEST_NO_PROXY,
  });

  const host_http = independent_env_value("http_proxy", bracket_env);
  const host_https = independent_env_value("HTTPS_PROXY", bracket_env);
  const host_no = independent_env_value("no_proxy", bracket_env);
  ensure(host_http === TEST_HTTP_PROXY, "cu_linux_proxy_env_host_http:" + host_http);
  ensure(host_https === TEST_HTTP_PROXY, "cu_linux_proxy_env_host_https:" + host_https);
  ensure(host_no === TEST_NO_PROXY, "cu_linux_proxy_env_host_no:" + host_no);

  const reply = invoke(context.run_directory, executable, ["capabilities"], bracket_env);
  ensure(reply.command === "capabilities" && reply.target === "current",
         "cu_linux_proxy_env_command");
  const facts = proxy_env(reply);
  expect_proxy_field(facts, "http_proxy", host_http, "cu_linux_proxy_env_http");
  expect_proxy_field(facts, "HTTPS_PROXY", host_https, "cu_linux_proxy_env_https");
  expect_proxy_field(facts, "no_proxy", host_no, "cu_linux_proxy_env_no");

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-proxy-env-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux capabilities proxy_env matches independent printenv read-back with typed capabilities/get-extents --name/--coords/--bogus usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux capabilities proxy_env matches independent printenv read-back with typed capabilities --name/--coords/--bogus usage plus get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
