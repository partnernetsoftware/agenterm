// CEO#9: clipboard-write UTF-8 seed then paste --name into GTK entry.
// Acceptance is N≥2 independent paste→get-text == SEED roundtrips through
// AT-SPI --name only; no --coords or screenshot. Typed paste/get-text usage
// must reject missing/zero --window, --role-without--name, and --coords/--bogus
// via usage_rejects_unexpected + command=usage, or an honest non-usage typed
// failure (never fake command=usage), or stay on accessibility-tree --name.
// Typed get-extents --name usage AND host-limit courts must both hold before
// process-state, desktop-state, and the native actuate/read-back court (no
// if/else gating those courts on atspi_available), including get-extents
// --coords/--bogus command=usage honesty. process-state and desktop-state
// fixture binding courts must hold before actuate/read-back. Miss paths must
// not mutate the entry (independent get-text read-back).
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-gtk-entry-clipboard-write",
  "cu.linux-gtk-entry-paste",
  "cu.linux-gtk-entry-paste-get-text",
];

const ENTRY_NAME = "Fixture Entry";
const MISSING_NODE = "No Such Entry";
const UNAVAILABLE_NODE = "Fixture Check";
const PASTE_ROUND_COUNT = 2;
const text_type = "text/plain;charset=utf-8";
const FIXTURE_SEED = "seed";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function honest_actuate_non_usage_code(code) {
  return code === "a11y_backend_failed"
    || code === "unsupported"
    || code === "bad_handle"
    || code === "window_not_found"
    || code === "a11y_window_gone"
    || code === "invalid_input"
    || code === "a11y_focus_unavailable"
    || code === "a11y_node_not_found";
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}


function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_entry_paste_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(rh.output_success(document), "cu_linux_gtk_entry_paste_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_entry_paste_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_entry_text(run_directory, executable, handle, expected, label) {
  const got = run_cu(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", ENTRY_NAME,
  ]);
  const readback = text_at(got, "data.text");
  ensure(
    readback === expected && text_at(got, "data.via") === "gettext",
    "cu_linux_gtk_entry_paste_get_" + label + ":" + JSON.stringify({
      expected: expected,
      readback: readback,
    })
  );
  return got;
}

function assert_usage_or_honest_non_usage(reply, label, token) {
  ensure(!rh.output_success(reply),
    "cu_linux_gtk_entry_paste_" + label + "_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  const command = text_at(reply, "command");
  if (code === "usage" || command === "usage") {
    ensure(
      code === "usage",
      "cu_linux_gtk_entry_paste_" + label + "_code:" + JSON.stringify(reply.error)
    );
    ensure(
      command === "usage",
      "cu_linux_gtk_entry_paste_" + label + "_command:" + JSON.stringify(reply)
    );
    ensure(
      usage_rejects_unexpected(text_at(reply, "error.message"), token)
        || text_at(reply, "error.message").indexOf("--name") >= 0,
      "cu_linux_gtk_entry_paste_" + label + "_message:" + JSON.stringify(reply.error)
    );
  } else {
    ensure(
      command !== "usage" && honest_actuate_non_usage_code(code),
      "cu_linux_gtk_entry_paste_" + label + "_honest:" + JSON.stringify(reply)
    );
    ensure(
      JSON.stringify(reply).indexOf("coordinate") < 0
        && JSON.stringify(reply).indexOf("XTest") < 0,
      "cu_linux_gtk_entry_paste_" + label + "_degraded:" + JSON.stringify(reply)
    );
  }
}

function assert_named_stay_or_misuse(reply, label, via, token) {
  if (!rh.output_success(reply)) {
    const code = text_at(reply, "error.code");
    const command = text_at(reply, "command");
    if (code === "usage" || command === "usage") {
      ensure(
        code === "usage",
        "cu_linux_gtk_entry_paste_" + label + "_code:" + JSON.stringify(reply.error)
      );
      ensure(
        command === "usage",
        "cu_linux_gtk_entry_paste_" + label + "_command:" + JSON.stringify(reply)
      );
      ensure(
        usage_rejects_unexpected(text_at(reply, "error.message"), token)
          || text_at(reply, "error.message").indexOf("--name") >= 0,
        "cu_linux_gtk_entry_paste_" + label + "_message:" + JSON.stringify(reply.error)
      );
    } else {
      ensure(
        command !== "usage" && honest_actuate_non_usage_code(code),
        "cu_linux_gtk_entry_paste_" + label + "_honest:" + JSON.stringify(reply)
      );
      ensure(
        JSON.stringify(reply).indexOf("coordinate") < 0
          && JSON.stringify(reply).indexOf("XTest") < 0,
        "cu_linux_gtk_entry_paste_" + label + "_degraded:" + JSON.stringify(reply)
      );
    }
    return false;
  }
  ensure(
    text_at(reply, "data.addressing") === "accessibility-tree"
      && (via === "" || text_at(reply, "data.via") === via),
    "cu_linux_gtk_entry_paste_" + label + "_degraded:" + JSON.stringify(reply.data)
  );
  return true;
}

function assert_paste_usage_limit(run_directory, executable) {
  const missing_window = run_cu_reply(run_directory, executable, "observe,actuate", [
    "paste", "--name", ENTRY_NAME,
  ]);
  ensure(!rh.output_success(missing_window), "cu_linux_gtk_entry_paste_usage_ok:" + JSON.stringify(missing_window));
  ensure(
    text_at(missing_window, "error.code") === "usage",
    "cu_linux_gtk_entry_paste_usage_code:" + JSON.stringify(missing_window.error)
  );
  ensure(
    text_at(missing_window, "command") === "usage",
    "cu_linux_gtk_entry_paste_usage_command:" + JSON.stringify(missing_window)
  );
  ensure(
    text_at(missing_window, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_entry_paste_usage_message:" + JSON.stringify(missing_window.error)
  );

  const role_without_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "paste", "--window", "1", "--role", "entry",
  ]);
  ensure(!rh.output_success(role_without_name), "cu_linux_gtk_entry_paste_role_ok:" + JSON.stringify(role_without_name));
  ensure(
    text_at(role_without_name, "error.code") === "usage",
    "cu_linux_gtk_entry_paste_role_code:" + JSON.stringify(role_without_name.error)
  );
  ensure(
    text_at(role_without_name, "command") === "usage",
    "cu_linux_gtk_entry_paste_role_command:" + JSON.stringify(role_without_name)
  );
  ensure(
    text_at(role_without_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_paste_role_message:" + JSON.stringify(role_without_name.error)
  );

  const zero_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "paste", "--window", "0", "--name", ENTRY_NAME,
  ]);
  ensure(!rh.output_success(zero_handle), "cu_linux_gtk_entry_paste_zero_handle_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "usage",
    "cu_linux_gtk_entry_paste_zero_handle_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "command") === "usage",
    "cu_linux_gtk_entry_paste_zero_handle_command:" + JSON.stringify(zero_handle)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_entry_paste_zero_handle_message:" + JSON.stringify(zero_handle.error)
  );

  const get_text_zero = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "0", "--name", ENTRY_NAME,
  ]);
  ensure(!rh.output_success(get_text_zero), "cu_linux_gtk_entry_paste_get_text_zero_ok:" + JSON.stringify(get_text_zero));
  ensure(
    text_at(get_text_zero, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_paste_get_text_zero_code:" + JSON.stringify(get_text_zero.error)
  );
  ensure(
    text_at(get_text_zero, "error.message").indexOf("window") >= 0,
    "cu_linux_gtk_entry_paste_get_text_zero_message:" + JSON.stringify(get_text_zero.error)
  );

  const get_text_role = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--role", "entry",
  ]);
  ensure(!rh.output_success(get_text_role), "cu_linux_gtk_entry_paste_get_text_role_ok:" + JSON.stringify(get_text_role));
  const get_text_role_code = text_at(get_text_role, "error.code");
  ensure(
    get_text_role_code === "usage" || get_text_role_code === "invalid_input",
    "cu_linux_gtk_entry_paste_get_text_role_code:" + JSON.stringify(get_text_role.error)
  );
  if (get_text_role_code === "usage") {
    ensure(
      text_at(get_text_role, "command") === "usage",
      "cu_linux_gtk_entry_paste_get_text_role_command:" + JSON.stringify(get_text_role)
    );
  }
  ensure(
    text_at(get_text_role, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_paste_get_text_role_message:" + JSON.stringify(get_text_role.error)
  );

  const paste_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "paste", "--window", "1", "--coords", "10,10",
  ]);
  assert_usage_or_honest_non_usage(paste_coords, "coords", "--coords");

  const paste_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "paste", "--window", "1", "--bogus",
  ]);
  assert_usage_or_honest_non_usage(paste_bogus, "bogus", "--bogus");

  const get_text_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--coords", "10,10",
  ]);
  assert_usage_or_honest_non_usage(get_text_coords, "get_text_coords", "--coords");

  const get_text_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--bogus",
  ]);
  assert_usage_or_honest_non_usage(get_text_bogus, "get_text_bogus", "--bogus");
}

function assert_get_text_reject_coords_or_stay_named(
  run_directory, executable, handle, expected_text, label
) {
  const get_text_coords = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", ENTRY_NAME, "--coords", "10,10",
  ]);
  if (assert_named_stay_or_misuse(get_text_coords, "get_text_coords_" + label, "gettext", "--coords")) {
    ensure(
      text_at(get_text_coords, "data.text") === expected_text,
      "cu_linux_gtk_entry_paste_get_text_coords_named_" + label + ":" + JSON.stringify(get_text_coords.data)
    );
  }

  const get_text_bogus = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", handle, "--name", ENTRY_NAME, "--bogus",
  ]);
  if (assert_named_stay_or_misuse(get_text_bogus, "get_text_bogus_" + label, "gettext", "--bogus")) {
    ensure(
      text_at(get_text_bogus, "data.text") === expected_text,
      "cu_linux_gtk_entry_paste_get_text_bogus_named_" + label + ":" + JSON.stringify(get_text_bogus.data)
    );
  }
}

function assert_paste_reject_coords_or_stay_named(run_directory, executable, handle, label) {
  const paste_coords = run_cu_reply(run_directory, executable, "observe,actuate", [
    "paste", "--window", handle, "--name", ENTRY_NAME, "--coords", "10,10",
  ]);
  assert_named_stay_or_misuse(paste_coords, "name_coords_" + label, "", "--coords");

  const paste_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "paste", "--window", handle, "--name", ENTRY_NAME, "--bogus",
  ]);
  assert_named_stay_or_misuse(paste_bogus, "name_bogus_" + label, "", "--bogus");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", ENTRY_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle), "cu_linux_gtk_entry_paste_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_paste_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_gtk_entry_paste_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name), "cu_linux_gtk_entry_paste_extents_missing_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_gtk_entry_paste_extents_missing_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_gtk_entry_paste_extents_missing_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_paste_extents_missing_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_gtk_entry_paste_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_gtk_entry_paste_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_gtk_entry_paste_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_paste_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_gtk_entry_paste_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_gtk_entry_paste_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_gtk_entry_paste_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_paste_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", ENTRY_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply), "cu_linux_gtk_entry_paste_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_gtk_entry_paste_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_gtk_entry_paste_extents_unavailable_code:" + code
  );
}

function assert_paste_host_limit_when_atspi_absent(run_directory, executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "paste", "--window", "1", "--name", ENTRY_NAME,
  ], env);
  ensure(!rh.output_success(reply), "cu_linux_gtk_entry_paste_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_gtk_entry_paste_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle",
    "cu_linux_gtk_entry_paste_unavailable_code:" + code
  );

  const get_text_reply = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1", "--name", ENTRY_NAME,
  ], env);
  ensure(!rh.output_success(get_text_reply), "cu_linux_gtk_entry_paste_get_text_unavailable_ok:" + JSON.stringify(get_text_reply));
  ensure(
    text_at(get_text_reply, "command") !== "usage",
    "cu_linux_gtk_entry_paste_get_text_unavailable_fake_usage:" + JSON.stringify(get_text_reply)
  );
  const get_text_code = text_at(get_text_reply, "error.code");
  ensure(
    get_text_code === "a11y_backend_failed" || get_text_code === "unsupported" || get_text_code === "bad_handle",
    "cu_linux_gtk_entry_paste_get_text_unavailable_code:" + get_text_code
  );
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_gtk_entry_paste_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_gtk_entry_paste_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_gtk_entry_paste_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_gtk_entry_paste_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_gtk_entry_paste_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function assert_paste_missing_node(run_directory, executable, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "paste", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!rh.output_success(reply), "cu_linux_gtk_entry_paste_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_gtk_entry_paste_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function assert_paste_unavailable(run_directory, executable, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "paste", "--window", handle, "--name", UNAVAILABLE_NODE,
  ]);
  ensure(!rh.output_success(reply), "cu_linux_gtk_entry_paste_unavailable_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_text_unavailable",
    "cu_linux_gtk_entry_paste_unavailable_code_" + label + ":" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("editabletext") >= 0 || message.indexOf("text") >= 0,
    "cu_linux_gtk_entry_paste_unavailable_message_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(rh.is_direct_file(executable), "cu_linux_gtk_entry_paste_executable_missing");
const context = harness.new_context(repo, "cu-linux-gtk-entry-paste");
const run_directory = rh.join(repo, "target/cu-linux-gtk-entry-paste-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(rh.is_direct_file(fixture_source), "cu_linux_gtk_entry_paste_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP paste/get-text typed-fail usage for missing/zero --window, --role-without--name, and --coords/--bogus misuse (usage_rejects_unexpected + command=usage, or honest non-usage typed failure; never fake command=usage)");
  assert_paste_usage_limit(run_directory, executable);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP paste/get-text typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
  assert_paste_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held; gtk-entry paste read-back requires pyatspi");
    succeeded = 1;
  } else {
    print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_gtk_entry_paste_window_wait");
    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_gtk_entry_paste_window_identity");
    const handle = "" + at(row, "handle");

    print("STEP process-state binds the owned fixture pid before paste actuate/read-back court");
    assert_fixture_process_state(run_directory, executable, fixture_pid);

    print("STEP desktop-state window row agrees with inventory before paste actuate/read-back court");
    assert_fixture_desktop_state(
      run_directory, executable, fixture_pid, fixture_title, handle, row
    );

    print("STEP paste typed-fail a11y_node_not_found when the named entry is missing");
    assert_paste_missing_node(run_directory, executable, handle, "before_focus");
    print("STEP independent get-text proves the entry stayed at the fixture seed after the miss");
    assert_entry_text(run_directory, executable, handle, FIXTURE_SEED, "after_missing");

    print("STEP paste typed-fail a11y_text_unavailable when the target has no EditableText interface");
    run_cu(run_directory, executable, "observe,actuate", [
      "clipboard-write", "--type", text_type, "--text", "probe-unavailable",
    ]);
    assert_paste_unavailable(run_directory, executable, handle, "check_without_editable");
    print("STEP independent get-text proves the unavailable paste did not mutate the entry");
    assert_entry_text(run_directory, executable, handle, FIXTURE_SEED, "after_unavailable");

    print("STEP focus moves AT-SPI focus to the named GTK entry");
    run_cu(run_directory, executable, "observe,actuate", [
      "focus", "--window", handle, "--name", ENTRY_NAME,
    ]);
    const focused = run_cu(run_directory, executable, "observe", [
      "focused", "--window", handle,
    ]);
    ensure(
      text_at(focused, "data.node.name") === ENTRY_NAME,
      "cu_linux_gtk_entry_paste_focused:" + JSON.stringify(focused.data)
    );

    print("STEP clear the entry so paste read-back is unambiguous");
    run_cu(run_directory, executable, "observe,actuate", [
      "send-text", "--window", handle, "--name", ENTRY_NAME, "--", "",
    ]);
    assert_entry_text(run_directory, executable, handle, "", "cleared");

    print("STEP get-extents --name locates the GTK entry before paste actuate/read-back court");
    const entry_extents = run_cu(run_directory, executable, "observe", [
      "get-extents", "--window", handle, "--name", ENTRY_NAME,
    ]);
    ensure(
      text_at(entry_extents, "data.matched.name") === ENTRY_NAME
        && int_at(entry_extents, "data.extents.width") > 0
        && int_at(entry_extents, "data.extents.height") > 0,
      "cu_linux_gtk_entry_paste_extents_before_actuate:" + JSON.stringify(entry_extents.data)
    );

    const paste_seeds = [
      "ceo9-paste-r1-" + context.run_id + " ≠ 你好",
      "ceo9-paste-r2-" + context.run_id + " π≈3.14",
    ];
    ensure(paste_seeds.length >= PASTE_ROUND_COUNT, "cu_linux_gtk_entry_paste_seed_count");

    for (let round = 1; round <= PASTE_ROUND_COUNT; round += 1) {
      const seed = paste_seeds[round - 1];
      print("STEP round " + round + "/" + PASTE_ROUND_COUNT + ": clipboard-clear before publishing UTF-8 SEED");
      run_cu(run_directory, executable, "observe,actuate", [
        "clipboard-clear", "--apply",
      ]);
      print("STEP round " + round + "/" + PASTE_ROUND_COUNT + ": clipboard-write publishes UTF-8 SEED");
      const written = run_cu(run_directory, executable, "actuate", [
        "clipboard-write", "--type", text_type, "--text", seed,
      ]);
      ensure(
        text_at(written, "data.type") === text_type
          && flag_at(written, "data.verified"),
        "cu_linux_gtk_entry_paste_clipboard_write_r" + round + ":" + JSON.stringify(written.data)
      );
      if (round === 1) {
        harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-clipboard-write");
      }

      print("STEP round " + round + "/" + PASTE_ROUND_COUNT + ": paste --name writes clipboard SEED through AT-SPI");
      const pasted = run_cu(run_directory, executable, "observe,actuate", [
        "paste", "--window", handle, "--name", ENTRY_NAME,
      ]);
      ensure(
        text_at(pasted, "data.typed") === seed
          && text_at(pasted, "data.addressing") === "accessibility-tree"
          && flag_at(pasted, "data.clipboard"),
        "cu_linux_gtk_entry_paste_actuate_r" + round + ":" + JSON.stringify(pasted.data)
      );
      if (round === 1) {
        harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-paste");
      }

      print("STEP round " + round + "/" + PASTE_ROUND_COUNT + ": independent get-text --name reads SEED back");
      assert_entry_text(run_directory, executable, handle, seed, "after_paste_r" + round);
      print("STEP round " + round + "/" + PASTE_ROUND_COUNT + ": get-text --name with --coords/--bogus rejects or stays gettext");
      assert_get_text_reject_coords_or_stay_named(
        run_directory, executable, handle, seed, "round_" + round
      );
      if (round === PASTE_ROUND_COUNT) {
        harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-paste-get-text");
        print("STEP paste --name with --coords/--bogus rejects or stays accessibility-tree");
        assert_paste_reject_coords_or_stay_named(run_directory, executable, handle, "final");
      }
    }

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_gtk_entry_paste_failed");
if (atspi_available) {
  print("PASS: CEO#9 GTK entry clipboard-write → " + PASTE_ROUND_COUNT + " paste --name → get-text roundtrips with typed paste/get-text --coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty (no atspi gating), process-state/desktop-state courts before actuate, and independent get-text == SEED (AT-SPI --name, no --coords)");
} else {
  print("PASS: CEO#9 GTK entry paste/get-text typed-fails with typed get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
}
