// CEO: Linux CDP page-files honesty — set files on input[type=file] without a
// native picker; prove with independent page-js FileList basename+size
// read-back (not receipt paths). Typed page-files usage rejects AT-SPI
// --name/--bogus and missing selector/files; typed get-extents --name
// usage/host-limit paths must hold before the page-files actuate/read-back
// court. Typed usage, miss, and no-CDP host-limit paths must hold.
// Disposable Chrome+CDP; --port/--target-id/--selector only; no --coords.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-cdp-page-files",
  "cu.linux-cdp-page-files-readback",
];

const AT_SPI_PROBE_NAME = "Page Files Court Anchor";
const MISSING_NODE = "agenterm-no-such-page-files-node";
const UPLOAD_BASENAME = "smoke-upload.txt";
const UPLOAD_PAYLOAD = "hello-files-smoke";
const FILE_LIST_EXPR = "(function(){var el=document.getElementById('upload');if(!el||!el.files)return'[]';var out=[];for(var i=0;i<el.files.length;i++){out.push({name:el.files[i].name,size:el.files[i].size});}return JSON.stringify(out);})()";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function output_success(document) { return flag_at(document, "ok"); }

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_page_files_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(document), "cu_linux_page_files_reply:" + JSON.stringify(document));
  return document;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_message_rejects_extra_tokens(message) {
  return message.indexOf("--name") >= 0
    || message.indexOf("unexpected") >= 0
    || message.indexOf("absolute paths") >= 0
    || message.indexOf("--bogus") >= 0;
}

function assert_page_files_usage(run_directory, executable, env, port) {
  const missing_selector = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-files", "--port", "" + port, "--target-id", "unused",
  ], env);
  ensure(!output_success(missing_selector),
    "cu_linux_page_files_usage_ok_selector:" + JSON.stringify(missing_selector));
  ensure(
    text_at(missing_selector, "error.code") === "usage",
    "cu_linux_page_files_usage_code_selector:" + JSON.stringify(missing_selector.error)
  );
  ensure(
    text_at(missing_selector, "error.message").indexOf("--selector") >= 0
      || text_at(missing_selector, "error.message").indexOf("--node") >= 0,
    "cu_linux_page_files_usage_message_selector:" + JSON.stringify(missing_selector.error)
  );

  const missing_files = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-files", "--port", "" + port, "--target-id", "unused",
    "--selector", "#upload",
  ], env);
  ensure(!output_success(missing_files),
    "cu_linux_page_files_usage_ok_files:" + JSON.stringify(missing_files));
  ensure(
    text_at(missing_files, "error.code") === "usage",
    "cu_linux_page_files_usage_code_files:" + JSON.stringify(missing_files.error)
  );
  ensure(
    text_at(missing_files, "error.message").indexOf("local files") >= 0,
    "cu_linux_page_files_usage_message_files:" + JSON.stringify(missing_files.error)
  );
}

function assert_page_files_usage_rejects_name(run_directory, executable, env, port, upload_path) {
  const flat_with_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-files", "--port", "" + port, "--target-id", "unused",
    "--selector", "#upload", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_page_files_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_page_files_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_page_files_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    usage_message_rejects_extra_tokens(text_at(flat_with_name, "error.message")),
    "cu_linux_page_files_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page", "files", "--port", "" + port, "--target-id", "unused",
    "--selector", "#upload", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_page_files_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_page_files_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    usage_message_rejects_extra_tokens(text_at(grouped_with_name, "error.message")),
    "cu_linux_page_files_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-files", "--port", "" + port, "--target-id", "unused",
    "--selector", "#upload", upload_path, "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_page_files_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_page_files_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    usage_message_rejects_extra_tokens(text_at(with_bogus, "error.message")),
    "cu_linux_page_files_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_page_files_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_page_files_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_page_files_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_page_files_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_page_files_extents_unavailable_code:" + code
  );
}

function assert_get_extents_missing_node(run_directory, executable, env, handle, label) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", MISSING_NODE,
  ], env);
  ensure(!output_success(reply), "cu_linux_page_files_extents_missing_ok_" + label);
  ensure(
    text_at(reply, "error.code") === "a11y_node_not_found",
    "cu_linux_page_files_extents_missing_code_" + label + ":" + JSON.stringify(reply.error)
  );
}

function windows_rows(reply) {
  const data = at(reply, "data");
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function window_row_for_title(run_directory, executable, env, title_needle) {
  const reply = run_cu(run_directory, executable, "observe", ["windows"], env);
  for (const row of windows_rows(reply)) {
    const title = text_at(row, "title");
    if (title.indexOf(title_needle) < 0) { continue; }
    const handle = int_at(row, "handle");
    if (handle > 0) { return row; }
  }
  return null;
}

function assert_no_cdp_listener(run_directory, executable, env, port, upload_path) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-files", "--port", "" + port, "--target-id", "unused",
    "--selector", "#upload", upload_path,
  ], env);
  ensure(reply.ok !== true, "cu_linux_page_files_false_success:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_page_files_host_limit_code:" + JSON.stringify(reply)
  );
  const message = text_at(reply, "error.message");
  ensure(
    message.indexOf("no CDP listener") >= 0 && message.indexOf("" + port) >= 0,
    "cu_linux_page_files_host_limit_message:" + JSON.stringify(reply.error)
  );
}

function assert_page_files_miss_bad_target(run_directory, executable, env, port, upload_path) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-files", "--port", "" + port, "--target-id", "deadbeef",
    "--selector", "#upload", upload_path,
  ], env);
  ensure(!output_success(reply), "cu_linux_page_files_miss_target_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "cdp_target_not_found",
    "cu_linux_page_files_miss_target_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("--target-id") >= 0,
    "cu_linux_page_files_miss_target_message:" + JSON.stringify(reply.error)
  );
}

function page_js_text(run_directory, executable, env, port, target_id, expression) {
  const read = run_cu(run_directory, executable, "observe", [
    "page-js", "--port", "" + port, "--target-id", target_id,
    "--expression", expression,
  ], env);
  return text_at(read, "data.value");
}

function file_list_json(run_directory, executable, env, port, target_id) {
  return page_js_text(run_directory, executable, env, port, target_id, FILE_LIST_EXPR);
}

function page_target(rows) {
  for (const row of rows) {
    if (text_at(row, "type") === "page") { return row; }
  }
  return null;
}

function cdp_ready(run_directory, port) {
  const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  return probe.success === true && probe.stdout.indexOf("Browser") >= 0;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "cu_linux_page_files_executable_missing:" + executable);
ensure(direct_file(abi_library), "cu_linux_page_files_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-page-files");
const run_directory = context.run_directory;
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_title = "CEO CDP Files " + context.run_id;
const fixture = rh.join(run_directory, "cdp-files.html");
const fixture_html = "<!DOCTYPE html><html><head><title>"
  + fixture_title + "</title></head><body>"
  + "<input id='upload' type='file' aria-label='" + AT_SPI_PROBE_NAME + "'>"
  + "</body></html>";
rh.write_text(fixture, fixture_html);

const upload_path = rh.join(run_directory, UPLOAD_BASENAME);
rh.write_text(upload_path, UPLOAD_PAYLOAD);
const expected_bytes = UPLOAD_PAYLOAD.length;
const expected_file_list = JSON.stringify([{ name: UPLOAD_BASENAME, size: expected_bytes }]);

const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
const port = 9800 + (rh.pid() % 350);
let chrome_child = -1;
let succeeded = 0;
let failure = "";

try {
  const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  ensure(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
    "cu_linux_page_files_port_in_use:" + port);

  print("STEP page-files typed-fails usage when --selector or FILE... is missing");
  assert_page_files_usage(run_directory, executable, env, port);

  print("STEP page-files typed-fails usage when AT-SPI --name or other unexpected arguments are present");
  assert_page_files_usage_rejects_name(run_directory, executable, env, port, upload_path);

  print("STEP page-files typed-fails no CDP listener on the owned free port before Chrome starts");
  assert_no_cdp_listener(run_directory, executable, env, port, upload_path);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before page-files actuate court");
    assert_get_extents_usage_limit(run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
  }

  print("STEP launch owned Chrome with CDP port and a disposable about:blank tab");
  chrome_child = harness.start({
    program: launcher,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--new-window",
      "about:blank",
    ],
    current_dir: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  for (let attempt = 0; attempt < 80 && !cdp_ready(run_directory, port); attempt = attempt + 1) {
    harness.sleep_ms(250);
  }
  ensure(cdp_ready(run_directory, port), "cu_linux_page_files_cdp_not_ready:" + port);

  print("STEP page-files typed-fails cdp_target_not_found for a bogus --target-id");
  assert_page_files_miss_bad_target(run_directory, executable, env, port, upload_path);

  const targets = run_cu(run_directory, executable, "observe", [
    "page-targets", "--port", "" + port,
  ], env);
  const target = page_target(targets.data.targets);
  ensure(target !== null && text_at(target, "id") !== "", "cu_linux_page_files_target_missing");
  const target_id = text_at(target, "id");

  print("STEP page-nav loads the disposable HTML fixture in this owned tab");
  const nav_url = "file://" + fixture;
  const nav = run_cu(run_directory, executable, "observe,actuate", [
    "page-nav", "--port", "" + port, "--target-id", target_id,
    "--url", nav_url, "--wait-ms", "10000",
  ], env);
  ensure(
    flag_at(nav, "data.verified") && text_at(nav, "data.final_title") === fixture_title,
    "cu_linux_page_files_nav:" + JSON.stringify(nav.data)
  );

  if (atspi_available) {
    print("STEP wait for owned Chrome window before named get-extents court");
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "20000", "--window-title-contains", fixture_title,
    ], env);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_page_files_window_wait");

    let window_row = null;
    for (let attempt = 0; attempt < 40 && window_row === null; attempt = attempt + 1) {
      window_row = window_row_for_title(run_directory, executable, env, fixture_title);
      if (window_row === null) { harness.sleep_ms(250); }
    }
    ensure(window_row !== null, "cu_linux_page_files_window_missing:" + fixture_title);
    const window_handle = "" + int_at(window_row, "handle");
    ensure(window_handle !== "" && window_handle !== "0",
      "cu_linux_page_files_window_handle:" + JSON.stringify(window_row));

    const unlocked = run_cu(run_directory, executable, "observe,actuate", [
      "unlock", "--window", window_handle,
    ], env);
    ensure(flag_at(unlocked, "data.poked"), "cu_linux_page_files_unlock:" + JSON.stringify(unlocked.data));

    print("STEP get-extents typed-fail a11y_node_not_found when the named anchor is missing");
    assert_get_extents_missing_node(run_directory, executable, env, window_handle, "before_files");
  }

  print("STEP independent page-js baseline proves FileList starts empty before page-files");
  const before_list = file_list_json(run_directory, executable, env, port, target_id);
  ensure(
    before_list === "[]",
    "cu_linux_page_files_before:" + JSON.stringify({ file_list: before_list })
  );

  print("STEP page-files --selector sets the upload without opening a native picker");
  const files = run_cu(run_directory, executable, "observe,actuate", [
    "page-files", "--port", "" + port, "--target-id", target_id,
    "--selector", "#upload", upload_path,
  ], env);
  ensure(
    files.command === "page-files" && flag_at(files, "data.verified"),
    "cu_linux_page_files_actuate:" + JSON.stringify(files.data)
  );
  ensure(
    flag_at(files, "data.performed") && flag_at(files, "data.focus_changed") === false,
    "cu_linux_page_files_authority:" + JSON.stringify(files.data)
  );
  const verification = at(files, "data.verification");
  const observed = verification.observed;
  ensure(
    observed !== undefined && observed.length === 1
      && text_at(observed[0], "name") === UPLOAD_BASENAME
      && int_at(observed[0], "size") === expected_bytes,
    "cu_linux_page_files_receipt_observed:" + JSON.stringify(verification)
  );
  ensure(
    JSON.stringify(files).indexOf(upload_path) < 0,
    "cu_linux_page_files_path_leak:" + JSON.stringify(files)
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-cdp-page-files");

  print("STEP independent page-js read-back proves FileList basename+size");
  let readback_list = "";
  for (let attempt = 0; attempt < 40 && readback_list !== expected_file_list; attempt = attempt + 1) {
    readback_list = file_list_json(run_directory, executable, env, port, target_id);
    if (readback_list !== expected_file_list) { harness.sleep_ms(250); }
  }
  ensure(
    readback_list === expected_file_list,
    "cu_linux_page_files_readback:" + JSON.stringify({
      expected: expected_file_list,
      observed: readback_list,
    })
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-cdp-page-files-readback");

  print("STEP MCU page files spelling sets the same input again after clearing via page-js");
  page_js_text(run_directory, executable, env, port, target_id,
    "(function(){var el=document.getElementById('upload');if(el){el.value='';}return'cleared';})()");
  let cleared_list = file_list_json(run_directory, executable, env, port, target_id);
  ensure(cleared_list === "[]", "cu_linux_page_files_cleared:" + cleared_list);
  const grouped = run_cu(run_directory, executable, "observe,actuate", [
    "page", "files", "--port", "" + port, "--target-id", target_id,
    "--selector", "#upload", upload_path,
  ], env);
  ensure(
    grouped.command === "page-files" && flag_at(grouped, "data.verified"),
    "cu_linux_page_files_grouped:" + JSON.stringify(grouped.data)
  );
  let regrouped_list = "";
  for (let attempt = 0; attempt < 40 && regrouped_list !== expected_file_list; attempt = attempt + 1) {
    regrouped_list = file_list_json(run_directory, executable, env, port, target_id);
    if (regrouped_list !== expected_file_list) { harness.sleep_ms(250); }
  }
  ensure(
    regrouped_list === expected_file_list,
    "cu_linux_page_files_grouped_readback:" + JSON.stringify({
      expected: expected_file_list,
      observed: regrouped_list,
    })
  );

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup: " + error); }
}

ensure(succeeded === 1, failure || "cu_linux_page_files_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux CDP page-files usage/miss/host-limit honesty + independent page-js FileList read-back with typed page-files/get-extents usage honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux CDP page-files usage/miss/host-limit honesty + independent page-js FileList read-back with typed get-extents host-limit honesty (AT-SPI --name, no --coords)");
}
return;
