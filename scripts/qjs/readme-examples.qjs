// Verify that README artifact roles and public command examples agree with
// offline machine-readable product catalogs. Moved from rh on 2026-08-29.
//
// Args: [ARTIFACT_ROOT] [--skip-executable-probes]
//
// Runs under `--profile tool`.
import * as rh from "lib/rh_compat";

const args = [];
for (let i = 0; i < arg_count(); i = i + 1) {
  if (arg(i) !== 0) { throw "arg: " + tool_result(); }
  args.push(tool_result());
}

const repo = rh.cwd();
let artifact_root = rh.join(repo, "dist");
if (args.length > 0) {
  artifact_root = rh.absolute(args[0]);
}
let skip_probes = 0;
if (args.length > 1 && args[1] === "--skip-executable-probes") {
  skip_probes = 1;
}

const manifest_path = rh.join(repo, "scripts/artifacts.json");
const manifest = JSON.parse(rh.read_text(manifest_path));
rh.require(manifest.schema_version === 2, "readme_artifact_manifest_schema");

const readme_path = rh.join(repo, "README.md");
const readme = rh.read_text(readme_path);
let normalized_readme = readme;
normalized_readme = normalized_readme.replaceAll("\r", " ");
normalized_readme = normalized_readme.replaceAll("\n", " ");
normalized_readme = normalized_readme.replaceAll("\t", " ");
// Bounded collapse of runs of spaces (README roles are short phrases).
// rh ran all 16 passes unconditionally; a pass over a string with no "  "
// left is a no-op, and here it costs steps the budget does not have (16
// passes over 16 KB exhausted max_steps), so the loop stops at the same
// fixed point the 16th pass would have reached.
for (let space_pass = 1; space_pass <= 16; space_pass = space_pass + 1) {
  if (!normalized_readme.includes("  ")) { break; }
  normalized_readme = normalized_readme.replaceAll("  ", " ");
}
normalized_readme = normalized_readme.trim();

for (const artifact of manifest.executables) {
  const artifact_name = "" + artifact.name;
  rh.require(
    readme.includes(artifact_name),
    "README does not name manifest artifact '" + artifact_name + "'"
  );
  let role = "" + artifact.documentation_role;
  role = role.replaceAll("\r", " ");
  role = role.replaceAll("\n", " ");
  role = role.replaceAll("\t", " ");
  for (let role_space = 1; role_space <= 8; role_space = role_space + 1) {
    if (!role.includes("  ")) { break; }
    role = role.replaceAll("  ", " ");
  }
  role = role.trim();
  rh.require(
    normalized_readme.includes(role),
    "README does not describe '" + artifact_name + "' as '" + role + "'"
  );
}

rh.require(
  readme.includes(".\\build.bat"),
  "README is missing required executable example '.\\build.bat'"
);
rh.require(
  readme.includes(".\\check.cmd"),
  "README is missing required executable example '.\\check.cmd'"
);
rh.require(
  readme.includes(".\\dist\\agenterm.exe"),
  "README is missing required executable example '.\\dist\\agenterm.exe'"
);

if (skip_probes === 0) {
  const no_activate = { env: { AGENTERM_NO_ACTIVATE: "1" }, timeout_ms: 10000 };
  for (const artifact of manifest.executables) {
    const probe_len = artifact.offline_probe.length;
    if (probe_len === 0) {
      continue;
    }
    const artifact_name = "" + artifact.name;
    const executable = rh.join(artifact_root, artifact_name);
    rh.require(
      rh.exists(executable),
      "README probe artifact is missing: " + executable
    );
    let probe_code = 1;
    if (artifact_name === "agenterm-rh.exe") {
      probe_code = rh.command_status(executable, ["version"], no_activate);
    } else {
      probe_code = rh.command_status(executable, ["--version"], no_activate);
    }
    rh.require(
      probe_code === 0,
      "Offline README probe failed for '" + artifact_name + "'"
    );
  }

  const stdout_path = rh.join(repo, ".readme-examples.stdout.tmp");
  const cli_path = rh.join(artifact_root, "agenterm.exe");
  const cli_code = rh.command_stdout_file(
    cli_path,
    ["cli", "list-commands"],
    stdout_path,
    no_activate
  );
  rh.require(cli_code === 0, "readme-cli-command-catalog");
  const cli_stdout = rh.read_text(stdout_path);
  const cli_names = {};
  for (const source_line of cli_stdout.split("\n")) {
    const line = source_line.trim();
    if (line === "") {
      continue;
    }
    const fields = line.split(" ");
    rh.require(fields.length > 0, "readme-cli-command-catalog-line");
    const command_key = fields[0];
    cli_names[command_key] = true;
  }

  for (const source_line of readme.split("\n")) {
    const line = source_line.trim();
    if (!line.startsWith("& $r ")) {
      continue;
    }
    const fields = [];
    for (const source_field of line.split(" ")) {
      const field = source_field.trim();
      if (field !== "") {
        fields.push(field);
      }
    }
    rh.require(fields.length >= 4, "README contains an invalid agenterm cli example");
    rh.require(fields[2] === "cli", "README CLI example is missing the cli subcommand");
    let command_index = 3;
    const maybe_address = fields[3];
    if (maybe_address === "--address") {
      command_index = 5;
    }
    rh.require(
      fields.length > command_index,
      "README contains an incomplete agenterm cli example"
    );
    let command_name = fields[command_index];
    command_name = command_name.replaceAll("\"", "");
    rh.require(
      cli_names[command_name] === true,
      "README references unknown agenterm cli command '" + command_name + "'"
    );
  }

  // Through the `cli` subcommand, like the list-commands probe above:
  // the standalone mux/mcp PEs were dropped in 7b930b9c ("CLI
  // subcommands only"), so bare `agenterm.exe mux ...` now falls
  // through to the GUI launcher's argument handling and never runs the
  // command. That probe was missed by that migration.
  const mux_code = rh.command_stdout_file(
    cli_path,
    ["cli", "mux", "compatibility", "--json"],
    stdout_path,
    no_activate
  );
  rh.require(mux_code === 0, "readme-mux-compatibility");
  const mux_text = rh.read_text(stdout_path);
  const compatibility = JSON.parse(mux_text);
  rh.require(
    compatibility.schema_version > 0,
    "README mux compatibility example returned an invalid catalog"
  );
  rh.try_remove_file(stdout_path);
}

const executable_count = manifest.executables.length;
print(
  "PASS: README names " + executable_count +
  " manifest artifacts and its command examples match the offline catalogs."
);
return;
