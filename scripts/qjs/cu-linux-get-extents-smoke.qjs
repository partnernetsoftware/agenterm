// CEO: Linux get-extents honesty with independent AT-SPI Component.GetExtents(Screen)
// read-back. Acceptance is smoke read-back only: CU get-extents --name for
// owned GTK fixture nodes must agree with a separate pyatspi Component
// query on the same named node, both must typed-fail for unreadable rects,
// and typed usage/miss/host-limit paths must hold when addressing is invalid
// or the independent pyatspi desktop probe is unavailable.
// AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-get-extents-readback",
];

const READABLE_NODES = [
  "Fixture Press",
  "Fixture Entry",
  "Fixture Drag Source",
  "Fixture Drag Target",
  "Fixture Wheel Target",
];

const UNAVAILABLE_NODE = "Do Thing";
const MISS_NODE = "agenterm-no-such-node-xyz";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu(run_directory, executable, grant, cu_args) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_get_extents_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_get_extents_empty");
  return JSON.parse(trimmed);
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_get_extents_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available() {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(""),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_extents_usage_limit(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "0", "--name", "Fixture Press",
  ]);
  ensure(!flag_at(reply, "ok"), "cu_linux_get_extents_usage_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "invalid_input",
    "cu_linux_get_extents_usage_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("window") >= 0,
    "cu_linux_get_extents_usage_message:" + JSON.stringify(reply.error)
  );
}

function assert_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "1", "--name", "Fixture Press",
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!flag_at(reply, "ok"), "cu_linux_get_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle",
    "cu_linux_get_extents_unavailable_code:" + code
  );
  if (code === "a11y_backend_failed") {
    const message = text_at(reply, "error.message").toLowerCase();
    ensure(
      message.indexOf("accessibility") >= 0
        || message.indexOf("address") >= 0
        || message.indexOf("bus") >= 0,
      "cu_linux_get_extents_unavailable_message:" + JSON.stringify(reply.error)
    );
  }
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  ensure(flag_at(reply, "ok"), "cu_linux_get_extents_windows:" + JSON.stringify(reply));
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_probe_script() {
  return [
    "import json, sys",
    "import pyatspi",
    "",
    "config = json.loads(sys.argv[1])",
    "title = config['title']",
    "name = config['name']",
    "I32_MIN = -2147483648",
    "",
    "def node_name(obj):",
    "    try: return obj.name or ''",
    "    except Exception: return ''",
    "",
    "def is_readable(x, y, width, height):",
    "    return width > 0 and height > 0 and x != I32_MIN and y != I32_MIN",
    "",
    "def find_named(root, needle):",
    "    if node_name(root) == needle:",
    "        return root",
    "    try: child_count = root.childCount",
    "    except Exception: child_count = 0",
    "    for index in range(child_count):",
    "        try: child = root.getChildAtIndex(index)",
    "        except Exception: child = None",
    "        if child is None: continue",
    "        found = find_named(child, needle)",
    "        if found is not None: return found",
    "    return None",
    "",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "application = None",
    "for candidate in desktop:",
    "    try:",
    "        for index in range(candidate.childCount):",
    "            window = candidate.getChildAtIndex(index)",
    "            if window is not None and node_name(window) == title:",
    "                application = candidate",
    "                break",
    "        if application is not None: break",
    "    except Exception: continue",
    "if application is None:",
    "    raise SystemExit('cu_linux_get_extents_probe_window_missing')",
    "",
    "node = find_named(application, name)",
    "if node is None:",
    "    raise SystemExit('cu_linux_get_extents_probe_node_missing:' + name)",
    "",
    "try:",
    "    component = node.queryComponent()",
    "    x, y, width, height = component.getExtents(pyatspi.DESKTOP_COORDS)",
    "except Exception as error:",
    "    print(json.dumps({'available': False, 'reason': str(error)}))",
    "    raise SystemExit(0)",
    "",
    "print(json.dumps({",
    "    'available': is_readable(x, y, width, height),",
    "    'x': x, 'y': y, 'width': width, 'height': height,",
    "}))",
  ].join("\n");
}

function independent_extents(run_directory, title, node_name) {
  const output = rh.command(
    "python3",
    ["-c", independent_probe_script(), JSON.stringify({ title: title, name: node_name })],
    { cwd: run_directory, env: cu_env(""), timeout_ms: 45000 },
  );
  ensure(output.success === true, "cu_linux_get_extents_probe:" + output.stderr + output.stdout);
  const document = JSON.parse(output.stdout.trim());
  return document;
}

function independent_node_presence_script() {
  return [
    "import json, sys",
    "import pyatspi",
    "",
    "config = json.loads(sys.argv[1])",
    "title = config['title']",
    "name = config['name']",
    "",
    "def node_name(obj):",
    "    try: return obj.name or ''",
    "    except Exception: return ''",
    "",
    "def find_named(root, needle):",
    "    if node_name(root) == needle:",
    "        return root",
    "    try: child_count = root.childCount",
    "    except Exception: child_count = 0",
    "    for index in range(child_count):",
    "        try: child = root.getChildAtIndex(index)",
    "        except Exception: child = None",
    "        if child is None: continue",
    "        found = find_named(child, needle)",
    "        if found is not None: return found",
    "    return None",
    "",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "application = None",
    "for candidate in desktop:",
    "    try:",
    "        for index in range(candidate.childCount):",
    "            window = candidate.getChildAtIndex(index)",
    "            if window is not None and node_name(window) == title:",
    "                application = candidate",
    "                break",
    "        if application is not None: break",
    "    except Exception: continue",
    "if application is None:",
    "    raise SystemExit('cu_linux_get_extents_probe_window_missing')",
    "",
    "node = find_named(application, name)",
    "print(json.dumps({'found': node is not None}))",
  ].join("\n");
}

function independent_node_found(run_directory, title, node_name) {
  const output = rh.command(
    "python3",
    ["-c", independent_node_presence_script(), JSON.stringify({ title: title, name: node_name })],
    { cwd: run_directory, env: cu_env(""), timeout_ms: 45000 },
  );
  ensure(output.success === true, "cu_linux_get_extents_presence:" + output.stderr + output.stdout);
  const document = JSON.parse(output.stdout.trim());
  return document.found === true;
}

function assert_extents_agreement(run_directory, executable, handle, title, node_name, label) {
  const cu = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", "" + handle, "--name", node_name,
  ]);
  ensure(flag_at(cu, "ok"), "cu_linux_get_extents_cu_ok_" + label + ":" + JSON.stringify(cu));
  ensure(text_at(cu, "data.via") === "get-extents", "cu_linux_get_extents_via_" + label);
  ensure(text_at(cu, "data.addressing") === "accessibility-tree", "cu_linux_get_extents_addressing_" + label);
  const probe = independent_extents(run_directory, title, node_name);
  ensure(
    probe.available === true,
    "cu_linux_get_extents_probe_readable_" + label + ":" + JSON.stringify(probe)
  );
  ensure(
    int_at(cu, "data.extents.x") === probe.x
      && int_at(cu, "data.extents.y") === probe.y
      && int_at(cu, "data.extents.width") === probe.width
      && int_at(cu, "data.extents.height") === probe.height,
    "cu_linux_get_extents_mismatch_" + label + ":" + JSON.stringify({
      cu: cu.data.extents,
      probe: probe,
    })
  );
}

function assert_extents_miss(run_directory, executable, handle, title, node_name, label) {
  const cu = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "" + handle, "--name", node_name,
  ]);
  ensure(
    !flag_at(cu, "ok") && text_at(cu, "error.code") === "a11y_node_not_found",
    "cu_linux_get_extents_cu_miss_" + label + ":" + JSON.stringify(cu)
  );
  ensure(
    text_at(cu, "error.message").indexOf(node_name) >= 0,
    "cu_linux_get_extents_miss_message_" + label + ":" + JSON.stringify(cu.error)
  );
  ensure(
    !independent_node_found(run_directory, title, node_name),
    "cu_linux_get_extents_probe_should_miss_" + label
  );
}

function assert_extents_unavailable(run_directory, executable, handle, title, node_name, label) {
  const cu = run_cu_reply(run_directory, executable, "observe", [
    "get-extents", "--window", "" + handle, "--name", node_name,
  ]);
  ensure(
    !flag_at(cu, "ok") && text_at(cu, "error.code") === "a11y_extents_unavailable",
    "cu_linux_get_extents_cu_unavailable_" + label + ":" + JSON.stringify(cu)
  );
  const probe = independent_extents(run_directory, title, node_name);
  ensure(
    probe.available !== true,
    "cu_linux_get_extents_probe_should_refuse_" + label + ":" + JSON.stringify(probe)
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-get-extents");
const run_directory = rh.join(repo, "target/cu-linux-get-extents-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_get_extents_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const atspi_available = probe_atspi_available();

try {
  if (!atspi_available) {
    print("STEP typed host-limit when independent pyatspi desktop probe is unavailable");
    assert_extents_usage_limit(run_directory, executable);
    assert_extents_host_limit_when_atspi_absent(run_directory, executable);
    succeeded = 1;
  } else {
    print("STEP get-extents typed-fails invalid_input when --window handle is zero");
    assert_extents_usage_limit(run_directory, executable);

    print("STEP start owned GTK fixture and resolve window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "ok") && flag_at(window_wait, "data.met"), "cu_linux_get_extents_window_wait");

    const inventory_row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(inventory_row !== null, "cu_linux_get_extents_window_identity");
    const handle = int_at(inventory_row, "handle");
    ensure(handle > 0, "cu_linux_get_extents_handle:" + JSON.stringify(inventory_row));

    for (let index = 0; index < READABLE_NODES.length; index = index + 1) {
      const node_name = READABLE_NODES[index];
      print("STEP get-extents --name " + node_name + " agrees with independent Component.GetExtents(Screen)");
      assert_extents_agreement(
        run_directory, executable, handle, fixture_title, node_name, "readable_" + index
      );
    }

    print("STEP get-extents typed-fails a11y_node_not_found when --name misses every showing node");
    assert_extents_miss(
      run_directory, executable, handle, fixture_title, MISS_NODE, "missing_node"
    );

    print("STEP get-extents typed-fails for closed menu item with unreadable AT-SPI rect");
    assert_extents_unavailable(
      run_directory, executable, handle, fixture_title, UNAVAILABLE_NODE, "closed_menu_item"
    );

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-get-extents-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux get-extents matches independent AT-SPI Component.GetExtents(Screen) read-back with usage/miss/unavailable honesty");
  } else {
    print("PASS: Linux get-extents typed-fails when independent pyatspi desktop probe is unavailable");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
