// Prove the agenterm-cu default loop through libagenterm's UI Automation
// backend on a real Windows desktop: capabilities -> windows -> bounded
// tree -> query -> invoke -> the background menu verbs -> focused ->
// window-place answering from a read-back -> a window screenshot -> the
// destructive close gate.
//
// This replaces a journey that was ported here in 2026-08 and never ran.
// That one compiled a Win32 fixture in the guest, which no guest on hand
// has a toolchain for, and its clipboard step depended on a door op that
// does not exist -- so it could not have run even with a compiler. What
// carried over is its shape: owned fixture, name-addressed actuation,
// window-place refusal and actuation, close only the owned window. What
// did not: the staged-host self-test, the persisted-grant walk, the
// clipboard comparison and the window-place audit read. Those are worth
// having and are not claimed here.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
//
// Runs under --profile tool on a Windows desktop, in an *interactive*
// session: UI Automation in session 0 sees no desktop at all, so a runner
// that reaches this host through a service or a guest agent has to hand
// off to the logged-on session first (the UTM court contract does that with
// an invocation-owned one-shot scheduled task).
//
// The owned fixture is examples/csharp/agenterm_uia_fixture.cs. The .NET
// Framework csc.exe already present on Windows compiles it, so no external C
// toolchain or PowerShell source/runtime is needed. Its controls are real
// Win32 controls with real UIA providers. It is spawned as a door handle;
// only the pid this run spawned is ever signalled. Every agenterm-cu call is
// `rh.command`, and the worker's JSON reply is parsed, never grepped.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.windows-uia-capabilities",
  "cu.windows-uia-window-identity",
  "cu.windows-process-state",
  "cu.windows-process-argv",
  "cu.windows-process-usage",
  "cu.windows-process-usage-watch",
  "cu.windows-process-wait",
  "cu.windows-process-kill",
  "cu.windows-process-lifecycle-watch",
  "cu.windows-network-probe",
  "cu.windows-file-inspect",
  "cu.windows-terminal-control",
  "cu.windows-uia-tree",
  "cu.windows-uia-query",
  "cu.windows-uia-invoke",
  "cu.windows-uia-menu",
  "cu.windows-window-activate",
  "cu.windows-uia-focused",
  "cu.windows-uia-window-place",
  "cu.windows-uia-screenshot",
  "cu.windows-uia-destructive-close",
  "cu.windows-uia-cleanup"
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) { return text_of(at(value, dotted)); }
function int_at(value, dotted) { return rh.int_of(at(value, dotted)); }
function flag_at(value, dotted) { return at(value, dotted) === true; }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

// Most Win32 APIs accept `/`, but csc.exe reserves it as the option prefix.
// Normalize only at that external compiler boundary; keep the shared path
// helpers platform-neutral.
function csc_path(value) {
  return ("" + value).replaceAll("/", "\\");
}

function remove_directory_bounded(path) {
  if (!rh.exists(path)) { return true; }
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    rh.try_remove_dir_all(path);
    if (!rh.exists(path)) { return true; }
    harness.sleep_ms(50);
  }
  return false;
}

let terminal_instance = "";

function cu_env(run_directory) {
  const environment = {
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl")
  };
  if (terminal_instance !== "") {
    environment.AGENTERM_INSTANCE = terminal_instance;
  }
  return environment;
}

function framework_csc() {
  const windows = rh.env_or("WINDIR", "C:/Windows");
  const candidates = [
    rh.join(windows, "Microsoft.NET/Framework64/v4.0.30319/csc.exe"),
    rh.join(windows, "Microsoft.NET/Framework/v4.0.30319/csc.exe")
  ];
  for (const candidate of candidates) {
    if (direct_file(candidate)) { return candidate; }
  }
  throw "cu_windows_smoke_framework_csc_missing";
}

function run_cu_json(run_directory, executable, arguments) {
  const output = rh.command(
    executable, arguments,
    { cwd: run_directory, env: cu_env(run_directory), timeout_ms: 30000 }
  );
  ensure(output.success === true, "cu_windows_smoke_cli_process:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_windows_smoke_cli_empty:" + output.stderr);
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_windows_smoke_cli_reply:" + JSON.stringify(document));
  return document;
}

function run_cu_reply(run_directory, executable, arguments) {
  const output = rh.command(
    executable, arguments,
    { cwd: run_directory, env: cu_env(run_directory), timeout_ms: 30000 }
  );
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_windows_smoke_cli_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "windows", "--pid", "" + pid
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function tree_nodes(run_directory, executable, handle_text) {
  const reply = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "tree",
    "--window", handle_text, "--max-nodes", "200"
  ]);
  return reply.data.nodes;
}

function assert_network_probe(reply, port, attempts, reachable) {
  const data = reply.data;
  ensure(
    text_of(data.provider) === "system-resolver-owned-worker"
      && text_of(data.host) === "127.0.0.1"
      && rh.int_of(data.port) === port
      && data.address_set_frozen === true
      && Array.isArray(data.resolved_addresses)
      && data.resolved_addresses.length === 1
      && rh.int_of(data.address_count) === 1
      && text_of(data.resolved_addresses[0].address) === "127.0.0.1"
      && text_of(data.resolved_addresses[0].family) === "ipv4"
      && Array.isArray(data.attempts)
      && data.attempts.length === attempts
      && rh.int_of(data.attempt_count) === attempts,
    "cu_windows_smoke_network_shape:" + JSON.stringify(data)
  );
  ensure(
    text_of(data.status) === (reachable ? "reachable" : "unreachable")
      && rh.int_of(data.connected_count) === (reachable ? attempts : 0)
      && rh.int_of(data.unreachable_count) === (reachable ? 0 : attempts),
    "cu_windows_smoke_network_status:" + JSON.stringify(data)
  );
  for (let index = 0; index < data.attempts.length; index = index + 1) {
    const row = data.attempts[index];
    ensure(
      rh.int_of(row.attempt) === index + 1
        && text_of(row.address) === text_of(data.resolved_addresses[0].address)
        && text_of(row.family) === text_of(data.resolved_addresses[0].family)
        && (reachable
          ? text_of(row.outcome) === "connected" && row.error_kind === null
          : text_of(row.outcome) !== "connected" && text_of(row.error_kind) !== ""),
      "cu_windows_smoke_network_attempt:" + JSON.stringify(row)
    );
  }
}

// A WinForms Label's UIA name is its displayed text, so these are read by
// what they currently say rather than by a stable name.
function label_starting_with(nodes, prefix) {
  for (const node of nodes) {
    if (text_of(node.name).startsWith(prefix)) { return text_of(node.name); }
  }
  return "";
}

function label_text(run_directory, executable, handle_text, prefix) {
  return label_starting_with(tree_nodes(run_directory, executable, handle_text), prefix);
}

// ---- entry ----------------------------------------------------------------

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_windows_smoke_executable_missing:" + executable);
ensure(
  direct_file(rh.join(rh.parent(executable), "agenterm.dll")),
  "cu_windows_smoke_library_missing:" + rh.parent(executable)
);

const context = harness.new_context(repo, "cu-windows");
const run_directory = rh.join(repo, "target/cu-windows-smoke-run");
terminal_instance = "cu-windows-" + context.run_id;
ensure(remove_directory_bounded(run_directory), "cu_windows_smoke_stale_directory_locked");
rh.create_dir_all(run_directory);

let succeeded = 0;
let failure = "";
let fixture_pid = 0;
let fixture = -1;
let fixture_reaped = false;
let short_pid = 0;
let short_child = -1;
let short_reaped = false;
let terminal_gui_pid = 0;
let terminal_gui = -1;
let terminal_gui_reaped = false;
let network_fixture = null;
let network_fixture_reaped = false;
let network_fixture_pid = 0;

try {
  print("STEP capabilities declare the UI Automation tree and query available on current");
  const version_output = rh.command(executable, ["--version"], { cwd: run_directory, timeout_ms: 30000 });
  ensure(
    version_output.success === true && version_output.stdout.trim().startsWith("agenterm-cu "),
    "cu_windows_smoke_version:" + version_output.stdout + version_output.stderr
  );
  const capabilities = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "capabilities"
  ]);
  ensure(
    text_at(capabilities, "data.capabilities.tree") === "Available"
      && text_at(capabilities, "data.verbs.tree.status") === "available"
      && text_at(capabilities, "data.verbs.screenshot.status") === "available",
    "cu_windows_smoke_capabilities:" + JSON.stringify(capabilities.data.capabilities)
  );
  // Windows has no per-application permission gate; saying so is a
  // different answer from reporting a grant nobody asked for.
  ensure(
    text_at(capabilities, "data.permissions.model") === "none",
    "cu_windows_smoke_permissions:" + JSON.stringify(capabilities.data.permissions)
  );
  const refused = run_cu_reply(run_directory, executable, ["--target", "current", "windows"]);
  ensure(
    !flag_at(refused, "ok") && text_at(refused, "error.code") === "refused",
    "cu_windows_smoke_refusal:" + JSON.stringify(refused)
  );

  print("STEP file-inspect reads one final entry without following links and binds metadata to one stable object identity");
  const file_fixture = rh.join(run_directory, "file-inspect-fixture.txt");
  rh.write_text(file_fixture, "file-inspect");
  const file_inspect = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "file", "inspect", file_fixture
  ]);
  ensure(
    text_at(capabilities, "data.verbs.file-inspect.status") === "available"
      && text_at(capabilities, "data.verbs.file-inspect.link_policy") === "never-follow-final-link"
      && text_at(file_inspect, "data.kind") === "file"
      && text_at(file_inspect, "data.size_bytes") === "12"
      && flag_at(file_inspect, "data.identity.available")
      && !flag_at(file_inspect, "data.followed_final_link"),
    "cu_windows_smoke_file_inspect:" + JSON.stringify(file_inspect)
  );
  const file_missing = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe", "file-inspect",
    rh.join(run_directory, "file-inspect-missing")
  ]);
  ensure(
    !flag_at(file_missing, "ok") && text_at(file_missing, "error.code") === "file_inspect_failed",
    "cu_windows_smoke_file_inspect_missing:" + JSON.stringify(file_missing)
  );

  print("STEP network-probe resolves loopback once, freezes the address set for exact reachable attempts, then reports the closed listener unreachable");
  ensure(
    text_at(capabilities, "data.verbs.network-probe.resolution")
        === "once-deduplicated-frozen"
      && text_at(capabilities, "data.verbs.network-probe.attempts")
        === "exact-round-robin",
    "cu_windows_smoke_network_contract:" + JSON.stringify(capabilities.data.verbs)
  );
  const network_attempts = 3;
  const network_stdout = rh.join(run_directory, "network-fixture.stdout");
  const network_stderr = rh.join(run_directory, "network-fixture.stderr");
  rh.try_remove_file(network_stdout);
  rh.try_remove_file(network_stderr);
  network_fixture = harness.start_child(context, {
    program: executable,
    args: [
      "--agenterm-cu-internal-network-probe-fixture",
      "" + network_attempts,
      "30000"
    ],
    current_dir: run_directory,
    env: { AGENTERM_CU_INTERNAL_TEST_FIXTURE: "1" },
    timeout_ms: 35000,
    stdout_path: network_stdout,
    stderr_path: network_stderr
  }, "network-probe-fixture");
  network_fixture_pid = network_fixture.pid;
  let network_header = null;
  for (let attempt = 0; attempt < 400; attempt = attempt + 1) {
    if (rh.exists(network_stdout)) {
      const header_text = rh.read_text(network_stdout).trim();
      if (header_text.startsWith("{") && header_text.endsWith("}")) {
        network_header = JSON.parse(header_text);
        break;
      }
    }
    ensure(
      harness.child_state(network_fixture) !== "exited",
      "cu_windows_smoke_network_fixture_early_exit"
    );
    harness.sleep_ms(25);
  }
  ensure(network_header !== null, "cu_windows_smoke_network_fixture_not_ready");
  const network_port = rh.int_of(network_header.port);
  ensure(network_port > 0 && network_port <= 65535, "cu_windows_smoke_network_fixture_port");
  const reachable = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "network-probe", "127.0.0.1",
    "--port", "" + network_port, "--attempts", "" + network_attempts,
    "--timeout-ms", "1000"
  ]);
  assert_network_probe(reachable, network_port, network_attempts, true);
  const network_fixture_output = harness.child_wait(network_fixture, 5000);
  network_fixture_reaped = true;
  ensure(
    network_fixture_output.success === true && network_fixture_output.exit_code === 0,
    "cu_windows_smoke_network_fixture_exit:" + JSON.stringify(network_fixture_output)
  );
  ensure(
    harness.process_present(network_fixture_pid) === 0,
    "cu_windows_smoke_network_fixture_orphan"
  );
  const unreachable_attempts = 2;
  const unreachable = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "network-probe", "127.0.0.1",
    "--port", "" + network_port, "--attempts", "" + unreachable_attempts,
    "--timeout-ms", "1000"
  ]);
  assert_network_probe(unreachable, network_port, unreachable_attempts, false);

  print("STEP start the owned WinForms fixture and resolve its two windows by pid and exact title");
  const fixture_source = csc_path(rh.join(repo, "examples/csharp/agenterm_uia_fixture.cs"));
  ensure(direct_file(fixture_source), "cu_windows_smoke_fixture_missing:" + fixture_source);
  const fixture_executable = csc_path(rh.join(run_directory, "agenterm-uia-fixture.exe"));
  const compile = rh.command(framework_csc(), [
    "/nologo", "/target:winexe", "/out:" + fixture_executable,
    "/reference:System.Windows.Forms.dll", "/reference:System.Drawing.dll",
    fixture_source
  ], { cwd: run_directory, timeout_ms: 60000 });
  ensure(
    compile.success === true && direct_file(fixture_executable),
    "cu_windows_smoke_fixture_compile:" + compile.stdout + compile.stderr
  );
  fixture = harness.start({
    program: fixture_executable,
    args: [],
    current_dir: run_directory,
    timeout_ms: 60000
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-win-fixture-" + fixture_pid;
  const second_title = "agenterm-win-second-" + fixture_pid;
  const window_wait = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "wait",
    "--timeout-ms", "30000", "--window-title-contains", fixture_title
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_windows_smoke_window_wait_not_met");
  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_windows_smoke_window_identity");
  const fixture_handle = int_at(row, "handle");
  ensure(
    fixture_handle > 0
      && int_at(row, "bounds.width") > 0
      && int_at(row, "bounds.height") > 0,
    "cu_windows_smoke_window_row:" + JSON.stringify(row)
  );
  const handle_text = "" + fixture_handle;

  print("STEP process-state binds the live owned fixture pid to a non-empty start identity");
  const process_state = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-state",
    "--pid", "" + fixture_pid
  ]);
  const process_identity = at(process_state, "data.start_identity");
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && flag_at(process_state, "data.verified")
      && typeof process_identity === "string"
      && process_identity !== "",
    "cu_windows_smoke_process_state:" + JSON.stringify(process_state.data)
  );

  print("STEP process argv preserves native boundaries and keeps plaintext behind explicit --values");
  const process_argv_hidden = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process", "argv", "" + fixture_pid,
    "--limit", "1"
  ]);
  const process_argv_visible = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-argv", "--pid", "" + fixture_pid,
    "--limit", "1", "--values"
  ]);
  const hidden_arg = process_argv_hidden.data.arguments[0];
  const visible_arg = process_argv_visible.data.arguments[0];
  ensure(
    text_at(process_argv_hidden, "data.start_identity") === process_identity
      && flag_at(process_argv_hidden, "data.verified")
      && !flag_at(process_argv_hidden, "data.values_included")
      && hidden_arg.value === undefined
      && text_of(hidden_arg.sha256).length === 64
      && rh.only_chars(text_of(hidden_arg.sha256), rh.HEX)
      && text_of(process_argv_visible.data.executable) !== ""
      && flag_at(process_argv_visible, "data.values_included")
      && text_of(visible_arg.value) !== ""
      && text_of(visible_arg.sha256) === text_of(hidden_arg.sha256),
    "cu_windows_smoke_process_argv"
  );

  print("STEP process-usage preserves that identity and publishes verified lossless counters");
  const process_usage = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-usage",
    "--pid", "" + fixture_pid
  ]);
  const cpu_time_ns = at(process_usage, "data.cpu_time_ns");
  const resident_bytes = at(process_usage, "data.resident_bytes");
  const page_faults_total = at(process_usage, "data.page_faults.total");
  ensure(
    int_at(process_usage, "data.pid") === fixture_pid
      && text_at(process_usage, "data.start_identity") === process_identity
      && flag_at(process_usage, "data.verified")
      && typeof cpu_time_ns === "string" && cpu_time_ns !== ""
      && rh.only_chars(cpu_time_ns, rh.DIGITS)
      && typeof resident_bytes === "string" && resident_bytes !== ""
      && rh.only_chars(resident_bytes, rh.DIGITS)
      && typeof page_faults_total === "string" && page_faults_total !== ""
      && rh.only_chars(page_faults_total, rh.DIGITS),
    "cu_windows_smoke_process_usage:" + JSON.stringify(process_usage.data)
  );
  print("STEP bounded process usage watch preserves one identity and stops at its sample ceiling");
  const usage_watch = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-usage",
    "--pid", "" + fixture_pid, "--watch-ms", "20", "--interval-ms", "5", "--max-samples", "2"
  ]);
  const usage_samples = at(usage_watch, "data.samples");
  ensure(
    Array.isArray(usage_samples) && usage_samples.length === 2
      && int_at(usage_watch, "data.emitted") === 2
      && flag_at(usage_watch, "data.truncated")
      && flag_at(usage_watch, "data.verified")
      && text_at(usage_watch, "data.start_identity") === process_identity
      && text_of(usage_samples[0].cpu_time_ns) !== ""
      && text_of(usage_samples[1].cpu_time_ns) !== "",
    "cu_windows_smoke_process_usage_watch:" + JSON.stringify(usage_watch.data)
  );
  print("STEP process-wait binds the same identity to the Windows process HANDLE and times out while the fixture remains live");
  const process_wait = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-wait",
    "--pid", "" + fixture_pid, "--start-identity", process_identity,
    "--timeout-ms", "5"
  ]);
  ensure(
    text_at(process_wait, "data.state") === "timeout"
      && !flag_at(process_wait, "data.completed")
      && flag_at(process_wait, "data.verified")
      && text_at(process_wait, "data.mechanism") === "native-process-reference",
    "cu_windows_smoke_process_wait:" + JSON.stringify(process_wait.data)
  );

  print("STEP process lifecycle watch reports the exact identity of an owned child that exits");
  // A cold PowerShell startup under an emulated x86_64 court can itself take
  // longer than the watch deadline. Use the Windows inbox native wait path so
  // this proves process lifecycle rather than PowerShell startup latency.
  short_child = harness.start({
    program: "cmd.exe",
    args: ["/d", "/c", "ping.exe", "-n", "2", "127.0.0.1"],
    current_dir: run_directory,
    timeout_ms: 5000
  });
  short_pid = harness.spawned_pid(short_child);
  const lifecycle = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-watch", "--pid", "" + short_pid,
    "--duration-ms", "10000", "--interval-ms", "20", "--max-events", "1", "--max-processes", "4"
  ]);
  const lifecycle_events = at(lifecycle, "data.events");
  ensure(
    Array.isArray(lifecycle_events) && lifecycle_events.length === 1
      && text_of(lifecycle_events[0].kind) === "exited"
      && int_at(lifecycle_events[0], "process.pid") === short_pid
      && text_of(lifecycle_events[0].process.start_identity)
        === text_of(lifecycle.data.baseline[0].start_identity)
      && !flag_at(lifecycle, "data.completed") && flag_at(lifecycle, "data.truncated"),
    "cu_windows_smoke_process_lifecycle_watch:" + JSON.stringify(lifecycle.data)
  );
  harness.wait(short_child, 5000);
  short_reaped = true;

  print("STEP terminal control binds scope+epoch+@tab, sends literal input, waits and reads the finalized remain-on-exit tab, and refuses a late send typed");
  const terminal_gui_executable = rh.join(rh.parent(executable), "agenterm.exe");
  ensure(direct_file(terminal_gui_executable), "cu_windows_smoke_terminal_gui_missing");
  terminal_gui = harness.start({
    program: terminal_gui_executable,
    args: [],
    current_dir: run_directory,
    env: {
      AGENTERM_INSTANCE: terminal_instance,
      AGENTERM_NO_ACTIVATE: "1"
    },
    timeout_ms: 60000
  });
  terminal_gui_pid = harness.spawned_pid(terminal_gui);
  let terminal_list = null;
  for (let attempt = 0; attempt < 80; attempt = attempt + 1) {
    const candidate = run_cu_reply(run_directory, executable, [
      "--target", "current", "--grant", "observe", "terminal-list"
    ]);
    if (flag_at(candidate, "ok") && Array.isArray(candidate.data.tabs)
        && candidate.data.tabs.length > 0
        && text_at(candidate, "data.active_tab_id").startsWith("@")) {
      terminal_list = candidate;
      break;
    }
    ensure(harness.state(terminal_gui) !== "exited", "cu_windows_smoke_terminal_gui_early_exit");
    harness.sleep_ms(100);
  }
  ensure(terminal_list !== null, "cu_windows_smoke_terminal_list_startup");
  const terminal_scope = text_at(terminal_list, "data.server_scope_id");
  const terminal_epoch = text_at(terminal_list, "data.server_epoch");
  const terminal_tab = text_at(terminal_list, "data.active_tab_id");
  ensure(
    terminal_scope.startsWith("agt-v1-")
      && terminal_epoch !== ""
      && text_at(terminal_list, "data.position.server_epoch") === terminal_epoch
      && terminal_tab.startsWith("@")
      && text_at(terminal_list, "data.identity") === "server-scope+epoch+tab-id",
    "cu_windows_smoke_terminal_identity:" + JSON.stringify(terminal_list.data)
  );
  let listed_tab = null;
  for (const tab of terminal_list.data.tabs) {
    if (text_of(tab.id) === terminal_tab) { listed_tab = tab; }
  }
  ensure(listed_tab !== null, "cu_windows_smoke_terminal_active_tab_missing");

  const terminal_token = "AGENTERM_CU_TERMINAL_" + context.run_id;
  // `cls` removes cmd.exe's echoed input line first, so the later screen
  // match proves command output reached the parser rather than merely seeing
  // the submitted bytes echoed by the shell.
  const literal_line = "cls & echo " + terminal_token + "\r";
  const terminal_send = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "terminal-send",
    "--tab", terminal_tab, "--", literal_line
  ]);
  ensure(
    text_at(terminal_send, "data.tab_id") === terminal_tab
      && int_at(terminal_send, "data.text_bytes") === literal_line.length
      && flag_at(terminal_send, "data.performed")
      && flag_at(terminal_send, "data.verified")
      && text_at(terminal_send, "data.verification") === "agenterm-control-receipt",
    "cu_windows_smoke_terminal_literal_send:" + JSON.stringify(terminal_send.data)
  );
  const terminal_contains = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "terminal-wait",
    "--tab", terminal_tab, "--contains", terminal_token, "--timeout-ms", "30000"
  ]);
  ensure(
    text_at(terminal_contains, "data.tab_id") === terminal_tab
      && text_at(terminal_contains, "data.state") === "matched"
      && flag_at(terminal_contains, "data.completed"),
    "cu_windows_smoke_terminal_contains:" + JSON.stringify(terminal_contains.data)
  );
  const terminal_read = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "terminal-read",
    "--tab", terminal_tab, "--max-bytes", "262144"
  ]);
  ensure(
    text_at(terminal_read, "data.tab_id") === terminal_tab
      && text_at(terminal_read, "data.read_kind") === "bounded-screen-snapshot"
      && at(terminal_read, "data.incremental_cursor") === null
      && text_at(terminal_read, "data.text").includes(terminal_token)
      && !flag_at(terminal_read, "data.truncated"),
    "cu_windows_smoke_terminal_read:" + JSON.stringify(terminal_read.data)
  );

  const terminal_exit = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "terminal-send",
    "--tab", terminal_tab, "--", "exit\r"
  ]);
  ensure(
    flag_at(terminal_exit, "data.performed") && flag_at(terminal_exit, "data.verified"),
    "cu_windows_smoke_terminal_exit_send:" + JSON.stringify(terminal_exit.data)
  );
  const terminal_finalized = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "terminal-wait",
    "--tab", terminal_tab, "--finalized", "--timeout-ms", "30000"
  ]);
  ensure(
    text_at(terminal_finalized, "data.tab_id") === terminal_tab
      && text_at(terminal_finalized, "data.state") === "matched"
      && flag_at(terminal_finalized, "data.completed"),
    "cu_windows_smoke_terminal_finalized:" + JSON.stringify(terminal_finalized.data)
  );
  const terminal_final_read = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "terminal-read", "--tab", terminal_tab
  ]);
  ensure(
    text_at(terminal_final_read, "data.text").includes(terminal_token),
    "cu_windows_smoke_terminal_final_read:" + JSON.stringify(terminal_final_read.data)
  );
  const terminal_after = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "terminal-list"
  ]);
  let retained_tab = null;
  for (const tab of terminal_after.data.tabs) {
    if (text_of(tab.id) === terminal_tab) { retained_tab = tab; }
  }
  ensure(
    text_at(terminal_after, "data.server_scope_id") === terminal_scope
      && text_at(terminal_after, "data.server_epoch") === terminal_epoch
      && retained_tab !== null && retained_tab.dead === true
      && int_at(retained_tab, "exit_code") === 0,
    "cu_windows_smoke_terminal_remain_on_exit:" + JSON.stringify(terminal_after.data)
  );
  const terminal_late_send = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "terminal-send",
    "--tab", terminal_tab, "--", "late-input"
  ]);
  ensure(
    !flag_at(terminal_late_send, "ok")
      && text_at(terminal_late_send, "error.code") === "terminal_not_writable",
    "cu_windows_smoke_terminal_late_send:" + JSON.stringify(terminal_late_send)
  );
  const terminal_shutdown = rh.command(
    terminal_gui_executable, ["cli", "shutdown"],
    {
      cwd: run_directory,
      env: {
        AGENTERM_INSTANCE: terminal_instance,
        AGENTERM_NO_ACTIVATE: "1"
      },
      timeout_ms: 30000
    }
  );
  ensure(
    terminal_shutdown.success === true,
    "cu_windows_smoke_terminal_shutdown:" + terminal_shutdown.stdout + terminal_shutdown.stderr
  );
  const terminal_gui_output = harness.wait(terminal_gui, 10000);
  terminal_gui_reaped = true;
  ensure(
    terminal_gui_output.success === true && terminal_gui_output.exit_code === 0,
    "cu_windows_smoke_terminal_gui_exit:" + JSON.stringify(terminal_gui_output)
  );

  print("STEP the bounded tree names the fixture's controls with real rectangles and a UIA backend");
  const nodes = tree_nodes(run_directory, executable, handle_text);
  ensure(text_at(capabilities, "data.mechanism") === "libagenterm", "cu_windows_smoke_mechanism");
  let press_button = null;
  let menu_bar = null;
  for (const node of nodes) {
    if (text_of(node.name) === "Fixture Press") { press_button = node; }
    if (text_of(node.role) === "menu bar") { menu_bar = node; }
  }
  ensure(press_button !== null, "cu_windows_smoke_button_missing:" + nodes.length);
  ensure(
    int_at(press_button, "bounds.width") > 0 && int_at(press_button, "bounds.height") > 0,
    "cu_windows_smoke_button_bounds:" + JSON.stringify(press_button.bounds)
  );
  ensure(menu_bar !== null, "cu_windows_smoke_menu_bar_missing");

  print("STEP query by role finds the fixture controls and reports its counts");
  const query = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "query", "--window", handle_text, "--role", "button"
  ]);
  ensure(int_at(query, "data.matched") >= 1, "cu_windows_smoke_query:" + JSON.stringify(query.data));

  print("STEP invoke press advances the count label, and set-checked repeats as a verified no-op");
  const before_press = label_text(run_directory, executable, handle_text, "pressed ");
  ensure(before_press === "pressed 0", "cu_windows_smoke_press_before:" + before_press);
  const pressed = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "invoke",
    "--window", handle_text, "--name", "Fixture Press", "press"
  ]);
  ensure(flag_at(pressed, "data.performed"), "cu_windows_smoke_press:" + JSON.stringify(pressed.data));
  ensure(
    label_text(run_directory, executable, handle_text, "pressed ") === "pressed 1",
    "cu_windows_smoke_press_after"
  );
  const checked_once = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "invoke",
    "--window", handle_text, "--name", "Fixture Check", "set-checked", "true"
  ]);
  ensure(
    flag_at(checked_once, "data.performed") && flag_at(checked_once, "data.verified"),
    "cu_windows_smoke_check_first:" + JSON.stringify(checked_once.data)
  );
  const checked_again = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "invoke",
    "--window", handle_text, "--name", "Fixture Check", "set-checked", "true"
  ]);
  ensure(
    flag_at(checked_again, "data.verified") && !flag_at(checked_again, "data.performed"),
    "cu_windows_smoke_check_repeat:" + JSON.stringify(checked_again.data)
  );

  print("STEP menu inspect walks the background menu bar, terminates, and reports only what a closed menu publishes");
  // This verb hung here at over 2 GB the first time it ran on Windows: node
  // ids longer than the ABI record's 64-byte field collapsed onto one
  // another, a node became its own parent, and the path flattening walked
  // that cycle forever. Reaching this step at all is the regression check.
  const menu = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "menu", "inspect", "--window", handle_text
  ]);
  const items = menu.data.items;
  // The application's own menu bar, not the window's System menu: both are
  // `menu bar` nodes, and the walk reaches the shallower one first.
  let saw_file = 0;
  for (const item of items) {
    if (item.path.join("/") === "File") { saw_file = 1; }
  }
  ensure(saw_file === 1, "cu_windows_smoke_menu_shape:" + JSON.stringify(items));
  ensure(
    flag_at(menu, "data.scan_truncated") === false,
    "cu_windows_smoke_menu_truncated:" + JSON.stringify(menu.data)
  );
  // A closed Win32 drop-down publishes its bar entry and nothing under it.
  // That is the toolkit's answer and it is reported as it stands: this
  // product does not open a menu on screen to make one look richer, and
  // `capabilities` declares `mode: "tree-search"` for exactly this.
  let closed_dropdown_is_empty = 1;
  for (const item of items) {
    if (item.path.length > 1) { closed_dropdown_is_empty = 0; }
  }
  ensure(
    closed_dropdown_is_empty === 1,
    "cu_windows_smoke_menu_unexpected_children:" + JSON.stringify(items)
  );
  // Every id the snapshot carries must be unique, which is what the 64-byte
  // record could not guarantee for UI Automation's long runtime paths.
  const tree_for_ids = tree_nodes(run_directory, executable, handle_text);
  const seen_ids = [];
  for (const node of tree_for_ids) {
    for (const other of seen_ids) {
      ensure(other !== node.id, "cu_windows_smoke_duplicate_node_id:" + node.id);
    }
    seen_ids.push(node.id);
  }
  // and no node may be its own parent, which is how the duplicates showed up
  for (const node of tree_for_ids) {
    ensure(
      text_of(node.parent_id) !== text_of(node.id),
      "cu_windows_smoke_self_parent:" + node.id
    );
  }

  print("STEP activate makes the owned window foreground and reads the exact handle back focused");
  const activated = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "activate", "--window", handle_text
  ]);
  ensure(
    flag_at(activated, "data.performed") && flag_at(activated, "data.verified")
      && flag_at(activated, "data.after.focused"),
    "cu_windows_smoke_activate:" + JSON.stringify(activated.data)
  );

  print("STEP focus gives the owned entry keyboard focus and focused reads that state back");
  const focus_entry = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "focus",
    "--window", handle_text, "--name", "Fixture Entry"
  ]);
  ensure(
    flag_at(focus_entry, "data.performed") && flag_at(focus_entry, "data.verified"),
    "cu_windows_smoke_focus:" + JSON.stringify(focus_entry.data)
  );
  const focused = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "focused", "--window", handle_text
  ]);
  ensure(
    text_at(focused, "data.node.name") === "Fixture Entry"
      && text_at(focused, "data.node.role") !== "",
    "cu_windows_smoke_focused:" + JSON.stringify(focused.data)
  );

  print("STEP window-place is refused without the actuate grant and moves nothing, then places the window and the inventory reads it back");
  const place_refused = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe", "window-place",
    "--action", "frame", "--window", handle_text,
    "--x", "300", "--y", "200", "--width", "380", "--height", "300"
  ]);
  ensure(!flag_at(place_refused, "ok"), "cu_windows_smoke_place_grant:" + JSON.stringify(place_refused));
  const before_place = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(
    int_at(before_place, "bounds.x") === int_at(row, "bounds.x"),
    "cu_windows_smoke_place_refusal_moved_it"
  );
  const placed = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "window-place",
    "--action", "frame", "--window", handle_text,
    "--x", "300", "--y", "200", "--width", "380", "--height", "300"
  ]);
  ensure(flag_at(placed, "ok") !== false, "cu_windows_smoke_place:" + JSON.stringify(placed.data));
  const placed_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(
    int_at(placed_row, "bounds.width") === 380 && int_at(placed_row, "bounds.height") === 300,
    "cu_windows_smoke_place_inventory:" + JSON.stringify(placed_row.bounds)
  );

  print("STEP screenshot captures the fixture window itself, sized to the window rather than the screen");
  const shot_path = rh.join(run_directory, "window.png");
  const shot = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "screenshot",
    "--out", shot_path, "--window", handle_text
  ]);
  ensure(
    int_at(shot, "data.output_width") === int_at(placed_row, "bounds.width")
      && int_at(shot, "data.output_height") === int_at(placed_row, "bounds.height"),
    "cu_windows_smoke_shot_size:" + JSON.stringify(shot.data) + JSON.stringify(placed_row.bounds)
  );
  ensure(direct_file(shot_path), "cu_windows_smoke_shot_missing");
  ensure(rh.metadata(shot_path).len > 2000, "cu_windows_smoke_shot_empty");

  print("STEP close without a snapshot, a postcondition or a target is refused typed; with all three the second window closes and the handle reads back gone");
  const second_row = window_row(run_directory, executable, fixture_pid, second_title);
  ensure(second_row !== null, "cu_windows_smoke_second_window_missing");
  const second_handle = int_at(second_row, "handle");
  const close_bare = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "close", "--window", "" + second_handle
  ]);
  ensure(
    !flag_at(close_bare, "ok") && text_at(close_bare, "error.code") === "refused"
      && text_at(close_bare, "error.detail.effect") === "not_performed",
    "cu_windows_smoke_close_bare:" + JSON.stringify(close_bare)
  );
  ensure(
    window_row(run_directory, executable, fixture_pid, second_title) !== null,
    "cu_windows_smoke_close_bare_side_effect"
  );
  const closed = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "close",
    "--window", "" + second_handle, "--pid", "" + fixture_pid, "--title", second_title,
    "--snapshot", "--expect", "gone"
  ]);
  ensure(
    flag_at(closed, "data.performed") && flag_at(closed, "data.snapshot.in_receipt"),
    "cu_windows_smoke_close:" + JSON.stringify(closed.data)
  );
  let closed_gone = 0;
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    if (window_row(run_directory, executable, fixture_pid, second_title) === null) { closed_gone = 1; break; }
    harness.sleep_ms(50);
  }
  ensure(closed_gone === 1, "cu_windows_smoke_close_window_lingers");
  // Closing a window is not killing the process: the main window is still
  // there and the fixture is still running.
  ensure(harness.process_present(fixture_pid) !== 0, "cu_windows_smoke_close_killed_the_process");
  ensure(
    window_row(run_directory, executable, fixture_pid, fixture_title) !== null,
    "cu_windows_smoke_close_took_the_wrong_window"
  );
  const receipts = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "receipts", "--max", "50"
  ]);
  ensure(receipts.data.receipts.length > 0, "cu_windows_smoke_receipts");

  print("STEP process-kill terminates the retained Windows HANDLE, verifies exit, and leaves no window");
  const process_kill = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "process-kill",
    "--pid", "" + fixture_pid, "--start-identity", process_identity,
    "--mode", "forceful", "--timeout-ms", "10000", "--expect", "exited"
  ]);
  ensure(
    flag_at(process_kill, "data.performed")
      && text_at(process_kill, "data.state") === "exited"
      && flag_at(process_kill, "data.verified")
      && text_at(process_kill, "data.mechanism") === "native-process-reference",
    "cu_windows_smoke_process_kill:" + JSON.stringify(process_kill.data)
  );
  let fixture_exited = 0;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    if (harness.state(fixture) === "exited") { fixture_exited = 1; break; }
    harness.sleep_ms(25);
  }
  ensure(fixture_exited !== 0, "cu_windows_smoke_fixture_exit_timeout");
  harness.wait(fixture, 5000);
  fixture_reaped = true;
  ensure(harness.process_present(fixture_pid) === 0, "cu_windows_smoke_fixture_orphan");
  const gone = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "windows", "--pid", "" + fixture_pid
  ]);
  ensure(int_at(gone, "data.matched") === 0, "cu_windows_smoke_fixture_window_lingers");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture >= 0 && !fixture_reaped) {
  // Only the pid this run spawned; never a name pattern.
  if (fixture_pid !== 0) {
    rh.command("taskkill", ["/PID", "" + fixture_pid, "/F"], { timeout_ms: 10000 });
  }
  try { harness.wait(fixture, 5000); } catch (wait_error) { print("cleanup: " + wait_error); }
}
if (short_child >= 0 && !short_reaped) {
  // Reaping closes the final Windows process handle, which is also required
  // before the run directory can be removed after a failed assertion.
  if (short_pid !== 0) {
    rh.command("taskkill", ["/PID", "" + short_pid, "/F"], { timeout_ms: 10000 });
  }
  try {
    harness.wait(short_child, 5000);
    short_reaped = true;
  } catch (wait_error) {
    print("cleanup: " + wait_error);
  }
}
if (terminal_gui >= 0 && !terminal_gui_reaped) {
  // Kill only this run's GUI process tree. Its terminal child has already
  // exited on success; /T also bounds cleanup if an earlier assertion failed.
  if (terminal_gui_pid !== 0) {
    const terminated = rh.command(
      "taskkill", ["/PID", "" + terminal_gui_pid, "/T", "/F"],
      { timeout_ms: 10000 }
    );
    if (terminated.success !== true && harness.process_present(terminal_gui_pid) !== 0) {
      succeeded = 0;
      failure = failure + ":cu_windows_smoke_terminal_cleanup_kill";
    }
  }
  try {
    harness.wait(terminal_gui, 5000);
    terminal_gui_reaped = true;
  } catch (wait_error) {
    print("cleanup: " + wait_error);
    succeeded = 0;
    failure = failure + ":cu_windows_smoke_terminal_cleanup_wait";
  }
  if (terminal_gui_pid !== 0 && harness.process_present(terminal_gui_pid) !== 0) {
    succeeded = 0;
    failure = failure + ":cu_windows_smoke_terminal_cleanup_orphan";
  }
}
if (network_fixture !== null && !network_fixture_reaped) {
  try {
    if (harness.child_state(network_fixture) === "running") {
      harness.child_kill(network_fixture);
    }
    harness.child_wait(network_fixture, 5000);
    network_fixture_reaped = true;
  } catch (wait_error) {
    print("cleanup: " + wait_error);
    succeeded = 0;
    failure = failure + ":cu_windows_smoke_network_cleanup_wait";
  }
  if (network_fixture_pid !== 0 && harness.process_present(network_fixture_pid) !== 0) {
    succeeded = 0;
    failure = failure + ":cu_windows_smoke_network_cleanup_orphan";
  }
}

// Evidence is emitted only once the whole run has succeeded.
if (succeeded !== 1) {
  if (!remove_directory_bounded(run_directory)) {
    failure = failure + ":cu_windows_smoke_cleanup_locked";
  }
  harness.remove_run(context);
  throw failure;
}

ensure(remove_directory_bounded(run_directory), "cu_windows_smoke_cleanup_locked");
harness.emit_evidence(context, declared_evidence, "cu.windows-uia-capabilities");
harness.emit_evidence(context, declared_evidence, "cu.windows-uia-window-identity");
harness.emit_evidence(context, declared_evidence, "cu.windows-process-state");
harness.emit_evidence(context, declared_evidence, "cu.windows-process-argv");
harness.emit_evidence(context, declared_evidence, "cu.windows-process-usage");
harness.emit_evidence(context, declared_evidence, "cu.windows-process-usage-watch");
harness.emit_evidence(context, declared_evidence, "cu.windows-process-wait");
harness.emit_evidence(context, declared_evidence, "cu.windows-process-kill");
harness.emit_evidence(context, declared_evidence, "cu.windows-process-lifecycle-watch");
harness.emit_evidence(context, declared_evidence, "cu.windows-network-probe");
harness.emit_evidence(context, declared_evidence, "cu.windows-file-inspect");
harness.emit_evidence(context, declared_evidence, "cu.windows-terminal-control");
harness.emit_evidence(context, declared_evidence, "cu.windows-uia-tree");
harness.emit_evidence(context, declared_evidence, "cu.windows-uia-query");
harness.emit_evidence(context, declared_evidence, "cu.windows-uia-invoke");
harness.emit_evidence(context, declared_evidence, "cu.windows-uia-menu");
harness.emit_evidence(context, declared_evidence, "cu.windows-window-activate");
harness.emit_evidence(context, declared_evidence, "cu.windows-uia-focused");
harness.emit_evidence(context, declared_evidence, "cu.windows-uia-window-place");
harness.emit_evidence(context, declared_evidence, "cu.windows-uia-screenshot");
harness.emit_evidence(context, declared_evidence, "cu.windows-uia-destructive-close");
harness.emit_evidence(context, declared_evidence, "cu.windows-uia-cleanup");
harness.remove_run(context);
print("PASS: agenterm-cu Windows UIA journey (capabilities, windows, process state/usage, network probe, terminal control, tree, query, invoke, menu, activate, focused, window-place, screenshot, close, cleanup)");
return;
