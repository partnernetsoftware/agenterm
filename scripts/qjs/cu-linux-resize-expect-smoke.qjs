// CEO#6: resize --expect WxH on a named window target.
// Acceptance is smoke read-back only: independent windows inventory
// bounds and xwininfo Width/Height must match --expect after resize.
// Typed usage, destructive-gate refusals, missing-window and headless
// host-limit paths must hold before any owned fixture window exists.
// Typed resize usage must reject AT-SPI --name, --coords, --bogus, and
// other unexpected arguments via usage_rejects_unexpected + command=usage,
// or an honest non-usage typed failure (never fake command=usage). Typed
// get-extents --name usage AND host-limit paths must both hold before
// process-state, desktop-state, and the actuate/read-back court (no
// if/else gating those courts on atspi_available); get-extents
// --coords/--bogus must reject as command=usage. Prefer host-limit clarity
// over fake success. AT-SPI/--name only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-resize-expect-geometry",
];

const MISSING_HANDLE = "99999999";
const NAMED_NODE = "Fixture Entry";
const AT_SPI_PROBE_NAME = "Resize Expect Court Anchor";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;
const TARGET_WIDTH = 400;
// GTK fixture enforces ~430px minimum client height; 360 clamps and breaks --expect.
const TARGET_HEIGHT = 430;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function within(got, want) {
  return got >= want - 5 && got <= want;
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function parse_xwininfo_size(stdout) {
  let width = 0;
  let height = 0;
  for (const line of stdout.split("\n")) {
    const trimmed = line.trim();
    if (trimmed.indexOf("Width:") === 0) {
      width = rh.parse_int(trimmed.slice("Width:".length).trim());
    } else if (trimmed.indexOf("Height:") === 0) {
      height = rh.parse_int(trimmed.slice("Height:".length).trim());
    }
  }
  return { width, height };
}

function independent_xwininfo_size(run_directory, executable, handle) {
  const output = rh.command("xwininfo", ["-id", "" + handle], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  ensure(output.success === true,
    "cu_linux_resize_expect_xwininfo:" + output.stderr + output.stdout);
  const size = parse_xwininfo_size(output.stdout);
  ensure(size.width > 0 && size.height > 0,
    "cu_linux_resize_expect_xwininfo_parse:" + output.stdout);
  return size;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_resize_expect_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_resize_expect_reply:" + JSON.stringify(document));
  return document;
}

function resize_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["resize"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_resize_expect_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function assert_resize_usage_limit(run_directory, executable) {
  const zero_window = run_cu_reply(run_directory, executable, "actuate", [
    "resize", "--window", "0",
    "--width", "" + TARGET_WIDTH, "--height", "" + TARGET_HEIGHT,
    "--expect", "" + TARGET_WIDTH + "x" + TARGET_HEIGHT,
  ]);
  ensure(!output_success(zero_window), "cu_linux_resize_expect_usage_ok:" + JSON.stringify(zero_window));
  ensure(
    text_at(zero_window, "error.code") === "usage",
    "cu_linux_resize_expect_usage_code:" + JSON.stringify(zero_window.error)
  );
  ensure(
    text_at(zero_window, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_resize_expect_usage_message:" + JSON.stringify(zero_window.error)
  );

  const missing_height = run_cu_reply(run_directory, executable, "actuate", [
    "resize", "--window", "1",
    "--width", "" + TARGET_WIDTH,
    "--expect", "" + TARGET_WIDTH + "x" + TARGET_HEIGHT,
  ]);
  ensure(!output_success(missing_height), "cu_linux_resize_expect_missing_height_ok:" + JSON.stringify(missing_height));
  ensure(
    text_at(missing_height, "error.code") === "usage",
    "cu_linux_resize_expect_missing_height_code:" + JSON.stringify(missing_height.error)
  );
  ensure(
    text_at(missing_height, "error.message").indexOf("--width") >= 0
      && text_at(missing_height, "error.message").indexOf("--height") >= 0,
    "cu_linux_resize_expect_missing_height_message:" + JSON.stringify(missing_height.error)
  );

  const mismatched_expect = run_cu_reply(run_directory, executable, "actuate", [
    "resize", "--window", "1",
    "--width", "" + TARGET_WIDTH, "--height", "" + TARGET_HEIGHT,
    "--expect", "500x430",
  ]);
  ensure(!output_success(mismatched_expect), "cu_linux_resize_expect_mismatch_ok:" + JSON.stringify(mismatched_expect));
  ensure(
    text_at(mismatched_expect, "error.code") === "invalid_input",
    "cu_linux_resize_expect_mismatch_code:" + JSON.stringify(mismatched_expect.error)
  );
  ensure(
    text_at(mismatched_expect, "error.message").indexOf("must match") >= 0,
    "cu_linux_resize_expect_mismatch_message:" + JSON.stringify(mismatched_expect.error)
  );
}

function assert_resize_destructive_gate(run_directory, executable) {
  const missing_target = resize_refused(run_directory, executable, [
    "--width", "" + TARGET_WIDTH, "--height", "" + TARGET_HEIGHT,
    "--expect", "" + TARGET_WIDTH + "x" + TARGET_HEIGHT,
  ], "refused");
  ensure(
    text_at(missing_target, "error.detail.reason") === "destructive_gate"
      && text_at(missing_target, "error.detail.effect") === "not_performed"
      && missing_target.error.detail.missing.length >= 1
      && text_of(missing_target.error.detail.missing[0]) === "target",
    "cu_linux_resize_expect_missing_target:" + JSON.stringify(missing_target)
  );
}

function assert_resize_missing_window(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "actuate", [
    "resize", "--window", MISSING_HANDLE,
    "--width", "" + TARGET_WIDTH, "--height", "" + TARGET_HEIGHT,
    "--expect", "" + TARGET_WIDTH + "x" + TARGET_HEIGHT,
  ]);
  ensure(!output_success(reply), "cu_linux_resize_expect_missing_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "failed",
    "cu_linux_resize_expect_missing_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("not found") >= 0,
    "cu_linux_resize_expect_missing_message:" + JSON.stringify(reply.error)
  );
}

function assert_headless_host_limit(run_directory, executable) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    [
      "resize", "--window", "1",
      "--width", "" + TARGET_WIDTH, "--height", "" + TARGET_HEIGHT,
      "--expect", "" + TARGET_WIDTH + "x" + TARGET_HEIGHT,
    ],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_resize_expect_headless_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_resize_expect_headless_code:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("window enumeration") >= 0
      || message.indexOf("mechanism unavailable") >= 0,
    "cu_linux_resize_expect_headless_message:" + JSON.stringify(reply.error)
  );
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_resize_expect_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_resize_unexpected_usage(run_directory, executable, env) {
  const expect_text = "" + TARGET_WIDTH + "x" + TARGET_HEIGHT;
  const resize_with_name = run_cu_reply(run_directory, executable, "actuate", [
    "resize", "--window", "1", "--name", AT_SPI_PROBE_NAME,
    "--width", "" + TARGET_WIDTH, "--height", "" + TARGET_HEIGHT,
    "--expect", expect_text,
  ], env);
  ensure(!output_success(resize_with_name),
    "cu_linux_resize_expect_usage_resize_name_ok:" + JSON.stringify(resize_with_name));
  ensure(
    text_at(resize_with_name, "error.code") === "usage",
    "cu_linux_resize_expect_usage_resize_name_code:" + JSON.stringify(resize_with_name.error)
  );
  ensure(
    text_at(resize_with_name, "command") === "usage",
    "cu_linux_resize_expect_usage_resize_name_command:" + JSON.stringify(resize_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(resize_with_name, "error.message"), "--name"),
    "cu_linux_resize_expect_usage_resize_name_message:" + JSON.stringify(resize_with_name.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, "actuate", [
    "resize", "--window", "1",
    "--width", "" + TARGET_WIDTH, "--height", "" + TARGET_HEIGHT,
    "--expect", expect_text, "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_resize_expect_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_resize_expect_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_resize_expect_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_resize_expect_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_coords = run_cu_reply(run_directory, executable, "actuate", [
    "resize", "--window", "1",
    "--width", "" + TARGET_WIDTH, "--height", "" + TARGET_HEIGHT,
    "--expect", expect_text, "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords),
    "cu_linux_resize_expect_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_resize_expect_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_resize_expect_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_resize_expect_usage_coords_message:" + JSON.stringify(with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_resize_expect_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_resize_expect_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_resize_expect_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_resize_expect_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_resize_expect_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_resize_expect_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_resize_expect_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_resize_expect_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_resize_expect_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_resize_expect_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_resize_expect_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_resize_expect_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_resize_expect_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_resize_expect_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_resize_expect_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_resize_expect_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_resize_expect_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_resize_expect_extents_unavailable_code:" + code
  );
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_resize_expect_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_resize_expect_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_resize_expect_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_resize_expect_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_resize_expect_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function independent_pyatspi_named_extents(run_directory, executable, title, node_name) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "want = sys.argv[2]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and w.name == title:",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    if (node.name or '') == want:",
    "        return node",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_resize_expect_atspi_no_frame')",
    "node = walk(frame)",
    "if node is None:",
    "    raise SystemExit('cu_linux_resize_expect_atspi_miss:' + want)",
    "component = node.queryComponent()",
    "ext = component.getExtents(pyatspi.DESKTOP_COORDS)",
    "print(json.dumps({",
    "    'name': want,",
    "    'x': int(ext.x), 'y': int(ext.y),",
    "    'width': int(ext.width), 'height': int(ext.height),",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title, node_name], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(
    output.success === true,
    "cu_linux_resize_expect_pyatspi_named:" + output.stderr + output.stdout
  );
  return JSON.parse(output.stdout.trim());
}

function assert_get_extents_name_agreement(run_directory, executable, handle, title, node_name) {
  const pyatspi_node = independent_pyatspi_named_extents(
    run_directory, executable, title, node_name
  );
  const cu_extents = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", node_name,
  ]);
  ensure(
    int_at(cu_extents, "data.extents.x") === pyatspi_node.x
      && int_at(cu_extents, "data.extents.y") === pyatspi_node.y
      && int_at(cu_extents, "data.extents.width") === pyatspi_node.width
      && int_at(cu_extents, "data.extents.height") === pyatspi_node.height,
    "cu_linux_resize_expect_extents_agree:" + JSON.stringify({
      cu: cu_extents.data.extents,
      pyatspi: pyatspi_node,
    })
  );
}

function window_rows(reply) {
  const data = reply.data;
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  for (const row of window_rows(reply)) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-resize-expect-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_resize_expect_fixture_missing:" + fixture_source);

print("STEP resize typed-fails usage when --window handle is zero or geometry args are incomplete");
assert_resize_usage_limit(run_directory, executable);

print("STEP resize typed-fails refused destructive_gate when --window target is missing");
assert_resize_destructive_gate(run_directory, executable);

print("STEP resize typed-fails failed when handle is absent from inventory");
assert_resize_missing_window(run_directory, executable);

print("STEP resize without DISPLAY typed-fails unsupported host-limit");
assert_headless_host_limit(run_directory, executable);

print("STEP resize typed-fail usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
assert_resize_unexpected_usage(run_directory, executable, env);

print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (command=usage) before process-state/desktop-state and actuate/read-back court");
assert_get_extents_usage_limit(run_directory, executable, env);

print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_resize_expect_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_resize_expect_window_missing");
  const handle_text = "" + int_at(row, "handle");
  ensure(int_at(row, "handle") > 0, "cu_linux_resize_expect_handle:" + JSON.stringify(row));

  const before_width = int_at(row, "bounds.width");
  const before_height = int_at(row, "bounds.height");
  ensure(before_width > 0 && before_height > 0, "cu_linux_resize_expect_baseline:" + before_width + "x" + before_height);

  print("STEP process-state binds the owned fixture pid before resize actuate/read-back court");
  assert_fixture_process_state(run_directory, executable, fixture_pid);

  print("STEP desktop-state window row agrees with inventory before resize actuate/read-back court");
  assert_fixture_desktop_state(
    run_directory, executable, fixture_pid, fixture_title, handle_text, row
  );

  if (atspi_available) {
    print("STEP independent pyatspi extents and CU get-extents --name agree before resize actuate/read-back");
    assert_get_extents_name_agreement(
      run_directory, executable, handle_text, fixture_title, NAMED_NODE
    );
  } else {
    print("STEP host-limit: independent pyatspi desktop probe unavailable; skip get-extents agreement court");
  }

  print("STEP invalid_input refusals on a live handle must not change inventory or xwininfo bounds");
  resize_refused(run_directory, executable, [
    "--window", handle_text,
    "--width", "" + TARGET_WIDTH, "--height", "" + TARGET_HEIGHT,
    "--expect", "500x430",
  ], "invalid_input");
  const refusal_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(refusal_row !== null, "cu_linux_resize_expect_refusal_row_missing");
  ensure(
    int_at(refusal_row, "bounds.width") === before_width
      && int_at(refusal_row, "bounds.height") === before_height,
    "cu_linux_resize_expect_refusal_inventory_changed:" + JSON.stringify(refusal_row)
  );
  const refusal_xwininfo = independent_xwininfo_size(
    run_directory, executable, int_at(refusal_row, "handle"));
  ensure(
    refusal_xwininfo.width === before_width && refusal_xwininfo.height === before_height,
    "cu_linux_resize_expect_refusal_xwininfo_changed:" + refusal_xwininfo.width + "x" + refusal_xwininfo.height
  );

  const expect_text = "" + TARGET_WIDTH + "x" + TARGET_HEIGHT;
  print("STEP resize --window " + handle_text + " --width " + TARGET_WIDTH + " --height " + TARGET_HEIGHT + " --expect " + expect_text);
  const resized = run_cu(run_directory, executable, "observe,actuate", [
    "resize", "--window", handle_text,
    "--width", "" + TARGET_WIDTH, "--height", "" + TARGET_HEIGHT,
    "--expect", expect_text,
  ]);
  ensure(
    text_at(resized, "data.effect") === "committed"
      && int_at(resized, "data.after.width") === TARGET_WIDTH
      && int_at(resized, "data.after.height") === TARGET_HEIGHT,
    "cu_linux_resize_expect_reply_geometry:" + JSON.stringify(resized.data)
  );

  print("STEP independent windows inventory read-back matches --expect geometry");
  const after_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(after_row !== null, "cu_linux_resize_expect_after_row_missing");
  const got_width = int_at(after_row, "bounds.width");
  const got_height = int_at(after_row, "bounds.height");
  const exact = got_width === TARGET_WIDTH && got_height === TARGET_HEIGHT;
  const quantized = flag_at(resized, "data.quantized")
    && within(got_width, TARGET_WIDTH) && within(got_height, TARGET_HEIGHT);
  ensure(
    exact || quantized,
    "cu_linux_resize_expect_inventory:" + got_width + "x" + got_height + " expected " + expect_text
  );

  print("STEP independent xwininfo Width/Height read-back matches --expect geometry");
  const xwininfo = independent_xwininfo_size(run_directory, executable, int_at(after_row, "handle"));
  const xwin_exact = xwininfo.width === TARGET_WIDTH && xwininfo.height === TARGET_HEIGHT;
  const xwin_quantized = flag_at(resized, "data.quantized")
    && within(xwininfo.width, TARGET_WIDTH) && within(xwininfo.height, TARGET_HEIGHT);
  ensure(
    xwin_exact || xwin_quantized,
    "cu_linux_resize_expect_xwininfo_mismatch:" + xwininfo.width + "x" + xwininfo.height
      + " expected " + expect_text
  );
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-resize-expect");
harness.emit_evidence(context, declared_evidence, "cu.linux-resize-expect-geometry");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux resize --expect usage/miss/host-limit honesty + process-state/desktop-state courts + independent windows inventory and xwininfo bounds read-back with typed resize --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit with --coords/--bogus command=usage (no atspi gating), and pyatspi get-extents --name geometry (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux resize --expect usage/miss/host-limit honesty + process-state/desktop-state courts + independent windows inventory and xwininfo bounds read-back with typed resize --name/--coords/--bogus usage_rejects_unexpected and get-extents --name usage/host-limit plus --coords/--bogus command=usage honesty when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
}
return;
