// CEO: Linux spaces host-limit honesty with independent SkyLight absence and
// EWMH workspace probes. Acceptance is smoke read-back only: `spaces` must
// return typed unsupported with detail.os/required_os/alternatives even when
// the root window exposes _NET_CURRENT_DESKTOP / _NET_NUMBER_OF_DESKTOPS
// (EWMH virtual desktops are not macOS SkyLight managed Spaces). Typed spaces
// usage must reject AT-SPI --name and other unexpected arguments; typed
// get-extents --name usage/host-limit paths must hold before the spaces
// read-back court. Headless host-limit and capabilities alignment must hold
// before any owned fixture window exists. Observe-only; no --coords or
// screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.linux-spaces-readback"];

const AT_SPI_PROBE_NAME = "Spaces Court Anchor";

const PROBE_SCRIPT = [
  "import json, os, sys",
  "is_linux = sys.platform.startswith('linux')",
  "has_skylight = os.path.exists('/System/Library/PrivateFrameworks/SkyLight.framework')",
  "print(json.dumps({",
  "    'linux': is_linux,",
  "    'skylight': has_skylight,",
  "    'managed_spaces_unavailable': is_linux and not has_skylight,",
  "}))",
].join("\n");

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_spaces_empty:" + output.stderr);
  return JSON.parse(trimmed);
}

function invoke(run_directory, executable, arguments, expect_success) {
  const reply = run_cu_reply(run_directory, executable, "observe", arguments);
  ensure(reply.ok === expect_success,
    "cu_linux_spaces_reply:" + JSON.stringify(reply));
  return reply;
}

function parse_xprop_cardinal(stdout, property) {
  const marker = property + "(CARDINAL) = ";
  const start = stdout.indexOf(marker);
  if (start < 0) { return -1; }
  const tail = stdout.slice(start + marker.length).trim();
  const end = tail.indexOf("\n");
  const number = end < 0 ? tail : tail.slice(0, end);
  if (number === "") { return -1; }
  return rh.parse_int(number);
}

function independent_ewmh_desktops(run_directory, executable) {
  const output = rh.command("xprop", [
    "-root", "_NET_CURRENT_DESKTOP", "_NET_NUMBER_OF_DESKTOPS",
  ], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (!output.success) {
    return { current_desktop: -1, desktop_count: -1, ewmh_present: false };
  }
  const current_desktop = parse_xprop_cardinal(output.stdout, "_NET_CURRENT_DESKTOP");
  const desktop_count = parse_xprop_cardinal(output.stdout, "_NET_NUMBER_OF_DESKTOPS");
  const ewmh_present = current_desktop >= 0 && desktop_count > 0;
  return { current_desktop, desktop_count, ewmh_present };
}

function independent_probe() {
  const output = rh.command("python3", ["-c", PROBE_SCRIPT], {
    env: cu_env("."),
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_spaces_probe:" + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_spaces_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_spaces_usage_limit(run_directory, executable, env) {
  const with_name = run_cu_reply(run_directory, executable, "observe", [
    "spaces", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(with_name),
    "cu_linux_spaces_usage_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_spaces_usage_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_spaces_usage_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    text_at(with_name, "error.message").indexOf("--name") >= 0
      || text_at(with_name, "error.message").indexOf("no arguments") >= 0
      || text_at(with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_spaces_usage_name_message:" + JSON.stringify(with_name.error)
  );

  const reply = run_cu_reply(run_directory, executable, "observe", ["spaces", "--bogus"], env);
  ensure(!output_success(reply), "cu_linux_spaces_usage_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_spaces_usage_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_spaces_usage_command:" + JSON.stringify(reply)
  );
  ensure(
    text_at(reply, "error.message").indexOf("no arguments") >= 0
      || text_at(reply, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_spaces_usage_message:" + JSON.stringify(reply.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_spaces_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_spaces_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_spaces_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_spaces_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_spaces_extents_unavailable_code:" + code
  );
}

function assert_headless_host_limit(run_directory, executable) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "observe",
    ["spaces"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!flag_at(reply, "ok"), "cu_linux_spaces_headless_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_spaces_headless_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.required_os") === "macos",
    "cu_linux_spaces_headless_required_os:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.limit") === "host",
    "cu_linux_spaces_headless_limit:" + JSON.stringify(reply.error)
  );
}

function verify_spaces_unsupported(reply, probe, ewmh) {
  ensure(reply.ok !== true, "cu_linux_spaces_false_success");
  ensure(text_at(reply, "error.code") === "unsupported", "cu_linux_spaces_code");
  ensure(text_at(reply, "command") === "spaces", "cu_linux_spaces_command");
  const detail = at(reply, "error.detail");
  ensure(text_at(detail, "os") === "linux", "cu_linux_spaces_os:" + JSON.stringify(detail));
  ensure(text_at(detail, "limit") === "host", "cu_linux_spaces_limit");
  ensure(text_at(detail, "required_os") === "macos", "cu_linux_spaces_required_os");
  ensure(text_at(detail, "mechanism") === "skylight-private-read",
    "cu_linux_spaces_mechanism:" + JSON.stringify(detail));
  ensure(text_at(detail, "group") === "geometry", "cu_linux_spaces_group");
  ensure(text_at(reply, "error.message").indexOf("macOS") >= 0,
    "cu_linux_spaces_message:" + text_at(reply, "error.message"));
  const alternatives = at(detail, "alternatives");
  ensure(Array.isArray(alternatives) && alternatives.length > 0,
    "cu_linux_spaces_alternatives:" + JSON.stringify(detail));
  const joined = alternatives.join(" ").toLowerCase();
  ensure(joined.indexOf("displays") >= 0, "cu_linux_spaces_alternatives_displays:" + joined);
  ensure(joined.indexOf("windows") >= 0, "cu_linux_spaces_alternatives_windows:" + joined);
  ensure(probe.managed_spaces_unavailable === true,
    "cu_linux_spaces_probe_unavailable:" + JSON.stringify(probe));
  if (ewmh.ewmh_present) {
    ensure(
      text_at(reply, "error.detail.required_os") === "macos",
      "cu_linux_spaces_ewmh_still_macos_only:" + JSON.stringify(reply.error)
    );
    print(
      "STEP independent xprop read-back: EWMH current_desktop="
        + ewmh.current_desktop + " desktop_count=" + ewmh.desktop_count
        + " does not satisfy macOS SkyLight managed Space inventory"
    );
  } else {
    print("STEP host lacks root _NET_CURRENT_DESKTOP/_NET_NUMBER_OF_DESKTOPS; spaces remains macOS-only");
  }
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_spaces_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-spaces");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

print("STEP spaces typed-fails usage when AT-SPI --name or other unexpected arguments are present");
assert_spaces_usage_limit(context.run_directory, executable, env);

if (atspi_available) {
  print("STEP get-extents typed-fail invalid_input when --window is zero before spaces read-back court");
  assert_get_extents_usage_limit(context.run_directory, executable, env);
} else {
  print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
  assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
}

print("STEP spaces without DISPLAY typed-fails unsupported macOS host-limit");
assert_headless_host_limit(context.run_directory, executable);

print("STEP independent probe confirms Linux has no macOS SkyLight managed Space model");
const probe = independent_probe();
ensure(probe.linux === true, "cu_linux_spaces_not_linux:" + JSON.stringify(probe));

const ewmh = independent_ewmh_desktops(context.run_directory, executable);

print("STEP spaces returns typed host-limit unsupported with detail.os/required_os/alternatives");
const spaces = invoke(context.run_directory, executable, ["spaces"], false);
verify_spaces_unsupported(spaces, probe, ewmh);

print("STEP capabilities declares spaces unsupported on this Linux host");
const caps = invoke(context.run_directory, executable, ["capabilities"], true);
ensure(text_at(caps, "data.verbs.spaces.status") === "unsupported",
  "cu_linux_spaces_capabilities_status:" + JSON.stringify(at(caps, "data.verbs.spaces")));
ensure(text_at(caps, "data.verbs.spaces.os") === "linux",
  "cu_linux_spaces_capabilities_os:" + JSON.stringify(at(caps, "data.verbs.spaces")));
ensure(text_at(caps, "data.verbs.spaces.provider") === "none",
  "cu_linux_spaces_capabilities_provider:" + JSON.stringify(at(caps, "data.verbs.spaces")));

harness.emit_evidence(context, declared_evidence, "cu.linux-spaces-readback");
harness.remove_run(context);
if (atspi_available) {
  print("PASS typed unsupported with SkyLight host-limit honesty, EWMH workspace read-back, typed spaces/get-extents usage honesty (AT-SPI --name, no --coords), headless paths, and capabilities alignment");
} else {
  print("PASS typed unsupported with SkyLight host-limit honesty, EWMH workspace read-back, typed spaces/get-extents host-limit honesty (AT-SPI --name, no --coords), headless paths, and capabilities alignment");
}
