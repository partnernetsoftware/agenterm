// CEO: Linux spaces host-limit honesty with independent SkyLight absence and
// EWMH/wmctrl workspace probes. Acceptance is smoke read-back only: `spaces`
// must return typed unsupported with detail.os/required_os/alternatives even
// when wmctrl -d or root _NET_CURRENT_DESKTOP / _NET_NUMBER_OF_DESKTOPS are
// present (EWMH virtual desktops are not macOS SkyLight managed Spaces). When
// those desktop/workspace APIs are absent, the same typed host-limit still
// holds — never skip or fake green. Typed spaces --name/--coords/--bogus
// must use usage_rejects_unexpected or an honest non-usage typed failure
// (never fake command=usage). Typed get-extents --name usage AND host-limit
// paths (including --coords/--bogus command=usage) both run before
// process-state, desktop-state, and the spaces inventory/observe court, with
// no if/else gating those courts on atspi_available. process-state and
// desktop-state fixture binding courts must hold before the independent
// spaces read-back court. Headless host-limit and capabilities alignment
// must hold before any owned fixture window exists. Observe-only;
// AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = ["cu.linux-spaces-readback"];

const AT_SPI_PROBE_NAME = "Spaces Court Anchor";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

const PROBE_SCRIPT = [
  "import json, os, sys",
  "is_linux = sys.platform.startswith('linux')",
  "has_skylight = os.path.exists('/System/Library/PrivateFrameworks/SkyLight.framework')",
  "print(json.dumps({",
  "    'linux': is_linux,",
  "    'skylight': has_skylight,",
  "    'managed_spaces_unavailable': is_linux and not has_skylight,",
  "}))",
].join("\n");

const DESKTOP_WORKSPACE_SCRIPT = [
  "import json, shutil, subprocess",
  "def xprop_cardinal(stdout, prop):",
  "    marker = prop + '(CARDINAL) = '",
  "    start = stdout.find(marker)",
  "    if start < 0:",
  "        return -1",
  "    tail = stdout[start + len(marker):].strip().splitlines()",
  "    if not tail:",
  "        return -1",
  "    first = tail[0].strip()",
  "    if first.isdigit() or (first.startswith('-') and first[1:].isdigit()):",
  "        return int(first)",
  "    return -1",
  "ewmh = {",
  "    'current_desktop': -1,",
  "    'desktop_count': -1,",
  "    'ewmh_present': False,",
  "    'desktop_names_present': False,",
  "    'reason': 'xprop-absent',",
  "}",
  "try:",
  "    proc = subprocess.run(",
  "        ['xprop', '-root', '_NET_CURRENT_DESKTOP', '_NET_NUMBER_OF_DESKTOPS', '_NET_DESKTOP_NAMES'],",
  "        capture_output=True, text=True, timeout=10)",
  "    stdout = proc.stdout or ''",
  "    current = xprop_cardinal(stdout, '_NET_CURRENT_DESKTOP')",
  "    count = xprop_cardinal(stdout, '_NET_NUMBER_OF_DESKTOPS')",
  "    ewmh = {",
  "        'current_desktop': current,",
  "        'desktop_count': count,",
  "        'ewmh_present': current >= 0 and count > 0,",
  "        'desktop_names_present': '_NET_DESKTOP_NAMES(' in stdout,",
  "        'reason': '' if current >= 0 and count > 0 else ('xprop-failed' if proc.returncode != 0 else 'ewmh-absent'),",
  "    }",
  "except FileNotFoundError:",
  "    ewmh['reason'] = 'xprop-absent'",
  "except Exception:",
  "    ewmh['reason'] = 'xprop-error'",
  "wmctrl = {",
  "    'present': False,",
  "    'current_desktop': -1,",
  "    'desktop_count': -1,",
  "    'reason': 'wmctrl-absent',",
  "}",
  "wmctrl_bin = shutil.which('wmctrl')",
  "if wmctrl_bin:",
  "    try:",
  "        proc = subprocess.run([wmctrl_bin, '-d'], capture_output=True, text=True, timeout=10)",
  "        rows = []",
  "        current = -1",
  "        for line in (proc.stdout or '').splitlines():",
  "            parts = line.split()",
  "            if len(parts) < 2 or not parts[0].isdigit():",
  "                continue",
  "            idx = int(parts[0])",
  "            rows.append(idx)",
  "            if parts[1] == '*':",
  "                current = idx",
  "        if proc.returncode == 0 and rows:",
  "            wmctrl = {",
  "                'present': True,",
  "                'current_desktop': current,",
  "                'desktop_count': len(rows),",
  "                'reason': '',",
  "            }",
  "        else:",
  "            wmctrl['reason'] = 'wmctrl-failed'",
  "    except Exception:",
  "        wmctrl['reason'] = 'wmctrl-error'",
  "print(json.dumps({'ewmh': ewmh, 'wmctrl': wmctrl}))",
].join("\n");

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}


function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_spaces_empty:" + output.stderr);
  return JSON.parse(trimmed);
}

function invoke(run_directory, executable, arguments, expect_success) {
  const reply = run_cu_reply(run_directory, executable, "observe", arguments);
  ensure(reply.ok === expect_success,
    "cu_linux_spaces_reply:" + JSON.stringify(reply));
  return reply;
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const reply = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(rh.output_success(reply),
    "cu_linux_spaces_ok_reply:" + JSON.stringify(reply));
  return reply;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_probe() {
  const output = rh.command("python3", ["-c", PROBE_SCRIPT], {
    env: cu_env("."),
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_spaces_probe:" + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function independent_desktop_workspace(run_directory, executable) {
  const output = rh.command("python3", ["-c", DESKTOP_WORKSPACE_SCRIPT], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_spaces_desktop_probe:" + output.stderr);
  const parsed = JSON.parse(output.stdout.trim());
  ensure(parsed.ewmh !== undefined && parsed.ewmh !== null,
    "cu_linux_spaces_desktop_ewmh_shape:" + output.stdout);
  ensure(parsed.wmctrl !== undefined && parsed.wmctrl !== null,
    "cu_linux_spaces_desktop_wmctrl_shape:" + output.stdout);
  return parsed;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_spaces_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function assert_spaces_usage_reject(run_directory, executable, env, extra_args, token, label) {
  const argv = ["spaces"];
  for (const argument of extra_args) { argv.push("" + argument); }
  const reply = run_cu_reply(run_directory, executable, "observe", argv, env);
  ensure(!rh.output_success(reply),
    "cu_linux_spaces_usage_" + label + "_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  const command = text_at(reply, "command");
  const message = text_at(reply, "error.message");
  if (code === "usage") {
    ensure(
      command === "usage",
      "cu_linux_spaces_usage_" + label + "_command:" + JSON.stringify(reply)
    );
    ensure(
      usage_rejects_unexpected(message, token),
      "cu_linux_spaces_usage_" + label + "_message:" + JSON.stringify(reply.error)
    );
  } else {
    ensure(
      command !== "usage",
      "cu_linux_spaces_usage_" + label + "_fake_command:" + JSON.stringify(reply)
    );
    ensure(
      code === "unsupported" || code === "invalid_input",
      "cu_linux_spaces_usage_" + label + "_code:" + JSON.stringify(reply.error)
    );
  }
}

function assert_spaces_usage_limit(run_directory, executable, env) {
  assert_spaces_usage_reject(
    run_directory, executable, env, ["--name", AT_SPI_PROBE_NAME], "--name", "name"
  );
  assert_spaces_usage_reject(
    run_directory, executable, env, ["--coords", "0,0"], "--coords", "coords"
  );
  assert_spaces_usage_reject(
    run_directory, executable, env, ["--bogus"], "--bogus", "bogus"
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_spaces_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_spaces_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_spaces_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_spaces_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_spaces_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_spaces_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_spaces_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_spaces_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_spaces_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_spaces_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_spaces_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_spaces_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_spaces_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_spaces_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_spaces_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_spaces_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_spaces_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_spaces_extents_unavailable_code:" + code
  );
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_spaces_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_spaces_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_spaces_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_spaces_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_spaces_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function assert_court_anchor_binding(run_directory, executable, env, fixture_source) {
  let fixture = null;
  let fixture_pid = 0;
  try {
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ], env);
    ensure(flag_at(window_wait, "data.met"),
      "cu_linux_spaces_court_anchor_wait:" + JSON.stringify(window_wait.data));
    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_spaces_court_anchor_row");
    const handle_text = "" + int_at(row, "handle");
    ensure(int_at(row, "handle") > 0,
      "cu_linux_spaces_court_anchor_handle:" + JSON.stringify(row));
    assert_fixture_process_state(run_directory, executable, fixture_pid);
    assert_fixture_desktop_state(
      run_directory, executable, fixture_pid, fixture_title, handle_text, row
    );
  } finally {
    if (fixture_pid !== 0) {
      rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
    }
    if (fixture !== null) {
      try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
    }
  }
}

function assert_headless_host_limit(run_directory, executable) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "observe",
    ["spaces"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!flag_at(reply, "ok"), "cu_linux_spaces_headless_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_spaces_headless_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.required_os") === "macos",
    "cu_linux_spaces_headless_required_os:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.limit") === "host",
    "cu_linux_spaces_headless_limit:" + JSON.stringify(reply.error)
  );
}

function verify_spaces_unsupported(reply, probe, desktop) {
  ensure(reply.ok !== true, "cu_linux_spaces_false_success");
  ensure(text_at(reply, "error.code") === "unsupported", "cu_linux_spaces_code");
  ensure(text_at(reply, "command") === "spaces", "cu_linux_spaces_command");
  const detail = at(reply, "error.detail");
  ensure(text_at(detail, "os") === "linux", "cu_linux_spaces_os:" + JSON.stringify(detail));
  ensure(text_at(detail, "limit") === "host", "cu_linux_spaces_limit");
  ensure(text_at(detail, "required_os") === "macos", "cu_linux_spaces_required_os");
  ensure(text_at(detail, "mechanism") === "skylight-private-read",
    "cu_linux_spaces_mechanism:" + JSON.stringify(detail));
  ensure(text_at(detail, "group") === "geometry", "cu_linux_spaces_group");
  ensure(text_at(reply, "error.message").indexOf("macOS") >= 0,
    "cu_linux_spaces_message:" + text_at(reply, "error.message"));
  const alternatives = at(detail, "alternatives");
  ensure(Array.isArray(alternatives) && alternatives.length > 0,
    "cu_linux_spaces_alternatives:" + JSON.stringify(detail));
  const joined = alternatives.join(" ").toLowerCase();
  ensure(joined.indexOf("displays") >= 0, "cu_linux_spaces_alternatives_displays:" + joined);
  ensure(joined.indexOf("windows") >= 0, "cu_linux_spaces_alternatives_windows:" + joined);
  ensure(probe.managed_spaces_unavailable === true,
    "cu_linux_spaces_probe_unavailable:" + JSON.stringify(probe));

  const ewmh = desktop.ewmh;
  const wmctrl = desktop.wmctrl;
  const ewmh_present = flag_at(ewmh, "ewmh_present");
  const wmctrl_present = flag_at(wmctrl, "present");

  if (ewmh_present && wmctrl_present) {
    ensure(
      int_at(ewmh, "current_desktop") === int_at(wmctrl, "current_desktop"),
      "cu_linux_spaces_ewmh_wmctrl_current:" + JSON.stringify(desktop)
    );
    ensure(
      int_at(ewmh, "desktop_count") === int_at(wmctrl, "desktop_count"),
      "cu_linux_spaces_ewmh_wmctrl_count:" + JSON.stringify(desktop)
    );
  }

  if (ewmh_present) {
    ensure(
      text_at(reply, "error.detail.required_os") === "macos",
      "cu_linux_spaces_ewmh_still_macos_only:" + JSON.stringify(reply.error)
    );
    print(
      "STEP independent xprop _NET_DESKTOP read-back: EWMH current_desktop="
        + int_at(ewmh, "current_desktop") + " desktop_count=" + int_at(ewmh, "desktop_count")
        + " names_present=" + flag_at(ewmh, "desktop_names_present")
        + " does not satisfy macOS SkyLight managed Space inventory"
    );
  } else {
    print(
      "STEP host lacks root _NET_CURRENT_DESKTOP/_NET_NUMBER_OF_DESKTOPS ("
        + text_at(ewmh, "reason")
        + "); spaces remains macOS-only typed host-limit"
    );
  }

  if (wmctrl_present) {
    ensure(
      text_at(reply, "error.detail.required_os") === "macos",
      "cu_linux_spaces_wmctrl_still_macos_only:" + JSON.stringify(reply.error)
    );
    print(
      "STEP independent wmctrl -d read-back: current_desktop="
        + int_at(wmctrl, "current_desktop") + " desktop_count=" + int_at(wmctrl, "desktop_count")
        + " does not satisfy macOS SkyLight managed Space inventory"
    );
  } else {
    print(
      "STEP independent wmctrl -d unavailable ("
        + text_at(wmctrl, "reason")
        + "); Linux workspace listing is not a SkyLight Space inventory"
    );
  }

  if (!ewmh_present && !wmctrl_present) {
    print(
      "STEP desktop/workspace API absent (xprop _NET_DESKTOP + wmctrl); spaces still typed host-limit unsupported — no fake green"
    );
  }
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_spaces_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-spaces");
const env = cu_env(executable);

print("STEP get-extents --name usage AND host-limit courts (including --coords/--bogus command=usage) before process-state/desktop-state and spaces inventory/observe");
assert_get_extents_usage_limit(context.run_directory, executable, env);
assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);

print("STEP spaces --name/--coords/--bogus use usage_rejects_unexpected or honest non-usage typed failure (never fake command=usage)");
assert_spaces_usage_limit(context.run_directory, executable, env);

print("STEP spaces without DISPLAY typed-fails unsupported macOS host-limit");
assert_headless_host_limit(context.run_directory, executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_spaces_fixture_missing:" + fixture_source);

print("STEP process-state and desktop-state bind the court anchor before spaces observe/read-back court");
assert_court_anchor_binding(context.run_directory, executable, env, fixture_source);

print("STEP independent probe confirms Linux has no macOS SkyLight managed Space model");
const probe = independent_probe();
ensure(probe.linux === true, "cu_linux_spaces_not_linux:" + JSON.stringify(probe));

print("STEP independent wmctrl -d and xprop _NET_DESKTOP workspace evidence");
const desktop = independent_desktop_workspace(context.run_directory, executable);

print("STEP spaces returns typed host-limit unsupported with detail.os/required_os/alternatives");
const spaces = invoke(context.run_directory, executable, ["spaces"], false);
verify_spaces_unsupported(spaces, probe, desktop);

print("STEP capabilities declares spaces unsupported on this Linux host");
const caps = invoke(context.run_directory, executable, ["capabilities"], true);
ensure(text_at(caps, "data.verbs.spaces.status") === "unsupported",
  "cu_linux_spaces_capabilities_status:" + JSON.stringify(at(caps, "data.verbs.spaces")));
ensure(text_at(caps, "data.verbs.spaces.os") === "linux",
  "cu_linux_spaces_capabilities_os:" + JSON.stringify(at(caps, "data.verbs.spaces")));
ensure(text_at(caps, "data.verbs.spaces.provider") === "none",
  "cu_linux_spaces_capabilities_provider:" + JSON.stringify(at(caps, "data.verbs.spaces")));

harness.emit_evidence(context, declared_evidence, "cu.linux-spaces-readback");
harness.remove_run(context);
print("PASS typed unsupported with SkyLight host-limit honesty, independent wmctrl/_NET_DESKTOP read-back, typed spaces --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit with --coords/--bogus command=usage (no atspi gating), process-state/desktop-state fixture binding before observe, headless paths, and capabilities alignment");
