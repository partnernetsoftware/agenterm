// CEO: Linux network-probe honesty with independent getent/getaddrinfo and
// python socket TCP read-back. Acceptance is smoke read-back only: CU
// resolve-once plus bounded TCP reachability must agree with an independent
// probe for the same host/port (reachable listener and closed-port failure).
// Typed network-probe usage must reject AT-SPI --name, --coords, --bogus, and
// other unexpected arguments; typed get-extents --name usage AND host-limit
// paths must both hold before the getent/getaddrinfo and python socket
// read-back court. Prefer host-limit clarity over fake success. AT-SPI/--name
// only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-network-probe-readback",
];

const AT_SPI_PROBE_NAME = "Network Probe Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function text_at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function int_at(value, dotted) {
  return rh.int_of(rh.field(value, dotted));
}

function flag_at(value, dotted) {
  return rh.field(value, dotted) === true;
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}


function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
         "cu_linux_network_probe_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "network-probe" || text_at(reply, "command") === "usage",
    "cu_linux_network_probe_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
         "cu_linux_network_probe_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_network_probe_usage_limit(run_directory, executable, env, host) {
  const flat_with_name = invoke_observe_reply(run_directory, executable, [
    "network-probe", host, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_network_probe_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_network_probe_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_network_probe_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_name, "error.message"), "--name"),
    "cu_linux_network_probe_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_observe_reply(run_directory, executable, [
    "network", "probe", host, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_network_probe_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_network_probe_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_name, "error.message"), "--name"),
    "cu_linux_network_probe_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const flat_with_bogus = invoke_observe_reply(run_directory, executable, [
    "network-probe", host, "--bogus",
  ], env);
  ensure(!output_success(flat_with_bogus),
    "cu_linux_network_probe_usage_flat_bogus_ok:" + JSON.stringify(flat_with_bogus));
  ensure(
    text_at(flat_with_bogus, "error.code") === "usage",
    "cu_linux_network_probe_usage_flat_bogus_code:" + JSON.stringify(flat_with_bogus.error)
  );
  ensure(
    text_at(flat_with_bogus, "command") === "usage",
    "cu_linux_network_probe_usage_flat_bogus_command:" + JSON.stringify(flat_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_bogus, "error.message"), "--bogus"),
    "cu_linux_network_probe_usage_flat_bogus_message:" + JSON.stringify(flat_with_bogus.error)
  );

  const grouped_with_bogus = invoke_observe_reply(run_directory, executable, [
    "network", "probe", host, "--bogus",
  ], env);
  ensure(!output_success(grouped_with_bogus),
    "cu_linux_network_probe_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_network_probe_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    text_at(grouped_with_bogus, "command") === "usage",
    "cu_linux_network_probe_usage_grouped_bogus_command:" + JSON.stringify(grouped_with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_bogus, "error.message"), "--bogus"),
    "cu_linux_network_probe_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const flat_with_coords = invoke_observe_reply(run_directory, executable, [
    "network-probe", host, "--coords", "10,10",
  ], env);
  ensure(!output_success(flat_with_coords),
    "cu_linux_network_probe_usage_flat_coords_ok:" + JSON.stringify(flat_with_coords));
  ensure(
    text_at(flat_with_coords, "error.code") === "usage",
    "cu_linux_network_probe_usage_flat_coords_code:" + JSON.stringify(flat_with_coords.error)
  );
  ensure(
    text_at(flat_with_coords, "command") === "usage",
    "cu_linux_network_probe_usage_flat_coords_command:" + JSON.stringify(flat_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_with_coords, "error.message"), "--coords"),
    "cu_linux_network_probe_usage_flat_coords_message:" + JSON.stringify(flat_with_coords.error)
  );

  const grouped_with_coords = invoke_observe_reply(run_directory, executable, [
    "network", "probe", host, "--coords", "10,10",
  ], env);
  ensure(!output_success(grouped_with_coords),
    "cu_linux_network_probe_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_network_probe_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    text_at(grouped_with_coords, "command") === "usage",
    "cu_linux_network_probe_usage_grouped_coords_command:" + JSON.stringify(grouped_with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_coords, "error.message"), "--coords"),
    "cu_linux_network_probe_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_network_probe_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_network_probe_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_network_probe_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_network_probe_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_network_probe_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_network_probe_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_network_probe_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_network_probe_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_network_probe_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_network_probe_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_network_probe_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_network_probe_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_network_probe_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_network_probe_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_network_probe_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_network_probe_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_network_probe_extents_unavailable_code:" + code
  );
}

function output_success(document) { return rh.field(document, "ok") === true; }

function invoke(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_network_probe_exit:" + output.exit_code + ":" + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(reply.ok === true, "cu_linux_network_probe_reply:" + output.stdout);
  return reply;
}

function independent_resolve(host, port) {
  const script = [
    "import json, socket, subprocess, sys",
    "host, port = sys.argv[1], int(sys.argv[2])",
    "def family_name(sock_family):",
    "    return 'ipv4' if sock_family == socket.AF_INET else 'ipv6'",
    "def resolve_getent(name):",
    "    out = subprocess.run(['getent', 'hosts', name], capture_output=True, text=True)",
    "    if out.returncode != 0:",
    "        return []",
    "    rows = []",
    "    for line in out.stdout.splitlines():",
    "        parts = line.split()",
    "        if len(parts) >= 1:",
    "            rows.append(parts[0])",
    "    return rows",
    "def resolve_getaddrinfo(name, port):",
    "    seen = set()",
    "    rows = []",
    "    for entry in socket.getaddrinfo(name, port, type=socket.SOCK_STREAM, proto=socket.IPPROTO_TCP):",
    "        addr = entry[4][0]",
    "        family = family_name(entry[0])",
    "        key = (addr, family)",
    "        if key in seen:",
    "            continue",
    "        seen.add(key)",
    "        rows.append({'address': addr, 'family': family})",
    "    return rows",
    "resolved = resolve_getaddrinfo(host, port)",
    "if not resolved:",
    "    raise SystemExit('independent_resolve_empty')",
    "print(json.dumps({",
    "    'getent_addresses': resolve_getent(host),",
    "    'resolved_addresses': resolved,",
    "    'address_count': len(resolved),",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, host, "" + port], { timeout_ms: 30000 });
  ensure(output.success === true, "cu_linux_network_probe_independent_resolve:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function independent_tcp_probe(host, port, attempts, timeout_ms) {
  const script = [
    "import json, socket, sys",
    "host, port, attempts, timeout_ms = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])",
    "def family_name(sock_family):",
    "    return 'ipv4' if sock_family == socket.AF_INET else 'ipv6'",
    "def resolve_getaddrinfo(name, port):",
    "    seen = set()",
    "    rows = []",
    "    for entry in socket.getaddrinfo(name, port, type=socket.SOCK_STREAM, proto=socket.IPPROTO_TCP):",
    "        addr = entry[4][0]",
    "        family = family_name(entry[0])",
    "        key = (addr, family)",
    "        if key in seen:",
    "            continue",
    "        seen.add(key)",
    "        rows.append({'address': addr, 'family': family})",
    "    return rows",
    "def tcp_outcome(address, family, port, timeout_ms):",
    "    sock_family = socket.AF_INET if family == 'ipv4' else socket.AF_INET6",
    "    sock = socket.socket(sock_family, socket.SOCK_STREAM)",
    "    sock.settimeout(timeout_ms / 1000.0)",
    "    try:",
    "        sock.connect((address, port))",
    "        sock.close()",
    "        return 'connected'",
    "    except socket.timeout:",
    "        return 'timeout'",
    "    except ConnectionRefusedError:",
    "        return 'refused'",
    "    except OSError:",
    "        return 'unreachable'",
    "resolved = resolve_getaddrinfo(host, port)",
    "if not resolved:",
    "    raise SystemExit('independent_resolve_empty')",
    "attempt_rows = []",
    "connected = 0",
    "for index in range(attempts):",
    "    row = resolved[index % len(resolved)]",
    "    outcome = tcp_outcome(row['address'], row['family'], port, timeout_ms)",
    "    if outcome == 'connected':",
    "        connected += 1",
    "    attempt_rows.append({",
    "        'attempt': index + 1,",
    "        'address': row['address'],",
    "        'family': row['family'],",
    "        'outcome': outcome,",
    "    })",
    "print(json.dumps({",
    "    'resolved_addresses': resolved,",
    "    'address_count': len(resolved),",
    "    'attempt_count': attempts,",
    "    'connected_count': connected,",
    "    'unreachable_count': attempts - connected,",
    "    'status': 'reachable' if connected > 0 else 'unreachable',",
    "    'attempts': attempt_rows,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", [
    "-c", script, host, "" + port, "" + attempts, "" + timeout_ms
  ], { timeout_ms: 30000 });
  ensure(output.success === true, "cu_linux_network_probe_independent_tcp:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function sorted_address_keys(rows) {
  const keys = [];
  for (let index = 0; index < rows.length; index = index + 1) {
    const row = rows[index];
    keys.push(text_at(row, "address") + "/" + text_at(row, "family"));
  }
  keys.sort();
  return keys;
}

function assert_resolution_agreement(cu_data, independent) {
  const cu_keys = sorted_address_keys(cu_data.resolved_addresses);
  const independent_keys = sorted_address_keys(independent.resolved_addresses);
  ensure(
    JSON.stringify(cu_keys) === JSON.stringify(independent_keys),
    "cu_linux_network_probe_resolve_mismatch:cu=" + JSON.stringify(cu_keys)
      + ":independent=" + JSON.stringify(independent_keys)
  );
  if (independent.getent_addresses.length > 0) {
    for (let index = 0; index < cu_data.resolved_addresses.length; index = index + 1) {
      const address = text_at(cu_data.resolved_addresses[index], "address");
      let found = false;
      for (let getent_index = 0; getent_index < independent.getent_addresses.length; getent_index = getent_index + 1) {
        if (independent.getent_addresses[getent_index] === address) { found = true; break; }
      }
      ensure(found, "cu_linux_network_probe_getent_mismatch:" + address);
    }
  }
  ensure(
    int_at(cu_data, "address_count") === int_at(independent, "address_count"),
    "cu_linux_network_probe_address_count:" + JSON.stringify(cu_data)
  );
}

function assert_tcp_agreement(cu_data, independent, expect_reachable) {
  ensure(
    int_at(cu_data, "attempt_count") === int_at(independent, "attempt_count")
      && int_at(cu_data, "connected_count") === int_at(independent, "connected_count")
      && int_at(cu_data, "unreachable_count") === int_at(independent, "unreachable_count")
      && text_at(cu_data, "status") === text_at(independent, "status"),
    "cu_linux_network_probe_counts_mismatch:cu=" + JSON.stringify(cu_data)
      + ":independent=" + JSON.stringify(independent)
  );
  ensure(
    expect_reachable
      ? text_at(cu_data, "status") === "reachable"
      : text_at(cu_data, "status") === "unreachable",
    "cu_linux_network_probe_status:" + text_at(cu_data, "status")
  );
  for (let index = 0; index < independent.attempts.length; index = index + 1) {
    const independent_row = independent.attempts[index];
    const cu_row = cu_data.attempts[index];
    ensure(
      int_at(cu_row, "attempt") === int_at(independent_row, "attempt")
        && text_at(cu_row, "address") === text_at(independent_row, "address")
        && text_at(cu_row, "family") === text_at(independent_row, "family")
        && text_at(cu_row, "outcome") === text_at(independent_row, "outcome"),
      "cu_linux_network_probe_attempt_mismatch:cu=" + JSON.stringify(cu_row)
        + ":independent=" + JSON.stringify(independent_row)
    );
  }
}

function start_fixture(context, run_directory, executable, attempts, label) {
  const stdout_path = rh.join(run_directory, label + ".stdout");
  const stderr_path = rh.join(run_directory, label + ".stderr");
  rh.try_remove_file(stdout_path);
  rh.try_remove_file(stderr_path);
  const child = harness.start_child(context, {
    program: executable,
    args: [
      "--agenterm-cu-internal-network-probe-fixture",
      "" + attempts,
      "10000"
    ],
    current_dir: run_directory,
    env: { AGENTERM_CU_INTERNAL_TEST_FIXTURE: "1" },
    stdout_path: stdout_path,
    stderr_path: stderr_path,
    timeout_ms: 30000
  }, label);
  let ready = null;
  for (let poll = 0; poll < 400; poll = poll + 1) {
    if (rh.is_direct_file(stdout_path)) {
      const text = rh.read_text(stdout_path).trim();
      if (text.startsWith("{") && text.endsWith("}")) {
        const candidate = JSON.parse(text);
        if (int_at(candidate, "port") > 0) { ready = candidate; break; }
      }
    }
    ensure(harness.child_state(child) !== "exited", "cu_linux_network_probe_fixture_early_exit:" + label);
    harness.sleep_ms(10);
  }
  ensure(ready !== null, "cu_linux_network_probe_fixture_not_ready:" + label);
  return { child: child, port: int_at(ready, "port"), stdout_path: stdout_path };
}

function reap_fixture(fixture, label) {
  const output = harness.child_wait(fixture.child, 5000);
  ensure(output.success === true, "cu_linux_network_probe_fixture_exit:" + label + ":" + JSON.stringify(output));
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-network-probe");
const run_directory = context.run_directory;
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
const owned_children = [];
let succeeded = 0;
let failure = "";

try {
  const host = "127.0.0.1";
  const timeout_ms = 500;
  const reachable_attempts = 3;
  const unreachable_attempts = 2;

  print("STEP network-probe typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_network_probe_usage_limit(run_directory, executable, env, host);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before getent/getaddrinfo read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before getent/getaddrinfo read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; network-probe read-back still uses getent/getaddrinfo and python socket");
  }

  print("STEP CU reachable observation against invocation-owned loopback listener");
  const cu_fixture = start_fixture(context, run_directory, executable, reachable_attempts, "cu-listener");
  owned_children.push(cu_fixture.child);
  const cu_reachable = invoke(run_directory, executable, [
    "network-probe", host,
    "--port", "" + cu_fixture.port,
    "--attempts", "" + reachable_attempts,
    "--timeout-ms", "" + timeout_ms
  ], env);
  ensure(
    text_at(cu_reachable.data, "provider") === "system-resolver-owned-worker"
      && flag_at(cu_reachable.data, "address_set_frozen")
      && text_at(cu_reachable.data, "status") === "reachable",
    "cu_linux_network_probe_cu_reachable:" + JSON.stringify(cu_reachable.data)
  );
  reap_fixture(cu_fixture, "cu-listener");

  print("STEP independent getent/getaddrinfo resolution agrees with CU frozen address set");
  const independent_resolve_closed = independent_resolve(host, cu_fixture.port);
  assert_resolution_agreement(cu_reachable.data, independent_resolve_closed);

  print("STEP independent python socket probe reaches its own listener with the same attempt semantics");
  const independent_fixture = start_fixture(
    context, run_directory, executable, reachable_attempts, "independent-listener"
  );
  owned_children.push(independent_fixture.child);
  const independent_reachable = independent_tcp_probe(
    host, independent_fixture.port, reachable_attempts, timeout_ms
  );
  ensure(text_at(independent_reachable, "status") === "reachable", "cu_linux_network_probe_independent_reachable");
  assert_tcp_agreement(cu_reachable.data, independent_reachable, true);
  reap_fixture(independent_fixture, "independent-listener");

  print("STEP CU and independent closed-port unreachable observations agree on the same port");
  const closed_port = cu_fixture.port;
  const cu_unreachable = invoke(run_directory, executable, [
    "network-probe", host,
    "--port", "" + closed_port,
    "--attempts", "" + unreachable_attempts,
    "--timeout-ms", "" + timeout_ms
  ], env);
  const independent_unreachable = independent_tcp_probe(
    host, closed_port, unreachable_attempts, timeout_ms
  );
  assert_resolution_agreement(cu_unreachable.data, independent_resolve(host, closed_port));
  assert_tcp_agreement(cu_unreachable.data, independent_unreachable, false);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, owned_children, succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-network-probe-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux network-probe matches independent getent/getaddrinfo and python socket TCP read-back with typed network-probe --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux network-probe matches independent getent/getaddrinfo and python socket TCP read-back with typed network-probe --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
