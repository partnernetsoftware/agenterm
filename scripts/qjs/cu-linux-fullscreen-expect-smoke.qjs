// CEO: fullscreen/unfullscreen --expect fullscreen|unfullscreen on Linux.
// Acceptance is smoke read-back only: independent xprop _NET_WM_STATE,
// windows inventory fullscreen field, and independent pyatspi window
// extents/state must match --expect after each verb. Typed usage,
// destructive-gate refusals, missing-window and headless host-limit paths
// must hold before any owned fixture window exists. Typed
// fullscreen/unfullscreen usage must reject AT-SPI --name, --coords, --bogus,
// and other unexpected arguments via usage_rejects_unexpected +
// command=usage, or an honest non-usage typed failure (never fake
// command=usage). Typed get-extents --name usage AND host-limit paths must
// both hold before process-state, desktop-state, and the actuate/read-back
// court (no if/else gating those courts on atspi_available); get-extents
// --coords/--bogus must reject as command=usage. Prefer host-limit clarity
// over fake success. AT-SPI/--name only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-fullscreen-expect-state",
];

const MISSING_HANDLE = "99999999";
const AT_SPI_PROBE_NAME = "Fullscreen Expect Court Anchor";
const FIXTURE_BUTTON_NAME = "Fixture Press";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function honest_actuate_non_usage_code(code) {
  return code === "a11y_backend_failed"
    || code === "unsupported"
    || code === "bad_handle"
    || code === "window_not_found"
    || code === "window_op_failed"
    || code === "invalid_input"
    || code === "refused";
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_fullscreen_expect_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_fullscreen_expect_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_fullscreen_expect_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function fullscreen_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["fullscreen"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_fullscreen_expect_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function unfullscreen_refused(run_directory, executable, arguments, code) {
  const reply = run_cu_reply(run_directory, executable, "actuate", ["unfullscreen"].concat(arguments));
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === code,
    "cu_linux_fullscreen_expect_unfullscreen_refused:" + code + ":" + JSON.stringify(reply)
  );
  return reply;
}

function assert_fullscreen_usage_limit(run_directory, executable) {
  const fullscreen_zero = run_cu_reply(run_directory, executable, "actuate", [
    "fullscreen", "--window", "0", "--expect", "fullscreen",
  ]);
  ensure(!output_success(fullscreen_zero), "cu_linux_fullscreen_expect_usage_ok:" + JSON.stringify(fullscreen_zero));
  ensure(
    text_at(fullscreen_zero, "error.code") === "usage",
    "cu_linux_fullscreen_expect_usage_code:" + JSON.stringify(fullscreen_zero.error)
  );
  ensure(
    text_at(fullscreen_zero, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_fullscreen_expect_usage_message:" + JSON.stringify(fullscreen_zero.error)
  );

  const unfullscreen_zero = run_cu_reply(run_directory, executable, "actuate", [
    "unfullscreen", "--window", "0", "--expect", "unfullscreen",
  ]);
  ensure(!output_success(unfullscreen_zero), "cu_linux_fullscreen_expect_unfullscreen_usage_ok:" + JSON.stringify(unfullscreen_zero));
  ensure(
    text_at(unfullscreen_zero, "error.code") === "usage",
    "cu_linux_fullscreen_expect_unfullscreen_usage_code:" + JSON.stringify(unfullscreen_zero.error)
  );
}

function assert_actuate_usage_reject(run_directory, executable, env, arguments, token, label) {
  const reply = run_cu_reply(run_directory, executable, "actuate", arguments, env);
  ensure(
    !output_success(reply),
    "cu_linux_fullscreen_expect_usage_" + label + "_ok:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  const command = text_at(reply, "command");
  if (code === "usage" || command === "usage") {
    ensure(
      code === "usage",
      "cu_linux_fullscreen_expect_usage_" + label + "_code:" + JSON.stringify(reply.error)
    );
    ensure(
      command === "usage",
      "cu_linux_fullscreen_expect_usage_" + label + "_command:" + JSON.stringify(reply)
    );
    ensure(
      usage_rejects_unexpected(text_at(reply, "error.message"), token),
      "cu_linux_fullscreen_expect_usage_" + label + "_message:" + JSON.stringify(reply.error)
    );
  } else {
    ensure(
      command !== "usage" && honest_actuate_non_usage_code(code),
      "cu_linux_fullscreen_expect_usage_" + label + "_honest:" + JSON.stringify(reply)
    );
  }
}

function assert_fullscreen_unfullscreen_unexpected_usage(run_directory, executable, env) {
  assert_actuate_usage_reject(run_directory, executable, env, [
    "fullscreen", "--window", "1", "--expect", "fullscreen", "--name", AT_SPI_PROBE_NAME,
  ], "--name", "name");
  assert_actuate_usage_reject(run_directory, executable, env, [
    "unfullscreen", "--window", "1", "--expect", "unfullscreen", "--name", AT_SPI_PROBE_NAME,
  ], "--name", "unfullscreen_name");
  assert_actuate_usage_reject(run_directory, executable, env, [
    "fullscreen", "--window", "1", "--expect", "fullscreen", "--bogus",
  ], "--bogus", "bogus");
  assert_actuate_usage_reject(run_directory, executable, env, [
    "unfullscreen", "--window", "1", "--expect", "unfullscreen", "--bogus",
  ], "--bogus", "unfullscreen_bogus");
  assert_actuate_usage_reject(run_directory, executable, env, [
    "fullscreen", "--window", "1", "--expect", "fullscreen", "--coords", "10,10",
  ], "--coords", "coords");
  assert_actuate_usage_reject(run_directory, executable, env, [
    "unfullscreen", "--window", "1", "--expect", "unfullscreen", "--coords", "10,10",
  ], "--coords", "unfullscreen_coords");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(
    !output_success(zero_handle),
    "cu_linux_fullscreen_expect_extents_usage_ok:" + JSON.stringify(zero_handle)
  );
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_fullscreen_expect_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_fullscreen_expect_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(
    !output_success(missing_name),
    "cu_linux_fullscreen_expect_extents_usage_name_ok:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_fullscreen_expect_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_fullscreen_expect_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_fullscreen_expect_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(
    !output_success(extents_coords),
    "cu_linux_fullscreen_expect_extents_coords_ok:" + JSON.stringify(extents_coords)
  );
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_fullscreen_expect_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_fullscreen_expect_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_fullscreen_expect_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(
    !output_success(extents_bogus),
    "cu_linux_fullscreen_expect_extents_bogus_ok:" + JSON.stringify(extents_bogus)
  );
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_fullscreen_expect_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_fullscreen_expect_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_fullscreen_expect_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_fullscreen_expect_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_fullscreen_expect_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_fullscreen_expect_extents_unavailable_code:" + code
  );
}

function assert_fullscreen_destructive_gate(run_directory, executable) {
  const missing_target = fullscreen_refused(
    run_directory, executable, ["--expect", "fullscreen"], "refused"
  );
  ensure(
    text_at(missing_target, "error.detail.reason") === "destructive_gate"
      && text_at(missing_target, "error.detail.effect") === "not_performed"
      && missing_target.error.detail.missing.length === 1
      && text_of(missing_target.error.detail.missing[0]) === "target",
    "cu_linux_fullscreen_expect_missing_target:" + JSON.stringify(missing_target)
  );

  const missing_postcondition = unfullscreen_refused(
    run_directory, executable, ["--window", "1"], "refused"
  );
  ensure(
    text_at(missing_postcondition, "error.detail.reason") === "destructive_gate"
      && missing_postcondition.error.detail.missing.length === 1
      && text_of(missing_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_fullscreen_expect_missing_postcondition:" + JSON.stringify(missing_postcondition)
  );

  const wrong_postcondition = fullscreen_refused(
    run_directory, executable, ["--window", "1", "--expect", "unfullscreen"], "refused"
  );
  ensure(
    text_at(wrong_postcondition, "error.detail.reason") === "destructive_gate"
      && wrong_postcondition.error.detail.missing.length === 1
      && text_of(wrong_postcondition.error.detail.missing[0]) === "postcondition",
    "cu_linux_fullscreen_expect_wrong_postcondition:" + JSON.stringify(wrong_postcondition)
  );

  const unfullscreen_missing = unfullscreen_refused(
    run_directory, executable, ["--expect", "unfullscreen"], "refused"
  );
  ensure(
    text_at(unfullscreen_missing, "error.detail.reason") === "destructive_gate"
      && unfullscreen_missing.error.detail.missing.length === 1
      && text_of(unfullscreen_missing.error.detail.missing[0]) === "target",
    "cu_linux_fullscreen_expect_unfullscreen_missing_target:" + JSON.stringify(unfullscreen_missing)
  );
}

function assert_fullscreen_missing_window(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "actuate", [
    "fullscreen", "--window", MISSING_HANDLE, "--expect", "fullscreen",
  ]);
  ensure(!output_success(reply), "cu_linux_fullscreen_expect_missing_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "window_op_failed",
    "cu_linux_fullscreen_expect_missing_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_fullscreen_expect_missing_effect:" + JSON.stringify(reply.error)
  );

  const unfullscreen_reply = run_cu_reply(run_directory, executable, "actuate", [
    "unfullscreen", "--window", MISSING_HANDLE, "--expect", "unfullscreen",
  ]);
  ensure(!output_success(unfullscreen_reply), "cu_linux_fullscreen_expect_unfullscreen_missing_ok:" + JSON.stringify(unfullscreen_reply));
  ensure(
    text_at(unfullscreen_reply, "error.code") === "window_op_failed",
    "cu_linux_fullscreen_expect_unfullscreen_missing_code:" + JSON.stringify(unfullscreen_reply.error)
  );
  ensure(
    text_at(unfullscreen_reply, "error.detail.effect") === "not_performed",
    "cu_linux_fullscreen_expect_unfullscreen_missing_effect:" + JSON.stringify(unfullscreen_reply.error)
  );
}

function assert_headless_host_limit(run_directory, executable, verb, label) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    [verb, "--window", "1", "--expect", verb === "fullscreen" ? "fullscreen" : "unfullscreen"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_fullscreen_expect_headless_ok_" + label + ":" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_fullscreen_expect_headless_code_" + label + ":" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("mechanism unavailable") >= 0
      || message.indexOf("agt_native_window_fullscreen") >= 0,
    "cu_linux_fullscreen_expect_headless_message_" + label + ":" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.detail.effect") === "not_performed",
    "cu_linux_fullscreen_expect_headless_effect_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_rows(reply) {
  const data = reply.data;
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  for (const row of window_rows(reply)) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_net_wm_fullscreen(run_directory, executable, handle) {
  const xprop = rh.command("xprop", ["-id", "" + handle, "_NET_WM_STATE"], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  if (!xprop.success) { return false; }
  return xprop.stdout.indexOf("_NET_WM_STATE_FULLSCREEN") >= 0;
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_fullscreen_expect_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_fullscreen_expect_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_fullscreen_expect_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_fullscreen_expect_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_fullscreen_expect_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function assert_get_extents_reject_coords_or_stay_named(
  run_directory, executable, handle, node_name, label
) {
  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "" + handle, "--name", node_name, "--coords", "10,10",
  ]);
  if (!output_success(extents_coords)) {
    ensure(
      text_at(extents_coords, "error.code") === "usage",
      "cu_linux_fullscreen_expect_named_extents_coords_code_" + label + ":"
        + JSON.stringify(extents_coords.error)
    );
    ensure(
      text_at(extents_coords, "command") === "usage",
      "cu_linux_fullscreen_expect_named_extents_coords_command_" + label + ":"
        + JSON.stringify(extents_coords)
    );
    ensure(
      usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
        || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
      "cu_linux_fullscreen_expect_named_extents_coords_message_" + label + ":"
        + JSON.stringify(extents_coords.error)
    );
  } else {
    ensure(
      text_at(extents_coords, "data.addressing") === "accessibility-tree"
        && text_at(extents_coords, "data.matched.name") === node_name,
      "cu_linux_fullscreen_expect_named_extents_coords_named_" + label + ":"
        + JSON.stringify(extents_coords.data)
    );
  }

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "" + handle, "--name", node_name, "--bogus",
  ]);
  if (!output_success(extents_bogus)) {
    ensure(
      text_at(extents_bogus, "error.code") === "usage",
      "cu_linux_fullscreen_expect_named_extents_bogus_code_" + label + ":"
        + JSON.stringify(extents_bogus.error)
    );
    ensure(
      text_at(extents_bogus, "command") === "usage",
      "cu_linux_fullscreen_expect_named_extents_bogus_command_" + label + ":"
        + JSON.stringify(extents_bogus)
    );
    ensure(
      usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
        || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
      "cu_linux_fullscreen_expect_named_extents_bogus_message_" + label + ":"
        + JSON.stringify(extents_bogus.error)
    );
  } else {
    ensure(
      text_at(extents_bogus, "data.addressing") === "accessibility-tree"
        && text_at(extents_bogus, "data.matched.name") === node_name,
      "cu_linux_fullscreen_expect_named_extents_bogus_named_" + label + ":"
        + JSON.stringify(extents_bogus.data)
    );
  }
}

function independent_pyatspi_window(run_directory, executable, title) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "frame = None",
    "for i in range(desktop.childCount):",
    "    app = desktop.getChildAtIndex(i)",
    "    if app is None:",
    "        continue",
    "    for j in range(app.childCount):",
    "        w = app.getChildAtIndex(j)",
    "        if w is not None and w.name == title:",
    "            frame = w",
    "            break",
    "    if frame is not None:",
    "        break",
    "if frame is None:",
    "    raise SystemExit('cu_linux_fullscreen_expect_atspi_no_frame')",
    "st = frame.getState()",
    "states = []",
    "for s in st.get_states():",
    "    states.append(str(s).split('.')[-1].lower())",
    "showing = st.contains(pyatspi.STATE_SHOWING)",
    "visible = st.contains(pyatspi.STATE_VISIBLE)",
    "iconified = st.contains(pyatspi.STATE_ICONIFIED)",
    "fullscreen_token = False",
    "for name in states:",
    "    if name.find('fullscreen') >= 0:",
    "        fullscreen_token = True",
    "x = 0",
    "y = 0",
    "width = 0",
    "height = 0",
    "try:",
    "    ext = frame.queryComponent().getExtents(pyatspi.DESKTOP_COORDS)",
    "    x = int(ext.x)",
    "    y = int(ext.y)",
    "    width = int(ext.width)",
    "    height = int(ext.height)",
    "except Exception as error:",
    "    raise SystemExit('cu_linux_fullscreen_expect_atspi_extents:' + str(error))",
    "print(json.dumps({",
    "    'showing': showing,",
    "    'visible': visible,",
    "    'iconified': iconified,",
    "    'fullscreen_token': fullscreen_token,",
    "    'states': states,",
    "    'x': x, 'y': y, 'width': width, 'height': height,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_fullscreen_expect_pyatspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function independent_pyatspi_named_extents(run_directory, executable, title, node_name) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "want = sys.argv[2]",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and w.name == title:",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    if (node.name or '') == want:",
    "        return node",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_fullscreen_expect_atspi_no_frame')",
    "node = walk(frame)",
    "if node is None:",
    "    raise SystemExit('cu_linux_fullscreen_expect_atspi_miss:' + want)",
    "component = node.queryComponent()",
    "ext = component.getExtents(pyatspi.DESKTOP_COORDS)",
    "print(json.dumps({",
    "    'name': want,",
    "    'x': int(ext.x), 'y': int(ext.y),",
    "    'width': int(ext.width), 'height': int(ext.height),",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title, node_name], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(
    output.success === true,
    "cu_linux_fullscreen_expect_pyatspi_named:" + output.stderr + output.stdout
  );
  return JSON.parse(output.stdout.trim());
}

function assert_get_extents_name_agreement(run_directory, executable, handle, title, node_name) {
  const pyatspi_node = independent_pyatspi_named_extents(
    run_directory, executable, title, node_name
  );
  const cu_extents = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", handle, "--name", node_name,
  ]);
  ensure(
    int_at(cu_extents, "data.extents.x") === pyatspi_node.x
      && int_at(cu_extents, "data.extents.y") === pyatspi_node.y
      && int_at(cu_extents, "data.extents.width") === pyatspi_node.width
      && int_at(cu_extents, "data.extents.height") === pyatspi_node.height,
    "cu_linux_fullscreen_expect_extents_agree:" + JSON.stringify({
      cu: cu_extents.data.extents,
      pyatspi: pyatspi_node,
    })
  );
}

function assert_pyatspi_window_not_fullscreen(probe, label) {
  ensure(flag_at(probe, "showing") === true, "cu_linux_fullscreen_expect_pyatspi_showing_" + label);
  ensure(flag_at(probe, "iconified") === false, "cu_linux_fullscreen_expect_pyatspi_iconified_" + label);
  ensure(int_at(probe, "width") > 0 && int_at(probe, "height") > 0,
    "cu_linux_fullscreen_expect_pyatspi_extents_" + label + ":" + JSON.stringify(probe));
  ensure(
    flag_at(probe, "fullscreen_token") === false,
    "cu_linux_fullscreen_expect_pyatspi_token_" + label + ":" + JSON.stringify(probe)
  );
}

function assert_pyatspi_window_fullscreen(probe, baseline, label) {
  ensure(flag_at(probe, "showing") === true, "cu_linux_fullscreen_expect_pyatspi_showing_" + label);
  ensure(flag_at(probe, "iconified") === false, "cu_linux_fullscreen_expect_pyatspi_iconified_" + label);
  const width = int_at(probe, "width");
  const height = int_at(probe, "height");
  const grew = width > int_at(baseline, "width") || height > int_at(baseline, "height");
  ensure(
    grew === true,
    "cu_linux_fullscreen_expect_pyatspi_grew_" + label + ":" + JSON.stringify({
      baseline: baseline,
      after: probe,
    })
  );
}

function assert_pyatspi_window_restored(probe, fullscreen_probe, label) {
  ensure(flag_at(probe, "showing") === true, "cu_linux_fullscreen_expect_pyatspi_showing_" + label);
  ensure(flag_at(probe, "iconified") === false, "cu_linux_fullscreen_expect_pyatspi_iconified_" + label);
  ensure(
    flag_at(probe, "fullscreen_token") === false,
    "cu_linux_fullscreen_expect_pyatspi_token_" + label + ":" + JSON.stringify(probe)
  );
  const shrunk = int_at(probe, "width") < int_at(fullscreen_probe, "width")
    || int_at(probe, "height") < int_at(fullscreen_probe, "height");
  ensure(
    shrunk === true,
    "cu_linux_fullscreen_expect_pyatspi_shrunk_" + label + ":" + JSON.stringify({
      fullscreen: fullscreen_probe,
      after: probe,
    })
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-fullscreen-expect-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_fullscreen_expect_fixture_missing:" + fixture_source);

print("STEP fullscreen/unfullscreen typed-fails usage when --window handle is zero");
assert_fullscreen_usage_limit(run_directory, executable);

print("STEP fullscreen/unfullscreen typed-fails refused destructive_gate when target or postcondition is missing");
assert_fullscreen_destructive_gate(run_directory, executable);

print("STEP fullscreen/unfullscreen typed-fails window_op_failed when handle is absent from inventory");
assert_fullscreen_missing_window(run_directory, executable);

print("STEP fullscreen/unfullscreen without DISPLAY typed-fails unsupported host-limit");
assert_headless_host_limit(run_directory, executable, "fullscreen", "fullscreen");
assert_headless_host_limit(run_directory, executable, "unfullscreen", "unfullscreen");

print("STEP fullscreen/unfullscreen typed-fail usage when AT-SPI --name/--coords/--bogus is present (usage_rejects_unexpected + command=usage, or honest non-usage typed failure; never fake command=usage)");
assert_fullscreen_unfullscreen_unexpected_usage(run_directory, executable, env);

print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (command=usage) before process-state/desktop-state and actuate/read-back court");
assert_get_extents_usage_limit(run_directory, executable, env);

print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and actuate/read-back court");
assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

if (!atspi_available) {
  print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held; fullscreen read-back still uses xprop/inventory");
}

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_fullscreen_expect_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_fullscreen_expect_window_missing");
  const handle = int_at(row, "handle");
  const handle_text = "" + handle;
  ensure(handle > 0, "cu_linux_fullscreen_expect_handle:" + JSON.stringify(row));
  ensure(
    flag_at(row, "fullscreen") === false,
    "cu_linux_fullscreen_expect_baseline_not_fullscreen:" + JSON.stringify(row)
  );
  ensure(
    independent_net_wm_fullscreen(run_directory, executable, handle) === false,
    "cu_linux_fullscreen_expect_baseline_xprop_not_fullscreen"
  );

  print("STEP process-state binds the owned fixture pid before fullscreen actuate/read-back court");
  assert_fixture_process_state(run_directory, executable, fixture_pid);

  print("STEP desktop-state window row agrees with inventory before fullscreen actuate/read-back court");
  assert_fixture_desktop_state(
    run_directory, executable, fixture_pid, fixture_title, handle_text, row
  );

  let pyatspi_baseline = null;
  if (atspi_available) {
    print("STEP independent pyatspi extents and CU get-extents --name agree before fullscreen actuate/read-back");
    assert_get_extents_name_agreement(
      run_directory, executable, handle_text, fixture_title, FIXTURE_BUTTON_NAME
    );
    print("STEP get-extents --name with --coords/--bogus rejects as command=usage or stays accessibility-tree before fullscreen actuate/read-back");
    assert_get_extents_reject_coords_or_stay_named(
      run_directory, executable, handle_text, FIXTURE_BUTTON_NAME, "before_actuate"
    );
    pyatspi_baseline = independent_pyatspi_window(run_directory, executable, fixture_title);
    assert_pyatspi_window_not_fullscreen(pyatspi_baseline, "baseline");
  }

  print("STEP destructive_gate refusals on a live handle must not change xprop or inventory");
  fullscreen_refused(
    run_directory, executable, ["--window", handle_text, "--expect", "unfullscreen"], "refused"
  );
  unfullscreen_refused(
    run_directory, executable, ["--window", handle_text, "--expect", "fullscreen"], "refused"
  );
  ensure(
    independent_net_wm_fullscreen(run_directory, executable, handle) === false,
    "cu_linux_fullscreen_expect_refusal_xprop_changed"
  );
  const refusal_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(refusal_row !== null, "cu_linux_fullscreen_expect_refusal_row_missing");
  ensure(
    flag_at(refusal_row, "fullscreen") === false,
    "cu_linux_fullscreen_expect_refusal_inventory_changed:" + JSON.stringify(refusal_row)
  );

  print("STEP fullscreen --window " + handle_text + " --expect fullscreen");
  const fullscreen = run_cu(run_directory, executable, "actuate", [
    "fullscreen", "--window", handle_text, "--expect", "fullscreen",
  ]);
  ensure(
    flag_at(fullscreen, "data.verified")
      && flag_at(fullscreen, "data.after.fullscreen") === true,
    "cu_linux_fullscreen_expect_reply_fullscreen:" + JSON.stringify(fullscreen.data)
  );

  print("STEP independent xprop _NET_WM_STATE read-back: fullscreen must be true");
  ensure(
    independent_net_wm_fullscreen(run_directory, executable, handle) === true,
    "cu_linux_fullscreen_expect_xprop_fullscreen"
  );

  print("STEP independent windows inventory read-back: fullscreen must be true");
  const fullscreen_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(fullscreen_row !== null, "cu_linux_fullscreen_expect_fullscreen_row_missing");
  ensure(
    flag_at(fullscreen_row, "fullscreen") === true,
    "cu_linux_fullscreen_expect_inventory_fullscreen:" + JSON.stringify(fullscreen_row)
  );

  let pyatspi_fullscreen = null;
  if (atspi_available) {
    print("STEP independent pyatspi window extents/state read-back: fullscreen must grow vs baseline");
    pyatspi_fullscreen = independent_pyatspi_window(run_directory, executable, fixture_title);
    assert_pyatspi_window_fullscreen(pyatspi_fullscreen, pyatspi_baseline, "fullscreen");
  }

  print("STEP unfullscreen --window " + handle_text + " --expect unfullscreen");
  const unfullscreen = run_cu(run_directory, executable, "actuate", [
    "unfullscreen", "--window", handle_text, "--expect", "unfullscreen",
  ]);
  ensure(
    flag_at(unfullscreen, "data.verified")
      && flag_at(unfullscreen, "data.after.fullscreen") === false,
    "cu_linux_fullscreen_expect_reply_unfullscreen:" + JSON.stringify(unfullscreen.data)
  );

  print("STEP independent xprop _NET_WM_STATE read-back: fullscreen must be false");
  ensure(
    independent_net_wm_fullscreen(run_directory, executable, handle) === false,
    "cu_linux_fullscreen_expect_xprop_unfullscreen"
  );

  print("STEP independent windows inventory read-back: fullscreen must be false");
  const restored_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(restored_row !== null, "cu_linux_fullscreen_expect_unfullscreen_row_missing");
  ensure(
    flag_at(restored_row, "fullscreen") === false,
    "cu_linux_fullscreen_expect_inventory_unfullscreen:" + JSON.stringify(restored_row)
  );

  if (atspi_available) {
    print("STEP independent pyatspi window extents/state read-back: unfullscreen must shrink vs fullscreen");
    const pyatspi_restored = independent_pyatspi_window(run_directory, executable, fixture_title);
    assert_pyatspi_window_restored(pyatspi_restored, pyatspi_fullscreen, "unfullscreen");
  }
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-fullscreen-expect");
harness.emit_evidence(context, declared_evidence, "cu.linux-fullscreen-expect-state");
harness.remove_run(context);
print("PASS: Linux fullscreen/unfullscreen usage/host-limit/miss honesty + independent xprop, windows inventory, and pyatspi extents/state fullscreen read-back with typed fullscreen/unfullscreen --name/--coords/--bogus usage_rejects_unexpected (never fake command=usage), get-extents --name usage AND host-limit with --coords/--bogus command=usage (no atspi gating), and process-state/desktop-state binding before actuate (AT-SPI --name, no --coords)");
return;
