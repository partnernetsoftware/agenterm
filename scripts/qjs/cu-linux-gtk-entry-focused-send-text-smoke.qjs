// CEO: GTK entry focus --name then bare send-text --window (no --name).
// Acceptance: independent get-text --window (no --name) == SEED through
// AT-SPI live-probe focused path; no --coords or screenshot degradation.
// Typed focus/send-text/get-text/focused usage and host-limit paths must hold
// when --window/--name are missing or the AT-SPI bus is unavailable; typed
// get-extents --name usage/host-limit paths must hold before the native
// actuate/read-back court.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-gtk-entry-focus",
  "cu.linux-gtk-entry-focused-send-text",
  "cu.linux-gtk-entry-focused-get-text",
];

const ENTRY_NAME = "Fixture Entry";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_entry_focused_send_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(document), "cu_linux_gtk_entry_focused_send_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_gtk_entry_focused_send_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_focused_send_text_usage_limit(run_directory, executable) {
  const focus_missing_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "1",
  ]);
  ensure(!output_success(focus_missing_name),
    "cu_linux_gtk_entry_focused_send_focus_missing_name_ok:" + JSON.stringify(focus_missing_name));
  ensure(
    text_at(focus_missing_name, "error.code") === "usage"
      || text_at(focus_missing_name, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_focused_send_focus_missing_name_code:" + JSON.stringify(focus_missing_name.error)
  );
  ensure(
    text_at(focus_missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_focused_send_focus_missing_name_message:" + JSON.stringify(focus_missing_name.error)
  );

  const focus_zero_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "0", "--name", ENTRY_NAME,
  ]);
  ensure(!output_success(focus_zero_handle),
    "cu_linux_gtk_entry_focused_send_focus_zero_ok:" + JSON.stringify(focus_zero_handle));
  ensure(
    text_at(focus_zero_handle, "error.code") === "usage"
      || text_at(focus_zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_focused_send_focus_zero_code:" + JSON.stringify(focus_zero_handle.error)
  );
  ensure(
    text_at(focus_zero_handle, "error.message").indexOf("--window") >= 0
      || text_at(focus_zero_handle, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_gtk_entry_focused_send_focus_zero_message:" + JSON.stringify(focus_zero_handle.error)
  );

  const send_name_without_window = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--name", ENTRY_NAME, "--", "probe",
  ]);
  ensure(!output_success(send_name_without_window),
    "cu_linux_gtk_entry_focused_send_send_name_ok:" + JSON.stringify(send_name_without_window));
  ensure(
    text_at(send_name_without_window, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_focused_send_send_name_code:" + JSON.stringify(send_name_without_window.error)
  );
  ensure(
    text_at(send_name_without_window, "error.message").indexOf("--window") >= 0,
    "cu_linux_gtk_entry_focused_send_send_name_message:" + JSON.stringify(send_name_without_window.error)
  );

  const send_role_without_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "1", "--role", "entry", "--", "probe",
  ]);
  ensure(!output_success(send_role_without_name),
    "cu_linux_gtk_entry_focused_send_send_role_ok:" + JSON.stringify(send_role_without_name));
  ensure(
    text_at(send_role_without_name, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_focused_send_send_role_code:" + JSON.stringify(send_role_without_name.error)
  );
  ensure(
    text_at(send_role_without_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_gtk_entry_focused_send_send_role_message:" + JSON.stringify(send_role_without_name.error)
  );

  const get_text_zero = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "0",
  ]);
  ensure(!output_success(get_text_zero),
    "cu_linux_gtk_entry_focused_send_get_text_zero_ok:" + JSON.stringify(get_text_zero));
  ensure(
    text_at(get_text_zero, "error.code") === "usage"
      || text_at(get_text_zero, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_focused_send_get_text_zero_code:" + JSON.stringify(get_text_zero.error)
  );
  ensure(
    text_at(get_text_zero, "error.message").indexOf("window") >= 0
      || text_at(get_text_zero, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_gtk_entry_focused_send_get_text_zero_message:" + JSON.stringify(get_text_zero.error)
  );

  const focused_zero = run_cu_reply(run_directory, executable, "observe", [
    "focused", "--window", "0",
  ]);
  ensure(!output_success(focused_zero),
    "cu_linux_gtk_entry_focused_send_focused_zero_ok:" + JSON.stringify(focused_zero));
  ensure(
    text_at(focused_zero, "error.code") === "usage",
    "cu_linux_gtk_entry_focused_send_focused_zero_code:" + JSON.stringify(focused_zero.error)
  );
  ensure(
    text_at(focused_zero, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_gtk_entry_focused_send_focused_zero_message:" + JSON.stringify(focused_zero.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", ENTRY_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_gtk_entry_focused_send_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_gtk_entry_focused_send_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_gtk_entry_focused_send_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", ENTRY_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_gtk_entry_focused_send_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_gtk_entry_focused_send_extents_unavailable_code:" + code
  );
}

function assert_focused_send_text_host_limit_when_atspi_absent(run_directory, executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
  const focus_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "focus", "--window", "1", "--name", ENTRY_NAME,
  ], env);
  ensure(!output_success(focus_reply),
    "cu_linux_gtk_entry_focused_send_focus_unavailable_ok:" + JSON.stringify(focus_reply));
  const focus_code = text_at(focus_reply, "error.code");
  ensure(
    focus_code === "a11y_backend_failed" || focus_code === "unsupported" || focus_code === "bad_handle",
    "cu_linux_gtk_entry_focused_send_focus_unavailable_code:" + focus_code
  );

  const send_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "send-text", "--window", "1", "--", "probe",
  ], env);
  ensure(!output_success(send_reply),
    "cu_linux_gtk_entry_focused_send_send_unavailable_ok:" + JSON.stringify(send_reply));
  const send_code = text_at(send_reply, "error.code");
  ensure(
    send_code === "a11y_backend_failed" || send_code === "unsupported" || send_code === "bad_handle",
    "cu_linux_gtk_entry_focused_send_send_unavailable_code:" + send_code
  );

  const get_reply = run_cu_reply(run_directory, executable, "observe", [
    "get-text", "--window", "1",
  ], env);
  ensure(!output_success(get_reply),
    "cu_linux_gtk_entry_focused_send_get_unavailable_ok:" + JSON.stringify(get_reply));
  const get_code = text_at(get_reply, "error.code");
  ensure(
    get_code === "a11y_backend_failed" || get_code === "unsupported" || get_code === "bad_handle",
    "cu_linux_gtk_entry_focused_send_get_unavailable_code:" + get_code
  );

  const focused_reply = run_cu_reply(run_directory, executable, "observe", [
    "focused", "--window", "1",
  ], env);
  ensure(!output_success(focused_reply),
    "cu_linux_gtk_entry_focused_send_focused_unavailable_ok:" + JSON.stringify(focused_reply));
  const focused_code = text_at(focused_reply, "error.code");
  ensure(
    focused_code === "a11y_backend_failed" || focused_code === "unsupported" || focused_code === "bad_handle"
      || focused_code === "a11y_focus_unavailable",
    "cu_linux_gtk_entry_focused_send_focused_unavailable_code:" + focused_code
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_gtk_entry_focused_send_executable_missing");
const context = harness.new_context(repo, "cu-linux-gtk-entry-focused-send");
const run_directory = rh.join(repo, "target/cu-linux-gtk-entry-focused-send-text-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_gtk_entry_focused_send_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP focus/send-text/get-text/focused typed-fail usage when --window or --name is missing");
  assert_focused_send_text_usage_limit(run_directory, executable);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before actuate/read-back court");
    assert_get_extents_usage_limit(run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
  }

  if (!atspi_available) {
    print("STEP focus/send-text/get-text/focused typed-fail host-limit when independent pyatspi desktop probe is unavailable");
    assert_focused_send_text_host_limit_when_atspi_absent(run_directory, executable);
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-focus");
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-focused-send-text");
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-focused-get-text");
    succeeded = 1;
  } else {
    print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_gtk_entry_focused_send_window_wait");
    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_gtk_entry_focused_send_window_identity");
    const handle = "" + at(row, "handle");

    print("STEP focus --name moves AT-SPI focus to the GTK entry");
    const focused_act = run_cu(run_directory, executable, "observe,actuate", [
      "focus", "--window", handle, "--name", ENTRY_NAME,
    ]);
    ensure(
      flag_at(focused_act, "data.verified"),
      "cu_linux_gtk_entry_focused_send_focus_verified:" + JSON.stringify(focused_act.data)
    );
    const focused = run_cu(run_directory, executable, "observe", [
      "focused", "--window", handle,
    ]);
    ensure(
      text_at(focused, "data.node.name") === ENTRY_NAME,
      "cu_linux_gtk_entry_focused_send_focused:" + JSON.stringify(focused.data)
    );
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-focus");

    const seed = "ceo-focused-send-" + context.run_id;
    print("STEP send-text --window without --name writes SEED into the focused control");
    const sent = run_cu(run_directory, executable, "observe,actuate", [
      "send-text", "--window", handle, "--", seed,
    ]);
    ensure(
      text_at(sent, "data.typed") === seed
        && text_at(sent, "data.addressing") === "accessibility-tree"
        && text_at(sent, "data.action") === "send-text",
      "cu_linux_gtk_entry_focused_send_actuate:" + JSON.stringify(sent.data)
    );
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-focused-send-text");

    print("STEP independent get-text --window without --name reads SEED via AT-SPI Text.GetText");
    const got = run_cu(run_directory, executable, "observe", [
      "get-text", "--window", handle,
    ]);
    const readback = text_at(got, "data.text");
    ensure(
      readback === seed && text_at(got, "data.via") === "gettext",
      "cu_linux_gtk_entry_focused_send_get:" + JSON.stringify({ seed: seed, readback: readback })
    );
    harness.emit_evidence(context, declared_evidence, "cu.linux-gtk-entry-focused-get-text");

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_gtk_entry_focused_send_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: CEO GTK entry focus --name → send-text --window → get-text --window with typed focus/send-text/get-text/focused/get-extents usage honesty (AT-SPI focused path, no --coords)");
} else {
  print("PASS: CEO GTK entry focus/send-text/get-text/focused typed-fails with typed get-extents host-limit honesty when independent pyatspi desktop probe is unavailable");
}
return;
