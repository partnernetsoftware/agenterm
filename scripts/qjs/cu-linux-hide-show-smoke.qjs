// CEO: app hide / show on Linux with independent map-state, inventory and
// AT-SPI read-back. Acceptance is smoke read-back only: hide must leave
// every process window off screen and read back as unmapped/iconified;
// show must restore viewable inventory rows. Typed usage, missing-window
// and headless host-limit paths must hold before any owned fixture window
// exists. GTK fixture ok; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-app-hide-show-state",
];

const MISSING_HANDLE = "99999999";
const MISSING_PID = "99999999";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function last_json_line(text) {
  const lines = text.split("\n");
  for (let index = lines.length - 1; index >= 0; index = index - 1) {
    const line = lines[index].trim();
    if (line.charAt(0) === "{") { return JSON.parse(line); }
  }
  throw "cu_linux_hide_show_missing_json";
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  ensure(output.stdout.trim() !== "", "cu_linux_hide_show_empty_reply:" + output.stderr);
  return last_json_line(output.stdout);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_hide_show_reply:" + JSON.stringify(document));
  return document;
}

function assert_hide_show_usage_limits(run_directory, executable) {
  const missing_target = run_cu_reply(run_directory, executable, "actuate", [
    "app", "hide",
  ]);
  ensure(!output_success(missing_target), "cu_linux_hide_show_usage_hide_ok:" + JSON.stringify(missing_target));
  ensure(
    text_at(missing_target, "error.code") === "usage",
    "cu_linux_hide_show_usage_hide_code:" + JSON.stringify(missing_target.error)
  );
  ensure(
    text_at(missing_target, "error.message").indexOf("--window") >= 0
      || text_at(missing_target, "error.message").indexOf("--pid") >= 0,
    "cu_linux_hide_show_usage_hide_message:" + JSON.stringify(missing_target.error)
  );

  const hide_zero = run_cu_reply(run_directory, executable, "actuate", [
    "app", "hide", "--window", "0",
  ]);
  ensure(!output_success(hide_zero), "cu_linux_hide_show_usage_hide_zero_ok:" + JSON.stringify(hide_zero));
  ensure(
    text_at(hide_zero, "error.code") === "usage",
    "cu_linux_hide_show_usage_hide_zero_code:" + JSON.stringify(hide_zero.error)
  );
  ensure(
    text_at(hide_zero, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_hide_show_usage_hide_zero_message:" + JSON.stringify(hide_zero.error)
  );

  const show_missing = run_cu_reply(run_directory, executable, "actuate", [
    "app", "show",
  ]);
  ensure(!output_success(show_missing), "cu_linux_hide_show_usage_show_ok:" + JSON.stringify(show_missing));
  ensure(
    text_at(show_missing, "error.code") === "usage",
    "cu_linux_hide_show_usage_show_code:" + JSON.stringify(show_missing.error)
  );
}

function assert_hide_show_invalid_input(run_directory, executable) {
  const show_window_only = run_cu_reply(run_directory, executable, "actuate", [
    "app", "show", "--window", "1",
  ]);
  ensure(!output_success(show_window_only), "cu_linux_hide_show_show_window_ok:" + JSON.stringify(show_window_only));
  ensure(
    text_at(show_window_only, "error.code") === "invalid_input",
    "cu_linux_hide_show_show_window_code:" + JSON.stringify(show_window_only.error)
  );
  ensure(
    text_at(show_window_only, "error.message").indexOf("--pid") >= 0,
    "cu_linux_hide_show_show_window_message:" + JSON.stringify(show_window_only.error)
  );

  const hide_snapshot = run_cu_reply(run_directory, executable, "actuate", [
    "app", "hide", "--window", "1", "--snapshot",
  ]);
  ensure(!output_success(hide_snapshot), "cu_linux_hide_show_hide_snapshot_ok:" + JSON.stringify(hide_snapshot));
  ensure(
    text_at(hide_snapshot, "error.code") === "invalid_input",
    "cu_linux_hide_show_hide_snapshot_code:" + JSON.stringify(hide_snapshot.error)
  );
  ensure(
    text_at(hide_snapshot, "error.message").indexOf("quit") >= 0,
    "cu_linux_hide_show_hide_snapshot_message:" + JSON.stringify(hide_snapshot.error)
  );
}

function assert_hide_show_missing_window(run_directory, executable) {
  const hide_missing = run_cu_reply(run_directory, executable, "actuate", [
    "app", "hide", "--window", MISSING_HANDLE,
  ]);
  ensure(!output_success(hide_missing), "cu_linux_hide_show_missing_hide_ok:" + JSON.stringify(hide_missing));
  ensure(
    text_at(hide_missing, "error.code") === "window_not_found",
    "cu_linux_hide_show_missing_hide_code:" + JSON.stringify(hide_missing.error)
  );

  const show_missing = run_cu_reply(run_directory, executable, "actuate", [
    "app", "show", "--pid", MISSING_PID,
  ]);
  ensure(!output_success(show_missing), "cu_linux_hide_show_missing_show_ok:" + JSON.stringify(show_missing));
  ensure(
    text_at(show_missing, "error.code") === "a11y_app_not_found",
    "cu_linux_hide_show_missing_show_code:" + JSON.stringify(show_missing.error)
  );
  ensure(
    int_at(show_missing, "error.detail.process_id") === rh.parse_int(MISSING_PID),
    "cu_linux_hide_show_missing_show_pid:" + JSON.stringify(show_missing.error)
  );
}

function assert_headless_host_limit(run_directory, executable, action, label) {
  const arguments = action === "show"
    ? ["app", "show", "--pid", "1"]
    : ["app", "hide", "--window", "1"];
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    arguments,
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_hide_show_headless_ok_" + label + ":" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_hide_show_headless_code_" + label + ":" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("window enumeration") >= 0
      || message.indexOf("unavailable") >= 0,
    "cu_linux_hide_show_headless_message_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_rows(reply) {
  const data = reply.data;
  if (data.windows !== undefined) { return data.windows; }
  return data;
}

function windows_on_screen(run_directory, executable, pid) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = window_rows(reply);
  let on_screen = 0;
  for (const row of rows) {
    if (flag_at(row, "minimized") !== true) { on_screen = on_screen + 1; }
  }
  return { listed: rows.length, on_screen: on_screen, rows: rows };
}

function window_row(run_directory, executable, pid, title) {
  const inventory = windows_on_screen(run_directory, executable, pid);
  for (const row of inventory.rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function independent_visibility_probe(title, handle) {
  const script = [
    "import json, sys, subprocess, pyatspi",
    "title = sys.argv[1]",
    "handle = int(sys.argv[2])",
    "def run(argv):",
    "    return subprocess.run(argv, capture_output=True, text=True)",
    "def map_state(wid):",
    "    result = run(['xwininfo', '-id', str(wid)])",
    "    if result.returncode != 0:",
    "        return None",
    "    for line in result.stdout.splitlines():",
    "        if 'Map State:' in line:",
    "            return line.split(':', 1)[1].strip()",
    "    return None",
    "def wm_hidden(wid):",
    "    result = run(['xprop', '-id', str(wid), '_NET_WM_STATE'])",
    "    if result.returncode != 0:",
    "        return False",
    "    return '_NET_WM_STATE_HIDDEN' in result.stdout",
    "def atspi_frame(title):",
    "    desktop = pyatspi.Registry.getDesktop(0)",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            frame = app.getChildAtIndex(j)",
    "            if frame is not None and frame.name == title:",
    "                return frame",
    "    return None",
    "frame = atspi_frame(title)",
    "if frame is None:",
    "    raise SystemExit('cu_linux_hide_show_atspi_no_frame')",
    "states = frame.getState()",
    "print(json.dumps({",
    "    'map_state': map_state(handle),",
    "    'wm_hidden': wm_hidden(handle),",
    "    'iconified': states.contains(pyatspi.STATE_ICONIFIED),",
    "    'showing': states.contains(pyatspi.STATE_SHOWING),",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title, "" + handle], {
    timeout_ms: 30000,
  });
  ensure(
    output.success === true,
    "cu_linux_hide_show_visibility_probe:" + output.stderr + output.stdout
  );
  return JSON.parse(output.stdout.trim());
}

function ensure_hidden_probe(probe) {
  ensure(
    probe.map_state !== "IsViewable"
      && probe.wm_hidden === true
      && probe.iconified === true,
    "cu_linux_hide_show_probe_hidden:" + JSON.stringify(probe)
  );
}

function ensure_shown_probe(probe) {
  ensure(
    probe.map_state === "IsViewable"
      && probe.wm_hidden === false
      && probe.iconified === false,
    "cu_linux_hide_show_probe_shown:" + JSON.stringify(probe)
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-hide-show-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_hide_show_fixture_missing:" + fixture_source);

print("STEP app hide/show typed-fails usage when target or handle is missing or zero");
assert_hide_show_usage_limits(run_directory, executable);

print("STEP app hide/show typed-fails invalid_input when show omits --pid or hide carries quit-only flags");
assert_hide_show_invalid_input(run_directory, executable);

print("STEP app hide/show typed-fails window_not_found / a11y_app_not_found when handle or pid is absent from inventory");
assert_hide_show_missing_window(run_directory, executable);

print("STEP app hide/show without DISPLAY typed-fails unsupported host-limit");
assert_headless_host_limit(run_directory, executable, "hide", "hide");
assert_headless_host_limit(run_directory, executable, "show", "show");

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_hide_show_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_hide_show_window_missing");
  const handle_text = "" + int_at(row, "handle");
  ensure(int_at(row, "handle") > 0, "cu_linux_hide_show_handle:" + JSON.stringify(row));

  const baseline = windows_on_screen(run_directory, executable, fixture_pid);
  ensure(
    baseline.on_screen >= 1,
    "cu_linux_hide_show_baseline_on_screen:" + JSON.stringify(baseline)
  );
  const baseline_on_screen = baseline.on_screen;
  const baseline_probe = independent_visibility_probe(fixture_title, int_at(row, "handle"));
  ensure_shown_probe(baseline_probe);

  print("STEP app hide --window " + handle_text + " puts every owned window away");
  const hidden = run_cu(run_directory, executable, "observe,actuate", [
    "app", "hide", "--window", handle_text,
  ]);
  ensure(
    flag_at(hidden, "data.verified") && int_at(hidden, "data.windows_on_screen") === 0,
    "cu_linux_hide_show_hide_reply:" + JSON.stringify(hidden.data)
  );

  print("STEP independent windows inventory read-back after hide: on_screen must be 0");
  const hidden_inventory = windows_on_screen(run_directory, executable, fixture_pid);
  ensure(
    hidden_inventory.on_screen === 0,
    "cu_linux_hide_show_inventory_hidden:" + JSON.stringify(hidden_inventory)
  );
  ensure(
    harness.process_present(fixture_pid) !== 0,
    "cu_linux_hide_show_hide_killed_process"
  );

  print("STEP independent xwininfo/xprop + AT-SPI read-back after hide: unmapped and iconified");
  const hidden_probe = independent_visibility_probe(fixture_title, int_at(row, "handle"));
  ensure_hidden_probe(hidden_probe);

  print("STEP app show --pid " + fixture_pid + " restores every owned window");
  const shown = run_cu(run_directory, executable, "observe,actuate", [
    "app", "show", "--pid", "" + fixture_pid,
  ]);
  ensure(
    flag_at(shown, "data.verified")
      && int_at(shown, "data.windows_on_screen") === baseline_on_screen,
    "cu_linux_hide_show_show_reply:" + JSON.stringify(shown.data)
  );

  print("STEP independent windows inventory read-back after show: on_screen must match baseline");
  const shown_inventory = windows_on_screen(run_directory, executable, fixture_pid);
  ensure(
    shown_inventory.on_screen === baseline_on_screen,
    "cu_linux_hide_show_inventory_shown:" + JSON.stringify(shown_inventory)
  );
  ensure(
    window_row(run_directory, executable, fixture_pid, fixture_title) !== null,
    "cu_linux_hide_show_primary_window_missing_after_show"
  );

  print("STEP independent xwininfo/xprop + AT-SPI read-back after show: viewable and not iconified");
  const shown_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(shown_row !== null, "cu_linux_hide_show_shown_row_missing");
  const shown_probe = independent_visibility_probe(
    fixture_title,
    int_at(shown_row, "handle")
  );
  ensure_shown_probe(shown_probe);
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-hide-show");
harness.emit_evidence(context, declared_evidence, "cu.linux-app-hide-show-state");
harness.remove_run(context);
print("PASS: Linux app hide/show usage/miss/host-limit honesty + independent windows inventory and xprop map-state read-back (no --coords)");
return;
