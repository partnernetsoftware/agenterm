// CEO: Linux process-environment honesty with independent /proc/<pid>/environ read-back.
// Acceptance is smoke read-back only: CU process-environment must agree with key
// presence and values derived outside agenterm-cu from the NUL-delimited environ block
// for the same live PID. Typed process-environment usage must reject AT-SPI --name and
// other unexpected arguments; typed get-extents --name usage/host-limit paths must hold
// before the /proc/<pid>/environ read-back court. AT-SPI/--name only; no --coords or
// screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-environment-readback",
];

const AT_SPI_PROBE_NAME = "Process Environment Court Anchor";
const ENV_LIMIT = 5000;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_environment_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "process-environment" || text_at(reply, "command") === "usage",
    "cu_linux_process_environment_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_environment_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_process_environment_usage_limit(run_directory, executable, env, pid) {
  const flat_with_name = run_cu_reply(run_directory, executable, [
    "process-environment", "--pid", "" + pid, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_process_environment_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_process_environment_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_process_environment_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    text_at(flat_with_name, "error.message").indexOf("--name") >= 0
      || text_at(flat_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_process_environment_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = run_cu_reply(run_directory, executable, [
    "process", "env", "" + pid, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_process_environment_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_process_environment_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "error.message").indexOf("--name") >= 0
      || text_at(grouped_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_process_environment_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = run_cu_reply(run_directory, executable, [
    "process-environment", "--pid", "" + pid, "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_process_environment_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_process_environment_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_process_environment_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_process_environment_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_process_environment_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_process_environment_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_process_environment_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_process_environment_extents_unavailable_code:" + code
  );
}

function verify_readback(run_directory, executable, pid, env) {
  const script = [
    "import json, os, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "limit = int(sys.argv[3])",
    "MAX_BYTES = 4 * 1024 * 1024",
    "def read_environ():",
    "    with open(f'/proc/{pid}/environ', 'rb') as handle:",
    "        data = handle.read(MAX_BYTES + 1)",
    "    if len(data) > MAX_BYTES:",
    "        raise ValueError('process initial environment exceeds 4 MiB')",
    "    if not data:",
    "        return [], 0",
    "    fields = data.split(b'\\0')",
    "    if data.endswith(b'\\0'):",
    "        fields.pop()",
    "    entries = []",
    "    for field in fields:",
    "        equals = field.find(b'=')",
    "        if equals < 0:",
    "            entries.append((field, None))",
    "        else:",
    "            entries.append((field[:equals], field[equals + 1:]))",
    "    entries.sort(key=lambda item: (item[0], item[1] if item[1] is not None else b''))",
    "    return entries, len(data)",
    "def field_encoding(bytes_value):",
    "    try:",
    "        return 'utf8', bytes_value.decode('utf-8')",
    "    except UnicodeDecodeError:",
    "        return 'hex', bytes_value.hex()",
    "def compare_field(label, probe_bytes, row, field):",
    "    encoding, text = field_encoding(probe_bytes)",
    "    if row.get(f'{field}_encoding') != encoding:",
    "        raise SystemExit(f'{label}:{field}_encoding:probe={encoding}:cu={row.get(f\"{field}_encoding\")}')",
    "    if encoding == 'utf8':",
    "        if row.get(field) != text:",
    "            raise SystemExit(f'{label}:{field}:probe={text}:cu={row.get(field)}')",
    "    elif row.get(f'{field}_hex') != text:",
    "        raise SystemExit(f'{label}:{field}_hex:probe={text}:cu={row.get(f\"{field}_hex\")}')",
    "def invoke_environment():",
    "    out = subprocess.check_output(",
    "        [cu, '--target', 'current', '--grant', 'observe',",
    "         'process-environment', '--pid', str(pid), '--values',",
    "         '--limit', str(limit)],",
    "        text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok') or reply.get('command') != 'process-environment':",
    "        raise SystemExit('cu_linux_process_environment_reply_state')",
    "    return reply['data']",
    "probe_entries, source_bytes = read_environ()",
    "data = invoke_environment()",
    "if data.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_environment_verified')",
    "if int(data['pid']) != pid:",
    "    raise SystemExit('cu_linux_process_environment_pid')",
    "if data.get('provider') != 'linux-proc-environ':",
    "    raise SystemExit('cu_linux_process_environment_provider')",
    "if data.get('semantics') != 'exec-initial':",
    "    raise SystemExit('cu_linux_process_environment_semantics')",
    "if int(data.get('source_bytes', -1)) != source_bytes:",
    "    raise SystemExit(f'cu_linux_process_environment_source_bytes:{data.get(\"source_bytes\")}:{source_bytes}')",
    "if int(data.get('total', -1)) != len(probe_entries):",
    "    raise SystemExit(f'cu_linux_process_environment_total:{data.get(\"total\")}:{len(probe_entries)}')",
    "if int(data.get('returned', -1)) != len(probe_entries):",
    "    raise SystemExit(f'cu_linux_process_environment_returned:{data.get(\"returned\")}:{len(probe_entries)}')",
    "if data.get('values_included') is not True:",
    "    raise SystemExit('cu_linux_process_environment_values_included')",
    "rows = data.get('entries') or []",
    "if len(rows) != len(probe_entries):",
    "    raise SystemExit(f'cu_linux_process_environment_entry_count:{len(rows)}:{len(probe_entries)}')",
    "for index, (name, value) in enumerate(probe_entries):",
    "    row = rows[index]",
    "    label = f'cu_linux_process_environment_entry_{index}'",
    "    if int(row.get('index', -1)) != index:",
    "        raise SystemExit(f'{label}:index:{row.get(\"index\")}:{index}')",
    "    compare_field(label, name, row, 'name')",
    "    if value is None:",
    "        if row.get('has_value') is not False:",
    "            raise SystemExit(f'{label}:has_value:{row.get(\"has_value\")}')",
    "        continue",
    "    if row.get('has_value') is not True:",
    "        raise SystemExit(f'{label}:has_value:{row.get(\"has_value\")}')",
    "    compare_field(label, value, row, 'value')",
    "print('pid', pid)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, executable, "" + ENV_LIMIT], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_process_environment_readback:" + output.stderr + output.stdout);
}

function verify_pid(run_directory, executable, pid, env) {
  verify_readback(run_directory, executable, pid, env);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-environment");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
let succeeded = 0;
let failure = "";
try {
  print("STEP process-environment typed-fails usage when AT-SPI --name or other unexpected arguments are present");
  assert_process_environment_usage_limit(context.run_directory, executable, env, rh.pid());

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before /proc/<pid>/environ read-back");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  print("STEP process-environment observe matches independent /proc/<pid>/environ read-back for self");
  verify_pid(context.run_directory, executable, rh.pid(), env);

  print("STEP spawn disposable child with owned env vars and verify --pid read-back");
  const child = harness.start({
    program: "sh",
    args: ["-c", "exec sleep 300"],
    current_dir: context.run_directory,
    env: {
      AGENTERM_NO_ACTIVATE: "1",
      AGENTERM_CU_ENV_READBACK_ALPHA: "alpha-value",
      AGENTERM_CU_ENV_READBACK_EMPTY: "",
    },
    timeout_ms: 60000,
  });
  verify_pid(context.run_directory, executable, harness.spawned_pid(child), env);
  harness.kill(child);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-environment-readback");
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux process-environment matches independent /proc/<pid>/environ read-back with typed process-environment/get-extents usage honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux process-environment matches independent /proc/<pid>/environ read-back with typed process-environment/get-extents host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
