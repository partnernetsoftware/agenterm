// CEO: Linux process-environment honesty with independent /proc/<pid>/environ read-back.
// Acceptance is smoke read-back only: CU process-environment must agree with key
// presence and values derived outside agenterm-cu from the NUL-delimited environ block
// for the same live PID. No --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-environment-readback",
];

const ENV_LIMIT = 5000;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function verify_readback(run_directory, executable, pid) {
  const script = [
    "import json, os, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "limit = int(sys.argv[3])",
    "MAX_BYTES = 4 * 1024 * 1024",
    "def read_environ():",
    "    with open(f'/proc/{pid}/environ', 'rb') as handle:",
    "        data = handle.read(MAX_BYTES + 1)",
    "    if len(data) > MAX_BYTES:",
    "        raise ValueError('process initial environment exceeds 4 MiB')",
    "    if not data:",
    "        return [], 0",
    "    fields = data.split(b'\\0')",
    "    if data.endswith(b'\\0'):",
    "        fields.pop()",
    "    entries = []",
    "    for field in fields:",
    "        equals = field.find(b'=')",
    "        if equals < 0:",
    "            entries.append((field, None))",
    "        else:",
    "            entries.append((field[:equals], field[equals + 1:]))",
    "    entries.sort(key=lambda item: (item[0], item[1] if item[1] is not None else b''))",
    "    return entries, len(data)",
    "def field_encoding(bytes_value):",
    "    try:",
    "        return 'utf8', bytes_value.decode('utf-8')",
    "    except UnicodeDecodeError:",
    "        return 'hex', bytes_value.hex()",
    "def compare_field(label, probe_bytes, row, field):",
    "    encoding, text = field_encoding(probe_bytes)",
    "    if row.get(f'{field}_encoding') != encoding:",
    "        raise SystemExit(f'{label}:{field}_encoding:probe={encoding}:cu={row.get(f\"{field}_encoding\")}')",
    "    if encoding == 'utf8':",
    "        if row.get(field) != text:",
    "            raise SystemExit(f'{label}:{field}:probe={text}:cu={row.get(field)}')",
    "    elif row.get(f'{field}_hex') != text:",
    "        raise SystemExit(f'{label}:{field}_hex:probe={text}:cu={row.get(f\"{field}_hex\")}')",
    "def invoke_environment():",
    "    out = subprocess.check_output(",
    "        [cu, '--target', 'current', '--grant', 'observe',",
    "         'process-environment', '--pid', str(pid), '--values',",
    "         '--limit', str(limit)],",
    "        text=True)",
    "    reply = json.loads(out)",
    "    if not reply.get('ok') or reply.get('command') != 'process-environment':",
    "        raise SystemExit('cu_linux_process_environment_reply_state')",
    "    return reply['data']",
    "probe_entries, source_bytes = read_environ()",
    "data = invoke_environment()",
    "if data.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_environment_verified')",
    "if int(data['pid']) != pid:",
    "    raise SystemExit('cu_linux_process_environment_pid')",
    "if data.get('provider') != 'linux-proc-environ':",
    "    raise SystemExit('cu_linux_process_environment_provider')",
    "if data.get('semantics') != 'exec-initial':",
    "    raise SystemExit('cu_linux_process_environment_semantics')",
    "if int(data.get('source_bytes', -1)) != source_bytes:",
    "    raise SystemExit(f'cu_linux_process_environment_source_bytes:{data.get(\"source_bytes\")}:{source_bytes}')",
    "if int(data.get('total', -1)) != len(probe_entries):",
    "    raise SystemExit(f'cu_linux_process_environment_total:{data.get(\"total\")}:{len(probe_entries)}')",
    "if int(data.get('returned', -1)) != len(probe_entries):",
    "    raise SystemExit(f'cu_linux_process_environment_returned:{data.get(\"returned\")}:{len(probe_entries)}')",
    "if data.get('values_included') is not True:",
    "    raise SystemExit('cu_linux_process_environment_values_included')",
    "rows = data.get('entries') or []",
    "if len(rows) != len(probe_entries):",
    "    raise SystemExit(f'cu_linux_process_environment_entry_count:{len(rows)}:{len(probe_entries)}')",
    "for index, (name, value) in enumerate(probe_entries):",
    "    row = rows[index]",
    "    label = f'cu_linux_process_environment_entry_{index}'",
    "    if int(row.get('index', -1)) != index:",
    "        raise SystemExit(f'{label}:index:{row.get(\"index\")}:{index}')",
    "    compare_field(label, name, row, 'name')",
    "    if value is None:",
    "        if row.get('has_value') is not False:",
    "            raise SystemExit(f'{label}:has_value:{row.get(\"has_value\")}')",
    "        continue",
    "    if row.get('has_value') is not True:",
    "        raise SystemExit(f'{label}:has_value:{row.get(\"has_value\")}')",
    "    compare_field(label, value, row, 'value')",
    "print('pid', pid)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, executable, "" + ENV_LIMIT], {
    cwd: run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_process_environment_readback:" + output.stderr + output.stdout);
}

function verify_pid(run_directory, executable, pid) {
  verify_readback(run_directory, executable, pid);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-environment");
let succeeded = 0;
let failure = "";
try {
  print("STEP process-environment observe matches independent /proc/<pid>/environ read-back for self");
  verify_pid(context.run_directory, executable, rh.pid());

  print("STEP spawn disposable child with owned env vars and verify --pid read-back");
  const child = harness.start({
    program: "sh",
    args: ["-c", "exec sleep 300"],
    current_dir: context.run_directory,
    env: {
      AGENTERM_NO_ACTIVATE: "1",
      AGENTERM_CU_ENV_READBACK_ALPHA: "alpha-value",
      AGENTERM_CU_ENV_READBACK_EMPTY: "",
    },
    timeout_ms: 60000,
  });
  verify_pid(context.run_directory, executable, harness.spawned_pid(child));
  harness.kill(child);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-environment-readback");
  harness.remove_run(context);
  print("PASS: Linux process-environment matches independent /proc/<pid>/environ read-back");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
