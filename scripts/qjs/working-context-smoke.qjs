// Prove that launch proxy facts stay redacted, non-actionable, and ephemeral.
//
// Args:
//   --list-evidence
// or:
//   REPO GUI_EXE CLI_EXE
//
// Ported from scripts/rh/working-context-smoke.rh; runs under `--profile
// tool`. Both GUI launches are door handles: started with the proxy
// variables set (first) or removed (second, `env_remove`), polled for
// readiness, told to shut down, drained for their stderr, and covered by
// `complete_unwaited`. Needs a GUI, exactly as the original did.
//
// Changed on purpose: the original's `wait_for_exit` discarded the child's
// output and the caller re-waited for stderr; the door drains a handle once,
// so `wait_for_exit` here answers the output and the caller reads its
// stderr from that.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

function require_no_secret(text, secret, location) {
  harness.require(!("" + text).includes(secret), "working_context_secret_leak:" + location);
}

function active_tab_from_snapshot(snapshot) {
  const tabs = snapshot.tabs;
  for (const tab of tabs) {
    if (tab.active) { return tab; }
  }
  throw "working_context_active_tab_missing";
}

function wait_for_server(context, cli, gui_child, redactions, waited) {
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    const probe = harness.run_cli_bounded(context, cli, ["ui-snapshot"], 0, redactions);
    if (probe.success) { return 0; }
    if (harness.state(gui_child) === "exited") {
      const output = harness.drain(gui_child, 2000, waited);
      throw "working_context_gui_early_exit:" + harness.redact_text("" + output.stderr, redactions);
    }
    harness.sleep_ms(50);
  }
  throw "working_context_server_timeout";
}

function wait_for_exit(child, code, waited) {
  const code_text = "" + code;
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    if (harness.state(child) === "exited") {
      return harness.drain(child, 2000, waited);
    }
    harness.sleep_ms(50);
  }
  if (harness.state(child) === "running") {
    process_kill(child);
  }
  try {
    return harness.drain(child, 3000, waited);
  } catch (error) {
    throw code_text + ":" + ("" + error);
  }
}

function start_gui(context, gui, proxy) {
  let spec = null;
  if (proxy === "") {
    spec = harness.configured_spec_with_env(
      context, gui, [], {},
      ["HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy"]
    );
  } else {
    spec = harness.configured_spec_with_env(
      context, gui, [],
      { HTTP_PROXY: proxy, HTTPS_PROXY: proxy, http_proxy: proxy, https_proxy: proxy },
      []
    );
  }
  return harness.start(spec);
}

function invoke(context, cli, arguments, expected_failure, redactions) {
  return harness.invoke_cli_bounded(context, cli, arguments, expected_failure, redactions);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  print("ux.working-context-proxy");
  print("ux.persistent-workspace");
  return 0;
}

harness.require(args.length === 3, "expected: REPO GUI_EXE CLI_EXE");
const repo = rh.absolute(args[0]);
const gui = rh.absolute(args[1]);
const cli = rh.absolute(args[2]);
harness.require(rh.exists(gui), "working_context_gui_missing");
harness.require(rh.exists(cli), "working_context_cli_missing");

const context = harness.new_context(repo, "working-context");
const secret = "credential-" + rh.pid() + "-" + rh.now_ms() + "-sentinel";
const proxy = "https://alice:" + secret + "@proxy.example:8443/private?token=" + secret + "#fragment";
const redactions = [proxy, secret];
const waited = [];
const first_gui = start_gui(context, gui, proxy);
let second_gui = first_gui;
let second_started = false;
let succeeded = false;
let failure = "";

try {
  wait_for_server(context, cli, first_gui, redactions, waited);
  invoke(context, cli, ["wait-ui", "--window-state", "restored", "--timeout-ms", "30000"], 0, redactions);
  invoke(context, cli, ["wait-ui", "-t", "0", "--tab-state", "running", "--timeout-ms", "30000"], 0, redactions);

  const snapshot_result = invoke(context, cli, ["ui-snapshot"], 0, redactions);
  const snapshot_text = "" + snapshot_result.stdout;
  require_no_secret(snapshot_text, secret, "launch_ui_snapshot");
  const snapshot = JSON.parse(snapshot_text);
  const tab = active_tab_from_snapshot(snapshot);
  const working_context = tab.working_context;
  const tab_proxy = working_context.proxy;
  const proxy_source = "" + tab_proxy.source;
  harness.require(
    tab_proxy.configured
      && proxy_source === "launch"
      && !tab_proxy.endpoint_visible
      && !tab_proxy.credential_revealed,
    "working_context_launch_proxy_facts"
  );
  const tab_id = "" + tab.id;
  const epoch = "" + snapshot.event_position.epoch;
  const launch_pane_result = invoke(context, cli, ["pane-snapshot", "-t", tab_id], 0, redactions);
  const launch_pane = JSON.parse("" + launch_pane_result.stdout);
  const launch_window = launch_pane.windows[0];
  const input_writes = launch_window.input_writes;
  const proxy_status = snapshot.layout.status_bar.proxy;
  const proxy_bounds = proxy_status.bounds;
  harness.require(
    proxy_status.archived
      && !proxy_status.available
      && proxy_bounds.width === 0
      && (proxy_status.action === undefined || proxy_status.action === null)
      && (proxy_status.eye_action === undefined || proxy_status.eye_action === null),
    "working_context_archived_surface_visible"
  );

  const archived = invoke(context, cli, ["ui-action", "open-proxy-editor", "-t", tab_id], 1, redactions);
  const archived_text = ("" + archived.stdout) + ("" + archived.stderr);
  require_no_secret(archived_text, secret, "archived_proxy_action");
  harness.require(
    archived_text.includes("proxy workbench controls are archived"),
    "working_context_archived_status_missing"
  );
  const pane_result = invoke(context, cli, ["pane-snapshot", "-t", tab_id], 0, redactions);
  const pane_text = "" + pane_result.stdout;
  require_no_secret(pane_text, secret, "archived_pane_snapshot");
  const pane = JSON.parse(pane_text);
  const pane_window = pane.windows[0];
  const composer = "" + pane_window.composer;
  harness.require(
    pane_window.input_writes === input_writes
      && !pane_window.composer_sensitive
      && composer === "",
    "working_context_archived_surface_mutated_terminal"
  );

  print("STEP persist tab metadata while discarding unconfirmed CWD state");
  const persistent_name = "persistent-" + context.run_id;
  const persistent_note = "restored note";
  const persistent_draft = "restored draft";
  const persistent_result = invoke(
    context, cli,
    ["new-window", "-d", "-n", persistent_name, "-F", "#{window_id}"],
    0, redactions
  );
  const persistent_id = ("" + persistent_result.stdout).trim();
  invoke(
    context, cli,
    ["wait-ui", "-t", persistent_id, "--tab-state", "running", "--timeout-ms", "30000"],
    0, redactions
  );
  invoke(context, cli, ["set-tab-note", "-t", persistent_id, persistent_note], 0, redactions);
  invoke(context, cli, ["set-composer", "-t", persistent_id, persistent_draft], 0, redactions);
  invoke(
    context, cli,
    ["ui-action", "cwd-prepare-append", "-t", persistent_id, "--path", "C:\\restart-request-must-not-persist"],
    0, redactions
  );
  invoke(context, cli, ["ui-action", "tabs-set-width", "--width", "250"], 0, redactions);
  invoke(context, cli, ["ui-action", "tabs-show"], 0, redactions);
  invoke(context, cli, ["select-window", "-t", persistent_id], 0, redactions);

  invoke(context, cli, ["save-workspace"], 0, redactions);
  const workspace_text = rh.read_text(context.workspace_path);
  require_no_secret(workspace_text, secret, "workspace");
  const events_result = invoke(
    context, cli,
    ["read-events", "--epoch", epoch, "--after", "0", "--limit", "1024"],
    0, redactions
  );
  require_no_secret("" + events_result.stdout, secret, "event_journal");

  invoke(context, cli, ["shutdown"], 0, redactions);
  const first_output = wait_for_exit(first_gui, "working_context_first_gui_shutdown_timeout", waited);
  require_no_secret("" + first_output.stderr, secret, "first_gui_stderr");

  second_gui = start_gui(context, gui, "");
  second_started = true;
  wait_for_server(context, cli, second_gui, redactions, waited);
  invoke(context, cli, ["wait-ui", "--window-state", "restored", "--timeout-ms", "30000"], 0, redactions);
  invoke(
    context, cli,
    ["wait-ui", "-t", persistent_name, "--tab-state", "running", "--timeout-ms", "30000"],
    0, redactions
  );
  const restored_result = invoke(context, cli, ["ui-snapshot"], 0, redactions);
  const restored_text = "" + restored_result.stdout;
  require_no_secret(restored_text, secret, "restart_ui_snapshot");
  const restored_snapshot = JSON.parse(restored_text);
  const restored_tab = active_tab_from_snapshot(restored_snapshot);
  const restored_working_context = restored_tab.working_context;
  const restored_tab_proxy = restored_working_context.proxy;
  const restored_cwd = restored_working_context.cwd;
  const restored_proxy_source = "" + restored_tab_proxy.source;
  const restored_id = "" + restored_tab.id;
  const restored_name = "" + restored_tab.name;
  const restored_note = "" + restored_tab.note;
  const restored_cwd_source = "" + restored_cwd.source;
  const restored_cwd_path = "" + restored_cwd.path;
  const restored_cwd_confirmed = "" + restored_cwd.confirmed_path;
  harness.require(
    !restored_tab_proxy.configured && restored_proxy_source === "off",
    "working_context_proxy_persisted"
  );
  const restored_sidebar = restored_snapshot.layout.sidebar;
  harness.require(
    restored_id === persistent_id
      && restored_name === persistent_name
      && restored_note === persistent_note
      && restored_tab.draft
      && restored_tab.active
      && restored_cwd_source === "launch"
      && !restored_cwd.pending
      && restored_cwd_path === restored_cwd_confirmed
      && restored_cwd_path !== "C:\\restart-request-must-not-persist"
      && restored_sidebar.configured_width === 250
      && restored_sidebar.visible,
    "working_context_workspace_metadata_not_restored"
  );
  invoke(context, cli, ["shutdown"], 0, redactions);
  const second_output = wait_for_exit(second_gui, "working_context_second_gui_shutdown_timeout", waited);
  require_no_secret("" + second_output.stderr, secret, "second_gui_stderr");

  harness.emit_evidence(
    context,
    ["ux.working-context-proxy", "ux.persistent-workspace"],
    "ux.working-context-proxy"
  );
  harness.emit_evidence(
    context,
    ["ux.working-context-proxy", "ux.persistent-workspace"],
    "ux.persistent-workspace"
  );
  print("PASS: archived Proxy facts remain private while workspace metadata survives restart");
  succeeded = true;
} catch (error) {
  failure = harness.redact_text("" + error, redactions);
}

harness.scrub_retained_text(context, redactions);
let completion_failure = "";
try {
  if (second_started) {
    harness.complete_unwaited(context, [first_gui, second_gui], waited, succeeded, failure);
  } else {
    harness.complete_unwaited(context, [first_gui], waited, succeeded, failure);
  }
} catch (error) {
  completion_failure = harness.redact_text("" + error, redactions);
}
if (succeeded && completion_failure === "") {
  harness.remove_run(context);
}
if (failure !== "") {
  throw failure;
}
if (completion_failure !== "") {
  throw completion_failure;
}
return;
