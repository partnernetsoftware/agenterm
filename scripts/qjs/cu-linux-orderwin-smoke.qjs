// CEO: Linux orderwin above/below with independent xprop _NET_CLIENT_LIST_STACKING
// and windows inventory z_index read-back. Two disposable GTK fixture windows; every
// actuation verified from stacking sources outside the verb reply. Typed orderwin
// usage must reject AT-SPI --name, --coords, --bogus, and other unexpected arguments;
// typed get-extents --name usage AND host-limit paths must both hold before the
// actuate/read-back court. Missing-window and headless host-limit paths must hold
// before any owned fixture window exists. Prefer host-limit clarity over fake
// success. AT-SPI inventory handles only; no --coords or screenshot.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-orderwin",
];

const AT_SPI_PROBE_NAME = "Orderwin Court Anchor";
const MISSING_HANDLE = "99999999";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function last_json_line(text) {
  const lines = text.trim().split("\n");
  for (let index = lines.length - 1; index >= 0; index = index - 1) {
    const line = lines[index].trim();
    if (line !== "") { return JSON.parse(line); }
  }
  throw "cu_linux_orderwin_missing_json";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  ensure(output.stdout.trim() !== "", "cu_linux_orderwin_empty_reply:" + output.stderr);
  return last_json_line(output.stdout);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_orderwin_reply:" + JSON.stringify(document));
  return document;
}

function invoke_orderwin_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "actuate",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_orderwin_actuate_cli:" + output.stderr);
  const reply = last_json_line(output.stdout);
  const command = text_at(reply, "command");
  ensure(
    command === "orderwin" || command === "usage",
    "cu_linux_orderwin_actuate_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_orderwin_extents_cli:" + output.stderr);
  return last_json_line(output.stdout);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_orderwin_usage_limit(run_directory, executable) {
  const missing_window = run_cu_reply(run_directory, executable, "actuate", [
    "orderwin", "--relation", "above", "--relative", "1",
  ]);
  ensure(!output_success(missing_window), "cu_linux_orderwin_usage_window_ok:" + JSON.stringify(missing_window));
  ensure(
    text_at(missing_window, "error.code") === "usage",
    "cu_linux_orderwin_usage_window_code:" + JSON.stringify(missing_window.error)
  );
  ensure(
    text_at(missing_window, "error.message").indexOf("--window") >= 0,
    "cu_linux_orderwin_usage_window_message:" + JSON.stringify(missing_window.error)
  );

  const missing_relative = run_cu_reply(run_directory, executable, "actuate", [
    "orderwin", "--window", "1", "--relation", "above",
  ]);
  ensure(!output_success(missing_relative), "cu_linux_orderwin_usage_relative_ok:" + JSON.stringify(missing_relative));
  ensure(
    text_at(missing_relative, "error.code") === "usage",
    "cu_linux_orderwin_usage_relative_code:" + JSON.stringify(missing_relative.error)
  );
  ensure(
    text_at(missing_relative, "error.message").indexOf("--relative") >= 0,
    "cu_linux_orderwin_usage_relative_message:" + JSON.stringify(missing_relative.error)
  );

  const missing_relation = run_cu_reply(run_directory, executable, "actuate", [
    "orderwin", "--window", "1", "--relative", "2",
  ]);
  ensure(!output_success(missing_relation), "cu_linux_orderwin_usage_relation_ok:" + JSON.stringify(missing_relation));
  ensure(
    text_at(missing_relation, "error.code") === "usage",
    "cu_linux_orderwin_usage_relation_code:" + JSON.stringify(missing_relation.error)
  );
  ensure(
    text_at(missing_relation, "error.message").indexOf("--relation") >= 0,
    "cu_linux_orderwin_usage_relation_message:" + JSON.stringify(missing_relation.error)
  );

  const bad_relation = run_cu_reply(run_directory, executable, "actuate", [
    "orderwin", "--window", "1", "--relation", "sideways", "--relative", "2",
  ]);
  ensure(!output_success(bad_relation), "cu_linux_orderwin_usage_bad_relation_ok:" + JSON.stringify(bad_relation));
  ensure(
    text_at(bad_relation, "error.code") === "usage",
    "cu_linux_orderwin_usage_bad_relation_code:" + JSON.stringify(bad_relation.error)
  );
  ensure(
    text_at(bad_relation, "error.message").indexOf("above or below") >= 0,
    "cu_linux_orderwin_usage_bad_relation_message:" + JSON.stringify(bad_relation.error)
  );

  const zero_window = run_cu_reply(run_directory, executable, "actuate", [
    "orderwin", "--window", "0", "--relation", "above", "--relative", "1",
  ]);
  ensure(!output_success(zero_window), "cu_linux_orderwin_zero_window_ok:" + JSON.stringify(zero_window));
  ensure(
    text_at(zero_window, "error.code") === "usage",
    "cu_linux_orderwin_zero_window_code:" + JSON.stringify(zero_window.error)
  );
  ensure(
    text_at(zero_window, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_orderwin_zero_window_message:" + JSON.stringify(zero_window.error)
  );

  const zero_relative = run_cu_reply(run_directory, executable, "actuate", [
    "orderwin", "--window", "1", "--relation", "above", "--relative", "0",
  ]);
  ensure(!output_success(zero_relative), "cu_linux_orderwin_zero_relative_ok:" + JSON.stringify(zero_relative));
  ensure(
    text_at(zero_relative, "error.code") === "usage",
    "cu_linux_orderwin_zero_relative_code:" + JSON.stringify(zero_relative.error)
  );
  ensure(
    text_at(zero_relative, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_orderwin_zero_relative_message:" + JSON.stringify(zero_relative.error)
  );
}

function assert_orderwin_atspi_name_usage_limit(run_directory, executable, env) {
  const with_name = invoke_orderwin_reply(run_directory, executable, [
    "orderwin",
    "--window", "1",
    "--name", AT_SPI_PROBE_NAME,
    "--relation", "above",
    "--relative", "2",
  ], env);
  ensure(!output_success(with_name), "cu_linux_orderwin_usage_name_ok:" + JSON.stringify(with_name));
  ensure(
    text_at(with_name, "error.code") === "usage",
    "cu_linux_orderwin_usage_name_code:" + JSON.stringify(with_name.error)
  );
  ensure(
    text_at(with_name, "command") === "usage",
    "cu_linux_orderwin_usage_name_command:" + JSON.stringify(with_name)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_name, "error.message"), "--name"),
    "cu_linux_orderwin_usage_name_message:" + JSON.stringify(with_name.error)
  );

  const with_bogus = invoke_orderwin_reply(run_directory, executable, [
    "orderwin",
    "--window", "1",
    "--relation", "above",
    "--relative", "2",
    "--bogus",
  ], env);
  ensure(!output_success(with_bogus), "cu_linux_orderwin_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_orderwin_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_orderwin_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_orderwin_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const with_coords = invoke_orderwin_reply(run_directory, executable, [
    "orderwin",
    "--window", "1",
    "--relation", "above",
    "--relative", "2",
    "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords), "cu_linux_orderwin_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_orderwin_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_orderwin_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_orderwin_usage_coords_message:" + JSON.stringify(with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_orderwin_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_orderwin_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_orderwin_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_orderwin_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_orderwin_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_orderwin_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_orderwin_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_orderwin_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_orderwin_extents_unavailable_code:" + code
  );
}

function assert_orderwin_missing_window(run_directory, executable) {
  const missing_window = run_cu_reply(run_directory, executable, "actuate", [
    "orderwin", "--window", MISSING_HANDLE, "--relation", "above", "--relative", "1",
  ]);
  ensure(!output_success(missing_window), "cu_linux_orderwin_missing_window_ok:" + JSON.stringify(missing_window));
  ensure(
    text_at(missing_window, "error.code") === "a11y_window_gone",
    "cu_linux_orderwin_missing_window_code:" + JSON.stringify(missing_window.error)
  );
  ensure(
    text_at(missing_window, "error.message").indexOf("--window") >= 0,
    "cu_linux_orderwin_missing_window_message:" + JSON.stringify(missing_window.error)
  );
}

function assert_headless_host_limit(run_directory, executable) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    ["orderwin", "--window", "1", "--relation", "above", "--relative", "2"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_orderwin_headless_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_orderwin_headless_code:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("window enumeration") >= 0
      || message.indexOf("mechanism unavailable") >= 0
      || message.indexOf("agt_native_window_show") >= 0,
    "cu_linux_orderwin_headless_message:" + JSON.stringify(reply.error)
  );
}

function window_rows(run_directory, executable, pid) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  const by_title = {};
  for (const row of rows) { by_title[text_at(row, "title")] = row; }
  return by_title;
}

function parse_x11_id(token) {
  let start = 0;
  if (token.length >= 2 && token.charAt(0) === "0"
      && (token.charAt(1) === "x" || token.charAt(1) === "X")) {
    start = 2;
  }
  let result = 0;
  for (let index = start; index < token.length; index = index + 1) {
    const code = token.charCodeAt(index);
    let digit = -1;
    if (code >= 48 && code <= 57) { digit = code - 48; }
    else if (code >= 97 && code <= 102) { digit = code - 87; }
    else if (code >= 65 && code <= 70) { digit = code - 55; }
    else { throw "cu_linux_orderwin_xprop_id:" + token; }
    result = result * 16 + digit;
  }
  return result;
}

function parse_stacking_list(stdout) {
  const marker = "_NET_CLIENT_LIST_STACKING(WINDOW): window id # ";
  const start = stdout.indexOf(marker);
  if (start < 0) { return null; }
  const rest = stdout.substring(start + marker.length).trim();
  if (rest === "") { return []; }
  const ids = [];
  for (const token of rest.split(",")) {
    const trimmed = token.trim();
    if (trimmed !== "") { ids.push(parse_x11_id(trimmed)); }
  }
  return ids;
}

function stacking_indices(run_directory, executable, handles) {
  const xprop = rh.command("xprop", ["-root", "_NET_CLIENT_LIST_STACKING"], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  ensure(xprop.success === true, "cu_linux_orderwin_xprop_stacking_failed:" + xprop.stderr);
  const ids = parse_stacking_list(xprop.stdout);
  ensure(ids !== null, "cu_linux_orderwin_xprop_stacking_parse:" + xprop.stdout);
  const out = {};
  for (const handle of handles) {
    let index = -1;
    for (let i = 0; i < ids.length; i++) {
      if (ids[i] === handle) { index = i; break; }
    }
    out["" + handle] = index;
  }
  return out;
}

function ensure_stacking_above(run_directory, executable, above_handle, below_handle) {
  const indices = stacking_indices(run_directory, executable, [above_handle, below_handle]);
  const above_index = indices["" + above_handle];
  const below_index = indices["" + below_handle];
  ensure(
    above_index >= 0 && below_index >= 0 && above_index > below_index,
    "cu_linux_orderwin_xprop_stacking:above=" + above_index + ":below=" + below_index
      + ":handles=" + above_handle + "," + below_handle
  );
}

function ensure_inventory_z_above(second_row, main_row) {
  ensure(
    int_at(second_row, "z_index") < int_at(main_row, "z_index"),
    "cu_linux_orderwin_inventory_z:second=" + int_at(second_row, "z_index")
      + ":main=" + int_at(main_row, "z_index")
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-orderwin-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_orderwin_fixture_missing:" + fixture_source);

print("STEP orderwin typed-fails usage when --window, --relative, or --relation is missing or invalid");
assert_orderwin_usage_limit(run_directory, executable);

print("STEP orderwin typed-fails usage when AT-SPI --name/--coords/--bogus is present");
assert_orderwin_atspi_name_usage_limit(run_directory, executable, env);

print("STEP get-extents typed-fail usage when --window is zero or --name is missing before orderwin actuate/read-back court");
assert_get_extents_usage_limit(run_directory, executable, env);

print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before orderwin actuate/read-back court");
assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

print("STEP orderwin typed-fails a11y_window_gone when handle is absent from inventory");
assert_orderwin_missing_window(run_directory, executable);

print("STEP orderwin without DISPLAY typed-fails unsupported host-limit");
assert_headless_host_limit(run_directory, executable);

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
  const second_title = "agenterm-linux-second-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_orderwin_fixture_wait");

  const inventory = window_rows(run_directory, executable, fixture_pid);
  const main_row = inventory[fixture_title];
  const second_row = inventory[second_title];
  ensure(main_row !== undefined && second_row !== undefined,
    "cu_linux_orderwin_window_inventory:" + JSON.stringify(inventory));
  const main_handle = int_at(main_row, "handle");
  const second_handle = int_at(second_row, "handle");
  const main_handle_text = "" + main_handle;
  const second_handle_text = "" + second_handle;
  ensure(main_handle > 0 && second_handle > 0,
    "cu_linux_orderwin_handles:" + main_handle_text + "," + second_handle_text);
  const main_z = int_at(main_row, "z_index");
  const second_z = int_at(second_row, "z_index");
  ensure(main_z > 0 && second_z > 0, "cu_linux_orderwin_baseline_z:" + main_z + "," + second_z);
  print("STEP baseline windows inventory z_index: main z=" + main_z + " second z=" + second_z);
  const baseline_indices = stacking_indices(run_directory, executable, [main_handle, second_handle]);
  ensure(
    baseline_indices["" + main_handle] >= 0 && baseline_indices["" + second_handle] >= 0,
    "cu_linux_orderwin_baseline_xprop_stacking:" + JSON.stringify(baseline_indices)
  );
  print("STEP baseline independent xprop _NET_CLIENT_LIST_STACKING indices: main="
    + baseline_indices["" + main_handle] + " second=" + baseline_indices["" + second_handle]);

  print("STEP orderwin typed-fails a11y_window_gone when --relative handle is absent from inventory");
  const missing_relative = run_cu_reply(run_directory, executable, "actuate", [
    "orderwin", "--window", main_handle_text, "--relation", "above", "--relative", MISSING_HANDLE,
  ]);
  ensure(!output_success(missing_relative), "cu_linux_orderwin_missing_relative_ok:" + JSON.stringify(missing_relative));
  ensure(
    text_at(missing_relative, "error.code") === "a11y_window_gone",
    "cu_linux_orderwin_missing_relative_code:" + JSON.stringify(missing_relative.error)
  );
  ensure(
    text_at(missing_relative, "error.message").indexOf("--relative") >= 0,
    "cu_linux_orderwin_missing_relative_message:" + JSON.stringify(missing_relative.error)
  );

  print("STEP orderwin above: second above main");
  const raised = run_cu(run_directory, executable, "observe,actuate", [
    "orderwin", "--window", second_handle_text, "--relation", "above", "--relative", main_handle_text,
  ]);
  ensure(
    flag_at(raised, "data.verified")
      && int_at(raised, "data.after.window_z") < int_at(raised, "data.after.relative_z"),
    "cu_linux_orderwin_above_reply:" + JSON.stringify(raised.data)
  );
  const after_above = window_rows(run_directory, executable, fixture_pid);
  ensure_inventory_z_above(after_above[second_title], after_above[fixture_title]);
  print("STEP orderwin above inventory z_index read-back: second z="
    + int_at(after_above[second_title], "z_index")
    + " main z=" + int_at(after_above[fixture_title], "z_index"));
  print("STEP independent xprop _NET_CLIENT_LIST_STACKING read-back: second above main");
  ensure_stacking_above(
    run_directory,
    executable,
    int_at(after_above[second_title], "handle"),
    int_at(after_above[fixture_title], "handle")
  );

  print("STEP orderwin below: main below second");
  const lowered = run_cu(run_directory, executable, "observe,actuate", [
    "orderwin", "--window", main_handle_text, "--relation", "below", "--relative", second_handle_text,
  ]);
  ensure(
    flag_at(lowered, "data.verified")
      && int_at(lowered, "data.after.window_z") > int_at(lowered, "data.after.relative_z"),
    "cu_linux_orderwin_below_reply:" + JSON.stringify(lowered.data)
  );
  const after_below = window_rows(run_directory, executable, fixture_pid);
  ensure_inventory_z_above(after_below[second_title], after_below[fixture_title]);
  print("STEP orderwin below inventory z_index read-back: main z="
    + int_at(after_below[fixture_title], "z_index")
    + " second z=" + int_at(after_below[second_title], "z_index"));
  print("STEP independent xprop _NET_CLIENT_LIST_STACKING read-back: second above main");
  ensure_stacking_above(
    run_directory,
    executable,
    int_at(after_below[second_title], "handle"),
    int_at(after_below[fixture_title], "handle")
  );

  print("STEP orderwin same handle must refuse invalid_input without changing stacking read-back");
  const before_refusal = window_rows(run_directory, executable, fixture_pid);
  const before_indices = stacking_indices(run_directory, executable, [main_handle, second_handle]);
  const same_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "orderwin", "--window", main_handle_text, "--relation", "above", "--relative", main_handle_text,
  ]);
  ensure(
    !output_success(same_handle) && text_at(same_handle, "error.code") === "invalid_input",
    "cu_linux_orderwin_same:" + JSON.stringify(same_handle)
  );
  const after_refusal = window_rows(run_directory, executable, fixture_pid);
  ensure(
    int_at(after_refusal[second_title], "z_index") === int_at(before_refusal[second_title], "z_index")
      && int_at(after_refusal[fixture_title], "z_index") === int_at(before_refusal[fixture_title], "z_index"),
    "cu_linux_orderwin_same_inventory_changed:" + JSON.stringify({ before: before_refusal, after: after_refusal })
  );
  const after_indices = stacking_indices(run_directory, executable, [main_handle, second_handle]);
  ensure(
    after_indices["" + main_handle] === before_indices["" + main_handle]
      && after_indices["" + second_handle] === before_indices["" + second_handle],
    "cu_linux_orderwin_same_xprop_changed:" + JSON.stringify({ before: before_indices, after: after_indices })
  );
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-orderwin");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-orderwin");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux orderwin above/below usage/miss/host-limit honesty + independent xprop stacking and windows inventory z_index read-back with typed orderwin --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux orderwin above/below usage/miss/host-limit honesty + independent xprop stacking and windows inventory z_index read-back with typed orderwin --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
}
return;
