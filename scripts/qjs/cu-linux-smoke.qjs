// Prove the agenterm-cu default loop through libagenterm's AT-SPI2 backend
// on a real X11 desktop: capabilities -> windows -> bounded tree / query ->
// invoke -> the background menu verbs -> the node text and geometry verbs ->
// window-place and orderwin, both answering from a read-back -> the
// minimized reading -> the installed-application inventory -> the
// destructive close gate.
//
// Every step here exists because the Linux path was written against the
// specifications and shipped without ever executing, and executing it found
// sixteen defects. So this journey deliberately asserts the *readings*, not
// just that a call returned ok: per-node bounds that are real rectangles
// rather than the empty-rect sentinel, menu paths that `menu invoke` will
// actually accept, a placement whose read-back equals the request exactly,
// a raise that changed the order, and a minimized window that is still
// listed. A verb that reports success without having done anything passes a
// weaker journey and fails this one.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
//
// Runs under --profile tool on a Linux host with DISPLAY, a session D-Bus
// and the AT-SPI2 bus reachable, and PyGObject for the fixture. Nothing here
// screenshots, uses coordinates, or injects a keystroke; every write is read
// back. The owned fixture is examples/python/agenterm_atspi_fixture.py,
// spawned as a door handle -- its pid is `harness.spawned_pid(handle)`, and
// only that pid is ever signalled. Every agenterm-cu call runs with
// AGENTERM_CU_AUDIT_PATH inside the run directory, so the audit log and the
// receipt file are this run's own.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-capabilities",
  "cu.linux-atspi-window-identity",
  "cu.linux-process-state",
  "cu.linux-process-argv",
  "cu.linux-process-usage",
  "cu.linux-process-usage-watch",
  "cu.linux-process-wait",
  "cu.linux-process-kill",
  "cu.linux-process-lifecycle-watch",
  "cu.linux-network-probe",
  "cu.linux-file-inspect",
  "cu.linux-terminal-control",
  "cu.linux-atspi-tree-geometry",
  "cu.linux-atspi-query",
  "cu.linux-atspi-invoke",
  "cu.linux-atspi-menu-inspect",
  "cu.linux-atspi-menu-invoke",
  "cu.linux-atspi-node-text",
  "cu.linux-atspi-focus",
  "cu.linux-atspi-observe",
  "cu.linux-atspi-screenshot",
  "cu.linux-atspi-window-place",
  "cu.linux-atspi-orderwin",
  "cu.linux-atspi-minimized",
  "cu.linux-atspi-send-keys",
  "cu.linux-atspi-app-lifecycle",
  "cu.linux-atspi-app-inventory",
  "cu.linux-atspi-destructive-close",
  "cu.linux-atspi-refusal-reasons",
  "cu.linux-atspi-fixture-cleanup"
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function text_of(value) {
  if (value === undefined || value === null) { return ""; }
  return "" + value;
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) { return text_of(at(value, dotted)); }
function int_at(value, dotted) { return rh.int_of(at(value, dotted)); }
function flag_at(value, dotted) { return at(value, dotted) === true; }

function ensure_wide_counter(value, dotted) {
  const counter = at(value, dotted);
  ensure(
    typeof counter === "string" && counter !== "" && rh.parse_int(counter) >= 0,
    "cu_linux_smoke_process_counter:" + dotted + ":" + text_of(counter)
  );
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function remove_directory_bounded(path) {
  if (!rh.exists(path)) { return true; }
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    rh.try_remove_dir_all(path);
    if (!rh.exists(path)) { return true; }
    harness.sleep_ms(50);
  }
  return false;
}

let terminal_instance = "";
let terminal_address = "";
let terminal_instance_directory = "";
let terminal_workspace_path = "";
let terminal_settings_path = "";

function terminal_env(run_directory) {
  return {
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
    AGENTERM_INSTANCE: terminal_instance,
    AGENTERM_IPC_ADDRESS: terminal_address,
    AGENTERM_INSTANCE_DIR: terminal_instance_directory,
    AGENTERM_WORKSPACE_PATH: terminal_workspace_path,
    AGENTERM_SETTINGS_PATH: terminal_settings_path,
    AGENTERM_NO_ACTIVATE: "1"
  };
}

function cu_env(run_directory) {
  return terminal_env(run_directory);
}

// One agenterm-cu call whose reply must be `ok: true`.
function run_cu_json(run_directory, executable, arguments) {
  const output = rh.command(
    executable, arguments,
    { cwd: run_directory, env: cu_env(run_directory), timeout_ms: 30000 }
  );
  ensure(output.success === true, "cu_linux_smoke_cli_process:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_smoke_cli_empty:" + output.stderr);
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_linux_smoke_cli_reply:" + JSON.stringify(document));
  return document;
}

// One agenterm-cu call whose reply is returned as parsed, ok or not.
function run_cu_reply(run_directory, executable, arguments) {
  const output = rh.command(
    executable, arguments,
    { cwd: run_directory, env: cu_env(run_directory), timeout_ms: 30000 }
  );
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_smoke_cli_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_agenterm(run_directory, executable, arguments) {
  const all = ["cli", "--address", terminal_address];
  for (const argument of arguments) { all.push(argument); }
  const output = rh.command(
    executable, all,
    { cwd: run_directory, env: terminal_env(run_directory), timeout_ms: 30000 }
  );
  ensure(output.success === true, "cu_linux_smoke_agenterm_cli:" + output.stdout + output.stderr);
  return output.stdout.trim();
}

function terminal_tab(rows, tab_id) {
  for (const row of rows) {
    if (text_of(row.id) === tab_id) { return row; }
  }
  return null;
}

// Spawn an `observe` worker through the door. The readiness marker is
// published only after the complete poll-diff baseline, so a slow AT-SPI
// walk cannot straddle the caller's writes and turn them into the baseline.
function start_observer(run_directory, executable, handle_text, duration) {
  const ready_path = rh.join(run_directory, "observe-ready.json");
  rh.try_remove_file(ready_path);
  const handle = harness.start({
    program: executable,
    args: [
      "--target", "current", "--grant", "observe", "observe",
      "--window", handle_text, "--duration", duration,
      "--ready-path", ready_path
    ],
    current_dir: run_directory,
    env: cu_env(run_directory),
    timeout_ms: 30000
  });
  let ready = false;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    if (direct_file(ready_path)) {
      const marker = rh.parse_file(ready_path);
      ready = text_at(marker, "state") === "ready"
        && text_at(marker, "mode") === "poll-diff"
        && text_at(marker, "window") === handle_text;
      if (ready) { break; }
    }
    harness.sleep_ms(50);
  }
  ensure(ready, "cu_linux_smoke_observer_not_ready");
  return { handle: handle, ready_path: ready_path };
}

function observer_result(observer) {
  const output = harness.wait(observer.handle, 20000);
  rh.try_remove_file(observer.ready_path);
  ensure(output.success === true, "cu_linux_smoke_observer_process:" + JSON.stringify(output));
  const document = JSON.parse(output.stdout.trim());
  ensure(flag_at(document, "ok"), "cu_linux_smoke_observer_reply:" + JSON.stringify(document));
  return document.data;
}

// The window row this run owns, by pid and exact title.
function window_row(run_directory, executable, pid, title) {
  const reply = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "windows", "--pid", "" + pid
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

// The text of one named node, through the Text interface.
function node_text(run_directory, executable, handle_text, name) {
  const reply = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "get-text",
    "--window", handle_text, "--name", name
  ]);
  return text_at(reply, "data.matched.text");
}

function tree_nodes(run_directory, executable, handle_text, depth) {
  const reply = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "tree",
    "--window", handle_text, "--depth", depth
  ]);
  return reply.data.nodes;
}

function node_named(nodes, name) {
  for (const node of nodes) {
    if (text_of(node.name) === name) { return node; }
  }
  return null;
}

// The displayed text of one label, read from the tree.
//
// A GtkLabel's accessible *name* is its text, so these are addressed by
// what they currently say rather than by a stable name -- giving them one
// would hide the value being read back.
function label_starting_with(nodes, prefix) {
  for (const node of nodes) {
    if (text_of(node.role) !== "label") { continue; }
    if (text_of(node.name).startsWith(prefix)) { return text_of(node.name); }
  }
  return "";
}

function label_text(run_directory, executable, handle_text, prefix) {
  return label_starting_with(tree_nodes(run_directory, executable, handle_text, "8"), prefix);
}

// ---- entry ----------------------------------------------------------------

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_smoke_executable_missing:" + executable);
ensure(
  direct_file(rh.join(rh.parent(executable), "libagenterm.so")),
  "cu_linux_smoke_library_missing:" + rh.parent(executable)
);

const context = harness.new_context(repo, "cu-linux");
const run_directory = rh.join(repo, "target/cu-linux-smoke-run");
ensure(remove_directory_bounded(run_directory), "cu_linux_smoke_stale_directory_locked");
rh.create_dir_all(run_directory);
terminal_instance = "ephemeral:cu-linux-" + context.run_id;
terminal_address = "" + context.address;
terminal_instance_directory = "" + context.instance_directory;
terminal_workspace_path = "" + context.workspace_path;
terminal_settings_path = "" + context.settings_path;

let succeeded = 0;
let failure = "";
let fixture_pid = 0;
let fixture = -1;
let fixture_reaped = false;
let terminal_server = -1;
let terminal_server_reaped = false;
let terminal_tab_id = "";
let network_fixture = null;
let network_fixture_reaped = false;

try {
  print("STEP capabilities declare the AT-SPI tree and query available on current");
  const version_output = rh.command(executable, ["--version"], { cwd: run_directory, timeout_ms: 30000 });
  ensure(
    version_output.success === true && version_output.stdout.trim().startsWith("agenterm-cu "),
    "cu_linux_smoke_version:" + version_output.stdout + version_output.stderr
  );
  const capabilities = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "capabilities"
  ]);
  ensure(
    text_at(capabilities, "data.target") === "current"
      && text_at(capabilities, "data.mechanism") === "libagenterm"
      && text_at(capabilities, "data.capabilities.tree") === "Available"
      && text_at(capabilities, "data.verbs.tree.status") === "available"
      && text_at(capabilities, "data.verbs.query.status") === "available",
    "cu_linux_smoke_capabilities:" + JSON.stringify(capabilities.data.capabilities)
  );
  // An unauthorized observe is typed, never an empty inventory.
  const refused = run_cu_reply(run_directory, executable, ["--target", "current", "windows"]);
  ensure(
    !flag_at(refused, "ok") && text_at(refused, "error.code") === "refused",
    "cu_linux_smoke_refusal:" + JSON.stringify(refused)
  );

  print("STEP file-inspect reads one final entry without following links and binds metadata to one stable object identity");
  const file_fixture = rh.join(run_directory, "file-inspect-fixture.txt");
  rh.write_text(file_fixture, "file-inspect");
  const file_inspect = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "file", "inspect", file_fixture
  ]);
  ensure(
    text_at(capabilities, "data.verbs.file-inspect.status") === "available"
      && text_at(capabilities, "data.verbs.file-inspect.link_policy") === "never-follow-final-link"
      && text_at(file_inspect, "data.kind") === "file"
      && text_at(file_inspect, "data.size_bytes") === "12"
      && flag_at(file_inspect, "data.identity.available")
      && !flag_at(file_inspect, "data.followed_final_link"),
    "cu_linux_smoke_file_inspect:" + JSON.stringify(file_inspect)
  );
  const file_missing = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe", "file-inspect",
    rh.join(run_directory, "file-inspect-missing")
  ]);
  ensure(
    !flag_at(file_missing, "ok") && text_at(file_missing, "error.code") === "file_inspect_failed",
    "cu_linux_smoke_file_inspect_missing:" + JSON.stringify(file_missing)
  );

  print("STEP network-probe resolves one frozen loopback address, makes the exact requested attempts, observes the owned listener reachable, then reports its closed port unreachable without turning observation into failure");
  const network_stdout_path = rh.join(run_directory, "network-probe-fixture.stdout");
  const network_stderr_path = rh.join(run_directory, "network-probe-fixture.stderr");
  rh.try_remove_file(network_stdout_path);
  rh.try_remove_file(network_stderr_path);
  const network_attempts = 3;
  network_fixture = harness.start_child(context, {
    program: executable,
    args: [
      "--agenterm-cu-internal-network-probe-fixture", "" + network_attempts, "10000"
    ],
    current_dir: run_directory,
    env: { AGENTERM_CU_INTERNAL_TEST_FIXTURE: "1" },
    stdout_path: network_stdout_path,
    stderr_path: network_stderr_path,
    timeout_ms: 30000
  }, "network-probe-listener");
  let network_ready = null;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    if (direct_file(network_stdout_path)) {
      const ready_text = rh.read_text(network_stdout_path).trim();
      if (ready_text.startsWith("{") && ready_text.endsWith("}")) {
        const marker = JSON.parse(ready_text);
        if (int_at(marker, "port") > 0) { network_ready = marker; break; }
      }
    }
    ensure(
      harness.child_state(network_fixture) !== "exited",
      "cu_linux_smoke_network_fixture_early_exit"
    );
    harness.sleep_ms(10);
  }
  ensure(network_ready !== null, "cu_linux_smoke_network_fixture_not_ready");
  const network_port = int_at(network_ready, "port");
  const reachable = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "network-probe", "127.0.0.1",
    "--port", "" + network_port, "--attempts", "" + network_attempts,
    "--timeout-ms", "500"
  ]);
  ensure(
    text_at(reachable, "data.provider") === "system-resolver-owned-worker"
      && flag_at(reachable, "data.address_set_frozen")
      && int_at(reachable, "data.address_count") === 1
      && reachable.data.resolved_addresses.length === 1
      && text_of(reachable.data.resolved_addresses[0].address) === "127.0.0.1"
      && text_of(reachable.data.resolved_addresses[0].family) === "ipv4"
      && int_at(reachable, "data.attempt_count") === network_attempts
      && reachable.data.attempts.length === network_attempts
      && int_at(reachable, "data.connected_count") === network_attempts
      && int_at(reachable, "data.unreachable_count") === 0
      && text_at(reachable, "data.status") === "reachable",
    "cu_linux_smoke_network_reachable:" + JSON.stringify(reachable.data)
  );
  for (let index = 0; index < network_attempts; index = index + 1) {
    const attempt = reachable.data.attempts[index];
    ensure(
      int_at(attempt, "attempt") === index + 1
        && text_at(attempt, "address") === "127.0.0.1"
        && text_at(attempt, "family") === "ipv4"
        && text_at(attempt, "outcome") === "connected",
      "cu_linux_smoke_network_reachable_attempt:" + JSON.stringify(attempt)
    );
  }
  const network_fixture_output = harness.child_wait(network_fixture, 5000);
  network_fixture_reaped = true;
  ensure(
    network_fixture_output.success === true,
    "cu_linux_smoke_network_fixture_exit:" + JSON.stringify(network_fixture_output)
  );
  const unreachable_attempts = 2;
  const unreachable = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "network-probe", "127.0.0.1",
    "--port", "" + network_port, "--attempts", "" + unreachable_attempts,
    "--timeout-ms", "500"
  ]);
  ensure(
    text_at(unreachable, "data.provider") === "system-resolver-owned-worker"
      && flag_at(unreachable, "data.address_set_frozen")
      && int_at(unreachable, "data.address_count") === 1
      && int_at(unreachable, "data.attempt_count") === unreachable_attempts
      && unreachable.data.attempts.length === unreachable_attempts
      && int_at(unreachable, "data.connected_count") === 0
      && int_at(unreachable, "data.unreachable_count") === unreachable_attempts
      && text_at(unreachable, "data.status") === "unreachable",
    "cu_linux_smoke_network_unreachable:" + JSON.stringify(unreachable.data)
  );
  for (let index = 0; index < unreachable_attempts; index = index + 1) {
    const attempt = unreachable.data.attempts[index];
    ensure(
      int_at(attempt, "attempt") === index + 1
        && text_at(attempt, "address") === "127.0.0.1"
        && text_at(attempt, "family") === "ipv4"
        && text_at(attempt, "outcome") !== "connected",
      "cu_linux_smoke_network_unreachable_attempt:" + JSON.stringify(attempt)
    );
  }
  rh.try_remove_file(network_stdout_path);
  rh.try_remove_file(network_stderr_path);

  print("STEP terminal-list/read/send/wait preserve stable authority and tab identity through literal input, finalized remain-on-exit, typed late-send refusal, and explicit cleanup");
  const agenterm = rh.join(rh.parent(executable), "agenterm");
  ensure(direct_file(agenterm), "cu_linux_smoke_agenterm_missing:" + agenterm);
  terminal_server = harness.start({
    program: agenterm,
    args: ["server", "--address", terminal_address],
    current_dir: run_directory,
    env: terminal_env(run_directory),
    timeout_ms: 60000
  });
  let terminal_ready = null;
  for (let attempt = 0; attempt < 400; attempt = attempt + 1) {
    const candidate = run_cu_reply(run_directory, executable, [
      "--target", "current", "--grant", "observe", "terminal-list"
    ]);
    if (flag_at(candidate, "ok")) { terminal_ready = candidate; break; }
    ensure(harness.state(terminal_server) !== "exited", "cu_linux_smoke_terminal_server_early_exit");
    harness.sleep_ms(25);
  }
  ensure(terminal_ready !== null, "cu_linux_smoke_terminal_server_not_ready");
  const terminal_scope = text_at(terminal_ready, "data.server_scope_id");
  const terminal_epoch = text_at(terminal_ready, "data.server_epoch");
  ensure(
    terminal_scope !== "" && terminal_epoch !== ""
      && text_at(terminal_ready, "data.identity") === "server-scope+epoch+tab-id",
    "cu_linux_smoke_terminal_authority:" + JSON.stringify(terminal_ready.data)
  );
  terminal_tab_id = run_agenterm(run_directory, agenterm, [
    "new-window", "-d", "-P", "-F", "#{window_id}",
    "-n", "cu-terminal-" + context.run_id, "--", "sh", "-c", "stty -echo; exec sh"
  ]);
  ensure(terminal_tab_id.startsWith("@"), "cu_linux_smoke_terminal_tab_id:" + terminal_tab_id);
  let terminal_inventory = null;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    const candidate = run_cu_json(run_directory, executable, [
      "--target", "current", "--grant", "observe", "terminal-list"
    ]);
    if (terminal_tab(candidate.data.tabs, terminal_tab_id) !== null) {
      terminal_inventory = candidate;
      break;
    }
    harness.sleep_ms(25);
  }
  ensure(terminal_inventory !== null, "cu_linux_smoke_terminal_tab_missing");
  ensure(
    text_at(terminal_inventory, "data.server_scope_id") === terminal_scope
      && text_at(terminal_inventory, "data.server_epoch") === terminal_epoch,
    "cu_linux_smoke_terminal_identity_changed:" + JSON.stringify(terminal_inventory.data)
  );
  const terminal_marker = "ACU_TERMINAL_LITERAL_" + context.run_id;
  const terminal_input = "printf '" + terminal_marker + "\\n'; exit\r";
  const terminal_send = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "terminal-send",
    "--tab", terminal_tab_id, "--", terminal_input
  ]);
  ensure(
    text_at(terminal_send, "data.tab_id") === terminal_tab_id
      && int_at(terminal_send, "data.text_bytes") === terminal_input.length
      && flag_at(terminal_send, "data.performed")
      && flag_at(terminal_send, "data.verified")
      && text_at(terminal_send, "data.verification") === "agenterm-control-receipt",
    "cu_linux_smoke_terminal_send:" + JSON.stringify(terminal_send.data)
  );
  const terminal_contains = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "terminal-wait",
    "--tab", terminal_tab_id, "--contains", terminal_marker, "--timeout-ms", "10000"
  ]);
  ensure(
    text_at(terminal_contains, "data.state") === "matched"
      && flag_at(terminal_contains, "data.completed"),
    "cu_linux_smoke_terminal_contains:" + JSON.stringify(terminal_contains.data)
  );
  const terminal_read = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "terminal-read",
    "--tab", terminal_tab_id, "--max-bytes", "16384"
  ]);
  ensure(
    text_at(terminal_read, "data.text").indexOf(terminal_marker) >= 0
      && text_at(terminal_read, "data.read_kind") === "bounded-screen-snapshot"
      && at(terminal_read, "data.incremental_cursor") === null
      && !flag_at(terminal_read, "data.truncated"),
    "cu_linux_smoke_terminal_read:" + JSON.stringify(terminal_read.data)
  );
  const terminal_finalized = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "terminal-wait",
    "--tab", terminal_tab_id, "--finalized", "--timeout-ms", "10000"
  ]);
  ensure(
    text_at(terminal_finalized, "data.state") === "matched"
      && flag_at(terminal_finalized, "data.completed"),
    "cu_linux_smoke_terminal_finalized:" + JSON.stringify(terminal_finalized.data)
  );
  const retained = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "terminal-list"
  ]);
  const retained_tab = terminal_tab(retained.data.tabs, terminal_tab_id);
  ensure(
    retained_tab !== null && retained_tab.dead === true && int_at(retained_tab, "exit_code") === 0
      && text_at(retained, "data.server_scope_id") === terminal_scope
      && text_at(retained, "data.server_epoch") === terminal_epoch,
    "cu_linux_smoke_terminal_remain_on_exit:" + JSON.stringify(retained.data)
  );
  const terminal_late_send = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "terminal-send",
    "--tab", terminal_tab_id, "--", "late-input"
  ]);
  ensure(
    !flag_at(terminal_late_send, "ok")
      && text_at(terminal_late_send, "error.code") === "terminal_not_writable",
    "cu_linux_smoke_terminal_late_send:" + JSON.stringify(terminal_late_send)
  );
  run_agenterm(run_directory, agenterm, ["kill-window", "-t", terminal_tab_id]);
  terminal_tab_id = "";
  run_agenterm(run_directory, agenterm, ["shutdown"]);
  const terminal_server_output = harness.wait(terminal_server, 10000);
  terminal_server_reaped = true;
  ensure(terminal_server_output.success === true, "cu_linux_smoke_terminal_server_exit");

  print("STEP start the owned GTK fixture and resolve its two windows by pid and exact title");
  const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
  ensure(direct_file(fixture_source), "cu_linux_smoke_fixture_source_missing:" + fixture_source);
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    // GTK publishes its AT-SPI tree only with the bridge loaded.
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
  const second_title = "agenterm-linux-second-" + fixture_pid;
  const window_wait = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "wait",
    "--timeout-ms", "15000", "--window-title-contains", fixture_title
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_smoke_window_wait_not_met");
  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_smoke_window_identity");
  const fixture_handle = int_at(row, "handle");
  ensure(
    fixture_handle > 0
      && int_at(row, "bounds.width") > 0
      && int_at(row, "bounds.height") > 0
      && text_at(row, "app_name") !== "",
    "cu_linux_smoke_window_row:" + JSON.stringify(row)
  );
  const handle_text = "" + fixture_handle;

  print("STEP process-state and process-usage bind real observations to the owned fixture pid and one stable start identity");
  const process_state = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-state", "--pid", "" + fixture_pid
  ]);
  const process_identity = text_at(process_state, "data.start_identity");
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && process_identity !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_smoke_process_state:" + JSON.stringify(process_state.data)
  );
  print("STEP process argv preserves native boundaries and keeps plaintext behind explicit --values");
  const process_argv_hidden = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process", "argv", "" + fixture_pid,
    "--limit", "1"
  ]);
  const process_argv_visible = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-argv", "--pid", "" + fixture_pid,
    "--limit", "1", "--values"
  ]);
  const hidden_arg = process_argv_hidden.data.arguments[0];
  const visible_arg = process_argv_visible.data.arguments[0];
  ensure(
    text_at(process_argv_hidden, "data.start_identity") === process_identity
      && flag_at(process_argv_hidden, "data.verified")
      && !flag_at(process_argv_hidden, "data.values_included")
      && hidden_arg.value === undefined
      && text_of(hidden_arg.sha256).length === 64
      && rh.only_chars(text_of(hidden_arg.sha256), rh.HEX)
      && text_of(process_argv_visible.data.executable) !== ""
      && flag_at(process_argv_visible, "data.values_included")
      && text_of(visible_arg.value) !== ""
      && text_of(visible_arg.sha256) === text_of(hidden_arg.sha256),
    "cu_linux_smoke_process_argv"
  );
  const process_usage = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-usage", "--pid", "" + fixture_pid
  ]);
  ensure(
    int_at(process_usage, "data.pid") === fixture_pid
      && text_at(process_usage, "data.start_identity") === process_identity
      && flag_at(process_usage, "data.verified"),
    "cu_linux_smoke_process_usage:" + JSON.stringify(process_usage.data)
  );
  ensure_wide_counter(process_usage, "data.cpu_time_ns");
  ensure_wide_counter(process_usage, "data.resident_bytes");
  ensure_wide_counter(process_usage, "data.page_faults.total");
  ensure_wide_counter(process_usage, "data.page_faults.soft");
  ensure_wide_counter(process_usage, "data.page_faults.hard");
  print("STEP bounded process usage watch preserves one identity and stops at its sample ceiling");
  const usage_watch = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-usage", "--pid", "" + fixture_pid,
    "--watch-ms", "20", "--interval-ms", "5", "--max-samples", "2"
  ]);
  const usage_samples = at(usage_watch, "data.samples");
  ensure(
    Array.isArray(usage_samples) && usage_samples.length === 2
      && int_at(usage_watch, "data.emitted") === 2
      && flag_at(usage_watch, "data.truncated")
      && flag_at(usage_watch, "data.verified")
      && text_at(usage_watch, "data.start_identity") === process_identity
      && text_of(usage_samples[0].cpu_time_ns) !== ""
      && text_of(usage_samples[1].cpu_time_ns) !== "",
    "cu_linux_smoke_process_usage_watch:" + JSON.stringify(usage_watch.data)
  );
  print("STEP process-wait binds the same identity to a native exact-object timeout");
  const process_wait = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-wait",
    "--pid", "" + fixture_pid, "--start-identity", process_identity, "--timeout-ms", "5"
  ]);
  ensure(
    text_at(process_wait, "data.state") === "timeout"
      && !flag_at(process_wait, "data.completed")
      && flag_at(process_wait, "data.verified")
      && text_at(process_wait, "data.mechanism") === "native-process-reference",
    "cu_linux_smoke_process_wait:" + JSON.stringify(process_wait.data)
  );

  print("STEP process lifecycle watch reports the exact identity of an owned child that exits");
  const short_child = harness.start({
    program: "sh", args: ["-c", "sleep 1"], current_dir: run_directory, timeout_ms: 5000
  });
  const short_pid = harness.spawned_pid(short_child);
  const lifecycle = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "process-watch", "--pid", "" + short_pid,
    "--duration-ms", "10000", "--interval-ms", "20", "--max-events", "1", "--max-processes", "4"
  ]);
  const lifecycle_events = at(lifecycle, "data.events");
  ensure(
    Array.isArray(lifecycle_events) && lifecycle_events.length === 1
      && text_of(lifecycle_events[0].kind) === "exited"
      && int_at(lifecycle_events[0], "process.pid") === short_pid
      && text_of(lifecycle_events[0].process.start_identity)
        === text_of(lifecycle.data.baseline[0].start_identity)
      && !flag_at(lifecycle, "data.completed") && flag_at(lifecycle, "data.truncated"),
    "cu_linux_smoke_process_lifecycle_watch:" + JSON.stringify(lifecycle.data)
  );
  harness.wait(short_child, 5000);

  print("STEP every node in the tree carries a real rectangle, and a control that has none says so with the empty-rect sentinel rather than a screen coordinate");
  const nodes = tree_nodes(run_directory, executable, handle_text, "8");
  ensure(nodes.length > 5, "cu_linux_smoke_tree_small:" + nodes.length);
  const press_button = node_named(nodes, "Fixture Press");
  ensure(press_button !== null, "cu_linux_smoke_button_missing");
  // The walk hardcoded these to zero, which is this adapter's own
  // "unavailable" sentinel -- published for every node as though measured.
  ensure(
    int_at(press_button, "bounds.width") > 0 && int_at(press_button, "bounds.height") > 0,
    "cu_linux_smoke_button_bounds:" + JSON.stringify(press_button.bounds)
  );
  // A closed menu's items are never allocated, and GTK reports them at
  // i32::MIN. That must not reach a caller as a place to click.
  let closed_item_seen = 0;
  for (const node of nodes) {
    if (text_of(node.role).indexOf("menu item") < 0) { continue; }
    closed_item_seen = 1;
    ensure(
      int_at(node, "bounds.x") > -2000000000 && int_at(node, "bounds.y") > -2000000000,
      "cu_linux_smoke_unallocated_rect:" + JSON.stringify(node)
    );
  }
  ensure(closed_item_seen === 1, "cu_linux_smoke_no_menu_items_in_tree");

  print("STEP query by role finds the fixture controls and reports its counts");
  const query = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "query", "--window", handle_text, "--role", "button"
  ]);
  ensure(int_at(query, "data.matched") >= 1, "cu_linux_smoke_query:" + JSON.stringify(query.data));

  print("STEP invoke press advances the count label, and set-checked repeats as a verified no-op");
  const before_press = label_text(run_directory, executable, handle_text, "pressed ");
  ensure(before_press === "pressed 0", "cu_linux_smoke_press_before:" + before_press);
  const pressed = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "invoke",
    "--window", handle_text, "--name", "Fixture Press", "press"
  ]);
  ensure(flag_at(pressed, "data.performed"), "cu_linux_smoke_press:" + JSON.stringify(pressed.data));
  ensure(
    label_text(run_directory, executable, handle_text, "pressed ") === "pressed 1",
    "cu_linux_smoke_press_after"
  );
  const checked_once = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "invoke",
    "--window", handle_text, "--name", "Fixture Check", "set-checked", "true"
  ]);
  ensure(
    flag_at(checked_once, "data.performed") && flag_at(checked_once, "data.verified"),
    "cu_linux_smoke_check_first:" + JSON.stringify(checked_once.data)
  );
  const checked_again = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "invoke",
    "--window", handle_text, "--name", "Fixture Check", "set-checked", "true"
  ]);
  ensure(
    flag_at(checked_again, "data.verified") && !flag_at(checked_again, "data.performed"),
    "cu_linux_smoke_check_repeat:" + JSON.stringify(checked_again.data)
  );

  print("STEP focus moves the AT-SPI focus to the entry and focused binds it back");
  // Before the menu steps, deliberately. Pressing a background menu item
  // leaves this desktop with no focused widget at all -- measured: the
  // window's tree carries no STATE_FOCUSED node afterwards, and a later
  // `focus` verifies at the moment it acts and then loses it again. That
  // is a property of the desktop, not of the verb, and a journey that
  // asserted otherwise would be asserting something untrue.
  run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "focus",
    "--window", handle_text, "--name", "Fixture Entry"
  ]);
  const focused = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "focused", "--window", handle_text
  ]);
  ensure(
    text_at(focused, "data.node.name") === "Fixture Entry",
    "cu_linux_smoke_focused:" + JSON.stringify(focused.data)
  );

  print("STEP menu inspect walks the background menu bar and reports the paths menu invoke accepts, with the enabled and checked states AT-SPI publishes only positively");
  const menu = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "menu", "inspect", "--window", handle_text
  ]);
  const items = menu.data.items;
  ensure(items.length >= 4, "cu_linux_smoke_menu_items:" + JSON.stringify(items));
  let saw_bar_entry = 0;
  let saw_do_thing = 0;
  let saw_disabled = 0;
  let saw_checkable = 0;
  for (const item of items) {
    const path = item.path.join("/");
    // AT-SPI has no separate bar-entry node: GTK's "File" is itself a
    // role-`menu` node, and it has to be a path segment or these paths are
    // not the ones `menu invoke` accepts.
    if (path === "File") { saw_bar_entry = 1; }
    if (path === "File/Do Thing") { saw_do_thing = item.enabled === true ? 1 : 0; }
    // AT-SPI publishes no `disabled` state at all, so "not disabled" called
    // every item pressable.
    if (path === "File/Disabled Thing") { saw_disabled = item.enabled === false ? 1 : 0; }
    // A checkable entry carries its own role; without it `inspect` omitted
    // items `invoke` would press.
    if (path === "File/Marked Thing") { saw_checkable = 1; }
  }
  ensure(
    saw_bar_entry === 1 && saw_do_thing === 1 && saw_disabled === 1 && saw_checkable === 1,
    "cu_linux_smoke_menu_shape:" + JSON.stringify(items)
  );

  print("STEP menu invoke presses a background menu item and the label changes; a disabled item is refused typed with nothing performed, and a checkable one round-trips its mark");
  const menu_before = label_text(run_directory, executable, handle_text, "menu idle");
  ensure(menu_before === "menu idle", "cu_linux_smoke_menu_label_before:" + menu_before);
  const invoked = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "menu", "invoke",
    "--window", handle_text, "--path", "File/Do Thing"
  ]);
  ensure(flag_at(invoked, "data.performed"), "cu_linux_smoke_menu_invoke:" + JSON.stringify(invoked.data));
  ensure(
    label_text(run_directory, executable, handle_text, "did thing ") === "did thing 1",
    "cu_linux_smoke_menu_label_after"
  );
  const menu_refused = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "menu", "invoke",
    "--window", handle_text, "--path", "File/Disabled Thing"
  ]);
  ensure(
    !flag_at(menu_refused, "ok") && text_at(menu_refused, "error.code") === "a11y_menu_item_disabled",
    "cu_linux_smoke_menu_disabled:" + JSON.stringify(menu_refused)
  );
  ensure(
    label_text(run_directory, executable, handle_text, "did thing ") === "did thing 1",
    "cu_linux_smoke_menu_disabled_side_effect"
  );
  // The receipt's mark is one Unicode scalar, so a state word would arrive
  // as its first letter -- invisible on macOS, where a real mark is one
  // character.
  const marked_on = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "menu", "invoke",
    "--window", handle_text, "--path", "File/Marked Thing"
  ]);
  ensure(
    text_at(marked_on, "data.mark_after").length === 1
      && text_at(marked_on, "data.mark_before") === "",
    "cu_linux_smoke_mark_on:" + JSON.stringify(marked_on.data)
  );
  const marked_off = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "menu", "invoke",
    "--window", handle_text, "--path", "File/Marked Thing"
  ]);
  ensure(
    text_at(marked_off, "data.mark_before").length === 1
      && text_at(marked_off, "data.mark_after") === "",
    "cu_linux_smoke_mark_off:" + JSON.stringify(marked_off.data)
  );

  print("STEP the node text and geometry verbs write and read the entry through AT-SPI: send-text, select / get-selection, set-caret / get-caret, get-extents");
  run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "send-text",
    "--window", handle_text, "--name", "Fixture Entry", "--", "linuxtyped"
  ]);
  ensure(
    node_text(run_directory, executable, handle_text, "Fixture Entry") === "linuxtyped",
    "cu_linux_smoke_send_text"
  );
  run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "select",
    "--window", handle_text, "--name", "Fixture Entry", "--start", "2", "--end", "7"
  ]);
  const selection = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "get-selection",
    "--window", handle_text, "--name", "Fixture Entry"
  ]);
  ensure(
    int_at(selection, "data.start") === 2 && int_at(selection, "data.end") === 7,
    "cu_linux_smoke_selection:" + JSON.stringify(selection.data)
  );
  run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "set-caret",
    "--window", handle_text, "--name", "Fixture Entry", "--offset", "4"
  ]);
  const caret = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "get-caret",
    "--window", handle_text, "--name", "Fixture Entry"
  ]);
  ensure(int_at(caret, "data.offset") === 4, "cu_linux_smoke_caret:" + JSON.stringify(caret.data));
  const extents = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "get-extents",
    "--window", handle_text, "--name", "Fixture Press"
  ]);
  ensure(
    int_at(extents, "data.extents.width") > 0 && int_at(extents, "data.extents.height") > 0,
    "cu_linux_smoke_extents:" + JSON.stringify(extents.data)
  );

  print("STEP observe captures the changes made while it runs, with the before and after of each, rather than a snapshot taken after the fact");
  // The two independent mutation calls can consume most of a three-second
  // stream on a cold AT-SPI guest. Keep enough post-mutation polling time to
  // observe both changes instead of turning host latency into a false drop.
  const observer = start_observer(run_directory, executable, handle_text, "6");
  harness.sleep_ms(700);
  run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "invoke",
    "--window", handle_text, "--name", "Fixture Press", "press"
  ]);
  harness.sleep_ms(400);
  run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "send-text",
    "--window", handle_text, "--name", "Fixture Entry", "--", "observed"
  ]);
  const observed = observer_result(observer);
  // Both changes were issued by a *different* process while the stream was
  // open, so an implementation that diffed once at the end would report the
  // final state and miss that there were two separate changes.
  ensure(
    int_at(observed, "emitted") >= 2 && text_at(observed, "mode") === "poll-diff",
    "cu_linux_smoke_observe:" + JSON.stringify(observed)
  );
  let saw_label_change = 0;
  let saw_text_change = 0;
  for (const event of observed.events) {
    if (text_of(event.before) === "pressed 1" && text_of(event.after) === "pressed 2") { saw_label_change = 1; }
    if (text_of(event.before) === "linuxtyped" && text_of(event.after) === "observed") { saw_text_change = 1; }
  }
  ensure(
    saw_label_change === 1 && saw_text_change === 1,
    // Keep the complete poll account on failure. A slow AT-SPI court needs
    // polls / elapsed / errors / filtering to distinguish a mixed tree walk
    // from a dropped event; the event rows alone cannot make that decision.
    "cu_linux_smoke_observe_events:" + JSON.stringify(observed)
  );

  print("STEP screenshot writes a PNG of the window itself, sized to the window rather than to the screen");
  const shot_path = rh.join(run_directory, "window.png");
  const shot = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "screenshot",
    "--out", shot_path, "--window", handle_text
  ]);
  const shot_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(
    int_at(shot, "data.output_width") === int_at(shot_row, "bounds.width")
      && int_at(shot, "data.output_height") === int_at(shot_row, "bounds.height"),
    "cu_linux_smoke_shot_size:" + JSON.stringify(shot.data) + JSON.stringify(shot_row.bounds)
  );
  ensure(direct_file(shot_path), "cu_linux_smoke_shot_missing");
  // A capture of a real window compresses to far more than a blank one; an
  // empty or flat image is what a broken X11 GetImage produces.
  ensure(
    rh.metadata(shot_path).len > 2000,
    "cu_linux_smoke_shot_empty:" + rh.metadata(shot_path).len
  );

  print("STEP send-keys performs the action the chord means, because AT-SPI publishes no key interface here; a chord with no such meaning is a typed refusal rather than a keystroke into the void");
  // The same answer macOS gives for a different reason: it delivers a
  // keystroke only to the active application and this never activates one,
  // so `enter` is the AX action `AXConfirm`. GTK publishes no
  // DeviceEventListener at all, and the AT-SPI spelling of that action is
  // the node's own default action.
  const keys_before = label_text(run_directory, executable, handle_text, "pressed ");
  run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "send-keys",
    "--window", handle_text, "--name", "Fixture Press", "--", "enter"
  ]);
  ensure(
    label_text(run_directory, executable, handle_text, "pressed ") !== keys_before,
    "cu_linux_smoke_send_keys_no_effect:" + keys_before
  );
  const keys_refused = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "send-keys",
    "--window", handle_text, "--name", "Fixture Press", "--", "esc"
  ]);
  ensure(
    !flag_at(keys_refused, "ok") && text_at(keys_refused, "error.code") === "a11y_key_unavailable",
    "cu_linux_smoke_send_keys_esc:" + JSON.stringify(keys_refused)
  );

  print("STEP window-place frame puts the window exactly where it was asked, which is an equality only because the request compensates for the window manager's own frame and the read-back is in root coordinates");
  const placed = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "window-place",
    "--action", "frame", "--window", handle_text,
    "--x", "260", "--y", "180", "--width", "300", "--height", "240"
  ]);
  ensure(
    int_at(placed, "data.after.x") === 260 && int_at(placed, "data.after.y") === 180
      && int_at(placed, "data.after.width") === 300 && int_at(placed, "data.after.height") === 240,
    "cu_linux_smoke_place:" + JSON.stringify(placed.data)
  );
  // The inventory is read independently of the verb's own answer.
  const placed_row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(
    int_at(placed_row, "bounds.x") === 260 && int_at(placed_row, "bounds.y") === 180,
    "cu_linux_smoke_place_inventory:" + JSON.stringify(placed_row.bounds)
  );

  print("STEP orderwin raises the second window above the first and answers from the order it reads back, not from having sent the raise");
  const second_row = window_row(run_directory, executable, fixture_pid, second_title);
  ensure(second_row !== null, "cu_linux_smoke_second_window_missing");
  const second_handle = int_at(second_row, "handle");
  const raised = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "orderwin",
    "--window", "" + second_handle, "--relation", "above", "--relative", handle_text
  ]);
  ensure(
    int_at(raised, "data.after.window_z") < int_at(raised, "data.after.relative_z"),
    "cu_linux_smoke_orderwin:" + JSON.stringify(raised.data)
  );
  const same_handle = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "orderwin",
    "--window", handle_text, "--relation", "above", "--relative", handle_text
  ]);
  ensure(
    !flag_at(same_handle, "ok") && text_at(same_handle, "error.code") === "invalid_input",
    "cu_linux_smoke_orderwin_same:" + JSON.stringify(same_handle)
  );

  print("STEP a window the window manager has put away stays in the inventory as minimized with no place in the stacking order, and the filter matches it");
  run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "menu", "invoke",
    "--window", handle_text, "--path", "File/Minimize"
  ]);
  let minimized_row = null;
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    const candidate = window_row(run_directory, executable, fixture_pid, fixture_title);
    if (candidate !== null && candidate.minimized === true) { minimized_row = candidate; break; }
    harness.sleep_ms(50);
  }
  ensure(minimized_row !== null, "cu_linux_smoke_minimized_never_true");
  // A window that is not on screen has no z-order position, and reporting
  // zero for it would put it in front of everything.
  ensure(
    at(minimized_row, "z_index") === null || at(minimized_row, "z_index") === undefined,
    "cu_linux_smoke_minimized_z:" + JSON.stringify(minimized_row)
  );
  const minimized_filter = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "windows",
    "--pid", "" + fixture_pid, "--minimized", "true"
  ]);
  ensure(
    int_at(minimized_filter, "data.matched") === 1,
    "cu_linux_smoke_minimized_filter:" + JSON.stringify(minimized_filter.data)
  );

  print("STEP app hide puts every window the process owns away and app show brings them all back, verified from the inventory rather than from the request");
  // AT-SPI2 has no application-level hidden flag, so this is the operation
  // the desktop itself means: every top-level window of the process is
  // iconified. It is only honest because it acts on all of them and reads
  // the result back. What "away" looks like also differs by host -- macOS
  // stops listing a hidden application's windows, X11 keeps them listed and
  // marks them hidden -- so absent and minimized both count.
  const hidden = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "app", "hide", "--window", handle_text
  ]);
  ensure(
    flag_at(hidden, "data.verified") && int_at(hidden, "data.windows_on_screen") === 0,
    "cu_linux_smoke_app_hide:" + JSON.stringify(hidden.data)
  );
  // Hiding is not closing and not killing: the process is still there.
  ensure(harness.process_present(fixture_pid) !== 0, "cu_linux_smoke_app_hide_killed_it");
  const shown = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "app", "show", "--pid", "" + fixture_pid
  ]);
  ensure(
    flag_at(shown, "data.verified") && int_at(shown, "data.windows_on_screen") === 2,
    "cu_linux_smoke_app_show:" + JSON.stringify(shown.data)
  );

  print("STEP apps --all lists applications no window can reveal, read from the XDG desktop entries, and names the join behind its running flag");
  const apps = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "apps", "--all"
  ]);
  ensure(
    flag_at(apps, "data.installed_available"),
    "cu_linux_smoke_apps_unavailable:" + JSON.stringify(apps.data.installed_reason)
  );
  ensure(
    apps.data.installed_apps.length > 0
      && text_at(apps, "data.running_match") === "window-app-name",
    "cu_linux_smoke_apps:" + JSON.stringify(apps.data.installed_apps)
  );
  for (const app of apps.data.installed_apps) {
    ensure(text_of(app.name) !== "", "cu_linux_smoke_app_unnamed:" + JSON.stringify(app));
    ensure(text_of(app.path).endsWith(".desktop"), "cu_linux_smoke_app_path:" + JSON.stringify(app));
  }

  print("STEP unlock truthfully reports either a performed AT-SPI poke or the backend reason it could not perform one");
  // AT-SPI deployments differ: some expose org.a11y.Status and can perform
  // the content poke, while others can only name why it is unavailable. Both
  // are truthful; a blank success/refusal is not.
  const poke = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "unlock", "--window", handle_text
  ]);
  ensure(
    (flag_at(poke, "data.poked") && text_at(poke, "data.ax") !== "")
      || (!flag_at(poke, "data.poked")
        && text_at(poke, "data.reason").indexOf("AT-SPI") >= 0),
    "cu_linux_smoke_poke_reason:" + JSON.stringify(poke.data)
  );
  const launch_refusal = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "app", "launch",
    "--path", rh.join(run_directory, "does-not-exist.desktop")
  ]);
  ensure(
    !flag_at(launch_refusal, "ok") && text_at(launch_refusal, "error.code") === "app_not_found",
    "cu_linux_smoke_launch_missing:" + JSON.stringify(launch_refusal)
  );

  print("STEP close without a snapshot, a postcondition or a target is refused typed; with all three the second window closes and the handle reads back gone");
  const close_bare = run_cu_reply(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "close", "--window", "" + second_handle
  ]);
  ensure(
    !flag_at(close_bare, "ok") && text_at(close_bare, "error.code") === "refused"
      && text_at(close_bare, "error.detail.effect") === "not_performed",
    "cu_linux_smoke_close_bare:" + JSON.stringify(close_bare)
  );
  ensure(
    window_row(run_directory, executable, fixture_pid, second_title) !== null,
    "cu_linux_smoke_close_bare_side_effect"
  );
  const closed = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "close",
    "--window", "" + second_handle, "--pid", "" + fixture_pid, "--title", second_title,
    "--snapshot", "--expect", "gone"
  ]);
  ensure(
    flag_at(closed, "data.performed") && flag_at(closed, "data.snapshot.in_receipt"),
    "cu_linux_smoke_close:" + JSON.stringify(closed.data)
  );
  let closed_gone = 0;
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    if (window_row(run_directory, executable, fixture_pid, second_title) === null) { closed_gone = 1; break; }
    harness.sleep_ms(50);
  }
  ensure(closed_gone === 1, "cu_linux_smoke_close_window_lingers");
  // Closing a window is not killing the process: the other window is still
  // there and the fixture is still running.
  ensure(harness.process_present(fixture_pid) !== 0, "cu_linux_smoke_close_killed_the_process");
  const receipts = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "receipts", "--max", "50"
  ]);
  ensure(
    receipts.data.receipts.length > 0,
    "cu_linux_smoke_receipts:" + JSON.stringify(receipts.data)
  );

  print("STEP process-kill sends SIGTERM through the retained pidfd, verifies exit, and leaves no window");
  const process_kill = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe,actuate", "process-kill",
    "--pid", "" + fixture_pid, "--start-identity", process_identity,
    "--mode", "graceful", "--timeout-ms", "5000", "--expect", "exited"
  ]);
  ensure(
    flag_at(process_kill, "data.performed")
      && text_at(process_kill, "data.state") === "exited"
      && flag_at(process_kill, "data.verified")
      && text_at(process_kill, "data.mechanism") === "native-process-reference",
    "cu_linux_smoke_process_kill:" + JSON.stringify(process_kill.data)
  );
  let fixture_exited = 0;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    if (harness.state(fixture) === "exited") { fixture_exited = 1; break; }
    harness.sleep_ms(25);
  }
  ensure(fixture_exited !== 0, "cu_linux_smoke_fixture_exit_timeout");
  const fixture_output = harness.wait(fixture, 3000);
  fixture_reaped = true;
  const ready_parts = fixture_output.stdout.trim().split(" ");
  ensure(
    ready_parts.length === 2 && ready_parts[0] === "ready"
      && rh.parse_int("" + ready_parts[1]) === fixture_pid,
    "cu_linux_smoke_fixture_ready:" + fixture_output.stdout
  );
  ensure(harness.process_present(fixture_pid) === 0, "cu_linux_smoke_fixture_orphan");
  const gone = run_cu_json(run_directory, executable, [
    "--target", "current", "--grant", "observe", "windows", "--pid", "" + fixture_pid
  ]);
  ensure(int_at(gone, "data.matched") === 0, "cu_linux_smoke_fixture_window_lingers");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture >= 0 && !fixture_reaped) {
  // Only the pid this run spawned; never a name pattern.
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  try { harness.wait(fixture, 3000); } catch (wait_error) { print("cleanup: " + wait_error); }
}

if (network_fixture !== null && !network_fixture_reaped) {
  if (harness.child_state(network_fixture) === "running") {
    try { harness.child_kill(network_fixture); }
    catch (kill_error) { print("cleanup: " + kill_error); }
  }
  try { harness.child_wait(network_fixture, 3000); }
  catch (wait_error) { print("cleanup: " + wait_error); }
}

if (terminal_server >= 0 && !terminal_server_reaped) {
  const agenterm = rh.join(rh.parent(executable), "agenterm");
  if (terminal_tab_id !== "") {
    try { run_agenterm(run_directory, agenterm, ["kill-window", "-t", terminal_tab_id]); }
    catch (close_error) { print("cleanup: " + close_error); }
  }
  if (harness.state(terminal_server) === "running") {
    try { run_agenterm(run_directory, agenterm, ["shutdown"]); }
    catch (shutdown_error) { print("cleanup: " + shutdown_error); }
  }
  try { harness.wait(terminal_server, 3000); }
  catch (wait_error) { print("cleanup: " + wait_error); }
}

// Evidence is emitted only once the whole run has succeeded: a partial run
// that left evidence behind would claim what it did not finish proving.
if (succeeded !== 1) {
  if (!remove_directory_bounded(run_directory)) {
    failure = failure + ":cu_linux_smoke_cleanup_locked";
  }
  harness.remove_run(context);
  throw failure;
}

ensure(remove_directory_bounded(run_directory), "cu_linux_smoke_cleanup_locked");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-capabilities");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-window-identity");
harness.emit_evidence(context, declared_evidence, "cu.linux-process-state");
harness.emit_evidence(context, declared_evidence, "cu.linux-process-argv");
harness.emit_evidence(context, declared_evidence, "cu.linux-process-usage");
harness.emit_evidence(context, declared_evidence, "cu.linux-process-usage-watch");
harness.emit_evidence(context, declared_evidence, "cu.linux-process-wait");
harness.emit_evidence(context, declared_evidence, "cu.linux-process-kill");
harness.emit_evidence(context, declared_evidence, "cu.linux-process-lifecycle-watch");
harness.emit_evidence(context, declared_evidence, "cu.linux-network-probe");
harness.emit_evidence(context, declared_evidence, "cu.linux-file-inspect");
harness.emit_evidence(context, declared_evidence, "cu.linux-terminal-control");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-tree-geometry");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-query");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-invoke");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-menu-inspect");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-menu-invoke");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-node-text");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-focus");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-observe");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-screenshot");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-window-place");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-orderwin");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-minimized");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-send-keys");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-app-lifecycle");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-app-inventory");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-destructive-close");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-refusal-reasons");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-fixture-cleanup");
harness.remove_run(context);
print("PASS: agenterm-cu Linux AT-SPI journey (capabilities, windows, tree geometry, query, invoke, menus, node text, focus, window-place, orderwin, minimized, apps, close, receipts)");
return;
