// CEO: Linux process-fds honesty with independent /proc/<pid>/fd read-back.
// Acceptance is smoke read-back only: CU process-fds must agree with descriptor
// count, paths and kinds derived outside agenterm-cu for the same live PID.
// Typed process-fds usage must reject AT-SPI --name, --coords, --bogus, and other
// unexpected arguments; typed get-extents --name usage AND host-limit paths must
// both hold before the /proc/<pid>/fd inventory/read-back court. Prefer host-limit
// clarity over fake success. AT-SPI/--name only; no --coords or screenshot
// degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-process-fds-readback",
];

const MAX_VISITED = 256;
const AT_SPI_PROBE_NAME = "Process Fds Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function output_success(document) { return at(document, "ok") === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_fds_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "process-fds" || text_at(reply, "command") === "usage",
    "cu_linux_process_fds_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_process_fds_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_process_fds_usage_limit(run_directory, executable, env) {
  const flat_with_name = invoke_observe_reply(run_directory, executable, [
    "process-fds", "--pid", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_process_fds_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_process_fds_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_process_fds_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    text_at(flat_with_name, "error.message").indexOf("--name") >= 0
      || text_at(flat_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_process_fds_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_observe_reply(run_directory, executable, [
    "process", "fds", "--pid", "1", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_process_fds_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_process_fds_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "error.message").indexOf("--name") >= 0
      || text_at(grouped_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_process_fds_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = invoke_observe_reply(run_directory, executable, [
    "process-fds", "--pid", "1", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_process_fds_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_process_fds_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "command") === "usage",
    "cu_linux_process_fds_usage_bogus_command:" + JSON.stringify(with_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_bogus, "error.message"), "--bogus"),
    "cu_linux_process_fds_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );

  const grouped_with_bogus = invoke_observe_reply(run_directory, executable, [
    "process", "fds", "--pid", "1", "--bogus",
  ], env);
  ensure(!output_success(grouped_with_bogus),
    "cu_linux_process_fds_usage_grouped_bogus_ok:" + JSON.stringify(grouped_with_bogus));
  ensure(
    text_at(grouped_with_bogus, "error.code") === "usage",
    "cu_linux_process_fds_usage_grouped_bogus_code:" + JSON.stringify(grouped_with_bogus.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_bogus, "error.message"), "--bogus"),
    "cu_linux_process_fds_usage_grouped_bogus_message:" + JSON.stringify(grouped_with_bogus.error)
  );

  const with_coords = invoke_observe_reply(run_directory, executable, [
    "process-fds", "--pid", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(with_coords),
    "cu_linux_process_fds_usage_coords_ok:" + JSON.stringify(with_coords));
  ensure(
    text_at(with_coords, "error.code") === "usage",
    "cu_linux_process_fds_usage_coords_code:" + JSON.stringify(with_coords.error)
  );
  ensure(
    text_at(with_coords, "command") === "usage",
    "cu_linux_process_fds_usage_coords_command:" + JSON.stringify(with_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(with_coords, "error.message"), "--coords"),
    "cu_linux_process_fds_usage_coords_message:" + JSON.stringify(with_coords.error)
  );

  const grouped_with_coords = invoke_observe_reply(run_directory, executable, [
    "process", "fds", "--pid", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(grouped_with_coords),
    "cu_linux_process_fds_usage_grouped_coords_ok:" + JSON.stringify(grouped_with_coords));
  ensure(
    text_at(grouped_with_coords, "error.code") === "usage",
    "cu_linux_process_fds_usage_grouped_coords_code:" + JSON.stringify(grouped_with_coords.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_with_coords, "error.message"), "--coords"),
    "cu_linux_process_fds_usage_grouped_coords_message:" + JSON.stringify(grouped_with_coords.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_process_fds_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_process_fds_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_process_fds_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name),
    "cu_linux_process_fds_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_process_fds_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_process_fds_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_fds_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_process_fds_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_process_fds_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_process_fds_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_fds_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_process_fds_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_process_fds_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_process_fds_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_process_fds_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_process_fds_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_process_fds_extents_unavailable_code:" + code
  );
}

function verify_readback(run_directory, executable, pid, env) {
  const script = [
    "import json, os, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "max_visited = int(sys.argv[3])",
    "def classify(target_bytes):",
    "    if target_bytes.startswith(b'socket:['):",
    "        return 'socket'",
    "    if target_bytes.startswith(b'pipe:['):",
    "        return 'pipe'",
    "    if target_bytes.startswith(b'anon_inode:'):",
    "        return 'anonymous-inode'",
    "    if target_bytes.startswith(b'memfd:'):",
    "        return 'memory-file'",
    "    if target_bytes.startswith(b'/'):",
    "        return 'file'",
    "    return 'other'",
    "def target_fields(target_bytes):",
    "    try:",
    "        return {'encoding': 'utf8', 'text': target_bytes.decode('utf-8')}",
    "    except UnicodeDecodeError:",
    "        return {'encoding': 'hex', 'hex': target_bytes.hex()}",
    "def read_inventory():",
    "    directory = f'/proc/{pid}/fd'",
    "    descriptors = []",
    "    read_errors = 0",
    "    for entry in os.scandir(directory):",
    "        try:",
    "            descriptor = int(entry.name)",
    "        except ValueError:",
    "            continue",
    "        descriptors.append((descriptor, entry.path))",
    "        if len(descriptors) > max_visited:",
    "            break",
    "    descriptors.sort(key=lambda item: item[0])",
    "    truncated_scan = len(descriptors) > max_visited",
    "    descriptors = descriptors[:max_visited]",
    "    visited_count = len(descriptors)",
    "    items = []",
    "    for descriptor, path in descriptors:",
    "        try:",
    "            target_bytes = os.fsencode(os.readlink(path))",
    "        except OSError:",
    "            read_errors += 1",
    "            continue",
    "        row = {'fd': descriptor, 'type': classify(target_bytes)}",
    "        row.update(target_fields(target_bytes))",
    "        items.append(row)",
    "    return {",
    "        'visited_count': visited_count,",
    "        'read_errors': read_errors,",
    "        'truncated_scan': truncated_scan,",
    "        'descriptors': items,",
    "    }",
    "def compare_row(label, probe, cu):",
    "    if probe['fd'] != cu['fd']:",
    "        raise SystemExit(f'{label}:fd:probe={probe[\"fd\"]}:cu={cu[\"fd\"]}')",
    "    if probe['type'] != cu['type']:",
    "        raise SystemExit(f'{label}:type:probe={probe[\"type\"]}:cu={cu[\"type\"]}')",
    "    if probe['encoding'] != cu.get('target_encoding'):",
    "        raise SystemExit(f'{label}:encoding:probe={probe[\"encoding\"]}:cu={cu.get(\"target_encoding\")}')",
    "    if probe['encoding'] == 'utf8':",
    "        if probe['text'] != cu.get('target'):",
    "            raise SystemExit(f'{label}:target:probe={probe[\"text\"]}:cu={cu.get(\"target\")}')",
    "    else:",
    "        if probe['hex'] != cu.get('target_hex'):",
    "            raise SystemExit(f'{label}:target_hex:probe={probe[\"hex\"]}:cu={cu.get(\"target_hex\")}')",
    "before = read_inventory()",
    "out = subprocess.check_output(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-fds', '--pid', str(pid), '--limit', str(max_visited),",
    "     '--max-visited', str(max_visited)],",
    "    text=True)",
    "after = read_inventory()",
    "reply = json.loads(out)",
    "if not reply.get('ok') or reply.get('command') != 'process-fds':",
    "    raise SystemExit('cu_linux_process_fds_reply_state')",
    "data = reply['data']",
    "if data.get('verified') is not True:",
    "    raise SystemExit('cu_linux_process_fds_verified')",
    "if int(data['pid']) != pid:",
    "    raise SystemExit('cu_linux_process_fds_pid')",
    "if int(data['visited_count']) != before['visited_count']:",
    "    raise SystemExit('cu_linux_process_fds_visited_count')",
    "if int(data['read_errors']) != before['read_errors']:",
    "    raise SystemExit('cu_linux_process_fds_read_errors')",
    "if bool(data['truncated_scan']) != before['truncated_scan']:",
    "    raise SystemExit('cu_linux_process_fds_truncated_scan')",
    "if int(data['matched_count']) != len(before['descriptors']):",
    "    raise SystemExit('cu_linux_process_fds_matched_count')",
    "if int(data['returned_count']) != len(before['descriptors']):",
    "    raise SystemExit('cu_linux_process_fds_returned_count')",
    "cu_rows = data.get('descriptors') or []",
    "if len(cu_rows) != len(before['descriptors']):",
    "    raise SystemExit('cu_linux_process_fds_descriptor_count')",
    "for index, probe in enumerate(before['descriptors']):",
    "    compare_row(f'cu_linux_process_fds_row_{index}', probe, cu_rows[index])",
    "state = json.loads(subprocess.check_output(",
    "    [cu, '--target', 'current', '--grant', 'observe', 'process-state', '--pid', str(pid)],",
    "    text=True))",
    "if not state.get('ok') or state['data'].get('start_identity') != data.get('start_identity'):",
    "    raise SystemExit('cu_linux_process_fds_start_identity')",
    "if after['visited_count'] != before['visited_count']:",
    "    raise SystemExit('cu_linux_process_fds_inventory_changed')",
    "print('pid', pid)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, executable, "" + MAX_VISITED], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_process_fds_readback:" + output.stderr + output.stdout);
}

function verify_pid(run_directory, executable, pid, env) {
  verify_readback(run_directory, executable, pid, env);
}

function probe_fd_directory(pid) {
  const script = [
    "import json, os, sys",
    "pid = int(sys.argv[1])",
    "proc_path = f'/proc/{pid}'",
    "fd_path = f'{proc_path}/fd'",
    "exists = os.path.exists(proc_path)",
    "readable = False",
    "error_kind = None",
    "if exists:",
    "    try:",
    "        with os.scandir(fd_path):",
    "            readable = True",
    "    except OSError as error:",
    "        if error.errno == 13:",
    "            error_kind = 'PermissionDenied'",
    "        elif error.errno == 2:",
    "            error_kind = 'NotFound'",
    "        else:",
    "            error_kind = error.__class__.__name__",
    "print(json.dumps({",
    "    'pid': pid,",
    "    'exists': exists,",
    "    'readable': readable,",
    "    'error_kind': error_kind,",
    "    'fd_path': fd_path,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid], {
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_process_fds_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function find_denied_probe_pid() {
  const script = [
    "import json, os",
    "for candidate in (1,):",
    "    proc_path = f'/proc/{candidate}'",
    "    if not os.path.exists(proc_path):",
    "        continue",
    "    try:",
    "        with os.scandir(f'{proc_path}/fd'):",
    "            pass",
    "    except OSError as error:",
    "        if error.errno == 13:",
    "            print(json.dumps({'pid': candidate, 'denied': True}))",
    "            raise SystemExit",
    "print(json.dumps({'denied': False}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 10000,
  });
  ensure(output.success === true, "cu_linux_process_fds_denied_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function assert_permission_denied_host_limit(run_directory, executable, pid, env) {
  const script = [
    "import json, os, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "fd_path = f'/proc/{pid}/fd'",
    "try:",
    "    with os.scandir(fd_path):",
    "        raise SystemExit('cu_linux_process_fds_denied_probe_readable')",
    "except OSError as probe_error:",
    "    if probe_error.errno != 13:",
    "        raise SystemExit(f'cu_linux_process_fds_denied_probe_errno:{probe_error.errno}')",
    "proc = subprocess.run(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-fds', '--pid', str(pid), '--limit', '16', '--max-visited', '256'],",
    "    capture_output=True, text=True, timeout=30)",
    "if proc.returncode == 0:",
    "    raise SystemExit('cu_linux_process_fds_denied_ok:' + proc.stdout)",
    "reply = json.loads(proc.stdout)",
    "if reply.get('ok') is not False:",
    "    raise SystemExit('cu_linux_process_fds_denied_ok_state:' + proc.stdout)",
    "error = reply.get('error') or {}",
    "code = error.get('code') or ''",
    "if code != 'process_inspection_permission_denied':",
    "    raise SystemExit('cu_linux_process_fds_denied_code:' + code)",
    "detail = error.get('detail') or {}",
    "if detail.get('kind') != 'PermissionDenied':",
    "    raise SystemExit('cu_linux_process_fds_denied_kind:' + json.dumps(detail))",
    "if detail.get('subject') != 'file descriptors':",
    "    raise SystemExit('cu_linux_process_fds_denied_subject:' + json.dumps(detail))",
    "message = error.get('message') or ''",
    "if 'Permission denied' not in message and '/proc/' not in message:",
    "    raise SystemExit('cu_linux_process_fds_denied_message:' + message)",
    "print(json.dumps({'code': code, 'pid': pid, 'fd_path': fd_path}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + pid, executable], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true,
         "cu_linux_process_fds_permission_denied:" + output.stderr + output.stdout);
}

function verify_unavailable_when_probe_denied(run_directory, executable, probe, env) {
  const script = [
    "import json, subprocess, sys",
    "pid = int(sys.argv[1])",
    "cu = sys.argv[2]",
    "proc = subprocess.run(",
    "    [cu, '--target', 'current', '--grant', 'observe',",
    "     'process-fds', '--pid', str(pid), '--limit', '16', '--max-visited', '256'],",
    "    capture_output=True, text=True, timeout=30)",
    "if proc.returncode == 0:",
    "    raise SystemExit('cu_linux_process_fds_unavailable_ok:' + proc.stdout)",
    "reply = json.loads(proc.stdout)",
    "if reply.get('ok') is not False:",
    "    raise SystemExit('cu_linux_process_fds_unavailable_ok_state:' + proc.stdout)",
    "error = reply.get('error') or {}",
    "code = error.get('code') or ''",
    "if code != 'process_inspection_permission_denied':",
    "    raise SystemExit('cu_linux_process_fds_unavailable_code:' + code)",
    "detail = error.get('detail') or {}",
    "if detail.get('kind') != 'PermissionDenied':",
    "    raise SystemExit('cu_linux_process_fds_unavailable_kind:' + json.dumps(detail))",
    "message = error.get('message') or ''",
    "if 'Permission denied' not in message and '/proc/' not in message:",
    "    raise SystemExit('cu_linux_process_fds_unavailable_message:' + message)",
    "print(json.dumps({'code': code, 'pid': pid}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, "" + probe.pid, executable], {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.success === true,
         "cu_linux_process_fds_unavailable:" + output.stderr + output.stdout);
  ensure(probe.error_kind === "PermissionDenied",
         "cu_linux_process_fds_probe_not_denied:" + JSON.stringify(probe));
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-process-fds");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
const self_probe = probe_fd_directory(rh.pid());
const denied_probe = find_denied_probe_pid();
let succeeded = 0;
let failure = "";
try {
  print("STEP process-fds typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_process_fds_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before /proc/<pid>/fd inventory/read-back court");
  assert_get_extents_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before /proc/<pid>/fd inventory/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);

  if (atspi_available !== true) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; process-fds read-back still uses /proc/<pid>/fd");
  }

  if (!self_probe.readable) {
    print("STEP typed host-limit when independent /proc/<pid>/fd probe is unreadable or denied"
      + " (readable=" + self_probe.readable
      + " error_kind=" + self_probe.error_kind + ")");
    verify_unavailable_when_probe_denied(context.run_directory, executable, self_probe, env);
    succeeded = 1;
  } else {
    print("STEP process-fds observe matches independent /proc/<pid>/fd read-back for self");
    verify_pid(context.run_directory, executable, rh.pid(), env);

    print("STEP spawn disposable child and verify --pid read-back");
    const child = harness.start({
      program: "sleep",
      args: ["300"],
      current_dir: context.run_directory,
      env: { AGENTERM_NO_ACTIVATE: "1" },
      timeout_ms: 60000,
    });
    verify_pid(context.run_directory, executable, harness.spawned_pid(child), env);
    harness.kill(child);

    if (denied_probe.denied === true) {
      print("STEP process-fds typed-fails permission-denied host-limit when independent"
        + " /proc/" + denied_probe.pid + "/fd probe is denied");
      assert_permission_denied_host_limit(
        context.run_directory, executable, denied_probe.pid, env);
    } else {
      print("STEP skip permission-denied host-limit: no independent denied /proc/<pid>/fd probe on this host");
    }

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-process-fds-readback");
  harness.remove_run(context);
  if (self_probe.readable) {
    if (atspi_available) {
      print("PASS: Linux process-fds matches independent /proc/<pid>/fd read-back with typed process-fds --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
    } else {
      print("PASS: Linux process-fds matches independent /proc/<pid>/fd read-back with typed process-fds --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
    }
  } else {
    if (atspi_available) {
      print("PASS: Linux process-fds typed-fails when independent /proc/<pid>/fd is unreadable or denied with typed process-fds --name/--coords/--bogus and get-extents --name usage/host-limit honesty (AT-SPI --name, no --coords)");
    } else {
      print("PASS: Linux process-fds typed-fails when independent /proc/<pid>/fd is unreadable or denied with typed process-fds --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
    }
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
