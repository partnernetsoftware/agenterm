// CEO: Linux network-interfaces observe with independent ip + sysfs read-back.
// Acceptance is smoke read-back only: CU rows must agree with facts parsed outside
// agenterm-cu from `ip -j addr show` and /sys/class/net ifindex/IFF_UP. When the
// independent iface probe is unavailable, verify typed network_interfaces_unavailable
// when native enumeration fails. Typed network-interfaces usage must reject AT-SPI
// --name and other unexpected arguments; typed get-extents --name usage/host-limit
// paths must hold before the ip/sysfs read-back court. AT-SPI/--name only; no
// --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-network-interfaces-ip-sysfs",
];

const IFF_UP = 1;
const MAX_ROWS = 5000;
const AT_SPI_PROBE_NAME = "Network Interfaces Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function output_success(document) { return at(document, "ok") === true; }

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_observe_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
         "cu_linux_network_interfaces_observe_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "network-interfaces" || text_at(reply, "command") === "usage",
    "cu_linux_network_interfaces_observe_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
         "cu_linux_network_interfaces_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_network_interfaces_usage_limit(run_directory, executable, env) {
  const flat_with_name = invoke_observe_reply(run_directory, executable, [
    "network-interfaces", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(flat_with_name),
    "cu_linux_network_interfaces_usage_flat_name_ok:" + JSON.stringify(flat_with_name));
  ensure(
    text_at(flat_with_name, "error.code") === "usage",
    "cu_linux_network_interfaces_usage_flat_name_code:" + JSON.stringify(flat_with_name.error)
  );
  ensure(
    text_at(flat_with_name, "command") === "usage",
    "cu_linux_network_interfaces_usage_flat_name_command:" + JSON.stringify(flat_with_name)
  );
  ensure(
    text_at(flat_with_name, "error.message").indexOf("--name") >= 0
      || text_at(flat_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_network_interfaces_usage_flat_name_message:" + JSON.stringify(flat_with_name.error)
  );

  const grouped_with_name = invoke_observe_reply(run_directory, executable, [
    "network", "interfaces", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(grouped_with_name),
    "cu_linux_network_interfaces_usage_grouped_name_ok:" + JSON.stringify(grouped_with_name));
  ensure(
    text_at(grouped_with_name, "error.code") === "usage",
    "cu_linux_network_interfaces_usage_grouped_name_code:" + JSON.stringify(grouped_with_name.error)
  );
  ensure(
    text_at(grouped_with_name, "error.message").indexOf("--name") >= 0
      || text_at(grouped_with_name, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_network_interfaces_usage_grouped_name_message:" + JSON.stringify(grouped_with_name.error)
  );

  const with_bogus = invoke_observe_reply(run_directory, executable, [
    "network-interfaces", "--bogus",
  ], env);
  ensure(!output_success(with_bogus),
    "cu_linux_network_interfaces_usage_bogus_ok:" + JSON.stringify(with_bogus));
  ensure(
    text_at(with_bogus, "error.code") === "usage",
    "cu_linux_network_interfaces_usage_bogus_code:" + JSON.stringify(with_bogus.error)
  );
  ensure(
    text_at(with_bogus, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_network_interfaces_usage_bogus_message:" + JSON.stringify(with_bogus.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle),
    "cu_linux_network_interfaces_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_network_interfaces_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_network_interfaces_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply),
    "cu_linux_network_interfaces_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_network_interfaces_extents_unavailable_code:" + code
  );
}

function text_at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function flag_at(value, dotted) {
  const text = text_at(value, dotted);
  if (text === "true") { return true; }
  if (text === "false") { return false; }
  return value[dotted.split(".").pop()];
}

function split_whitespace(text) {
  const parts = [];
  let current = "";
  for (let index = 0; index < text.length; index = index + 1) {
    const code = text.charCodeAt(index);
    if (code === 9 || code === 10 || code === 13 || code === 32) {
      if (current.length > 0) {
        parts.push(current);
        current = "";
      }
    } else {
      current = current + text.charAt(index);
    }
  }
  if (current.length > 0) { parts.push(current); }
  return parts;
}

function parse_hex(value) {
  let start = 0;
  if (value.length >= 2 && value.charAt(0) === "0"
      && (value.charAt(1) === "x" || value.charAt(1) === "X")) {
    start = 2;
  }
  let result = 0;
  for (let index = start; index < value.length; index = index + 1) {
    const code = value.charCodeAt(index);
    let digit = -1;
    if (code >= 48 && code <= 57) { digit = code - 48; }
    else if (code >= 97 && code <= 102) { digit = code - 87; }
    else if (code >= 65 && code <= 70) { digit = code - 55; }
    else { return -1; }
    result = result * 16 + digit;
  }
  return result;
}

function normalize_mac(value) {
  return ("" + value).toLowerCase();
}

function flags_include_loopback(flags) {
  if (!Array.isArray(flags)) { return false; }
  for (let index = 0; index < flags.length; index = index + 1) {
    if (flags[index] === "LOOPBACK") { return true; }
  }
  return false;
}

function invoke(run_directory, executable, arguments, expect_success) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 30000,
  });
  ensure(output.success === expect_success, "cu_linux_network_interfaces_exit:" + output.exit_code);
  const reply = JSON.parse(output.stdout.trim());
  ensure(reply.ok === expect_success, "cu_linux_network_interfaces_reply_state");
  return reply;
}

function normalize_address(family, address) {
  if (family !== "IPv6") { return address; }
  const output = rh.command("ip", ["-6", "addr", "show", "to", address], {
    timeout_ms: 10000,
  });
  if (!output.success) { return address.toLowerCase(); }
  const lines = output.stdout.split("\n");
  for (let index = 0; index < lines.length; index = index + 1) {
    const line = lines[index].trim();
    if (line.indexOf("inet6 ") === 0) {
      const parts = split_whitespace(line);
      if (parts.length >= 2) {
        const slash = parts[1].indexOf("/");
        const candidate = slash < 0 ? parts[1] : parts[1].slice(0, slash);
        if (candidate !== "") { return candidate.toLowerCase(); }
      }
    }
  }
  return address.toLowerCase();
}

function probe_iface_sources() {
  const script = [
    "import json, os, subprocess",
    "readable = False",
    "address_rows = 0",
    "sysfs_ok = False",
    "try:",
    "    out = subprocess.check_output(['ip', '-j', 'addr', 'show'], text=True, timeout=15)",
    "    document = json.loads(out)",
    "    if isinstance(document, list):",
    "        readable = True",
    "        for iface in document:",
    "            addrinfo = iface.get('addr_info') or []",
    "            for addr in addrinfo:",
    "                if addr.get('local'):",
    "                    address_rows += 1",
    "except Exception:",
    "    readable = False",
    "if os.path.isdir('/sys/class/net'):",
    "    for entry in os.scandir('/sys/class/net'):",
    "        flags_path = os.path.join(entry.path, 'flags')",
    "        index_path = os.path.join(entry.path, 'ifindex')",
    "        if os.path.isfile(flags_path) and os.path.isfile(index_path):",
    "            sysfs_ok = True",
    "            break",
    "print(json.dumps({",
    "    'readable': readable,",
    "    'address_rows': address_rows,",
    "    'sysfs_ok': sysfs_ok,",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 20000,
  });
  ensure(output.success === true,
         "cu_linux_network_interfaces_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function independent_ip_rows() {
  const output = rh.command("ip", ["-j", "addr", "show"], { timeout_ms: 15000 });
  ensure(output.success === true, "ip_addr_show_failed:" + output.stderr);
  const document = JSON.parse(output.stdout.trim());
  ensure(Array.isArray(document), "ip_addr_show_shape");
  const rows = [];
  for (let index = 0; index < document.length; index = index + 1) {
    const iface = document[index];
    const name = "" + iface.ifname;
    const ifindex = Number(iface.ifindex);
    ensure(name !== "" && ifindex > 0, "ip_addr_iface_shape:" + JSON.stringify(iface));
    const flags = iface.flags;
    const link_mac = iface.address === undefined ? "" : normalize_mac("" + iface.address);
    const internal = flags_include_loopback(flags) || name === "lo";
    const addrinfo = iface.addr_info;
    if (!Array.isArray(addrinfo)) { continue; }
    for (let addr_index = 0; addr_index < addrinfo.length; addr_index = addr_index + 1) {
      const addr = addrinfo[addr_index];
      const family = addr.family === "inet" ? "IPv4" : (addr.family === "inet6" ? "IPv6" : "");
      if (family === "" || addr.local === undefined) { continue; }
      const prefixlen = addr.prefixlen === undefined ? null : Number(addr.prefixlen);
      let scope_id = null;
      if (family === "IPv6" && addr.scope === "link") {
        scope_id = ifindex;
      }
      rows.push({
        name: name,
        family: family,
        address: normalize_address(family, "" + addr.local),
        ifindex: ifindex,
        cidr: prefixlen,
        internal: internal,
        mac: link_mac,
        scope_id: scope_id,
      });
    }
  }
  return rows;
}

function sysfs_text(path) {
  if (!rh.exists(path)) { return ""; }
  return rh.read_text(path).trim();
}

function sysfs_ifindex(name) {
  const text = sysfs_text("/sys/class/net/" + name + "/ifindex");
  if (text === "") { return 0; }
  const value = Number(text);
  ensure(value > 0, "sysfs_ifindex_shape:" + name + ":" + text);
  return value;
}

function sysfs_iff_up(name) {
  const text = sysfs_text("/sys/class/net/" + name + "/flags");
  if (text === "") { return null; }
  const flags = parse_hex(text);
  ensure(flags >= 0, "sysfs_flags_shape:" + name + ":" + text);
  return (flags & IFF_UP) !== 0;
}

function address_key(name, family, address) {
  return name + "\0" + family + "\0" + normalize_address(family, address);
}

function find_ip_row(rows, name, family, address) {
  const key = address_key(name, family, address);
  for (let index = 0; index < rows.length; index = index + 1) {
    const row = rows[index];
    if (address_key(row.name, row.family, row.address) === key) {
      return row;
    }
  }
  return null;
}

function find_cu_row(rows, name, family, address) {
  const key = address_key(name, family, address);
  for (let index = 0; index < rows.length; index = index + 1) {
    const row = rows[index];
    if (address_key(text_at(row, "name"), text_at(row, "family"), text_at(row, "address")) === key) {
      return row;
    }
  }
  return null;
}

function assert_getifaddrs_host_limit(run_directory, executable) {
  const script = [
    "import json, os, subprocess, sys, tempfile, textwrap",
    "cu = sys.argv[1]",
    "run_dir = sys.argv[2]",
    "hook = textwrap.dedent('''",
    "#define _GNU_SOURCE",
    "#include <errno.h>",
    "int getifaddrs(void **ifap) {",
    "    errno = ENOSYS;",
    "    return -1;",
    "}",
    "''')",
    "with tempfile.TemporaryDirectory() as td:",
    "    src = os.path.join(td, 'hook.c')",
    "    so = os.path.join(td, 'hook.so')",
    "    with open(src, 'w') as handle:",
    "        handle.write(hook)",
    "    subprocess.check_call(['gcc', '-shared', '-fPIC', '-o', so, src])",
    "    env = os.environ.copy()",
    "    env['LD_PRELOAD'] = so",
    "    env['AGENTERM_NO_ACTIVATE'] = '1'",
    "    proc = subprocess.run(",
    "        [cu, '--target', 'current', '--grant', 'observe',",
    "         'network-interfaces', '--max', '1'],",
    "        cwd=run_dir, capture_output=True, text=True, timeout=30, env=env)",
    "    if proc.returncode == 0:",
    "        raise SystemExit('cu_linux_network_interfaces_getifaddrs_ok:' + proc.stdout)",
    "    reply = json.loads(proc.stdout)",
    "    if reply.get('ok') is not False:",
    "        raise SystemExit('cu_linux_network_interfaces_getifaddrs_ok_state:' + proc.stdout)",
    "    error = reply.get('error') or {}",
    "    code = error.get('code') or ''",
    "    if code != 'network_interfaces_unavailable':",
    "        raise SystemExit('cu_linux_network_interfaces_getifaddrs_code:' + code)",
    "    message = error.get('message') or ''",
    "    if message == '':",
    "        raise SystemExit('cu_linux_network_interfaces_getifaddrs_message_empty')",
    "    print(json.dumps({'code': code}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, executable, run_directory], {
    timeout_ms: 45000,
  });
  ensure(output.success === true,
         "cu_linux_network_interfaces_getifaddrs:" + output.stderr + output.stdout);
  const probe = JSON.parse(output.stdout.trim());
  ensure(probe.code === "network_interfaces_unavailable",
         "cu_linux_network_interfaces_getifaddrs_code:" + JSON.stringify(probe));
}

function verify_unavailable_when_probe_absent(run_directory, executable, probe) {
  assert_getifaddrs_host_limit(run_directory, executable);
  if (probe.readable === true && probe.address_rows === 0) {
    const reply = invoke(run_directory, executable, [
      "network-interfaces", "--max", "" + MAX_ROWS
    ], true);
    ensure(Number(text_at(reply, "data.returned")) === 0,
           "cu_linux_network_interfaces_empty_mismatch:" + JSON.stringify(reply.data));
    ensure(text_at(reply, "data.provider") === "getifaddrs",
           "cu_linux_network_interfaces_empty_provider:" + JSON.stringify(reply.data));
  }
}

function assert_row_readback(row, ip_row) {
  const name = text_at(row, "name");
  const family = text_at(row, "family");
  const address = text_at(row, "address");
  const native_id = text_at(row, "native_id");
  const up = flag_at(row, "up");
  ensure(name !== "" && (family === "IPv4" || family === "IPv6") && address !== "",
         "cu_linux_network_interfaces_row_schema:" + JSON.stringify(row));
  ensure(text_at(row, "native_id_kind") === "ifindex",
         "cu_linux_network_interfaces_native_kind:" + name);

  const sysfs_index = sysfs_ifindex(name);
  ensure("" + ip_row.ifindex === native_id,
         "cu_linux_network_interfaces_ifindex_mismatch:cu=" + native_id + ":ip=" + ip_row.ifindex);
  ensure("" + sysfs_index === native_id,
         "cu_linux_network_interfaces_sysfs_ifindex_mismatch:cu=" + native_id + ":sysfs=" + sysfs_index);

  const sysfs_up = sysfs_iff_up(name);
  ensure(sysfs_up !== null,
         "cu_linux_network_interfaces_sysfs_flags_missing:" + name);
  ensure(up === sysfs_up,
         "cu_linux_network_interfaces_up_mismatch:" + JSON.stringify({
           name: name, cu: up, sysfs: sysfs_up
         }));

  if (ip_row.cidr !== null) {
    ensure(Number(text_at(row, "cidr")) === ip_row.cidr,
           "cu_linux_network_interfaces_cidr_mismatch:" + JSON.stringify({
             name: name, family: family, address: address,
             cu: text_at(row, "cidr"), ip: ip_row.cidr
           }));
  }
  ensure(flag_at(row, "internal") === ip_row.internal,
         "cu_linux_network_interfaces_internal_mismatch:" + JSON.stringify({
           name: name, cu: flag_at(row, "internal"), ip: ip_row.internal
         }));
  if (ip_row.mac !== "" && ip_row.mac !== "00:00:00:00:00:00") {
    ensure(normalize_mac(text_at(row, "mac")) === ip_row.mac,
           "cu_linux_network_interfaces_mac_mismatch:" + JSON.stringify({
             name: name, cu: text_at(row, "mac"), ip: ip_row.mac
           }));
  }
  if (ip_row.scope_id !== null) {
    const scope_text = text_at(row, "scopeid");
    ensure(scope_text !== "" && Number(scope_text) === ip_row.scope_id,
           "cu_linux_network_interfaces_scope_mismatch:" + JSON.stringify({
             name: name, cu: scope_text, ip: ip_row.scope_id
           }));
  }
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-network-interfaces");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
const host_sources = probe_iface_sources();
let succeeded = 0;
let failure = "";
try {
  print("STEP network-interfaces typed-fails usage when AT-SPI --name or other unexpected arguments are present");
  assert_network_interfaces_usage_limit(context.run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before ip/sysfs read-back");
    assert_get_extents_usage_limit(context.run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);
  }

  if (!host_sources.readable || !host_sources.sysfs_ok || host_sources.address_rows === 0) {
    print("STEP typed host-limit when independent ip/sysfs iface probe is unavailable or empty"
      + " (readable=" + host_sources.readable
      + " sysfs_ok=" + host_sources.sysfs_ok
      + " address_rows=" + host_sources.address_rows + ")");
    verify_unavailable_when_probe_absent(context.run_directory, executable, host_sources);
    succeeded = 1;
  } else {
    print("STEP network-interfaces typed-fails when getifaddrs is unavailable in an isolated preload hook");
    assert_getifaddrs_host_limit(context.run_directory, executable);

    print("STEP independent ip -j addr show captures a non-empty address inventory");
    const ip_rows = independent_ip_rows();
    ensure(ip_rows.length > 0, "cu_linux_network_interfaces_ip_empty");

    print("STEP network-interfaces observe returns a complete bounded inventory");
    const reply = invoke(context.run_directory, executable, [
      "network-interfaces", "--max", "" + MAX_ROWS
    ], true);
    ensure(reply.command === "network-interfaces" && reply.target === "current",
           "cu_linux_network_interfaces_identity");
    const data = reply.data;
    const interfaces = data.interfaces;
    ensure(Array.isArray(interfaces) && interfaces.length > 0,
           "cu_linux_network_interfaces_empty");
    ensure(data.returned === interfaces.length && data.returned <= MAX_ROWS,
           "cu_linux_network_interfaces_counts");
    ensure(data.returned === ip_rows.length,
           "cu_linux_network_interfaces_ip_count_mismatch:cu=" + data.returned
             + ":ip=" + ip_rows.length);
    ensure(text_at(data, "provider") === "getifaddrs",
           "cu_linux_network_interfaces_provider:" + JSON.stringify(data));
    ensure(Number(text_at(data, "read_errors")) === 0,
           "cu_linux_network_interfaces_read_errors:" + JSON.stringify(data));
    ensure(flag_at(data, "truncated") === false && flag_at(data, "truncated_scan") === false,
           "cu_linux_network_interfaces_truncated:" + JSON.stringify(data));

    print("STEP each CU row matches independent ip/sysfs name, address, ifindex, IFF_UP, cidr, internal and mac");
    for (let index = 0; index < interfaces.length; index = index + 1) {
      const row = interfaces[index];
      const name = text_at(row, "name");
      const family = text_at(row, "family");
      const address = text_at(row, "address");
      const ip_row = find_ip_row(ip_rows, name, family, address);
      ensure(ip_row !== null,
             "cu_linux_network_interfaces_ip_missing:" + JSON.stringify({
               name: name, family: family, address: address
             }));
      assert_row_readback(row, ip_row);
    }

    print("STEP every independent ip address row appears in the CU inventory");
    for (let index = 0; index < ip_rows.length; index = index + 1) {
      const ip_row = ip_rows[index];
      ensure(find_cu_row(interfaces, ip_row.name, ip_row.family, ip_row.address) !== null,
             "cu_linux_network_interfaces_cu_missing:" + JSON.stringify(ip_row));
    }

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-network-interfaces-ip-sysfs");
  harness.remove_run(context);
  if (host_sources.readable && host_sources.sysfs_ok && host_sources.address_rows > 0) {
    if (atspi_available) {
      print("PASS: CEO Linux network-interfaces with independent ip and sysfs read-back, getifaddrs host-limit honesty, and typed network-interfaces/get-extents usage honesty (AT-SPI --name, no --coords)");
    } else {
      print("PASS: CEO Linux network-interfaces with independent ip and sysfs read-back, getifaddrs host-limit honesty, and typed network-interfaces/get-extents host-limit honesty (AT-SPI --name, no --coords)");
    }
  } else {
    if (atspi_available) {
      print("PASS: CEO Linux network-interfaces typed host-limit when independent ip/sysfs iface probe is unavailable or empty with typed network-interfaces/get-extents usage honesty (AT-SPI --name, no --coords)");
    } else {
      print("PASS: CEO Linux network-interfaces typed host-limit when independent ip/sysfs iface probe is unavailable or empty with typed network-interfaces/get-extents host-limit honesty (AT-SPI --name, no --coords)");
    }
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
