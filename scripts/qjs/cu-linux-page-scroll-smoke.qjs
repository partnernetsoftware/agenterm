// CEO: Linux CDP page-scroll honesty — wheel scroll on a disposable container.
// Acceptance is smoke read-back only: independent page-js scrollTop and wheel
// effect must increase after page-scroll --dy; distinct from AT-SPI scroll-to /
// scroll-wheel. Typed usage, miss, and no-CDP host-limit paths must hold.
// --port/--target-id only; no --coords.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-cdp-page-scroll-actuate",
  "cu.linux-cdp-page-scroll-readback",
];

const scroll_readback_expr = "(function(){"
  + "const el=document.getElementById('scroll');"
  + "if(!el){return{missing:true};}"
  + "return{"
  + "scrollTop:el.scrollTop,"
  + "wheelEvents:window.__ceoWheelCount||0,"
  + "scrollHeight:el.scrollHeight,"
  + "clientHeight:el.clientHeight"
  + "};})()";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function number_at(value, dotted) {
  const raw = text_at(value, dotted);
  if (raw === "") { return 0; }
  return rh.parse_int(raw);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function output_success(document) { return flag_at(document, "ok"); }

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  const lines = output.stdout.split("\n");
  let json_line = "";
  for (let index = lines.length - 1; index >= 0; index = index - 1) {
    const line = lines[index].trim();
    if (line.charAt(0) === "{") {
      json_line = line;
      break;
    }
  }
  ensure(json_line !== "", "cu_linux_page_scroll_cli:" + output.stdout + output.stderr);
  return JSON.parse(json_line);
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const document = run_cu_reply(run_directory, executable, grant, arguments, env);
  ensure(output_success(document), "cu_linux_page_scroll_reply:" + JSON.stringify(document));
  return document;
}

function assert_x11_display_usable(run_directory, env) {
  const output = rh.command("xdpyinfo", [], {
    cwd: run_directory,
    env: env,
    timeout_ms: 5000,
  });
  if (output.success === true) { return; }
  const text = output.stdout + output.stderr;
  ensure(
    text.indexOf("Maximum number of clients reached") < 0
      && text.indexOf("unable to open display") < 0,
    "cu_linux_page_scroll_host_limit:x11_display_unavailable:" + text.trim()
  );
  ensure(false, "cu_linux_page_scroll_host_limit:xdpyinfo:" + text.trim());
}

function assert_no_cdp_listener(run_directory, executable, env, port) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "page-targets", "--port", "" + port,
  ], env);
  ensure(reply.ok !== true, "cu_linux_page_scroll_false_success:" + JSON.stringify(reply));
  ensure(text_at(reply, "error.code") === "unsupported",
    "cu_linux_page_scroll_host_limit_code:" + JSON.stringify(reply));
  const message = text_at(reply, "error.message");
  ensure(
    message.indexOf("no CDP listener") >= 0 && message.indexOf("" + port) >= 0,
    "cu_linux_page_scroll_host_limit_message:" + JSON.stringify(reply.error)
  );
}

function assert_scroll_usage(run_directory, executable, env, port) {
  const missing_xy = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-scroll", "--port", "" + port, "--target-id", "unused",
    "--dy", "120",
  ], env);
  ensure(!output_success(missing_xy), "cu_linux_page_scroll_usage_ok_xy:" + JSON.stringify(missing_xy));
  ensure(
    text_at(missing_xy, "error.code") === "usage",
    "cu_linux_page_scroll_usage_code_xy:" + JSON.stringify(missing_xy.error)
  );
  ensure(
    text_at(missing_xy, "error.message").indexOf("--x") >= 0
      && text_at(missing_xy, "error.message").indexOf("--y") >= 0,
    "cu_linux_page_scroll_usage_message_xy:" + JSON.stringify(missing_xy.error)
  );

  const zero_delta = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-scroll", "--port", "" + port, "--target-id", "unused",
    "--x", "10", "--y", "10", "--dx", "0", "--dy", "0",
  ], env);
  ensure(!output_success(zero_delta), "cu_linux_page_scroll_usage_ok_delta:" + JSON.stringify(zero_delta));
  ensure(
    text_at(zero_delta, "error.code") === "usage",
    "cu_linux_page_scroll_usage_code_delta:" + JSON.stringify(zero_delta.error)
  );
  ensure(
    text_at(zero_delta, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_page_scroll_usage_message_delta:" + JSON.stringify(zero_delta.error)
  );
}

function assert_scroll_miss_bad_target(run_directory, executable, env, port) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "page-scroll", "--port", "" + port, "--target-id", "deadbeef",
    "--x", "10", "--y", "10", "--dy", "120",
  ], env);
  ensure(!output_success(reply), "cu_linux_page_scroll_miss_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "cdp_target_not_found",
    "cu_linux_page_scroll_miss_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("--target-id") >= 0,
    "cu_linux_page_scroll_miss_message:" + JSON.stringify(reply.error)
  );
}

function page_target(rows) {
  for (const row of rows) {
    if (text_at(row, "type") === "page") { return row; }
  }
  return null;
}

function scroll_readback(run_directory, executable, env, port, target_id) {
  const read = run_cu(run_directory, executable, "observe", [
    "page-js", "--port", "" + port, "--target-id", target_id,
    "--expression", scroll_readback_expr,
  ], env);
  return at(read, "data.value");
}

function cdp_ready(run_directory, port) {
  const probe = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  return probe.success === true && probe.stdout.indexOf("Browser") >= 0;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "cu_linux_page_scroll_executable_missing:" + executable);
ensure(direct_file(abi_library), "cu_linux_page_scroll_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-page-scroll");
const run_directory = context.run_directory;
const env = cu_env(executable);

const fixture_title = "CEO CDP Scroll " + context.run_id;
const fixture = rh.join(run_directory, "cdp-scroll.html");
const fixture_html = "<!DOCTYPE html><html><head><title>"
  + fixture_title + "</title></head><body>"
  + "<div id='scroll' style='height:120px;overflow:auto'>"
  + "<div style='height:1000px'>Tall</div></div>"
  + "<script>"
  + "window.__ceoWheelCount=0;"
  + "document.getElementById('scroll').addEventListener('wheel',function(){window.__ceoWheelCount++;},{passive:true});"
  + "</script>"
  + "</body></html>";
rh.write_text(fixture, fixture_html);

const profile = rh.join(run_directory, "chrome-profile-" + context.run_id);
const launcher = rh.join(repo, "scripts/box-chrome-a11y.sh");
const port = 9500 + (rh.pid() % 400);
let chrome_child = -1;
let succeeded = 0;
let failure = "";

try {
  print("STEP verify the configured X11 display is usable before owning Chrome");
  assert_x11_display_usable(run_directory, env);

  const stale = rh.command("curl", ["-s", "--max-time", "1", "http://127.0.0.1:" + port + "/json/version"], {
    cwd: run_directory,
    timeout_ms: 3000,
  });
  ensure(!(stale.success === true && stale.stdout.indexOf("Browser") >= 0),
    "cu_linux_page_scroll_port_in_use:" + port);

  print("STEP page-scroll typed-fails usage when --x/--y or wheel delta are missing");
  assert_scroll_usage(run_directory, executable, env, port);

  print("STEP page-targets --port typed-fails no CDP listener on the owned free port before Chrome starts");
  assert_no_cdp_listener(run_directory, executable, env, port);

  print("STEP launch owned Chrome with CDP port and a disposable file:// tab");
  chrome_child = harness.start({
    program: launcher,
    args: [
      "--user-data-dir=" + profile,
      "--remote-debugging-port=" + port,
      "--remote-debugging-address=127.0.0.1",
      "--new-window",
      "about:blank",
    ],
    current_dir: run_directory,
    env: env,
    timeout_ms: 45000,
  });
  for (let attempt = 0; attempt < 80 && !cdp_ready(run_directory, port); attempt = attempt + 1) {
    harness.sleep_ms(250);
  }
  ensure(cdp_ready(run_directory, port), "cu_linux_page_scroll_cdp_not_ready:" + port);

  print("STEP page-scroll typed-fails cdp_target_not_found for a bogus --target-id");
  assert_scroll_miss_bad_target(run_directory, executable, env, port);

  const targets = run_cu(run_directory, executable, "observe", [
    "page-targets", "--port", "" + port,
  ], env);
  const target = page_target(targets.data.targets);
  ensure(target !== null && text_at(target, "id") !== "", "cu_linux_page_scroll_target_missing");
  const target_id = text_at(target, "id");

  print("STEP page-nav loads the disposable scroll fixture in this owned tab");
  const nav_url = "file://" + fixture;
  const nav = run_cu(run_directory, executable, "observe,actuate", [
    "page-nav", "--port", "" + port, "--target-id", target_id,
    "--url", nav_url, "--wait-ms", "10000",
  ], env);
  ensure(
    flag_at(nav, "data.verified") && text_at(nav, "data.final_title") === fixture_title,
    "cu_linux_page_scroll_nav:" + JSON.stringify(nav.data)
  );

  print("STEP independent page-js records scrollTop and wheel baseline before actuation");
  const before = scroll_readback(run_directory, executable, env, port, target_id);
  ensure(
    flag_at(before, "missing") !== true
      && number_at(before, "scrollTop") === 0
      && number_at(before, "wheelEvents") === 0
      && number_at(before, "scrollHeight") > number_at(before, "clientHeight"),
    "cu_linux_page_scroll_before:" + JSON.stringify(before)
  );

  print("STEP page-find #scroll locates the scrollable container center");
  const found = run_cu(run_directory, executable, "observe", [
    "page-find", "--port", "" + port, "--target-id", target_id, "--selector", "#scroll",
  ], env);
  const found_nodes = at(found, "data.nodes");
  ensure(
    at(found, "data.returned") === 1
      && found_nodes !== undefined
      && found_nodes.length === 1,
    "cu_linux_page_scroll_find_container:" + JSON.stringify(found.data)
  );
  const box = found_nodes[0].box;
  const x = box.x + box.width / 2;
  const y = box.y + box.height / 2;

  print("STEP page-scroll --dy 120 wheels at the container center");
  const scrolled = run_cu(run_directory, executable, "observe,actuate", [
    "page-scroll", "--port", "" + port, "--target-id", target_id,
    "--x", "" + x, "--y", "" + y, "--dy", "120",
  ], env);
  ensure(
    flag_at(scrolled, "data.performed") && flag_at(scrolled, "data.verified"),
    "cu_linux_page_scroll_actuate:" + JSON.stringify(scrolled.data)
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-cdp-page-scroll-actuate");

  print("STEP independent page-js read-back proves scrollTop and wheel effect increased");
  const after = scroll_readback(run_directory, executable, env, port, target_id);
  ensure(
    number_at(after, "scrollTop") > number_at(before, "scrollTop")
      && number_at(after, "wheelEvents") > number_at(before, "wheelEvents"),
    "cu_linux_page_scroll_readback:" + JSON.stringify({ before: before, after: after })
  );
  harness.emit_evidence(context, declared_evidence, "cu.linux-cdp-page-scroll-readback");

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (chrome_child >= 0) {
  try { harness.kill(chrome_child); } catch (error) { print("cleanup: " + error); }
}

ensure(succeeded === 1, failure || "cu_linux_page_scroll_failed");
harness.remove_run(context);
print("PASS: Linux CDP page-scroll with usage/miss/host-limit paths and independent scrollTop/wheel read-back (no --coords)");
return;
