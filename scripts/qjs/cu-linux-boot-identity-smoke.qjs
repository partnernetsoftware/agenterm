// CEO: Linux host boot identity honesty via capabilities with independent read-back.
// Acceptance is smoke read-back only: boot_id, machine_id and uptime_milliseconds
// must match facts derived outside agenterm-cu, or return typed unavailable when
// either host source is absent. Typed capabilities usage must reject AT-SPI --name,
// --coords, --bogus, and other unexpected arguments; typed get-extents --name usage
// AND host-limit paths must both hold before the boot-identity inventory/read-back
// court. Host-limit clarity when boot-identity fields are absent. Prefer honesty
// over fake success. AT-SPI/--name only; no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-boot-identity-readback",
];

const AT_SPI_PROBE_NAME = "Boot Identity Court Anchor";
const BOOT_ID_PATH = "/proc/sys/kernel/random/boot_id";
const MACHINE_ID_PATH = "/etc/machine-id";
const UPTIME_SLACK_MS = 15000;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function invoke_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_boot_identity_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  ensure(
    text_at(reply, "command") === "capabilities" || text_at(reply, "command") === "usage",
    "cu_linux_boot_identity_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke(run_directory, executable, arguments, env) {
  const reply = invoke_reply(run_directory, executable, arguments, env);
  ensure(rh.output_success(reply), "cu_linux_boot_identity_exit:" + JSON.stringify(reply));
  ensure(text_at(reply, "command") === "capabilities", "cu_linux_boot_identity_command:" + JSON.stringify(reply));
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "", "cu_linux_boot_identity_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_capabilities_unexpected(run_directory, executable, env, arguments, label, token) {
  const reply = invoke_reply(run_directory, executable, arguments, env);
  ensure(!rh.output_success(reply),
    "cu_linux_boot_identity_usage_" + label + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_boot_identity_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_boot_identity_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  ensure(
    usage_rejects_unexpected(text_at(reply, "error.message"), token)
      || text_at(reply, "error.message").indexOf("no arguments") >= 0,
    "cu_linux_boot_identity_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_capabilities_usage_limit(run_directory, executable, env) {
  assert_capabilities_unexpected(run_directory, executable, env, [
    "capabilities", "--name", AT_SPI_PROBE_NAME,
  ], "name", "--name");
  assert_capabilities_unexpected(run_directory, executable, env, [
    "capabilities", "--bogus",
  ], "bogus", "--bogus");
  assert_capabilities_unexpected(run_directory, executable, env, [
    "capabilities", "--coords", "10,10",
  ], "coords", "--coords");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_boot_identity_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_boot_identity_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_boot_identity_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_boot_identity_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_boot_identity_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_boot_identity_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_boot_identity_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_boot_identity_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_boot_identity_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_boot_identity_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_boot_identity_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_boot_identity_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_boot_identity_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_boot_identity_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_boot_identity_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply), "cu_linux_boot_identity_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_boot_identity_extents_unavailable_code:" + code
  );
}

function boot_id_shape(value) {
  if (value.length !== 36) { return false; }
  for (let index = 0; index < value.length; index = index + 1) {
    const code = value.charCodeAt(index);
    if (index === 8 || index === 13 || index === 18 || index === 23) {
      if (code !== 45) { return false; }
    } else if (code < 48 || (code > 57 && code < 65) || (code > 70 && code < 97) || code > 102) {
      return false;
    }
  }
  return true;
}

function machine_id_shape(value) {
  if (value.length !== 32) { return false; }
  for (let index = 0; index < value.length; index = index + 1) {
    const code = value.charCodeAt(index);
    if (code < 48 || (code > 57 && code < 97) || code > 102) {
      return false;
    }
  }
  return true;
}

function independent_boot_id() {
  ensure(rh.exists(BOOT_ID_PATH), "cu_linux_boot_identity_boot_id_missing");
  const boot_id = rh.read_text(BOOT_ID_PATH).trim();
  ensure(boot_id_shape(boot_id), "cu_linux_boot_identity_boot_id_shape:" + boot_id);
  return boot_id;
}

function independent_machine_id() {
  ensure(rh.exists(MACHINE_ID_PATH), "cu_linux_boot_identity_machine_id_missing");
  const machine_id = rh.read_text(MACHINE_ID_PATH).trim().toLowerCase();
  ensure(machine_id_shape(machine_id), "cu_linux_boot_identity_machine_id_shape:" + machine_id);
  return machine_id;
}

function independent_uptime_milliseconds() {
  const script = [
    "import time",
    "print(int(time.clock_gettime(time.CLOCK_BOOTTIME) * 1000))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], { timeout_ms: 10000 });
  ensure(output.success === true, "cu_linux_boot_identity_uptime_probe:" + output.stderr);
  const value = Number(output.stdout.trim());
  ensure(value === value && value >= 0, "cu_linux_boot_identity_uptime_shape:" + output.stdout);
  return value;
}

function uptime_near(candidate, lower, upper) {
  return candidate >= lower - UPTIME_SLACK_MS && candidate <= upper + UPTIME_SLACK_MS;
}

function host_boot_identity(reply) {
  const data = rh.field(reply, "data");
  const facts = rh.field(data, "host_boot_identity");
  ensure(facts !== undefined && facts !== null, "cu_linux_boot_identity_missing");
  ensure(text_at(facts, "status") === "available", "cu_linux_boot_identity_status:" + JSON.stringify(facts));
  return facts;
}

function probe_host_sources() {
  const script = [
    "import json, os",
    "print(json.dumps({",
    "    'boot_id': os.path.isfile('/proc/sys/kernel/random/boot_id'),",
    "    'machine_id': os.path.isfile('/etc/machine-id'),",
    "}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], { timeout_ms: 10000 });
  ensure(output.success === true, "cu_linux_boot_identity_probe:" + output.stderr);
  const probe = JSON.parse(output.stdout.trim());
  ensure(probe.boot_id === true || probe.boot_id === false, "cu_linux_boot_identity_probe_boot_id");
  ensure(probe.machine_id === true || probe.machine_id === false, "cu_linux_boot_identity_probe_machine_id");
  return probe;
}

function verify_unavailable_host_boot_identity(reply, absence) {
  const data = rh.field(reply, "data");
  const facts = rh.field(data, "host_boot_identity");
  ensure(facts !== undefined && facts !== null, "cu_linux_boot_identity_missing");
  ensure(text_at(facts, "status") === "unavailable",
         "cu_linux_boot_identity_unavailable_status:" + JSON.stringify(facts));
  const reason = text_at(facts, "reason");
  ensure(reason.length > 0, "cu_linux_boot_identity_unavailable_reason_empty");
  if (!absence.boot_id) {
    ensure(reason.indexOf("boot_id") >= 0,
           "cu_linux_boot_identity_unavailable_boot_id_reason:" + reason);
  }
  if (!absence.machine_id) {
    ensure(reason.indexOf("machine-id") >= 0,
           "cu_linux_boot_identity_unavailable_machine_id_reason:" + reason);
  }
  ensure(text_at(facts, "kind").length > 0, "cu_linux_boot_identity_unavailable_kind");
  ensure(text_at(facts, "boot_id") === "", "cu_linux_boot_identity_fake_boot_id");
  ensure(text_at(facts, "machine_id") === "", "cu_linux_boot_identity_fake_machine_id");
  ensure(text_at(facts, "uptime_milliseconds") === "", "cu_linux_boot_identity_fake_uptime");
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(rh.exists(executable), "cu_linux_boot_identity_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-linux-boot-identity");
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);
const host_sources = probe_host_sources();
let succeeded = 0;
let failure = "";
try {
  print("STEP capabilities typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_capabilities_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before boot-identity inventory/read-back court");
  assert_get_extents_usage_limit(context.run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before boot-identity inventory/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(context.run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; boot-identity read-back still uses /proc and CLOCK_BOOTTIME");
  }

  if (!host_sources.boot_id || !host_sources.machine_id) {
    print("STEP typed unavailable host-limit path (independent /proc probe absent: boot_id="
      + host_sources.boot_id + " machine_id=" + host_sources.machine_id + ")");
    const reply = invoke(context.run_directory, executable, ["capabilities"], env);
    ensure(reply.command === "capabilities" && reply.target === "current",
           "cu_linux_boot_identity_command");
    verify_unavailable_host_boot_identity(reply, host_sources);
    const second = invoke(context.run_directory, executable, ["capabilities"], env);
    verify_unavailable_host_boot_identity(second, host_sources);
    ensure(text_at(second, "data.host_boot_identity.reason")
           === text_at(reply, "data.host_boot_identity.reason"),
           "cu_linux_boot_identity_unavailable_reason_unstable");
    succeeded = 1;
  } else {
  print("STEP independent boot_id, machine-id and CLOCK_BOOTTIME bracket one capabilities observation");
  const boot_id_before = independent_boot_id();
  const machine_id_before = independent_machine_id();
  const uptime_before = independent_uptime_milliseconds();
  const reply = invoke(context.run_directory, executable, ["capabilities"], env);
  const boot_id_after = independent_boot_id();
  const machine_id_after = independent_machine_id();
  const uptime_after = independent_uptime_milliseconds();

  ensure(reply.command === "capabilities" && reply.target === "current",
         "cu_linux_boot_identity_command");
  const facts = host_boot_identity(reply);

  ensure(boot_id_before === boot_id_after,
         "cu_linux_boot_identity_boot_id_changed:" + boot_id_before + "!=" + boot_id_after);
  ensure(machine_id_before === machine_id_after,
         "cu_linux_boot_identity_machine_id_changed:" + machine_id_before + "!=" + machine_id_after);
  ensure(text_at(facts, "boot_id") === boot_id_before,
         "cu_linux_boot_identity_boot_id_mismatch:cu="
         + text_at(facts, "boot_id") + ":host=" + boot_id_before);
  ensure(text_at(facts, "machine_id") === machine_id_before,
         "cu_linux_boot_identity_machine_id_mismatch:cu="
         + text_at(facts, "machine_id") + ":host=" + machine_id_before);

  const uptime_ms = Number(text_at(facts, "uptime_milliseconds"));
  ensure(uptime_ms === uptime_ms && uptime_ms >= 0, "cu_linux_boot_identity_uptime_shape");
  ensure(uptime_near(uptime_ms, uptime_before, uptime_after),
         "cu_linux_boot_identity_uptime_mismatch:cu=" + uptime_ms
         + ":before=" + uptime_before + ":after=" + uptime_after);

  print("STEP repeated capabilities observations keep boot_id and machine_id stable");
  const second = invoke(context.run_directory, executable, ["capabilities"], env);
  const second_facts = host_boot_identity(second);
  ensure(text_at(second_facts, "boot_id") === text_at(facts, "boot_id"),
         "cu_linux_boot_identity_boot_id_unstable");
  ensure(text_at(second_facts, "machine_id") === text_at(facts, "machine_id"),
         "cu_linux_boot_identity_machine_id_unstable");
  ensure(Number(text_at(second_facts, "uptime_milliseconds")) >= uptime_ms,
         "cu_linux_boot_identity_uptime_monotonic");

  succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-boot-identity-readback");
  harness.remove_run(context);
  if (host_sources.boot_id && host_sources.machine_id) {
    if (atspi_available) {
      print("PASS: Linux capabilities host_boot_identity matches independent boot_id, machine-id and CLOCK_BOOTTIME read-back with typed capabilities/get-extents --name/--coords/--bogus usage/host-limit honesty (AT-SPI --name, no --coords)");
    } else {
      print("PASS: Linux capabilities host_boot_identity matches independent boot_id, machine-id and CLOCK_BOOTTIME read-back with typed capabilities --name/--coords/--bogus usage plus get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
    }
  } else if (atspi_available) {
    print("PASS: Linux capabilities host_boot_identity typed unavailable when independent /proc boot_id or machine-id is absent, with typed capabilities/get-extents --name/--coords/--bogus usage/host-limit honesty (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux capabilities host_boot_identity typed unavailable when independent /proc boot_id or machine-id is absent, with typed capabilities --name/--coords/--bogus usage plus get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
