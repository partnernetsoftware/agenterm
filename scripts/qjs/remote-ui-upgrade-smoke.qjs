// Prove real GUI byte upgrade and rollback against one stable server and PTY.
//
// Args:
//   --list-evidence
// or:
//   REPO PRIOR_GUI_EXE NEXT_GUI_EXE CLI_EXE SERVER_EXE [NEXT_GUI_OVERRIDE]
//
// Ported from scripts/rh/remote-ui-upgrade-smoke.rh; runs under `--profile
// tool`. The server and each GUI are door handles (process_spawn / _state /
// _wait), which is what rh's `command.start()` / `.state` /
// `wait_with_output()` were.
//
// A Windows journey: `--ui-client` is accepted only by the Windows GUI
// launcher (`src/frontend/mod.rs` rejects it elsewhere) and the output stream
// is a cmd.exe `for /L` loop. Both are kept verbatim.
//
// Gap, not approximated: the door has no `process.pid(handle)`, so
// `lease.client_pid == gui.id` -- "the lease belongs to the child we
// started" -- cannot be asked. `child_pid` below is the one seam to replace
// when the door answers it; until then it throws `remote_upgrade_gap`.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

function catch_text(error) {
  return "" + error;
}

// rh's `child.id`: the child's OS pid. No door op carries it yet.
function child_pid(handle) {
  throw "remote_upgrade_gap:process_pid:handle=" + handle;
}

function command(context, cli, args, expected_failure) {
  return harness.invoke_cli(context, cli, args, expected_failure, []);
}

function command_text(context, cli, args) {
  const output = command(context, cli, args, 0);
  return "" + output.stdout + output.stderr;
}

function command_json(context, cli, args) {
  const output = command(context, cli, args, 0);
  const text = "" + output.stdout + output.stderr;
  return JSON.parse(text);
}

function wait_for_server(context, cli, server) {
  for (let attempt = 0; attempt < 400; attempt = attempt + 1) {
    const probe = harness.run_cli(context, cli, ["protocol-info", "--running"], 0, []);
    if (probe.success) {
      const text = "" + probe.stdout;
      return JSON.parse(text);
    }
    if (harness.state(server) === "exited") {
      const output = harness.wait(server, 2000);
      throw "remote_upgrade_server_early_exit:" + output.stderr;
    }
    rh.sleep_ms(25);
  }
  throw "remote_upgrade_server_ready_timeout";
}

function wait_for_bootstrap_terminal(context, cli, server, server_pid) {
  command_text(context, cli, ["wait-ui", "-t", "0", "--tab-state", "running", "--timeout-ms", "30000"]);
  if (harness.state(server) === "exited") {
    const output = harness.wait(server, 2000);
    throw "remote_upgrade_server_before_terminal_ready:" + output.stderr;
  }
  const bootstrap = command_json(context, cli, ["ui-bootstrap"]);
  const active_id = "" + bootstrap.active_tab_id;
  let active_process_id = 0;
  for (let index = 0; index < bootstrap.tabs.length; index = index + 1) {
    const tab = bootstrap.tabs[index];
    if ("" + tab.id === active_id) {
      active_process_id = tab.process_id;
    }
  }
  harness.require(
    bootstrap.server_pid === server_pid && active_process_id !== 0,
    "remote_upgrade_baseline_terminal_identity"
  );
  return bootstrap;
}

function wait_for_exit(child, timeout_attempts, code) {
  for (let attempt = 0; attempt < timeout_attempts; attempt = attempt + 1) {
    if (harness.state(child) === "exited") {
      return harness.wait(child, 2000);
    }
    rh.sleep_ms(25);
  }
  throw code;
}

function start_upgrade_ui(context, cli, executable, label) {
  const gui_spec = harness.configured_spec(
    context,
    executable,
    ["--ui-client", "--no-activate", "--address", context.address]
  );
  const gui = harness.start(gui_spec);
  for (let attempt = 0; attempt < 480; attempt = attempt + 1) {
    const lease_probe = harness.run_cli(context, cli, ["ui-lease", "status"], 0, []);
    // Lease + client_pid ownership only, as in rh.
    if (lease_probe.success) {
      const lease_text = "" + lease_probe.stdout;
      const lease = JSON.parse(lease_text);
      const client_pid = lease.client_pid;
      if (lease.attached && client_pid === child_pid(gui)) {
        return gui;
      }
    }
    if (harness.state(gui) === "exited") {
      const output = harness.wait(gui, 2000);
      throw label + "_gui_early_exit:" + output.stderr;
    }
    rh.sleep_ms(25);
  }
  throw label + "_gui_lease_timeout";
}

function stop_upgrade_ui_keeping_server(context, cli, gui) {
  const modal = command_json(context, cli, ["ui-action", "close-window"]);
  const modal_kind = "" + modal.modal.kind;
  const modal_default = "" + modal.modal.default_action;
  harness.require(
    modal_kind === "confirm-window-close"
      && modal_default === "keep-server-running"
      && rh.array_has(modal.modal.actions, "keep-server-running")
      && rh.array_has(modal.modal.actions, "stop-server-and-exit")
      && rh.array_has(modal.modal.actions, "cancel"),
    "remote_upgrade_close_contract"
  );
  const detached = command_json(context, cli, ["ui-action", "keep-server-running"]);
  harness.require(
    !detached.window.visible
      && detached.window.detached
      && !detached.layout.composer.visible,
    "remote_upgrade_detached_ui_facts"
  );
  const output = wait_for_exit(gui, 200, "remote_upgrade_gui_exit_timeout");
  harness.require(output.success, "remote_upgrade_gui_exit_failure");
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    const lease = command_json(context, cli, ["ui-lease", "status"]);
    if (!lease.attached) {
      return 0;
    }
    rh.sleep_ms(25);
  }
  throw "remote_upgrade_lease_detach_timeout";
}

function find_tab_index(bootstrap, tab_id) {
  let found = -1;
  for (let index = 0; index < bootstrap.tabs.length; index = index + 1) {
    const candidate = bootstrap.tabs[index];
    const candidate_id = "" + candidate.id;
    if (candidate_id === tab_id) {
      found = index;
    }
  }
  return found;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  print("ui.same-server-upgrade-rollback");
  return;
}

harness.require(
  args.length === 5 || args.length === 6,
  "expected: REPO PRIOR_GUI_EXE NEXT_GUI_EXE CLI_EXE SERVER_EXE [NEXT_GUI_OVERRIDE]"
);
const repo = rh.absolute(args[0]);
const prior_gui_exe = rh.absolute(args[1]);
let next_gui_arg = args[2];
if (args.length === 6) {
  next_gui_arg = args[5];
}
const next_gui_exe = rh.absolute(next_gui_arg);
const cli = rh.absolute(args[3]);
const server_exe = rh.absolute(args[4]);
for (const path of [prior_gui_exe, next_gui_exe, cli, server_exe]) {
  harness.require(rh.exists(path), "remote_upgrade_input_missing:" + path);
}
harness.require(
  rh.sha256_file(prior_gui_exe) !== rh.sha256_file(next_gui_exe),
  "remote_upgrade_requires_distinct_gui_bytes"
);

const context = harness.new_context(repo, "remote-ui-upgrade");
let succeeded = 0;
let failure = "";

try {
  print("STEP start one stable headless server");
  const server_spec = harness.configured_spec(context, server_exe, ["server", "--address", context.address]);
  const server = harness.start(server_spec);
  const running_protocol = wait_for_server(context, cli, server);
  const expected_server_pid = running_protocol.pid;

  const baseline = wait_for_bootstrap_terminal(context, cli, server, expected_server_pid);
  const tab_id = "" + baseline.active_tab_id;
  const baseline_tab_index = find_tab_index(baseline, tab_id);
  const baseline_tab = baseline.tabs[baseline_tab_index];
  harness.require(
    baseline_tab_index >= 0
      && baseline.server_pid === expected_server_pid
      && baseline_tab.process_id !== 0,
    "remote_upgrade_baseline_identity"
  );
  const server_pid = baseline.server_pid;
  const server_epoch = baseline.server_epoch;
  const pty_pid = baseline_tab.process_id;
  const draft = "upgrade-draft-" + context.run_id;
  command_text(context, cli, ["set-composer", "-t", tab_id, draft]);

  print("STEP connect the prior GUI and probe the alternate bytes");
  const prior = start_upgrade_ui(context, cli, prior_gui_exe, "remote_upgrade_prior");
  const prior_lease = command_json(context, cli, ["ui-lease", "status"]);
  const prior_build = prior_lease.client_build;
  const prior_identity = JSON.stringify(prior_build);
  harness.require(
    prior_identity !== "" && prior_build.protocol_version === 1,
    "remote_upgrade_prior_build_identity"
  );
  const prior_pid = child_pid(prior);
  const probe_spec = harness.configured_spec(context, next_gui_exe, ["--version"]);
  const probe = harness.start(probe_spec);
  const probe_output = wait_for_exit(probe, 200, "remote_upgrade_alternate_probe_timeout");
  harness.require(probe_output.success, "remote_upgrade_alternate_probe_failed");
  const prior_lease_after_probe = command_json(context, cli, ["ui-lease", "status"]);
  const healthy_bootstrap = command_json(context, cli, ["ui-bootstrap"]);
  const healthy_tab_index = find_tab_index(healthy_bootstrap, tab_id);
  const healthy_tab = healthy_bootstrap.tabs[healthy_tab_index];
  harness.require(
    healthy_tab_index >= 0
      && prior_lease_after_probe.attached
      && prior_lease_after_probe.client_pid === prior_pid
      && healthy_bootstrap.server_pid === server_pid
      && healthy_tab.process_id === pty_pid,
    "remote_upgrade_alternate_probe_disturbed_state"
  );

  print("STEP stream output while replacing the prior GUI");
  const stream_prefix = "UPGRADE_STREAM_" + context.run_id;
  // cmd.exe syntax, verbatim from rh: the journey's shell is the Windows one.
  const stream_command =
    "for /L %i in (1,1,12) do @(echo " + stream_prefix + "_%i & ping -n 2 127.0.0.1 >nul)";
  command_text(context, cli, ["send-keys", "-t", tab_id, "-l", stream_command]);
  command_text(context, cli, ["send-keys", "-t", tab_id, "Enter"]);
  command_text(context, cli, ["wait-pane", "-t", tab_id, "--contains", stream_prefix + "_2", "--timeout-ms", "30000"]);
  stop_upgrade_ui_keeping_server(context, cli, prior);

  print("STEP connect the next GUI to the unchanged server");
  const next = start_upgrade_ui(context, cli, next_gui_exe, "remote_upgrade_next");
  const next_lease = command_json(context, cli, ["ui-lease", "status"]);
  const next_build = next_lease.client_build;
  const next_identity = JSON.stringify(next_build);
  const next_pid = child_pid(next);
  harness.require(
    next_identity !== prior_identity && next_pid !== prior_pid,
    "remote_upgrade_next_identity_unchanged"
  );
  command_text(context, cli, ["wait-pane", "-t", tab_id, "--contains", stream_prefix + "_8", "--timeout-ms", "30000"]);
  const next_bootstrap = command_json(context, cli, ["ui-bootstrap"]);
  const next_tab_index = find_tab_index(next_bootstrap, tab_id);
  const next_tab = next_bootstrap.tabs[next_tab_index];
  const next_composer = "" + next_tab.composer.text;
  harness.require(
    next_tab_index >= 0
      && next_bootstrap.server_pid === server_pid
      && next_bootstrap.server_epoch === server_epoch
      && next_bootstrap.active_tab_id === tab_id
      && next_tab.process_id === pty_pid
      && next_composer === draft,
    "remote_upgrade_next_lost_state"
  );

  print("STEP reject an incompatible hello without ending live state");
  const incompatible = command_json(
    context,
    cli,
    ["ui-hello", "--minimum", "2", "--maximum", "2", "--client-id", "incompatible-" + context.run_id]
  );
  const incompatible_reason = "" + incompatible.compatibility;
  harness.require(
    !incompatible.accepted
      && incompatible_reason === "client_too_new"
      && harness.state(server) === "running",
    "remote_upgrade_incompatible_hello"
  );

  print("STEP roll back to the prior GUI and finish the output stream");
  stop_upgrade_ui_keeping_server(context, cli, next);
  const rollback = start_upgrade_ui(context, cli, prior_gui_exe, "remote_upgrade_rollback");
  const rollback_lease = command_json(context, cli, ["ui-lease", "status"]);
  const rollback_build = rollback_lease.client_build;
  const rollback_identity = JSON.stringify(rollback_build);
  harness.require(rollback_identity === prior_identity, "remote_upgrade_rollback_identity");
  command_text(
    context,
    cli,
    ["wait-pane", "-t", tab_id, "--contains", stream_prefix + "_12", "--submit-complete", "--timeout-ms", "30000"]
  );
  const final_bootstrap = command_json(context, cli, ["ui-bootstrap"]);
  const final_tab_index = find_tab_index(final_bootstrap, tab_id);
  const final_tab = final_bootstrap.tabs[final_tab_index];
  const final_composer = "" + final_tab.composer.text;
  const capture = command_text(context, cli, ["capture-pane", "-p", "-t", tab_id, "--max-bytes", "65536"]);
  const token_2 = stream_prefix + "_2";
  const token_8 = stream_prefix + "_8";
  const token_12 = stream_prefix + "_12";
  harness.require(
    final_tab_index >= 0
      && final_bootstrap.server_pid === server_pid
      && final_bootstrap.server_epoch === server_epoch
      && final_bootstrap.active_tab_id === tab_id
      && final_tab.process_id === pty_pid
      && final_composer === draft
      && final_tab.screen.max_scrollback >= next_tab.screen.max_scrollback
      && capture.includes(token_2)
      && capture.includes(token_8)
      && capture.includes(token_12),
    "remote_upgrade_rollback_lost_state"
  );

  harness.emit_evidence(context, ["ui.same-server-upgrade-rollback"], "ui.same-server-upgrade-rollback");
  stop_upgrade_ui_keeping_server(context, cli, rollback);
  command_text(context, cli, ["shutdown"]);
  const server_output = wait_for_exit(server, 400, "remote_upgrade_server_shutdown_timeout");
  harness.require(server_output.success, "remote_upgrade_server_shutdown_failure");
  print("PASS: real GUI bytes upgrade and roll back on one stable server and PTY");
  succeeded = 1;
} catch (error) {
  failure = catch_text(error);
}

if (succeeded !== 0 && failure === "") {
  harness.remove_run(context);
}
if (failure !== "") {
  throw failure;
}
return;
