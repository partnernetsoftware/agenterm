// CEO: Linux screenshot --window honesty with independent PNG file read-back.
// Acceptance is smoke read-back only: CU screenshot --window for an owned GTK
// fixture must write a real PNG whose magic, IHDR dimensions and size agree
// with inventory bounds; optional full-display screenshot is secondary.
// Typed screenshot usage must reject AT-SPI --name, --coords, --bogus, and
// other unexpected arguments (usage_rejects_unexpected + command=usage, never
// fake command=usage); typed get-extents --name usage AND host-limit paths must
// both always run before the screenshot actuate/read-back court, including
// get-extents --coords/--bogus command=usage honesty. Missing
// DISPLAY host-limit paths must hold; stale handles typed-fail
// screenshot_window_unavailable. Prefer host-limit clarity over fake success.
// AT-SPI/--name only; no --coords.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-screenshot-window-readback",
];

const MIN_WINDOW_PNG_BYTES = 2000;
const MIN_DISPLAY_PNG_BYTES = 5000;
const PNG_MAGIC_HEX = "89504e470d0a1a0a";
const AT_SPI_PROBE_NAME = "Screenshot Window Court Anchor";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return -1; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu(run_directory, executable, grant, cu_args) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_screenshot_window_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_screenshot_window_empty");
  return JSON.parse(trimmed);
}

function last_json_line(text) {
  const lines = text.trim().split("\n");
  for (let index = lines.length - 1; index >= 0; index = index - 1) {
    const line = lines[index].trim();
    if (line !== "") { return JSON.parse(line); }
  }
  throw "cu_linux_screenshot_window_missing_json";
}

function run_cu_reply(run_directory, executable, grant, cu_args, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  ensure(output.stdout.trim() !== "", "cu_linux_screenshot_window_empty_reply:" + output.stderr);
  return last_json_line(output.stdout);
}

function invoke_get_extents_reply(run_directory, executable, cu_args, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(cu_args), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_screenshot_window_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function probe_cu_windows_enum_available(run_directory, executable, env) {
  const reply = run_cu_reply(run_directory, executable, "observe", ["windows"], env);
  if (output_success(reply)) { return { available: true }; }
  const message = text_at(reply, "error.message");
  if (message.indexOf("Maximum number of clients reached") >= 0
      || message.indexOf("window_enum_failed") >= 0) {
    return { available: false, reason: "x11_window_enum_unavailable" };
  }
  return { available: false, reason: message };
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  ensure(flag_at(reply, "ok"), "cu_linux_screenshot_window_windows:" + JSON.stringify(reply));
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function wait_for_fixture_window(run_directory, executable, pid, title) {
  for (let attempt = 0; attempt < 300; attempt = attempt + 1) {
    const row = window_row(run_directory, executable, pid, title);
    if (row !== null) { return row; }
    harness.sleep_ms(50);
  }
  throw "cu_linux_screenshot_window_fixture_not_ready";
}

function independent_png_probe_script() {
  return [
    "import json, os, struct, sys",
    "path = sys.argv[1]",
    "with open(path, 'rb') as handle:",
    "    head = handle.read(24)",
    "if len(head) < 24:",
    "    raise SystemExit('cu_linux_screenshot_window_probe_short')",
    "if head[:8] != b'\\x89PNG\\r\\n\\x1a\\n':",
    "    raise SystemExit('cu_linux_screenshot_window_probe_magic')",
    "if head[12:16] != b'IHDR':",
    "    raise SystemExit('cu_linux_screenshot_window_probe_ihdr')",
    "width, height = struct.unpack('>II', head[16:24])",
    "size = os.path.getsize(path)",
    "print(json.dumps({'width': width, 'height': height, 'size': size}))",
  ].join("\n");
}

function independent_png_magic_hex(path) {
  const script = [
    "import sys",
    "path = sys.argv[1]",
    "data = open(path, 'rb').read(8)",
    "if len(data) != 8:",
    "    raise SystemExit('cu_linux_screenshot_window_magic_short')",
    "print(data.hex())",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, path], { timeout_ms: 10000 });
  ensure(
    output.success === true && output.stdout.trim() !== "",
    "cu_linux_screenshot_window_magic:" + output.stdout + output.stderr
  );
  return output.stdout.trim().toLowerCase();
}

function independent_png_readback(run_directory, path) {
  ensure(
    independent_png_magic_hex(path) === PNG_MAGIC_HEX,
    "cu_linux_screenshot_window_magic_mismatch:" + path
  );
  const output = rh.command(
    "python3",
    ["-c", independent_png_probe_script(), path],
    { cwd: run_directory, env: cu_env(""), timeout_ms: 30000 },
  );
  ensure(
    output.success === true,
    "cu_linux_screenshot_window_probe:" + output.stderr + output.stdout
  );
  return JSON.parse(output.stdout.trim());
}

function optional_identify_dimensions(run_directory, path) {
  const which = rh.command("sh", ["-c", "command -v identify"], {
    cwd: run_directory,
    timeout_ms: 5000,
  });
  if (!which.success || which.stdout.trim() === "") { return null; }
  const output = rh.command("identify", ["-format", "%w %h", path], {
    cwd: run_directory,
    timeout_ms: 15000,
  });
  if (!output.success) { return null; }
  const trimmed = output.stdout.trim();
  const space = trimmed.indexOf(" ");
  if (space <= 0) { return null; }
  return {
    width: rh.parse_int(trimmed.slice(0, space)),
    height: rh.parse_int(trimmed.slice(space + 1)),
  };
}

function assert_window_png_honesty(run_directory, executable, handle, inventory_row, shot_path, label) {
  const shot = run_cu(run_directory, executable, "observe", [
    "screenshot", "--out", shot_path, "--window", "" + handle,
  ]);
  ensure(flag_at(shot, "ok"), "cu_linux_screenshot_window_ok_" + label + ":" + JSON.stringify(shot));
  ensure(text_at(shot, "data.via") === "window-capture", "cu_linux_screenshot_window_via_" + label);
  ensure(text_at(shot, "data.path") === shot_path, "cu_linux_screenshot_window_path_" + label);
  ensure(direct_file(shot_path), "cu_linux_screenshot_window_missing_" + label);

  const inventory_width = int_at(inventory_row, "bounds.width");
  const inventory_height = int_at(inventory_row, "bounds.height");
  ensure(
    int_at(shot, "data.output_width") === inventory_width
      && int_at(shot, "data.output_height") === inventory_height,
    "cu_linux_screenshot_window_cu_dims_" + label + ":" + JSON.stringify({
      shot: shot.data,
      bounds: inventory_row.bounds,
    })
  );

  const probe = independent_png_readback(run_directory, shot_path);
  ensure(probe.size >= MIN_WINDOW_PNG_BYTES, "cu_linux_screenshot_window_probe_size_" + label + ":" + JSON.stringify(probe));
  ensure(
    probe.width === inventory_width && probe.height === inventory_height,
    "cu_linux_screenshot_window_probe_dims_" + label + ":" + JSON.stringify({
      probe: probe,
      bounds: inventory_row.bounds,
    })
  );
  ensure(
    probe.width === int_at(shot, "data.output_width")
      && probe.height === int_at(shot, "data.output_height"),
    "cu_linux_screenshot_window_probe_cu_dims_" + label + ":" + JSON.stringify({
      probe: probe,
      shot: shot.data,
    })
  );

  const identify = optional_identify_dimensions(run_directory, shot_path);
  if (identify !== null) {
    ensure(
      identify.width === probe.width && identify.height === probe.height,
      "cu_linux_screenshot_window_identify_" + label + ":" + JSON.stringify({
        identify: identify,
        probe: probe,
      })
    );
  }
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function assert_screenshot_usage_limit(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "screenshot", "--out", rh.join(run_directory, "usage.png"), "--window", "0",
  ]);
  ensure(!output_success(reply), "cu_linux_screenshot_window_usage_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_screenshot_window_usage_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_screenshot_window_usage_message:" + JSON.stringify(reply.error)
  );
}

function assert_screenshot_unexpected_flag(run_directory, executable, env, extra_args, token, label) {
  const argv = [
    "screenshot",
    "--out", rh.join(run_directory, "usage-" + label + ".png"),
    "--window", "1",
  ];
  for (const argument of extra_args) { argv.push("" + argument); }
  const reply = run_cu_reply(run_directory, executable, "observe", argv, env);
  ensure(!output_success(reply), "cu_linux_screenshot_window_usage_" + label + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "usage",
    "cu_linux_screenshot_window_usage_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "command") === "usage",
    "cu_linux_screenshot_window_usage_" + label + "_command:" + JSON.stringify(reply)
  );
  ensure(
    usage_rejects_unexpected(text_at(reply, "error.message"), token),
    "cu_linux_screenshot_window_usage_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_screenshot_atspi_name_usage_limit(run_directory, executable, env) {
  assert_screenshot_unexpected_flag(
    run_directory, executable, env, ["--name", AT_SPI_PROBE_NAME], "--name", "name"
  );
  assert_screenshot_unexpected_flag(
    run_directory, executable, env, ["--bogus"], "--bogus", "bogus"
  );
  assert_screenshot_unexpected_flag(
    run_directory, executable, env, ["--coords", "10,10"], "--coords", "coords"
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_screenshot_window_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_screenshot_window_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_screenshot_window_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_screenshot_window_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_screenshot_window_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_screenshot_window_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_screenshot_window_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords),
    "cu_linux_screenshot_window_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_screenshot_window_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_screenshot_window_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_screenshot_window_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus),
    "cu_linux_screenshot_window_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_screenshot_window_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_screenshot_window_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_screenshot_window_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_screenshot_window_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_screenshot_window_extents_unavailable_code:" + code
  );
}

function assert_headless_display_host_limit(run_directory, executable, label, cu_args, message_needle) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "observe",
    cu_args,
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_screenshot_window_headless_ok_" + label + ":" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_screenshot_window_headless_code_" + label + ":" + JSON.stringify(reply.error)
  );
  ensure(
    text_at(reply, "error.message").toLowerCase().indexOf(message_needle) >= 0,
    "cu_linux_screenshot_window_headless_message_" + label + ":" + JSON.stringify(reply.error)
  );
}

function assert_unavailable_window(run_directory, executable, label) {
  const reply = run_cu_reply(run_directory, executable, "observe", [
    "screenshot", "--out", rh.join(run_directory, "bad-" + label + ".png"), "--window", "1",
  ]);
  ensure(
    !output_success(reply) && text_at(reply, "error.code") === "screenshot_window_unavailable",
    "cu_linux_screenshot_window_unavailable_" + label + ":" + JSON.stringify(reply)
  );
  ensure(
    text_at(reply, "error.message").indexOf("not a current top-level") >= 0,
    "cu_linux_screenshot_window_unavailable_message_" + label + ":" + JSON.stringify(reply.error)
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-screenshot-window");
const run_directory = rh.join(repo, "target/cu-linux-screenshot-window-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_screenshot_window_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
let window_enum = { available: false, reason: "not_probed" };
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP screenshot typed-fails usage when --window handle is zero");
  assert_screenshot_usage_limit(run_directory, executable);

  print("STEP screenshot typed-fails usage when AT-SPI --name, --coords, or --bogus is present");
  assert_screenshot_atspi_name_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (usage_rejects_unexpected + command=usage) before screenshot actuate/read-back court");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before screenshot actuate/read-back court");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  print("STEP screenshot without DISPLAY typed-fails unsupported x11-display host-limit");
  assert_headless_display_host_limit(
    run_directory,
    executable,
    "display",
    ["screenshot", "--out", rh.join(run_directory, "headless-display.png")],
    "x11 display"
  );
  assert_headless_display_host_limit(
    run_directory,
    executable,
    "window",
    ["screenshot", "--out", rh.join(run_directory, "headless-window.png"), "--window", "1"],
    "x11 display"
  );

  window_enum = probe_cu_windows_enum_available(run_directory, executable, env);
  if (window_enum.available !== true) {
    print("STEP typed host-limit when CU windows enumeration is unavailable before screenshot actuate/read-back court");
    succeeded = 1;
  } else {
    print("STEP start owned GTK fixture and resolve window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "ok") && flag_at(window_wait, "data.met"), "cu_linux_screenshot_window_window_wait");

    const inventory_row = wait_for_fixture_window(run_directory, executable, fixture_pid, fixture_title);
    const handle = int_at(inventory_row, "handle");
    ensure(handle > 0, "cu_linux_screenshot_window_handle:" + JSON.stringify(inventory_row));

    print("STEP screenshot --window writes PNG with independent magic/IHDR/size read-back");
    const window_png = rh.join(run_directory, "fixture-window.png");
    assert_window_png_honesty(
      run_directory, executable, handle, inventory_row, window_png, "gtk_fixture"
    );

    print("STEP optional full-display screenshot is secondary PNG read-back");
    const display_png = rh.join(run_directory, "display.png");
    const display = run_cu(run_directory, executable, "observe", [
      "screenshot", "--out", display_png,
    ]);
    ensure(flag_at(display, "ok"), "cu_linux_screenshot_window_display_ok:" + JSON.stringify(display));
    ensure(text_at(display, "data.via") === "display-capture", "cu_linux_screenshot_window_display_via");
    ensure(direct_file(display_png), "cu_linux_screenshot_window_display_missing");
    const display_probe = independent_png_readback(run_directory, display_png);
    ensure(
      display_probe.size >= MIN_DISPLAY_PNG_BYTES,
      "cu_linux_screenshot_window_display_size:" + JSON.stringify(display_probe)
    );
    ensure(
      display_probe.width === int_at(display, "data.output_width")
        && display_probe.height === int_at(display, "data.output_height"),
      "cu_linux_screenshot_window_display_dims:" + JSON.stringify({
        probe: display_probe,
        shot: display.data,
      })
    );

    print("STEP stale handle typed-fails screenshot_window_unavailable");
    assert_unavailable_window(run_directory, executable, "stale_handle");

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-screenshot-window-readback");
  harness.remove_run(context);
  if (window_enum.available !== true) {
    print("PASS: Linux screenshot --window typed screenshot --name/--coords/--bogus usage_rejects_unexpected plus get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty with x11 window-enum host-limit when CU inventory is unavailable (AT-SPI --name, no --coords)");
  } else if (atspi_available) {
    print("PASS: Linux screenshot --window with typed screenshot --name/--coords/--bogus usage_rejects_unexpected, get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty, headless-display host-limit, and independent PNG read-back (AT-SPI --name, no --coords)");
  } else {
    print("PASS: Linux screenshot --window with typed screenshot --name/--coords/--bogus usage_rejects_unexpected, get-extents --name usage AND host-limit plus --coords/--bogus command=usage honesty, headless-display host-limit, and independent PNG read-back (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
