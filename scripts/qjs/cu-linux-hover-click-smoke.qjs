// CEO#1: hover then click the same GTK button by --name on Linux AT-SPI.
// Acceptance is smoke read-back only: the fixture count label must advance.
// No --coords, no screenshot, no coordinate degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-hover-click",
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function run_cu(run_directory, executable, grant, arguments) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_hover_click_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_hover_click_empty");
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_linux_hover_click_reply:" + JSON.stringify(document));
  return document;
}

function tree_nodes(run_directory, executable, handle_text, depth) {
  const reply = run_cu(run_directory, executable, "observe", [
    "tree", "--window", handle_text, "--depth", depth,
  ]);
  return reply.data.nodes;
}

function label_text(run_directory, executable, handle_text, prefix) {
  const nodes = tree_nodes(run_directory, executable, handle_text, "8");
  for (const node of nodes) {
    if (("" + node.role) !== "label") { continue; }
    const name = "" + node.name;
    if (name.startsWith(prefix)) { return name; }
  }
  return "";
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-hover-click-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_hover_click_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_hover_click_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_hover_click_window_missing");
  const handle_text = "" + int_at(row, "handle");
  ensure(int_at(row, "handle") > 0, "cu_linux_hover_click_handle:" + JSON.stringify(row));

  print("STEP baseline count label reads pressed 0");
  const before = label_text(run_directory, executable, handle_text, "pressed ");
  ensure(before === "pressed 0", "cu_linux_hover_click_before:" + before);

  print("STEP hover --name Fixture Press moves the pointer through AT-SPI GenerateMouseEvent(abs)");
  const hovered = run_cu(run_directory, executable, "observe,actuate", [
    "hover", "--window", handle_text, "--name", "Fixture Press",
  ]);
  ensure(
    flag_at(hovered, "data.performed")
      && text_at(hovered, "data.addressing") === "accessibility-tree",
    "cu_linux_hover_click_hover:" + JSON.stringify(hovered.data)
  );
  const after_hover = label_text(run_directory, executable, handle_text, "pressed ");
  ensure(
    after_hover === "pressed 0",
    "cu_linux_hover_click_after_hover:" + after_hover
  );

  print("STEP click --name Fixture Press on the same node, verified by the count label");
  const clicked = run_cu(run_directory, executable, "observe,actuate", [
    "click", "--window", handle_text, "--name", "Fixture Press",
  ]);
  ensure(
    flag_at(clicked, "data.performed")
      && text_at(clicked, "data.addressing") === "accessibility-tree",
    "cu_linux_hover_click_click:" + JSON.stringify(clicked.data)
  );
  const after = label_text(run_directory, executable, handle_text, "pressed ");
  ensure(after === "pressed 1", "cu_linux_hover_click_after:" + after);
} finally {
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-hover-click");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-hover-click");
harness.remove_run(context);
print("PASS: CEO#1 Linux AT-SPI hover then click by --name (count label read-back)");
return;
