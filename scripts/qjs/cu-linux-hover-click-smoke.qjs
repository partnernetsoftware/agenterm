// CEO#1: hover then click the same GTK button by --name on Linux AT-SPI.
// Acceptance is independent pyatspi read-back only: hover must not advance the
// count label, click must. Typed hover/click usage and host-limit paths must
// hold when --name/--window is missing or the independent pyatspi desktop probe
// is unavailable; typed get-extents --name usage/host-limit paths must hold
// before the native actuate/read-back court; missing named nodes must
// typed-fail a11y_node_not_found. CU tree is not used for effect proof. No
// --coords, screenshot, or coordinate degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-hover-click",
];

const BUTTON_NAME = "Fixture Press";
const MISSING_NODE = "No Such Button";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_hover_click_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_hover_click_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_hover_click_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_hover_click_usage_limit(run_directory, executable) {
  const hover_missing_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "hover", "--window", "1",
  ]);
  ensure(!output_success(hover_missing_name), "cu_linux_hover_click_hover_usage_ok:" + JSON.stringify(hover_missing_name));
  ensure(
    text_at(hover_missing_name, "error.code") === "usage",
    "cu_linux_hover_click_hover_usage_code:" + JSON.stringify(hover_missing_name.error)
  );
  ensure(
    text_at(hover_missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_hover_click_hover_usage_message:" + JSON.stringify(hover_missing_name.error)
  );

  const click_missing = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", "1",
  ]);
  ensure(!output_success(click_missing), "cu_linux_hover_click_click_usage_ok:" + JSON.stringify(click_missing));
  ensure(
    text_at(click_missing, "error.code") === "invalid_input",
    "cu_linux_hover_click_click_usage_code:" + JSON.stringify(click_missing.error)
  );
  ensure(
    text_at(click_missing, "error.message").indexOf("--window") >= 0
      || text_at(click_missing, "error.message").indexOf("--name") >= 0,
    "cu_linux_hover_click_click_usage_message:" + JSON.stringify(click_missing.error)
  );

  const zero_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", "0", "--name", BUTTON_NAME,
  ]);
  ensure(!output_success(zero_handle), "cu_linux_hover_click_zero_handle_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_hover_click_zero_handle_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("--window") >= 0,
    "cu_linux_hover_click_zero_handle_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", BUTTON_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_hover_click_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_hover_click_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_hover_click_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", BUTTON_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_hover_click_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_hover_click_extents_unavailable_code:" + code
  );
}

function assert_hover_click_missing_node(run_directory, executable, handle, label) {
  const hover_missing = run_cu_reply(run_directory, executable, "observe,actuate", [
    "hover", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!output_success(hover_missing), "cu_linux_hover_click_hover_missing_ok_" + label);
  ensure(
    text_at(hover_missing, "error.code") === "a11y_node_not_found",
    "cu_linux_hover_click_hover_missing_code_" + label + ":" + JSON.stringify(hover_missing.error)
  );

  const click_missing = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!output_success(click_missing), "cu_linux_hover_click_click_missing_ok_" + label);
  ensure(
    text_at(click_missing, "error.code") === "a11y_node_not_found",
    "cu_linux_hover_click_click_missing_code_" + label + ":" + JSON.stringify(click_missing.error)
  );
}

function assert_hover_click_host_limit_when_atspi_absent(run_directory, executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
  const hover_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "hover", "--window", "1", "--name", BUTTON_NAME,
  ], env);
  ensure(!output_success(hover_reply), "cu_linux_hover_click_hover_unavailable_ok:" + JSON.stringify(hover_reply));
  const hover_code = text_at(hover_reply, "error.code");
  ensure(
    hover_code === "a11y_backend_failed" || hover_code === "unsupported" || hover_code === "bad_handle",
    "cu_linux_hover_click_hover_unavailable_code:" + hover_code
  );

  const click_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", "1", "--name", BUTTON_NAME,
  ], env);
  ensure(!output_success(click_reply), "cu_linux_hover_click_click_unavailable_ok:" + JSON.stringify(click_reply));
  const click_code = text_at(click_reply, "error.code");
  ensure(
    click_code === "a11y_backend_failed" || click_code === "unsupported" || click_code === "bad_handle",
    "cu_linux_hover_click_click_unavailable_code:" + click_code
  );
}

function independent_atspi_probe(title, mode, expected) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "mode = sys.argv[2]",
    "expected = sys.argv[3] if len(sys.argv) > 3 else ''",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and w.name == title:",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    name = node.name or ''",
    "    if mode == 'press_label' and name.startswith('pressed '):",
    "        return name",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_hover_click_atspi_no_frame')",
    "value = walk(frame)",
    "if value is None:",
    "    raise SystemExit('cu_linux_hover_click_atspi_probe_miss:' + mode)",
    "if expected and value != expected:",
    "    raise SystemExit('cu_linux_hover_click_atspi_mismatch:' + mode + ':' + value + ':' + expected)",
    "print(json.dumps({'mode': mode, 'value': value}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title, mode, expected], {
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_hover_click_atspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function wait_press_label(fixture_title, expected) {
  for (let attempt = 0; attempt < 80; attempt = attempt + 1) {
    const probe = independent_atspi_probe(fixture_title, "press_label", "");
    if (probe.value === expected) { return probe; }
    harness.sleep_ms(100);
  }
  const last = independent_atspi_probe(fixture_title, "press_label", "");
  ensure(last.value === expected, "cu_linux_hover_click_readback:" + last.value + ":" + expected);
  return last;
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_hover_click_executable_missing");
const context = harness.new_context(repo, "cu-linux-hover-click");
const run_directory = rh.join(repo, "target/cu-linux-hover-click-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_hover_click_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP hover / click typed-fail usage when --name or --window is missing");
  assert_hover_click_usage_limit(run_directory, executable);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before actuate/read-back court");
    assert_get_extents_usage_limit(run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
  }

  if (!atspi_available) {
    print("STEP hover / click typed-fail host-limit when independent pyatspi desktop probe is unavailable");
    assert_hover_click_host_limit_when_atspi_absent(run_directory, executable);
    succeeded = 1;
  } else {
  print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;

  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_hover_click_window_wait");

  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_hover_click_window_missing");
  const handle_text = "" + int_at(row, "handle");
  ensure(int_at(row, "handle") > 0, "cu_linux_hover_click_handle:" + JSON.stringify(row));

  print("STEP hover / click typed-fail a11y_node_not_found when the named button is missing");
  assert_hover_click_missing_node(run_directory, executable, handle_text, "before_actuate");

  print("STEP independent AT-SPI read-back reports press label baseline pressed 0");
  const before = independent_atspi_probe(fixture_title, "press_label", "pressed 0");
  ensure(before.value === "pressed 0", "cu_linux_hover_click_before:" + JSON.stringify(before));

  print("STEP hover --name " + BUTTON_NAME + " moves the pointer through AT-SPI GenerateMouseEvent(abs)");
  const hovered = run_cu(run_directory, executable, "observe,actuate", [
    "hover", "--window", handle_text, "--name", BUTTON_NAME,
  ]);
  ensure(
    flag_at(hovered, "data.performed")
      && text_at(hovered, "data.addressing") === "accessibility-tree",
    "cu_linux_hover_click_hover:" + JSON.stringify(hovered.data)
  );

  print("STEP independent pyatspi read-back proves hover alone did not click the button");
  const after_hover = independent_atspi_probe(fixture_title, "press_label", "pressed 0");
  ensure(
    after_hover.value === "pressed 0",
    "cu_linux_hover_click_after_hover:" + JSON.stringify(after_hover)
  );

  print("STEP click --name " + BUTTON_NAME + " on the same node, verified by independent read-back");
  const clicked = run_cu(run_directory, executable, "observe,actuate", [
    "click", "--window", handle_text, "--name", BUTTON_NAME,
  ]);
  ensure(
    flag_at(clicked, "data.performed")
      && text_at(clicked, "data.addressing") === "accessibility-tree",
    "cu_linux_hover_click_click:" + JSON.stringify(clicked.data)
  );

  print("STEP independent pyatspi read-back proves the named click advanced the counter");
  const after = wait_press_label(fixture_title, "pressed 1");
  ensure(after.value === "pressed 1", "cu_linux_hover_click_after:" + JSON.stringify(after));

  harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-hover-click");
  succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_hover_click_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: CEO#1 Linux AT-SPI hover then click by --name with pyatspi read-back and typed hover/click/get-extents usage honesty (no --coords)");
} else {
  print("PASS: CEO#1 Linux AT-SPI hover/click typed-fails with typed get-extents host-limit honesty when independent pyatspi desktop probe is unavailable");
}
return;
