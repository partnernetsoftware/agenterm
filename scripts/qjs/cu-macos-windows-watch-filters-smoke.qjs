// Public macOS black-box court for windows-watch state and event filters.
//
// The court compiles examples/objc/agenterm_ax_fixture.m into an owned Cocoa
// accessory process. The fixture orders windows without activation, and every
// watch is restricted to its exact pid plus primary-window title. No browser,
// network endpoint or unowned window is operated.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.windows-watch.macos-filters",
  "cu.windows-watch.macos-bounds",
  "cu.windows-watch.macos-typed"
];

const WATCH_INTERVAL_MS = 50;
const START_BUFFER_MS = 250;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) { current = rh.field(current, key); }
  return current;
}

function text_at(value, dotted) {
  const current = at(value, dotted);
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function int_at(value, dotted) {
  return rh.int_of(at(value, dotted));
}

function flag_at(value, dotted) {
  return at(value, dotted) === true;
}


function cu_env(run_directory, label) {
  return {
    HOME: run_directory,
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, label + "-audit.jsonl"),
    AGENTERM_CU_RECEIPT_PATH: rh.join(run_directory, label + "-receipts.jsonl")
  };
}

function cu_args(arguments) {
  return ["--target", "current", "--grant", "observe"].concat(arguments);
}

function parse_reply(output, label) {
  const text = ("" + output.stdout).trim();
  ensure(text !== "", "cu_macos_windows_watch_empty_reply:" + label + ":" + output.stderr);
  return JSON.parse(text);
}

function invoke_reply(run_directory, executable, label, arguments) {
  const output = rh.command(executable, cu_args(arguments), {
    cwd: run_directory,
    env: cu_env(run_directory, label),
    timeout_ms: 30000
  });
  return parse_reply(output, label);
}

function invoke_ok(run_directory, executable, label, arguments) {
  const reply = invoke_reply(run_directory, executable, label, arguments);
  ensure(flag_at(reply, "ok"),
    "cu_macos_windows_watch_cli:" + label + ":" + JSON.stringify(reply));
  return reply;
}

function compile_fixture(run_directory, repo) {
  const source = rh.join(repo, "examples/objc/agenterm_ax_fixture.m");
  ensure(rh.is_direct_file(source), "cu_macos_windows_watch_fixture_source_missing");
  const fixture = rh.join(run_directory, "agenterm_ax_fixture");
  const compiled = rh.command("clang", [
    "-fobjc-arc", "-framework", "Cocoa", "-Wall", "-Wextra", "-Werror",
    source, "-o", fixture
  ], { cwd: repo, timeout_ms: 60000 });
  ensure(compiled.success === true && rh.is_direct_file(fixture),
    "cu_macos_windows_watch_fixture_compile:" + compiled.stdout + compiled.stderr);
  return fixture;
}

function wait_for_fixture(run_directory, executable, pid, title) {
  const waited = invoke_ok(run_directory, executable, "fixture-wait", [
    "wait", "--timeout-ms", "5000", "--window-title-contains", title
  ]);
  ensure(flag_at(waited, "data.met"), "cu_macos_windows_watch_fixture_wait");
  const inventory = invoke_ok(run_directory, executable, "fixture-inventory", [
    "windows", "--pid", "" + pid, "--title", title, "--max", "2"
  ]);
  ensure(int_at(inventory, "data.matched") === 1
      && int_at(inventory, "data.returned") === 1
      && flag_at(inventory, "data.truncated") === false,
    "cu_macos_windows_watch_fixture_inventory:" + JSON.stringify(inventory));
  const row = inventory.data.windows[0];
  ensure(int_at(row, "process_id") === pid
      && text_at(row, "title") === title
      && int_at(row, "handle") > 0,
    "cu_macos_windows_watch_fixture_identity:" + JSON.stringify(row));
  return row;
}

function act_window(run_directory, executable, verb, handle, expected_state, label) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe,actuate",
    verb, "--window", "" + handle, "--expect", expected_state
  ], {
    cwd: run_directory,
    env: cu_env(run_directory, label),
    timeout_ms: 30000
  });
  const reply = parse_reply(output, label);
  ensure(flag_at(reply, "ok"),
    "cu_macos_windows_watch_action_reply:" + label + ":" + JSON.stringify(reply));
  ensure(flag_at(reply, "data.verified") && flag_at(reply, "data.frontmost_app_unchanged"),
    "cu_macos_windows_watch_action:" + label + ":" + JSON.stringify(reply));
  if (expected_state === "minimized") {
    ensure(flag_at(reply, "data.after.minimized"),
      "cu_macos_windows_watch_minimized_readback:" + label);
  } else {
    ensure(flag_at(reply, "data.after.minimized") === false,
      "cu_macos_windows_watch_restored_readback:" + label);
  }
}

function watch_args(pid, title, duration_ms, max_events, extra) {
  const arguments = [
    "windows-watch", "--pid", "" + pid, "--title", title,
    "--duration-ms", "" + duration_ms,
    "--interval-ms", "" + WATCH_INTERVAL_MS,
    "--max-events", "" + max_events,
    "--max-windows", "4"
  ];
  for (const item of extra) { arguments.push(item); }
  return arguments;
}

function start_watcher(context, children, executable, label, arguments, timeout_ms) {
  const child = harness.start_child(context, {
    program: executable,
    args: cu_args(arguments),
    current_dir: context.run_directory,
    env: cu_env(context.run_directory, label),
    timeout_ms: timeout_ms + 30000
  }, label);
  children.push(child);
  const started_ms = rh.now_ms();
  ensure(harness.child_state(child) === "running",
    "cu_macos_windows_watch_child_not_running:" + label);
  // windows-watch currently has no public ready seam. Running child state plus
  // this bounded buffer is the explicit test boundary; the fixture is not
  // changed until both checks complete.
  rh.sleep_ms(START_BUFFER_MS);
  ensure(harness.child_state(child) === "running",
    "cu_macos_windows_watch_child_exited_before_buffer:" + label);
  return { child: child, label: label, started_ms: started_ms };
}

function finish_watcher(watcher, timeout_ms) {
  const output = harness.child_wait(watcher.child, timeout_ms);
  ensure(output.timed_out !== true,
    "cu_macos_windows_watch_child_timeout:" + watcher.label);
  const reply = parse_reply(output, watcher.label);
  ensure(flag_at(reply, "ok") && text_at(reply, "command") === "windows-watch",
    "cu_macos_windows_watch_child_reply:" + watcher.label + ":" + JSON.stringify(reply));
  return { data: reply.data, elapsed_ms: rh.now_ms() - watcher.started_ms };
}

function event_count(data, kind, handle) {
  let count = 0;
  for (const event of data.events) {
    if (text_at(event, "kind") === kind && int_at(event, "handle") === handle) {
      count += 1;
    }
  }
  return count;
}

function assert_watch_shape(data, pid, title, duration_ms, max_events, label) {
  ensure(text_at(data, "mechanism") === "libagenterm"
      && text_at(data, "mode") === "poll-diff",
    label + ":mechanism:" + JSON.stringify(data));
  ensure(int_at(data, "duration_ms") === duration_ms
      && int_at(data, "interval_ms") === WATCH_INTERVAL_MS
      && int_at(data, "max_events") === max_events
      && int_at(data, "max_windows") === 4,
    label + ":bounds:" + JSON.stringify(data));
  ensure(int_at(data, "filter.pid") === pid
      && text_at(data, "filter.title") === title,
    label + ":filter:" + JSON.stringify(data.filter));
  ensure(rh.is_array(data.events) && rh.is_array(data.windows), label + ":arrays");
  ensure(int_at(data, "emitted") === data.events.length, label + ":emitted");
  let previous_seq = 0;
  let previous_t = 0;
  for (const event of data.events) {
    ensure(int_at(event, "process_id") === pid && text_at(event, "title") === title,
      label + ":foreign_event:" + JSON.stringify(event));
    ensure(int_at(event, "seq") > previous_seq && int_at(event, "t_ms") >= previous_t,
      label + ":event_order:" + JSON.stringify(event));
    previous_seq = int_at(event, "seq");
    previous_t = int_at(event, "t_ms");
  }
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(rh.is_direct_file(executable), "cu_macos_windows_watch_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-macos-windows-watch-filters");
const run_directory = context.run_directory;
const children = [];
let succeeded = 0;
let failure = "";

try {
  print("STEP compile and identify one owned no-activate Cocoa fixture window");
  const fixture_executable = compile_fixture(run_directory, repo);
  const fixture = harness.start_child(context, {
    program: fixture_executable,
    args: [],
    current_dir: run_directory,
    env: {},
    timeout_ms: 30000
  }, "ax-fixture");
  children.push(fixture);
  const fixture_title = "agenterm-ax-fixture-" + fixture.pid;
  const row = wait_for_fixture(run_directory, executable, fixture.pid, fixture_title);
  const handle = int_at(row, "handle");

  print("STEP --minimized false emits disappeared then appeared at snapshot boundaries");
  const filter_duration = 1500;
  const filter_watch = start_watcher(
    context, children, executable, "filter-minimized",
    watch_args(fixture.pid, fixture_title, filter_duration, 32, ["--minimized", "false"]),
    filter_duration);
  act_window(run_directory, executable, "minimize", handle, "minimized", "filter-minimize");
  rh.sleep_ms(START_BUFFER_MS);
  act_window(run_directory, executable, "restore", handle, "restored", "filter-restore");
  const filter_result = finish_watcher(filter_watch, filter_duration + 10000);
  assert_watch_shape(filter_result.data, fixture.pid, fixture_title,
    filter_duration, 32, "cu_macos_windows_watch_filters");
  ensure(flag_at(filter_result.data, "completed")
      && flag_at(filter_result.data, "truncated") === false
      && text_at(filter_result.data, "filter.minimized") === "false",
    "cu_macos_windows_watch_filter_completion:" + JSON.stringify(filter_result.data));
  ensure(event_count(filter_result.data, "disappeared", handle) >= 1
      && event_count(filter_result.data, "appeared", handle) >= 1,
    "cu_macos_windows_watch_minimized_boundaries:" + JSON.stringify(filter_result.data.events));

  print("STEP --type disappeared filters appeared before the one-event ceiling");
  const bounds_duration = 1200;
  const bounds_watch = start_watcher(
    context, children, executable, "filter-type-bounds",
    watch_args(fixture.pid, fixture_title, bounds_duration, 1,
      ["--minimized", "false", "--type", "disappeared"]),
    bounds_duration);
  act_window(run_directory, executable, "minimize", handle, "minimized", "bounds-minimize");
  rh.sleep_ms(START_BUFFER_MS);
  act_window(run_directory, executable, "restore", handle, "restored", "bounds-restore");
  const bounds_result = finish_watcher(bounds_watch, bounds_duration + 10000);
  assert_watch_shape(bounds_result.data, fixture.pid, fixture_title,
    bounds_duration, 1, "cu_macos_windows_watch_bounds");
  ensure(bounds_result.data.events.length === 1
      && event_count(bounds_result.data, "disappeared", handle) === 1
      && flag_at(bounds_result.data, "completed")
      && flag_at(bounds_result.data, "truncated") === false
      && bounds_result.data.filter.types.length === 1
      && ("" + bounds_result.data.filter.types[0]) === "disappeared",
    "cu_macos_windows_watch_type_before_ceiling:" + JSON.stringify(bounds_result.data));

  print("STEP --occluded follows existing stacking truth or fails with its typed provider error");
  const stacking_truth = rh.field(row, "occluded_percent");
  const wanted_occluded = stacking_truth !== undefined && stacking_truth !== null
    ? rh.int_of(stacking_truth) > 0
    : false;
  const occlusion = invoke_reply(run_directory, executable, "filter-occluded", [
    "windows-watch", "--pid", "" + fixture.pid, "--title", fixture_title,
    "--occluded", wanted_occluded ? "true" : "false",
    "--duration-ms", "0", "--interval-ms", "20",
    "--max-events", "4", "--max-windows", "4"
  ]);
  if (stacking_truth === undefined || stacking_truth === null) {
    ensure(flag_at(occlusion, "ok") === false
        && text_at(occlusion, "error.code") === "windows_watch_filter_unavailable",
      "cu_macos_windows_watch_occlusion_unavailable:" + JSON.stringify(occlusion));
  } else {
    ensure(flag_at(occlusion, "ok"),
      "cu_macos_windows_watch_occlusion_reply:" + JSON.stringify(occlusion));
    ensure(occlusion.data.windows.length === 1
        && int_at(occlusion.data.windows[0], "handle") === handle
        && (int_at(occlusion.data.windows[0], "occluded_percent") > 0) === wanted_occluded,
      "cu_macos_windows_watch_occlusion_truth:" + JSON.stringify(occlusion.data));
  }

  print("STEP --all plus --onscreen false retains the owned minimized window through ABI 1.36");
  act_window(run_directory, executable, "minimize", handle, "minimized", "all-minimize");
  const offscreen = invoke_ok(run_directory, executable, "filter-all-offscreen", [
    "windows-watch", "--pid", "" + fixture.pid, "--title", fixture_title,
    "--all", "--onscreen", "false",
    "--duration-ms", "0", "--interval-ms", "20",
    "--max-events", "4", "--max-windows", "4"
  ]);
  ensure(offscreen.data.windows.length === 1
      && int_at(offscreen.data.windows[0], "handle") === handle
      && flag_at(offscreen.data.windows[0], "minimized")
      && flag_at(offscreen.data.windows[0], "onscreen") === false
      && flag_at(offscreen, "data.filter.all")
      && text_at(offscreen, "data.filter.onscreen") === "false",
    "cu_macos_windows_watch_all_offscreen:" + JSON.stringify(offscreen.data));
  act_window(run_directory, executable, "restore", handle, "restored", "all-restore");

  print("STEP bogus event type and out-of-range max-windows values fail typed");
  const bogus_type = invoke_reply(run_directory, executable, "typed-bogus-type", [
    "windows-watch", "--pid", "" + fixture.pid, "--type", "moved"
  ]);
  ensure(flag_at(bogus_type, "ok") === false && text_at(bogus_type, "error.code") === "usage",
    "cu_macos_windows_watch_bogus_type:" + JSON.stringify(bogus_type));
  for (const bad_max of ["0", "10001"]) {
    const invalid = invoke_reply(run_directory, executable, "typed-max-" + bad_max, [
      "windows-watch", "--pid", "" + fixture.pid,
      "--duration-ms", "0", "--max-windows", bad_max
    ]);
    ensure(flag_at(invalid, "ok") === false
        && text_at(invalid, "error.code") === "invalid_input",
      "cu_macos_windows_watch_invalid_max:" + bad_max + ":" + JSON.stringify(invalid));
  }
  const overflow = invoke_reply(run_directory, executable, "typed-inventory-overflow", [
    "windows-watch", "--pid", "" + fixture.pid,
    "--duration-ms", "0", "--max-events", "4", "--max-windows", "1"
  ]);
  ensure(flag_at(overflow, "ok") === false
      && text_at(overflow, "error.code") === "windows_watch_inventory_truncated"
      && int_at(overflow, "error.detail.max_windows") === 1
      && int_at(overflow, "error.detail.observed_at_least") === 2,
    "cu_macos_windows_watch_inventory_overflow:" + JSON.stringify(overflow));
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, children, succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  for (const id of declared_evidence) {
    harness.emit_evidence(context, declared_evidence, id);
  }
  harness.remove_run(context);
  print("PASS: macOS windows-watch applies state and event filters before bounded diff retention");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
