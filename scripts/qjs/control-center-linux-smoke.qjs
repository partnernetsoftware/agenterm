// Prove the Linux Control Center against one caller-selected native IPC
// authority. The live renderer owns both its structured frame facts and the
// exact PNG bytes. X11 additionally proves compositor-observed focus behavior;
// Wayland keeps the portable no-activate and same-owner focus-request proof.
//
// Args:
//   --list-evidence
// or:
//   REPO CONTROL_CENTER_EXE SERVER_EXE CLI_EXE [--backend auto|x11|wayland]
//
// Headless hosts and explicitly requested unavailable display backends return a
// typed Unsupported skip before creating a test run or any screenshot.
//
// Ported from scripts/rh/control-center-linux-smoke.rh; runs under
// `--profile tool`. The server and the renderer are long-lived door handles
// (harness.start / state / wait / kill). Where rh's host gave a child facts
// the door does not:
//   - `child.id` (the pid): the child is started through `/bin/sh -c`, which
//     writes `$$` to a file and then `exec`s the real program, so the handle
//     owns the program itself (same pid) and the pid is read back from the
//     file. Server stdout/stderr go to files in the same wrapper (rh's
//     `stdout_file`/`stderr_file`).
//   - `std::process::list()`: `kill -0 PID` is the presence probe.
//   - `child.window_key(k)` on X11 was XTest to the foreground window;
//     `xdotool key K` is the same request, and xdotool is already a
//     precondition of the X11 journey. On Wayland rh's host answered a typed
//     `process_window_unsupported`; the door has no window op, so that
//     branch is a gap (see `window_key`).
//   - `rh::image::inspect_png`: no door op decodes a PNG; `inspect_png` is a
//     gap and fails closed.
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";
import * as path from "lib/path";

const declared_evidence = [
  "control-center.linux-caller-endpoint",
  "control-center.linux-renderer-evidence",
  "control-center.linux-native-cockpit-input",
  "control-center.linux-no-activate-focus-reuse",
  "control-center.linux-server-recovery",
  "control-center.linux-renderer-replacement",
  "control-center.linux-process-isolation"
];

function gap(what) {
  throw "control_center_linux_gap:" + what;
}

function process_output_text(output) {
  return output.stdout + output.stderr;
}

function json_from_output(output) {
  return JSON.parse("" + output.stdout + output.stderr);
}

function registry_owner_pid(registry) {
  return 0 + rh.parse_file(registry).pid;
}

function tab_id_at_index(tabs, target_index) {
  let index = 0;
  for (const tab of tabs) {
    if (index === target_index) { return "" + tab.id; }
    index = index + 1;
  }
  throw "control_center_linux_tab_id_at_index_missing";
}

function find_tab_index(tabs, wanted_tab_id) {
  const wanted = "" + wanted_tab_id;
  let index = 0;
  for (const tab of tabs) {
    if ("" + tab.id === wanted) { return index; }
    index = index + 1;
  }
  return -1;
}

function has_nonempty_env(name) {
  if (!rh.has_env(name)) { return false; }
  return ("" + rh.env_or(name, "")) !== "";
}

function emit_linux_evidence(context, id) {
  const id_text = "" + id;
  if (!rh.array_has(declared_evidence, id_text)) {
    throw "control_center_linux_undeclared_evidence:" + id_text;
  }
  harness.emit_evidence(context, declared_evidence, id_text);
}

function unsupported(code, message, backend) {
  print("SKIP " + JSON.stringify({
    schema_version: 1,
    suite: "control-center-linux-smoke",
    result_class: "skipped",
    failure: { kind: "Unsupported", code: "" + code, message: "" + message },
    display_backend: "" + backend,
    evidence_emitted: []
  }));
}

// rh's `native_command`: the harness spec minus the TCP address, instance
// and endpoint variables, plus the registry path and the backend's display
// exclusion.
function native_spec(context, program, registry, endpoint, backend, args) {
  const spec = harness.configured_spec(context, "" + program, args);
  spec.env = {
    AGENTERM_WORKSPACE_PATH: "" + context.workspace_path,
    AGENTERM_SETTINGS_PATH: "" + context.settings_path,
    AGENTERM_INSTANCE_DIR: "" + context.instance_directory,
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_CC_REGISTRY_PATH: "" + registry
  };
  const removed = ["AGENTERM_IPC_ADDRESS", "AGENTERM_IPC_ENDPOINT", "AGENTERM_INSTANCE"];
  if ("" + backend === "x11") { removed.push("WAYLAND_DISPLAY"); }
  if ("" + backend === "wayland") { removed.push("DISPLAY"); }
  spec.env_remove = removed;
  spec.timeout_ms = 15000;
  return spec;
}

function invoke(context, program, registry, endpoint, backend, args, expected_failure) {
  const output = rh.run_spec(native_spec(context, program, registry, endpoint, backend, args));
  harness.append_command_record(context, args, output, expected_failure, [endpoint]);
  if (expected_failure !== 0) {
    harness.require(!output.success, "expected command failure");
  } else {
    harness.require(output.success, "command_failed:" + output.stdout + output.stderr);
  }
  return output;
}

function json_command(context, program, registry, endpoint, backend, args) {
  return json_from_output(invoke(context, program, registry, endpoint, backend, args, 0));
}

function child_exited_text(child) {
  const exited = harness.wait(child.handle, 2000);
  return exited.stderr;
}

function wait_active_tab(context, control_center, registry, endpoint, backend, child, target_tab_id, expected_server_pid, expected_server_epoch, code) {
  const endpoint_text = "" + endpoint;
  const target_text = "" + target_tab_id;
  const code_text = "" + code;
  let last = "";
  for (let attempt = 0; attempt < 160; attempt = attempt + 1) {
    const args = ["snapshot", "--json", "--endpoint", endpoint_text];
    const output = rh.run_spec(native_spec(context, control_center, registry, endpoint_text, backend, args));
    last = process_output_text(output);
    if (output.success) {
      const snapshot = json_from_output(output);
      if (snapshot.server_state === "connected"
          && snapshot.connected_server.pid === expected_server_pid
          && snapshot.connected_server.epoch === expected_server_epoch
          && snapshot.connected_server.endpoint === endpoint_text
          && snapshot.connected_server.active_tab_id === target_text) {
        harness.append_command_record(context, args, output, 0, [endpoint_text]);
        return snapshot;
      }
    }
    if (harness.state(child.handle) === "exited") {
      throw code_text + "_renderer_exited:" + child_exited_text(child);
    }
    rh.sleep_ms(25);
  }
  throw code_text + "_timeout:" + last;
}

function invoke_activate(context, program, registry, endpoint, backend, args) {
  const spec = native_spec(context, program, registry, endpoint, backend, args);
  spec.env = {
    AGENTERM_WORKSPACE_PATH: "" + context.workspace_path,
    AGENTERM_SETTINGS_PATH: "" + context.settings_path,
    AGENTERM_INSTANCE_DIR: "" + context.instance_directory,
    AGENTERM_CC_REGISTRY_PATH: "" + registry
  };
  spec.env_remove.push("AGENTERM_NO_ACTIVATE");
  const output = rh.run_spec(spec);
  harness.append_command_record(context, args, output, 0, [endpoint]);
  harness.require(output.success, "activate_command_failed:" + output.stdout + output.stderr);
}

// rh's `bounded_record_text(text, 2048)` for a diagnostic file. The harness
// version slices (an engine wall); this keeps whole lines up to the limit.
function bounded_lines(text, limit) {
  if (text.length <= limit) { return text; }
  let kept = "";
  for (const line of text.split("\n")) {
    if (kept.length + line.length + 1 > limit) { break; }
    kept = kept === "" ? line : kept + "\n" + line;
  }
  return kept + "\n<agenterm-command-output-truncated>\n";
}

function read_diagnostic_file(p) {
  if (!rh.exists(p)) { return "<missing>"; }
  return bounded_lines(rh.read_text(p), 2048);
}

function wait_protocol(context, cli, registry, endpoint, backend, child, stdout_path, stderr_path, code) {
  const endpoint_text = "" + endpoint;
  const code_text = "" + code;
  const args = ["cli", "--endpoint", endpoint_text, "protocol-info", "--running"];
  for (let attempt = 0; attempt < 600; attempt = attempt + 1) {
    const output = rh.run_spec(native_spec(context, cli, registry, endpoint_text, backend, args));
    if (output.success) {
      harness.append_command_record(context, args, output, 0, [endpoint_text]);
      return json_from_output(output);
    }
    if (harness.state(child.handle) === "exited") {
      throw code_text + "_early_exit:" + child_exited_text(child);
    }
    rh.sleep_ms(25);
  }
  const diagnostic_output = rh.run_spec(native_spec(context, cli, registry, endpoint_text, backend, args));
  throw code_text + "_timeout:pid=" + child.pid
    + ":state=" + harness.state(child.handle)
    + ":registry_exists=" + (rh.exists(registry) ? 1 : 0)
    + ":probe_stdout=" + diagnostic_output.stdout
    + ":probe_stderr=" + diagnostic_output.stderr
    + ":server_stdout=" + read_diagnostic_file(stdout_path)
    + ":server_stderr=" + read_diagnostic_file(stderr_path);
}

function wait_registry(p, expected_pid, child, code) {
  for (let attempt = 0; attempt < 240; attempt = attempt + 1) {
    if (rh.exists(p)) {
      let candidate = null;
      let parsed = false;
      try {
        candidate = rh.parse_file(p);
        parsed = true;
      } catch (error) {
        parsed = false;
      }
      if (parsed && candidate !== null && typeof candidate === "object") {
        const identity = "" + candidate.process_start_identity;
        if (candidate.schema_version === 2 && candidate.pid === expected_pid && identity !== "") {
          return candidate;
        }
      }
    }
    if (harness.state(child.handle) === "exited") {
      throw code + "_early_exit:" + child_exited_text(child);
    }
    rh.sleep_ms(20);
  }
  throw code + "_timeout";
}

// rh: `registry.sub_string(0, len - 4) + "window"` -- the `.json` registry's
// sibling `.window` file. No `slice` here: rebuild around the last `.json`.
function window_path_for(registry_text) {
  const parts = registry_text.split(".json");
  let out = parts[0];
  for (let i = 1; i < parts.length - 1; i = i + 1) { out = out + ".json" + parts[i]; }
  return out + ".window";
}

function wait_native_window(registry, expected_pid, child, code) {
  const registry_text = "" + registry;
  const code_text = "" + code;
  harness.require(registry_text.endsWith(".json"), "control_center_linux_registry_extension");
  const p = window_path_for(registry_text);
  for (let attempt = 0; attempt < 240; attempt = attempt + 1) {
    if (rh.exists(p)) {
      const identity = ("" + rh.read_text(p)).trim();
      if (identity !== "") { return identity; }
    }
    if (harness.state(child.handle) === "exited") {
      throw code_text + "_early_exit:" + child_exited_text(child);
    }
    rh.sleep_ms(20);
  }
  throw code_text + "_timeout:" + expected_pid;
}

function wait_exit(child, code) {
  for (let attempt = 0; attempt < 240; attempt = attempt + 1) {
    if (harness.state(child.handle) === "exited") {
      return harness.wait(child.handle, 2000);
    }
    rh.sleep_ms(20);
  }
  throw code;
}

// rh's `std::process::list()` scan; the door has no process list, and
// `kill -0` asks the kernel the same question.
function process_present(pid) {
  return rh.command_status("kill", ["-0", "" + pid], { timeout_ms: 2000 }) === 0;
}

function wait_process_gone(pid, code) {
  for (let attempt = 0; attempt < 240; attempt = attempt + 1) {
    if (!process_present(pid)) { return; }
    rh.sleep_ms(20);
  }
  throw code;
}

function wait_capture(context, control_center, registry, endpoint, backend, child, output_path, required_state, code) {
  const endpoint_text = "" + endpoint;
  const required_state_text = "" + required_state;
  const code_text = "" + code;
  let last_document = "no successful screenshot response";
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    const args = ["screenshot", "--output", "" + output_path, "--json"];
    const capture = rh.run_spec(native_spec(context, control_center, registry, endpoint_text, backend, args));
    if (capture.success) {
      harness.append_command_record(context, args, capture, 0, [endpoint_text]);
      const document = json_from_output(capture);
      last_document = JSON.stringify(document);
      if (document.rendered_snapshot !== undefined && document.rendered_snapshot.server_state === required_state_text) {
        return document;
      }
      if (document.capture_strategy !== undefined && document.capture_strategy !== "renderer-request") {
        throw code_text + "_wrong_capture_strategy:" + last_document;
      }
    }
    if (harness.state(child.handle) === "exited") {
      throw code_text + "_early_exit:" + child_exited_text(child);
    }
    rh.sleep_ms(25);
  }
  throw code_text + "_timeout:" + last_document;
}

function prove_pty(context, cli, registry, endpoint, backend, label) {
  const endpoint_text = "" + endpoint;
  const label_text = "" + label;
  const marker = "AGENTERM_CC_LINUX_" + label_text + "_" + context.run_id;
  const created = invoke(context, cli, registry, endpoint, backend, [
    "cli", "--endpoint", endpoint_text,
    "new-window", "-d", "-P", "-F", "#{window_id}",
    "-n", "cc-" + label_text + "-" + context.run_id,
    "--", "/bin/sh"
  ], 0);
  const tab_id = ("" + created.stdout).trim();
  harness.require(tab_id.startsWith("@"), "control_center_linux_stable_tab_id");
  invoke(context, cli, registry, endpoint, backend, [
    "cli", "--endpoint", endpoint_text, "send-keys", "-t", tab_id, "-l", "echo " + marker
  ], 0);
  invoke(context, cli, registry, endpoint, backend, [
    "cli", "--endpoint", endpoint_text, "send-keys", "-t", tab_id, "Enter"
  ], 0);
  invoke(context, cli, registry, endpoint, backend, [
    "cli", "--endpoint", endpoint_text, "wait-pane", "-t", tab_id, "--contains", marker, "--timeout-ms", "5000"
  ], 0);
  const captured = invoke(context, cli, registry, endpoint, backend, [
    "cli", "--endpoint", endpoint_text, "capture-pane", "-p", "-t", tab_id, "--max-bytes", "16384"
  ], 0);
  harness.require(("" + captured.stdout).includes(marker), "control_center_linux_pty_capture");
  return tab_id;
}

function x11_focus_tools_available() {
  const xdotool_output = rh.command("which", ["xdotool"], { timeout_ms: 2000 });
  const xmessage_output = rh.command("which", ["xmessage"], { timeout_ms: 2000 });
  return xdotool_output.success && xmessage_output.success;
}

function xdotool(context, args, expected_failure) {
  const output = rh.command("xdotool", args, { timeout_ms: 3000 });
  harness.append_command_record(context, args, output, expected_failure, []);
  if (expected_failure === 0) {
    harness.require(output.success, "control_center_linux_xdotool_failed:" + output.stderr);
  }
  return output;
}

function wait_x11_window(context, title, child, code) {
  const title_text = "" + title;
  const code_text = "" + code;
  let last = "";
  for (let attempt = 0; attempt < 120; attempt = attempt + 1) {
    const output = xdotool(context, ["search", "--onlyvisible", "--name", title_text], 1);
    last = process_output_text(output);
    if (output.success) {
      for (const line of ("" + output.stdout).split("\n")) {
        const line_text = line.trim();
        if (line_text !== "") {
          const name = xdotool(context, ["getwindowname", line_text], 1);
          if (name.success && ("" + name.stdout).trim() === title_text) { return line_text; }
        }
      }
    }
    if (harness.state(child.handle) === "exited") {
      throw code_text + "_early_exit:" + child_exited_text(child);
    }
    rh.sleep_ms(25);
  }
  throw code_text + ":" + last;
}

function active_x11_window(context) {
  const value = ("" + xdotool(context, ["getactivewindow"], 0).stdout).trim();
  harness.require(value !== "", "control_center_linux_x11_active_window_empty");
  return value;
}

function activate_x11_window(context, identity) {
  xdotool(context, ["windowactivate", "--sync", "" + identity], 0);
}

function wait_x11_active(context, identity, code) {
  const identity_text = "" + identity;
  for (let attempt = 0; attempt < 120; attempt = attempt + 1) {
    if (active_x11_window(context) === identity_text) { return; }
    rh.sleep_ms(25);
  }
  throw "" + code;
}

function start_x11_focus_witness(title, pid_file) {
  const title_text = "" + title;
  return start_with_pid({
    program: "xmessage",
    args: ["-name", "agenterm-focus-witness", "-title", title_text, "-center", "-buttons", "OK:0", title_text]
  }, pid_file);
}

// rh's `child.window_key(key)`. X11: XTest to the foreground window, which
// the journey has just made the Control Center; `xdotool key` is that
// request. Wayland: rh's host answered typed `process_window_unsupported`
// and the journey asserts that answer; the door has no window op to give
// it, so the site is a gap rather than a simulated answer.
function window_key(context, backend, key) {
  if ("" + backend === "x11") {
    xdotool(context, ["key", "--clearmodifiers", "" + key], 0);
    return;
  }
  gap("process_window_key_" + backend);
}

// rh's `rh::image::inspect_png(path)` -> {width, height, samples, luminance}.
// No door op decodes an image; a text door cannot even read the bytes.
function inspect_png(p) {
  gap("image_inspect_png:" + p);
}

function remove_native_runtime(runtime) {
  harness.require(runtime.startsWith("/tmp/agt-cc-linux-"), "control_center_linux_runtime_not_owned");
  if (rh.exists(runtime)) { rh.remove_dir_all(runtime); }
}

function prepare_private_runtime(runtime) {
  harness.require(runtime.startsWith("/tmp/agt-cc-linux-"), "control_center_linux_runtime_not_owned");
  rh.create_dir_all(runtime);
  const metadata = rh.symlink_metadata(runtime);
  harness.require(
    metadata.is_dir && !metadata.is_symlink && !metadata.is_reparse_point,
    "control_center_linux_runtime_indirect"
  );

  // create_dir_all observes the runner umask, which is commonly 0022 on
  // Linux CI. The production Unix IPC contract intentionally rejects that
  // resulting 0755 directory, so make the smoke-owned authority explicitly
  // private before any server or client can observe it.
  const chmod_output = rh.command("chmod", ["0700", "--", runtime], { timeout_ms: 2000 });
  harness.require(chmod_output.success, "control_center_linux_runtime_chmod_failed:" + chmod_output.stderr);

  const id_output = rh.command("id", ["-u"], { timeout_ms: 2000 });
  harness.require(id_output.success, "control_center_linux_effective_uid_failed:" + id_output.stderr);
  const effective_uid = ("" + id_output.stdout).trim();
  harness.require(effective_uid !== "", "control_center_linux_effective_uid_empty");

  const stat_output = rh.command("stat", ["-c", "%u:%a", "--", runtime], { timeout_ms: 2000 });
  harness.require(stat_output.success, "control_center_linux_runtime_stat_failed:" + stat_output.stderr);
  const ownership = ("" + stat_output.stdout).trim();
  harness.require(
    ownership === effective_uid + ":700",
    "control_center_linux_runtime_not_private_to_effective_uid:" + ownership
  );
}

// Start `spec` through `/bin/sh -c`: the shell writes its own pid to
// `pid_file` and `exec`s the program in place, so the door handle owns the
// program (same pid) and the script learns the pid rh's `child.id` gave it.
// With `stdout_log`/`stderr_log` the shell also redirects the program's
// streams to those files (rh's `stdout_file`/`stderr_file`); without them
// the door captures the streams until `wait`.
// Answers {handle, pid}.
function start_with_pid(spec, pid_file, stdout_log, stderr_log) {
  const wrapped = { program: "/bin/sh", args: [] };
  if (stdout_log !== undefined) {
    wrapped.args = ["-c", "printf '%s' \"$$\" > \"$0\"; o=\"$1\"; e=\"$2\"; shift 2; exec \"$@\" >\"$o\" 2>\"$e\"",
      "" + pid_file, "" + stdout_log, "" + stderr_log];
  } else {
    wrapped.args = ["-c", "printf '%s' \"$$\" > \"$0\"; exec \"$@\"", "" + pid_file];
  }
  wrapped.args.push("" + spec.program);
  for (const a of spec.args) { wrapped.args.push("" + a); }
  if (spec.env !== undefined) { wrapped.env = spec.env; }
  if (spec.env_remove !== undefined) { wrapped.env_remove = spec.env_remove; }
  if (spec.current_dir !== undefined) { wrapped.current_dir = spec.current_dir; }
  rh.try_remove_file("" + pid_file);
  const handle = harness.start(wrapped);
  let pid = 0;
  for (let attempt = 0; attempt < 200; attempt = attempt + 1) {
    if (rh.exists("" + pid_file)) {
      const text = rh.read_text("" + pid_file).trim();
      if (text !== "") { pid = Number(text); break; }
    }
    if (harness.state(handle) === "exited") { break; }
    rh.sleep_ms(10);
  }
  harness.require(pid > 0, "control_center_linux_child_pid_unavailable:" + pid_file);
  return { handle: handle, pid: pid };
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return 0;
}

harness.require(args.length >= 4, "expected: REPO CONTROL_CENTER_EXE SERVER_EXE CLI_EXE [--backend auto|x11|wayland]");
const repo = rh.absolute(args[0]);
let control_center_value = args[1];
let server_executable_value = args[2];
let cli_executable_value = args[3];
let requested_backend = "auto";
let option = 4;
while (option < args.length) {
  harness.require(option + 1 < args.length, "control_center_linux_option_value");
  const value = args[option + 1];
  if (args[option] === "--backend") {
    harness.require(value === "auto" || value === "x11" || value === "wayland", "control_center_linux_backend_invalid:" + value);
    requested_backend = value;
  } else if (args[option] === "--control-center") {
    control_center_value = value;
  } else if (args[option] === "--server") {
    server_executable_value = value;
  } else if (args[option] === "--cli") {
    cli_executable_value = value;
  } else {
    throw "control_center_linux_unknown_option:" + args[option];
  }
  option = option + 2;
}

const x11_available = has_nonempty_env("DISPLAY");
const wayland_available = has_nonempty_env("WAYLAND_DISPLAY");
let backend = "";
if (requested_backend === "x11") {
  if (!x11_available) {
    unsupported("control_center_linux_x11_display_unavailable", "--backend x11 requires DISPLAY", "x11");
    return 0;
  }
  backend = "x11";
} else if (requested_backend === "wayland") {
  if (!wayland_available) {
    unsupported("control_center_linux_wayland_display_unavailable", "--backend wayland requires WAYLAND_DISPLAY", "wayland");
    return 0;
  }
  backend = "wayland";
} else if (wayland_available) {
  backend = "wayland";
} else if (x11_available) {
  backend = "x11";
} else {
  unsupported(
    "control_center_linux_display_unavailable",
    "native Control Center evidence requires DISPLAY or WAYLAND_DISPLAY",
    "none"
  );
  return 0;
}

if (backend === "x11" && !x11_focus_tools_available()) {
  unsupported(
    "control_center_linux_x11_focus_probe_unavailable",
    "the X11 journey requires xdotool and xmessage for black-box focus evidence",
    backend
  );
  return 0;
}

const control_center = rh.absolute(control_center_value);
const server_executable = rh.absolute(server_executable_value);
const cli_executable = rh.absolute(cli_executable_value);
harness.require(rh.exists(control_center), "control_center_linux_executable_missing:" + control_center);
harness.require(rh.exists(server_executable), "control_center_linux_executable_missing:" + server_executable);
harness.require(rh.exists(cli_executable), "control_center_linux_executable_missing:" + cli_executable);

const context = harness.new_context(repo, "control-center-linux");
const runtime = "/tmp/agt-cc-linux-" + rh.pid() + "-" + rh.now_ms();
prepare_private_runtime(runtime);
const endpoint = "unix:" + path.join(runtime, "authority.sock");
const run_directory = "" + context.run_directory;
const evidence_parent = path.parent(context.evidence_path);
const registry = path.join(run_directory, "control-center-registry.json");
const cockpit_png = path.join(evidence_parent, "control-center-live-cockpit-linux.png");
const keyboard_input_png = path.join(evidence_parent, "control-center-keyboard-input-linux.png");
const pointer_input_png = path.join(evidence_parent, "control-center-pointer-input-linux.png");
const refresh_png = path.join(evidence_parent, "control-center-refresh-linux.png");
const replacement_png = path.join(evidence_parent, "control-center-replacement-linux.png");
const durable_directory = path.join(repo, "dist/evidence");
const durable_png = path.join(durable_directory, "control-center-live-cockpit-linux.png");
const owned_children = [];
let succeeded = false;
let failure = "";

try {
  print("STEP start caller-selected native Unix IPC authority and PTY");
  const server_args = ["server", "--endpoint", "" + endpoint];
  const server_stdout = path.join(run_directory, "server.stdout.log");
  const server_stderr = path.join(run_directory, "server.stderr.log");
  const server = start_with_pid(
    native_spec(context, server_executable, registry, endpoint, backend, server_args),
    path.join(run_directory, "server.pid"), server_stdout, server_stderr
  );
  owned_children.push(server.handle);
  const protocol = wait_protocol(
    context, cli_executable, registry, endpoint, backend, server, server_stdout, server_stderr,
    "control_center_linux_server"
  );
  harness.require(
    protocol.pid === server.pid && protocol.endpoint === endpoint && ("" + protocol.endpoint).startsWith("unix:"),
    "control_center_linux_native_authority"
  );
  const baseline_tab = prove_pty(context, cli_executable, registry, endpoint, backend, "baseline");
  const native_input_tab = prove_pty(context, cli_executable, registry, endpoint, backend, "native-input");

  const selected = json_command(context, control_center, registry, endpoint, backend, ["snapshot", "--json", "--endpoint", "" + endpoint]);
  const selected_epoch = "" + selected.connected_server.epoch;
  harness.require(
    selected.server_state === "connected"
      && selected.connected_server.pid === protocol.pid
      && selected.connected_server.endpoint === endpoint,
    "control_center_linux_caller_endpoint"
  );
  emit_linux_evidence(context, "control-center.linux-caller-endpoint");

  let witness_window = "";
  let witness = null;
  if (backend === "x11") {
    print("STEP establish an independently focused X11 witness");
    const witness_title = "AgenTerm focus witness " + context.run_id;
    witness = start_x11_focus_witness(witness_title, path.join(run_directory, "witness.pid"));
    owned_children.push(witness.handle);
    witness_window = wait_x11_window(context, witness_title, witness, "control_center_linux_x11_witness_window_timeout");
    activate_x11_window(context, witness_window);
    wait_x11_active(context, witness_window, "control_center_linux_x11_witness_focus_timeout");
  }

  print("STEP no-activate opens one renderer and publishes exact frame evidence");
  const open_args = ["open", "--no-activate", "--endpoint", "" + endpoint];
  const cc = start_with_pid(
    native_spec(context, control_center, registry, endpoint, backend, open_args),
    path.join(run_directory, "cc.pid")
  );
  owned_children.push(cc.handle);
  wait_registry(registry, cc.pid, cc, "control_center_linux_registry");
  const native_window = wait_native_window(registry, cc.pid, cc, "control_center_linux_native_window");
  const capture = wait_capture(
    context, control_center, registry, endpoint, backend, cc, cockpit_png, "connected",
    "control_center_linux_first_frame"
  );
  const rendered = inspect_png(cockpit_png);
  const tab_count = 0 + selected.connected_server.tabs.length;
  const expected_tabs = "" + tab_count + " tabs";
  harness.require(
    capture.owner_pid === cc.pid
      && capture.renderer === "native"
      && capture.output === cockpit_png
      && capture.width === rendered.width
      && capture.height === rendered.height
      && capture.width === capture.rendered_snapshot.physical_width
      && capture.height === capture.rendered_snapshot.physical_height
      && capture.rendered_snapshot.scale_factor >= 1.0
      && capture.rendered_snapshot.selected_view === "cockpit"
      && capture.rendered_snapshot.server_endpoint === endpoint
      && ("" + capture.rendered_snapshot.window_title).includes(expected_tabs)
      && capture.sha256 === rh.sha256_file(cockpit_png)
      && capture.bytes >= 1000
      && rendered.samples > 0
      && rendered.luminance > 1.0
      && rendered.luminance < 254.9,
    "control_center_linux_renderer_evidence"
  );
  if (backend === "x11") {
    // The passive launch contract is complete before the journey grants
    // foreground authority for real XTest input.
    harness.require(active_x11_window(context) === witness_window, "control_center_linux_no_activate_stole_focus");
  }
  rh.create_dir_all(durable_directory);
  rh.copy(cockpit_png, durable_png);
  harness.require(rh.sha256_file(durable_png) === capture.sha256, "control_center_linux_durable_png_hash");
  emit_linux_evidence(context, "control-center.linux-renderer-evidence");

  print("STEP native keyboard and pointer obey the Linux display contract");
  const baseline_index = find_tab_index(selected.connected_server.tabs, baseline_tab);
  const native_input_index = find_tab_index(selected.connected_server.tabs, native_input_tab);
  harness.require(
    baseline_index !== -1 && baseline_index < 3 && native_input_index !== -1 && native_input_index < 3
      && baseline_tab !== native_input_tab,
    "control_center_linux_native_input_targets_not_visible"
  );
  if (backend === "x11") {
    print("STEP explicitly focus the Control Center before XTest input");
    activate_x11_window(context, native_window);
    wait_x11_active(context, native_window, "control_center_linux_native_input_focus_timeout");

    window_key(context, backend, "Home");
    for (let step = 0; step < native_input_index; step = step + 1) { window_key(context, backend, "Down"); }
    window_key(context, backend, "Return");
    const keyboard_selected = wait_active_tab(
      context, control_center, registry, endpoint, backend, cc, native_input_tab, server.pid, selected_epoch,
      "control_center_linux_native_keyboard_navigation"
    );
    harness.require(
      keyboard_selected.connected_server.active_tab_id === native_input_tab
        && keyboard_selected.connected_server.pid === server.pid
        && keyboard_selected.connected_server.epoch === selected_epoch
        && keyboard_selected.connected_server.endpoint === endpoint
        && harness.state(cc.handle) === "running"
        && registry_owner_pid(registry) === cc.pid
        && active_x11_window(context) === native_window,
      "control_center_linux_native_keyboard_navigation_truth"
    );
    const keyboard_receipt = wait_capture(
      context, control_center, registry, endpoint, backend, cc, keyboard_input_png, "connected",
      "control_center_linux_native_keyboard_receipt"
    );
    harness.require(
      keyboard_receipt.owner_pid === cc.pid
        && keyboard_receipt.rendered_snapshot.last_native_input !== undefined
        && keyboard_receipt.rendered_snapshot.last_native_input.kind === "key-pressed"
        && keyboard_receipt.rendered_snapshot.last_native_input.key === "enter"
        && !keyboard_receipt.rendered_snapshot.last_native_input.repeat,
      "control_center_linux_native_keyboard_receipt_truth"
    );

    // The projection contract fixes every line before the three clickable
    // tab rows: two chrome lines, six product lines, the Tabs-total line,
    // one detail row per tab (16-row cap plus a collapse marker), the
    // remaining view lines, and the Tabs help line. The Unix adapter maps
    // each 26-pixel body row to one Cockpit line. Only the strip's first
    // rendered row is guaranteed inside the 480-px-tall client, so the
    // pointer target is that row -- never the keyboard-selected tab.
    let visible_start = 0;
    if (native_input_index > 0) { visible_start = native_input_index - 1; }
    let maximum_start = 0;
    if (tab_count > 3) { maximum_start = tab_count - 3; }
    if (visible_start > maximum_start) { visible_start = maximum_start; }
    const pointer_index = visible_start;
    harness.require(
      pointer_index !== native_input_index && pointer_index < tab_count && baseline_tab !== native_input_tab,
      "control_center_linux_native_pointer_target_not_visible"
    );
    const pointer_target = tab_id_at_index(selected.connected_server.tabs, pointer_index);
    window_key(context, backend, "Home");
    for (let step = 0; step < pointer_index; step = step + 1) { window_key(context, backend, "Down"); }
    window_key(context, backend, "Return");
    const pointer_selected = wait_active_tab(
      context, control_center, registry, endpoint, backend, cc, pointer_target, server.pid, selected_epoch,
      "control_center_linux_native_pointer_navigation"
    );
    harness.require(
      pointer_selected.connected_server.active_tab_id === pointer_target
        && pointer_selected.connected_server.pid === server.pid
        && pointer_selected.connected_server.epoch === selected_epoch
        && pointer_selected.connected_server.endpoint === endpoint
        && harness.state(cc.handle) === "running"
        && registry_owner_pid(registry) === cc.pid
        && active_x11_window(context) === native_window,
      "control_center_linux_native_pointer_navigation_truth"
    );
    const pointer_receipt = wait_capture(
      context, control_center, registry, endpoint, backend, cc, pointer_input_png, "connected",
      "control_center_linux_native_pointer_receipt"
    );
    harness.require(
      pointer_receipt.owner_pid === cc.pid
        && pointer_receipt.rendered_snapshot.last_native_input !== undefined
        && pointer_receipt.rendered_snapshot.last_native_input.kind === "key-pressed"
        && pointer_receipt.rendered_snapshot.last_native_input.key === "enter"
        && !pointer_receipt.rendered_snapshot.last_native_input.repeat,
      "control_center_linux_native_pointer_receipt_truth"
    );

    print("STEP restore the independent foreground witness after native input");
    activate_x11_window(context, witness_window);
    wait_x11_active(context, witness_window, "control_center_linux_native_input_witness_restore_timeout");
    emit_linux_evidence(context, "control-center.linux-native-cockpit-input");
  } else {
    let input_failure = "";
    try {
      window_key(context, backend, "Home");
    } catch (error) {
      input_failure = "control_center_linux_smoke_failed";
    }
    harness.require(
      input_failure.includes("process_window_unsupported") && input_failure.includes("unsupported"),
      "control_center_linux_wayland_input_not_typed_unsupported:" + input_failure
    );
    const unchanged = json_command(context, control_center, registry, endpoint, backend, ["snapshot", "--json", "--endpoint", "" + endpoint]);
    harness.require(
      unchanged.connected_server.active_tab_id === selected.connected_server.active_tab_id
        && unchanged.connected_server.pid === server.pid
        && unchanged.connected_server.epoch === selected_epoch
        && unchanged.connected_server.endpoint === endpoint
        && harness.state(cc.handle) === "running"
        && registry_owner_pid(registry) === cc.pid,
      "control_center_linux_wayland_unsupported_changed_state"
    );
  }

  print("STEP repeated no-activate and focus requests reuse the same owner");
  invoke(context, control_center, registry, endpoint, backend, ["open", "--no-activate", "--endpoint", "" + endpoint], 0);
  const reused = json_command(context, control_center, registry, endpoint, backend, ["status", "--json"]);
  harness.require(
    reused.state === "running" && reused.pid === cc.pid && reused.context.endpoint === endpoint,
    "control_center_linux_pid_reuse"
  );
  if (backend === "x11") {
    harness.require(active_x11_window(context) === witness_window, "control_center_linux_reused_no_activate_stole_focus");
  }
  invoke_activate(context, control_center, registry, endpoint, backend, ["open", "--endpoint", "" + endpoint]);
  const focused = wait_capture(
    context, control_center, registry, endpoint, backend, cc, refresh_png, "connected",
    "control_center_linux_focus_refresh"
  );
  harness.require(
    focused.owner_pid === cc.pid
      && wait_native_window(registry, cc.pid, cc, "control_center_linux_reused_native_window") === native_window,
    "control_center_linux_focus_owner_changed"
  );
  if (backend === "x11") {
    wait_x11_active(context, native_window, "control_center_linux_focus_request_timeout");
    activate_x11_window(context, witness_window);
  }
  emit_linux_evidence(context, "control-center.linux-no-activate-focus-reuse");

  print("STEP server loss is explicit and replacement has a new epoch");
  const prior_server_pid = server.pid;
  const prior_epoch = selected_epoch;
  process_kill(server.handle);
  wait_exit(server, "control_center_linux_server_kill_timeout");
  wait_process_gone(prior_server_pid, "control_center_linux_server_kill_orphan");
  invoke(context, control_center, registry, endpoint, backend, ["open", "--no-activate", "--endpoint", "" + endpoint], 0);
  const lost = wait_capture(
    context, control_center, registry, endpoint, backend, cc, refresh_png, "unavailable",
    "control_center_linux_server_loss"
  );
  harness.require(
    lost.owner_pid === cc.pid && lost.rendered_snapshot.server_endpoint === "" && process_present(cc.pid),
    "control_center_linux_server_loss_truth"
  );

  const replacement_server_stdout = path.join(run_directory, "replacement-server.stdout.log");
  const replacement_server_stderr = path.join(run_directory, "replacement-server.stderr.log");
  const replacement_server = start_with_pid(
    native_spec(context, server_executable, registry, endpoint, backend, ["server", "--endpoint", "" + endpoint]),
    path.join(run_directory, "replacement-server.pid"), replacement_server_stdout, replacement_server_stderr
  );
  owned_children.push(replacement_server.handle);
  const replacement_protocol = wait_protocol(
    context, cli_executable, registry, endpoint, backend, replacement_server,
    replacement_server_stdout, replacement_server_stderr, "control_center_linux_replacement_server"
  );
  invoke(context, control_center, registry, endpoint, backend, ["open", "--no-activate", "--endpoint", "" + endpoint], 0);
  const refreshed = wait_capture(
    context, control_center, registry, endpoint, backend, cc, refresh_png, "connected",
    "control_center_linux_server_recovery"
  );
  const replacement_selected = json_command(context, control_center, registry, endpoint, backend, ["snapshot", "--json", "--endpoint", "" + endpoint]);
  harness.require(
    replacement_protocol.pid !== prior_server_pid
      && replacement_protocol.endpoint === endpoint
      && refreshed.owner_pid === cc.pid
      && refreshed.rendered_snapshot.server_endpoint === endpoint
      && replacement_selected.connected_server.pid === replacement_protocol.pid
      && ("" + replacement_selected.connected_server.epoch) !== prior_epoch
      && process_present(cc.pid),
    "control_center_linux_recovery_identity"
  );
  prove_pty(context, cli_executable, registry, endpoint, backend, "after-restart");
  emit_linux_evidence(context, "control-center.linux-server-recovery");

  print("STEP killed renderer is replaced without owning server or PTY");
  const killed_pid = cc.pid;
  process_kill(cc.handle);
  wait_exit(cc, "control_center_linux_renderer_kill_timeout");
  wait_process_gone(killed_pid, "control_center_linux_renderer_kill_orphan");
  harness.require(process_present(replacement_server.pid), "control_center_linux_renderer_kill_affected_server");
  prove_pty(context, cli_executable, registry, endpoint, backend, "after-renderer-kill");

  const recovered = start_with_pid(
    native_spec(context, control_center, registry, endpoint, backend, ["open", "--no-activate", "--endpoint", "" + endpoint]),
    path.join(run_directory, "recovered.pid")
  );
  owned_children.push(recovered.handle);
  wait_registry(registry, recovered.pid, recovered, "control_center_linux_recovered_registry");
  harness.require(recovered.pid !== killed_pid, "control_center_linux_renderer_not_replaced");
  const replacement_capture = wait_capture(
    context, control_center, registry, endpoint, backend, recovered, replacement_png, "connected",
    "control_center_linux_replacement_frame"
  );
  harness.require(
    replacement_capture.owner_pid === recovered.pid
      && replacement_capture.owner_pid !== killed_pid
      && replacement_capture.sha256 === rh.sha256_file(replacement_png)
      && replacement_capture.rendered_snapshot.server_endpoint === endpoint
      && process_present(replacement_server.pid),
    "control_center_linux_replacement_truth"
  );
  emit_linux_evidence(context, "control-center.linux-renderer-replacement");

  const closed = json_command(context, control_center, registry, endpoint, backend, ["close", "--json"]);
  harness.require(
    (closed.state === "closed" || closed.state === "close_requested") && closed.pid === recovered.pid,
    "control_center_linux_typed_close"
  );
  const recovered_output = wait_exit(recovered, "control_center_linux_recovered_close_timeout");
  harness.require(
    recovered_output.success && process_present(replacement_server.pid),
    "control_center_linux_close_affected_server"
  );
  prove_pty(context, cli_executable, registry, endpoint, backend, "after-close");
  emit_linux_evidence(context, "control-center.linux-process-isolation");

  invoke(context, cli_executable, registry, endpoint, backend, ["cli", "--endpoint", "" + endpoint, "shutdown"], 0);
  const server_output = wait_exit(replacement_server, "control_center_linux_final_server_shutdown");
  harness.require(server_output.success, "control_center_linux_final_server_exit");
  wait_process_gone(replacement_server.pid, "control_center_linux_final_server_orphan");
  print(
    "PASS: Linux caller-selected Unix IPC, renderer-owned PNG/digest, "
      + "native-input display contract, no-activate/focus reuse, new "
      + "epoch recovery, renderer replacement, and orphan-free "
      + "isolation (" + backend + ")"
  );
  succeeded = true;
} catch (error) {
  // rh folded every cause into one code; the cause is printed here so a
  // failed run says which step, since the manifest will not.
  print("FAILURE " + error);
  failure = "control_center_linux_smoke_failed";
}

let completion_failure = "";
try {
  // `complete_waited`, not `complete`: the killed server and the closed
  // renderer were already waited, and the door refuses a second wait.
  harness.complete_waited(context, owned_children, succeeded, failure);
} catch (error) {
  completion_failure = "control_center_linux_smoke_failed";
}
try {
  remove_native_runtime(runtime);
} catch (error) {
  if (completion_failure === "") { completion_failure = "control_center_linux_smoke_failed"; }
}
if (succeeded && completion_failure === "") { harness.remove_run(context); }
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return 0;
