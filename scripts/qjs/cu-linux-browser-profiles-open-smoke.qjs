function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_browser_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_browser_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_browser_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_browser_extents_missing_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_browser_extents_missing_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_browser_extents_missing_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_browser_extents_missing_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_browser_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_browser_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_browser_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_browser_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_browser_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_browser_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_browser_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_browser_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_browser_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_browser_extents_unavailable_code:" + code
  );
}

function run_cu(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env,
    timeout_ms: 60000,
  });
  ensure(output.success === true, "cu_linux_browser_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_browser_empty");
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_linux_browser_reply:" + JSON.stringify(document));
  return document;
}

function profile_row(data, name) {
  for (const row of data.profiles) {
    if (row.name === name) { return row; }
  }
  throw "cu_linux_browser_missing_profile:" + name;
}

function windows_rows(document) {
  const data = at(document, "data");
  if (data === undefined || data === null) { return []; }
  if (data.windows !== undefined) { return data.windows; }
  if (Array.isArray(data)) { return data; }
  return [];
}

function chrome_handles(document) {
  const handles = [];
  for (const row of windows_rows(document)) {
    const app = text_at(row, "app_name").toLowerCase();
    if (app.indexOf("chrome") >= 0 || app === "google-chrome" || app === "google-chrome-stable") {
      handles.push("" + at(row, "handle"));
    }
  }
  return handles;
}

function attach_atspi_bus_from_runtime(env) {
  if (env.AT_SPI_BUS_ADDRESS !== undefined && env.AT_SPI_BUS_ADDRESS !== "") {
    return;
  }
  const runtime = env.XDG_RUNTIME_DIR;
  if (runtime === undefined || runtime === "") { return; }
  const bus_file = rh.join(runtime, "at-spi/bus");
  if (!rh.exists(bus_file)) { return; }
  const guid_parts = rh.read_text(bus_file).trim().split(",guid=");
  const address = guid_parts[0];
  if (address !== "") {
    env.AT_SPI_BUS_ADDRESS = address;
    env.AT_SPI_BUS = address;
  }
}

function pin_box_chrome_atspi_bus(repo, env) {
  const wrapper = rh.join(repo, "scripts/box-chrome-a11y.sh");
  if (!rh.is_direct_file(wrapper)) { return false; }
  attach_atspi_bus_from_runtime(env);
  let address = "";
  if (env.AT_SPI_BUS_ADDRESS !== undefined) { address = "" + env.AT_SPI_BUS_ADDRESS; }
  if (address === "" && env.AT_SPI_BUS !== undefined) { address = "" + env.AT_SPI_BUS; }
  if (address === "") { return true; }
  const guid_parts = address.split(",guid=");
  address = guid_parts[0];
  let display_num = "1";
  if (env.DISPLAY !== undefined) {
    let display = "" + env.DISPLAY;
    const colon_parts = display.split(":");
    if (colon_parts.length > 1) { display = colon_parts[1]; }
    const dot_parts = display.split(".");
    display_num = dot_parts[0];
  }
  let chrome_xdg = "/tmp/xdg-runtime-box";
  if (rh.parse_int(display_num) >= 2) {
    chrome_xdg = "/tmp/xdg-runtime-box-" + display_num;
  }
  rh.create_dir_all(rh.join(chrome_xdg, "at-spi"));
  rh.write_text(rh.join(chrome_xdg, "at-spi/bus"), address + "\n");
  env.AT_SPI_BUS_ADDRESS = address;
  env.AT_SPI_BUS = address;
  env.QT_ACCESSIBILITY = "1";
  env.GNOME_ACCESSIBILITY = "1";
  env.ACCESSIBILITY_ENABLED = "1";
  return true;
}

function clear_stale_chrome() {
  rh.command_status("pkill", ["-9", "-f", "/usr/local/bin/box-chrome"], { timeout_ms: 5000 });
  rh.command_status("pkill", ["-9", "-f", "/opt/google/chrome/chrome"], { timeout_ms: 5000 });
  harness.sleep_ms(1000);
}

function assert_zero_chrome_windows(run_directory, executable, env) {
  let last = null;
  for (let attempt = 0; attempt < 40; attempt = attempt + 1) {
    last = run_cu(run_directory, executable, "observe", ["windows"], env);
    if (chrome_handles(last).length === 0) { return last; }
    if (attempt === 10 || attempt === 20) { clear_stale_chrome(); }
    harness.sleep_ms(250);
  }
  const leftover = [];
  for (const row of windows_rows(last)) {
    const app = text_at(row, "app_name").toLowerCase();
    if (app.indexOf("chrome") >= 0 || app === "google-chrome" || app === "google-chrome-stable") {
      leftover.push({
        handle: at(row, "handle"),
        pid: at(row, "process_id"),
        title: text_at(row, "title"),
      });
    }
  }
  throw "cu_linux_browser_chrome_windows_not_zero:" + JSON.stringify(leftover);
}

function window_row_for_title(run_directory, executable, env, title_needle, pid) {
  const reply = run_cu(run_directory, executable, "observe", ["windows"], env);
  for (const row of windows_rows(reply)) {
    const title = text_at(row, "title");
    const pid_ok = pid <= 0 || int_at(row, "process_id") === pid;
    if (title.indexOf(title_needle) >= 0 && pid_ok && int_at(row, "handle") > 0) {
      return row;
    }
  }
  return null;
}

function assert_get_extents_name_court(run_directory, executable, env, repo) {
  const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
  ensure(rh.is_direct_file(fixture_source), "cu_linux_browser_court_fixture_missing:" + fixture_source);
  const fixture_env = {};
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (env[key] !== undefined) { fixture_env[key] = env[key]; }
  }
  fixture_env.GTK_MODULES = "gail:atk-bridge";
  const fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: fixture_env,
    timeout_ms: 30000,
  });
  let court_ok = false;
  let failure = "";
  try {
    const fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
    const window_wait = run_cu(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ], env);
    ensure(flag_at(window_wait, "data.met"),
      "cu_linux_browser_court_window_wait:" + JSON.stringify(window_wait));
    let row = null;
    for (let attempt = 0; attempt < 40 && row === null; attempt = attempt + 1) {
      row = window_row_for_title(run_directory, executable, env, fixture_title, fixture_pid);
      if (row === null) { harness.sleep_ms(250); }
    }
    ensure(row !== null, "cu_linux_browser_court_inventory_missing:" + fixture_title);
    const handle = "" + at(row, "handle");
    const extents = run_cu(run_directory, executable, "observe", [
      "get-extents", "--window", handle, "--name", COURT_NODE_NAME,
    ], env);
    const matched_name = text_at(extents, "data.matched.name");
    const payload_name = text_at(extents, "data.name");
    const named = matched_name === COURT_NODE_NAME || payload_name === COURT_NODE_NAME;
    ensure(
      text_at(extents, "command") === "get-extents"
        && text_at(extents, "data.via") === "get-extents"
        && int_at(extents, "data.extents.width") > 0
        && int_at(extents, "data.extents.height") > 0
        && named,
      "cu_linux_browser_court_extents:" + JSON.stringify(extents)
    );
    court_ok = true;
  } catch (error) {
    failure = "" + error;
  }
  try { harness.kill(fixture); } catch (error) { print("cleanup court fixture: " + error); }
  ensure(court_ok, failure || "cu_linux_browser_court_failed");
}

function assert_linux_open_not_macos_na(opened) {
  const mechanism = text_at(opened, "data.mechanism");
  ensure(
    mechanism !== "open -na" && mechanism === "chromium --profile-directory+cdp",
    "cu_linux_browser_open_macos_na:" + JSON.stringify(opened.data)
  );
  const argv = at(opened, "data.argv");
  ensure(Array.isArray(argv) && argv.length > 0,
    "cu_linux_browser_open_argv:" + JSON.stringify(opened.data));
  let argv_text = "";
  for (const argument of argv) { argv_text = argv_text + " " + argument; }
  ensure(
    argv_text.indexOf("open -na") < 0 && argv_text.indexOf(" -na ") < 0,
    "cu_linux_browser_open_argv_na:" + argv_text
  );
  const binary = ("" + argv[0]).toLowerCase();
  ensure(
    binary.indexOf("chrome") >= 0 || binary.indexOf("chromium") >= 0,
    "cu_linux_browser_open_linux_binary:" + argv[0]
  );
}

function tree_sees_chrome_window(document, handle, title_needle, require_renderer) {
  ensure(
    text_at(document, "command") === "tree"
      && text_at(document, "data.backend") === "at-spi2"
      && text_at(document, "data.addressing") === "accessibility-tree"
      && ("" + at(document, "data.window")) === ("" + handle)
      && !flag_at(document, "data.degraded"),
    "cu_linux_browser_open_tree_shape:" + JSON.stringify(document.data)
  );
  const nodes = at(document, "data.nodes");
  ensure(Array.isArray(nodes) && nodes.length >= 1 && int_at(document, "data.visited") >= 1,
    "cu_linux_browser_open_tree_empty:" + JSON.stringify(document.data));
  let saw = false;
  for (const node of nodes) {
    const name = text_at(node, "name").toLowerCase();
    const role = text_at(node, "role").toLowerCase();
    if (name.indexOf("chrome") >= 0
        || (title_needle !== "" && name.indexOf(title_needle.toLowerCase()) >= 0)
        || role.indexOf("application") >= 0
        || role.indexOf("frame") >= 0) {
      saw = true;
    }
  }
  ensure(saw, "cu_linux_browser_open_tree_no_chrome:" + JSON.stringify({
    handle: handle,
    title: title_needle,
    visited: at(document, "data.visited"),
    nodes: nodes.length,
  }));
  if (require_renderer) {
    ensure(
      nodes.length > 1 && int_at(document, "data.visited") > 1,
      "cu_linux_browser_open_tree_x11_frame_only:" + JSON.stringify({
        visited: at(document, "data.visited"),
        returned: nodes.length,
      })
    );
  }
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
harness.require(!harness.host_is_windows(),
  "cu.linux-browser-profiles-open requires Linux Local State mapping");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(rh.is_direct_file(executable), "cu_linux_browser_executable_missing:" + executable);
ensure(rh.is_direct_file(abi_library), "cu_linux_browser_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-browser-profiles-open");
const run_directory = context.run_directory;
const user_data = rh.join(run_directory, ".config/google-chrome");
const local_state = rh.join(user_data, "Local State");
const html_dir = rh.join(run_directory, "html");
const fixture = rh.join(html_dir, "fixture.html");
const fixture_title = "CEO Browser Open " + context.run_id;
const env = isolated_env(run_directory, executable);
env.CHROME_USER_DATA_DIR = user_data;
attach_atspi_bus_from_runtime(env);
const a11y_launcher_present = pin_box_chrome_atspi_bus(repo, env);
const atspi_available = probe_atspi_available(executable);

let succeeded = 0;
let failure = "";

try {
  print("STEP browser-profiles/browser-open typed-fails usage when AT-SPI --name/--coords/--bogus or other unexpected arguments are present");
  assert_browser_profiles_open_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before browser-open");
  assert_get_extents_usage_limit(run_directory, executable, env);

  print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before browser-open");
  assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

  if (!atspi_available) {
    print("STEP independent pyatspi desktop probe unavailable: get-extents host-limit already held; browser-open read-back still uses windows inventory");
  }

  print("STEP clear stale Chrome/box-chrome processes on this display before zero-chrome inventory");
  clear_stale_chrome();
  print("STEP prove ZERO Chrome windows on this display before browser-profiles");
  assert_zero_chrome_windows(run_directory, executable, env);

  print("STEP write synthetic Chromium Local State under an invocation-owned HOME");
  rh.create_dir_all(rh.join(user_data, "Default"));
  rh.create_dir_all(html_dir);
  rh.write_text(fixture, "<!DOCTYPE html><html><head><title>"
    + fixture_title + "</title></head><body>ok</body></html>");
  rh.write_text(local_state, JSON.stringify({
    profile: {
      last_used: "Profile 7",
      profiles_order: ["Profile 7", "Default"],
      info_cache: {
        Default: { name: "court-alpha" },
        "Profile 7": { name: "court-beta" },
      },
    },
  }));

  print("STEP browser-profiles lists Google Chrome from installed Local State with ZERO Chrome windows");
  const profiles = run_cu(run_directory, executable, "observe", [
    "browser-profiles", "--app", "Google Chrome",
  ], env);
  ensure(profiles.command === "browser-profiles", "cu_linux_browser_profiles_identity");
  const data = profiles.data;
  ensure(data.app === "Google Chrome"
      && data.mechanism === "local-state+window-inventory"
      && data.local_state.startsWith("~/")
      && !data.local_state.includes(run_directory)
      && data.returned === 2,
    "cu_linux_browser_profiles_contract");
  const alpha = profile_row(data, "court-alpha");
  const beta = profile_row(data, "court-beta");
  ensure(alpha.directory === "Default" && alpha.last_used === false,
    "cu_linux_browser_profiles_alpha");
  ensure(beta.directory === "Profile 7" && beta.last_used === true,
    "cu_linux_browser_profiles_beta");
  ensure(Array.isArray(alpha.windows) && alpha.windows.length === 0,
    "cu_linux_browser_profiles_alpha_no_live_window:" + JSON.stringify(alpha.windows));
  harness.emit_evidence(context, declared_evidence, "cu.linux-browser-profiles-installed");

  if (atspi_available) {
    print("STEP get-extents --name court on owned GTK fixture BEFORE browser-open");
    assert_get_extents_name_court(run_directory, executable, env, repo);
  } else {
    print("STEP skip get-extents --name court: pyatspi desktop probe unavailable (host-limit already recorded)");
  }

  print("STEP record independent chrome window handles before browser-open");
  const before_inventory = run_cu(run_directory, executable, "observe", ["windows"], env);
  const before_handles = chrome_handles(before_inventory);
  const before_set = {};
  for (const handle of before_handles) { before_set[handle] = true; }

  print("STEP browser-open court-alpha and verify a new chrome window through windows inventory");
  const fixture_url = "file://" + fixture;
  let opened = null;
  for (let open_attempt = 0; open_attempt < 3 && opened === null; open_attempt = open_attempt + 1) {
    if (open_attempt > 0) {
      clear_stale_chrome();
      harness.sleep_ms(1000);
    }
    const output = rh.command(executable, [
      "--target", "current", "--grant", "actuate",
      "browser-open",
      "--profile", "court-alpha",
      "--url", fixture_url,
      "--app", "Google Chrome",
      "--timeout-ms", "30000",
    ], { cwd: run_directory, env: env, timeout_ms: 60000 });
    if (output.success !== true) { continue; }
    const trimmed = output.stdout.trim();
    if (trimmed === "") { continue; }
    const reply = JSON.parse(trimmed);
    if (reply.command === "browser-open" && flag_at(reply, "ok")) {
      opened = reply;
    }
  }
  ensure(opened !== null, "cu_linux_browser_open_failed");
  ensure(opened.command === "browser-open", "cu_linux_browser_open_identity");
  print("STEP browser-open Linux launch is chromium --profile-directory+cdp, not macOS open -na");
  assert_linux_open_not_macos_na(opened);
  const open_handle = "" + at(opened, "data.handle");
  ensure(open_handle !== "" && open_handle !== "0",
    "cu_linux_browser_open_handle:" + JSON.stringify(opened.data));

  let readback_handle = null;
  for (let attempt = 0; attempt < 40 && readback_handle === null; attempt = attempt + 1) {
    const inventory = run_cu(run_directory, executable, "observe", ["windows"], env);
    for (const handle of chrome_handles(inventory)) {
      if (readback_handle === null && before_set[handle] !== true) {
        readback_handle = handle;
      }
    }
    if (readback_handle === null) { harness.sleep_ms(250); }
  }
  ensure(readback_handle !== null, "cu_linux_browser_open_readback_missing");
  ensure(readback_handle === open_handle,
    "cu_linux_browser_open_handle_mismatch:" + JSON.stringify({
      open: open_handle,
      readback: readback_handle,
    }));
  harness.emit_evidence(context, declared_evidence, "cu.linux-browser-open-window");

  if (atspi_available) {
    print("STEP tree --window sees the opened Chrome window through AT-SPI"
      + (a11y_launcher_present ? " (box-chrome-a11y.sh present)" : " (box-chrome-a11y.sh absent)"));
    let tree_document = null;
    let tree_error = "";
    for (let attempt = 0; attempt < 40 && tree_document === null; attempt = attempt + 1) {
      const tree = run_cu_reply(run_directory, executable, "observe", [
        "tree", "--window", open_handle,
        "--depth", "6",
        "--max-nodes", "200",
        "--flat",
      ], env);
      if (rh.output_success(tree)) {
        try {
          tree_sees_chrome_window(tree, open_handle, fixture_title, a11y_launcher_present);
          tree_document = tree;
        } catch (error) {
          tree_error = "" + error;
          harness.sleep_ms(250);
        }
      } else {
        tree_error = "cu_linux_browser_open_tree_reply:" + JSON.stringify(tree);
        harness.sleep_ms(250);
      }
    }
    ensure(tree_document !== null, tree_error || "cu_linux_browser_open_tree_missing");
  } else {
    print("STEP skip Chrome AT-SPI tree read-back: pyatspi desktop probe unavailable");
  }

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.remove_run(context);
  if (atspi_available) {
    print("PASS: Linux browser-profiles zero-chrome installed inventory + browser-open windows/tree AT-SPI --name court with typed browser-profiles/browser-open --name/--coords/--bogus and get-extents --name usage/host-limit honesty (not open -na, no --coords)");
  } else {
    print("PASS: Linux browser-profiles zero-chrome installed inventory + browser-open windows read-back with typed browser-profiles/browser-open --name/--coords/--bogus usage and get-extents --name host-limit honesty (AT-SPI --name, no --coords)");
  }
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
