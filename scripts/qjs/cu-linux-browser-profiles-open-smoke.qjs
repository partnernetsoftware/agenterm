// CEO: Linux browser-profiles lists installed Chrome profiles with ZERO Chrome
// windows (Local State inventory evidence), then browser-open with independent
// windows inventory plus AT-SPI tree/--name read-back.
// Typed browser-profiles/browser-open usage must reject AT-SPI --name, --coords,
// --bogus, and other unexpected arguments; typed get-extents --name usage AND
// host-limit paths must both hold BEFORE browser-open. After open+profile, tree
// --window must see the Chrome window through AT-SPI (pin scripts/box-chrome-a11y.sh
// when present). Linux launch must not be macOS `open -na`. Prefer host-limit
// clarity over fake success. AT-SPI/--name only; no --coords.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-browser-profiles-installed",
  "cu.linux-browser-open-window",
];

const AT_SPI_PROBE_NAME = "Browser Profiles Court Anchor";
const COURT_NODE_NAME = "Fixture Entry";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}


function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function isolated_env(run_directory, executable) {
  const env = {
    HOME: run_directory,
    XDG_CONFIG_HOME: rh.join(run_directory, ".config"),
    XDG_DATA_HOME: rh.join(run_directory, ".data"),
    AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
    AGENTERM_CU_RECEIPT_PATH: rh.join(run_directory, "cu-receipts.jsonl"),
    AGENTERM_CU_RUNTIME_PATH: rh.join(run_directory, "cu-runtime.json"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  const cu = cu_env(executable);
  env.AGENTERM_ABI_LIB = cu.AGENTERM_ABI_LIB;
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (cu[key] !== undefined) { env[key] = cu[key]; }
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_browser_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 60000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_browser_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function assert_browser_profiles_open_usage_limit(run_directory, executable, env) {
  const flat_profiles = run_cu_reply(run_directory, executable, "observe", [
    "browser-profiles", "--app", "Google Chrome", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(flat_profiles),
    "cu_linux_browser_profiles_usage_flat_name_ok:" + JSON.stringify(flat_profiles));
  ensure(
    text_at(flat_profiles, "error.code") === "usage",
    "cu_linux_browser_profiles_usage_flat_name_code:" + JSON.stringify(flat_profiles.error)
  );
  ensure(
    text_at(flat_profiles, "command") === "usage",
    "cu_linux_browser_profiles_usage_flat_name_command:" + JSON.stringify(flat_profiles)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_profiles, "error.message"), "--name"),
    "cu_linux_browser_profiles_usage_flat_name_message:" + JSON.stringify(flat_profiles.error)
  );

  const grouped_profiles = run_cu_reply(run_directory, executable, "observe", [
    "browser", "profiles", "--app", "Google Chrome", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(grouped_profiles),
    "cu_linux_browser_profiles_usage_grouped_name_ok:" + JSON.stringify(grouped_profiles));
  ensure(
    text_at(grouped_profiles, "error.code") === "usage",
    "cu_linux_browser_profiles_usage_grouped_name_code:" + JSON.stringify(grouped_profiles.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_profiles, "error.message"), "--name"),
    "cu_linux_browser_profiles_usage_grouped_name_message:" + JSON.stringify(grouped_profiles.error)
  );

  const flat_profiles_coords = run_cu_reply(run_directory, executable, "observe", [
    "browser-profiles", "--app", "Google Chrome", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(flat_profiles_coords),
    "cu_linux_browser_profiles_usage_flat_coords_ok:" + JSON.stringify(flat_profiles_coords));
  ensure(
    text_at(flat_profiles_coords, "error.code") === "usage",
    "cu_linux_browser_profiles_usage_flat_coords_code:" + JSON.stringify(flat_profiles_coords.error)
  );
  ensure(
    text_at(flat_profiles_coords, "command") === "usage",
    "cu_linux_browser_profiles_usage_flat_coords_command:" + JSON.stringify(flat_profiles_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_profiles_coords, "error.message"), "--coords"),
    "cu_linux_browser_profiles_usage_flat_coords_message:" + JSON.stringify(flat_profiles_coords.error)
  );

  const grouped_profiles_coords = run_cu_reply(run_directory, executable, "observe", [
    "browser", "profiles", "--app", "Google Chrome", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(grouped_profiles_coords),
    "cu_linux_browser_profiles_usage_grouped_coords_ok:" + JSON.stringify(grouped_profiles_coords));
  ensure(
    text_at(grouped_profiles_coords, "error.code") === "usage",
    "cu_linux_browser_profiles_usage_grouped_coords_code:" + JSON.stringify(grouped_profiles_coords.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_profiles_coords, "error.message"), "--coords"),
    "cu_linux_browser_profiles_usage_grouped_coords_message:" + JSON.stringify(grouped_profiles_coords.error)
  );

  const profiles_bogus = run_cu_reply(run_directory, executable, "observe", [
    "browser-profiles", "--app", "Google Chrome", "--bogus",
  ], env);
  ensure(!rh.output_success(profiles_bogus),
    "cu_linux_browser_profiles_usage_bogus_ok:" + JSON.stringify(profiles_bogus));
  ensure(
    text_at(profiles_bogus, "error.code") === "usage",
    "cu_linux_browser_profiles_usage_bogus_code:" + JSON.stringify(profiles_bogus.error)
  );
  ensure(
    text_at(profiles_bogus, "command") === "usage",
    "cu_linux_browser_profiles_usage_bogus_command:" + JSON.stringify(profiles_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(profiles_bogus, "error.message"), "--bogus"),
    "cu_linux_browser_profiles_usage_bogus_message:" + JSON.stringify(profiles_bogus.error)
  );

  const flat_open = run_cu_reply(run_directory, executable, "actuate", [
    "browser-open", "--profile", "court-alpha", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(flat_open),
    "cu_linux_browser_open_usage_flat_name_ok:" + JSON.stringify(flat_open));
  ensure(
    text_at(flat_open, "error.code") === "usage",
    "cu_linux_browser_open_usage_flat_name_code:" + JSON.stringify(flat_open.error)
  );
  ensure(
    text_at(flat_open, "command") === "usage",
    "cu_linux_browser_open_usage_flat_name_command:" + JSON.stringify(flat_open)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_open, "error.message"), "--name"),
    "cu_linux_browser_open_usage_flat_name_message:" + JSON.stringify(flat_open.error)
  );

  const grouped_open = run_cu_reply(run_directory, executable, "actuate", [
    "browser", "open", "--profile", "court-alpha", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(grouped_open),
    "cu_linux_browser_open_usage_grouped_name_ok:" + JSON.stringify(grouped_open));
  ensure(
    text_at(grouped_open, "error.code") === "usage",
    "cu_linux_browser_open_usage_grouped_name_code:" + JSON.stringify(grouped_open.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_open, "error.message"), "--name"),
    "cu_linux_browser_open_usage_grouped_name_message:" + JSON.stringify(grouped_open.error)
  );

  const flat_open_coords = run_cu_reply(run_directory, executable, "actuate", [
    "browser-open", "--profile", "court-alpha", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(flat_open_coords),
    "cu_linux_browser_open_usage_flat_coords_ok:" + JSON.stringify(flat_open_coords));
  ensure(
    text_at(flat_open_coords, "error.code") === "usage",
    "cu_linux_browser_open_usage_flat_coords_code:" + JSON.stringify(flat_open_coords.error)
  );
  ensure(
    text_at(flat_open_coords, "command") === "usage",
    "cu_linux_browser_open_usage_flat_coords_command:" + JSON.stringify(flat_open_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(flat_open_coords, "error.message"), "--coords"),
    "cu_linux_browser_open_usage_flat_coords_message:" + JSON.stringify(flat_open_coords.error)
  );

  const grouped_open_coords = run_cu_reply(run_directory, executable, "actuate", [
    "browser", "open", "--profile", "court-alpha", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(grouped_open_coords),
    "cu_linux_browser_open_usage_grouped_coords_ok:" + JSON.stringify(grouped_open_coords));
  ensure(
    text_at(grouped_open_coords, "error.code") === "usage",
    "cu_linux_browser_open_usage_grouped_coords_code:" + JSON.stringify(grouped_open_coords.error)
  );
  ensure(
    usage_rejects_unexpected(text_at(grouped_open_coords, "error.message"), "--coords"),
    "cu_linux_browser_open_usage_grouped_coords_message:" + JSON.stringify(grouped_open_coords.error)
  );

  const open_bogus = run_cu_reply(run_directory, executable, "actuate", [
    "browser-open", "--profile", "court-alpha", "--bogus",
