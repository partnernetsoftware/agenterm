  ensure(
    text_at(open_bogus, "error.code") === "usage",
    "cu_linux_browser_open_usage_bogus_code:" + JSON.stringify(open_bogus.error)
  );
  ensure(
    text_at(open_bogus, "command") === "usage",
    "cu_linux_browser_open_usage_bogus_command:" + JSON.stringify(open_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(open_bogus, "error.message"), "--bogus"),
