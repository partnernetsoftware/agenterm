// Platform-neutral public black-box journey for native `network-dns`.
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.network-dns",
  "cu.network-dns-services",
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function invoke(run_directory, executable, arguments, expect_success) {
  const receipt_path = rh.join(run_directory, "cu-receipts.jsonl");
  const output = rh.command(executable, arguments, {
    cwd: run_directory,
    env: {
      AGENTERM_CU_AUDIT_PATH: rh.join(run_directory, "cu-audit.jsonl"),
      AGENTERM_CU_RECEIPT_PATH: receipt_path
    },
    timeout_ms: 30000
  });
  ensure(output.success === expect_success, "cu_network_dns_exit:" + output.exit_code);
  const reply = JSON.parse(output.stdout.trim());
  ensure(reply.ok === expect_success, "cu_network_dns_reply_state");
  ensure(!rh.exists(receipt_path) || rh.read_text(receipt_path).trim() === "", "cu_network_dns_effect_receipt_created");
  return reply;
}

function optional_text(value) {
  return value === null || typeof value === "string";
}

function host_is_macos() {
  return !harness.host_is_windows() && rh.exists("/System/Library/CoreServices");
}

function hardware_port_pairs() {
  const output = rh.command("/usr/sbin/networksetup", ["-listallhardwareports"], {
    env: { LANG: "C", LC_ALL: "C" },
    timeout_ms: 30000
  });
  ensure(output.success === true, "cu_network_dns_networksetup_failed:" + output.exit_code);
  const pairs = [];
  let hardware_port = "";
  for (const source_line of output.stdout.split("\n")) {
    let line = source_line.trim();
    while (line.startsWith("*")) { line = line.slice(1).trim(); }
    if (line.startsWith("Hardware Port:")) {
      hardware_port = line.slice("Hardware Port:".length).trim();
    } else if (line.startsWith("Device:")) {
      const device = line.slice("Device:".length).trim();
      if (hardware_port !== "" && device !== "") {
        pairs.push({ device: device, service: hardware_port });
      }
      hardware_port = "";
    }
  }
  ensure(pairs.length > 0, "cu_network_dns_networksetup_empty");
  return pairs;
}

function service_for_interface(pairs, interface_name) {
  for (const pair of pairs) {
    if (pair.device === interface_name) { return pair.service; }
  }
  return null;
}

function assert_service_identity(reply) {
  const rows = [];
  for (const row of reply.data.resolvers) { rows.push(row); }
  for (const row of reply.data.search_domains) { rows.push(row); }
  ensure(rows.length > 0, "cu_network_dns_service_rows_empty");

  if (host_is_macos()) {
    ensure(
      reply.data.provider === "scutil --dns + networksetup -listallhardwareports",
      "cu_network_dns_macos_join_provider"
    );
    const pairs = hardware_port_pairs();
    let mapped = 0;
    for (const row of rows) {
      const expected = row.interface === null ? null : service_for_interface(pairs, row.interface);
      ensure(row.service === expected, "cu_network_dns_macos_service_identity");
      if (expected !== null) { mapped = mapped + 1; }
    }
    ensure(mapped > 0, "cu_network_dns_macos_service_identity_unobserved");
    return;
  }

  if (harness.host_is_windows()) {
    let mapped = 0;
    for (const row of rows) {
      ensure(row.service === row.interface, "cu_network_dns_windows_service_identity");
      if (row.service !== null) { mapped = mapped + 1; }
    }
    ensure(mapped > 0, "cu_network_dns_windows_service_identity_unobserved");
    return;
  }

  for (const row of rows) {
    ensure(row.service === null, "cu_network_dns_linux_service_must_be_null");
  }
}

function assert_payload(reply, max) {
  ensure(reply.command === "network-dns" && reply.target === "current", "cu_network_dns_identity");
  const data = reply.data;
  ensure(
    Array.isArray(data.resolvers)
      && Array.isArray(data.search_domains)
      && data.returned === data.resolvers.length + data.search_domains.length
      && data.returned <= max
      && data.visited >= data.returned
      && data.response_ceiling_bytes === 1048576
      && typeof data.provider === "string"
      && data.provider.length > 0
      && (data.coverage === "system-effective" || data.coverage === "resolver-file" || data.coverage === "stub-only")
      && typeof data.complete === "boolean"
      && typeof data.truncated === "boolean"
      && typeof data.truncated_scan === "boolean",
    "cu_network_dns_counts_provider_or_coverage"
  );
  ensure(data.coverage !== "stub-only" || data.complete === false, "cu_network_dns_stub_claimed_complete");
  for (const row of data.resolvers) {
    ensure(
      (row.family === "IPv4" || row.family === "IPv6")
        && typeof row.address === "string"
        && row.address.length > 0
        && typeof row.port === "number"
        && row.port >= 1
        && row.port <= 65535
        && optional_text(row.interface)
        && optional_text(row.interface_native_id)
        && optional_text(row.service),
      "cu_network_dns_resolver_schema"
    );
  }
  for (const row of data.search_domains) {
    ensure(
      typeof row.domain === "string"
        && row.domain.length > 0
        && optional_text(row.interface)
        && optional_text(row.interface_native_id)
        && optional_text(row.service),
      "cu_network_dns_domain_schema"
    );
  }
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.is_direct_file(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
ensure(rh.is_direct_file(executable), "cu_network_dns_executable_missing:" + executable);

const context = harness.new_context(repo, "cu-network-dns");
let succeeded = 0;
let failure = "";
try {
  print("STEP canonical DNS inventory is bounded, typed and honest about coverage");
  const canonical = invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "observe", "network-dns", "--max", "5000"
  ], true);
  assert_payload(canonical, 5000);

  print("STEP DNS rows expose the host-defined service identity without fabricating a portable one");
  assert_service_identity(canonical);

  print("STEP grouped alias preserves the same public resolver contract");
  const alias = invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "observe", "network", "dns", "--max", "1"
  ], true);
  assert_payload(alias, 1);

  print("STEP invalid max fails before native provider execution");
  const invalid = invoke(context.run_directory, executable, [
    "--target", "current", "--grant", "observe", "network-dns", "--max", "0"
  ], false);
  ensure(invalid.error.code === "usage", "cu_network_dns_invalid_limit_code");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.network-dns");
  harness.emit_evidence(context, declared_evidence, "cu.network-dns-services");
  harness.remove_run(context);
  print("PASS: agenterm-cu native bounded effective DNS inventory");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
