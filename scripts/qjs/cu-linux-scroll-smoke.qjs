// CEO: Linux AT-SPI scroll --name (Component.ScrollTo TopEdge) on GTK.
// Acceptance is smoke read-back only: independent pyatspi Component.GetExtents
// before must refuse an off-screen named node while an on-screen reference
// node remains readable, scroll --name must succeed via scroll-to and name
// the matched node, and a second pyatspi probe plus CU get-extents must
// return positive geometry below the reference node and inside the fixture
// window bounds with STATE_SHOWING. Non-scrollable nodes typed-fail
// a11y_scroll_unavailable with alternatives. Typed scroll usage must reject
// missing --name and zero --window; typed
// get-extents --name usage/host-limit paths must hold before the scroll
// actuate/read-back court. No XTest wheel, --coords, or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-scroll-to",
];

const SCROLL_TARGET = "Fixture Scroll Target";
const WHEEL_TARGET = "Fixture Wheel Target";
const NON_SCROLLABLE_NODE = "Fixture Press";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function output_success(document) { return flag_at(document, "ok"); }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu(run_directory, executable, grant, arguments) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  if (trimmed === "") {
    return { ok: false, stdout: output.stdout, stderr: output.stderr };
  }
  const document = JSON.parse(trimmed);
  document._stdout = output.stdout;
  document._stderr = output.stderr;
  document._success = output.success === true;
  return document;
}

function run_cu_reply(run_directory, executable, grant, arguments, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_scroll_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_scroll_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu_ok(run_directory, executable, grant, arguments) {
  const document = run_cu(run_directory, executable, grant, arguments);
  ensure(document._success === true, "cu_linux_scroll_cli:" + document._stdout + document._stderr);
  ensure(flag_at(document, "ok"), "cu_linux_scroll_reply:" + JSON.stringify(document));
  return document;
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function independent_probe_script() {
  return [
    "import json, sys",
    "import pyatspi",
    "",
    "config = json.loads(sys.argv[1])",
    "title = config['title']",
    "name = config['name']",
    "I32_MIN = -2147483648",
    "",
    "def node_name(obj):",
    "    try: return obj.name or ''",
    "    except Exception: return ''",
    "",
    "def is_readable(x, y, width, height):",
    "    return width > 0 and height > 0 and x != I32_MIN and y != I32_MIN",
    "",
    "def find_named(root, needle):",
    "    if node_name(root) == needle:",
    "        return root",
    "    try: child_count = root.childCount",
    "    except Exception: child_count = 0",
    "    for index in range(child_count):",
    "        try: child = root.getChildAtIndex(index)",
    "        except Exception: child = None",
    "        if child is None: continue",
    "        found = find_named(child, needle)",
    "        if found is not None: return found",
    "    return None",
    "",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "application = None",
    "for candidate in desktop:",
    "    try:",
    "        for index in range(candidate.childCount):",
    "            window = candidate.getChildAtIndex(index)",
    "            if window is not None and node_name(window) == title:",
    "                application = candidate",
    "                break",
    "        if application is not None: break",
    "    except Exception: continue",
    "if application is None:",
    "    raise SystemExit('cu_linux_scroll_probe_window_missing')",
    "",
    "node = find_named(application, name)",
    "if node is None:",
    "    raise SystemExit('cu_linux_scroll_probe_node_missing:' + name)",
    "",
    "showing = False",
    "try:",
    "    showing = node.getState().contains(pyatspi.STATE_SHOWING)",
    "except Exception:",
    "    showing = False",
    "",
    "try:",
    "    component = node.queryComponent()",
    "    x, y, width, height = component.getExtents(pyatspi.DESKTOP_COORDS)",
    "except Exception as error:",
    "    print(json.dumps({'found': True, 'showing': showing, 'available': False, 'reason': str(error)}))",
    "    raise SystemExit(0)",
    "",
    "print(json.dumps({",
    "    'found': True,",
    "    'showing': showing,",
    "    'available': is_readable(x, y, width, height),",
    "    'x': x, 'y': y, 'width': width, 'height': height,",
    "}))",
  ].join("\n");
}

function independent_extents(run_directory, executable, title, node_name) {
  const output = rh.command(
    "python3",
    ["-c", independent_probe_script(), JSON.stringify({ title: title, name: node_name })],
    { cwd: run_directory, env: cu_env(executable), timeout_ms: 45000 },
  );
  ensure(output.success === true, "cu_linux_scroll_probe:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function usage_message_mentions_unexpected(message) {
  return message.indexOf("--name") >= 0
    || message.indexOf("unexpected") >= 0
    || message.indexOf("--bogus") >= 0;
}

function assert_scroll_usage_limit(run_directory, executable, env) {
  const missing_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "scroll", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_scroll_usage_missing_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_scroll_usage_missing_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    usage_message_mentions_unexpected(text_at(missing_name, "error.message")),
    "cu_linux_scroll_usage_missing_name_message:" + JSON.stringify(missing_name.error)
  );

  const zero_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "scroll", "--window", "0", "--name", SCROLL_TARGET,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_scroll_usage_zero_handle_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_scroll_usage_zero_handle_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_scroll_usage_zero_handle_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", SCROLL_TARGET,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_scroll_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_scroll_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_scroll_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", SCROLL_TARGET,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_scroll_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_scroll_extents_unavailable_code:" + code
  );
}

function assert_scroll_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "scroll", "--window", "1", "--name", SCROLL_TARGET,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!flag_at(reply, "ok"), "cu_linux_scroll_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle",
    "cu_linux_scroll_unavailable_code:" + code
  );
}

function assert_scroll_unavailable_with_alternatives(
  run_directory, executable, handle, node_name, label
) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "scroll", "--window", "" + handle, "--name", node_name,
  ]);
  ensure(
    !flag_at(reply, "ok") && text_at(reply, "error.code") === "a11y_scroll_unavailable",
    "cu_linux_scroll_unavailable_" + label + ":" + JSON.stringify(reply)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("scrollto") >= 0 || message.indexOf("scroll") >= 0,
    "cu_linux_scroll_unavailable_message_" + label + ":" + JSON.stringify(reply.error)
  );
  const alternatives = at(reply, "error.detail.alternatives");
  ensure(
    alternatives !== undefined && alternatives !== null && alternatives.length > 0,
    "cu_linux_scroll_unavailable_alternatives_" + label + ":" + JSON.stringify(reply.error)
  );
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu_ok(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

function get_extents(run_directory, executable, handle_text, node_name) {
  const reply = run_cu(run_directory, executable, "observe", [
    "get-extents", "--window", handle_text, "--name", node_name,
  ]);
  if (!flag_at(reply, "ok")) { return null; }
  return reply;
}

function assert_pyatspi_offscreen_baseline(
  run_directory, executable, fixture_title, reference_bottom, label
) {
  const probe = independent_extents(run_directory, executable, fixture_title, SCROLL_TARGET);
  ensure(
    probe.found === true,
    "cu_linux_scroll_pyatspi_offscreen_found_" + label + ":" + JSON.stringify(probe)
  );
  ensure(
    probe.showing !== true
      || probe.available !== true
      || int_at(probe, "y") > reference_bottom,
    "cu_linux_scroll_pyatspi_offscreen_" + label + ":" + JSON.stringify(probe)
  );
}

function assert_pyatspi_onscreen_readback(
  run_directory, executable, fixture_title, reference_bottom, win_x, win_y, win_w, win_h, label
) {
  const probe = independent_extents(run_directory, executable, fixture_title, SCROLL_TARGET);
  ensure(
    probe.found === true && probe.available === true && probe.showing === true,
    "cu_linux_scroll_pyatspi_onscreen_" + label + ":" + JSON.stringify(probe)
  );
  ensure(
    int_at(probe, "y") > reference_bottom
      && int_at(probe, "height") > 0
      && int_at(probe, "width") > 0,
    "cu_linux_scroll_pyatspi_geometry_" + label + ":" + JSON.stringify(probe)
  );
  ensure(
    int_at(probe, "x") >= win_x
      && int_at(probe, "y") >= win_y
      && int_at(probe, "x") + int_at(probe, "width") <= win_x + win_w
      && int_at(probe, "y") + int_at(probe, "height") <= win_y + win_h,
    "cu_linux_scroll_pyatspi_window_bounds_" + label + ":" + JSON.stringify({
      probe: probe,
      window: { x: win_x, y: win_y, width: win_w, height: win_h },
    })
  );
  return probe;
}

function assert_cu_pyatspi_agreement(cu_reply, probe, label) {
  ensure(
    int_at(cu_reply, "data.extents.x") === int_at(probe, "x")
      && int_at(cu_reply, "data.extents.y") === int_at(probe, "y")
      && int_at(cu_reply, "data.extents.width") === int_at(probe, "width")
      && int_at(cu_reply, "data.extents.height") === int_at(probe, "height"),
    "cu_linux_scroll_cu_pyatspi_mismatch_" + label + ":" + JSON.stringify({
      cu: cu_reply.data.extents,
      probe: probe,
    })
  );
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const abi_library = rh.join(rh.parent(executable), "libagenterm.so");
ensure(direct_file(executable), "cu_linux_scroll_executable_missing:" + executable);
ensure(direct_file(abi_library), "cu_linux_scroll_library_missing:" + abi_library);

const context = harness.new_context(repo, "cu-linux-scroll");
const run_directory = rh.join(repo, "target/cu-linux-scroll-smoke-run");
rh.create_dir_all(run_directory);
const env = cu_env(executable);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_scroll_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP scroll typed-fails usage when --name is missing or --window handle is zero");
  assert_scroll_usage_limit(run_directory, executable, env);

  if (atspi_available) {
    print("STEP get-extents typed-fail invalid_input when --window is zero before scroll actuate/read-back court");
    assert_get_extents_usage_limit(run_directory, executable, env);
  } else {
    print("STEP get-extents typed-fail host-limit when pyatspi desktop probe is unavailable");
    assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
  }

  if (!atspi_available) {
    print("STEP scroll typed-fail host-limit when independent pyatspi desktop probe is unavailable");
    assert_scroll_host_limit_when_atspi_absent(run_directory, executable);
    succeeded = 1;
  } else {
    print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
    fixture = harness.start({
      program: "python3",
      args: [fixture_source],
      current_dir: run_directory,
      env: { GTK_MODULES: "gail:atk-bridge" },
      timeout_ms: 30000,
    });
    fixture_pid = harness.spawned_pid(fixture);
    const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
    const window_wait = run_cu_ok(run_directory, executable, "observe", [
      "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
    ]);
    ensure(flag_at(window_wait, "data.met"), "cu_linux_scroll_window_wait");
    const row = window_row(run_directory, executable, fixture_pid, fixture_title);
    ensure(row !== null, "cu_linux_scroll_window_identity");
    const handle = "" + at(row, "handle");
    const win_x = int_at(row, "bounds.x");
    const win_y = int_at(row, "bounds.y");
    const win_w = int_at(row, "bounds.width");
    const win_h = int_at(row, "bounds.height");
    ensure(win_w > 0 && win_h > 0, "cu_linux_scroll_window_bounds:" + JSON.stringify(row));

    print("STEP scroll typed-fails a11y_scroll_unavailable with alternatives on a non-scrollable on-screen node");
    assert_scroll_unavailable_with_alternatives(
      run_directory, executable, handle, NON_SCROLLABLE_NODE, "fixture_press"
    );
    const press_probe = independent_extents(run_directory, executable, fixture_title, NON_SCROLLABLE_NODE);
    ensure(
      press_probe.found === true && press_probe.available === true && press_probe.showing === true,
      "cu_linux_scroll_press_onscreen:" + JSON.stringify(press_probe)
    );

    print("STEP independent pyatspi and CU get-extents must refuse off-screen " + SCROLL_TARGET);
    const before = run_cu(run_directory, executable, "observe", [
      "get-extents", "--window", handle, "--name", SCROLL_TARGET,
    ]);
    ensure(
      !flag_at(before, "ok")
        && text_at(before, "error.code") === "a11y_extents_unavailable",
      "cu_linux_scroll_offscreen_baseline:" + JSON.stringify(before)
    );

    print("STEP independent pyatspi keeps on-screen reference " + WHEEL_TARGET);
    const wheel_probe = independent_extents(run_directory, executable, fixture_title, WHEEL_TARGET);
    ensure(
      wheel_probe.found === true
        && wheel_probe.available === true
        && wheel_probe.showing === true,
      "cu_linux_scroll_wheel_pyatspi_baseline:" + JSON.stringify(wheel_probe)
    );
    const wheel_before = get_extents(run_directory, executable, handle, WHEEL_TARGET);
    ensure(wheel_before !== null, "cu_linux_scroll_wheel_baseline_missing");
    const wheel_y = int_at(wheel_before, "data.extents.y");
    const wheel_h = int_at(wheel_before, "data.extents.height");
    ensure(
      wheel_y > 0
        && wheel_h > 0
        && rh.has_item(at(wheel_before, "data.matched.states"), "showing"),
      "cu_linux_scroll_wheel_baseline:" + JSON.stringify(wheel_before.data)
    );
    assert_cu_pyatspi_agreement(wheel_before, wheel_probe, "wheel_baseline");
    const reference_bottom = wheel_y + wheel_h;
    assert_pyatspi_offscreen_baseline(
      run_directory, executable, fixture_title, reference_bottom, "before_scroll"
    );

    print("STEP scroll --name " + SCROLL_TARGET + " via Component.ScrollTo(TopEdge)");
    const scrolled = run_cu_ok(run_directory, executable, "observe,actuate", [
      "scroll", "--window", handle, "--name", SCROLL_TARGET,
    ]);
    ensure(
      text_at(scrolled, "data.via") === "scroll-to"
        && text_at(scrolled, "data.addressing") === "accessibility-tree"
        && text_at(scrolled, "data.matched.name") === SCROLL_TARGET,
      "cu_linux_scroll_actuate:" + JSON.stringify(scrolled.data)
    );

    print("STEP independent pyatspi and CU get-extents confirm scroll target geometry below reference and inside window");
    let after = null;
    let pyatspi_after = null;
    for (let attempt = 0; attempt < 20; attempt = attempt + 1) {
      after = get_extents(run_directory, executable, handle, SCROLL_TARGET);
      pyatspi_after = independent_extents(run_directory, executable, fixture_title, SCROLL_TARGET);
      if (after !== null && pyatspi_after.available === true && pyatspi_after.showing === true) {
        const probe_y = int_at(pyatspi_after, "y");
        const probe_h = int_at(pyatspi_after, "height");
        if (probe_y > reference_bottom && probe_h > 0) { break; }
      }
      harness.sleep_ms(100);
    }
    ensure(after !== null, "cu_linux_scroll_extents_readback_missing");
    assert_pyatspi_onscreen_readback(
      run_directory, executable, fixture_title, reference_bottom,
      win_x, win_y, win_w, win_h, "after_scroll"
    );
    assert_cu_pyatspi_agreement(after, pyatspi_after, "after_scroll");
    const after_x = int_at(after, "data.extents.x");
    const after_y = int_at(after, "data.extents.y");
    const after_w = int_at(after, "data.extents.width");
    const after_h = int_at(after, "data.extents.height");
    ensure(
      after_w > 0
        && after_h > 0
        && after_y > reference_bottom
        && rh.has_item(at(after, "data.matched.states"), "showing")
        && after_x >= win_x
        && after_y >= win_y
        && after_x + after_w <= win_x + win_w
        && after_y + after_h <= win_y + win_h,
      "cu_linux_scroll_extents_readback:" + JSON.stringify({
        after: after.data,
        wheel_before: wheel_before.data,
        window: { x: win_x, y: win_y, width: win_w, height: win_h },
      })
    );

    succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_scroll_failed");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-scroll-to");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux AT-SPI scroll --name with typed scroll/get-extents usage honesty and independent pyatspi geometry read-back (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux AT-SPI scroll typed scroll/get-extents host-limit honesty when independent pyatspi desktop probe is unavailable (AT-SPI --name, no --coords)");
}
return;
