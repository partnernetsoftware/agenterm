// CEO: Linux raise + activate with independent xprop _NET_ACTIVE_WINDOW,
// windows inventory, and pyatspi STATE_ACTIVE read-back. activate must make
// the exact disposable window foreground; raise must restack within the
// foreground application without changing the desktop frontmost pid or the
// independent active XID. Typed activate/raise usage must reject AT-SPI
// --name, --coords, --bogus, and other unexpected arguments via
// usage_rejects_unexpected + command=usage, or an honest non-usage typed
// failure (never fake command=usage). Typed get-extents --name usage AND
// host-limit paths must both hold before process-state, desktop-state, and
// native actuate/read-back courts (no if/else gating those courts on
// atspi_available); get-extents --coords/--bogus must reject as
// command=usage. Missing-window and headless host-limit paths must also hold
// before any owned fixture window exists. AT-SPI inventory handles only; no
// --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-window-activate",
  "cu.linux-atspi-raise",
];

const MISSING_HANDLE = "99999999";
const AT_SPI_PROBE_NAME = "Raise Activate Court Anchor";
const DESKTOP_STATE_DEPTH = 3;
const DESKTOP_STATE_MAX_NODES = 64;

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function honest_actuate_non_usage_code(code) {
  return code === "a11y_backend_failed"
    || code === "unsupported"
    || code === "bad_handle"
    || code === "window_not_found"
    || code === "invalid_input";
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_raise_activate_empty:" + output.stderr);
  return JSON.parse(trimmed);
}


function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(rh.output_success(document), "cu_linux_raise_activate_reply:" + JSON.stringify(document));
  return document;
}

function invoke_actuate_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "actuate",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_raise_activate_actuate_cli:" + output.stdout + output.stderr);
  const reply = JSON.parse(output.stdout.trim());
  const command = text_at(reply, "command");
  ensure(
    command === "activate" || command === "raise" || command === "usage",
    "cu_linux_raise_activate_actuate_command:" + JSON.stringify(reply)
  );
  return reply;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 30000,
  });
  ensure(output.stdout.trim() !== "",
    "cu_linux_raise_activate_extents_cli:" + output.stdout + output.stderr);
  return JSON.parse(output.stdout.trim());
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_actuate_usage_reject(
  run_directory, executable, env, arguments, token, label
) {
  const reply = invoke_actuate_reply(run_directory, executable, arguments, env);
  ensure(!rh.output_success(reply),
    "cu_linux_raise_activate_usage_" + label + "_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  const command = text_at(reply, "command");
  if (code === "usage" || command === "usage") {
    ensure(
      code === "usage",
      "cu_linux_raise_activate_usage_" + label + "_code:" + JSON.stringify(reply.error)
    );
    ensure(
      command === "usage",
      "cu_linux_raise_activate_usage_" + label + "_command:" + JSON.stringify(reply)
    );
    ensure(
      usage_rejects_unexpected(text_at(reply, "error.message"), token),
      "cu_linux_raise_activate_usage_" + label + "_message:" + JSON.stringify(reply.error)
    );
  } else {
    ensure(
      command !== "usage" && honest_actuate_non_usage_code(code),
      "cu_linux_raise_activate_usage_" + label + "_honest:" + JSON.stringify(reply)
    );
  }
}

function assert_activate_raise_atspi_name_usage_limit(run_directory, executable, env) {
  assert_actuate_usage_reject(run_directory, executable, env, [
    "activate", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], "--name", "activate_name");
  assert_actuate_usage_reject(run_directory, executable, env, [
    "activate", "--window", "1", "--bogus",
  ], "--bogus", "activate_bogus");
  assert_actuate_usage_reject(run_directory, executable, env, [
    "activate", "--window", "1", "--coords", "10,10",
  ], "--coords", "activate_coords");
  assert_actuate_usage_reject(run_directory, executable, env, [
    "raise", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], "--name", "raise_name");
  assert_actuate_usage_reject(run_directory, executable, env, [
    "raise", "--window", "1", "--bogus",
  ], "--bogus", "raise_bogus");
  assert_actuate_usage_reject(run_directory, executable, env, [
    "raise", "--window", "1", "--coords", "10,10",
  ], "--coords", "raise_coords");
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(zero_handle),
    "cu_linux_raise_activate_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_raise_activate_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_raise_activate_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!rh.output_success(missing_name),
    "cu_linux_raise_activate_extents_usage_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_raise_activate_extents_usage_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_raise_activate_extents_usage_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_raise_activate_extents_usage_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!rh.output_success(extents_coords),
    "cu_linux_raise_activate_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_raise_activate_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_raise_activate_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_raise_activate_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!rh.output_success(extents_bogus),
    "cu_linux_raise_activate_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_raise_activate_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_raise_activate_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_raise_activate_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_missing_window(run_directory, executable, env) {
  const missing = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", MISSING_HANDLE, "--name", AT_SPI_PROBE_NAME,
  ], env);
  ensure(!rh.output_success(missing),
    "cu_linux_raise_activate_extents_miss_ok:" + JSON.stringify(missing));
  ensure(
    text_at(missing, "command") !== "usage",
    "cu_linux_raise_activate_extents_miss_fake_usage:" + JSON.stringify(missing)
  );
  const code = text_at(missing, "error.code");
  ensure(
    code === "a11y_node_not_found" || code === "a11y_backend_failed"
      || code === "unsupported" || code === "bad_handle",
    "cu_linux_raise_activate_extents_miss_code:" + JSON.stringify(missing.error)
  );
  if (code === "a11y_node_not_found") {
    ensure(
      text_at(missing, "error.message").indexOf(AT_SPI_PROBE_NAME) >= 0,
      "cu_linux_raise_activate_extents_miss_message:" + JSON.stringify(missing.error)
    );
  }
}

function assert_fixture_process_state(run_directory, executable, fixture_pid) {
  const process_state = run_cu(run_directory, executable, "observe", [
    "process-state", "--pid", "" + fixture_pid,
  ]);
  ensure(
    text_at(process_state, "command") === "process-state",
    "cu_linux_raise_activate_process_state_command:" + JSON.stringify(process_state)
  );
  ensure(
    int_at(process_state, "data.pid") === fixture_pid
      && text_at(process_state, "data.state") === "live"
      && text_at(process_state, "data.start_identity") !== ""
      && flag_at(process_state, "data.verified"),
    "cu_linux_raise_activate_process_state:" + JSON.stringify(process_state.data)
  );
}

function assert_fixture_desktop_state(
  run_directory, executable, fixture_pid, fixture_title, handle_text, inventory_row
) {
  const state = run_cu(run_directory, executable, "observe", [
    "desktop-state", "--window", handle_text,
    "--depth", "" + DESKTOP_STATE_DEPTH,
    "--max-nodes", "" + DESKTOP_STATE_MAX_NODES,
  ]);
  ensure(
    text_at(state, "command") === "desktop-state",
    "cu_linux_raise_activate_desktop_state_command:" + JSON.stringify(state)
  );
  ensure(
    int_at(state, "data.window.handle") === int_at(inventory_row, "handle")
      && text_at(state, "data.window.title") === fixture_title
      && text_at(state, "data.window.title") === text_at(inventory_row, "title")
      && int_at(state, "data.window.process_id") === fixture_pid,
    "cu_linux_raise_activate_desktop_state_window:" + JSON.stringify({
      state: state.data.window,
      inventory: inventory_row,
    })
  );
  ensure(
    int_at(state, "data.tree.returned") > 0
      && int_at(state, "data.tree.returned") <= DESKTOP_STATE_MAX_NODES,
    "cu_linux_raise_activate_desktop_state_tree:" + JSON.stringify(state.data.tree)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", AT_SPI_PROBE_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!rh.output_success(reply),
    "cu_linux_raise_activate_extents_unavailable_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "command") !== "usage",
    "cu_linux_raise_activate_extents_unavailable_fake_usage:" + JSON.stringify(reply)
  );
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_raise_activate_extents_unavailable_code:" + code
  );
}

function assert_activate_raise_usage_limit(run_directory, executable) {
  const missing_activate = run_cu_reply(run_directory, executable, "actuate", ["activate"]);
  ensure(!rh.output_success(missing_activate), "cu_linux_raise_activate_usage_activate_ok:" + JSON.stringify(missing_activate));
  ensure(
    text_at(missing_activate, "error.code") === "usage",
    "cu_linux_raise_activate_usage_activate_code:" + JSON.stringify(missing_activate.error)
  );
  ensure(
    text_at(missing_activate, "error.message").indexOf("--window") >= 0,
    "cu_linux_raise_activate_usage_activate_message:" + JSON.stringify(missing_activate.error)
  );

  const missing_raise = run_cu_reply(run_directory, executable, "actuate", ["raise"]);
  ensure(!rh.output_success(missing_raise), "cu_linux_raise_activate_usage_raise_ok:" + JSON.stringify(missing_raise));
  ensure(
    text_at(missing_raise, "error.code") === "usage",
    "cu_linux_raise_activate_usage_raise_code:" + JSON.stringify(missing_raise.error)
  );
  ensure(
    text_at(missing_raise, "error.message").indexOf("--window") >= 0,
    "cu_linux_raise_activate_usage_raise_message:" + JSON.stringify(missing_raise.error)
  );

  const zero_activate = run_cu_reply(run_directory, executable, "actuate", [
    "activate", "--window", "0",
  ]);
  ensure(!rh.output_success(zero_activate), "cu_linux_raise_activate_zero_activate_ok:" + JSON.stringify(zero_activate));
  ensure(
    text_at(zero_activate, "error.code") === "usage",
    "cu_linux_raise_activate_zero_activate_code:" + JSON.stringify(zero_activate.error)
  );
  ensure(
    text_at(zero_activate, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_raise_activate_zero_activate_message:" + JSON.stringify(zero_activate.error)
  );

  const zero_raise = run_cu_reply(run_directory, executable, "actuate", [
    "raise", "--window", "0",
  ]);
  ensure(!rh.output_success(zero_raise), "cu_linux_raise_activate_zero_raise_ok:" + JSON.stringify(zero_raise));
  ensure(
    text_at(zero_raise, "error.code") === "usage",
    "cu_linux_raise_activate_zero_raise_code:" + JSON.stringify(zero_raise.error)
  );
  ensure(
    text_at(zero_raise, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_raise_activate_zero_raise_message:" + JSON.stringify(zero_raise.error)
  );

  const stray_flag = run_cu_reply(run_directory, executable, "actuate", [
    "raise", "--window", "1", "--force",
  ]);
  ensure(!rh.output_success(stray_flag), "cu_linux_raise_activate_stray_flag_ok:" + JSON.stringify(stray_flag));
  ensure(
    text_at(stray_flag, "error.code") === "usage",
    "cu_linux_raise_activate_stray_flag_code:" + JSON.stringify(stray_flag.error)
  );
  ensure(
    text_at(stray_flag, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_raise_activate_stray_flag_message:" + JSON.stringify(stray_flag.error)
  );
}

function assert_activate_raise_missing_window(run_directory, executable) {
  const missing_activate = run_cu_reply(run_directory, executable, "actuate", [
    "activate", "--window", MISSING_HANDLE,
  ]);
  ensure(!rh.output_success(missing_activate), "cu_linux_raise_activate_missing_activate_ok:" + JSON.stringify(missing_activate));
  ensure(
    text_at(missing_activate, "error.code") === "window_not_found",
    "cu_linux_raise_activate_missing_activate_code:" + JSON.stringify(missing_activate.error)
  );
  ensure(
    text_at(missing_activate, "error.message").indexOf(MISSING_HANDLE) >= 0,
    "cu_linux_raise_activate_missing_activate_message:" + JSON.stringify(missing_activate.error)
  );

  const missing_raise = run_cu_reply(run_directory, executable, "actuate", [
    "raise", "--window", MISSING_HANDLE,
  ]);
  ensure(!rh.output_success(missing_raise), "cu_linux_raise_activate_missing_raise_ok:" + JSON.stringify(missing_raise));
  ensure(
    text_at(missing_raise, "error.code") === "window_not_found",
    "cu_linux_raise_activate_missing_raise_code:" + JSON.stringify(missing_raise.error)
  );
  ensure(
    text_at(missing_raise, "error.message").indexOf(MISSING_HANDLE) >= 0,
    "cu_linux_raise_activate_missing_raise_message:" + JSON.stringify(missing_raise.error)
  );
}

function assert_headless_host_limit(run_directory, executable, verb) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    [verb, "--window", "1"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!rh.output_success(reply), "cu_linux_raise_activate_headless_" + verb + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_raise_activate_headless_" + verb + "_code:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("window enumeration") >= 0
      || message.indexOf("mechanism unavailable") >= 0,
    "cu_linux_raise_activate_headless_" + verb + "_message:" + JSON.stringify(reply.error)
  );
}

function focused_row(run_directory, executable) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--focused", "true", "--max", "1",
  ]);
  const rows = reply.data.windows;
  ensure(rows !== undefined && rows.length === 1, "cu_linux_raise_activate_focused_missing");
  return rows[0];
}

function window_rows(run_directory, executable, pid) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  const by_title = {};
  for (const row of rows) { by_title[text_at(row, "title")] = row; }
  return by_title;
}

function parse_x11_id(token) {
  let cleaned = token;
  const comma = cleaned.indexOf(",");
  if (comma >= 0) { cleaned = cleaned.slice(0, comma); }
  cleaned = cleaned.trim();
  let start = 0;
  if (cleaned.length >= 2 && cleaned.charAt(0) === "0"
      && (cleaned.charAt(1) === "x" || cleaned.charAt(1) === "X")) {
    start = 2;
  }
  ensure(cleaned.length > start, "cu_linux_raise_activate_xprop_id_empty:" + token);
  let result = 0;
  for (let index = start; index < cleaned.length; index = index + 1) {
    const code = cleaned.charCodeAt(index);
    let digit = -1;
    if (code >= 48 && code <= 57) { digit = code - 48; }
    else if (code >= 97 && code <= 102) { digit = code - 87; }
    else if (code >= 65 && code <= 70) { digit = code - 55; }
    else { throw "cu_linux_raise_activate_xprop_id:" + token; }
    result = result * 16 + digit;
  }
  return result;
}

function independent_net_active_window(run_directory, executable) {
  const output = rh.command("xprop", ["-root", "_NET_ACTIVE_WINDOW"], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  ensure(output.success === true,
    "cu_linux_raise_activate_xprop_active:" + output.stderr + output.stdout);
  const marker = "window id # ";
  const start = output.stdout.indexOf(marker);
  ensure(start >= 0,
    "cu_linux_raise_activate_xprop_active_parse:" + output.stdout);
  const rest = output.stdout.slice(start + marker.length).trim();
  const token = rest.split(",")[0].trim().split(" ")[0];
  ensure(token.length > 2 && token.slice(0, 2) === "0x",
    "cu_linux_raise_activate_xprop_active_token:" + token);
  return token.toLowerCase();
}

function independent_net_active_handle(run_directory, executable) {
  return parse_x11_id(independent_net_active_window(run_directory, executable));
}

function independent_atspi_active_title(executable) {
  const script = [
    "import json, pyatspi",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "for index in range(desktop.childCount):",
    "    app = desktop.getChildAtIndex(index)",
    "    if app is None:",
    "        continue",
    "    for child_index in range(app.childCount):",
    "        frame = app.getChildAtIndex(child_index)",
    "        if frame is None:",
    "            continue",
    "        try:",
    "            if frame.getState().contains(pyatspi.STATE_ACTIVE):",
    "                print(json.dumps({'title': frame.name or '', 'active': True}))",
    "                raise SystemExit(0)",
    "        except Exception:",
    "            pass",
    "print(json.dumps({'title': '', 'active': False}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 30000,
  });
  ensure(output.success === true,
    "cu_linux_raise_activate_atspi_active:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function wait_xprop_active_handle(run_directory, executable, expected_handle) {
  let xid = independent_net_active_handle(run_directory, executable);
  let attempt = 0;
  while (attempt < 20 && xid !== expected_handle) {
    rh.sleep_ms(50);
    xid = independent_net_active_handle(run_directory, executable);
    attempt = attempt + 1;
  }
  return xid;
}

function ensure_inventory_and_xprop_active(
  run_directory,
  executable,
  expected_handle,
  expected_pid,
  expected_title,
  label,
  check_atspi
) {
  const focused = focused_row(run_directory, executable);
  ensure(
    int_at(focused, "handle") === expected_handle
      && (expected_pid === 0 || int_at(focused, "process_id") === expected_pid)
      && (expected_title === "" || text_at(focused, "title") === expected_title),
    "cu_linux_raise_activate_" + label + "_inventory:" + JSON.stringify(focused)
  );
  const xid = wait_xprop_active_handle(run_directory, executable, expected_handle);
  ensure(
    xid === expected_handle,
    "cu_linux_raise_activate_" + label + "_xprop:" + xid + "!=" + expected_handle
      + ":inventory=" + JSON.stringify(focused)
  );
  if (check_atspi === true && expected_title !== "") {
    const atspi_active = independent_atspi_active_title(executable);
    if (atspi_active.active === true) {
      ensure(
        atspi_active.title === expected_title,
        "cu_linux_raise_activate_" + label + "_atspi:" + JSON.stringify(atspi_active)
          + ":expected=" + expected_title
      );
    } else {
      print(
        "host-limit: independent pyatspi STATE_ACTIVE probe unavailable for "
          + label + "; xprop+inventory read-back still holds"
      );
    }
  }
  return focused;
}

function ensure_xprop_agrees_with_focused(run_directory, executable, label) {
  const focused = focused_row(run_directory, executable);
  const expected = int_at(focused, "handle");
  const xid = wait_xprop_active_handle(run_directory, executable, expected);
  ensure(
    xid === expected,
    "cu_linux_raise_activate_" + label + "_xprop:" + xid + "!=" + expected
      + ":inventory=" + JSON.stringify(focused)
  );
  return focused;
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-raise-activate-smoke-run");
rh.create_dir_all(run_directory);

const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

print("STEP activate/raise typed-fail usage when --window is missing or zero");
assert_activate_raise_usage_limit(run_directory, executable);

print("STEP activate/raise typed-fails usage when AT-SPI --name/--coords/--bogus is present (usage_rejects_unexpected + command=usage, or honest non-usage typed failure; never fake command=usage)");
assert_activate_raise_atspi_name_usage_limit(run_directory, executable, env);

print("STEP get-extents typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present (command=usage) before process-state/desktop-state and activate/raise actuate/read-back court");
assert_get_extents_usage_limit(run_directory, executable, env);

print("STEP get-extents typed-fail host-limit when AT-SPI bus address is invalid before process-state/desktop-state and activate/raise actuate/read-back court");
assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);

print("STEP get-extents typed-fail when handle is absent from inventory (honest non-usage; never fake command=usage) before activate/raise actuate/read-back court");
assert_get_extents_missing_window(run_directory, executable, env);

if (!atspi_available) {
  print("STEP independent pyatspi desktop probe unavailable: get-extents usage AND host-limit already held; raise/activate read-back still uses xprop/inventory");
}

print("STEP activate/raise typed-fail window_not_found when handle is absent from inventory");
assert_activate_raise_missing_window(run_directory, executable);

print("STEP activate/raise without DISPLAY typed-fail unsupported host-limit");
assert_headless_host_limit(run_directory, executable, "activate");
assert_headless_host_limit(run_directory, executable, "raise");

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_raise_activate_fixture_missing:" + fixture_source);

const witness_source = rh.join(run_directory, "agenterm_witness_window.py");
rh.write_text(witness_source, [
  "#!/usr/bin/env python3",
  "import os, sys",
  "import gi; gi.require_version('Gtk', '3.0')",
  "from gi.repository import Gtk",
  "w = Gtk.Window(title='agenterm-witness-%d' % os.getpid())",
  "w.set_default_size(200, 100)",
  "w.add(Gtk.Label(label='witness'))",
  "w.connect('destroy', Gtk.main_quit)",
  "w.show_all()",
  "w.present()",
  "sys.stdout.write('ready %d\\n' % os.getpid()); sys.stdout.flush()",
  "Gtk.main()",
].join("\n"));

let fixture = -1;
let witness = -1;
let fixture_pid = 0;
let witness_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
  const second_title = "agenterm-linux-second-" + fixture_pid;

  witness = harness.start({
    program: "python3",
    args: [witness_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  witness_pid = harness.spawned_pid(witness);
  const witness_title = "agenterm-witness-" + witness_pid;

  const fixture_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(fixture_wait, "data.met"), "cu_linux_raise_activate_fixture_wait");
  const witness_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", witness_title,
  ]);
  ensure(flag_at(witness_wait, "data.met"), "cu_linux_raise_activate_witness_wait");

  const fixture_windows = window_rows(run_directory, executable, fixture_pid);
  const witness_windows = window_rows(run_directory, executable, witness_pid);
  const main_row = fixture_windows[fixture_title];
  const second_row = fixture_windows[second_title];
  const witness_row = witness_windows[witness_title];
  ensure(main_row !== undefined && second_row !== undefined && witness_row !== undefined,
    "cu_linux_raise_activate_window_inventory");
  const main_handle = "" + int_at(main_row, "handle");
  const second_handle = "" + int_at(second_row, "handle");
  const witness_handle = "" + int_at(witness_row, "handle");

  const main_xid = int_at(main_row, "handle");
  const witness_xid = int_at(witness_row, "handle");

  print("STEP process-state binds the owned fixture pid before activate/raise actuate/read-back court");
  assert_fixture_process_state(run_directory, executable, fixture_pid);

  print("STEP desktop-state window row agrees with inventory before activate/raise actuate/read-back court");
  assert_fixture_desktop_state(
    run_directory, executable, fixture_pid, fixture_title, main_handle, main_row
  );

  print("STEP activate witness; independent xprop _NET_ACTIVE_WINDOW, windows inventory, and pyatspi STATE_ACTIVE must read that exact window");
  run_cu(run_directory, executable, "observe,actuate", [
    "activate", "--window", witness_handle,
  ]);
  let focused = ensure_inventory_and_xprop_active(
    run_directory, executable, witness_xid, witness_pid, witness_title, "witness_focus", atspi_available
  );

  print("STEP activate main fixture; independent xprop _NET_ACTIVE_WINDOW, windows inventory, and pyatspi STATE_ACTIVE must read that exact window");
  const activated_main = run_cu(run_directory, executable, "observe,actuate", [
    "activate", "--window", main_handle,
  ]);
  ensure(
    flag_at(activated_main, "data.verified") && flag_at(activated_main, "data.after.focused"),
    "cu_linux_raise_activate_activate_reply:" + JSON.stringify(activated_main.data)
  );
  focused = ensure_inventory_and_xprop_active(
    run_directory, executable, main_xid, fixture_pid, fixture_title, "main_focus", atspi_available
  );

  print("STEP raise on a background application must fail typed foreground_changed");
  run_cu(run_directory, executable, "observe,actuate", [
    "activate", "--window", witness_handle,
  ]);
  focused = ensure_inventory_and_xprop_active(
    run_directory, executable, witness_xid, witness_pid, witness_title, "witness_reset", atspi_available
  );
  const background_raise = run_cu_reply(run_directory, executable, "observe,actuate", [
    "raise", "--window", main_handle,
  ]);
  ensure(
    !flag_at(background_raise, "ok")
      && text_at(background_raise, "error.code") === "foreground_changed",
    "cu_linux_raise_activate_raise_background:" + JSON.stringify(background_raise)
  );
  focused = ensure_xprop_agrees_with_focused(
    run_directory, executable, "raise_background_active"
  );
  if (int_at(focused, "handle") === witness_xid) {
    print("read-back after refused background raise: desktop frontmost stayed witness handle " + witness_xid);
  } else {
    print(
      "host-limit: refused background raise typed foreground_changed, but independent xprop/_NET_ACTIVE_WINDOW and windows inventory agree the desktop frontmost moved to handle "
        + int_at(focused, "handle") + " title=" + text_at(focused, "title")
    );
  }

  print("STEP raise within the foreground application reorders by read-back without changing desktop frontmost pid or independent active XID");
  const reactivated_main = run_cu(run_directory, executable, "observe,actuate", [
    "activate", "--window", main_handle,
  ]);
  ensure(
    flag_at(reactivated_main, "data.verified") && flag_at(reactivated_main, "data.after.focused"),
    "cu_linux_raise_activate_reactivate_reply:" + JSON.stringify(reactivated_main.data)
  );
  focused = ensure_inventory_and_xprop_active(
    run_directory, executable, main_xid, fixture_pid, fixture_title, "reactivate_focus", atspi_available
  );
  const active_before_raise = independent_net_active_handle(run_directory, executable);
  ensure(
    active_before_raise === main_xid,
    "cu_linux_raise_activate_raise_baseline_xprop:" + active_before_raise + "!=" + main_xid
  );
  const front_pid_before_raise = int_at(focused, "process_id");
  run_cu(run_directory, executable, "observe,actuate", [
    "orderwin", "--window", second_handle, "--relation", "above", "--relative", main_handle,
  ]);
  const stacked = window_rows(run_directory, executable, fixture_pid);
  ensure(
    int_at(stacked[second_title], "z_index") < int_at(stacked[fixture_title], "z_index"),
    "cu_linux_raise_activate_orderwin_readback:" + JSON.stringify(stacked)
  );
  focused = focused_row(run_directory, executable);
  ensure(
    int_at(focused, "process_id") === front_pid_before_raise,
    "cu_linux_raise_activate_orderwin_front:" + JSON.stringify(focused)
  );
  let active_after_orderwin = independent_net_active_handle(run_directory, executable);
  if (active_after_orderwin === active_before_raise) {
    print("read-back after orderwin: independent _NET_ACTIVE_WINDOW unchanged at handle " + active_before_raise);
  } else {
    print(
      "host-limit: orderwin restacked within fixture pid but independent _NET_ACTIVE_WINDOW moved "
        + active_before_raise + " -> " + active_after_orderwin
        + "; re-activating main before raise court"
    );
    run_cu(run_directory, executable, "observe,actuate", [
      "activate", "--window", main_handle,
    ]);
    focused = ensure_inventory_and_xprop_active(
      run_directory, executable, main_xid, fixture_pid, fixture_title, "orderwin_reactivate", atspi_available
    );
    active_after_orderwin = independent_net_active_handle(run_directory, executable);
    ensure(
      active_after_orderwin === main_xid,
      "cu_linux_raise_activate_orderwin_reactivate:" + active_after_orderwin + "!=" + main_xid
    );
  }
  const raised = run_cu(run_directory, executable, "observe,actuate", [
    "raise", "--window", main_handle,
  ]);
  ensure(
    flag_at(raised, "data.verified") && flag_at(raised, "data.frontmost_app_unchanged"),
    "cu_linux_raise_activate_raise_reply:" + JSON.stringify(raised.data)
  );
  const after_raise = window_rows(run_directory, executable, fixture_pid);
  ensure(
    int_at(after_raise[fixture_title], "z_index")
      < int_at(after_raise[second_title], "z_index"),
    "cu_linux_raise_activate_raise_inventory:" + JSON.stringify(after_raise)
  );
  focused = ensure_inventory_and_xprop_active(
    run_directory, executable, main_xid, fixture_pid, fixture_title, "raise_focus", atspi_available
  );
  ensure(
    int_at(focused, "process_id") === front_pid_before_raise,
    "cu_linux_raise_activate_raise_front:" + JSON.stringify(focused)
  );
  ensure(
    independent_net_active_handle(run_directory, executable) === active_before_raise,
    "cu_linux_raise_activate_raise_active:" + active_before_raise
  );
} finally {
  if (witness_pid !== 0) {
    rh.command("kill", ["-TERM", "" + witness_pid], { timeout_ms: 5000 });
  }
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (witness >= 0) {
    try { harness.wait(witness, 5000); } catch (error) { print("cleanup witness: " + error); }
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup fixture: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-raise-activate");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-window-activate");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-raise");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: CEO Linux raise+activate with independent xprop _NET_ACTIVE_WINDOW + windows inventory + pyatspi STATE_ACTIVE read-back, typed activate/raise/get-extents --name/--coords/--bogus usage or honest non-usage failure, get-extents usage/host-limit plus --coords/--bogus command=usage honesty, and process-state/desktop-state courts before actuate (AT-SPI --name, no --coords)");
} else {
  print("PASS: CEO Linux raise+activate with independent xprop _NET_ACTIVE_WINDOW + windows inventory handle read-back, typed activate/raise/get-extents --name/--coords/--bogus usage or honest non-usage failure, get-extents usage/host-limit plus --coords/--bogus command=usage honesty, and process-state/desktop-state courts before actuate (AT-SPI --name, no --coords)");
}
return;
