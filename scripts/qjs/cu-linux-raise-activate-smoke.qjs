// CEO: Linux raise + activate with independent windows inventory read-back.
// activate must make the exact disposable window foreground; raise must
// restack within the foreground application without changing the desktop
// frontmost pid. Typed usage, missing-window and headless host-limit paths
// must hold before any owned fixture window exists. AT-SPI inventory
// handles only; no --name, no --coords or screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-window-activate",
  "cu.linux-atspi-raise",
];

const MISSING_HANDLE = "99999999";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function cu_env(executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu_reply(run_directory, executable, grant, arguments, env, env_remove) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const spec = {
    program: executable,
    args: argv,
    current_dir: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  };
  if (env_remove !== undefined && env_remove.length > 0) { spec.env_remove = env_remove; }
  const output = rh.command_spec(spec);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_raise_activate_empty:" + output.stderr);
  return JSON.parse(trimmed);
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_raise_activate_reply:" + JSON.stringify(document));
  return document;
}

function assert_activate_raise_usage_limit(run_directory, executable) {
  const missing_activate = run_cu_reply(run_directory, executable, "actuate", ["activate"]);
  ensure(!output_success(missing_activate), "cu_linux_raise_activate_usage_activate_ok:" + JSON.stringify(missing_activate));
  ensure(
    text_at(missing_activate, "error.code") === "usage",
    "cu_linux_raise_activate_usage_activate_code:" + JSON.stringify(missing_activate.error)
  );
  ensure(
    text_at(missing_activate, "error.message").indexOf("--window") >= 0,
    "cu_linux_raise_activate_usage_activate_message:" + JSON.stringify(missing_activate.error)
  );

  const missing_raise = run_cu_reply(run_directory, executable, "actuate", ["raise"]);
  ensure(!output_success(missing_raise), "cu_linux_raise_activate_usage_raise_ok:" + JSON.stringify(missing_raise));
  ensure(
    text_at(missing_raise, "error.code") === "usage",
    "cu_linux_raise_activate_usage_raise_code:" + JSON.stringify(missing_raise.error)
  );
  ensure(
    text_at(missing_raise, "error.message").indexOf("--window") >= 0,
    "cu_linux_raise_activate_usage_raise_message:" + JSON.stringify(missing_raise.error)
  );

  const zero_activate = run_cu_reply(run_directory, executable, "actuate", [
    "activate", "--window", "0",
  ]);
  ensure(!output_success(zero_activate), "cu_linux_raise_activate_zero_activate_ok:" + JSON.stringify(zero_activate));
  ensure(
    text_at(zero_activate, "error.code") === "usage",
    "cu_linux_raise_activate_zero_activate_code:" + JSON.stringify(zero_activate.error)
  );
  ensure(
    text_at(zero_activate, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_raise_activate_zero_activate_message:" + JSON.stringify(zero_activate.error)
  );

  const zero_raise = run_cu_reply(run_directory, executable, "actuate", [
    "raise", "--window", "0",
  ]);
  ensure(!output_success(zero_raise), "cu_linux_raise_activate_zero_raise_ok:" + JSON.stringify(zero_raise));
  ensure(
    text_at(zero_raise, "error.code") === "usage",
    "cu_linux_raise_activate_zero_raise_code:" + JSON.stringify(zero_raise.error)
  );
  ensure(
    text_at(zero_raise, "error.message").indexOf("non-zero") >= 0,
    "cu_linux_raise_activate_zero_raise_message:" + JSON.stringify(zero_raise.error)
  );

  const stray_flag = run_cu_reply(run_directory, executable, "actuate", [
    "raise", "--window", "1", "--force",
  ]);
  ensure(!output_success(stray_flag), "cu_linux_raise_activate_stray_flag_ok:" + JSON.stringify(stray_flag));
  ensure(
    text_at(stray_flag, "error.code") === "usage",
    "cu_linux_raise_activate_stray_flag_code:" + JSON.stringify(stray_flag.error)
  );
  ensure(
    text_at(stray_flag, "error.message").indexOf("unexpected") >= 0,
    "cu_linux_raise_activate_stray_flag_message:" + JSON.stringify(stray_flag.error)
  );
}

function assert_activate_raise_missing_window(run_directory, executable) {
  const missing_activate = run_cu_reply(run_directory, executable, "actuate", [
    "activate", "--window", MISSING_HANDLE,
  ]);
  ensure(!output_success(missing_activate), "cu_linux_raise_activate_missing_activate_ok:" + JSON.stringify(missing_activate));
  ensure(
    text_at(missing_activate, "error.code") === "window_not_found",
    "cu_linux_raise_activate_missing_activate_code:" + JSON.stringify(missing_activate.error)
  );
  ensure(
    text_at(missing_activate, "error.message").indexOf(MISSING_HANDLE) >= 0,
    "cu_linux_raise_activate_missing_activate_message:" + JSON.stringify(missing_activate.error)
  );

  const missing_raise = run_cu_reply(run_directory, executable, "actuate", [
    "raise", "--window", MISSING_HANDLE,
  ]);
  ensure(!output_success(missing_raise), "cu_linux_raise_activate_missing_raise_ok:" + JSON.stringify(missing_raise));
  ensure(
    text_at(missing_raise, "error.code") === "window_not_found",
    "cu_linux_raise_activate_missing_raise_code:" + JSON.stringify(missing_raise.error)
  );
  ensure(
    text_at(missing_raise, "error.message").indexOf(MISSING_HANDLE) >= 0,
    "cu_linux_raise_activate_missing_raise_message:" + JSON.stringify(missing_raise.error)
  );
}

function assert_headless_host_limit(run_directory, executable, verb) {
  const reply = run_cu_reply(
    run_directory,
    executable,
    "actuate",
    [verb, "--window", "1"],
    {
      AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
      AGENTERM_NO_ACTIVATE: "1",
    },
    ["DISPLAY"]
  );
  ensure(!output_success(reply), "cu_linux_raise_activate_headless_" + verb + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "unsupported",
    "cu_linux_raise_activate_headless_" + verb + "_code:" + JSON.stringify(reply.error)
  );
  const message = text_at(reply, "error.message").toLowerCase();
  ensure(
    message.indexOf("window enumeration") >= 0
      || message.indexOf("mechanism unavailable") >= 0,
    "cu_linux_raise_activate_headless_" + verb + "_message:" + JSON.stringify(reply.error)
  );
}

function focused_row(run_directory, executable) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--focused", "true", "--max", "1",
  ]);
  const rows = reply.data.windows;
  ensure(rows !== undefined && rows.length === 1, "cu_linux_raise_activate_focused_missing");
  return rows[0];
}

function window_rows(run_directory, executable, pid) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  const by_title = {};
  for (const row of rows) { by_title[text_at(row, "title")] = row; }
  return by_title;
}

function independent_net_active_window(run_directory, executable) {
  const output = rh.command("xprop", ["-root", "_NET_ACTIVE_WINDOW"], {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  ensure(output.success === true,
    "cu_linux_raise_activate_xprop_active:" + output.stderr + output.stdout);
  const marker = "window id # ";
  const start = output.stdout.indexOf(marker);
  ensure(start >= 0,
    "cu_linux_raise_activate_xprop_active_parse:" + output.stdout);
  const token = output.stdout.slice(start + marker.length).trim().split(" ")[0];
  ensure(token.length > 2 && token.slice(0, 2) === "0x",
    "cu_linux_raise_activate_xprop_active_token:" + token);
  return token.toLowerCase();
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const run_directory = rh.join(repo, "target/cu-linux-raise-activate-smoke-run");
rh.create_dir_all(run_directory);

print("STEP activate/raise typed-fail usage when --window is missing or zero");
assert_activate_raise_usage_limit(run_directory, executable);

print("STEP activate/raise typed-fail window_not_found when handle is absent from inventory");
assert_activate_raise_missing_window(run_directory, executable);

print("STEP activate/raise without DISPLAY typed-fail unsupported host-limit");
assert_headless_host_limit(run_directory, executable, "activate");
assert_headless_host_limit(run_directory, executable, "raise");

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_raise_activate_fixture_missing:" + fixture_source);

const witness_source = rh.join(run_directory, "agenterm_witness_window.py");
rh.write_text(witness_source, [
  "#!/usr/bin/env python3",
  "import os, sys",
  "import gi; gi.require_version('Gtk', '3.0')",
  "from gi.repository import Gtk",
  "w = Gtk.Window(title='agenterm-witness-%d' % os.getpid())",
  "w.set_default_size(200, 100)",
  "w.add(Gtk.Label(label='witness'))",
  "w.connect('destroy', Gtk.main_quit)",
  "w.show_all()",
  "w.present()",
  "sys.stdout.write('ready %d\\n' % os.getpid()); sys.stdout.flush()",
  "Gtk.main()",
].join("\n"));

let fixture = -1;
let witness = -1;
let fixture_pid = 0;
let witness_pid = 0;
try {
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
  const second_title = "agenterm-linux-second-" + fixture_pid;

  witness = harness.start({
    program: "python3",
    args: [witness_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  witness_pid = harness.spawned_pid(witness);
  const witness_title = "agenterm-witness-" + witness_pid;

  const fixture_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(fixture_wait, "data.met"), "cu_linux_raise_activate_fixture_wait");
  const witness_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", witness_title,
  ]);
  ensure(flag_at(witness_wait, "data.met"), "cu_linux_raise_activate_witness_wait");

  const fixture_windows = window_rows(run_directory, executable, fixture_pid);
  const witness_windows = window_rows(run_directory, executable, witness_pid);
  const main_row = fixture_windows[fixture_title];
  const second_row = fixture_windows[second_title];
  const witness_row = witness_windows[witness_title];
  ensure(main_row !== undefined && second_row !== undefined && witness_row !== undefined,
    "cu_linux_raise_activate_window_inventory");
  const main_handle = "" + int_at(main_row, "handle");
  const second_handle = "" + int_at(second_row, "handle");
  const witness_handle = "" + int_at(witness_row, "handle");

  print("STEP activate witness; independent focused inventory must read that exact handle");
  run_cu(run_directory, executable, "observe,actuate", [
    "activate", "--window", witness_handle,
  ]);
  let focused = focused_row(run_directory, executable);
  ensure(
    int_at(focused, "handle") === int_at(witness_row, "handle")
      && text_at(focused, "title") === witness_title,
    "cu_linux_raise_activate_witness_focus:" + JSON.stringify(focused)
  );

  print("STEP activate main fixture; independent focused inventory must read that exact handle");
  const activated_main = run_cu(run_directory, executable, "observe,actuate", [
    "activate", "--window", main_handle,
  ]);
  ensure(
    flag_at(activated_main, "data.verified") && flag_at(activated_main, "data.after.focused"),
    "cu_linux_raise_activate_activate_reply:" + JSON.stringify(activated_main.data)
  );
  focused = focused_row(run_directory, executable);
  ensure(
    int_at(focused, "handle") === int_at(main_row, "handle")
      && int_at(focused, "process_id") === fixture_pid
      && text_at(focused, "title") === fixture_title,
    "cu_linux_raise_activate_main_focus:" + JSON.stringify(focused)
  );

  print("STEP raise on a background application must fail typed foreground_changed");
  run_cu(run_directory, executable, "observe,actuate", [
    "activate", "--window", witness_handle,
  ]);
  focused = focused_row(run_directory, executable);
  ensure(int_at(focused, "handle") === int_at(witness_row, "handle"),
    "cu_linux_raise_activate_witness_reset:" + JSON.stringify(focused));
  const background_raise = run_cu_reply(run_directory, executable, "observe,actuate", [
    "raise", "--window", main_handle,
  ]);
  ensure(
    !flag_at(background_raise, "ok")
      && text_at(background_raise, "error.code") === "foreground_changed",
    "cu_linux_raise_activate_raise_background:" + JSON.stringify(background_raise)
  );

  print("STEP raise within the foreground application reorders by read-back without changing desktop frontmost pid");
  const reactivated_main = run_cu(run_directory, executable, "observe,actuate", [
    "activate", "--window", main_handle,
  ]);
  ensure(
    flag_at(reactivated_main, "data.verified") && flag_at(reactivated_main, "data.after.focused"),
    "cu_linux_raise_activate_reactivate_reply:" + JSON.stringify(reactivated_main.data)
  );
  focused = focused_row(run_directory, executable);
  ensure(
    int_at(focused, "handle") === int_at(main_row, "handle")
      && int_at(focused, "process_id") === fixture_pid
      && text_at(focused, "title") === fixture_title,
    "cu_linux_raise_activate_reactivate_focus:" + JSON.stringify(focused)
  );
  const active_before_raise = independent_net_active_window(run_directory, executable);
  const front_pid_before_raise = int_at(focused, "process_id");
  run_cu(run_directory, executable, "observe,actuate", [
    "orderwin", "--window", second_handle, "--relation", "above", "--relative", main_handle,
  ]);
  const stacked = window_rows(run_directory, executable, fixture_pid);
  ensure(
    int_at(stacked[second_title], "z_index") < int_at(stacked[fixture_title], "z_index"),
    "cu_linux_raise_activate_orderwin_readback:" + JSON.stringify(stacked)
  );
  focused = focused_row(run_directory, executable);
  ensure(
    int_at(focused, "process_id") === front_pid_before_raise,
    "cu_linux_raise_activate_orderwin_front:" + JSON.stringify(focused)
  );
  ensure(
    independent_net_active_window(run_directory, executable) === active_before_raise,
    "cu_linux_raise_activate_orderwin_active:" + active_before_raise
  );
  const raised = run_cu(run_directory, executable, "observe,actuate", [
    "raise", "--window", main_handle,
  ]);
  ensure(
    flag_at(raised, "data.verified") && flag_at(raised, "data.frontmost_app_unchanged"),
    "cu_linux_raise_activate_raise_reply:" + JSON.stringify(raised.data)
  );
  const after_raise = window_rows(run_directory, executable, fixture_pid);
  ensure(
    int_at(after_raise[fixture_title], "z_index")
      < int_at(after_raise[second_title], "z_index"),
    "cu_linux_raise_activate_raise_inventory:" + JSON.stringify(after_raise)
  );
  focused = focused_row(run_directory, executable);
  ensure(
    int_at(focused, "handle") === int_at(main_row, "handle")
      && int_at(focused, "process_id") === fixture_pid
      && int_at(focused, "process_id") === front_pid_before_raise,
    "cu_linux_raise_activate_raise_focus:" + JSON.stringify(focused)
  );
  ensure(
    independent_net_active_window(run_directory, executable) === active_before_raise,
    "cu_linux_raise_activate_raise_active:" + active_before_raise
  );
} finally {
  if (witness_pid !== 0) {
    rh.command("kill", ["-TERM", "" + witness_pid], { timeout_ms: 5000 });
  }
  if (fixture_pid !== 0) {
    rh.command("kill", ["-TERM", "" + fixture_pid], { timeout_ms: 5000 });
  }
  if (witness >= 0) {
    try { harness.wait(witness, 5000); } catch (error) { print("cleanup witness: " + error); }
  }
  if (fixture >= 0) {
    try { harness.wait(fixture, 5000); } catch (error) { print("cleanup fixture: " + error); }
  }
}

const context = harness.new_context(repo, "cu-linux-raise-activate");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-window-activate");
harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-raise");
harness.remove_run(context);
print("PASS: CEO Linux raise+activate with independent windows inventory foreground read-back");
return;
