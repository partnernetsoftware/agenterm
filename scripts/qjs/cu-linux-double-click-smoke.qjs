// CEO: Linux GTK double-click by --name via click --count 2 (AT-SPI).
// Acceptance is independent pyatspi read-back only: the fixture count label
// must advance by two after each named multi-click actuation. CU tree is not
// used for effect proof. No --coords, screenshot, or coordinate degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-double-click",
];

const BUTTON_NAME = "Fixture Press";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function run_cu(run_directory, executable, grant, arguments) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of arguments) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: cu_env(executable),
    timeout_ms: 45000,
  });
  ensure(output.success === true, "cu_linux_double_click_cli:" + output.stdout + output.stderr);
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_double_click_empty");
  const document = JSON.parse(trimmed);
  ensure(flag_at(document, "ok"), "cu_linux_double_click_reply:" + JSON.stringify(document));
  return document;
}

function independent_atspi_probe(title, mode, expected) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "mode = sys.argv[2]",
    "expected = sys.argv[3] if len(sys.argv) > 3 else ''",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and w.name == title:",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    name = node.name or ''",
    "    if mode == 'press_label' and name.startswith('pressed '):",
    "        return name",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_double_click_atspi_no_frame')",
    "value = walk(frame)",
    "if value is None:",
    "    raise SystemExit('cu_linux_double_click_atspi_probe_miss:' + mode)",
    "if expected and value != expected:",
    "    raise SystemExit('cu_linux_double_click_atspi_mismatch:' + mode + ':' + value + ':' + expected)",
    "print(json.dumps({'mode': mode, 'value': value}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title, mode, expected], {
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_double_click_atspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function wait_press_label(fixture_title, expected) {
  for (let attempt = 0; attempt < 80; attempt = attempt + 1) {
    const probe = independent_atspi_probe(fixture_title, "press_label", "");
    if (probe.value === expected) { return probe; }
    harness.sleep_ms(100);
  }
  const last = independent_atspi_probe(fixture_title, "press_label", "");
  ensure(last.value === expected, "cu_linux_double_click_readback:" + last.value + ":" + expected);
  return last;
}

function actuate_until_label(run_directory, executable, handle_text, fixture_title, args, expected) {
  for (let round = 0; round < 2; round = round + 1) {
    const actuated = run_cu(run_directory, executable, "observe,actuate", args);
    ensure(
      flag_at(actuated, "data.performed")
        && text_at(actuated, "data.addressing") === "accessibility-tree"
        && int_at(actuated, "data.clicks") === 2,
      "cu_linux_double_click_actuation:" + JSON.stringify(actuated.data)
    );
    const probe = independent_atspi_probe(fixture_title, "press_label", "");
    if (probe.value === expected) { return actuated; }
    harness.sleep_ms(200);
  }
  wait_press_label(fixture_title, expected);
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
const context = harness.new_context(repo, "cu-linux-double-click");
const run_directory = rh.join(repo, "target/cu-linux-double-click-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_double_click_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";

try {
  print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_double_click_window_wait");
  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_double_click_window_identity");
  const handle_text = "" + int_at(row, "handle");
  ensure(int_at(row, "handle") > 0, "cu_linux_double_click_handle:" + JSON.stringify(row));

  print("STEP independent AT-SPI read-back reports press label baseline pressed 0");
  const before = independent_atspi_probe(fixture_title, "press_label", "pressed 0");
  ensure(before.value === "pressed 0", "cu_linux_double_click_before:" + JSON.stringify(before));

  print("STEP click --name " + BUTTON_NAME + " --count 2 through AT-SPI accessibility-tree actuation");
  actuate_until_label(run_directory, executable, handle_text, fixture_title, [
    "click", "--window", handle_text, "--name", BUTTON_NAME, "--count", "2",
  ], "pressed 2");

  print("STEP independent pyatspi read-back proves the named control received two clicks");
  const after_click = independent_atspi_probe(fixture_title, "press_label", "pressed 2");
  ensure(after_click.value === "pressed 2", "cu_linux_double_click_after_click:" + JSON.stringify(after_click));

  print("STEP dclick --name " + BUTTON_NAME + " alias delivers a second double-click through AT-SPI");
  actuate_until_label(run_directory, executable, handle_text, fixture_title, [
    "dclick", "--window", handle_text, "--name", BUTTON_NAME,
  ], "pressed 4");

  print("STEP independent pyatspi read-back proves dclick advanced the counter by two more");
  const after_dclick = independent_atspi_probe(fixture_title, "press_label", "pressed 4");
  ensure(after_dclick.value === "pressed 4", "cu_linux_double_click_after_dclick:" + JSON.stringify(after_dclick));

  harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-double-click");
  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_double_click_failed");
harness.remove_run(context);
print("PASS: Linux GTK double-click by --name via click --count 2 and dclick alias (independent pyatspi read-back, no --coords)");
