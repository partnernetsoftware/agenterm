// CEO: Linux GTK double-click by --name via click --count 2 (AT-SPI).
// Acceptance is independent pyatspi state read-back only: the fixture count
// label must advance by two after each named multi-click actuation. Typed
// click/dclick usage must hold when --name/--window is missing, --coords is
// present, or leftover --bogus is supplied; host-limit paths must hold when
// the independent pyatspi desktop probe is unavailable; typed get-extents
// --name usage/host-limit paths must hold before the native actuate/read-back
// court; missing named nodes must typed-fail a11y_node_not_found. CU tree is
// not used for effect proof. No --coords, screenshot, or coordinate degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-atspi-double-click",
];

const BUTTON_NAME = "Fixture Press";
const MISSING_NODE = "No Such Button";

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  return current;
}

function text_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return ""; }
  return "" + value_at;
}

function flag_at(value, dotted) { return at(value, dotted) === true; }

function usage_rejects_unexpected(message, token) {
  return message.indexOf(token) >= 0
    || message.indexOf("unexpected") >= 0;
}

function int_at(value, dotted) {
  const value_at = at(value, dotted);
  if (value_at === undefined || value_at === null) { return 0; }
  return rh.parse_int("" + value_at);
}

function direct_file(path) {
  if (!rh.exists(path)) { return false; }
  const metadata = rh.symlink_metadata(path);
  return metadata.is_file === true && metadata.is_symlink !== true;
}

function cu_env(executable) {
  const env = {
    AGENTERM_NO_ACTIVATE: "1",
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
  };
  for (const key of [
    "DISPLAY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
    "AT_SPI_BUS_ADDRESS",
    "AT_SPI_BUS",
  ]) {
    if (rh.has_env(key)) { env[key] = rh.env_or(key, ""); }
  }
  if (env.AT_SPI_BUS_ADDRESS === undefined && env.AT_SPI_BUS !== undefined) {
    env.AT_SPI_BUS_ADDRESS = env.AT_SPI_BUS;
  }
  return env;
}

function output_success(document) { return flag_at(document, "ok"); }

function run_cu_reply(run_directory, executable, grant, cu_args, env) {
  const argv = ["--target", "current", "--grant", grant];
  for (const argument of cu_args) { argv.push("" + argument); }
  const output = rh.command(executable, argv, {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_double_click_empty_reply:" + output.stderr);
  return JSON.parse(trimmed);
}

function run_cu(run_directory, executable, grant, arguments) {
  const document = run_cu_reply(run_directory, executable, grant, arguments);
  ensure(output_success(document), "cu_linux_double_click_reply:" + JSON.stringify(document));
  return document;
}

function invoke_get_extents_reply(run_directory, executable, arguments, env) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: env === undefined ? cu_env(executable) : env,
    timeout_ms: 45000,
  });
  const trimmed = output.stdout.trim();
  ensure(trimmed !== "", "cu_linux_double_click_extents_cli:" + output.stderr);
  return JSON.parse(trimmed);
}

function probe_atspi_available(executable) {
  const script = [
    "import sys",
    "try:",
    "    import pyatspi",
    "    _ = pyatspi.Registry.getDesktop(0)",
    "    print('1')",
    "except Exception:",
    "    print('0')",
  ].join("\n");
  const output = rh.command("python3", ["-c", script], {
    env: cu_env(executable),
    timeout_ms: 10000,
  });
  return output.success === true && output.stdout.trim() === "1";
}

function assert_double_click_usage_limit(run_directory, executable) {
  const click_missing = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", "1", "--count", "2",
  ]);
  ensure(!output_success(click_missing), "cu_linux_double_click_click_usage_ok:" + JSON.stringify(click_missing));
  ensure(
    text_at(click_missing, "error.code") === "invalid_input",
    "cu_linux_double_click_click_usage_code:" + JSON.stringify(click_missing.error)
  );
  ensure(
    text_at(click_missing, "error.message").indexOf("--name") >= 0,
    "cu_linux_double_click_click_usage_message:" + JSON.stringify(click_missing.error)
  );

  const dclick_missing = run_cu_reply(run_directory, executable, "observe,actuate", [
    "dclick", "--window", "1",
  ]);
  ensure(!output_success(dclick_missing), "cu_linux_double_click_dclick_usage_ok:" + JSON.stringify(dclick_missing));
  ensure(
    text_at(dclick_missing, "error.code") === "invalid_input",
    "cu_linux_double_click_dclick_usage_code:" + JSON.stringify(dclick_missing.error)
  );
  ensure(
    text_at(dclick_missing, "error.message").indexOf("--name") >= 0,
    "cu_linux_double_click_dclick_usage_message:" + JSON.stringify(dclick_missing.error)
  );

  const zero_handle = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", "0", "--name", BUTTON_NAME, "--count", "2",
  ]);
  ensure(!output_success(zero_handle), "cu_linux_double_click_zero_handle_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_double_click_zero_handle_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("--window") >= 0,
    "cu_linux_double_click_zero_handle_message:" + JSON.stringify(zero_handle.error)
  );

  assert_double_click_coords_bogus_usage(run_directory, executable);
}

function coords_misuse_message_ok(message) {
  return usage_rejects_unexpected(message, "--coords")
    || message.indexOf("--degraded") >= 0
    || message.indexOf("coordinate") >= 0;
}

function leftover_bogus_ok(reply) {
  if (output_success(reply)) {
    return text_at(reply, "data.addressing") === "accessibility-tree";
  }
  const code = text_at(reply, "error.code");
  const message = text_at(reply, "error.message");
  if (code === "usage" || code === "invalid_input") {
    return usage_rejects_unexpected(message, "--bogus")
      || message.indexOf("--name") >= 0
      || message.indexOf("--window") >= 0
      || message.indexOf("--node") >= 0
      || message.indexOf("--coords") >= 0
      || message.indexOf("--degraded") >= 0;
  }
  return code === "a11y_node_not_found"
    || code === "bad_handle"
    || code === "a11y_backend_failed"
    || code === "unsupported";
}

function assert_click_coords_rejected(run_directory, executable, args, label) {
  const reply = run_cu_reply(run_directory, executable, "observe,actuate", args);
  ensure(!output_success(reply), "cu_linux_double_click_" + label + "_ok:" + JSON.stringify(reply));
  ensure(
    text_at(reply, "error.code") === "invalid_input" || text_at(reply, "error.code") === "usage",
    "cu_linux_double_click_" + label + "_code:" + JSON.stringify(reply.error)
  );
  ensure(
    coords_misuse_message_ok(text_at(reply, "error.message")),
    "cu_linux_double_click_" + label + "_message:" + JSON.stringify(reply.error)
  );
}

function assert_double_click_coords_bogus_usage(run_directory, executable) {
  assert_click_coords_rejected(run_directory, executable, [
    "click", "--window", "1", "--count", "2", "--coords", "10,10",
  ], "click_coords");
  assert_click_coords_rejected(run_directory, executable, [
    "dclick", "--window", "1", "--coords", "10,10",
  ], "dclick_coords");
  assert_click_coords_rejected(run_directory, executable, [
    "click", "--window", "1", "--name", BUTTON_NAME, "--count", "2", "--coords", "10,10",
  ], "click_name_coords");
  assert_click_coords_rejected(run_directory, executable, [
    "dclick", "--window", "1", "--name", BUTTON_NAME, "--coords", "10,10",
  ], "dclick_name_coords");

  const click_bogus_missing_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", "1", "--count", "2", "--bogus",
  ]);
  ensure(
    leftover_bogus_ok(click_bogus_missing_name)
      && !output_success(click_bogus_missing_name),
    "cu_linux_double_click_click_bogus_missing_name_ok:" + JSON.stringify(click_bogus_missing_name)
  );
  ensure(
    text_at(click_bogus_missing_name, "error.message").indexOf("--name") >= 0
      || usage_rejects_unexpected(text_at(click_bogus_missing_name, "error.message"), "--bogus"),
    "cu_linux_double_click_click_bogus_missing_name_message:" + JSON.stringify(click_bogus_missing_name.error)
  );

  const dclick_bogus_missing_name = run_cu_reply(run_directory, executable, "observe,actuate", [
    "dclick", "--window", "1", "--bogus",
  ]);
  ensure(
    leftover_bogus_ok(dclick_bogus_missing_name)
      && !output_success(dclick_bogus_missing_name),
    "cu_linux_double_click_dclick_bogus_missing_name_ok:" + JSON.stringify(dclick_bogus_missing_name)
  );
  ensure(
    text_at(dclick_bogus_missing_name, "error.message").indexOf("--name") >= 0
      || usage_rejects_unexpected(text_at(dclick_bogus_missing_name, "error.message"), "--bogus"),
    "cu_linux_double_click_dclick_bogus_missing_name_message:" + JSON.stringify(dclick_bogus_missing_name.error)
  );

  const click_bogus_named = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", "1", "--name", BUTTON_NAME, "--count", "2", "--bogus",
  ]);
  ensure(
    leftover_bogus_ok(click_bogus_named),
    "cu_linux_double_click_click_bogus_named:" + JSON.stringify(click_bogus_named)
  );
  if (output_success(click_bogus_named)) {
    ensure(
      int_at(click_bogus_named, "data.clicks") === 2,
      "cu_linux_double_click_click_bogus_named_clicks:" + JSON.stringify(click_bogus_named.data)
    );
  }

  const dclick_bogus_named = run_cu_reply(run_directory, executable, "observe,actuate", [
    "dclick", "--window", "1", "--name", BUTTON_NAME, "--bogus",
  ]);
  ensure(
    leftover_bogus_ok(dclick_bogus_named),
    "cu_linux_double_click_dclick_bogus_named:" + JSON.stringify(dclick_bogus_named)
  );
  if (output_success(dclick_bogus_named)) {
    ensure(
      int_at(dclick_bogus_named, "data.clicks") === 2
        && text_at(dclick_bogus_named, "data.addressing") === "accessibility-tree",
      "cu_linux_double_click_dclick_bogus_named_stay:" + JSON.stringify(dclick_bogus_named.data)
    );
  }
}

function assert_double_click_missing_node(run_directory, executable, handle, label) {
  const click_missing = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", handle, "--name", MISSING_NODE, "--count", "2",
  ]);
  ensure(!output_success(click_missing), "cu_linux_double_click_click_missing_ok_" + label);
  ensure(
    text_at(click_missing, "error.code") === "a11y_node_not_found",
    "cu_linux_double_click_click_missing_code_" + label + ":" + JSON.stringify(click_missing.error)
  );

  const dclick_missing = run_cu_reply(run_directory, executable, "observe,actuate", [
    "dclick", "--window", handle, "--name", MISSING_NODE,
  ]);
  ensure(!output_success(dclick_missing), "cu_linux_double_click_dclick_missing_ok_" + label);
  ensure(
    text_at(dclick_missing, "error.code") === "a11y_node_not_found",
    "cu_linux_double_click_dclick_missing_code_" + label + ":" + JSON.stringify(dclick_missing.error)
  );
}

function assert_get_extents_usage_limit(run_directory, executable, env) {
  const zero_handle = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "0", "--name", BUTTON_NAME,
  ], env);
  ensure(!output_success(zero_handle), "cu_linux_double_click_extents_usage_ok:" + JSON.stringify(zero_handle));
  ensure(
    text_at(zero_handle, "error.code") === "invalid_input",
    "cu_linux_double_click_extents_usage_code:" + JSON.stringify(zero_handle.error)
  );
  ensure(
    text_at(zero_handle, "error.message").indexOf("window") >= 0,
    "cu_linux_double_click_extents_usage_message:" + JSON.stringify(zero_handle.error)
  );

  const missing_name = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1",
  ], env);
  ensure(!output_success(missing_name), "cu_linux_double_click_extents_missing_name_ok:" + JSON.stringify(missing_name));
  ensure(
    text_at(missing_name, "error.code") === "usage",
    "cu_linux_double_click_extents_missing_name_code:" + JSON.stringify(missing_name.error)
  );
  ensure(
    text_at(missing_name, "command") === "usage",
    "cu_linux_double_click_extents_missing_name_command:" + JSON.stringify(missing_name)
  );
  ensure(
    text_at(missing_name, "error.message").indexOf("--name") >= 0,
    "cu_linux_double_click_extents_missing_name_message:" + JSON.stringify(missing_name.error)
  );

  const extents_coords = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--coords", "10,10",
  ], env);
  ensure(!output_success(extents_coords), "cu_linux_double_click_extents_coords_ok:" + JSON.stringify(extents_coords));
  ensure(
    text_at(extents_coords, "error.code") === "usage",
    "cu_linux_double_click_extents_coords_code:" + JSON.stringify(extents_coords.error)
  );
  ensure(
    text_at(extents_coords, "command") === "usage",
    "cu_linux_double_click_extents_coords_command:" + JSON.stringify(extents_coords)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_coords, "error.message"), "--coords")
      || text_at(extents_coords, "error.message").indexOf("--name") >= 0,
    "cu_linux_double_click_extents_coords_message:" + JSON.stringify(extents_coords.error)
  );

  const extents_bogus = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--bogus",
  ], env);
  ensure(!output_success(extents_bogus), "cu_linux_double_click_extents_bogus_ok:" + JSON.stringify(extents_bogus));
  ensure(
    text_at(extents_bogus, "error.code") === "usage",
    "cu_linux_double_click_extents_bogus_code:" + JSON.stringify(extents_bogus.error)
  );
  ensure(
    text_at(extents_bogus, "command") === "usage",
    "cu_linux_double_click_extents_bogus_command:" + JSON.stringify(extents_bogus)
  );
  ensure(
    usage_rejects_unexpected(text_at(extents_bogus, "error.message"), "--bogus")
      || text_at(extents_bogus, "error.message").indexOf("--name") >= 0,
    "cu_linux_double_click_extents_bogus_message:" + JSON.stringify(extents_bogus.error)
  );
}

function assert_get_extents_host_limit_when_atspi_absent(run_directory, executable) {
  const reply = invoke_get_extents_reply(run_directory, executable, [
    "get-extents", "--window", "1", "--name", BUTTON_NAME,
  ], {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  });
  ensure(!output_success(reply), "cu_linux_double_click_extents_unavailable_ok:" + JSON.stringify(reply));
  const code = text_at(reply, "error.code");
  ensure(
    code === "a11y_backend_failed" || code === "unsupported" || code === "bad_handle"
      || code === "a11y_node_not_found",
    "cu_linux_double_click_extents_unavailable_code:" + code
  );
}

function assert_double_click_host_limit_when_atspi_absent(run_directory, executable) {
  const env = {
    AGENTERM_ABI_LIB: rh.join(rh.parent(executable), "libagenterm.so"),
    AGENTERM_NO_ACTIVATE: "1",
    AT_SPI_BUS_ADDRESS: "invalid",
  };
  const click_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "click", "--window", "1", "--name", BUTTON_NAME, "--count", "2",
  ], env);
  ensure(!output_success(click_reply), "cu_linux_double_click_click_unavailable_ok:" + JSON.stringify(click_reply));
  const click_code = text_at(click_reply, "error.code");
  ensure(
    click_code === "a11y_backend_failed" || click_code === "unsupported" || click_code === "bad_handle",
    "cu_linux_double_click_click_unavailable_code:" + click_code
  );

  const dclick_reply = run_cu_reply(run_directory, executable, "observe,actuate", [
    "dclick", "--window", "1", "--name", BUTTON_NAME,
  ], env);
  ensure(!output_success(dclick_reply), "cu_linux_double_click_dclick_unavailable_ok:" + JSON.stringify(dclick_reply));
  const dclick_code = text_at(dclick_reply, "error.code");
  ensure(
    dclick_code === "a11y_backend_failed" || dclick_code === "unsupported" || dclick_code === "bad_handle",
    "cu_linux_double_click_dclick_unavailable_code:" + dclick_code
  );
}

function independent_atspi_probe(title, mode, expected) {
  const script = [
    "import json, sys",
    "import pyatspi",
    "title = sys.argv[1]",
    "mode = sys.argv[2]",
    "expected = sys.argv[3] if len(sys.argv) > 3 else ''",
    "desktop = pyatspi.Registry.getDesktop(0)",
    "def find_frame():",
    "    for i in range(desktop.childCount):",
    "        app = desktop.getChildAtIndex(i)",
    "        if app is None:",
    "            continue",
    "        for j in range(app.childCount):",
    "            w = app.getChildAtIndex(j)",
    "            if w is not None and w.name == title:",
    "                return w",
    "    return None",
    "def walk(node):",
    "    if node is None:",
    "        return None",
    "    name = node.name or ''",
    "    if mode == 'press_label' and name.startswith('pressed '):",
    "        return name",
    "    for k in range(node.childCount):",
    "        hit = walk(node.getChildAtIndex(k))",
    "        if hit is not None:",
    "            return hit",
    "    return None",
    "frame = find_frame()",
    "if frame is None:",
    "    raise SystemExit('cu_linux_double_click_atspi_no_frame')",
    "value = walk(frame)",
    "if value is None:",
    "    raise SystemExit('cu_linux_double_click_atspi_probe_miss:' + mode)",
    "if expected and value != expected:",
    "    raise SystemExit('cu_linux_double_click_atspi_mismatch:' + mode + ':' + value + ':' + expected)",
    "print(json.dumps({'mode': mode, 'value': value}))",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, title, mode, expected], {
    timeout_ms: 30000,
  });
  ensure(output.success === true, "cu_linux_double_click_atspi:" + output.stderr + output.stdout);
  return JSON.parse(output.stdout.trim());
}

function wait_press_label(fixture_title, expected) {
  for (let attempt = 0; attempt < 80; attempt = attempt + 1) {
    const probe = independent_atspi_probe(fixture_title, "press_label", "");
    if (probe.value === expected) { return probe; }
    harness.sleep_ms(100);
  }
  const last = independent_atspi_probe(fixture_title, "press_label", "");
  ensure(last.value === expected, "cu_linux_double_click_readback:" + last.value + ":" + expected);
  return last;
}

function actuate_until_label(run_directory, executable, handle_text, fixture_title, args, expected) {
  for (let round = 0; round < 2; round = round + 1) {
    const actuated = run_cu(run_directory, executable, "observe,actuate", args);
    ensure(
      flag_at(actuated, "data.performed")
        && text_at(actuated, "data.addressing") === "accessibility-tree"
        && int_at(actuated, "data.clicks") === 2,
      "cu_linux_double_click_actuation:" + JSON.stringify(actuated.data)
    );
    const probe = independent_atspi_probe(fixture_title, "press_label", "");
    if (probe.value === expected) { return actuated; }
    harness.sleep_ms(200);
  }
  wait_press_label(fixture_title, expected);
}

function window_row(run_directory, executable, pid, title) {
  const reply = run_cu(run_directory, executable, "observe", [
    "windows", "--pid", "" + pid,
  ]);
  const rows = reply.data.windows === undefined ? reply.data : reply.data.windows;
  for (const row of rows) {
    if (text_at(row, "title") === title) { return row; }
  }
  return null;
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
const executable = rh.absolute(args[1]);
ensure(direct_file(executable), "cu_linux_double_click_executable_missing");
const context = harness.new_context(repo, "cu-linux-double-click");
const run_directory = rh.join(repo, "target/cu-linux-double-click-smoke-run");
rh.create_dir_all(run_directory);

const fixture_source = rh.join(repo, "examples/python/agenterm_atspi_fixture.py");
ensure(direct_file(fixture_source), "cu_linux_double_click_fixture_missing:" + fixture_source);

let fixture = -1;
let fixture_pid = 0;
let succeeded = 0;
let failure = "";
const env = cu_env(executable);
const atspi_available = probe_atspi_available(executable);

try {
  print("STEP click --count 2 / dclick typed-fail usage when --name or --window is missing, or --coords/--bogus is present");
  assert_double_click_usage_limit(run_directory, executable);

  if (atspi_available) {
    print("STEP get-extents --name typed-fail usage when --window is zero, --name is missing, or --coords/--bogus is present before actuate/read-back court");
    assert_get_extents_usage_limit(run_directory, executable, env);
  } else {
    print("STEP get-extents --name typed-fail host-limit when pyatspi desktop probe is unavailable before actuate/read-back court");
    assert_get_extents_host_limit_when_atspi_absent(run_directory, executable);
  }

  if (!atspi_available) {
    print("STEP click/dclick typed-fail host-limit when independent pyatspi desktop probe is unavailable");
    assert_double_click_host_limit_when_atspi_absent(run_directory, executable);
    succeeded = 1;
  } else {
  print("STEP start the owned GTK fixture and resolve its window by pid and exact title");
  fixture = harness.start({
    program: "python3",
    args: [fixture_source],
    current_dir: run_directory,
    env: { GTK_MODULES: "gail:atk-bridge" },
    timeout_ms: 30000,
  });
  fixture_pid = harness.spawned_pid(fixture);
  const fixture_title = "agenterm-linux-fixture-" + fixture_pid;
  const window_wait = run_cu(run_directory, executable, "observe", [
    "wait", "--timeout-ms", "15000", "--window-title-contains", fixture_title,
  ]);
  ensure(flag_at(window_wait, "data.met"), "cu_linux_double_click_window_wait");
  const row = window_row(run_directory, executable, fixture_pid, fixture_title);
  ensure(row !== null, "cu_linux_double_click_window_identity");
  const handle_text = "" + int_at(row, "handle");
  ensure(int_at(row, "handle") > 0, "cu_linux_double_click_handle:" + JSON.stringify(row));

  print("STEP click --count 2 / dclick typed-fail a11y_node_not_found when the named button is missing");
  assert_double_click_missing_node(run_directory, executable, handle_text, "before_actuate");

  print("STEP independent AT-SPI read-back reports press label baseline pressed 0");
  const before = independent_atspi_probe(fixture_title, "press_label", "pressed 0");
  ensure(before.value === "pressed 0", "cu_linux_double_click_before:" + JSON.stringify(before));

  print("STEP click --name " + BUTTON_NAME + " --count 2 through AT-SPI accessibility-tree actuation");
  actuate_until_label(run_directory, executable, handle_text, fixture_title, [
    "click", "--window", handle_text, "--name", BUTTON_NAME, "--count", "2",
  ], "pressed 2");

  print("STEP independent pyatspi read-back proves the named control received two clicks");
  const after_click = independent_atspi_probe(fixture_title, "press_label", "pressed 2");
  ensure(after_click.value === "pressed 2", "cu_linux_double_click_after_click:" + JSON.stringify(after_click));

  print("STEP dclick --name " + BUTTON_NAME + " alias delivers a second double-click through AT-SPI");
  actuate_until_label(run_directory, executable, handle_text, fixture_title, [
    "dclick", "--window", handle_text, "--name", BUTTON_NAME,
  ], "pressed 4");

  print("STEP independent pyatspi read-back proves dclick advanced the counter by two more");
  const after_dclick = independent_atspi_probe(fixture_title, "press_label", "pressed 4");
  ensure(after_dclick.value === "pressed 4", "cu_linux_double_click_after_dclick:" + JSON.stringify(after_dclick));

  harness.emit_evidence(context, declared_evidence, "cu.linux-atspi-double-click");
  succeeded = 1;
  }
} catch (error) {
  failure = "" + error;
}

if (fixture_pid > 0) {
  rh.command("kill", ["-TERM", "" + fixture_pid], { cwd: run_directory, timeout_ms: 5000 });
}
if (fixture >= 0) {
  harness.wait(fixture, 5000);
}

ensure(succeeded === 1, failure || "cu_linux_double_click_failed");
harness.remove_run(context);
if (atspi_available) {
  print("PASS: Linux GTK double-click by --name via click --count 2 and dclick alias with independent pyatspi state read-back and typed click/dclick --coords/--bogus plus get-extents --name usage honesty (AT-SPI --name, no --coords)");
} else {
  print("PASS: Linux GTK double-click typed-fails with typed click/dclick --coords/--bogus usage and get-extents --name host-limit honesty when independent pyatspi desktop probe is unavailable");
}
return;
