// CEO: Linux host memory honesty with independent /proc/meminfo read-back.
// Acceptance is smoke read-back only: CU host-memory-status must agree with
// MemTotal and MemAvailable derived outside agenterm-cu. No --coords or
// screenshot degradation.
//
// Args: REPO AGENTERM_CU_EXE
// or:   --list-evidence
import * as rh from "lib/rh_compat";
import * as harness from "lib/test_harness";

const declared_evidence = [
  "cu.linux-host-memory-readback",
];

function ensure(condition, message) {
  if (!condition) { throw message; }
}

function text_at(value, dotted) {
  let current = value;
  for (const key of dotted.split(".")) {
    current = rh.field(current, key);
  }
  if (current === undefined || current === null) { return ""; }
  return "" + current;
}

function invoke(run_directory, executable, arguments, expect_success) {
  const output = rh.command(executable, [
    "--target", "current", "--grant", "observe",
  ].concat(arguments), {
    cwd: run_directory,
    env: { AGENTERM_NO_ACTIVATE: "1" },
    timeout_ms: 30000,
  });
  ensure(output.success === expect_success, "cu_linux_host_memory_exit:" + output.exit_code);
  const reply = JSON.parse(output.stdout.trim());
  ensure(reply.ok === expect_success, "cu_linux_host_memory_reply_state");
  return reply;
}

function verify_readback(executable) {
  const script = [
    "import json, os, subprocess, sys",
    "def meminfo_kibibytes(key):",
    "    with open('/proc/meminfo') as handle:",
    "        for line in handle:",
    "            if line.startswith(key):",
    "                parts = line.split()",
    "                if len(parts) != 3 or parts[0] != key or parts[2] != 'kB':",
    "                    raise ValueError('invalid ' + key + ' line: ' + line.strip())",
    "                return int(parts[1]) * 1024",
    "    raise ValueError('missing ' + key)",
    "def snapshot():",
    "    return {",
    "        'page_size': int(os.sysconf('SC_PAGESIZE')),",
    "        'physical_bytes': meminfo_kibibytes('MemTotal:'),",
    "        'available_physical_bytes': meminfo_kibibytes('MemAvailable:'),",
    "    }",
    "cu = sys.argv[1]",
    "before = snapshot()",
    "out = subprocess.check_output([cu, '--target', 'current', '--grant', 'observe', 'host-memory-status'], text=True)",
    "after = snapshot()",
    "reply = json.loads(out)",
    "if not reply.get('ok') or reply.get('command') != 'host-memory-status':",
    "    raise SystemExit('cu_linux_host_memory_reply_state')",
    "data = reply['data']",
    "if data.get('atomic_snapshot') is not False:",
    "    raise SystemExit('cu_linux_host_memory_atomic_snapshot')",
    "if data.get('availability_semantics') != 'linux-mem-available':",
    "    raise SystemExit('cu_linux_host_memory_semantics:' + str(data.get('availability_semantics')))",
    "if data['physical_bytes'] != before['physical_bytes'] or data['physical_bytes'] != after['physical_bytes']:",
    "    raise SystemExit('cu_linux_host_memory_physical_mismatch:cu=' + str(data['physical_bytes'])",
    "        + ':before=' + str(before['physical_bytes']) + ':after=' + str(after['physical_bytes']))",
    "if data['page_size'] != before['page_size']:",
    "    raise SystemExit('cu_linux_host_memory_page_size_mismatch')",
    "if data['allocation_granularity'] < data['page_size']:",
    "    raise SystemExit('cu_linux_host_memory_allocation_granularity')",
    "lo = min(before['available_physical_bytes'], after['available_physical_bytes'])",
    "hi = max(before['available_physical_bytes'], after['available_physical_bytes'])",
    "avail = data['available_physical_bytes']",
    "if avail < lo or avail > hi:",
    "    raise SystemExit('cu_linux_host_memory_available_mismatch:cu=' + str(avail)",
    "        + ':lo=' + str(lo) + ':hi=' + str(hi))",
    "print('physical_bytes', data['physical_bytes'])",
    "print('available_physical_bytes', avail)",
  ].join("\n");
  const output = rh.command("python3", ["-c", script, executable], { timeout_ms: 30000 });
  ensure(output.success === true, "cu_linux_host_memory_readback:" + output.stderr + output.stdout);
}

const args = rh.args();
if (args.length === 1 && args[0] === "--list-evidence") {
  for (const id of declared_evidence) { print(id); }
  return;
}
harness.require(args.length === 2, "expected: REPO AGENTERM_CU_EXE");
const repo = rh.absolute(args[0]);
let executable = rh.absolute(args[1]);
if (!rh.exists(executable) && harness.host_is_windows()) { executable = executable + ".exe"; }
harness.require(rh.exists(executable), "agenterm-cu executable missing");

const context = harness.new_context(repo, "cu-linux-host-memory");
let succeeded = 0;
let failure = "";
try {
  print("STEP host-memory-status observe matches independent /proc/meminfo read-back");
  verify_readback(executable);

  succeeded = 1;
} catch (error) {
  failure = "" + error;
}

let completion_failure = "";
try { harness.complete_children(context, [], succeeded !== 0, failure); }
catch (error) { completion_failure = "" + error; }
if (succeeded !== 0 && completion_failure === "") {
  harness.emit_evidence(context, declared_evidence, "cu.linux-host-memory-readback");
  harness.remove_run(context);
  print("PASS: Linux host-memory-status matches independent /proc/meminfo MemTotal and MemAvailable read-back");
}
if (failure !== "") { throw failure; }
if (completion_failure !== "") { throw completion_failure; }
return;
