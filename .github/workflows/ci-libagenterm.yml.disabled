name: CI / libagenterm

on:
  workflow_dispatch:
  # Candidate requires a successful run for its exact immutable SHA. Keep this
  # workflow unfiltered so an otherwise-unrelated release commit cannot make
  # that authority check impossible to satisfy.
  push:
  pull_request:

concurrency:
  # An exact-SHA manual qualification must survive later main pushes. Ordinary
  # push/PR feedback remains replaceable within its mutable ref.
  group: ci-libagenterm-${{ github.event_name == 'workflow_dispatch' && github.sha || github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  libagenterm-abi:
    name: libagenterm + cu (windows)
    runs-on: windows-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0
        with:
          persist-credentials: false
      - name: Install Rust ABI toolchain components
        run: rustup component add clippy
      - name: Build libagenterm ABI (abi-release)
        run: cargo build --locked -p agenterm-abi --profile abi-release
      - name: Build Windows libagenterm installer task host
        run: cargo build --locked -p agenterm --bin agenterm
      - name: Test libagenterm ABI (abi-dev)
        run: cargo test --locked -p agenterm-abi --profile abi-dev
      - name: C ABI evidence (toolchain + artifact sizes)
        run: |
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_consumer -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_static_link -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_window -- --nocapture
      - name: C ABI evidence (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: |
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_consumer -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_static_link -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_window -- --nocapture
      - name: C++ consumer (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test cpp_consumer -- --nocapture
      - name: Mixed static+dynamic linkage probe (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test mixed_linkage -- --nocapture
      - name: C window rendezvous, statically linked (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test c_window_static -- --nocapture
      - name: Enumerate while hosting a window (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test enumerate_while_hosting -- --nocapture
      - name: Native window ops on a child-owned window (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test native_window_ops -- --nocapture
      - name: Symbol presence (abi-dev artifacts)
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test symbol_presence -- --nocapture
      - name: Symbol presence (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test symbol_presence -- --nocapture
      - name: Export surface exactness (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test export_exactness -- --nocapture
      - name: Static archive symbol surface (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test archive_surface -- --nocapture
      - name: Shared library install identity (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test install_identity -- --nocapture
      - name: Install and consume from the installed tree (Windows, abi-release)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
          AGENTERM_INSTALL_TASK_HOST: target/debug/agenterm.exe
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test install_consume_windows -- --nocapture
      - name: Input injection success path on a child-owned window (abi-release artifacts)
        # Milestone 72: the four agt_input_* exports finally get success-path
        # evidence. Injection is GLOBAL (real cursor + focused window), so the
        # test is opt-in: it SKIPs unless AGENTERM_ALLOW_INPUT_INJECTION=1 is
        # set, and this step is the ONLY place that sets it. Deliberately NOT
        # added to the linux/macos jobs (their stacks are another round and
        # their runners are headless anyway).
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
          AGENTERM_ALLOW_INPUT_INJECTION: '1'
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test input_inject_success -- --nocapture
      - name: Clippy libagenterm ABI (abi-dev)
        run: cargo clippy --locked -p agenterm-abi --profile abi-dev --all-targets --no-deps -- -D warnings
      - name: Test minicon-platform (all test targets)
        run: cargo test --locked -p minicon-platform --all-features --tests
      - name: Clippy minicon-platform (all features)
        run: cargo clippy --locked -p minicon-platform --all-features --all-targets --no-deps -- -D warnings
      - name: Build agenterm-cu
        run: cargo build --locked -p agenterm-cu --release
      - name: Stage Windows CU delivery pair
        run: target\debug\agenterm.exe rh task run stage-cu-windows-smoke --manifest agenterm.tasks.json
      - name: Prove CU smoke remains a native Rh pack
        run: cargo run --locked -p agenterm-rh --example mode_probe -- --root . scripts/rh/cu-windows-smoke.rh
      - name: Run staged Windows CU smoke
        env:
          AGENTERM_NO_ACTIVATE: '1'
        run: cargo run --locked -p agenterm --bin agenterm -- rh run scripts/rh/cu-windows-smoke.rh -- . dist/agenterm-cu.exe dist/agenterm.dll examples/c/agenterm_plain_window.c
      - name: Test agenterm-cu
        run: cargo test --locked -p agenterm-cu
      - name: Clippy agenterm-cu
        run: cargo clippy --locked -p agenterm-cu --all-targets --no-deps -- -D warnings

  libagenterm-windows-aarch64-build:
    name: libagenterm + cu (windows aarch64 build)
    runs-on: ubuntu-latest
    timeout-minutes: 35
    steps:
      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0
        with:
          persist-credentials: false
      - name: Install Windows ARM64 target and cargo-xwin
        run: |
          rustup target add aarch64-pc-windows-msvc
          cargo install cargo-xwin --locked
      - name: Build agenterm-cu for Windows ARM64
        run: cargo xwin build --locked -p agenterm-cu --release --target aarch64-pc-windows-msvc
      - name: Build libagenterm for Windows ARM64
        run: cargo xwin build --locked -p agenterm-abi --profile abi-release --target aarch64-pc-windows-msvc
      - name: Verify Windows ARM64 delivery pair exists
        run: |
          test -f target/aarch64-pc-windows-msvc/release/agenterm-cu.exe
          test -f target/aarch64-pc-windows-msvc/abi-release/agenterm.dll

  libagenterm-abi-macos:
    name: libagenterm + cu (macos)
    # macOS 交付通道:真实构建并验证 libagenterm.dylib 与 libagenterm.a
    # (c_consumer / c_static_link 必须真跑,不许 SKIP)。
    # 故意没有 brew 步骤——linux 那轮已证明编译期平台栈是纯 Rust(窗口 /
    # 剪贴板 / a11y 适配层全部 dlopen/dyn 加载,不链接系统 -dev 包),
    # macos-latest 自带的 clang 覆盖 C probe 编译。运行期 headless runner
    # 上窗口 / 剪贴板 / a11y 由适配层短路为 AGT_UNSUPPORTED(测试按设计
    # SKIP,不触碰 AppKit 主线程限制,已声明于 include/agenterm.h 与
    # README)。若 CI 首次运行报缺库,按报错补 brew 包,并回填本注释。
    runs-on: macos-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0
        with:
          persist-credentials: false
      - name: Install Rust ABI toolchain components
        run: rustup component add clippy
      - name: Build libagenterm ABI (abi-release)
        run: cargo build --locked -p agenterm-abi --profile abi-release
      - name: Test libagenterm ABI (abi-dev)
        run: cargo test --locked -p agenterm-abi --profile abi-dev
      - name: C ABI evidence (toolchain + artifact sizes)
        run: |
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_consumer -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_static_link -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_window -- --nocapture
      - name: C ABI evidence (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: |
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_consumer -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_static_link -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_window -- --nocapture
      - name: C++ consumer (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test cpp_consumer -- --nocapture
      - name: Mixed static+dynamic linkage probe (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test mixed_linkage -- --nocapture
      - name: C window rendezvous, statically linked (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test c_window_static -- --nocapture
      - name: Enumerate while hosting a window (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test enumerate_while_hosting -- --nocapture
      - name: Native window ops on a child-owned window (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test native_window_ops -- --nocapture
      - name: Symbol presence (abi-dev artifacts)
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test symbol_presence -- --nocapture
      - name: Symbol presence (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test symbol_presence -- --nocapture
      - name: Export surface exactness (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test export_exactness -- --nocapture
      - name: Static archive symbol surface (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test archive_surface -- --nocapture
      - name: Shared library install identity (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test install_identity -- --nocapture
      - name: pkg-config static consumption (end to end)
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test pkgconfig_consume -- --nocapture
      - name: Install and consume from the installed tree (abi-release)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test install_consume -- --nocapture
      - name: Clippy libagenterm ABI (abi-dev)
        run: cargo clippy --locked -p agenterm-abi --profile abi-dev --all-targets --no-deps -- -D warnings
      - name: Test minicon-platform (all test targets)
        run: cargo test --locked -p minicon-platform --all-features --tests
      - name: Clippy minicon-platform (all features)
        run: cargo clippy --locked -p minicon-platform --all-features --all-targets --no-deps -- -D warnings
      - name: Build agenterm-cu
        run: cargo build --locked -p agenterm-cu --release
      - name: Test agenterm-cu
        run: cargo test --locked -p agenterm-cu
      - name: Clippy agenterm-cu
        run: cargo clippy --locked -p agenterm-cu --all-targets --no-deps -- -D warnings

  libagenterm-abi-linux:
    name: libagenterm + cu (linux)
    # Linux 交付通道:真实构建并验证 libagenterm.so 与 libagenterm.a(c_consumer /
    # c_static_link 必须真跑,不许 SKIP)。
    # 故意没有 apt 步骤——实测依据(交叉 cargo check/clippy 通过 + 代码路径分析):
    # 编译期平台栈在 Linux 上是纯 Rust(winit+wayland-dlopen / x11rb / atspi /
    # zbus / softbuffer),零系统 -dev 包;运行期 headless runner 上窗口 / 剪贴板 /
    # a11y 由适配层短路为 AGT_UNSUPPORTED(测试按设计 SKIP,不触碰 xkbcommon 等
    # dlopen 库),PTY / C probe 只用 ubuntu-latest 自带的 gcc 与 glibc。
    # 若 CI 首次运行报缺库,按报错补 apt 包,并回填本注释与
    # crates/agenterm-abi/README.md 的 Unix 系统库列表。
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0
        with:
          persist-credentials: false
      - name: Install Rust ABI toolchain components
        run: rustup component add clippy
      - name: Build libagenterm ABI (abi-release)
        run: cargo build --locked -p agenterm-abi --profile abi-release
      - name: Test libagenterm ABI (abi-dev)
        run: cargo test --locked -p agenterm-abi --profile abi-dev
      - name: C ABI evidence (toolchain + artifact sizes)
        run: |
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_consumer -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_static_link -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_window -- --nocapture
      - name: C ABI evidence (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: |
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_consumer -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_static_link -- --nocapture
          cargo test --locked -p agenterm-abi --profile abi-dev --test c_window -- --nocapture
      - name: C++ consumer (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test cpp_consumer -- --nocapture
      - name: Mixed static+dynamic linkage probe (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test mixed_linkage -- --nocapture
      - name: C window rendezvous, statically linked (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test c_window_static -- --nocapture
      - name: Enumerate while hosting a window (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test enumerate_while_hosting -- --nocapture
      - name: Native window ops on a child-owned window (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test native_window_ops -- --nocapture
      - name: Symbol presence (abi-dev artifacts)
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test symbol_presence -- --nocapture
      - name: Symbol presence (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test symbol_presence -- --nocapture
      - name: Export surface exactness (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test export_exactness -- --nocapture
      - name: Static archive symbol surface (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test archive_surface -- --nocapture
      - name: Shared library install identity (abi-release artifacts)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test install_identity -- --nocapture
      - name: pkg-config static consumption (end to end)
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test pkgconfig_consume -- --nocapture
      - name: Install and consume from the installed tree (abi-release)
        env:
          AGENTERM_ABI_PROFILE_DIR: target/abi-release
        run: cargo test --locked -p agenterm-abi --profile abi-dev --test install_consume -- --nocapture
      - name: Clippy libagenterm ABI (abi-dev)
        run: cargo clippy --locked -p agenterm-abi --profile abi-dev --all-targets --no-deps -- -D warnings
      - name: Test minicon-platform (all test targets)
        run: cargo test --locked -p minicon-platform --all-features --tests
      - name: Clippy minicon-platform (all features)
        run: cargo clippy --locked -p minicon-platform --all-features --all-targets --no-deps -- -D warnings
      - name: Build agenterm-cu
        run: cargo build --locked -p agenterm-cu --release
      - name: Test agenterm-cu
        run: cargo test --locked -p agenterm-cu
      - name: Clippy agenterm-cu
        run: cargo clippy --locked -p agenterm-cu --all-targets --no-deps -- -D warnings
