{
  "schema_version": 3,
  "project": {
    "id": "agenterm-development",
    "version": "0.1.16",
    "requires": {
      "script_api": {
        "minimum": 2,
        "maximum": 2
      },
      "capabilities": [
        "runtime.project.named-task",
        "std.env.get",
        "std.env.has",
        "std.env.current-dir",
        "std.net.tcp-stream-connect",
        "std.net.tcp-stream-connect-timeout",
        "std.net.tcp-stream",
        "std.net.tcp-listener-bind",
        "std.net.tcp-listener",
        "std.fs.exists",
        "std.fs.metadata",
        "std.fs.read-dir",
        "std.fs.read-to-string",
        "std.fs.copy",
        "std.fs.create-dir-all",
        "std.fs.remove-dir-all",
        "std.fs.remove-file",
        "std.fs.rename",
        "std.fs.symlink-metadata",
        "std.fs.try-lock-exclusive",
        "std.fs.write",
        "std.path.absolute",
        "std.path.join",
        "std.path.parent",
        "std.process.command",
        "std.process.command-builder",
        "std.process.command-output",
        "std.process.child-window-input",
        "std.process.id",
        "std.process.list",
        "std.process.kill",
        "std.time.system-time-now",
        "std.time.system-time-unix-millis",
        "std.time.system-time-rfc3339"
      ]
    },
    "origin": {
      "kind": "repository",
      "id": "agenterm"
    },
    "provenance": {
      "producer": "agenterm",
      "revision": "v0.1.16-rc-unpublished"
    }
  },
  "contracts": {
    "lua-build-identity": {
      "inputs": [
        "source-tree",
        "cargo-lock",
        "artifact-manifest"
      ],
      "outputs": [
        "build-identity"
      ],
      "budget": {
        "timeout_ms": 120000,
        "max_operations": 10000000,
        "max_output_bytes": 1048576
      },
      "network": [],
      "evidence": [
        "task.lua-build-identity"
      ]
    },
    "lua-check": {
      "inputs": [
        "lua-source-tree"
      ],
      "outputs": [
        "lua-syntax-results"
      ],
      "budget": {
        "timeout_ms": 120000,
        "max_operations": 10000000,
        "max_output_bytes": 1048576
      },
      "network": [],
      "evidence": [
        "task.lua-check"
      ]
    }
  },
  "tasks": [
    {
      "id": "lua-build-identity",
      "description": "Lua production task: freeze build identity into batch env file",
      "entry": "scripts/lua/build_identity.lua",
      "profile": "local",
      "cwd": ".",
      "args": [
        ".",
        "dev",
        "build-identity.bat"
      ],
      "dependencies": [],
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "side_effects": [
        "artifact_write",
        "process_spawn"
      ]
    },
    {
      "id": "lua-check",
      "description": "Lua production task example: lint scripts/lua/ directory for syntax errors",
      "entry": "scripts/lua/check.lua",
      "profile": "local",
      "cwd": ".",
      "args": [
        "scripts/lua"
      ],
      "dependencies": [],
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "side_effects": [
        "process_spawn"
      ]
    }
  ]
}
